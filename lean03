/-- **Witness for `twoTerm_of_kappa_tau`.** In the deviation example at `k = 0`, `u = e_1`:
`β = 1 ≥ 0`, `Γ_0(R_0 u) ≤ 2 Γ_1(u)` (`κ = 2`), `‖R_0 u‖ ≤ 2‖u‖ + 0 · Γ_1(u)` (`τ = 0`) and
`τ + βκ ≤ sβ` for `s = 2`; hence the two-term condition holds at `u`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order; the 4D
channel constants are observations and enter only as hypotheses; nothing about the Yang–Mills
measure; (D), (E) and the mass gap remain open. -/
theorem witness_twoTerm_of_kappa_tau :
    (0 : ℝ) ≤ 1 ∧
      devG 0 (devR 0 (Pi.single 1 1 : ES 1)) ≤ 2 * devG 1 (Pi.single 1 1 : ES 1) ∧
      devN 0 (devR 0 (Pi.single 1 1 : ES 1)) ≤
        2 * devN 1 (Pi.single 1 1 : ES 1) + 0 * devG 1 (Pi.single 1 1 : ES 1) ∧
      (0 : ℝ) + 1 * 2 ≤ 2 * 1 ∧
      TwoTerm devR devN devG 2 1 0 (Pi.single 1 1 : ES 1) := by
  have hκ : devG 0 (devR 0 (Pi.single 1 1 : ES 1)) ≤ 2 * devG 1 (Pi.single 1 1 : ES 1) := by
    show |2 * (Pi.single 1 1 : ℕ → ℝ) 1 - 2 * (Pi.single 1 1 : ℕ → ℝ) 0| ≤
      2 * |(Pi.single 1 1 : ℕ → ℝ) 1 - (Pi.single 1 1 : ℕ → ℝ) 0|
    norm_num
  have hτ : devN 0 (devR 0 (Pi.single 1 1 : ES 1)) ≤
      2 * devN 1 (Pi.single 1 1 : ES 1) + 0 * devG 1 (Pi.single 1 1 : ES 1) := by
    show |2 * (Pi.single 1 1 : ℕ → ℝ) 0| + |2 * (Pi.single 1 1 : ℕ → ℝ) 1| ≤
      2 * (|(Pi.single 1 1 : ℕ → ℝ) 0| + |(Pi.single 1 1 : ℕ → ℝ) 1|) +
        0 * |(Pi.single 1 1 : ℕ → ℝ) 1 - (Pi.single 1 1 : ℕ → ℝ) 0|
    norm_num
  have hβτ : (0 : ℝ) + 1 * 2 ≤ 2 * 1 := by norm_num
  exact ⟨zero_le_one, hκ, hτ, hβτ, twoTerm_of_kappa_tau devR devN devG zero_le_one hκ hτ hβτ⟩

