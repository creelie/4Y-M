    · exact (admissible_iff_stepAdmissible wR _ _).1 witness_admissible_iff.2.2.2.2.2
  exact ⟨hA, hiso, halign, h0, hadm, minChain_le (Ch := fun _ => Fin 2) wMap wP (A := wA) hA
