          devN 0 (devR 0 (devR 1 w)) - 2 * devN 1 (devR 1 w) = 0) ∧
        BddAbove (Set.range fun i : {w : ES 2 // 0 < 2 * devG 1 (devR 1 w) -
            devG 0 (devR 0 (devR 1 w))} =>
          (devN 0 (devR 0 (devR 1 i)) - 2 * devN 1 (devR 1 i)) /
            (2 * devG 1 (devR 1 i) - devG 0 (devR 0 (devR 1 i)))) ∧
        ((∃ w : ES 2, 2 * devG 1 (devR 1 w) - devG 0 (devR 0 (devR 1 w)) < 0) →
          ∀ w : ES 2, devN 0 (devR 0 (devR 1 w)) - 2 * devN 1 (devR 1 w) = 0) := by
  have hlow : ∀ w : ES 2, 2 * devN 1 (devR 1 w) ≤ devN 0 (devR 0 (devR 1 w)) :=
    fun w => dev_lower 0 _
  have hβ : ∃ β, 0 ≤ β ∧ ∀ w : ES 2, TwoTerm devR devN devG 2 β 0 (devR 1 w) :=
    ⟨1, zero_le_one, fun w => dev_twoTerm 0 _⟩
  exact ⟨hlow, hβ, (exists_beta_twoTerm_iff devR devN devG (k := 0) (s := 2)
    (fun w : ES 2 => devR 1 w) hlow).1 hβ⟩

end Examples

/-! ## 9. Concrete witnesses

Hypothesis-free instances on explicit data.  Each theorem below applies one result of this part
to small explicit data (`Fin` index types, explicit matrices, profiles and weights), states that
result's hypotheses on these data as conjuncts, and ends with the conclusion obtained by applying
it.  The coordinate-channel data are the matrix `R = [[1, −1], [2, 1]]` on `ℝ²` (one sign change,
`|R| = [[1, 1], [2, 1]]`) and the weights `(1, 1) → (3, 2) → (7, 5)`, for which
`|R|ᵀ (1, 1) = (3, 2)` and `|R|ᵀ (3, 2) = (7, 5)`. -/

section Witnesses

/-- The matrix `R = [[1, −1], [2, 1]]` on `ℝ²`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order; the 4D
channel constants are observations and enter only as hypotheses; nothing about the Yang–Mills
measure; (D), (E) and the mass gap remain open. -/
def wR : Matrix (Fin 2) (Fin 2) ℝ := !![1, -1; 2, 1]

/-- The constant chain of maps `R_k z = R z` on `ℝ²`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order; the 4D
channel constants are observations and enter only as hypotheses; nothing about the Yang–Mills
measure; (D), (E) and the mass gap remain open. -/
def wMap : ∀ k, E2 (k + 1) → E2 k := fun _ z => wR *ᵥ z

/-- The coordinate profiles `p_k(y) = |y|` on `ℝ²`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order; the 4D
channel constants are observations and enter only as hypotheses; nothing about the Yang–Mills
measure; (D), (E) and the mass gap remain open. -/
def wP : ∀ k, E2 k → Fin 2 → ℝ := fun _ y => coordProfile y

/-- The constant transfer matrices `A_k = |R|`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order; the 4D
channel constants are observations and enter only as hypotheses; nothing about the Yang–Mills
measure; (D), (E) and the mass gap remain open. -/
def wA : ℕ → Matrix (Fin 2) (Fin 2) ℝ := fun _ => wR.map abs

/-- The weights `λ_0 = (1, 1)`, `λ_1 = (3, 2)` and `λ_k = (7, 5)` for `k ≥ 2`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order; the 4D
channel constants are observations and enter only as hypotheses; nothing about the Yang–Mills
measure; (D), (E) and the mass gap remain open. -/
def wLam : ℕ → Fin 2 → ℝ
  | 0 => ![1, 1]
  | 1 => ![3, 2]
  | _ + 2 => ![7, 5]

/-- `|R|ᵀ (1, 1) ≤ (3, 2)` and `|R|ᵀ (3, 2) ≤ (7, 5)` (both hold with equality).

Scope: a statement about one proof method (norm chains across scales) at Gaussian order; the 4D
channel constants are observations and enter only as hypotheses; nothing about the Yang–Mills
measure; (D), (E) and the mass gap remain open. -/
theorem wR_transfer_steps :
    (wR.map abs)ᵀ *ᵥ ![1, 1] ≤ ![3, 2] ∧ (wR.map abs)ᵀ *ᵥ ![3, 2] ≤ ![7, 5] := by
  constructor
  · intro j
    fin_cases j <;> norm_num [wR, Matrix.mulVec, dotProduct, Fin.sum_univ_two]
  · intro j
    fin_cases j <;> norm_num [wR, Matrix.mulVec, dotProduct, Fin.sum_univ_two]

/-- **Witness for `transpose_mulVec_mono`.** `|R| ≥ 0` and `(1, 1) ≤ (3, 2)`, hence
`|R|ᵀ (1, 1) ≤ |R|ᵀ (3, 2)`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order; the 4D
channel constants are observations and enter only as hypotheses; nothing about the Yang–Mills
measure; (D), (E) and the mass gap remain open. -/
theorem witness_transpose_mulVec_mono :
    (∀ i j, 0 ≤ (wR.map abs) i j) ∧ (![1, 1] : Fin 2 → ℝ) ≤ ![3, 2] ∧
      (wR.map abs)ᵀ *ᵥ ![1, 1] ≤ (wR.map abs)ᵀ *ᵥ ![3, 2] := by
  have hA : ∀ i j, 0 ≤ (wR.map abs) i j := fun i j => abs_nonneg (wR i j)
  have h : (![1, 1] : Fin 2 → ℝ) ≤ ![3, 2] := by
    intro i
    fin_cases i <;> norm_num
  exact ⟨hA, h, transpose_mulVec_mono hA h⟩

/-- **Witness for `single_le_dotProduct`.** `e_0 ≤ (1, 2)` and `(3, 4) ≥ 0`, hence
`3 ≤ ⟨(1, 2), (3, 4)⟩`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order; the 4D
channel constants are observations and enter only as hypotheses; nothing about the Yang–Mills
measure; (D), (E) and the mass gap remain open. -/
theorem witness_single_le_dotProduct :
    Pi.single (0 : Fin 2) (1 : ℝ) ≤ ![1, 2] ∧ (0 : Fin 2 → ℝ) ≤ ![3, 4] ∧
      (![3, 4] : Fin 2 → ℝ) 0 ≤ ![1, 2] ⬝ᵥ ![3, 4] := by
  have hc : Pi.single (0 : Fin 2) (1 : ℝ) ≤ ![1, 2] := by
    intro i
    fin_cases i
    · show (Pi.single 0 1 : Fin 2 → ℝ) 0 ≤ 1
      rw [Pi.single_eq_same]
    · show (Pi.single 0 1 : Fin 2 → ℝ) 1 ≤ 2
      rw [Pi.single_eq_of_ne (by decide)]
      norm_num
  have hP : (0 : Fin 2 → ℝ) ≤ ![3, 4] := by
    intro i
    fin_cases i <;> norm_num
  exact ⟨hc, hP, single_le_dotProduct hc hP⟩

/-- **Witness for `stepAdmissible_of_transfer` (the `StepAdmissible` bundle).** For coordinate
channels on `ℝ²` and the map `z ↦ R z`: `|R|` is a transfer matrix, `c = (1, 1) ≥ 0`, the
profiles are `≥ 0` and `|R|ᵀ c ≤ c' = (3, 2)`; hence `⟨c, |R z|⟩ ≤ ⟨c', |z|⟩` for every `z`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order; the 4D
channel constants are observations and enter only as hypotheses; nothing about the Yang–Mills
measure; (D), (E) and the mass gap remain open. -/
theorem witness_stepAdmissible_of_transfer :
    IsTransfer (fun z : Fin 2 → ℝ => wR *ᵥ z) coordProfile coordProfile (wR.map abs) ∧
      (0 : Fin 2 → ℝ) ≤ ![1, 1] ∧ (∀ z : Fin 2 → ℝ, 0 ≤ coordProfile z) ∧
      (wR.map abs)ᵀ *ᵥ ![1, 1] ≤ ![3, 2] ∧
      StepAdmissible (fun z : Fin 2 → ℝ => wR *ᵥ z) coordProfile coordProfile ![1, 1] ![3, 2] := by
  have hc : (0 : Fin 2 → ℝ) ≤ ![1, 1] := by
    intro i
    fin_cases i <;> norm_num
  exact ⟨coord_isTransfer wR, hc, coordProfile_nonneg, wR_transfer_steps.1,
    stepAdmissible_of_transfer (coord_isTransfer wR) hc coordProfile_nonneg wR_transfer_steps.1⟩

/-- **Witness for `transfer_le_of_stepAdmissible`.** The test vectors `e_s` isolate the
coordinate channels and are aligned with `|R|`, and the step from `(1, 1)` to `(3, 2)` is
admissible; hence `|R|ᵀ (1, 1) ≤ (3, 2)`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order; the 4D
channel constants are observations and enter only as hypotheses; nothing about the Yang–Mills
measure; (D), (E) and the mass gap remain open. -/
theorem witness_transfer_le_of_stepAdmissible :
    (∀ s : Fin 2, coordProfile (Pi.single s (1 : ℝ)) = Pi.single s 1) ∧
      (∀ s : Fin 2, coordProfile (wR *ᵥ Pi.single s 1) = wR.map abs *ᵥ Pi.single s 1) ∧
      StepAdmissible (fun z : Fin 2 → ℝ => wR *ᵥ z) coordProfile coordProfile ![1, 1] ![3, 2] ∧
      (wR.map abs)ᵀ *ᵥ ![1, 1] ≤ ![3, 2] := by
  have h := witness_stepAdmissible_of_transfer.2.2.2.2
  exact ⟨coord_isolation, coord_alignment wR, h,
    transfer_le_of_stepAdmissible (fun s => Pi.single s 1) coord_isolation (coord_alignment wR)
      h⟩

/-- **Witness for `stepAdmissible_iff`.** With the transfer matrix `|R|`, `c = (1, 1) ≥ 0`,
nonnegative profiles and the isolating, aligned test vectors `e_s`: the step from `(1, 1)` to
`(3, 2)` is admissible iff `|R|ᵀ (1, 1) ≤ (3, 2)`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order; the 4D
channel constants are observations and enter only as hypotheses; nothing about the Yang–Mills
measure; (D), (E) and the mass gap remain open. -/
theorem witness_stepAdmissible_iff :
    IsTransfer (fun z : Fin 2 → ℝ => wR *ᵥ z) coordProfile coordProfile (wR.map abs) ∧
      (0 : Fin 2 → ℝ) ≤ ![1, 1] ∧ (∀ z : Fin 2 → ℝ, 0 ≤ coordProfile z) ∧
      (∀ s : Fin 2, coordProfile (Pi.single s (1 : ℝ)) = Pi.single s 1) ∧
      (∀ s : Fin 2, coordProfile (wR *ᵥ Pi.single s 1) = wR.map abs *ᵥ Pi.single s 1) ∧
      (StepAdmissible (fun z : Fin 2 → ℝ => wR *ᵥ z) coordProfile coordProfile ![1, 1] ![3, 2] ↔
        (wR.map abs)ᵀ *ᵥ ![1, 1] ≤ ![3, 2]) := by
  have hc : (0 : Fin 2 → ℝ) ≤ ![1, 1] := witness_stepAdmissible_of_transfer.2.1
  exact ⟨coord_isTransfer wR, hc, coordProfile_nonneg, coord_isolation, coord_alignment wR,
    stepAdmissible_iff (coord_isTransfer wR) hc coordProfile_nonneg (fun s => Pi.single s 1)
      coord_isolation (coord_alignment wR)⟩

/-- **Witness for `isLeast_stepAdmissible`.** Under the hypotheses of
