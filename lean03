      (∀ s : Fin 2, coordProfile (wR *ᵥ Pi.single s 1) = wR.map abs *ᵥ Pi.single s 1) ∧
      IsLeast {c' | StepAdmissible (fun z : Fin 2 → ℝ => wR *ᵥ z) coordProfile coordProfile
        ![1, 1] c'} ((wR.map abs)ᵀ *ᵥ ![1, 1]) := by
  have hc : (0 : Fin 2 → ℝ) ≤ ![1, 1] := witness_stepAdmissible_of_transfer.2.1
