  have hh : |(1 / 2 : ℝ)| = 1 / 2 := abs_of_pos (by norm_num)
  rcases k with _ | _ | k
  · show |1 / 2 * y 0| + |1 / 2 * y 1| ≤ 1 * (|y 0| + |y 1|)
    rw [abs_mul, abs_mul, hh]
    linarith [abs_nonneg (y 0), abs_nonneg (y 1)]
  · show |y 0| ≤ 1 * (|y 0| + |y 1|)
    linarith [abs_nonneg (y 1)]
  · show |1 / 2 * y 0| ≤ 1 * |y 0|
    rw [abs_mul, hh]
    linarith [abs_nonneg (y 0)]

