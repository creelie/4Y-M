section Part1_DobrushinComparison

/-!
# The arithmetic core of the W₁ Dobrushin comparison

Lemma `comparison` of the forest-gauge paper has two halves.

1. **Measure theory.** A minimising coupling of two measures invariant under the single-site
   updates outside a set `S` satisfies `ρ e ≤ ∑ e', C e e' * ρ e'` for every `e ∉ S`, where
   `ρ e` is the expected link distance. This needs Kantorovich couplings and is not formalised
   here (item G1).
2. **Arithmetic.** From those inequalities, a weighted Dobrushin condition gives decay. This file
   proves that half for a finite index set, in two forms:

* `comparison_weighted` : the column-weighted form used in the paper,
  `∑_{e ∉ S} w e ρ e ≤ θ D / (1 - θ) · ∑_{z ∈ S} w z`,
  assuming `∑_e w e C e e' ≤ θ w e'` for every `e'`, and `ρ ≤ D` on `S`.
  With `S = ∅` it gives `ρ = 0` off `S`, i.e. uniqueness (`comparison_empty`).
* `decay_rowweighted` : the row-weighted (Bassalygo–Dobrushin) form,
  `ρ i ≤ B / (1 - α) · exp (-m d i k)`, when `ρ ≤ C ρ + b`, `b i ≤ B exp (-m d i k)`,
  and the weighted row sums `∑_j C i j exp (m d i j)` are at most `α < 1`.
  `sup_bound` is the case `m = 0`.

The paper allows infinitely many sites with summable weights. The finite case is the one
that finite-volume Gibbs measures need, and the infinite case follows from it by a limit,
which is not done here.
-/

open Finset Real

namespace YangMills.StrongCoupling.Comparison

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- **Column-weighted comparison.** The arithmetic of Lemma `comparison`. -/
theorem comparison_weighted (S : Finset ι) (C : ι → ι → ℝ) (w ρ : ι → ℝ)
    (θ D : ℝ) (hθ : θ < 1) (hθ0 : 0 ≤ θ)
    (hC : ∀ e e', 0 ≤ C e e') (hw : ∀ e, 0 ≤ w e) (hρ : ∀ e, 0 ≤ ρ e)
    (hρS : ∀ z ∈ S, ρ z ≤ D)
    (hmin : ∀ e ∉ S, ρ e ≤ ∑ e', C e e' * ρ e')
    (hcol : ∀ e', ∑ e, w e * C e e' ≤ θ * w e') :
    ∑ e ∈ Sᶜ, w e * ρ e ≤ θ * D / (1 - θ) * ∑ z ∈ S, w z := by
  set X := ∑ e ∈ Sᶜ, w e * ρ e
  set Y := ∑ z ∈ S, w z * ρ z
  -- Step 1: X ≤ θ (X + Y).
  have h1 : X ≤ ∑ e ∈ Sᶜ, w e * ∑ e', C e e' * ρ e' := by
    apply sum_le_sum
    intro e he
    exact mul_le_mul_of_nonneg_left (hmin e (by simpa using he)) (hw e)
  have h2 : ∑ e ∈ Sᶜ, w e * ∑ e', C e e' * ρ e' ≤ ∑ e, w e * ∑ e', C e e' * ρ e' := by
    apply sum_le_sum_of_subset_of_nonneg (subset_univ _)
    intro e _ _
    exact mul_nonneg (hw e) (sum_nonneg fun e' _ => mul_nonneg (hC e e') (hρ e'))
  have h3 : ∑ e, w e * ∑ e', C e e' * ρ e' = ∑ e', (∑ e, w e * C e e') * ρ e' := by
    simp_rw [mul_sum, sum_mul]
    rw [sum_comm]
    refine sum_congr rfl fun _ _ => sum_congr rfl fun _ _ => by ring
  have h4 : ∑ e', (∑ e, w e * C e e') * ρ e' ≤ ∑ e', θ * (w e' * ρ e') := by
    apply sum_le_sum
    intro e' _
    calc (∑ e, w e * C e e') * ρ e' ≤ (θ * w e') * ρ e' :=
          mul_le_mul_of_nonneg_right (hcol e') (hρ e')
      _ = θ * (w e' * ρ e') := by ring
  have h5 : ∑ e', θ * (w e' * ρ e') = θ * (X + Y) := by
    rw [← mul_sum, ← sum_compl_add_sum S]
  have hX : X ≤ θ * (X + Y) := by linarith
  -- Step 2: Y ≤ D ∑ w.
  have hY : Y ≤ D * ∑ z ∈ S, w z := by
    rw [mul_sum]
    apply sum_le_sum
    intro z hz
    calc w z * ρ z ≤ w z * D := mul_le_mul_of_nonneg_left (hρS z hz) (hw z)
      _ = D * w z := by ring
  -- Step 3: solve.
  have hpos : 0 < 1 - θ := by linarith
  have hX' : X * (1 - θ) ≤ θ * Y := by linarith
  have hXle : X ≤ θ * Y / (1 - θ) := by rw [le_div_iff₀ hpos]; linarith
  calc X ≤ θ * Y / (1 - θ) := hXle
    _ ≤ θ * (D * ∑ z ∈ S, w z) / (1 - θ) := by
        apply div_le_div_of_nonneg_right _ hpos.le
        exact mul_le_mul_of_nonneg_left hY hθ0
    _ = θ * D / (1 - θ) * ∑ z ∈ S, w z := by ring

/-- With `S = ∅` and positive weights, the distances vanish: uniqueness. -/
theorem comparison_empty (C : ι → ι → ℝ) (w ρ : ι → ℝ) (θ : ℝ) (hθ : θ < 1) (hθ0 : 0 ≤ θ)
    (hC : ∀ e e', 0 ≤ C e e') (hw : ∀ e, 0 < w e) (hρ : ∀ e, 0 ≤ ρ e)
    (hmin : ∀ e, ρ e ≤ ∑ e', C e e' * ρ e')
    (hcol : ∀ e', ∑ e, w e * C e e' ≤ θ * w e') :
    ∀ e, ρ e = 0 := by
  have h := comparison_weighted (∅ : Finset ι) C w ρ θ 0 hθ hθ0 hC (fun e => (hw e).le) hρ
    (by simp) (fun e _ => hmin e) hcol
  simp only [compl_empty, sum_empty, mul_zero] at h
  have hz := (sum_eq_zero_iff_of_nonneg (fun e _ => mul_nonneg (hw e).le (hρ e))).mp
    (le_antisymm h (sum_nonneg fun e _ => mul_nonneg (hw e).le (hρ e)))
  intro e
  have := hz e (mem_univ e)
  rcases mul_eq_zero.mp this with h0 | h0
  · exact absurd h0 (hw e).ne'
  · exact h0

omit [DecidableEq ι] in
/-- **Row-weighted decay** (Bassalygo–Dobrushin form). `d` is a pseudometric (only the
triangle inequality through `k` and `0 ≤ m` are used). -/
theorem decay_rowweighted [Nonempty ι] (C : ι → ι → ℝ) (ρ b : ι → ℝ) (d : ι → ι → ℝ)
    (k : ι) (m α B : ℝ) (hm : 0 ≤ m) (hα : α < 1)
    (hC : ∀ i j, 0 ≤ C i j) (hρ : ∀ i, 0 ≤ ρ i)
    (htri : ∀ i j, d i k ≤ d i j + d j k)
    (hrec : ∀ i, ρ i ≤ ∑ j, C i j * ρ j + b i)
    (hb : ∀ i, b i ≤ B * exp (-(m * d i k)))
    (hrow : ∀ i, ∑ j, C i j * exp (m * d i j) ≤ α) :
    ∀ i, ρ i ≤ B / (1 - α) * exp (-(m * d i k)) := by
  -- M = max over i of ρ i · exp (m d i k)
  set f : ι → ℝ := fun i => ρ i * exp (m * d i k)
  obtain ⟨i₀, -, hi₀⟩ := exists_max_image (univ : Finset ι) f univ_nonempty
  set M := f i₀
  have hf0 : ∀ i, 0 ≤ f i := fun i => mul_nonneg (hρ i) (exp_pos _).le
  have hM0 : 0 ≤ M := hf0 i₀
  have hfM : ∀ i, f i ≤ M := fun i => hi₀ i (mem_univ i)
  have key : ∀ i, f i ≤ α * M + B := by
    intro i
    have e1 : f i ≤ (∑ j, C i j * ρ j + b i) * exp (m * d i k) :=
      mul_le_mul_of_nonneg_right (hrec i) (exp_pos _).le
    have e2 : b i * exp (m * d i k) ≤ B := by
      calc b i * exp (m * d i k) ≤ B * exp (-(m * d i k)) * exp (m * d i k) :=
            mul_le_mul_of_nonneg_right (hb i) (exp_pos _).le
        _ = B := by rw [mul_assoc, ← exp_add]; simp
    have e3 : ∀ j, C i j * ρ j * exp (m * d i k) ≤ C i j * exp (m * d i j) * M := by
      intro j
      have hexp : exp (m * d i k) ≤ exp (m * d i j) * exp (m * d j k) := by
        rw [← exp_add]
        apply exp_le_exp.mpr
        have := mul_le_mul_of_nonneg_left (htri i j) hm
        linarith
      calc C i j * ρ j * exp (m * d i k)
          ≤ C i j * ρ j * (exp (m * d i j) * exp (m * d j k)) :=
            mul_le_mul_of_nonneg_left hexp (mul_nonneg (hC i j) (hρ j))
        _ = C i j * exp (m * d i j) * f j := by simp only [f]; ring
        _ ≤ C i j * exp (m * d i j) * M :=
            mul_le_mul_of_nonneg_left (hfM j) (mul_nonneg (hC i j) (exp_pos _).le)
    have e4 : (∑ j, C i j * ρ j) * exp (m * d i k) ≤ α * M := by
      rw [sum_mul]
      calc ∑ j, C i j * ρ j * exp (m * d i k) ≤ ∑ j, C i j * exp (m * d i j) * M :=
            sum_le_sum fun j _ => e3 j
        _ = (∑ j, C i j * exp (m * d i j)) * M := by rw [sum_mul]
        _ ≤ α * M := mul_le_mul_of_nonneg_right (hrow i) hM0
    calc f i ≤ (∑ j, C i j * ρ j + b i) * exp (m * d i k) := e1
      _ = (∑ j, C i j * ρ j) * exp (m * d i k) + b i * exp (m * d i k) := by ring
      _ ≤ α * M + B := add_le_add e4 e2
  have hpos : 0 < 1 - α := by linarith
  have hMB : M ≤ B / (1 - α) := by
    rw [le_div_iff₀ hpos]; have := key i₀; linarith
  intro i
  have hi : ρ i * exp (m * d i k) ≤ B / (1 - α) := (hfM i).trans hMB
  have hE : 0 < exp (m * d i k) := exp_pos _
  calc ρ i = ρ i * exp (m * d i k) * exp (-(m * d i k)) := by
        rw [mul_assoc, ← exp_add]; simp
    _ ≤ B / (1 - α) * exp (-(m * d i k)) :=
        mul_le_mul_of_nonneg_right hi (exp_pos _).le

omit [DecidableEq ι] in
/-- The case `m = 0`: a uniform bound `ρ ≤ B / (1 - α)`. -/
theorem sup_bound [Nonempty ι] (C : ι → ι → ℝ) (ρ b : ι → ℝ) (α B : ℝ) (hα : α < 1)
    (hC : ∀ i j, 0 ≤ C i j) (hρ : ∀ i, 0 ≤ ρ i)
    (hrec : ∀ i, ρ i ≤ ∑ j, C i j * ρ j + b i) (hb : ∀ i, b i ≤ B)
    (hrow : ∀ i, ∑ j, C i j ≤ α) :
    ∀ i, ρ i ≤ B / (1 - α) := by
  intro i
  have := decay_rowweighted C ρ b (fun _ _ => 0) (Classical.arbitrary ι) 0 α B le_rfl hα hC hρ
    (fun _ _ => by simp) hrec (fun i => by simpa using hb i) (fun i => by simpa using hrow i) i
  simpa using this

end YangMills.StrongCoupling.Comparison

end Part1_DobrushinComparison

section Part2_CouplingMinimality

/-!
# Minimality supplies a discrepancy recurrence without stationarity

This is an abstract finite-dimensional interface. `P` may be a type of
couplings with fixed marginals, `d p i` an expected coordinate discrepancy,
and `update i` a coupling obtained by a local coupled update. No existence
of couplings, measurable update kernels, or minimisers is asserted here.

A weighted-cost minimiser need not be invariant under individual coupled
updates. Minimality and preservation of the other discrepancies suffice.
The final theorem feeds this recurrence into the existing comparison core.
-/

open Finset

namespace YangMills.StrongCoupling.CouplingMinimality

variable {ι P : Type*} [Fintype ι] [DecidableEq ι]

/-- The finite weighted discrepancy cost of an abstract coupling. -/
def cost (w : ι → ℝ) (d : P → ι → ℝ) (p : P) : ℝ := ∑ i, w i * d p i

/-- A local update changes only its own summand in the total cost. -/
lemma cost_update (w : ι → ℝ) (d : P → ι → ℝ) (p q : P) (i : ι)
    (hfix : ∀ j, j ≠ i → d q j = d p j) :
    cost w d q = cost w d p + w i * (d q i - d p i) := by
  have hterm : ∀ j, w j * d q j = w j * d p j +
      if j = i then w i * (d q i - d p i) else 0 := by
    intro j
    by_cases h : j = i
    · subst j; simp only [ite_true]; ring
    · simp [h, hfix j h]
  simp only [cost, hterm, sum_add_distrib]
  simp

/-- Approximate cost minimality gives the local discrepancy inequality,
with its precise weight-dependent error. No sign hypotheses on d or b. -/
theorem recurrence_with_error (w : ι → ℝ) (d : P → ι → ℝ) (p q : P)
    (C : ι → ι → ℝ) (b : ι → ℝ) (i : ι) (ε : ℝ) (hw : 0 < w i)
    (hmin : cost w d p ≤ cost w d q + ε)
    (hfix : ∀ j, j ≠ i → d q j = d p j)
    (hstep : d q i ≤ ∑ j, C i j * d p j + b i) :
    d p i ≤ ∑ j, C i j * d p j + b i + ε / w i := by
  have hc := cost_update w d p q i hfix
  have hlocal : w i * d p i ≤ w i * d q i + ε := by linarith
  have hstep' := mul_le_mul_of_nonneg_left hstep hw.le
  apply (mul_le_mul_iff_right₀ hw).mp
  have hne : w i ≠ 0 := ne_of_gt hw
  have he : w i * (ε / w i) = ε := by field_simp
  rw [mul_add, he]
  linarith

/-- Exact cost minimality replaces stationary-coupling invariance. -/
theorem recurrence_of_minimality (w : ι → ℝ) (d : P → ι → ℝ) (p q : P)
    (C : ι → ι → ℝ) (b : ι → ℝ) (i : ι) (hw : 0 < w i)
    (hmin : cost w d p ≤ cost w d q)
    (hfix : ∀ j, j ≠ i → d q j = d p j)
    (hstep : d q i ≤ ∑ j, C i j * d p j + b i) :
    d p i ≤ ∑ j, C i j * d p j + b i := by
  simpa using recurrence_with_error w d p q C b i 0 hw
    (by simpa using hmin) hfix hstep

/-- The finite weighted boundary comparison from minimality of the coupling
cost. The hypotheses concerning the abstract updates remain explicit. -/
theorem comparison_of_minimality (S : Finset ι) (w : ι → ℝ)
    (d : P → ι → ℝ) (p : P) (update : ι → P) (C : ι → ι → ℝ)
    (θ D : ℝ) (hθ : θ < 1) (hθ0 : 0 ≤ θ)
    (hC : ∀ i j, 0 ≤ C i j) (hw : ∀ i, 0 < w i)
    (hd : ∀ i, 0 ≤ d p i) (hD : ∀ i ∈ S, d p i ≤ D)
    (hmin : ∀ i ∉ S, cost w d p ≤ cost w d (update i))
    (hfix : ∀ i ∉ S, ∀ j, j ≠ i → d (update i) j = d p j)
    (hstep : ∀ i ∉ S, d (update i) i ≤ ∑ j, C i j * d p j)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j) :
    ∑ i ∈ Sᶜ, w i * d p i ≤ θ * D / (1 - θ) * ∑ j ∈ S, w j := by
  apply Comparison.comparison_weighted S C w (d p) θ D hθ hθ0 hC
    (fun i => (hw i).le) hd hD _ hcol
  intro i hi
  simpa using recurrence_of_minimality w d p (update i) C (fun _ => 0) i
    (hw i) (hmin i hi) (hfix i hi) (by simpa using hstep i hi)

end YangMills.StrongCoupling.CouplingMinimality

end Part2_CouplingMinimality

section Part3_WassersteinComparisonBridge

/-!
# From couplings to the weighted Dobrushin comparison

Part 1 (`DobrushinComparison`) proves the arithmetic half of Lemma `comparison` of
the forest-gauge paper (item G1): from the
inequalities `ρ e ≤ ∑ e', C e e' * ρ e'` it derives decay. This file adds three things.

1. **The resolvent.** For a nonnegative `C` with weighted column sums `∑ i, w i * C i j ≤ θ * w j`,
   `θ < 1`, the Neumann series `∑ₖ Cᵏ` converges (entrywise, which in finite dimension is
   convergence in every norm), its sum `G` is a nonnegative two-sided inverse of `1 - C`, every
   complex eigenvalue of `C` has modulus at most `θ`, and `G` controls subsolutions, exact
   solutions and their perturbations in the weighted `ℓ¹` norm (`neumann_*`, `subsolution_le_resolvent`,
   `fixedPoint_stability`, `opNorm_*`). Stability is proved only for exact fixed points and under a
   discrepancy inequality; `one_sided_no_stability` shows that two one-sided subsolution inequalities
   do not give it.
2. **Decay with a floor and finite propagation.** `decay_with_floor` adds a constant source `ε` to
   `decay_rowweighted`, at the price of `ε / (1 - α₀)`; `floor_necessary` and `floor_attained` show
   that this term can be neither dropped nor improved. `finite_propagation` and `resolvent_tail`
   localise `Cⁿ b` and `G b` when `C` has range `R`.
3. **The measure-theoretic interface.** Couplings, the Kantorovich distance `W1`, the bound
   `|∫ f dμ - ∫ f dν| ≤ L ∫ d dγ` for Lipschitz `f`, the fact that a coupled update with the right
   marginals maps couplings to couplings, and the discrepancy recurrence for a coupling that is
   invariant under the coupled updates (`stationary_recurrence`), or only under their average, the
   random-scan update (`random_scan_recurrence`). `coupled_comparison` and `random_scan_comparison`
   chain these recurrences into the weighted comparison.

What is **not** proved here is the existence, for the SU(2) specification, of the objects that
`coupled_comparison` and `random_scan_comparison` take as hypotheses: a measurable coupled update
kernel for each site whose expected discrepancy is bounded by the Dobrushin coefficients (this
needs optimal or approximately optimal Kantorovich couplings of the conditional laws, chosen
measurably in the boundary condition), and a coupling invariant under all of them, or only under
their average. Those are the remaining parts of G1.
Nothing here concerns the lattice gauge measure, a transfer matrix or a continuum limit.
-/

open Finset Real Matrix

namespace YangMills.StrongCoupling.WassersteinBridge

section Resolvent

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The weighted `ℓ¹` norm `∑ i, w i * |x i|`. -/
def wnorm (w x : ι → ℝ) : ℝ := ∑ i, w i * |x i|

/-- The Neumann sum `∑ₖ Cᵏ` (the zero matrix if the series is not summable). -/
noncomputable def neumann (C : Matrix ι ι ℝ) : Matrix ι ι ℝ := ∑' k : ℕ, C ^ k

omit [DecidableEq ι] in
lemma wnorm_nonneg (w x : ι → ℝ) (hw : ∀ i, 0 ≤ w i) : 0 ≤ wnorm w x :=
  sum_nonneg fun i _ => mul_nonneg (hw i) (abs_nonneg _)

omit [DecidableEq ι] in
/-- Exchange of the order of summation in `∑ i, w i * (C x) i`. -/
lemma weighted_mulVec_eq (C : Matrix ι ι ℝ) (w x : ι → ℝ) :
    ∑ i, w i * (C *ᵥ x) i = ∑ j, (∑ i, w i * C i j) * x j := by
  simp only [mulVec, dotProduct, mul_sum, sum_mul]
  rw [sum_comm]
  exact sum_congr rfl fun _ _ => sum_congr rfl fun _ _ => by ring

omit [DecidableEq ι] in
/-- One step of the column condition on a nonnegative vector. -/
lemma weighted_mulVec_le (C : Matrix ι ι ℝ) (w x : ι → ℝ) (θ : ℝ)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j) (hx : ∀ j, 0 ≤ x j) :
    ∑ i, w i * (C *ᵥ x) i ≤ θ * ∑ i, w i * x i := by
  rw [weighted_mulVec_eq, mul_sum]
  exact sum_le_sum fun j _ => by
    calc (∑ i, w i * C i j) * x j ≤ (θ * w j) * x j := mul_le_mul_of_nonneg_right (hcol j) (hx j)
      _ = θ * (w j * x j) := by ring

omit [DecidableEq ι] in
lemma mulVec_nonneg (A : Matrix ι ι ℝ) (x : ι → ℝ) (hA : ∀ i j, 0 ≤ A i j) (hx : ∀ j, 0 ≤ x j) :
    ∀ i, 0 ≤ (A *ᵥ x) i := fun i => sum_nonneg fun j _ => mul_nonneg (hA i j) (hx j)

omit [DecidableEq ι] in
lemma mulVec_mono (A : Matrix ι ι ℝ) (x y : ι → ℝ) (hA : ∀ i j, 0 ≤ A i j) (hxy : ∀ j, x j ≤ y j) :
    ∀ i, (A *ᵥ x) i ≤ (A *ᵥ y) i :=
  fun i => sum_le_sum fun j _ => mul_le_mul_of_nonneg_left (hxy j) (hA i j)

omit [DecidableEq ι] in
/-- `|A x| ≤ A |x|` for a nonnegative matrix. -/
lemma abs_mulVec_le (A : Matrix ι ι ℝ) (x : ι → ℝ) (hA : ∀ i j, 0 ≤ A i j) :
    ∀ i, |(A *ᵥ x) i| ≤ (A *ᵥ fun j => |x j|) i := by
  intro i
  calc |(A *ᵥ x) i| = |∑ j, A i j * x j| := rfl
    _ ≤ ∑ j, |A i j * x j| := Finset.abs_sum_le_sum_abs _ _
    _ = ∑ j, A i j * |x j| := sum_congr rfl fun j _ => by rw [abs_mul, abs_of_nonneg (hA i j)]

/-- Column `j` of `A`: `A e_j`. -/
lemma mulVec_single_one (A : Matrix ι ι ℝ) (j i : ι) : (A *ᵥ Pi.single j 1) i = A i j := by
  simp [mulVec, dotProduct, Pi.single_apply]

lemma pow_nonneg' (C : Matrix ι ι ℝ) (hC : ∀ i j, 0 ≤ C i j) :
    ∀ n : ℕ, ∀ i j, 0 ≤ (C ^ n) i j := by
  intro n
  induction n with
  | zero => intro i j; rw [pow_zero, one_apply]; split_ifs <;> norm_num
  | succ n ih =>
    intro i j
    rw [pow_succ', mul_apply]
    exact sum_nonneg fun k _ => mul_nonneg (hC i k) (ih k j)

/-! ### Proposition A: weighted resolvent comparison -/

omit [DecidableEq ι] in
/-- **Proposition A.** A nonnegative subsolution `ρ ≤ C ρ + b` of a weighted column contraction
satisfies `∑ w ρ ≤ (1 / (1 - θ)) ∑ w b`. Only `w ≥ 0`, `ρ ≥ 0` and `θ < 1` are used; `C ≥ 0`,
`b ≥ 0`, `w > 0` and `θ ≥ 0` are not needed. -/
theorem resolvent_comparison (C : Matrix ι ι ℝ) (w ρ b : ι → ℝ) (θ : ℝ) (hθ : θ < 1)
    (hw : ∀ i, 0 ≤ w i) (hρ : ∀ i, 0 ≤ ρ i)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j)
    (hrec : ∀ i, ρ i ≤ (C *ᵥ ρ) i + b i) :
    ∑ i, w i * ρ i ≤ 1 / (1 - θ) * ∑ i, w i * b i := by
  have h1 : ∑ i, w i * ρ i ≤ ∑ i, w i * (C *ᵥ ρ) i + ∑ i, w i * b i := by
    rw [← sum_add_distrib]
    exact sum_le_sum fun i _ => by rw [← mul_add]; exact mul_le_mul_of_nonneg_left (hrec i) (hw i)
  have h2 := weighted_mulVec_le C w ρ θ hcol hρ
  have hpos : 0 < 1 - θ := by linarith
  rw [div_mul_eq_mul_div, one_mul, le_div_iff₀ hpos]
  nlinarith

omit [DecidableEq ι] in
/-- Proposition A is attained: one site, `C = θ`, `w = 1`, `ρ = b / (1 - θ)`. -/
theorem resolvent_comparison_attained (θ β : ℝ) (hθ : θ < 1) :
    let ρ : Unit → ℝ := fun _ => β / (1 - θ)
    (∀ i, ρ i = ((fun _ _ => θ : Matrix Unit Unit ℝ) *ᵥ ρ) i + β) ∧
      ∑ i, (1 : ℝ) * ρ i = 1 / (1 - θ) * ∑ _i : Unit, (1 : ℝ) * β := by
  have hpos : (1 - θ) ≠ 0 := by linarith
  refine ⟨fun i => ?_, ?_⟩
  · simp only [mulVec, dotProduct, Finset.univ_unique, Finset.sum_singleton]
    field_simp
    ring
  · simp only [Finset.univ_unique, Finset.sum_singleton, one_mul]
    ring

omit [DecidableEq ι] in
/-- Proposition A with `b = 0` gives back the conclusion of `Comparison.comparison_empty`
(uniqueness), from the same hypotheses. -/
theorem comparison_empty_of_resolvent (C : ι → ι → ℝ) (w ρ : ι → ℝ) (θ : ℝ) (hθ : θ < 1)
    (hw : ∀ e, 0 < w e) (hρ : ∀ e, 0 ≤ ρ e)
    (hmin : ∀ e, ρ e ≤ ∑ e', C e e' * ρ e')
    (hcol : ∀ e', ∑ e, w e * C e e' ≤ θ * w e') :
    ∀ e, ρ e = 0 := by
  have h := resolvent_comparison C w ρ 0 θ hθ (fun e => (hw e).le) hρ hcol
    (fun e => by simpa [mulVec, dotProduct] using hmin e)
  simp only [Pi.zero_apply, mul_zero, sum_const_zero] at h
  have hz := (sum_eq_zero_iff_of_nonneg fun e _ => mul_nonneg (hw e).le (hρ e)).mp
    (le_antisymm h (sum_nonneg fun e _ => mul_nonneg (hw e).le (hρ e)))
  intro e
  rcases mul_eq_zero.mp (hz e (mem_univ e)) with h0 | h0
  · exact absurd h0 (hw e).ne'
  · exact h0

/-! ### Proposition B: contraction of matrix powers -/

/-- **Proposition B (nonnegative vectors).** `∑ w (Cⁿ b) ≤ θⁿ ∑ w b`. -/
theorem weighted_pow_le (C : Matrix ι ι ℝ) (w b : ι → ℝ) (θ : ℝ) (hθ0 : 0 ≤ θ)
    (hC : ∀ i j, 0 ≤ C i j) (hb : ∀ i, 0 ≤ b i)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j) :
    ∀ n : ℕ, ∑ i, w i * ((C ^ n) *ᵥ b) i ≤ θ ^ n * ∑ i, w i * b i := by
  intro n
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ', ← mulVec_mulVec]
    have hnn : ∀ j, 0 ≤ ((C ^ n) *ᵥ b) j := mulVec_nonneg _ _ (pow_nonneg' C hC n) hb
    calc ∑ i, w i * (C *ᵥ ((C ^ n) *ᵥ b)) i ≤ θ * ∑ i, w i * ((C ^ n) *ᵥ b) i :=
          weighted_mulVec_le C w _ θ hcol hnn
      _ ≤ θ * (θ ^ n * ∑ i, w i * b i) := mul_le_mul_of_nonneg_left ih hθ0
      _ = θ ^ (n + 1) * ∑ i, w i * b i := by ring

omit [DecidableEq ι] in
/-- The weighted `ℓ¹` norm contracts by `θ` for signed vectors: `‖C x‖ ≤ θ ‖x‖`. -/
theorem wnorm_mulVec_le (C : Matrix ι ι ℝ) (w x : ι → ℝ) (θ : ℝ)
    (hC : ∀ i j, 0 ≤ C i j) (hw : ∀ i, 0 ≤ w i)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j) :
    wnorm w (C *ᵥ x) ≤ θ * wnorm w x := by
  unfold wnorm
  calc ∑ i, w i * |(C *ᵥ x) i| ≤ ∑ i, w i * (C *ᵥ fun j => |x j|) i :=
        sum_le_sum fun i _ => mul_le_mul_of_nonneg_left (abs_mulVec_le C x hC i) (hw i)
    _ ≤ θ * ∑ i, w i * |x i| := weighted_mulVec_le C w _ θ hcol fun j => abs_nonneg _

/-- **Proposition B (signed vectors).** `‖Cⁿ x‖₁,w ≤ θⁿ ‖x‖₁,w`. -/
theorem wnorm_pow_le (C : Matrix ι ι ℝ) (w x : ι → ℝ) (θ : ℝ) (hθ0 : 0 ≤ θ)
    (hC : ∀ i j, 0 ≤ C i j) (hw : ∀ i, 0 ≤ w i)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j) :
    ∀ n : ℕ, wnorm w ((C ^ n) *ᵥ x) ≤ θ ^ n * wnorm w x := by
  intro n
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ', ← mulVec_mulVec]
    calc wnorm w (C *ᵥ ((C ^ n) *ᵥ x)) ≤ θ * wnorm w ((C ^ n) *ᵥ x) :=
          wnorm_mulVec_le C w _ θ hC hw hcol
      _ ≤ θ * (θ ^ n * wnorm w x) := mul_le_mul_of_nonneg_left ih hθ0
      _ = θ ^ (n + 1) * wnorm w x := by ring

/-! ### Proposition C: finite and infinite Neumann sums -/

/-- **Proposition C (finite sums).**
`∑ w (∑ₖ₌₀ᴺ Cᵏ b) ≤ ((1 - θᴺ⁺¹) / (1 - θ)) ∑ w b`. -/
theorem weighted_neumann_partial_le (C : Matrix ι ι ℝ) (w b : ι → ℝ) (θ : ℝ)
    (hθ : θ < 1) (hθ0 : 0 ≤ θ) (hC : ∀ i j, 0 ≤ C i j) (hb : ∀ i, 0 ≤ b i)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j) (N : ℕ) :
    ∑ i, w i * ((∑ k ∈ range (N + 1), C ^ k) *ᵥ b) i
      ≤ (1 - θ ^ (N + 1)) / (1 - θ) * ∑ i, w i * b i := by
  have hsplit : ∑ i, w i * ((∑ k ∈ range (N + 1), C ^ k) *ᵥ b) i
      = ∑ k ∈ range (N + 1), ∑ i, w i * ((C ^ k) *ᵥ b) i := by
    rw [sum_comm]
    refine sum_congr rfl fun i _ => ?_
    rw [Matrix.sum_mulVec, Finset.sum_apply, mul_sum]
  rw [hsplit]
  calc ∑ k ∈ range (N + 1), ∑ i, w i * ((C ^ k) *ᵥ b) i
      ≤ ∑ k ∈ range (N + 1), θ ^ k * ∑ i, w i * b i :=
        sum_le_sum fun k _ => weighted_pow_le C w b θ hθ0 hC hb hcol k
    _ = (∑ k ∈ range (N + 1), θ ^ k) * ∑ i, w i * b i := by rw [sum_mul]
    _ = (1 - θ ^ (N + 1)) / (1 - θ) * ∑ i, w i * b i := by
        rw [geom_sum_eq (by linarith : θ ≠ 1)]
        congr 1
        have h1 : θ - 1 ≠ 0 := by linarith
        have h2 : 1 - θ ≠ 0 := by linarith
        field_simp
        ring

/-- Entry bound under the column condition: `(Cᵏ) i j ≤ θᵏ w j / w i`. -/
theorem pow_entry_le (C : Matrix ι ι ℝ) (w : ι → ℝ) (θ : ℝ) (hθ0 : 0 ≤ θ)
    (hC : ∀ i j, 0 ≤ C i j) (hw : ∀ i, 0 < w i)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j) (k : ℕ) (i j : ι) :
    (C ^ k) i j ≤ θ ^ k * (w j / w i) := by
  have hcolk := weighted_pow_le C w (Pi.single j 1) θ hθ0 hC
    (fun l => by by_cases h : l = j <;> simp [h]) hcol k
  have hcolk' : ∑ l, w l * (C ^ k) l j ≤ θ ^ k * w j := by
    have e1 : ∀ l, ((C ^ k) *ᵥ Pi.single j 1) l = (C ^ k) l j := fun l => by
      simp [mulVec_single]
    have e2 : ∑ l, w l * (Pi.single j (1 : ℝ) : ι → ℝ) l = w j := by
      simp [Pi.single_apply]
    simpa only [e1, e2] using hcolk
  have hsingle : w i * (C ^ k) i j ≤ ∑ l, w l * (C ^ k) l j :=
    single_le_sum (f := fun l => w l * (C ^ k) l j)
      (fun l _ => mul_nonneg (hw l).le (pow_nonneg' C hC k l j)) (mem_univ i)
  rw [mul_div_assoc', le_div_iff₀ (hw i)]
  linarith [mul_comm (w i) ((C ^ k) i j)]

/-- **Proposition C (convergence).** Under the column condition the Neumann series converges in
the topology of `Matrix ι ι ℝ` (the product topology, which is the topology of every norm), to
`neumann C`. -/
theorem neumann_hasSum (C : Matrix ι ι ℝ) (w : ι → ℝ) (θ : ℝ) (hθ : θ < 1) (hθ0 : 0 ≤ θ)
    (hC : ∀ i j, 0 ≤ C i j) (hw : ∀ i, 0 < w i)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j) :
    HasSum (fun k : ℕ => C ^ k) (neumann C) := by
  have hs : Summable (fun k : ℕ => C ^ k) := by
    refine Pi.summable.mpr fun i => Pi.summable.mpr fun j => ?_
    exact Summable.of_nonneg_of_le (fun k => pow_nonneg' C hC k i j)
      (fun k => pow_entry_le C w θ hθ0 hC hw hcol k i j)
      ((summable_geometric_of_lt_one hθ0 hθ).mul_right _)
  exact hs.hasSum

/-- Entries of the Neumann sum are the sums of the entries. -/
lemma neumann_apply (C : Matrix ι ι ℝ) (hs : Summable (fun k : ℕ => C ^ k)) (i j : ι) :
    neumann C i j = ∑' k : ℕ, (C ^ k) i j := by
  have h := Pi.hasSum.mp (Pi.hasSum.mp hs.hasSum i) j
  unfold neumann
  exact h.tsum_eq.symm

/-- Algebra of a summable Neumann series: `neumann C` is a two-sided inverse of `1 - C`. -/
theorem neumann_inverse (C : Matrix ι ι ℝ) (hs : Summable (fun k : ℕ => C ^ k)) :
    (1 - C) * neumann C = 1 ∧ neumann C * (1 - C) = 1 ∧ (1 - C)⁻¹ = neumann C := by
  have hshift : neumann C = 1 + ∑' k : ℕ, C ^ (k + 1) := by
    unfold neumann
    rw [hs.tsum_eq_zero_add, pow_zero]
  have hl : C * neumann C = ∑' k : ℕ, C ^ (k + 1) := by
    unfold neumann
    rw [← hs.tsum_mul_left]
    simp only [pow_succ']
  have hr : neumann C * C = ∑' k : ℕ, C ^ (k + 1) := by
    unfold neumann
    rw [← hs.tsum_mul_right]
    simp only [pow_succ]
  have h1 : (1 - C) * neumann C = 1 := by
    rw [sub_mul, one_mul, hl]
    nth_rewrite 1 [hshift]
    abel
  have h2 : neumann C * (1 - C) = 1 := by
    rw [mul_sub, mul_one, hr]
    nth_rewrite 1 [hshift]
    abel
  exact ⟨h1, h2, Matrix.inv_eq_right_inv h1⟩

lemma neumann_nonneg (C : Matrix ι ι ℝ) (hC : ∀ i j, 0 ≤ C i j)
    (hs : Summable (fun k : ℕ => C ^ k)) (i j : ι) : 0 ≤ neumann C i j := by
  rw [neumann_apply C hs]
  exact tsum_nonneg fun k => pow_nonneg' C hC k i j

/-- **Proposition C (resolvent).** Under the column condition, `G = neumann C` satisfies
`G = (1 - C)⁻¹`, `(1 - C) G = G (1 - C) = 1`, `G ≥ 0`, and the weighted column sums of `G` are
at most `w j / (1 - θ)`. -/
theorem resolvent_of_column (C : Matrix ι ι ℝ) (w : ι → ℝ) (θ : ℝ) (hθ : θ < 1) (hθ0 : 0 ≤ θ)
    (hC : ∀ i j, 0 ≤ C i j) (hw : ∀ i, 0 < w i)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j) :
    (1 - C)⁻¹ = neumann C ∧ (1 - C) * neumann C = 1 ∧ neumann C * (1 - C) = 1 ∧
      (∀ i j, 0 ≤ neumann C i j) ∧
      (∀ j, ∑ i, w i * neumann C i j ≤ w j / (1 - θ)) := by
  have hs := (neumann_hasSum C w θ hθ hθ0 hC hw hcol).summable
  obtain ⟨h1, h2, h3⟩ := neumann_inverse C hs
  refine ⟨h3, h1, h2, neumann_nonneg C hC hs, fun j => ?_⟩
  -- column `j` of `G = 1 + C G`
  have hGeq : neumann C = 1 + C * neumann C := by
    calc neumann C = (1 - C) * neumann C + C * neumann C := by rw [sub_mul, one_mul]; abel
      _ = 1 + C * neumann C := by rw [h1]
  have hG : ∀ i, neumann C i j = (if i = j then 1 else 0) + ∑ l, C i l * neumann C l j := by
    intro i
    have := congrArg (fun M : Matrix ι ι ℝ => M i j) hGeq
    simpa only [Matrix.add_apply, Matrix.one_apply, Matrix.mul_apply] using this
  have hGnn := neumann_nonneg C hC hs
  have key : ∑ i, w i * neumann C i j ≤ w j + θ * ∑ i, w i * neumann C i j := by
    have e : ∑ i, w i * neumann C i j
        = ∑ i, w i * (if i = j then 1 else 0) + ∑ i, w i * (C *ᵥ fun l => neumann C l j) i := by
      rw [← sum_add_distrib]
      exact sum_congr rfl fun i _ => by rw [hG i, mul_add]; rfl
    have hδ : ∑ i, w i * (if i = j then (1 : ℝ) else 0) = w j := by
      simp only [mul_ite, mul_one, mul_zero, sum_ite_eq', mem_univ, if_true]
    have := weighted_mulVec_le C w (fun l => neumann C l j) θ hcol fun l => hGnn l j
    linarith
  have hpos : 0 < 1 - θ := by linarith
  rw [le_div_iff₀ hpos]
  linarith

omit [DecidableEq ι] in
/-- **Spectral bound.** Every complex eigenvalue of `C` has modulus at most `θ`; in finite
dimension this is `r(C) ≤ θ`. -/
theorem eigenvalue_norm_le (C : Matrix ι ι ℝ) (w : ι → ℝ) (θ : ℝ)
    (hC : ∀ i j, 0 ≤ C i j) (hw : ∀ i, 0 < w i)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j)
    (μ : ℂ) (v : ι → ℂ) (hv : v ≠ 0) (heig : (C.map (↑) : Matrix ι ι ℂ) *ᵥ v = μ • v) :
    ‖μ‖ ≤ θ := by
  set N := ∑ i, w i * ‖v i‖ with hN
  have hNpos : 0 < N := by
    obtain ⟨i₀, hi₀⟩ : ∃ i, v i ≠ 0 := by
      by_contra h
      exact hv (funext fun i => not_not.mp fun hi => h ⟨i, hi⟩)
    have hle : w i₀ * ‖v i₀‖ ≤ N :=
      single_le_sum (f := fun i => w i * ‖v i‖)
        (fun i _ => mul_nonneg (hw i).le (norm_nonneg _)) (mem_univ i₀)
    have : 0 < w i₀ * ‖v i₀‖ := mul_pos (hw i₀) (norm_pos_iff.mpr hi₀)
    linarith
  have hrow : ∀ i, ‖μ‖ * ‖v i‖ ≤ ∑ j, C i j * ‖v j‖ := by
    intro i
    have := congrFun heig i
    simp only [Pi.smul_apply, smul_eq_mul, mulVec, dotProduct, map_apply] at this
    calc ‖μ‖ * ‖v i‖ = ‖μ * v i‖ := (norm_mul _ _).symm
      _ = ‖∑ j, (C i j : ℂ) * v j‖ := by rw [this]
      _ ≤ ∑ j, ‖(C i j : ℂ) * v j‖ := norm_sum_le _ _
      _ = ∑ j, C i j * ‖v j‖ := sum_congr rfl fun j _ => by
          rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (hC i j)]
  have hsum : ‖μ‖ * N ≤ θ * N := by
    calc ‖μ‖ * N = ∑ i, w i * (‖μ‖ * ‖v i‖) := by
          rw [hN, mul_sum]; exact sum_congr rfl fun i _ => by ring
      _ ≤ ∑ i, w i * (C *ᵥ fun j => ‖v j‖) i :=
          sum_le_sum fun i _ => mul_le_mul_of_nonneg_left (hrow i) (hw i).le
      _ ≤ θ * N := weighted_mulVec_le C w _ θ hcol fun j => norm_nonneg _
  exact le_of_mul_le_mul_right hsum hNpos

/-! ### Proposition E: comparison, stability, operator norm, monotonicity -/

/-- **E1 (upper comparison).** If `G (1 - C) = 1` and `G ≥ 0`, every real subsolution
`ρ ≤ C ρ + b` satisfies `ρ ≤ G b`. No sign condition on `ρ` or `b`. -/
theorem subsolution_le_resolvent (C G : Matrix ι ι ℝ) (hGinv : G * (1 - C) = 1)
    (hG : ∀ i j, 0 ≤ G i j) (ρ b : ι → ℝ) (hrec : ∀ i, ρ i ≤ (C *ᵥ ρ) i + b i) :
    ∀ i, ρ i ≤ (G *ᵥ b) i := by
  set r : ι → ℝ := fun i => (C *ᵥ ρ) i + b i - ρ i
  have hr : ∀ i, 0 ≤ r i := fun i => by simp only [r]; linarith [hrec i]
  have hb : b = (1 - C) *ᵥ ρ + r := by
    funext i
    simp only [r, Pi.add_apply, sub_mulVec, one_mulVec, Pi.sub_apply]
    ring
  have hGb : G *ᵥ b = ρ + G *ᵥ r := by
    rw [hb, mulVec_add, mulVec_mulVec, hGinv, one_mulVec]
  intro i
  rw [hGb, Pi.add_apply]
  linarith [mulVec_nonneg G r hG hr i]

omit [DecidableEq ι] in
/-- **E4 (monotonicity).** `b ≤ b' ⇒ G b ≤ G b'` for `G ≥ 0`. -/
theorem resolvent_mono (G : Matrix ι ι ℝ) (hG : ∀ i j, 0 ≤ G i j) (b b' : ι → ℝ)
    (hbb : ∀ i, b i ≤ b' i) : ∀ i, (G *ᵥ b) i ≤ (G *ᵥ b') i :=
  mulVec_mono G b b' hG hbb

/-- **E2 (stability of exact fixed points).** If `u = C u + b` and `u' = C u' + b'` then
`u - u' = G (b - b')` and `|u - u'| ≤ G |b - b'|`. -/
theorem fixedPoint_stability (C G : Matrix ι ι ℝ) (hGinv : G * (1 - C) = 1)
    (hG : ∀ i j, 0 ≤ G i j) (u u' b b' : ι → ℝ)
    (hu : u = C *ᵥ u + b) (hu' : u' = C *ᵥ u' + b') :
    u - u' = G *ᵥ (b - b') ∧ ∀ i, |u i - u' i| ≤ (G *ᵥ fun j => |b j - b' j|) i := by
  have hb : b = u - C *ᵥ u := by rw [eq_sub_iff_add_eq, add_comm]; exact hu.symm
  have hb' : b' = u' - C *ᵥ u' := by rw [eq_sub_iff_add_eq, add_comm]; exact hu'.symm
  have hdiff : b - b' = (1 - C) *ᵥ (u - u') := by
    rw [sub_mulVec, one_mulVec, mulVec_sub, hb, hb']
    abel
  have heq : u - u' = G *ᵥ (b - b') := by
    rw [hdiff, mulVec_mulVec, hGinv, one_mulVec]
  refine ⟨heq, fun i => ?_⟩
  have := abs_mulVec_le G (b - b') hG i
  rw [← heq] at this
  simpa using this

/-- **E3 (stability under a discrepancy inequality).**
`|ρ - ρ'| ≤ C |ρ - ρ'| + |b - b'|` implies `|ρ - ρ'| ≤ G |b - b'|`. -/
theorem discrepancy_stability (C G : Matrix ι ι ℝ) (hGinv : G * (1 - C) = 1)
    (hG : ∀ i j, 0 ≤ G i j) (ρ ρ' b b' : ι → ℝ)
    (hdisc : ∀ i, |ρ i - ρ' i| ≤ (C *ᵥ fun j => |ρ j - ρ' j|) i + |b i - b' i|) :
    ∀ i, |ρ i - ρ' i| ≤ (G *ᵥ fun j => |b j - b' j|) i :=
  subsolution_le_resolvent C G hGinv hG (fun j => |ρ j - ρ' j|) (fun j => |b j - b' j|) hdisc

/-- Two one-sided subsolution inequalities do **not** give stability: with `C = 0`, `b = b' = 1`,
`ρ = 0`, `ρ' = 1`, both are subsolutions, `b = b'`, and `|ρ - ρ'| = 1`. So no bound
`|ρ - ρ'| ≤ K |b - b'|` holds, for any `K`. -/
theorem one_sided_no_stability :
    ∃ ρ ρ' b b' : Unit → ℝ,
      (∀ i, 0 ≤ ρ i ∧ 0 ≤ ρ' i) ∧
      (∀ i, ρ i ≤ ((0 : Matrix Unit Unit ℝ) *ᵥ ρ) i + b i) ∧
      (∀ i, ρ' i ≤ ((0 : Matrix Unit Unit ℝ) *ᵥ ρ') i + b' i) ∧
      b = b' ∧ ∀ K : ℝ, ¬ ∀ i, |ρ i - ρ' i| ≤ K * |b i - b' i| := by
  refine ⟨fun _ => 0, fun _ => 1, fun _ => 1, fun _ => 1, fun _ => ⟨le_rfl, zero_le_one⟩,
    fun _ => by simp, fun _ => by simp, rfl, fun K h => ?_⟩
  have := h ()
  norm_num at this

/-- The weighted `ℓ¹` operator norm of a nonnegative matrix `A` is
`K = maxⱼ (∑ i, w i * A i j) / w j`: (i) `‖A x‖ ≤ K ‖x‖` for every `x`; (ii) equality holds at a
basis vector `e_j` with `‖e_j‖ = w j > 0`; (iii) `K` is the least such constant. -/
theorem opNorm_weighted [Nonempty ι] (A : Matrix ι ι ℝ) (w : ι → ℝ)
    (hA : ∀ i j, 0 ≤ A i j) (hw : ∀ i, 0 < w i) :
    let K := univ.sup' univ_nonempty fun j => (∑ i, w i * A i j) / w j
    (∀ x, wnorm w (A *ᵥ x) ≤ K * wnorm w x) ∧
    (∃ j, wnorm w (A *ᵥ Pi.single j 1) = K * wnorm w (Pi.single j 1) ∧
      wnorm w (Pi.single j 1) = w j) ∧
    (∀ K', (∀ x, wnorm w (A *ᵥ x) ≤ K' * wnorm w x) → K ≤ K') := by
  intro K
  have hcolK : ∀ j, ∑ i, w i * A i j ≤ K * w j := by
    intro j
    have := le_sup' (s := univ) (fun j => (∑ i, w i * A i j) / w j) (mem_univ j)
    rw [div_le_iff₀ (hw j)] at this
    exact this
  have hsingle : ∀ j, wnorm w (Pi.single j 1) = w j := by
    intro j
    have : ∀ x, w x * |(Pi.single j (1 : ℝ) : ι → ℝ) x| = if x = j then w j else 0 := by
      intro x
      by_cases h : x = j
      · subst h; simp
      · simp [h]
    simp only [wnorm, this, sum_ite_eq', mem_univ, if_true]
  have hcolumn : ∀ j, wnorm w (A *ᵥ Pi.single j 1) = ∑ i, w i * A i j := by
    intro j
    simp only [wnorm, mulVec_single_one]
    exact sum_congr rfl fun i _ => by rw [abs_of_nonneg (hA i j)]
  refine ⟨fun x => ?_, ?_, fun K' hK' => ?_⟩
  · unfold wnorm
    calc ∑ i, w i * |(A *ᵥ x) i| ≤ ∑ i, w i * (A *ᵥ fun j => |x j|) i :=
          sum_le_sum fun i _ => mul_le_mul_of_nonneg_left (abs_mulVec_le A x hA i) (hw i).le
      _ ≤ K * ∑ i, w i * |x i| := weighted_mulVec_le A w _ K hcolK fun j => abs_nonneg _
  · obtain ⟨j, -, hj⟩ := exists_mem_eq_sup' (s := univ) univ_nonempty
      (fun j => (∑ i, w i * A i j) / w j)
    refine ⟨j, ?_, hsingle j⟩
    rw [hcolumn, hsingle, show K = (∑ i, w i * A i j) / w j from hj]
    field_simp [(hw j).ne']
  · apply sup'_le
    intro j _
    have := hK' (Pi.single j 1)
    rw [hcolumn, hsingle] at this
    rw [div_le_iff₀ (hw j)]
    exact this

/-- **E2, weighted form.** For exact fixed points, `‖u - u'‖₁,w ≤ K(C,w) ‖b - b'‖₁,w ≤
‖b - b'‖₁,w / (1 - θ)`, with `K(C,w) = maxⱼ (∑ i, w i * G i j) / w j` the exact operator norm of
`G = (1 - C)⁻¹`. -/
theorem fixedPoint_stability_weighted [Nonempty ι] (C : Matrix ι ι ℝ) (w : ι → ℝ) (θ : ℝ)
    (hθ : θ < 1) (hθ0 : 0 ≤ θ) (hC : ∀ i j, 0 ≤ C i j) (hw : ∀ i, 0 < w i)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j) (u u' b b' : ι → ℝ)
    (hu : u = C *ᵥ u + b) (hu' : u' = C *ᵥ u' + b') :
    let K := univ.sup' univ_nonempty fun j => (∑ i, w i * neumann C i j) / w j
    wnorm w (u - u') ≤ K * wnorm w (b - b') ∧ K ≤ 1 / (1 - θ) ∧
      wnorm w (u - u') ≤ wnorm w (b - b') / (1 - θ) := by
  intro K
  obtain ⟨-, -, hinv, hG, hGcol⟩ := resolvent_of_column C w θ hθ hθ0 hC hw hcol
  obtain ⟨heq, -⟩ := fixedPoint_stability C (neumann C) hinv hG u u' b b' hu hu'
  obtain ⟨hop, -, -⟩ := opNorm_weighted (neumann C) w hG hw
  have h1 : wnorm w (u - u') ≤ K * wnorm w (b - b') := by rw [heq]; exact hop _
  have hpos : 0 < 1 - θ := by linarith
  have h2 : K ≤ 1 / (1 - θ) := by
    apply sup'_le
    intro j _
    rw [div_le_iff₀ (hw j), div_mul_eq_mul_div, one_mul]
    exact hGcol j
  refine ⟨h1, h2, ?_⟩
  have hn := wnorm_nonneg w (b - b') fun i => (hw i).le
  calc wnorm w (u - u') ≤ K * wnorm w (b - b') := h1
    _ ≤ 1 / (1 - θ) * wnorm w (b - b') := mul_le_mul_of_nonneg_right h2 hn
    _ = wnorm w (b - b') / (1 - θ) := by ring

end Resolvent

/-! ### Proposition D: exponential decay with an additive floor -/

section Decay

variable {ι : Type*} [Fintype ι]

/-- **Proposition D.** If `ρ ≤ C ρ + B e^{-m d(·,k)} + ε`, with weighted row sums `≤ αₘ < 1` and
plain row sums `≤ α₀ < 1`, then `ρ i ≤ B / (1 - αₘ) e^{-m d(i,k)} + ε / (1 - α₀)`.
Proved from `decay_rowweighted` applied to `max (ρ - ε / (1 - α₀)) 0`. Compared with
`decay_rowweighted`: the source has the extra constant `ε`; `B ≥ 0` is assumed (there it is not);
`ρ ≥ 0` is **not** assumed, and `ι` may be empty. -/
theorem decay_with_floor (C : ι → ι → ℝ) (ρ : ι → ℝ) (d : ι → ι → ℝ) (k : ι)
    (m αm α0 B ε : ℝ) (hm : 0 ≤ m) (hB : 0 ≤ B) (hε : 0 ≤ ε) (hαm : αm < 1) (hα0 : α0 < 1)
    (hC : ∀ i j, 0 ≤ C i j) (htri : ∀ i j, d i k ≤ d i j + d j k)
    (hrowm : ∀ i, ∑ j, C i j * exp (m * d i j) ≤ αm) (hrow0 : ∀ i, ∑ j, C i j ≤ α0)
    (hrec : ∀ i, ρ i ≤ ∑ j, C i j * ρ j + B * exp (-(m * d i k)) + ε) :
    ∀ i, ρ i ≤ B / (1 - αm) * exp (-(m * d i k)) + ε / (1 - α0) := by
  rcases isEmpty_or_nonempty ι with hι | hι
  · exact fun i => isEmptyElim i
  have hpos0 : 0 < 1 - α0 := by linarith
  set τ := ε / (1 - α0) with hτ
  have hτ0 : 0 ≤ τ := div_nonneg hε hpos0.le
  have hτid : τ * α0 + ε - τ = 0 := by
    rw [hτ]; field_simp; ring
  set σ : ι → ℝ := fun i => max (ρ i - τ) 0 with hσ
  have hσ0 : ∀ i, 0 ≤ σ i := fun i => le_max_right _ _
  have hσrec : ∀ i, σ i ≤ ∑ j, C i j * σ j + B * exp (-(m * d i k)) := by
    intro i
    have hb0 : 0 ≤ B * exp (-(m * d i k)) := mul_nonneg hB (exp_pos _).le
    have hsum : ∑ j, C i j * (ρ j - τ) ≤ ∑ j, C i j * σ j :=
      sum_le_sum fun j _ => mul_le_mul_of_nonneg_left (le_max_left _ _) (hC i j)
    have hsplit : ∑ j, C i j * ρ j = ∑ j, C i j * (ρ j - τ) + τ * ∑ j, C i j := by
      rw [mul_sum, ← sum_add_distrib]; exact sum_congr rfl fun j _ => by ring
    have hτC : τ * ∑ j, C i j ≤ τ * α0 := mul_le_mul_of_nonneg_left (hrow0 i) hτ0
    have h1 : ρ i - τ ≤ ∑ j, C i j * σ j + B * exp (-(m * d i k)) := by
      linarith [hrec i]
    have h2 : 0 ≤ ∑ j, C i j * σ j + B * exp (-(m * d i k)) :=
      add_nonneg (sum_nonneg fun j _ => mul_nonneg (hC i j) (hσ0 j)) hb0
    exact max_le h1 h2
  have hdec := Comparison.decay_rowweighted C σ (fun i => B * exp (-(m * d i k))) d k m αm B
    hm hαm hC hσ0 htri hσrec (fun _ => le_rfl) hrowm
  intro i
  have h3 := hdec i
  have h4 : ρ i - τ ≤ σ i := le_max_left _ _
  linarith

/-- With `d ≥ 0` and `m ≥ 0`, the plain row sums are at most the weighted ones: `α₀ ≤ αₘ`. -/
theorem row_sum_le_weighted (C : ι → ι → ℝ) (d : ι → ι → ℝ) (m : ℝ) (hm : 0 ≤ m)
    (hd : ∀ i j, 0 ≤ d i j) (hC : ∀ i j, 0 ≤ C i j) (i : ι) :
    ∑ j, C i j ≤ ∑ j, C i j * exp (m * d i j) :=
  sum_le_sum fun j _ => le_mul_of_one_le_right (hC i j) (one_le_exp (mul_nonneg hm (hd i j)))

/-- Proposition D with `α₀` derived: for `d ≥ 0` the hypothesis on plain row sums follows from
the weighted one, with `α₀ = αₘ`. A separately known smaller `α₀` gives the sharper floor of
`decay_with_floor`. -/
theorem decay_with_floor_of_nonneg (C : ι → ι → ℝ) (ρ : ι → ℝ) (d : ι → ι → ℝ) (k : ι)
    (m αm B ε : ℝ) (hm : 0 ≤ m) (hB : 0 ≤ B) (hε : 0 ≤ ε) (hαm : αm < 1)
    (hC : ∀ i j, 0 ≤ C i j) (hd : ∀ i j, 0 ≤ d i j) (htri : ∀ i j, d i k ≤ d i j + d j k)
    (hrowm : ∀ i, ∑ j, C i j * exp (m * d i j) ≤ αm)
    (hrec : ∀ i, ρ i ≤ ∑ j, C i j * ρ j + B * exp (-(m * d i k)) + ε) :
    ∀ i, ρ i ≤ B / (1 - αm) * exp (-(m * d i k)) + ε / (1 - αm) :=
  decay_with_floor C ρ d k m αm αm B ε hm hB hε hαm hαm hC htri hrowm
    (fun i => (row_sum_le_weighted C d m hm hd hC i).trans (hrowm i)) hrec

/-- The floor cannot be dropped: with `C = 0`, `B = 0`, `ε = 1`, `ρ = 1` the recurrence holds,
and the bound without the floor, `B / (1 - α) e^{-m d}`, is `0 < 1`. -/
theorem floor_necessary (d : Unit → Unit → ℝ) (m α : ℝ) :
    let C : Unit → Unit → ℝ := fun _ _ => 0
    let ρ : Unit → ℝ := fun _ => 1
    (∀ i, ρ i ≤ ∑ j, C i j * ρ j + 0 * exp (-(m * d i ())) + 1) ∧
      ¬ ∀ i, ρ i ≤ 0 / (1 - α) * exp (-(m * d i ())) := by
  intro C ρ
  refine ⟨fun i => by simp [C, ρ], fun h => ?_⟩
  have := h ()
  norm_num [ρ] at this

/-- The floor `ε / (1 - α₀)` is attained: one site, `C = α₀`, `B = 0`, `ρ = ε / (1 - α₀)`, with
equality in the recurrence. -/
theorem floor_attained (α0 ε : ℝ) (hα0 : α0 < 1) :
    let C : Unit → Unit → ℝ := fun _ _ => α0
    let ρ : Unit → ℝ := fun _ => ε / (1 - α0)
    (∀ i, ρ i = ∑ j, C i j * ρ j + ε) ∧ (∀ i, ∑ j, C i j ≤ α0) := by
  intro C ρ
  have h : (1 - α0) ≠ 0 := by linarith
  refine ⟨fun i => ?_, fun i => by simp [C]⟩
  simp only [C, ρ, Finset.univ_unique, Finset.sum_singleton]
  field_simp
  ring

end Decay

/-! ### Proposition F: finite propagation and spatial localisation -/

section Propagation

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- **F1 (finite propagation).** If `C i j = 0` whenever `d i j > R` and `b` vanishes off `S`, then
`(Cⁿ b) i = 0` whenever `d i s > n R` for every `s ∈ S`. For `S = ∅` the hypothesis on `i` is
empty and `b = 0`; no distance to the empty set is used. -/
theorem finite_propagation (C : Matrix ι ι ℝ) (d : ι → ι → ℝ) (R : ℝ) (S : Finset ι)
    (b : ι → ℝ) (hd0 : ∀ i, d i i = 0) (htri : ∀ i j s, d i s ≤ d i j + d j s)
    (hrange : ∀ i j, R < d i j → C i j = 0) (hsupp : ∀ i ∉ S, b i = 0) :
    ∀ n : ℕ, ∀ i, (∀ s ∈ S, (n : ℝ) * R < d i s) → ((C ^ n) *ᵥ b) i = 0 := by
  intro n
  induction n with
  | zero =>
    intro i hi
    rw [pow_zero, one_mulVec]
    apply hsupp
    intro hiS
    have := hi i hiS
    rw [hd0] at this
    simp at this
  | succ n ih =>
    intro i hi
    rw [pow_succ', ← mulVec_mulVec]
    show ∑ j, C i j * ((C ^ n) *ᵥ b) j = 0
    refine sum_eq_zero fun j _ => ?_
    by_cases hij : R < d i j
    · rw [hrange i j hij, zero_mul]
    · have hij' : d i j ≤ R := not_lt.mp hij
      rw [ih j (fun s hs => ?_), mul_zero]
      have h1 := hi s hs
      have h2 := htri i j s
      have h3 : ((n + 1 : ℕ) : ℝ) * R = n * R + R := by push_cast; ring
      linarith

/-- Row-sum bound for powers: `(Cⁿ b) i ≤ qⁿ M` when `0 ≤ b ≤ M` and the rows sum to `≤ q`. -/
theorem row_pow_le (C : Matrix ι ι ℝ) (q M : ℝ) (hC : ∀ i j, 0 ≤ C i j) (hq0 : 0 ≤ q)
    (hrow : ∀ i, ∑ j, C i j ≤ q) (b : ι → ℝ) (hb : ∀ i, 0 ≤ b i) (hM : ∀ i, b i ≤ M) :
    ∀ n : ℕ, ∀ i, ((C ^ n) *ᵥ b) i ≤ q ^ n * M := by
  intro n
  induction n with
  | zero => intro i; simpa using hM i
  | succ n ih =>
    intro i
    have hM0 : 0 ≤ M := (hb i).trans (hM i)
    rw [pow_succ', ← mulVec_mulVec]
    calc (C *ᵥ ((C ^ n) *ᵥ b)) i = ∑ j, C i j * ((C ^ n) *ᵥ b) j := rfl
      _ ≤ ∑ j, C i j * (q ^ n * M) := sum_le_sum fun j _ => mul_le_mul_of_nonneg_left (ih j) (hC i j)
      _ = (∑ j, C i j) * (q ^ n * M) := by rw [sum_mul]
      _ ≤ q * (q ^ n * M) := mul_le_mul_of_nonneg_right (hrow i) (mul_nonneg (pow_nonneg hq0 n) hM0)
      _ = q ^ (n + 1) * M := by ring

/-- Under the row condition with `q < 1` the Neumann series is summable. -/
theorem neumann_summable_of_row (C : Matrix ι ι ℝ) (q : ℝ) (hC : ∀ i j, 0 ≤ C i j)
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hrow : ∀ i, ∑ j, C i j ≤ q) :
    Summable (fun k : ℕ => C ^ k) := by
  refine Pi.summable.mpr fun i => Pi.summable.mpr fun j => ?_
  refine Summable.of_nonneg_of_le (fun k => pow_nonneg' C hC k i j) (fun k => ?_)
    ((summable_geometric_of_lt_one hq0 hq1).mul_right 1)
  have := row_pow_le C q 1 hC hq0 hrow (Pi.single j 1)
    (fun l => by by_cases h : l = j <;> simp [h]) (fun l => by by_cases h : l = j <;> simp [h]) k i
  rwa [mulVec_single_one] at this

/-- `(G b) i = ∑ₖ (Cᵏ b) i` for a summable Neumann series. -/
lemma neumann_mulVec_apply (C : Matrix ι ι ℝ) (hs : Summable (fun k : ℕ => C ^ k))
    (b : ι → ℝ) (i : ι) : (neumann C *ᵥ b) i = ∑' k : ℕ, ((C ^ k) *ᵥ b) i := by
  have hsij : ∀ j, Summable (fun k : ℕ => (C ^ k) i j * b j) := fun j =>
    (Pi.summable.mp (Pi.summable.mp hs i) j).mul_right (b j)
  calc (neumann C *ᵥ b) i = ∑ j, neumann C i j * b j := rfl
    _ = ∑ j, ∑' k : ℕ, (C ^ k) i j * b j := sum_congr rfl fun j _ => by
        rw [neumann_apply C hs, (Pi.summable.mp (Pi.summable.mp hs i) j).tsum_mul_right]
    _ = ∑' k : ℕ, ∑ j, (C ^ k) i j * b j := (Summable.tsum_finsetSum fun j _ => hsij j).symm
    _ = ∑' k : ℕ, ((C ^ k) *ᵥ b) i := rfl

/-- **F2 (geometric resolvent tail).** With range `R > 0`, row sums `≤ q < 1`, and `0 ≤ b ≤ M`
supported on a nonempty `S`: `(G b) i ≤ q^{Nᵢ} / (1 - q) · M`, where `Dᵢ = min_{s ∈ S} d i s` and
`Nᵢ = ⌈Dᵢ / R⌉`. The terms `k < Nᵢ` vanish by `finite_propagation`; the rest is a geometric tail. -/
theorem resolvent_tail (C : Matrix ι ι ℝ) (d : ι → ι → ℝ) (R q M : ℝ) (S : Finset ι)
    (hS : S.Nonempty) (b : ι → ℝ) (hd0 : ∀ i, d i i = 0) (htri : ∀ i j s, d i s ≤ d i j + d j s)
    (hR : 0 < R) (hq0 : 0 < q) (hq1 : q < 1) (hC : ∀ i j, 0 ≤ C i j)
    (hrow : ∀ i, ∑ j, C i j ≤ q) (hrange : ∀ i j, R < d i j → C i j = 0)
    (hsupp : ∀ i ∉ S, b i = 0) (hb : ∀ i, 0 ≤ b i) (hM : ∀ i, b i ≤ M) (i : ι) :
    (neumann C *ᵥ b) i ≤ q ^ ⌈S.inf' hS (d i) / R⌉₊ / (1 - q) * M := by
  set N := ⌈S.inf' hS (d i) / R⌉₊ with hN
  have hs := neumann_summable_of_row C q hC hq0.le hq1 hrow
  set a : ℕ → ℝ := fun k => ((C ^ k) *ᵥ b) i with ha
  have ha0 : ∀ k, 0 ≤ a k := fun k => mulVec_nonneg _ _ (pow_nonneg' C hC k) hb i
  have haM : ∀ k, a k ≤ q ^ k * M := fun k => row_pow_le C q M hC hq0.le hrow b hb hM k i
  have hgeo : Summable (fun k : ℕ => q ^ k * M) :=
    (summable_geometric_of_lt_one hq0.le hq1).mul_right M
  have has : Summable a := Summable.of_nonneg_of_le ha0 haM hgeo
  have hzero : ∀ k < N, a k = 0 := by
    intro k hk
    apply finite_propagation C d R S b hd0 htri hrange hsupp k i
    intro s hs'
    have h1 : (k : ℝ) < S.inf' hS (d i) / R := Nat.lt_ceil.mp hk
    have h2 : S.inf' hS (d i) ≤ d i s := inf'_le _ hs'
    have h3 : (k : ℝ) * R < S.inf' hS (d i) := by rwa [lt_div_iff₀ hR] at h1
    linarith
  rw [neumann_mulVec_apply C hs b i, ← has.sum_add_tsum_nat_add N]
  have hhead : ∑ k ∈ range N, a k = 0 := sum_eq_zero fun k hk => hzero k (mem_range.mp hk)
  rw [hhead, zero_add]
  have htail : ∑' k : ℕ, a (k + N) ≤ ∑' k : ℕ, q ^ (k + N) * M :=
    Summable.tsum_le_tsum (fun k => haM (k + N)) ((summable_nat_add_iff N).mpr has)
      ((summable_nat_add_iff N).mpr hgeo)
  have hval : ∑' k : ℕ, q ^ (k + N) * M = q ^ N / (1 - q) * M := by
    have : (fun k : ℕ => q ^ (k + N) * M) = fun k => q ^ N * M * q ^ k := by
      funext k; rw [pow_add]; ring
    rw [this, tsum_mul_left, tsum_geometric_of_lt_one hq0.le hq1]
    field_simp [(by linarith : (1 - q) ≠ 0)]
  linarith

/-- **F2 with the sup norm.** `(G b) i ≤ q^{Nᵢ} / (1 - q) · ‖b‖∞`. -/
theorem resolvent_tail_norm (C : Matrix ι ι ℝ) (d : ι → ι → ℝ) (R q : ℝ) (S : Finset ι)
    (hS : S.Nonempty) (b : ι → ℝ) (hd0 : ∀ i, d i i = 0) (htri : ∀ i j s, d i s ≤ d i j + d j s)
    (hR : 0 < R) (hq0 : 0 < q) (hq1 : q < 1) (hC : ∀ i j, 0 ≤ C i j)
    (hrow : ∀ i, ∑ j, C i j ≤ q) (hrange : ∀ i j, R < d i j → C i j = 0)
    (hsupp : ∀ i ∉ S, b i = 0) (hb : ∀ i, 0 ≤ b i) (i : ι) :
    (neumann C *ᵥ b) i ≤ q ^ ⌈S.inf' hS (d i) / R⌉₊ / (1 - q) * ‖b‖ :=
  resolvent_tail C d R q ‖b‖ S hS b hd0 htri hR hq0 hq1 hC hrow hrange hsupp hb
    (fun j => (Real.le_norm_self _).trans (norm_le_pi_norm b j)) i

/-- **F3, `q = 0`.** Row sums `≤ 0` force `C = 0`, and then `G b = b`. -/
theorem resolvent_q_zero (C : Matrix ι ι ℝ) (hC : ∀ i j, 0 ≤ C i j)
    (hrow : ∀ i, ∑ j, C i j ≤ 0) : C = 0 ∧ ∀ b, neumann C *ᵥ b = b := by
  have hC0 : C = 0 := by
    ext i j
    have h := (sum_eq_zero_iff_of_nonneg fun j _ => hC i j).mp
      (le_antisymm (hrow i) (sum_nonneg fun j _ => hC i j))
    simpa using h j (mem_univ j)
  refine ⟨hC0, fun b => ?_⟩
  have h1 : neumann C = 1 := by
    unfold neumann
    rw [hC0, tsum_eq_single 0 fun k hk => zero_pow hk, pow_zero]
  rw [h1, one_mulVec]

/-- **F3, `R = 0`.** For a metric (`d i j > 0` off the diagonal), range `0` makes `C` diagonal,
and then no power of `C`, and not `G`, moves `b` off its support. -/
theorem resolvent_range_zero (C : Matrix ι ι ℝ) (d : ι → ι → ℝ) (S : Finset ι) (b : ι → ℝ)
    (hd0 : ∀ i, d i i = 0) (htri : ∀ i j s, d i s ≤ d i j + d j s)
    (hpos : ∀ i j, i ≠ j → 0 < d i j) (hrange : ∀ i j, 0 < d i j → C i j = 0)
    (hsupp : ∀ i ∉ S, b i = 0) :
    (∀ i j, i ≠ j → C i j = 0) ∧ (∀ n : ℕ, ∀ i ∉ S, ((C ^ n) *ᵥ b) i = 0) ∧
      ∀ i ∉ S, (neumann C *ᵥ b) i = 0 := by
  have hpow : ∀ n : ℕ, ∀ i ∉ S, ((C ^ n) *ᵥ b) i = 0 := by
    intro n i hi
    refine finite_propagation C d 0 S b hd0 htri hrange hsupp n i fun s hs => ?_
    have hne : i ≠ s := fun h => hi (h ▸ hs)
    simpa using hpos i s hne
  refine ⟨fun i j hij => hrange i j (hpos i j hij), hpow, fun i hi => ?_⟩
  by_cases hs : Summable (fun k : ℕ => C ^ k)
  · rw [neumann_mulVec_apply C hs b i]
    simp [hpow _ i hi]
  · have : neumann C = 0 := tsum_eq_zero_of_not_summable hs
    rw [this, zero_mulVec]
    rfl

end Propagation

/-! ### The measure-theoretic interface: couplings and the discrepancy recurrence -/

section Coupling

open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal

variable {Ω : Type*} [MeasurableSpace Ω]

/-- `γ` is a coupling of `μ` and `ν`: its marginals are `μ` and `ν`. -/
def IsCoupling (μ ν : Measure Ω) (γ : Measure (Ω × Ω)) : Prop :=
  γ.map Prod.fst = μ ∧ γ.map Prod.snd = ν

/-- The Kantorovich (Wasserstein-1) distance `inf_γ ∫ d dγ` over couplings, valued in `[0, ∞]`
(it is `∞` when there is no coupling). -/
noncomputable def W1 [PseudoEMetricSpace Ω] (μ ν : Measure Ω) : ℝ≥0∞ :=
  ⨅ (γ : Measure (Ω × Ω)) (_ : IsCoupling μ ν γ), ∫⁻ p, edist p.1 p.2 ∂γ

/-- **Coupling bound for observables.** If `‖f x - f y‖ₑ ≤ D (x, y)` and `γ` couples `μ` and `ν`,
then `|∫ f dμ - ∫ f dν| ≤ ∫ D dγ`. -/
theorem coupling_integral_diff_le {μ ν : Measure Ω} {γ : Measure (Ω × Ω)}
    (hγ : IsCoupling μ ν γ) {f : Ω → ℝ} (hfm : Measurable f) (hμ : Integrable f μ)
    (hν : Integrable f ν) (D : Ω × Ω → ℝ≥0∞) (hD : ∀ p, ‖f p.1 - f p.2‖ₑ ≤ D p) :
    ENNReal.ofReal |∫ x, f x ∂μ - ∫ x, f x ∂ν| ≤ ∫⁻ p, D p ∂γ := by
  obtain ⟨h1, h2⟩ := hγ
  have hm1 : ∫ x, f x ∂μ = ∫ p, f p.1 ∂γ := by
    rw [← h1, integral_map measurable_fst.aemeasurable hfm.aestronglyMeasurable]
  have hm2 : ∫ x, f x ∂ν = ∫ p, f p.2 ∂γ := by
    rw [← h2, integral_map measurable_snd.aemeasurable hfm.aestronglyMeasurable]
  have hi1 : Integrable (fun p : Ω × Ω => f p.1) γ :=
    (integrable_map_measure hfm.aestronglyMeasurable measurable_fst.aemeasurable).mp
      (by rw [h1]; exact hμ)
  have hi2 : Integrable (fun p : Ω × Ω => f p.2) γ :=
    (integrable_map_measure hfm.aestronglyMeasurable measurable_snd.aemeasurable).mp
      (by rw [h2]; exact hν)
  rw [hm1, hm2, ← integral_sub hi1 hi2, ← Real.enorm_eq_ofReal_abs]
  calc ‖∫ p, (f p.1 - f p.2) ∂γ‖ₑ ≤ ∫⁻ p, ‖f p.1 - f p.2‖ₑ ∂γ :=
        enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ p, D p ∂γ := lintegral_mono hD

/-- **Kantorovich inequality for one coupling.** For an `L`-Lipschitz `f` and a coupling `γ`,
`|∫ f dμ - ∫ f dν| ≤ L ∫ d(x, y) dγ`. -/
theorem lipschitz_coupling_bound [PseudoMetricSpace Ω] [OpensMeasurableSpace Ω]
    {μ ν : Measure Ω} {γ : Measure (Ω × Ω)} (hγ : IsCoupling μ ν γ) {f : Ω → ℝ} {L : ℝ≥0}
    (hf : LipschitzWith L f) (hμ : Integrable f μ) (hν : Integrable f ν) :
    ENNReal.ofReal |∫ x, f x ∂μ - ∫ x, f x ∂ν| ≤ L * ∫⁻ p, edist p.1 p.2 ∂γ := by
  have h := coupling_integral_diff_le hγ hf.continuous.measurable hμ hν
    (fun p => L * edist p.1 p.2) fun p => by
      rw [← edist_eq_enorm_sub]; exact hf.edist_le_mul _ _
  rwa [lintegral_const_mul' _ _ ENNReal.coe_ne_top] at h

/-- **Kantorovich inequality.** For probability measures and an `L`-Lipschitz `f`,
`|∫ f dμ - ∫ f dν| ≤ L · W₁(μ, ν)`. -/
theorem lipschitz_W1_bound [PseudoMetricSpace Ω] [OpensMeasurableSpace Ω] {μ ν : Measure Ω}
    [IsProbabilityMeasure μ] [IsProbabilityMeasure ν] {f : Ω → ℝ} {L : ℝ≥0}
    (hf : LipschitzWith L f) (hμ : Integrable f μ) (hν : Integrable f ν) :
    ENNReal.ofReal |∫ x, f x ∂μ - ∫ x, f x ∂ν| ≤ L * W1 μ ν := by
  by_cases hL : (L : ℝ≥0∞) = 0
  · have hc : IsCoupling μ ν (μ.prod ν) :=
      ⟨by simp [Measure.map_fst_prod], by simp [Measure.map_snd_prod]⟩
    have h := lipschitz_coupling_bound hc hf hμ hν
    rw [hL, zero_mul] at h ⊢
    exact h
  · rw [W1, ENNReal.mul_iInf_of_ne hL ENNReal.coe_ne_top]
    refine le_iInf fun γ => ?_
    rw [ENNReal.mul_iInf_of_ne hL ENNReal.coe_ne_top]
    exact le_iInf fun hγ => lipschitz_coupling_bound hγ hf hμ hν

/-- **Coupled updates preserve couplings.** Let `Q` be a kernel on pairs whose marginals are the
single updates, `(Q p).map fst = K p.1` and `(Q p).map snd = K' p.2`. If `μ` is `K`-invariant and
`ν` is `K'`-invariant (as Gibbs measures are under their heat-bath updates), then `Q` maps
couplings of `μ` and `ν` to couplings of `μ` and `ν`. -/
theorem coupled_update_isCoupling {μ ν : Measure Ω} {γ : Measure (Ω × Ω)}
    (hγ : IsCoupling μ ν γ) (K K' : Kernel Ω Ω) (Q : Kernel (Ω × Ω) (Ω × Ω))
    (hQ1 : ∀ p, (Q p).map Prod.fst = K p.1) (hQ2 : ∀ p, (Q p).map Prod.snd = K' p.2)
    (hK : μ.bind K = μ) (hK' : ν.bind K' = ν) : IsCoupling μ ν (γ.bind Q) := by
  obtain ⟨h1, h2⟩ := hγ
  constructor
  · ext s hs
    rw [Measure.map_apply measurable_fst hs,
      Measure.bind_apply (measurable_fst hs) Q.measurable.aemeasurable]
    have hQs : ∀ p, Q p (Prod.fst ⁻¹' s) = K p.1 s := fun p => by
      rw [← Measure.map_apply measurable_fst hs, hQ1]
    simp_rw [hQs]
    rw [← hK, Measure.bind_apply hs K.measurable.aemeasurable, ← h1,
      lintegral_map (K.measurable_coe hs) measurable_fst]
  · ext s hs
    rw [Measure.map_apply measurable_snd hs,
      Measure.bind_apply (measurable_snd hs) Q.measurable.aemeasurable]
    have hQs : ∀ p, Q p (Prod.snd ⁻¹' s) = K' p.2 s := fun p => by
      rw [← Measure.map_apply measurable_snd hs, hQ2]
    simp_rw [hQs]
    rw [← hK', Measure.bind_apply hs K'.measurable.aemeasurable, ← h2,
      lintegral_map (K'.measurable_coe hs) measurable_snd]

/-- One coupled update integrated against `γ`: if `∫ D i d(Q p) ≤ ∑ⱼ c j · D j p + β p` for every
pair `p`, then `∫ D i d(γ Q) ≤ ∑ⱼ c j ∫ D j dγ + ∫ β dγ`. -/
theorem bind_step_le {ι : Type*} [Fintype ι] (γ : Measure (Ω × Ω))
    (Q : Kernel (Ω × Ω) (Ω × Ω)) (D : ι → Ω × Ω → ℝ≥0∞) (hD : ∀ j, Measurable (D j))
    (c : ι → ℝ≥0∞) (β : Ω × Ω → ℝ≥0∞) (hβ : Measurable β) (i : ι)
    (hstep : ∀ p, ∫⁻ q, D i q ∂(Q p) ≤ ∑ j, c j * D j p + β p) :
    ∫⁻ p, D i p ∂(γ.bind Q) ≤ ∑ j, c j * ∫⁻ p, D j p ∂γ + ∫⁻ p, β p ∂γ := by
  calc ∫⁻ p, D i p ∂(γ.bind Q) = ∫⁻ p, ∫⁻ q, D i q ∂(Q p) ∂γ :=
        Measure.lintegral_bind Q.measurable.aemeasurable (hD i).aemeasurable
    _ ≤ ∫⁻ p, (∑ j, c j * D j p + β p) ∂γ := lintegral_mono hstep
    _ = ∑ j, c j * ∫⁻ p, D j p ∂γ + ∫⁻ p, β p ∂γ := by
        rw [lintegral_add_right _ hβ, lintegral_finsetSum _ fun j _ => (hD j).const_mul _]
        congr 1
        exact sum_congr rfl fun j _ => lintegral_const_mul _ (hD j)

/-- **Discrepancy recurrence from a stationary coupling.** If `γ` is invariant under the coupled
update `Q` of site `i`, and one coupled update bounds the expected discrepancy at `i` by
`∑ⱼ c j · D j + β`, then `ρ i ≤ ∑ⱼ c j ρ j + ∫ β dγ`, where `ρ j = ∫ D j dγ`. Values in `[0, ∞]`,
so no integrability is assumed. -/
theorem stationary_recurrence {ι : Type*} [Fintype ι] (γ : Measure (Ω × Ω))
    (Q : Kernel (Ω × Ω) (Ω × Ω)) (hinv : γ.bind Q = γ)
    (D : ι → Ω × Ω → ℝ≥0∞) (hD : ∀ j, Measurable (D j)) (c : ι → ℝ≥0∞)
    (β : Ω × Ω → ℝ≥0∞) (hβ : Measurable β) (i : ι)
    (hstep : ∀ p, ∫⁻ q, D i q ∂(Q p) ≤ ∑ j, c j * D j p + β p) :
    ∫⁻ p, D i p ∂γ ≤ ∑ j, c j * ∫⁻ p, D j p ∂γ + ∫⁻ p, β p ∂γ := by
  have h := bind_step_le γ Q D hD c β hβ i hstep
  rwa [hinv] at h

/-- **Random scan.** Let `γ` be invariant under the random-scan update, the average of the coupled
single-site updates `Q k` (stated as `∑ₖ γ Q k = |ι| • γ`), and let the update of a site `k ≠ i`
not change the discrepancy at `i` (`∫ D i d(Q k p) = D i p`). If `∫ D i dγ < ∞`, then
`∫ D i dγ = ∫ D i d(γ Q i)`: the coupled update of site `i` alone can be used. Invariance is needed
only under the average, which is what an invariant law of one Markov kernel (the random-scan
heat bath) provides. -/
theorem random_scan_invariance {ι : Type*} [Fintype ι] [DecidableEq ι] (γ : Measure (Ω × Ω))
    (Q : ι → Kernel (Ω × Ω) (Ω × Ω))
    (hinv : ∑ k, γ.bind (Q k) = (Fintype.card ι : ℝ≥0∞) • γ)
    (D : ι → Ω × Ω → ℝ≥0∞) (hD : ∀ j, Measurable (D j)) (i : ι)
    (hfix : ∀ k, k ≠ i → ∀ p, ∫⁻ q, D i q ∂(Q k p) = D i p)
    (hfin : ∫⁻ p, D i p ∂γ ≠ ∞) :
    ∫⁻ p, D i p ∂γ = ∫⁻ p, D i p ∂(γ.bind (Q i)) := by
  set ρ := ∫⁻ p, D i p ∂γ with hρ
  have hk : ∀ k ∈ univ.erase i, ∫⁻ p, D i p ∂(γ.bind (Q k)) = ρ := by
    intro k hk
    rw [Measure.lintegral_bind (Q k).measurable.aemeasurable (hD i).aemeasurable]
    exact lintegral_congr fun p => hfix k (ne_of_mem_erase hk) p
  have hsum : ∫⁻ p, D i p ∂(∑ k, γ.bind (Q k))
      = ∫⁻ p, D i p ∂(γ.bind (Q i)) + ((Fintype.card ι - 1 : ℕ) : ℝ≥0∞) * ρ := by
    rw [lintegral_finsetSum_measure, ← add_sum_erase _ _ (mem_univ i), sum_congr rfl hk, sum_const,
      card_erase_of_mem (mem_univ i), nsmul_eq_mul, card_univ]
  have hn : 1 ≤ Fintype.card ι := Fintype.card_pos_iff.mpr ⟨i⟩
  have hlhs : ∫⁻ p, D i p ∂(∑ k, γ.bind (Q k)) = ((Fintype.card ι - 1 : ℕ) : ℝ≥0∞) * ρ + ρ := by
    rw [hinv, lintegral_smul_measure, smul_eq_mul]
    have e : (Fintype.card ι : ℝ≥0∞) = ((Fintype.card ι - 1 : ℕ) : ℝ≥0∞) + 1 := by
      exact_mod_cast (Nat.sub_add_cancel hn).symm
    rw [e, add_mul, one_mul]
  have hfin' : ((Fintype.card ι - 1 : ℕ) : ℝ≥0∞) * ρ ≠ ∞ :=
    ENNReal.mul_ne_top (ENNReal.natCast_ne_top _) hfin
  have h := hlhs.symm.trans hsum
  rw [add_comm (∫⁻ p, D i p ∂(γ.bind (Q i)))] at h
  exact (ENNReal.add_right_inj hfin').mp h

/-- **Discrepancy recurrence from a random-scan invariant coupling.** -/
theorem random_scan_recurrence {ι : Type*} [Fintype ι] [DecidableEq ι] (γ : Measure (Ω × Ω))
    (Q : ι → Kernel (Ω × Ω) (Ω × Ω))
    (hinv : ∑ k, γ.bind (Q k) = (Fintype.card ι : ℝ≥0∞) • γ)
    (D : ι → Ω × Ω → ℝ≥0∞) (hD : ∀ j, Measurable (D j)) (c : ι → ℝ≥0∞)
    (β : Ω × Ω → ℝ≥0∞) (hβ : Measurable β) (i : ι)
    (hfix : ∀ k, k ≠ i → ∀ p, ∫⁻ q, D i q ∂(Q k p) = D i p)
    (hfin : ∫⁻ p, D i p ∂γ ≠ ∞)
    (hstep : ∀ p, ∫⁻ q, D i q ∂(Q i p) ≤ ∑ j, c j * D j p + β p) :
    ∫⁻ p, D i p ∂γ ≤ ∑ j, c j * ∫⁻ p, D j p ∂γ + ∫⁻ p, β p ∂γ := by
  rw [random_scan_invariance γ Q hinv D hD i hfix hfin]
  exact bind_step_le γ (Q i) D hD c β hβ i hstep

/-- The recurrence in `[0, ∞]`, with real coefficients and finite values, gives the real recurrence
`ρ ≤ C ρ + b` and Proposition A. -/
theorem comparison_of_recurrence {ι : Type*} [Fintype ι] (X Y : ι → ℝ≥0∞)
    (C : Matrix ι ι ℝ) (hC : ∀ i j, 0 ≤ C i j)
    (hrec : ∀ i, X i ≤ ∑ j, ENNReal.ofReal (C i j) * X j + Y i)
    (hX : ∀ i, X i ≠ ∞) (hY : ∀ i, Y i ≠ ∞)
    (w : ι → ℝ) (θ : ℝ) (hθ : θ < 1) (hw : ∀ i, 0 ≤ w i)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j) :
    (∀ i, (X i).toReal ≤ (C *ᵥ fun j => (X j).toReal) i + (Y i).toReal) ∧
      ∑ i, w i * (X i).toReal ≤ 1 / (1 - θ) * ∑ i, w i * (Y i).toReal := by
  have hreal : ∀ i, (X i).toReal ≤ (C *ᵥ fun j => (X j).toReal) i + (Y i).toReal := by
    intro i
    have hterm : ∀ j ∈ (univ : Finset ι), ENNReal.ofReal (C i j) * X j ≠ ∞ :=
      fun j _ => ENNReal.mul_ne_top ENNReal.ofReal_ne_top (hX j)
    have hsum : ∑ j, ENNReal.ofReal (C i j) * X j ≠ ∞ := ENNReal.sum_ne_top.mpr hterm
    have h' := ENNReal.toReal_mono (ENNReal.add_ne_top.mpr ⟨hsum, hY i⟩) (hrec i)
    rw [ENNReal.toReal_add hsum (hY i), ENNReal.toReal_sum hterm] at h'
    simp only [ENNReal.toReal_mul, ENNReal.toReal_ofReal (hC i _)] at h'
    exact h'
  exact ⟨hreal, resolvent_comparison C w _ _ θ hθ hw (fun i => ENNReal.toReal_nonneg) hcol hreal⟩

/-- **From a stationary coupling to the weighted comparison.** Under the hypotheses of
`stationary_recurrence` at every site, with real coefficients `C i j ≥ 0` and finite
discrepancies, `ρ = (∫ D i dγ)ᵢ` satisfies `ρ ≤ C ρ + b` with `b = (∫ β i dγ)ᵢ`, and hence
Proposition A: `∑ w ρ ≤ (1 / (1 - θ)) ∑ w b`. The hypotheses `hinv` and `hstep` are what G1 has
to supply for a specification. -/
theorem coupled_comparison {ι : Type*} [Fintype ι] (γ : Measure (Ω × Ω))
    (Q : ι → Kernel (Ω × Ω) (Ω × Ω)) (hinv : ∀ i, γ.bind (Q i) = γ)
    (D : ι → Ω × Ω → ℝ≥0∞) (hD : ∀ j, Measurable (D j))
    (C : Matrix ι ι ℝ) (hC : ∀ i j, 0 ≤ C i j)
    (β : ι → Ω × Ω → ℝ≥0∞) (hβ : ∀ i, Measurable (β i))
    (hstep : ∀ i p, ∫⁻ q, D i q ∂(Q i p) ≤ ∑ j, ENNReal.ofReal (C i j) * D j p + β i p)
    (hDfin : ∀ i, ∫⁻ p, D i p ∂γ ≠ ∞) (hβfin : ∀ i, ∫⁻ p, β i p ∂γ ≠ ∞)
    (w : ι → ℝ) (θ : ℝ) (hθ : θ < 1) (hw : ∀ i, 0 ≤ w i)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j) :
    (∀ i, (∫⁻ p, D i p ∂γ).toReal ≤
        (C *ᵥ fun j => (∫⁻ p, D j p ∂γ).toReal) i + (∫⁻ p, β i p ∂γ).toReal) ∧
      ∑ i, w i * (∫⁻ p, D i p ∂γ).toReal ≤
        1 / (1 - θ) * ∑ i, w i * (∫⁻ p, β i p ∂γ).toReal :=
  comparison_of_recurrence (fun i => ∫⁻ p, D i p ∂γ) (fun i => ∫⁻ p, β i p ∂γ) C hC
    (fun i => stationary_recurrence γ (Q i) (hinv i) D hD (fun j => ENNReal.ofReal (C i j)) (β i)
      (hβ i) i (hstep i)) hDfin hβfin w θ hθ hw hcol

/-- **From a random-scan invariant coupling to the weighted comparison.** As `coupled_comparison`,
with invariance only under the average of the coupled updates, and with the update of site `k`
leaving the discrepancy at every other site unchanged. -/
theorem random_scan_comparison {ι : Type*} [Fintype ι] [DecidableEq ι] (γ : Measure (Ω × Ω))
    (Q : ι → Kernel (Ω × Ω) (Ω × Ω))
    (hinv : ∑ k, γ.bind (Q k) = (Fintype.card ι : ℝ≥0∞) • γ)
    (D : ι → Ω × Ω → ℝ≥0∞) (hD : ∀ j, Measurable (D j))
    (hfix : ∀ i k, k ≠ i → ∀ p, ∫⁻ q, D i q ∂(Q k p) = D i p)
    (C : Matrix ι ι ℝ) (hC : ∀ i j, 0 ≤ C i j)
    (β : ι → Ω × Ω → ℝ≥0∞) (hβ : ∀ i, Measurable (β i))
    (hstep : ∀ i p, ∫⁻ q, D i q ∂(Q i p) ≤ ∑ j, ENNReal.ofReal (C i j) * D j p + β i p)
    (hDfin : ∀ i, ∫⁻ p, D i p ∂γ ≠ ∞) (hβfin : ∀ i, ∫⁻ p, β i p ∂γ ≠ ∞)
    (w : ι → ℝ) (θ : ℝ) (hθ : θ < 1) (hw : ∀ i, 0 ≤ w i)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j) :
    (∀ i, (∫⁻ p, D i p ∂γ).toReal ≤
        (C *ᵥ fun j => (∫⁻ p, D j p ∂γ).toReal) i + (∫⁻ p, β i p ∂γ).toReal) ∧
      ∑ i, w i * (∫⁻ p, D i p ∂γ).toReal ≤
        1 / (1 - θ) * ∑ i, w i * (∫⁻ p, β i p ∂γ).toReal :=
  comparison_of_recurrence (fun i => ∫⁻ p, D i p ∂γ) (fun i => ∫⁻ p, β i p ∂γ) C hC
    (fun i => random_scan_recurrence γ Q hinv D hD (fun j => ENNReal.ofReal (C i j)) (β i) (hβ i) i
      (hfix i) (hDfin i) (hstep i)) hDfin hβfin w θ hθ hw hcol

/-- **Observables from coordinate discrepancies.** If `‖f x - f y‖ₑ ≤ ∑ᵢ aᵢ Dᵢ(x, y)` and `γ`
couples `μ` and `ν`, then `|∫ f dμ - ∫ f dν| ≤ ∑ᵢ aᵢ ∫ Dᵢ dγ`. With `coupled_comparison` this
turns the discrepancy bounds into bounds on expectations. -/
theorem observable_bound {ι : Type*} [Fintype ι] {μ ν : Measure Ω} {γ : Measure (Ω × Ω)}
    (hγ : IsCoupling μ ν γ) {f : Ω → ℝ} (hfm : Measurable f) (hμ : Integrable f μ)
    (hν : Integrable f ν) (D : ι → Ω × Ω → ℝ≥0∞) (hD : ∀ j, Measurable (D j)) (a : ι → ℝ≥0∞)
    (hf : ∀ p, ‖f p.1 - f p.2‖ₑ ≤ ∑ j, a j * D j p) :
    ENNReal.ofReal |∫ x, f x ∂μ - ∫ x, f x ∂ν| ≤ ∑ j, a j * ∫⁻ p, D j p ∂γ := by
  have h := coupling_integral_diff_le hγ hfm hμ hν (fun p => ∑ j, a j * D j p) hf
  rw [lintegral_finsetSum _ fun j _ => (hD j).const_mul _] at h
  refine h.trans (le_of_eq (sum_congr rfl fun j _ => lintegral_const_mul _ (hD j)))

end Coupling

end YangMills.StrongCoupling.WassersteinBridge

end Part3_WassersteinComparisonBridge

section Part4_FiniteCoupling

/-!
# G1 on a finite spin space: the coupling exists, and the comparison applies

Part 2 (`CouplingMinimality`) derives the discrepancy recurrence from minimality of a weighted coupling
cost, for an abstract type of couplings. This file instantiates it on a finite spin space and so
discharges its hypotheses there.

Setting: finitely many sites `ι`, a finite spin space `X` with a cost `dX ≥ 0`, configurations
`ι → X`. Probability laws are nonnegative functions summing to one; a coupling of `p` and `q` is a
nonnegative function on pairs with marginals `p` and `q` (the standard notion, on finite sets, where
every function is measurable). For a site `i` and kernels `k x` on `X`, the single-site update moves
`x` to `Function.update x i a` with probability `k x a`; a law is *stationary* at `i` if it is
invariant under that update (the finite DLR equation for a heat bath).

* `couplings_isCompact`, `exists_min_coupling`: the couplings of two laws form a compact set, so a
  continuous cost has a minimiser (here: the weighted expected discrepancy).
* `coupledUpdate`: from a coupling of the two laws, resample the pair at site `i` from couplings
  `π x y` of `k x` and `k y`. `coupledUpdate_isCoupling`: if both laws are stationary at `i`, this is
  again a coupling; `disc_coupledUpdate_ne`: the discrepancy at every other site is unchanged;
  `disc_coupledUpdate_self`: the discrepancy at `i` is the average cost of the `π x y`.
* `finite_dobrushin_comparison`: if the two laws are stationary under the same kernels outside a set
  `S`, and every such kernel satisfies the Dobrushin bound
  `cost(π x y) ≤ ∑ⱼ C i j · dX (x j) (y j)` for some coupling `π x y`, then a coupling exists with
  `∑_{e ∉ S} w e ρ e ≤ θ D / (1 - θ) ∑_{z ∈ S} w z`. The coupling is the cost minimiser; the
  recurrence comes from `CouplingMinimality.comparison_of_minimality`.
* `gibbs_stationary`: a Gibbs law `Φ / Z` is stationary under its own heat bath at every site, so the
  stationarity hypothesis is automatic for Gibbs laws.
* `example_comparison`: a two-site Ising instance with `μ ≠ ν` in which every hypothesis is
  discharged; it gives a coupling with `E[x₁ ≠ y₁] ≤ 1/2`, below the trivial bound `1`. This shows the
  hypotheses of `finite_dobrushin_comparison` (and hence of `comparison_of_minimality`) are
  satisfiable by distinct laws.

Scope: finite spin spaces and finite volume. SU(2) (a compact, not finite, spin space), the sharp
quarter as a bound on conditional laws, and infinite volume are not treated here.
-/

open Finset

namespace YangMills.StrongCoupling.FiniteCoupling

section Laws

variable {α β : Type*} [Fintype α] [Fintype β]

/-- A probability law on a finite set. -/
def IsProb (p : α → ℝ) : Prop := (∀ a, 0 ≤ p a) ∧ ∑ a, p a = 1

/-- A coupling of `p` and `q`: a nonnegative function on pairs with marginals `p` and `q`. -/
def IsCoupling (p : α → ℝ) (q : β → ℝ) (γ : α × β → ℝ) : Prop :=
  (∀ z, 0 ≤ γ z) ∧ (∀ a, ∑ b, γ (a, b) = p a) ∧ (∀ b, ∑ a, γ (a, b) = q b)

lemma IsCoupling.total {p : α → ℝ} {q : β → ℝ} {γ : α × β → ℝ} (h : IsCoupling p q γ)
    (hp : IsProb p) : ∑ z, γ z = 1 := by
  rw [Fintype.sum_prod_type]
  simp_rw [h.2.1]
  exact hp.2

lemma IsCoupling.le_one {p : α → ℝ} {q : β → ℝ} {γ : α × β → ℝ} (h : IsCoupling p q γ)
    (hp : IsProb p) (z : α × β) : γ z ≤ 1 :=
  (single_le_sum (fun z' _ => h.1 z') (mem_univ z)).trans (h.total hp).le

/-- The product coupling: couplings exist. -/
theorem prod_isCoupling {p : α → ℝ} {q : β → ℝ} (hp : IsProb p) (hq : IsProb q) :
    IsCoupling p q (fun z => p z.1 * q z.2) := by
  refine ⟨fun z => mul_nonneg (hp.1 _) (hq.1 _), fun a => ?_, fun b => ?_⟩
  · simp only
    rw [← mul_sum, hq.2, mul_one]
  · simp only
    rw [← sum_mul, hp.2, one_mul]

/-- The couplings of two laws form a compact subset of `α × β → ℝ`. -/
theorem couplings_isCompact {p : α → ℝ} {q : β → ℝ} (hp : IsProb p) :
    IsCompact {γ : α × β → ℝ | IsCoupling p q γ} := by
  apply Metric.isCompact_of_isClosed_isBounded
  · have h1 : IsClosed (⋂ z, {γ : α × β → ℝ | 0 ≤ γ z}) :=
      isClosed_iInter fun z => isClosed_le continuous_const (continuous_apply z)
    have h2 : IsClosed (⋂ a, {γ : α × β → ℝ | ∑ b, γ (a, b) = p a}) :=
      isClosed_iInter fun a => isClosed_eq
        (continuous_finsetSum _ fun b _ => continuous_apply (a, b)) continuous_const
    have h3 : IsClosed (⋂ b, {γ : α × β → ℝ | ∑ a, γ (a, b) = q b}) :=
      isClosed_iInter fun b => isClosed_eq
        (continuous_finsetSum _ fun a _ => continuous_apply (a, b)) continuous_const
    have e : {γ : α × β → ℝ | IsCoupling p q γ} =
        (⋂ z, {γ : α × β → ℝ | 0 ≤ γ z}) ∩ ((⋂ a, {γ : α × β → ℝ | ∑ b, γ (a, b) = p a}) ∩
          ⋂ b, {γ : α × β → ℝ | ∑ a, γ (a, b) = q b}) := by
      ext γ
      simp [IsCoupling]
    rw [e]
    exact h1.inter (h2.inter h3)
  · refine (Metric.isBounded_closedBall (x := (0 : α × β → ℝ)) (r := 1)).subset fun γ hγ => ?_
    rw [mem_closedBall_zero_iff, pi_norm_le_iff_of_nonneg zero_le_one]
    intro z
    rw [Real.norm_of_nonneg (hγ.1 z)]
    exact hγ.le_one hp z

/-- A continuous cost has a minimiser over the couplings of two laws. -/
theorem exists_min_coupling {p : α → ℝ} {q : β → ℝ} (hp : IsProb p) (hq : IsProb q)
    (F : (α × β → ℝ) → ℝ) (hF : Continuous F) :
    ∃ γ, IsCoupling p q γ ∧ ∀ γ', IsCoupling p q γ' → F γ ≤ F γ' := by
  obtain ⟨γ, hγ, hmin⟩ := (couplings_isCompact (q := q) hp).exists_isMinOn
    ⟨_, prod_isCoupling hp hq⟩ hF.continuousOn
  exact ⟨γ, hγ, fun γ' h' => hmin h'⟩

/-- The transport cost of a coupling on `α × α`. -/
def tcost (dX : α → α → ℝ) (π : α × α → ℝ) : ℝ := ∑ a, ∑ b, π (a, b) * dX a b

/-- The diagonal coupling of a law with itself. -/
lemma diag_isCoupling [DecidableEq α] {p : α → ℝ} (hp : IsProb p) :
    IsCoupling p p (fun z => if z.1 = z.2 then p z.1 else 0) := by
  refine ⟨fun z => ?_, fun a => ?_, fun b => ?_⟩
  · show 0 ≤ (if z.1 = z.2 then p z.1 else 0)
    split_ifs
    · exact hp.1 _
    · exact le_rfl
  · simp
  · simp

lemma tcost_diag [DecidableEq α] (dX : α → α → ℝ) (hd : ∀ a, dX a a = 0) (p : α → ℝ) :
    tcost dX (fun z => if z.1 = z.2 then p z.1 else 0) = 0 := by
  unfold tcost
  refine sum_eq_zero fun a _ => sum_eq_zero fun b _ => ?_
  by_cases h : a = b
  · subst h; simp [hd]
  · simp [h]

end Laws

section Configurations

variable {ι X : Type*} [Fintype ι] [DecidableEq ι] [Fintype X] [DecidableEq X]

/-- The expected discrepancy at site `i` of a coupling of two laws on configurations. -/
def disc (dX : X → X → ℝ) (γ : (ι → X) × (ι → X) → ℝ) (i : ι) : ℝ :=
  ∑ z, γ z * dX (z.1 i) (z.2 i)

/-- The single-site update at `i`: `x` moves to `Function.update x i a` with probability `k x a`. -/
def siteKernel (k : (ι → X) → X → ℝ) (i : ι) (x x' : ι → X) : ℝ :=
  ∑ a, if x' = Function.update x i a then k x a else 0

/-- A law is stationary at `i` if it is invariant under the single-site update (finite DLR). -/
def Stationary (μ : (ι → X) → ℝ) (k : (ι → X) → X → ℝ) (i : ι) : Prop :=
  ∀ x', ∑ x, μ x * siteKernel k i x x' = μ x'

/-- The coupled single-site transition: from `(x, y)`, resample `(xᵢ, yᵢ)` from `π x y`. -/
def pairKernel (π : (ι → X) → (ι → X) → X × X → ℝ) (i : ι) (z z' : (ι → X) × (ι → X)) : ℝ :=
  ∑ a, ∑ b, if z'.1 = Function.update z.1 i a ∧ z'.2 = Function.update z.2 i b
    then π z.1 z.2 (a, b) else 0

/-- The coupled update of a coupling `γ` at site `i`. -/
def coupledUpdate (π : (ι → X) → (ι → X) → X × X → ℝ) (i : ι) (γ : (ι → X) × (ι → X) → ℝ) :
    (ι → X) × (ι → X) → ℝ :=
  fun z' => ∑ z, γ z * pairKernel π i z z'

lemma pairKernel_nonneg {π : (ι → X) → (ι → X) → X × X → ℝ} (hπ : ∀ x y w, 0 ≤ π x y w) (i : ι)
    (z z' : (ι → X) × (ι → X)) : 0 ≤ pairKernel π i z z' :=
  sum_nonneg fun a _ => sum_nonneg fun b _ => by split_ifs <;> simp [hπ]

/-- Summing the coupled transition against a function of the new pair. -/
lemma sum_pairKernel_mul (π : (ι → X) → (ι → X) → X × X → ℝ) (i : ι) (z : (ι → X) × (ι → X))
    (f : (ι → X) × (ι → X) → ℝ) :
    ∑ z', pairKernel π i z z' * f z' =
      ∑ a, ∑ b, π z.1 z.2 (a, b) * f (Function.update z.1 i a, Function.update z.2 i b) := by
  simp only [pairKernel, sum_mul]
  rw [Finset.sum_comm]
  refine sum_congr rfl fun a _ => ?_
  rw [Finset.sum_comm]
  refine sum_congr rfl fun b _ => ?_
  have hc : ∀ z' : (ι → X) × (ι → X),
      (z'.1 = Function.update z.1 i a ∧ z'.2 = Function.update z.2 i b) ↔
        z' = (Function.update z.1 i a, Function.update z.2 i b) := fun z' =>
    ⟨fun h => Prod.ext h.1 h.2, fun h => by subst h; exact ⟨rfl, rfl⟩⟩
  simp_rw [hc, ite_mul, zero_mul]
  rw [Finset.sum_ite_eq']
  simp

/-- First marginal of the coupled transition: the single-site update of the first coordinate. -/
lemma sum_pairKernel_fst {π : (ι → X) → (ι → X) → X × X → ℝ} {k : (ι → X) → X → ℝ}
    (hπ : ∀ x y a, ∑ b, π x y (a, b) = k x a) (i : ι) (x y x' : ι → X) :
    ∑ y', pairKernel π i (x, y) (x', y') = siteKernel k i x x' := by
  simp only [pairKernel, siteKernel]
  rw [Finset.sum_comm]
  refine sum_congr rfl fun a _ => ?_
  rw [Finset.sum_comm]
  by_cases h : x' = Function.update x i a
  · simp only [h, true_and, if_true]
    simp_rw [Finset.sum_ite_eq', mem_univ, if_true]
    exact hπ x y a
  · simp [h]

/-- Second marginal of the coupled transition. -/
lemma sum_pairKernel_snd {π : (ι → X) → (ι → X) → X × X → ℝ} {k : (ι → X) → X → ℝ}
    (hπ : ∀ x y b, ∑ a, π x y (a, b) = k y b) (i : ι) (x y y' : ι → X) :
    ∑ x', pairKernel π i (x, y) (x', y') = siteKernel k i y y' := by
  calc ∑ x', pairKernel π i (x, y) (x', y')
      = ∑ z', pairKernel π i (x, y) z' * (if z'.2 = y' then 1 else 0) := by
        rw [Fintype.sum_prod_type]
        simp only [mul_ite, mul_one, mul_zero]
        exact sum_congr rfl fun x' _ => by rw [Finset.sum_ite_eq']; simp
    _ = ∑ a, ∑ b, π x y (a, b) * (if Function.update y i b = y' then 1 else 0) :=
        sum_pairKernel_mul π i (x, y) _
    _ = siteKernel k i y y' := by
        simp only [siteKernel]
        rw [Finset.sum_comm]
        refine sum_congr rfl fun b _ => ?_
        by_cases h : y' = Function.update y i b
        · simp only [h, if_true, mul_one]
          exact hπ x y b
        · simp [h, Ne.symm h]

/-- **Marginals.** If both laws are stationary at `i` under `k`, and every `π x y` couples `k x`
and `k y`, the coupled update of a coupling of `μ` and `ν` is again a coupling of `μ` and `ν`. -/
theorem coupledUpdate_isCoupling {μ ν : (ι → X) → ℝ} {k : (ι → X) → X → ℝ}
    {π : (ι → X) → (ι → X) → X × X → ℝ} {i : ι} {γ : (ι → X) × (ι → X) → ℝ}
    (hγ : IsCoupling μ ν γ) (hπ : ∀ x y, IsCoupling (k x) (k y) (π x y))
    (hμ : Stationary μ k i) (hν : Stationary ν k i) :
    IsCoupling μ ν (coupledUpdate π i γ) := by
  refine ⟨fun z' => sum_nonneg fun z _ => mul_nonneg (hγ.1 z)
    (pairKernel_nonneg (fun x y w => (hπ x y).1 w) i z z'), fun x' => ?_, fun y' => ?_⟩
  · calc ∑ y', coupledUpdate π i γ (x', y')
        = ∑ z, γ z * ∑ y', pairKernel π i z (x', y') := by
          simp only [coupledUpdate, mul_sum]; rw [Finset.sum_comm]
      _ = ∑ x, ∑ y, γ (x, y) * siteKernel k i x x' := by
          rw [Fintype.sum_prod_type]
          exact sum_congr rfl fun x _ => sum_congr rfl fun y _ => by
            rw [sum_pairKernel_fst (fun x y a => (hπ x y).2.1 a)]
      _ = ∑ x, μ x * siteKernel k i x x' := by
          refine sum_congr rfl fun x _ => ?_
          rw [← sum_mul, hγ.2.1 x]
      _ = μ x' := hμ x'
  · calc ∑ x', coupledUpdate π i γ (x', y')
        = ∑ z, γ z * ∑ x', pairKernel π i z (x', y') := by
          simp only [coupledUpdate, mul_sum]; rw [Finset.sum_comm]
      _ = ∑ y, ∑ x, γ (x, y) * siteKernel k i y y' := by
          rw [Fintype.sum_prod_type, Finset.sum_comm]
          exact sum_congr rfl fun y _ => sum_congr rfl fun x _ => by
            rw [sum_pairKernel_snd (fun x y b => (hπ x y).2.2 b)]
      _ = ∑ y, ν y * siteKernel k i y y' := by
          refine sum_congr rfl fun y _ => ?_
          rw [← sum_mul, hγ.2.2 y]
      _ = ν y' := hν y'

/-- Discrepancy of a coupled update, written through the old pair. -/
lemma disc_coupledUpdate (dX : X → X → ℝ) (π : (ι → X) → (ι → X) → X × X → ℝ) (i j : ι)
    (γ : (ι → X) × (ι → X) → ℝ) :
    disc dX (coupledUpdate π i γ) j = ∑ z, γ z * ∑ a, ∑ b, π z.1 z.2 (a, b) *
      dX (Function.update z.1 i a j) (Function.update z.2 i b j) := by
  simp only [disc, coupledUpdate, sum_mul]
  rw [Finset.sum_comm]
  refine sum_congr rfl fun z _ => ?_
  simp_rw [mul_assoc, ← mul_sum]
  rw [sum_pairKernel_mul π i z (fun z' => dX (z'.1 j) (z'.2 j))]

/-- **Other sites unchanged.** For `j ≠ i` the coupled update keeps the discrepancy at `j`. -/
theorem disc_coupledUpdate_ne (dX : X → X → ℝ) {k : (ι → X) → X → ℝ}
    {π : (ι → X) → (ι → X) → X × X → ℝ} (hπ : ∀ x y, IsCoupling (k x) (k y) (π x y))
    (hk : ∀ x, IsProb (k x)) (i j : ι) (hij : j ≠ i) (γ : (ι → X) × (ι → X) → ℝ) :
    disc dX (coupledUpdate π i γ) j = disc dX γ j := by
  rw [disc_coupledUpdate]
  refine sum_congr rfl fun z _ => ?_
  simp only [Function.update_of_ne hij]
  have h1 : ∑ a, ∑ b, π z.1 z.2 (a, b) = 1 := by
    simp_rw [(hπ z.1 z.2).2.1]; exact (hk z.1).2
  have h2 : ∑ a, ∑ b, π z.1 z.2 (a, b) * dX (z.1 j) (z.2 j) =
      (∑ a, ∑ b, π z.1 z.2 (a, b)) * dX (z.1 j) (z.2 j) := by
    simp only [sum_mul]
  rw [h2, h1, one_mul]

/-- **The updated site.** The discrepancy at `i` after the update is the average transport cost. -/
theorem disc_coupledUpdate_self (dX : X → X → ℝ) (π : (ι → X) → (ι → X) → X × X → ℝ) (i : ι)
    (γ : (ι → X) × (ι → X) → ℝ) :
    disc dX (coupledUpdate π i γ) i = ∑ z, γ z * tcost dX (π z.1 z.2) := by
  rw [disc_coupledUpdate]
  simp only [Function.update_self, tcost]

omit [DecidableEq X] in
lemma disc_nonneg (dX : X → X → ℝ) (hd : ∀ a b, 0 ≤ dX a b) {γ : (ι → X) × (ι → X) → ℝ}
    (hγ : ∀ z, 0 ≤ γ z) (i : ι) : 0 ≤ disc dX γ i :=
  sum_nonneg fun z _ => mul_nonneg (hγ z) (hd _ _)

omit [DecidableEq X] in
lemma disc_le (dX : X → X → ℝ) (D : ℝ) (hD : ∀ a b, dX a b ≤ D) {μ ν : (ι → X) → ℝ}
    {γ : (ι → X) × (ι → X) → ℝ} (hγ : IsCoupling μ ν γ) (hμ : IsProb μ) (i : ι) :
    disc dX γ i ≤ D := by
  calc disc dX γ i ≤ ∑ z, γ z * D := sum_le_sum fun z _ => mul_le_mul_of_nonneg_left (hD _ _) (hγ.1 z)
    _ = D := by rw [← sum_mul, hγ.total hμ, one_mul]

omit [DecidableEq X] in
lemma continuous_cost (dX : X → X → ℝ) (w : ι → ℝ) :
    Continuous fun γ : (ι → X) × (ι → X) → ℝ => ∑ i, w i * disc dX γ i :=
  continuous_finsetSum _ fun _ _ => continuous_const.mul
    (continuous_finsetSum _ fun z _ => (continuous_apply z).mul continuous_const)

/-- **G1 on a finite spin space.** Let `μ` and `ν` be laws on configurations that are stationary
under the same single-site kernels `k i` at every site outside `S`, and suppose each such kernel
satisfies the Dobrushin bound with coefficients `C`: for all `x, y` some coupling of `k i x` and
`k i y` costs at most `∑ⱼ C i j · dX (x j) (y j)`. If `0 ≤ dX ≤ D` and the weighted column condition
holds with `θ < 1`, then some coupling `γ` of `μ` and `ν` satisfies
`∑_{e ∉ S} w e · E_γ dX(xₑ, yₑ) ≤ θ D / (1 - θ) ∑_{z ∈ S} w z`. -/
theorem finite_dobrushin_comparison (dX : X → X → ℝ) (hd : ∀ a b, 0 ≤ dX a b) (D : ℝ)
    (hdD : ∀ a b, dX a b ≤ D) {μ ν : (ι → X) → ℝ} (hμ : IsProb μ) (hν : IsProb ν)
    (S : Finset ι) (k : ι → (ι → X) → X → ℝ) (hk : ∀ i x, IsProb (k i x))
    (hμk : ∀ i ∉ S, Stationary μ (k i) i) (hνk : ∀ i ∉ S, Stationary ν (k i) i)
    (C : ι → ι → ℝ) (hC : ∀ i j, 0 ≤ C i j)
    (hW : ∀ i ∉ S, ∀ x y, ∃ π, IsCoupling (k i x) (k i y) π ∧
      tcost dX π ≤ ∑ j, C i j * dX (x j) (y j))
    (w : ι → ℝ) (hw : ∀ i, 0 < w i) (θ : ℝ) (hθ : θ < 1) (hθ0 : 0 ≤ θ)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j) :
    ∃ γ, IsCoupling μ ν γ ∧
      ∑ i ∈ Sᶜ, w i * disc dX γ i ≤ θ * D / (1 - θ) * ∑ j ∈ S, w j := by
  classical
  choose! π hπ hπcost using hW
  obtain ⟨γ, hγ, hmin⟩ := exists_min_coupling hμ hν _ (continuous_cost dX w)
  refine ⟨γ, hγ, ?_⟩
  have hupd : ∀ i ∉ S, IsCoupling μ ν (coupledUpdate (π i) i γ) := fun i hi =>
    coupledUpdate_isCoupling hγ (hπ i hi) (hμk i hi) (hνk i hi)
  refine CouplingMinimality.comparison_of_minimality S w (disc dX) γ
    (fun i => coupledUpdate (π i) i γ) C θ D hθ hθ0 hC hw (disc_nonneg dX hd hγ.1)
    (fun i _ => disc_le dX D hdD hγ hμ i) (fun i hi => hmin _ (hupd i hi))
    (fun i hi j hj => disc_coupledUpdate_ne dX (hπ i hi) (hk i) i j hj γ)
    (fun i hi => ?_) hcol
  rw [disc_coupledUpdate_self]
  calc ∑ z, γ z * tcost dX (π i z.1 z.2)
      ≤ ∑ z, γ z * ∑ j, C i j * dX (z.1 j) (z.2 j) :=
        sum_le_sum fun z _ => mul_le_mul_of_nonneg_left (hπcost i hi z.1 z.2) (hγ.1 z)
    _ = ∑ j, C i j * disc dX γ j := by
        simp only [disc, mul_sum]
        rw [Finset.sum_comm]
        exact sum_congr rfl fun j _ => sum_congr rfl fun z _ => by ring

omit [DecidableEq X] in
/-- **Observables.** If `|f x - f y| ≤ ∑ᵢ aᵢ dX(xᵢ, yᵢ)` and `γ` couples `μ` and `ν`, then
`|E_μ f - E_ν f| ≤ ∑ᵢ aᵢ · disc γ i`. -/
theorem observable_bound (dX : X → X → ℝ) {μ ν : (ι → X) → ℝ} {γ : (ι → X) × (ι → X) → ℝ}
    (hγ : IsCoupling μ ν γ) (f : (ι → X) → ℝ) (a : ι → ℝ)
    (hf : ∀ x y, |f x - f y| ≤ ∑ i, a i * dX (x i) (y i)) :
    |∑ x, μ x * f x - ∑ y, ν y * f y| ≤ ∑ i, a i * disc dX γ i := by
  have e : ∑ x, μ x * f x - ∑ y, ν y * f y = ∑ z, γ z * (f z.1 - f z.2) := by
    simp only [mul_sub, sum_sub_distrib, Fintype.sum_prod_type]
    congr 1
    · exact sum_congr rfl fun x _ => by rw [← sum_mul, hγ.2.1 x]
    · rw [Finset.sum_comm]
      exact sum_congr rfl fun y _ => by rw [← sum_mul, hγ.2.2 y]
  rw [e]
  calc |∑ z, γ z * (f z.1 - f z.2)| ≤ ∑ z, |γ z * (f z.1 - f z.2)| := abs_sum_le_sum_abs _ _
    _ = ∑ z, γ z * |f z.1 - f z.2| := sum_congr rfl fun z _ => by
        rw [abs_mul, abs_of_nonneg (hγ.1 z)]
    _ ≤ ∑ z, γ z * ∑ i, a i * dX (z.1 i) (z.2 i) :=
        sum_le_sum fun z _ => mul_le_mul_of_nonneg_left (hf z.1 z.2) (hγ.1 z)
    _ = ∑ i, a i * disc dX γ i := by
        simp only [disc, mul_sum]
        rw [Finset.sum_comm]
        exact sum_congr rfl fun i _ => sum_congr rfl fun z _ => by ring

end Configurations

section Gibbs

variable {ι X : Type*} [Fintype ι] [DecidableEq ι] [Fintype X] [DecidableEq X]

/-- The Gibbs law of a weight `Φ`: `Φ x / ∑ Φ`. -/
noncomputable def gibbs (Φ : (ι → X) → ℝ) (x : ι → X) : ℝ := Φ x / ∑ x', Φ x'

/-- The heat-bath kernel at `i`: the conditional law under `Φ` of the spin at `i` given the others. -/
noncomputable def heatBath (Φ : (ι → X) → ℝ) (i : ι) (x : ι → X) (a : X) : ℝ :=
  Φ (Function.update x i a) / ∑ b, Φ (Function.update x i b)

omit [DecidableEq X] in
theorem gibbs_isProb [Nonempty X] (Φ : (ι → X) → ℝ) (hΦ : ∀ x, 0 < Φ x) : IsProb (gibbs Φ) := by
  have hZ : 0 < ∑ x, Φ x := sum_pos (fun x _ => hΦ x) univ_nonempty
  refine ⟨fun x => div_nonneg (hΦ x).le hZ.le, ?_⟩
  simp only [gibbs]
  rw [← sum_div, div_self hZ.ne']

omit [Fintype ι] [DecidableEq X] in
theorem heatBath_isProb [Nonempty X] (Φ : (ι → X) → ℝ) (hΦ : ∀ x, 0 < Φ x) (i : ι) (x : ι → X) :
    IsProb (heatBath Φ i x) := by
  have hN : 0 < ∑ b, Φ (Function.update x i b) := sum_pos (fun b _ => hΦ _) univ_nonempty
  refine ⟨fun a => div_nonneg (hΦ _).le hN.le, ?_⟩
  simp only [heatBath]
  rw [← sum_div, div_self hN.ne']

omit [Fintype ι] [Fintype X] [DecidableEq X] in
lemma eq_update_iff' (x x' : ι → X) (i : ι) (a : X) :
    x' = Function.update x i a ↔ a = x' i ∧ x' = Function.update x i (x' i) := by
  constructor
  · intro h; subst h; simp
  · rintro ⟨rfl, h⟩; exact h

omit [Fintype ι] [Fintype X] [DecidableEq X] in
lemma agree_comm (x x' : ι → X) (i : ι) :
    x' = Function.update x i (x' i) ↔ x = Function.update x' i (x i) := by
  simp only [Function.eq_update_iff, true_and]
  exact ⟨fun h j hj => (h j hj).symm, fun h j hj => (h j hj).symm⟩

omit [Fintype X] in
/-- Only `a = x' i` can satisfy `x' = update x i a`. -/
lemma ite_eq_update (x x' : ι → X) (i : ι) (a : X) (f : X → ℝ) :
    (if x' = Function.update x i a then f a else 0) =
      if a = x' i then (if x' = Function.update x i (x' i) then f (x' i) else 0) else 0 := by
  by_cases ha : a = x' i
  · subst ha; simp
  · have hne : ¬ x' = Function.update x i a := fun h => ha (by rw [h, Function.update_self])
    simp [hne, ha]

/-- The configurations that agree with `x'` off `i` are the `update x' i c`. -/
lemma sum_fiber (g : (ι → X) → ℝ) (x' : ι → X) (i : ι) :
    ∑ x, (if x' = Function.update x i (x' i) then g x else 0) = ∑ c, g (Function.update x' i c) := by
  have key : ∀ x, (if x' = Function.update x i (x' i) then g x else 0) =
      ∑ c, if x = Function.update x' i c then g x else 0 := by
    intro x
    have hs : ∑ c, (if x = Function.update x' i c then g x else 0) =
        ∑ c, (if c = x i then (if x = Function.update x' i (x i) then g x else 0) else 0) :=
      Finset.sum_congr rfl fun c _ => ite_eq_update x' x i c (fun _ => g x)
    rw [hs, Finset.sum_ite_eq']
    simp only [mem_univ, if_true]
    exact if_congr (agree_comm x x' i) rfl rfl
  rw [sum_congr rfl fun x _ => key x, Finset.sum_comm]
  refine sum_congr rfl fun c _ => ?_
  rw [Finset.sum_ite_eq']
  simp

/-- **Finite DLR equation.** A Gibbs law is stationary under its own heat bath at every site. -/
theorem gibbs_stationary [Nonempty X] (Φ : (ι → X) → ℝ) (hΦ : ∀ x, 0 < Φ x) (i : ι) :
    Stationary (gibbs Φ) (heatBath Φ i) i := by
  intro x'
  have hZ : 0 < ∑ x, Φ x := sum_pos (fun x _ => hΦ x) univ_nonempty
  set Z := ∑ x, Φ x with hZdef
  set N := ∑ b, Φ (Function.update x' i b) with hNdef
  have hN : 0 < N := sum_pos (fun b _ => hΦ _) univ_nonempty
  have step : ∀ x, gibbs Φ x * siteKernel (heatBath Φ i) i x x' =
      (if x' = Function.update x i (x' i) then Φ x else 0) * (Φ x' / (Z * N)) := by
    intro x
    unfold siteKernel
    have hs : ∑ a, (if x' = Function.update x i a then heatBath Φ i x a else 0) =
        ∑ a, (if a = x' i then (if x' = Function.update x i (x' i) then heatBath Φ i x (x' i) else 0)
          else 0) :=
      Finset.sum_congr rfl fun a _ => ite_eq_update x x' i a (heatBath Φ i x)
    rw [hs, Finset.sum_ite_eq']
    simp only [mem_univ, if_true]
    by_cases h : x' = Function.update x i (x' i)
    · have hloc : ∑ b, Φ (Function.update x i b) = N := by
        rw [hNdef]
        exact sum_congr rfl fun b _ => by rw [h, Function.update_idem]
      simp only [if_pos h, gibbs, heatBath]
      rw [← h, hloc, ← hZdef]
      field_simp
    · simp only [if_neg h, mul_zero, zero_mul]
  rw [sum_congr rfl fun x _ => step x, ← sum_mul, sum_fiber Φ x' i, ← hNdef]
  simp only [gibbs, ← hZdef]
  field_simp

omit [Fintype ι] [DecidableEq X] in
/-- A factor that does not depend on the spin at `i` leaves the heat bath at `i` unchanged. -/
theorem heatBath_mul_invariant (Φ g : (ι → X) → ℝ) (i : ι)
    (hg : ∀ x a, g (Function.update x i a) = g x) (hg0 : ∀ x, g x ≠ 0) :
    heatBath (fun x => Φ x * g x) i = heatBath Φ i := by
  funext x a
  simp only [heatBath, hg]
  rw [← sum_mul, mul_div_mul_right _ _ (hg0 x)]

end Gibbs

section Example

/-! ### A two-site Ising instance: the hypotheses are satisfiable with `μ ≠ ν`

Two sites (`Fin 2`), spins `Bool`, discrete metric. `μ` has pair weight `2` for equal spins and `1`
otherwise; `ν` adds a field of weight `3` on `spin 0 = true`. The laws differ only through site `0`,
so `S = {0}`, and both are stationary under the same heat bath at site `1`, whose two conditional
laws (for the two values of the spin at `0`) are at total-variation distance `1/3`. -/

/-- The discrete metric on `Bool`. -/
def dB (a b : Bool) : ℝ := if a = b then 0 else 1

/-- Ferromagnetic pair weight. -/
def pairW (a b : Bool) : ℝ := if a = b then 2 else 1

/-- The weight of `μ`. -/
def Φμ (x : Fin 2 → Bool) : ℝ := pairW (x 0) (x 1)

/-- The field factor on site `0`. -/
def fieldW (x : Fin 2 → Bool) : ℝ := if x 0 = true then 3 else 1

/-- The weight of `ν`. -/
def Φν (x : Fin 2 → Bool) : ℝ := Φμ x * fieldW x

/-- The Dobrushin coefficients: site `1` is influenced by site `0` with coefficient `1/3`. -/
noncomputable def Cex (i j : Fin 2) : ℝ := if i = 1 ∧ j = 0 then 1 / 3 else 0

lemma pairW_pos (a b : Bool) : 0 < pairW a b := by unfold pairW; split_ifs <;> norm_num

lemma Φμ_pos (x : Fin 2 → Bool) : 0 < Φμ x := pairW_pos _ _

lemma Φν_pos (x : Fin 2 → Bool) : 0 < Φν x := by
  unfold Φν fieldW; split_ifs <;> nlinarith [Φμ_pos x]

lemma heatBath_one (x : Fin 2 → Bool) (a : Bool) : heatBath Φμ 1 x a = pairW (x 0) a / 3 := by
  have h01 : (0 : Fin 2) ≠ 1 := by decide
  simp only [heatBath, Φμ, Function.update_of_ne h01, Function.update_self, Fintype.sum_bool]
  congr 1
  cases x 0 <;> simp [pairW] <;> norm_num

lemma heatBath_ν : heatBath Φν 1 = heatBath Φμ 1 := by
  have h01 : (0 : Fin 2) ≠ 1 := by decide
  exact heatBath_mul_invariant Φμ fieldW 1 (fun x a => by simp [fieldW])
    (fun x => by unfold fieldW; split_ifs <;> norm_num)

lemma hW_example : ∀ i ∉ ({0} : Finset (Fin 2)), ∀ x y : Fin 2 → Bool,
    ∃ π, IsCoupling (heatBath Φμ i x) (heatBath Φμ i y) π ∧
      tcost dB π ≤ ∑ j, Cex i j * dB (x j) (y j) := by
  intro i hi x y
  have hi1 : i = 1 := by
    fin_cases i
    · simp at hi
    · rfl
  subst hi1
  have hrhs : ∑ j, Cex 1 j * dB (x j) (y j) = 1 / 3 * dB (x 0) (y 0) := by
    simp [Cex]
  rw [hrhs]
  by_cases h : x 0 = y 0
  · have hxy : heatBath Φμ 1 x = heatBath Φμ 1 y := by
      funext a; rw [heatBath_one, heatBath_one, h]
    refine ⟨fun z => if z.1 = z.2 then heatBath Φμ 1 x z.1 else 0, ?_, ?_⟩
    · rw [← hxy]; exact diag_isCoupling (heatBath_isProb Φμ Φμ_pos 1 x)
    · rw [tcost_diag dB (fun a => by simp [dB])]
      exact mul_nonneg (by norm_num) (by unfold dB; split_ifs; norm_num)
  · refine ⟨fun z => if z.1 = z.2 then 1 / 3 else if z.1 = x 0 then 1 / 3 else 0, ⟨?_, ?_, ?_⟩, ?_⟩
    · intro z; dsimp only; split_ifs <;> norm_num
    · intro a
      rw [heatBath_one]
      cases hx : x 0 <;> cases a <;> simp [pairW] <;> norm_num
    · intro b
      rw [heatBath_one]
      have hy : y 0 = !x 0 := by cases hx : x 0 <;> cases hy : y 0 <;> simp_all
      rw [hy]
      cases hx : x 0 <;> cases b <;> simp [pairW] <;> norm_num
    · have hd : dB (x 0) (y 0) = 1 := by simp [dB, h]
      rw [hd]
      cases hx : x 0 <;> simp [tcost, dB]

/-- **Non-vacuity.** In the two-site instance the two Gibbs laws differ, every hypothesis of
`finite_dobrushin_comparison` is discharged, and it yields a coupling with `E[x₁ ≠ y₁] ≤ 1/2`
(the trivial bound is `1`). -/
theorem example_comparison :
    gibbs Φμ ≠ gibbs Φν ∧
      ∃ γ, IsCoupling (gibbs Φμ) (gibbs Φν) γ ∧ disc dB γ 1 ≤ 1 / 2 := by
  refine ⟨fun h => ?_, ?_⟩
  · have hZ : 0 < ∑ x, Φν x := sum_pos (fun x _ => Φν_pos x) univ_nonempty
    have h1 := congrFun h (fun _ => true)
    have h2 := congrFun h (fun _ => false)
    have e1 : Φμ (fun _ => true) = 2 := by simp [Φμ, pairW]
    have e2 : Φν (fun _ => true) = 6 := by norm_num [Φν, Φμ, fieldW, pairW]
    have e3 : Φμ (fun _ => false) = 2 := by simp [Φμ, pairW]
    have e4 : Φν (fun _ => false) = 2 := by norm_num [Φν, Φμ, fieldW, pairW]
    simp only [gibbs] at h1 h2
    rw [e1, e2] at h1
    rw [e3, e4] at h2
    rw [h2, div_eq_div_iff hZ.ne' hZ.ne'] at h1
    linarith
  · have hνk : ∀ i ∉ ({0} : Finset (Fin 2)), Stationary (gibbs Φν) (heatBath Φμ i) i := by
      intro i hi
      have hi1 : i = 1 := by
        fin_cases i
        · simp at hi
        · rfl
      subst hi1
      rw [← heatBath_ν]
      exact gibbs_stationary Φν Φν_pos 1
    obtain ⟨γ, hγ, hb⟩ := finite_dobrushin_comparison dB
      (fun a b => by unfold dB; split_ifs <;> norm_num) 1
      (fun a b => by unfold dB; split_ifs <;> norm_num)
      (gibbs_isProb Φμ Φμ_pos) (gibbs_isProb Φν Φν_pos) {0} (heatBath Φμ)
      (fun i x => heatBath_isProb Φμ Φμ_pos i x) (fun i _ => gibbs_stationary Φμ Φμ_pos i) hνk
      Cex (fun i j => by unfold Cex; split_ifs <;> norm_num) hW_example (fun _ => 1)
      (fun _ => one_pos) (1 / 3) (by norm_num) (by norm_num)
      (fun j => by fin_cases j <;> simp [Cex])
    refine ⟨γ, hγ, ?_⟩
    have hc : ({0} : Finset (Fin 2))ᶜ = {1} := by decide
    rw [hc, sum_singleton, sum_singleton] at hb
    norm_num at hb
    linarith

end Example

end YangMills.StrongCoupling.FiniteCoupling

end Part4_FiniteCoupling

section Part5_CompactCoupling

/-!
# G1 on a compact metric spin space: a cost-minimising coupling exists

Part 2 (`CouplingMinimality`) turns cost minimality into the discrepancy recurrence; Part 4 (`FiniteCoupling`)
discharges the whole chain on finite spin spaces. On a compact metric space (such as `ι → SU(2)`)
the existence of the minimiser is a compactness statement, proved here:

* `isClosed_couplings`, `isCompact_couplings`: the couplings of two probability measures form a
  closed, hence compact, subset of the probability measures on `E × E` with the weak topology
  (Prokhorov on a compact space: Mathlib's `CompactSpace (ProbabilityMeasure _)`);
* `exists_min_coupling`: a continuous cost `c` on `E × E` has a minimising coupling;
* `exists_min_coupling_config`: on configurations `ι → X` with `X` compact metric, the weighted
  discrepancy `∑ᵢ wᵢ d(xᵢ, yᵢ)` has a minimising coupling;
* `isCoupling_of_mem`: such a minimiser is a coupling in the sense of
  `WassersteinBridge.IsCoupling` (marginals of the underlying measures), so the measure-level lemmas
  of the bridge (`coupled_update_isCoupling`, `bind_step_le`) apply to it.

Still open (the remaining part of G1 on compact spaces): for each site, a measurable coupled update
kernel whose marginals are the single-site heat baths and whose expected discrepancy at the site is
at most `∑ⱼ C i j dⱼ + εᵢ`. With it, `CouplingMinimality.recurrence_with_error` gives the recurrence
with the loss `εᵢ / wᵢ`.
-/

open MeasureTheory

namespace YangMills.StrongCoupling.CompactCoupling

variable {E : Type*} [MetricSpace E] [CompactSpace E] [MeasurableSpace E] [BorelSpace E]

/-- The couplings of `μ` and `ν`: probability measures on `E × E` with marginals `μ` and `ν`. -/
def couplings (μ ν : ProbabilityMeasure E) : Set (ProbabilityMeasure (E × E)) :=
  {γ | γ.map measurable_fst.aemeasurable = μ ∧ γ.map measurable_snd.aemeasurable = ν}

omit [MetricSpace E] [CompactSpace E] [BorelSpace E] in
/-- The product coupling: the set of couplings is nonempty. -/
theorem prod_mem_couplings (μ ν : ProbabilityMeasure E) : μ.prod ν ∈ couplings μ ν :=
  ⟨ProbabilityMeasure.map_fst_prod μ ν, ProbabilityMeasure.map_snd_prod μ ν⟩

theorem isClosed_couplings (μ ν : ProbabilityMeasure E) : IsClosed (couplings μ ν) := by
  have h1 : IsClosed {γ : ProbabilityMeasure (E × E) | γ.map measurable_fst.aemeasurable = μ} :=
    isClosed_eq (ProbabilityMeasure.continuous_map continuous_fst) continuous_const
  have h2 : IsClosed {γ : ProbabilityMeasure (E × E) | γ.map measurable_snd.aemeasurable = ν} :=
    isClosed_eq (ProbabilityMeasure.continuous_map continuous_snd) continuous_const
  exact h1.inter h2

/-- **Weak compactness of the couplings.** -/
theorem isCompact_couplings (μ ν : ProbabilityMeasure E) : IsCompact (couplings μ ν) :=
  (isClosed_couplings μ ν).isCompact

/-- **A cost-minimising coupling exists** for every continuous cost on `E × E`. -/
theorem exists_min_coupling (μ ν : ProbabilityMeasure E) (c : E × E → ℝ) (hc : Continuous c) :
    ∃ γ ∈ couplings μ ν, ∀ γ' ∈ couplings μ ν,
      ∫ z, c z ∂(γ : Measure (E × E)) ≤ ∫ z, c z ∂(γ' : Measure (E × E)) := by
  let f : BoundedContinuousFunction (E × E) ℝ := BoundedContinuousFunction.mkOfCompact ⟨c, hc⟩
  have hf : Continuous fun γ : ProbabilityMeasure (E × E) => ∫ z, f z ∂(γ : Measure (E × E)) :=
    ProbabilityMeasure.continuous_integral_boundedContinuousFunction f
  obtain ⟨γ, hγ, hmin⟩ := (isCompact_couplings μ ν).exists_isMinOn ⟨_, prod_mem_couplings μ ν⟩
    hf.continuousOn
  exact ⟨γ, hγ, fun γ' h' => hmin h'⟩

omit [MetricSpace E] [CompactSpace E] [BorelSpace E] in
/-- A coupling in this sense is a coupling of the underlying measures, as in
`WassersteinBridge.IsCoupling`. -/
theorem isCoupling_of_mem {μ ν : ProbabilityMeasure E} {γ : ProbabilityMeasure (E × E)}
    (h : γ ∈ couplings μ ν) :
    WassersteinBridge.IsCoupling (μ : Measure E) (ν : Measure E) (γ : Measure (E × E)) := by
  obtain ⟨h1, h2⟩ := h
  constructor
  · rw [← h1, ProbabilityMeasure.toMeasure_map]
  · rw [← h2, ProbabilityMeasure.toMeasure_map]

/-- **Configurations.** On `ι → X` with `X` compact metric, the weighted expected discrepancy
`∑ᵢ wᵢ E_γ d(xᵢ, yᵢ)` has a minimising coupling of any two probability measures. -/
theorem exists_min_coupling_config {ι X : Type*} [Fintype ι] [MetricSpace X] [CompactSpace X]
    [MeasurableSpace X] [BorelSpace X] (μ ν : ProbabilityMeasure (ι → X)) (w : ι → ℝ) :
    ∃ γ ∈ couplings μ ν, ∀ γ' ∈ couplings μ ν,
      ∫ z, (∑ i, w i * dist (z.1 i) (z.2 i)) ∂(γ : Measure ((ι → X) × (ι → X))) ≤
        ∫ z, (∑ i, w i * dist (z.1 i) (z.2 i)) ∂(γ' : Measure ((ι → X) × (ι → X))) :=
  exists_min_coupling μ ν _ (continuous_finsetSum _ fun i _ => continuous_const.mul
    (((continuous_apply i).comp continuous_fst).dist ((continuous_apply i).comp continuous_snd)))

end YangMills.StrongCoupling.CompactCoupling

end Part5_CompactCoupling

section Part6_CouplingLimit

/-!
# G1 on a compact metric spin space from finite discretisations

Part 4 (`FiniteCoupling`) proves the Dobrushin comparison, with the coupling constructed, on finite spin
spaces; Part 5 (`CompactCoupling`) shows the couplings of two probability measures on a compact metric
space are weakly compact. This file passes the finite theorem to the limit (route 1:
no measurable selection of couplings is needed).

* `exists_coupling_of_limit`: if `γₙ` couples `μₙ` and `νₙ`, `μₙ → μ`, `νₙ → ν` weakly, and the cost of
  `γₙ` (a continuous function) is at most `Bₙ → B`, then some coupling of `μ` and `ν` costs at most `B`.
* `pushMeasure`, `pushProb`, `push_mem_couplings`, `integral_pushMeasure`: a finite law on `α` is moved
  into a measurable space along `e : α → β` as a finite sum of Dirac masses; couplings go to couplings.
* `finite_dobrushin_source`: the finite comparison when the Dobrushin bound holds only up to an
  additive error `η` (the discretisation error), in source form,
  `∑ᵢ wᵢ ρᵢ ≤ (1 / (1 - θ)) ∑ᵢ wᵢ bᵢ` with `bᵢ = D` on `S` and `bᵢ = η` off `S`.
* `compact_comparison_of_discretizations`: on `ι → X` with `X` compact metric, if finite
  discretisations (finite spin sets `Y n` mapped into `X`) satisfy the hypotheses of the finite
  theorem with errors `η n → 0`, and their laws converge weakly to `μ` and `ν`, then some coupling of
  `μ` and `ν` satisfies `∑ᵢ wᵢ E dist(xᵢ, yᵢ) ≤ (1 / (1 - θ)) D ∑_{i ∈ S} wᵢ`.
* `example_limit`: the hypotheses are satisfiable with `μ ≠ ν` (the two-site Ising laws of
  `FiniteCoupling`, in the unit interval).

Open, and not assumed anywhere in the library: that the heat baths of the SU(2) Wilson action have
such discretisations, i.e. the Dobrushin bound for the discretised kernels with an error that tends to
zero **uniformly in the boundary configuration**, and the weak convergence of the discretised laws.
-/

open MeasureTheory Filter Topology Finset

namespace YangMills.StrongCoupling.CouplingLimit

open CompactCoupling FiniteCoupling

section Limit

variable {E : Type*} [MetricSpace E] [CompactSpace E] [MeasurableSpace E] [BorelSpace E]

/-- **Weak limits of couplings.** -/
theorem exists_coupling_of_limit {μ ν : ProbabilityMeasure E} {μs νs : ℕ → ProbabilityMeasure E}
    (hμ : Tendsto μs atTop (𝓝 μ)) (hν : Tendsto νs atTop (𝓝 ν))
    (γs : ℕ → ProbabilityMeasure (E × E)) (hγ : ∀ n, γs n ∈ couplings (μs n) (νs n))
    (c : E × E → ℝ) (hc : Continuous c) (B : ℕ → ℝ) {Blim : ℝ} (hB : Tendsto B atTop (𝓝 Blim))
    (hcost : ∀ n, ∫ z, c z ∂(γs n : Measure (E × E)) ≤ B n) :
    ∃ γ ∈ couplings μ ν, ∫ z, c z ∂(γ : Measure (E × E)) ≤ Blim := by
  obtain ⟨γ, -, φ, hφ, hlim⟩ := isCompact_univ.tendsto_subseq (x := γs) (fun n => Set.mem_univ _)
  have hφt := hφ.tendsto_atTop
  refine ⟨γ, ⟨?_, ?_⟩, ?_⟩
  · have h1 := ((ProbabilityMeasure.continuous_map continuous_fst).tendsto γ).comp hlim
    have h2 : Tendsto (fun n => (γs (φ n)).map measurable_fst.aemeasurable) atTop (𝓝 μ) := by
      have e : (fun n => (γs (φ n)).map measurable_fst.aemeasurable) = μs ∘ φ :=
        funext fun n => (hγ (φ n)).1
      rw [e]; exact hμ.comp hφt
    exact tendsto_nhds_unique h1 h2
  · have h1 := ((ProbabilityMeasure.continuous_map continuous_snd).tendsto γ).comp hlim
    have h2 : Tendsto (fun n => (γs (φ n)).map measurable_snd.aemeasurable) atTop (𝓝 ν) := by
      have e : (fun n => (γs (φ n)).map measurable_snd.aemeasurable) = νs ∘ φ :=
        funext fun n => (hγ (φ n)).2
      rw [e]; exact hν.comp hφt
    exact tendsto_nhds_unique h1 h2
  · let f : BoundedContinuousFunction (E × E) ℝ := BoundedContinuousFunction.mkOfCompact ⟨c, hc⟩
    have h1 := ((ProbabilityMeasure.continuous_integral_boundedContinuousFunction f).tendsto γ).comp hlim
    exact le_of_tendsto_of_tendsto' h1 (hB.comp hφt) fun n => hcost (φ n)

end Limit

section Transfer

variable {α β : Type*} [Fintype α] [MeasurableSpace β]

/-- A finite law on `α`, moved along `e : α → β`: the finite sum of Dirac masses `∑ₐ p a δ_{e a}`. -/
noncomputable def pushMeasure (e : α → β) (p : α → ℝ) : Measure β :=
  ∑ a, ENNReal.ofReal (p a) • Measure.dirac (e a)

lemma pushMeasure_apply (e : α → β) (p : α → ℝ) {s : Set β} (hs : MeasurableSet s) :
    pushMeasure e p s = ∑ a, ENNReal.ofReal (p a) * s.indicator 1 (e a) := by
  simp [pushMeasure, Finset.sum_apply, Measure.dirac_apply' _ hs]

lemma pushMeasure_isProb {e : α → β} {p : α → ℝ} (hp : IsProb p) :
    IsProbabilityMeasure (pushMeasure e p) := by
  constructor
  rw [pushMeasure_apply e p MeasurableSet.univ]
  simp only [Set.indicator_univ, Pi.one_apply, mul_one]
  rw [← ENNReal.ofReal_sum_of_nonneg fun a _ => hp.1 a, hp.2, ENNReal.ofReal_one]

/-- `pushMeasure` as a probability measure. -/
noncomputable def pushProb (e : α → β) (p : α → ℝ) (hp : IsProb p) : ProbabilityMeasure β :=
  ⟨pushMeasure e p, pushMeasure_isProb hp⟩

lemma integral_pushMeasure [MeasurableSingletonClass β] (e : α → β) {p : α → ℝ}
    (hp : ∀ a, 0 ≤ p a) (f : β → ℝ) :
    ∫ x, f x ∂(pushMeasure e p) = ∑ a, p a * f (e a) := by
  unfold pushMeasure
  rw [integral_finsetSum_measure fun a _ => (integrable_dirac (by simp)).smul_measure ENNReal.ofReal_ne_top]
  refine sum_congr rfl fun a _ => ?_
  rw [integral_smul_measure, integral_dirac, ENNReal.toReal_ofReal (hp a), smul_eq_mul]

lemma map_pushMeasure {γ : Type*} [MeasurableSpace γ] (e : α → β) (p : α → ℝ) {g : β → γ}
    (hg : Measurable g) : (pushMeasure e p).map g = pushMeasure (g ∘ e) p := by
  ext s hs
  rw [Measure.map_apply hg hs, pushMeasure_apply e p (hg hs), pushMeasure_apply (g ∘ e) p hs]
  refine sum_congr rfl fun a _ => ?_
  congr 1

/-- Collecting the Dirac masses of a coupling by its first coordinate gives its first marginal. -/
lemma pushMeasure_fst {α' : Type*} [Fintype α'] (e : α → β) {p : α → ℝ} {q : α' → ℝ}
    {γ : α × α' → ℝ} (h : FiniteCoupling.IsCoupling p q γ) :
    pushMeasure (fun z : α × α' => e z.1) γ = pushMeasure e p := by
  unfold pushMeasure
  rw [Fintype.sum_prod_type]
  refine sum_congr rfl fun a _ => ?_
  dsimp only
  rw [← sum_smul, ← ENNReal.ofReal_sum_of_nonneg fun b _ => h.1 (a, b), h.2.1 a]

lemma pushMeasure_snd {α' : Type*} [Fintype α'] (e : α' → β) {p : α → ℝ} {q : α' → ℝ}
    {γ : α × α' → ℝ} (h : FiniteCoupling.IsCoupling p q γ) :
    pushMeasure (fun z : α × α' => e z.2) γ = pushMeasure e q := by
  unfold pushMeasure
  rw [Fintype.sum_prod_type, Finset.sum_comm]
  refine sum_congr rfl fun b _ => ?_
  dsimp only
  rw [← sum_smul, ← ENNReal.ofReal_sum_of_nonneg fun a _ => h.1 (a, b), h.2.2 b]

/-- A coupling of two laws is itself a law on pairs. -/
lemma coupling_isProb {p q : α → ℝ} {γ : α × α → ℝ} (h : FiniteCoupling.IsCoupling p q γ)
    (hp : IsProb p) : IsProb γ :=
  ⟨h.1, h.total hp⟩

/-- **Couplings go to couplings.** -/
theorem push_mem_couplings [TopologicalSpace β] [BorelSpace β] {e : α → β} {p q : α → ℝ}
    (hp : IsProb p) (hq : IsProb q) {γ : α × α → ℝ} (h : FiniteCoupling.IsCoupling p q γ) :
    pushProb (fun z : α × α => (e z.1, e z.2)) γ (coupling_isProb h hp) ∈
      couplings (pushProb e p hp) (pushProb e q hq) := by
  constructor
  · apply ProbabilityMeasure.toMeasure_injective
    rw [ProbabilityMeasure.toMeasure_map]
    show (pushMeasure (fun z : α × α => (e z.1, e z.2)) γ).map Prod.fst = pushMeasure e p
    rw [map_pushMeasure _ _ measurable_fst]
    exact pushMeasure_fst e h
  · apply ProbabilityMeasure.toMeasure_injective
    rw [ProbabilityMeasure.toMeasure_map]
    show (pushMeasure (fun z : α × α => (e z.1, e z.2)) γ).map Prod.snd = pushMeasure e q
    rw [map_pushMeasure _ _ measurable_snd]
    exact pushMeasure_snd e h

end Transfer

section Source

open Matrix

variable {ι X : Type*} [Fintype ι] [DecidableEq ι] [Fintype X] [DecidableEq X]

/-- **The finite comparison with an additive error.** As `finite_dobrushin_comparison`, but the
Dobrushin bound off `S` holds only up to `η ≥ 0`. In source form: with `bᵢ = D` on `S` and `bᵢ = η`
off `S`, some coupling satisfies `∑ᵢ wᵢ ρᵢ ≤ (1 / (1 - θ)) ∑ᵢ wᵢ bᵢ`. -/
theorem finite_dobrushin_source (dX : X → X → ℝ) (hd : ∀ a b, 0 ≤ dX a b) (D : ℝ)
    (hdD : ∀ a b, dX a b ≤ D) {μ ν : (ι → X) → ℝ} (hμ : IsProb μ) (hν : IsProb ν)
    (S : Finset ι) (k : ι → (ι → X) → X → ℝ) (hk : ∀ i x, IsProb (k i x))
    (hμk : ∀ i ∉ S, Stationary μ (k i) i) (hνk : ∀ i ∉ S, Stationary ν (k i) i)
    (C : ι → ι → ℝ) (hC : ∀ i j, 0 ≤ C i j) (η : ℝ)
    (hW : ∀ i ∉ S, ∀ x y, ∃ π, FiniteCoupling.IsCoupling (k i x) (k i y) π ∧
      tcost dX π ≤ ∑ j, C i j * dX (x j) (y j) + η)
    (w : ι → ℝ) (hw : ∀ i, 0 < w i) (θ : ℝ) (hθ : θ < 1)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j) :
    ∃ γ, FiniteCoupling.IsCoupling μ ν γ ∧
      ∑ i, w i * disc dX γ i ≤ 1 / (1 - θ) * ∑ i, w i * (if i ∈ S then D else η) := by
  classical
  choose! π hπ hπcost using hW
  obtain ⟨γ, hγ, hmin⟩ := FiniteCoupling.exists_min_coupling hμ hν _ (continuous_cost dX w)
  refine ⟨γ, hγ, ?_⟩
  have hrec : ∀ i, disc dX γ i ≤ (C *ᵥ disc dX γ) i + (if i ∈ S then D else η) := by
    intro i
    have hCd : 0 ≤ (C *ᵥ disc dX γ) i :=
      sum_nonneg fun j _ => mul_nonneg (hC i j) (disc_nonneg dX hd hγ.1 j)
    by_cases hi : i ∈ S
    · rw [if_pos hi]
      linarith [disc_le dX D hdD hγ hμ i]
    · rw [if_neg hi]
      have hupd := coupledUpdate_isCoupling hγ (hπ i hi) (hμk i hi) (hνk i hi)
      have h := CouplingMinimality.recurrence_of_minimality w (disc dX) γ
        (coupledUpdate (π i) i γ) C (fun _ => η) i (hw i) (hmin _ hupd)
        (fun j hj => disc_coupledUpdate_ne dX (hπ i hi) (hk i) i j hj γ) (by
          rw [disc_coupledUpdate_self]
          calc ∑ z, γ z * tcost dX (π i z.1 z.2)
              ≤ ∑ z, γ z * (∑ j, C i j * dX (z.1 j) (z.2 j) + η) :=
                sum_le_sum fun z _ => mul_le_mul_of_nonneg_left (hπcost i hi z.1 z.2) (hγ.1 z)
            _ = ∑ j, C i j * disc dX γ j + η := by
                simp only [mul_add, sum_add_distrib, ← sum_mul, hγ.total hμ, one_mul, disc, mul_sum]
                congr 1
                rw [Finset.sum_comm]
                exact sum_congr rfl fun j _ => sum_congr rfl fun z _ => by ring)
      simpa [Matrix.mulVec, dotProduct] using h
  exact WassersteinBridge.resolvent_comparison C w (disc dX γ) _ θ hθ (fun i => (hw i).le)
    (disc_nonneg dX hd hγ.1) hcol hrec

end Source

section Reduction

/-- **Route 1: G1 on a compact metric spin space from finite discretisations.** Let `X` be compact
metric and `μ`, `ν` probability measures on `ι → X`. Suppose that for each `n` a finite spin set
`Y n`, mapped into `X` by `e n`, carries laws `μf n`, `νf n` and kernels `k n` satisfying the
hypotheses of `finite_dobrushin_source` for the cost `dist (e n a) (e n b)` with fixed coefficients
`C` and errors `η n → 0`, and that the laws, moved into `ι → X`, converge weakly to `μ` and `ν`. Then
some coupling of `μ` and `ν` satisfies `∑ᵢ wᵢ E dist(xᵢ, yᵢ) ≤ (1 / (1 - θ)) ∑_{i ∈ S} wᵢ D`. -/
theorem compact_comparison_of_discretizations {ι X : Type*} [Fintype ι] [DecidableEq ι]
    [MetricSpace X] [CompactSpace X] [MeasurableSpace X] [BorelSpace X]
    (μ ν : ProbabilityMeasure (ι → X)) (S : Finset ι) (D : ℝ) (hdD : ∀ a b : X, dist a b ≤ D)
    (C : ι → ι → ℝ) (hC : ∀ i j, 0 ≤ C i j) (w : ι → ℝ) (hw : ∀ i, 0 < w i) (θ : ℝ) (hθ : θ < 1)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j)
    (Y : ℕ → Type) [∀ n, Fintype (Y n)] [∀ n, DecidableEq (Y n)] (e : ∀ n, Y n → X)
    (μf νf : ∀ n, (ι → Y n) → ℝ) (hμf : ∀ n, IsProb (μf n)) (hνf : ∀ n, IsProb (νf n))
    (k : ∀ n, ι → (ι → Y n) → Y n → ℝ) (hk : ∀ n i x, IsProb (k n i x))
    (hμk : ∀ n, ∀ i ∉ S, Stationary (μf n) (k n i) i)
    (hνk : ∀ n, ∀ i ∉ S, Stationary (νf n) (k n i) i)
    (η : ℕ → ℝ) (hη : Tendsto η atTop (𝓝 0))
    (hW : ∀ n, ∀ i ∉ S, ∀ x y, ∃ π, FiniteCoupling.IsCoupling (k n i x) (k n i y) π ∧
      tcost (fun a b => dist (e n a) (e n b)) π ≤ ∑ j, C i j * dist (e n (x j)) (e n (y j)) + η n)
    (hμlim : Tendsto (fun n => pushProb (fun x => e n ∘ x) (μf n) (hμf n)) atTop (𝓝 μ))
    (hνlim : Tendsto (fun n => pushProb (fun x => e n ∘ x) (νf n) (hνf n)) atTop (𝓝 ν)) :
    ∃ γ ∈ couplings μ ν, ∫ z, (∑ i, w i * dist (z.1 i) (z.2 i)) ∂(γ : Measure ((ι → X) × (ι → X))) ≤
      1 / (1 - θ) * ∑ i, w i * (if i ∈ S then D else 0) := by
  classical
  have hfin := fun n => finite_dobrushin_source (fun a b => dist (e n a) (e n b))
    (fun a b => dist_nonneg) D (fun a b => hdD _ _) (hμf n) (hνf n) S (k n) (hk n) (hμk n) (hνk n)
    C hC (η n) (hW n) w hw θ hθ hcol
  choose γf hγf hbound using hfin
  let γs : ℕ → ProbabilityMeasure ((ι → X) × (ι → X)) := fun n =>
    pushProb (fun z : (ι → Y n) × (ι → Y n) => (e n ∘ z.1, e n ∘ z.2)) (γf n)
      (coupling_isProb (hγf n) (hμf n))
  have hmem : ∀ n, γs n ∈ couplings (pushProb (fun x => e n ∘ x) (μf n) (hμf n))
      (pushProb (fun x => e n ∘ x) (νf n) (hνf n)) := fun n =>
    push_mem_couplings (e := fun x : ι → Y n => e n ∘ x) (hμf n) (hνf n) (hγf n)
  refine exists_coupling_of_limit hμlim hνlim γs hmem (fun z => ∑ i, w i * dist (z.1 i) (z.2 i))
    (continuous_finsetSum _ fun i _ => continuous_const.mul
      (((continuous_apply i).comp continuous_fst).dist ((continuous_apply i).comp continuous_snd)))
    (fun n => 1 / (1 - θ) * ∑ i, w i * (if i ∈ S then D else η n)) ?_ fun n => ?_
  · refine Tendsto.const_mul _ (tendsto_finsetSum _ fun i _ => Tendsto.const_mul _ ?_)
    by_cases hi : i ∈ S
    · simp only [hi, if_true]; exact tendsto_const_nhds
    · simp only [hi, if_false]; exact hη
  · have hint : ∫ z, (∑ i, w i * dist (z.1 i) (z.2 i)) ∂(γs n : Measure ((ι → X) × (ι → X))) =
        ∑ i, w i * disc (fun a b => dist (e n a) (e n b)) (γf n) i := by
      show ∫ z : (ι → X) × (ι → X), (∑ i, w i * dist (z.1 i) (z.2 i))
          ∂(pushMeasure (fun z : (ι → Y n) × (ι → Y n) => (e n ∘ z.1, e n ∘ z.2)) (γf n)) = _
      rw [integral_pushMeasure _ (hγf n).1]
      simp only [disc, Function.comp, mul_sum]
      rw [Finset.sum_comm]
      exact sum_congr rfl fun i _ => sum_congr rfl fun z _ => by ring
    rw [hint]
    exact hbound n

end Reduction

section Example

open FiniteCoupling

/-- The two Ising spins as the endpoints of the unit interval. -/
def eB (b : Bool) : unitInterval := if b then 1 else 0

lemma dist_eB (a b : Bool) : dist (eB a) (eB b) = dB a b := by
  cases a <;> cases b <;> simp [eB, dB, Subtype.dist_eq, dist_comm]

lemma eB_injective : Function.Injective eB := by
  intro a b h
  cases a <;> cases b <;> simp_all [eB]

/-- **Non-vacuity of the reduction.** The constant discretisation by the two-site Ising laws of
`FiniteCoupling` (spins embedded at `0` and `1` of the unit interval) satisfies every hypothesis of
`compact_comparison_of_discretizations` with `η = 0`; the two limit laws are distinct. -/
theorem example_limit :
    let μ := pushProb (fun x : Fin 2 → Bool => eB ∘ x) (gibbs Φμ) (gibbs_isProb Φμ Φμ_pos)
    let ν := pushProb (fun x : Fin 2 → Bool => eB ∘ x) (gibbs Φν) (gibbs_isProb Φν Φν_pos)
    μ ≠ ν ∧ ∃ γ ∈ couplings μ ν,
      ∫ z, (∑ i, dist (z.1 i) (z.2 i)) ∂(γ : Measure ((Fin 2 → unitInterval) × (Fin 2 → unitInterval))) ≤
        1 / (1 - 1 / 3) * ∑ i : Fin 2, (if i ∈ ({0} : Finset (Fin 2)) then (1 : ℝ) else 0) := by
  intro μ ν
  refine ⟨fun h => ?_, ?_⟩
  · -- distinct: the laws are recovered from the masses of the embedded configurations
    have hinj : Function.Injective fun x : Fin 2 → Bool => eB ∘ x := fun x y hxy =>
      funext fun i => eB_injective (congrFun hxy i)
    apply example_comparison.1
    funext x
    have hm := congrArg (fun m : ProbabilityMeasure (Fin 2 → unitInterval) =>
      (m : Measure (Fin 2 → unitInterval)) {eB ∘ x}) h
    simp only [μ, ν, pushProb, ProbabilityMeasure.coe_mk] at hm
    rw [pushMeasure_apply _ _ (measurableSet_singleton _), pushMeasure_apply _ _ (measurableSet_singleton _)] at hm
    have hind : ∀ y : Fin 2 → Bool, ({eB ∘ x} : Set (Fin 2 → unitInterval)).indicator 1 (eB ∘ y) =
        if y = x then (1 : ENNReal) else 0 := fun y => by
      by_cases hy : y = x
      · subst hy
        rw [Set.indicator_of_mem (Set.mem_singleton _), if_pos rfl, Pi.one_apply]
      · have hne : eB ∘ y ∉ ({eB ∘ x} : Set (Fin 2 → unitInterval)) := fun h' => hy (hinj h')
        rw [Set.indicator_of_notMem hne, if_neg hy]
    simp only [hind, mul_ite, mul_one, mul_zero, sum_ite_eq', mem_univ, if_true] at hm
    exact (ENNReal.ofReal_eq_ofReal_iff ((gibbs_isProb Φμ Φμ_pos).1 x)
      ((gibbs_isProb Φν Φν_pos).1 x)).mp hm
  · have hdist : ∀ n : ℕ, (fun a b => dist (eB a) (eB b)) = dB := fun _ => funext fun a => funext fun b => dist_eB a b
    have hνk : ∀ i ∉ ({0} : Finset (Fin 2)), Stationary (gibbs Φν) (heatBath Φμ i) i := by
      intro i hi
      have hi1 : i = 1 := by
        fin_cases i
        · simp at hi
        · rfl
      subst hi1
      rw [← heatBath_ν]
      exact gibbs_stationary Φν Φν_pos 1
    obtain ⟨γ, hγ, hb⟩ := compact_comparison_of_discretizations μ ν {0} 1
      (fun a b => by
        rcases a with ⟨a, ha⟩; rcases b with ⟨b, hb⟩
        rw [Subtype.dist_eq, Real.dist_eq]
        simp only [Set.mem_Icc] at ha hb
        rw [abs_le]; constructor <;> linarith)
      Cex (fun i j => by unfold Cex; split_ifs <;> norm_num) (fun _ => 1) (fun _ => one_pos) (1 / 3)
      (by norm_num) (fun j => by fin_cases j <;> simp [Cex])
      (fun _ => Bool) (fun _ => eB) (fun _ => gibbs Φμ) (fun _ => gibbs Φν)
      (fun _ => gibbs_isProb Φμ Φμ_pos) (fun _ => gibbs_isProb Φν Φν_pos) (fun _ => heatBath Φμ)
      (fun _ i x => heatBath_isProb Φμ Φμ_pos i x) (fun _ i _ => gibbs_stationary Φμ Φμ_pos i)
      (fun _ => hνk) (fun _ => 0) tendsto_const_nhds
      (fun n i hi x y => by
        obtain ⟨π, hπ, hc⟩ := hW_example i hi x y
        refine ⟨π, hπ, ?_⟩
        rw [hdist n, add_zero]
        simpa only [dist_eB] using hc)
      tendsto_const_nhds tendsto_const_nhds
    refine ⟨γ, hγ, ?_⟩
    simpa using hb

end Example

