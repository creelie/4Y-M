section Part7_FiniteGluing

/-!
# Gluing finite couplings, and kernels that are close to a Dobrushin kernel

The discretisation step needs the Dobrushin bound for discretised SU(2) heat baths with an error `η n → 0`. The
natural way to get it is to compare each discretised kernel with a reference kernel for which the
bound is known, and that comparison needs the triangle inequality for couplings. This file proves it
for finite laws and draws the consequences.

* `glue`, `glue_isCoupling`, `tcost_glue_le`: two couplings with a common middle marginal glue to a
  coupling of the outer marginals, and if the cost satisfies the triangle inequality the glued cost is
  at most the sum of the two costs (the gluing lemma on finite sets).
* `fW1`: the finite Kantorovich distance `inf_γ tcost d γ`. It is attained (`exists_fW1_eq`), and when
  `d` is a pseudometric it is a pseudometric on probability laws (`fW1_nonneg`, `fW1_self`,
  `fW1_comm`, `fW1_triangle`).
* `dobrushin_of_approx`: if every `k' x` is within transport cost `δ` of `k x`, and `k` satisfies a
  Dobrushin bound `B x y`, then `k'` satisfies it with `B x y + 2δ`.
* `finite_dobrushin_of_approx`, `compact_comparison_of_approx`: the finite comparison and the route-1
  reduction with hypothesis `hW` split into a reference kernel with the Dobrushin bound (error `η`)
  and the approximation of the actual kernels by it (error `δ`); the total error is `η + 2δ`.
* `example_exact`: in the two-site Ising instance of `FiniteCoupling`, every coupling has
  `E[x₀ ≠ y₀] ≥ 1/4` and `E[x₁ ≠ y₁] ≥ 1/12`, and one coupling attains both, so the Dobrushin
  recurrence `ρ₁ ≤ (1/3) ρ₀` is attained there.
* `example_approx`: a nontrivial instance of `finite_dobrushin_of_approx` (perturbed pair weight,
  `δ = 1/12`, two distinct laws).

Scope: this is infrastructure for the discretisation step. It does not prove the Dobrushin bound for SU(2) heat baths or
their discretisations, which remains open.
-/

open Finset Filter Topology MeasureTheory

namespace YangMills.StrongCoupling.FiniteGluing

open FiniteCoupling CompactCoupling CouplingLimit

section Gluing

variable {α β δ : Type*} [Fintype α] [Fintype β] [Fintype δ]

/-- The gluing of `γ₁` (a coupling of `p` and `q`) and `γ₂` (a coupling of `q` and `r`) along `q`:
`(a, c) ↦ ∑_b γ₁(a, b) γ₂(b, c) / q(b)`. Terms with `q b = 0` vanish (division by zero is zero). -/
noncomputable def glue (q : β → ℝ) (γ₁ : α × β → ℝ) (γ₂ : β × δ → ℝ) : α × δ → ℝ :=
  fun z => ∑ b, γ₁ (z.1, b) * γ₂ (b, z.2) / q b

lemma coupling_snd_nonneg {p : α → ℝ} {q : β → ℝ} {γ : α × β → ℝ} (h : IsCoupling p q γ)
    (b : β) : 0 ≤ q b := by
  rw [← h.2.2 b]; exact sum_nonneg fun a _ => h.1 _

lemma coupling_eq_zero_of_snd {p : α → ℝ} {q : β → ℝ} {γ : α × β → ℝ} (h : IsCoupling p q γ)
    {b : β} (hb : q b = 0) (a : α) : γ (a, b) = 0 := by
  have hs := h.2.2 b
  rw [hb] at hs
  exact (sum_eq_zero_iff_of_nonneg fun a _ => h.1 (a, b)).1 hs a (mem_univ a)

lemma coupling_eq_zero_of_fst {q : β → ℝ} {r : δ → ℝ} {γ : β × δ → ℝ} (h : IsCoupling q r γ)
    {b : β} (hb : q b = 0) (c : δ) : γ (b, c) = 0 := by
  have hs := h.2.1 b
  rw [hb] at hs
  exact (sum_eq_zero_iff_of_nonneg fun c _ => h.1 (b, c)).1 hs c (mem_univ c)

variable {p : α → ℝ} {q : β → ℝ} {r : δ → ℝ} {γ₁ : α × β → ℝ} {γ₂ : β × δ → ℝ}

lemma glue_term_nonneg (h₁ : IsCoupling p q γ₁) (h₂ : IsCoupling q r γ₂) (a : α) (b : β) (c : δ) :
    0 ≤ γ₁ (a, b) * γ₂ (b, c) / q b :=
  div_nonneg (mul_nonneg (h₁.1 _) (h₂.1 _)) (coupling_snd_nonneg h₁ b)

lemma glue_sum_right (h₁ : IsCoupling p q γ₁) (h₂ : IsCoupling q r γ₂) (a : α) (b : β) :
    ∑ c, γ₁ (a, b) * γ₂ (b, c) / q b = γ₁ (a, b) := by
  simp_rw [mul_div_right_comm]
  rw [← mul_sum, h₂.2.1 b]
  by_cases hb : q b = 0
  · rw [hb, coupling_eq_zero_of_snd h₁ hb a]; simp
  · exact div_mul_cancel₀ _ hb

lemma glue_sum_left (h₁ : IsCoupling p q γ₁) (h₂ : IsCoupling q r γ₂) (b : β) (c : δ) :
    ∑ a, γ₁ (a, b) * γ₂ (b, c) / q b = γ₂ (b, c) := by
  simp_rw [mul_div_assoc]
  rw [← sum_mul, h₁.2.2 b]
  by_cases hb : q b = 0
  · rw [hb, coupling_eq_zero_of_fst h₂ hb c]; simp
  · exact mul_div_cancel₀ _ hb

/-- **Gluing.** The glued function is a coupling of the outer marginals. -/
theorem glue_isCoupling (h₁ : IsCoupling p q γ₁) (h₂ : IsCoupling q r γ₂) :
    IsCoupling p r (glue q γ₁ γ₂) := by
  refine ⟨fun z => sum_nonneg fun b _ => glue_term_nonneg h₁ h₂ _ _ _, fun a => ?_, fun c => ?_⟩
  · simp only [glue]
    rw [Finset.sum_comm]
    simp_rw [glue_sum_right h₁ h₂]
    exact h₁.2.1 a
  · simp only [glue]
    rw [Finset.sum_comm]
    simp_rw [glue_sum_left h₁ h₂]
    exact h₂.2.2 c

end Gluing

section Cost

variable {α : Type*} [Fintype α] (d : α → α → ℝ)

/-- **The gluing lemma.** If `d` satisfies the triangle inequality, the glued coupling costs at most
the sum of the two costs. -/
theorem tcost_glue_le (htri : ∀ a b c, d a c ≤ d a b + d b c) {p q r : α → ℝ}
    {γ₁ γ₂ : α × α → ℝ} (h₁ : IsCoupling p q γ₁) (h₂ : IsCoupling q r γ₂) :
    tcost d (glue q γ₁ γ₂) ≤ tcost d γ₁ + tcost d γ₂ := by
  set w : α → α → α → ℝ := fun a b c => γ₁ (a, b) * γ₂ (b, c) / q b with hw
  have hw0 : ∀ a b c, 0 ≤ w a b c := glue_term_nonneg h₁ h₂
  calc tcost d (glue q γ₁ γ₂) = ∑ a, ∑ c, ∑ b, w a b c * d a c := by
        simp only [tcost, glue, hw, sum_mul]
    _ ≤ ∑ a, ∑ c, ∑ b, (w a b c * d a b + w a b c * d b c) :=
        sum_le_sum fun a _ => sum_le_sum fun c _ => sum_le_sum fun b _ => by
          rw [← mul_add]; exact mul_le_mul_of_nonneg_left (htri a b c) (hw0 a b c)
    _ = ∑ a, ∑ c, ∑ b, w a b c * d a b + ∑ a, ∑ c, ∑ b, w a b c * d b c := by
        simp only [sum_add_distrib]
    _ = tcost d γ₁ + tcost d γ₂ := by
        congr 1
        · unfold tcost
          refine sum_congr rfl fun a _ => ?_
          rw [Finset.sum_comm]
          refine sum_congr rfl fun b _ => ?_
          rw [← sum_mul, glue_sum_right h₁ h₂]
        · unfold tcost
          rw [sum_congr rfl fun a _ => Finset.sum_comm, Finset.sum_comm]
          refine sum_congr rfl fun b _ => ?_
          rw [Finset.sum_comm]
          refine sum_congr rfl fun c _ => ?_
          rw [← sum_mul, glue_sum_left h₁ h₂]

/-- The reflected coupling. -/
lemma swap_isCoupling {β : Type*} [Fintype β] {p : α → ℝ} {q : β → ℝ} {γ : α × β → ℝ}
    (h : IsCoupling p q γ) : IsCoupling q p (fun z => γ z.swap) :=
  ⟨fun _ => h.1 _, fun b => h.2.2 b, fun a => h.2.1 a⟩

lemma tcost_swap (hsymm : ∀ a b, d a b = d b a) (γ : α × α → ℝ) :
    tcost d (fun z => γ z.swap) = tcost d γ := by
  unfold tcost
  rw [Finset.sum_comm]
  exact sum_congr rfl fun a _ => sum_congr rfl fun b _ => by rw [hsymm]; rfl

end Cost

section Distance

variable {α : Type*} [Fintype α] (d : α → α → ℝ)

/-- The finite Kantorovich distance: the least transport cost over all couplings. -/
noncomputable def fW1 (p q : α → ℝ) : ℝ := sInf (tcost d '' {γ | IsCoupling p q γ})

lemma continuous_tcost : Continuous fun γ : α × α → ℝ => tcost d γ :=
  continuous_finsetSum _ fun a _ => continuous_finsetSum _ fun b _ =>
    (continuous_apply (a, b)).mul continuous_const

/-- The finite Kantorovich distance is attained, and bounds every coupling's cost from below. -/
theorem exists_fW1_eq {p q : α → ℝ} (hp : IsProb p) (hq : IsProb q) :
    ∃ γ, IsCoupling p q γ ∧ tcost d γ = fW1 d p q ∧
      ∀ γ', IsCoupling p q γ' → fW1 d p q ≤ tcost d γ' := by
  obtain ⟨γ, hγ, hmin⟩ := FiniteCoupling.exists_min_coupling hp hq (tcost d) (continuous_tcost d)
  have hleast : IsLeast (tcost d '' {γ | IsCoupling p q γ}) (tcost d γ) :=
    ⟨⟨γ, hγ, rfl⟩, by rintro _ ⟨γ', h', rfl⟩; exact hmin γ' h'⟩
  have he : fW1 d p q = tcost d γ := hleast.csInf_eq
  exact ⟨γ, hγ, he.symm, fun γ' h' => by rw [he]; exact hmin γ' h'⟩

lemma fW1_le {p q : α → ℝ} (hp : IsProb p) (hq : IsProb q) {γ : α × α → ℝ}
    (hγ : IsCoupling p q γ) : fW1 d p q ≤ tcost d γ :=
  (exists_fW1_eq d hp hq).choose_spec.2.2 γ hγ

lemma fW1_nonneg (hd : ∀ a b, 0 ≤ d a b) {p q : α → ℝ} (hp : IsProb p) (hq : IsProb q) :
    0 ≤ fW1 d p q := by
  obtain ⟨γ, hγ, he, -⟩ := exists_fW1_eq d hp hq
  rw [← he]
  exact sum_nonneg fun a _ => sum_nonneg fun b _ => mul_nonneg (hγ.1 _) (hd a b)

lemma fW1_self [DecidableEq α] (hd : ∀ a b, 0 ≤ d a b) (hd0 : ∀ a, d a a = 0) {p : α → ℝ}
    (hp : IsProb p) : fW1 d p p = 0 :=
  le_antisymm ((fW1_le d hp hp (diag_isCoupling hp)).trans (tcost_diag d hd0 p).le)
    (fW1_nonneg d hd hp hp)

lemma fW1_comm (hsymm : ∀ a b, d a b = d b a) {p q : α → ℝ} (hp : IsProb p) (hq : IsProb q) :
    fW1 d p q = fW1 d q p := by
  have key : ∀ {p q : α → ℝ}, IsProb p → IsProb q → fW1 d p q ≤ fW1 d q p := by
    intro p q hp hq
    obtain ⟨γ, hγ, he, -⟩ := exists_fW1_eq d hq hp
    rw [← he, ← tcost_swap d hsymm]
    exact fW1_le d hp hq (swap_isCoupling hγ)
  exact le_antisymm (key hp hq) (key hq hp)

/-- **Triangle inequality** for the finite Kantorovich distance. -/
theorem fW1_triangle (htri : ∀ a b c, d a c ≤ d a b + d b c) {p q r : α → ℝ} (hp : IsProb p)
    (hq : IsProb q) (hr : IsProb r) : fW1 d p r ≤ fW1 d p q + fW1 d q r := by
  obtain ⟨γ₁, h₁, e₁, -⟩ := exists_fW1_eq d hp hq
  obtain ⟨γ₂, h₂, e₂, -⟩ := exists_fW1_eq d hq hr
  rw [← e₁, ← e₂]
  exact (fW1_le d hp hr (glue_isCoupling h₁ h₂)).trans (tcost_glue_le d htri h₁ h₂)

end Distance

section Approx

variable {X : Type*} [Fintype X] (d : X → X → ℝ)

/-- **Kernels close to a Dobrushin kernel.** If every `k' x` is within transport cost `δ` of `k x`,
and `k` satisfies the Dobrushin bound `B x y`, then `k'` satisfies `B x y + 2δ`. The coupling is
`k' x → k x → k y → k' y`, glued twice. -/
theorem dobrushin_of_approx (hsymm : ∀ a b, d a b = d b a) (htri : ∀ a b c, d a c ≤ d a b + d b c)
    {Cfg : Type*} (k k' : Cfg → X → ℝ) (B : Cfg → Cfg → ℝ) (δ : ℝ)
    (happrox : ∀ x, ∃ π, IsCoupling (k' x) (k x) π ∧ tcost d π ≤ δ)
    (hk : ∀ x y, ∃ π, IsCoupling (k x) (k y) π ∧ tcost d π ≤ B x y) (x y : Cfg) :
    ∃ π, IsCoupling (k' x) (k' y) π ∧ tcost d π ≤ B x y + 2 * δ := by
  obtain ⟨π₁, h₁, c₁⟩ := happrox x
  obtain ⟨π, h, c⟩ := hk x y
  obtain ⟨π₂, h₂, c₂⟩ := happrox y
  have h₂' := swap_isCoupling h₂
  have h₁₂ := glue_isCoupling h₁ h
  refine ⟨glue (k y) (glue (k x) π₁ π) (fun z => π₂ z.swap), glue_isCoupling h₁₂ h₂', ?_⟩
  have g₁ := tcost_glue_le d htri h₁₂ h₂'
  have g₂ := tcost_glue_le d htri h₁ h
  rw [tcost_swap d hsymm] at g₁
  linarith

/-- Every kernel is within cost `0` of itself (non-vacuity of the approximation hypothesis). -/
lemma approx_refl [DecidableEq X] (hd0 : ∀ a, d a a = 0) {Cfg : Type*} (k : Cfg → X → ℝ)
    (hk : ∀ x, IsProb (k x)) (x : Cfg) : ∃ π, IsCoupling (k x) (k x) π ∧ tcost d π ≤ 0 :=
  ⟨_, diag_isCoupling (hk x), (tcost_diag d hd0 (k x)).le⟩

end Approx

section Comparison

/-- **The finite comparison from an approximating reference kernel.** As
`CouplingLimit.finite_dobrushin_source`, with its hypothesis `hW` split in two: reference kernels
`kref` satisfy the Dobrushin bound with error `η`, and the kernels `k` that leave `μ` and `ν`
invariant are within transport cost `δ` of them. The error becomes `η + 2δ`. -/
theorem finite_dobrushin_of_approx {ι Y : Type*} [Fintype ι] [DecidableEq ι] [Fintype Y]
    [DecidableEq Y] (d : Y → Y → ℝ) (hd : ∀ a b, 0 ≤ d a b) (D : ℝ) (hdD : ∀ a b, d a b ≤ D)
    (hsymm : ∀ a b, d a b = d b a) (htri : ∀ a b c, d a c ≤ d a b + d b c)
    {μ ν : (ι → Y) → ℝ} (hμ : IsProb μ) (hν : IsProb ν) (S : Finset ι)
    (k : ι → (ι → Y) → Y → ℝ) (hk : ∀ i x, IsProb (k i x))
    (hμk : ∀ i ∉ S, Stationary μ (k i) i) (hνk : ∀ i ∉ S, Stationary ν (k i) i)
    (kref : ι → (ι → Y) → Y → ℝ) (C : ι → ι → ℝ) (hC : ∀ i j, 0 ≤ C i j) (η δ : ℝ)
    (hWref : ∀ i ∉ S, ∀ x y, ∃ π, IsCoupling (kref i x) (kref i y) π ∧
      tcost d π ≤ ∑ j, C i j * d (x j) (y j) + η)
    (happrox : ∀ i ∉ S, ∀ x, ∃ π, IsCoupling (k i x) (kref i x) π ∧ tcost d π ≤ δ)
    (w : ι → ℝ) (hw : ∀ i, 0 < w i) (θ : ℝ) (hθ : θ < 1)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j) :
    ∃ γ, IsCoupling μ ν γ ∧
      ∑ i, w i * disc d γ i ≤ 1 / (1 - θ) * ∑ i, w i * (if i ∈ S then D else η + 2 * δ) := by
  refine finite_dobrushin_source d hd D hdD hμ hν S k hk hμk hνk C hC (η + 2 * δ) ?_ w hw θ hθ hcol
  intro i hi x y
  obtain ⟨π, hπ, hc⟩ := dobrushin_of_approx d hsymm htri (kref i) (k i)
    (fun x y => ∑ j, C i j * d (x j) (y j) + η) δ (happrox i hi) (hWref i hi) x y
  exact ⟨π, hπ, by linarith⟩

/-- **Route 1 from approximating reference kernels.** As
`CouplingLimit.compact_comparison_of_discretizations`, with its hypothesis `hW` split in two: for each
`n`, reference kernels `kref n` satisfy the Dobrushin bound with error `η n`, and the kernels `k n`
are within transport cost `δ n` of them, in the metric pulled back by `e n`. Both errors tend to `0`.
Taking `kref = k` and `δ = 0` (`approx_refl`) recovers the original hypotheses, so these are
satisfiable whenever those are (for instance by `CouplingLimit.example_limit`). -/
theorem compact_comparison_of_approx {ι X : Type*} [Fintype ι] [DecidableEq ι]
    [MetricSpace X] [CompactSpace X] [MeasurableSpace X] [BorelSpace X]
    (μ ν : ProbabilityMeasure (ι → X)) (S : Finset ι) (D : ℝ) (hdD : ∀ a b : X, dist a b ≤ D)
    (C : ι → ι → ℝ) (hC : ∀ i j, 0 ≤ C i j) (w : ι → ℝ) (hw : ∀ i, 0 < w i) (θ : ℝ) (hθ : θ < 1)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j)
    (Y : ℕ → Type) [∀ n, Fintype (Y n)] [∀ n, DecidableEq (Y n)] (e : ∀ n, Y n → X)
    (μf νf : ∀ n, (ι → Y n) → ℝ) (hμf : ∀ n, IsProb (μf n)) (hνf : ∀ n, IsProb (νf n))
    (k : ∀ n, ι → (ι → Y n) → Y n → ℝ) (hk : ∀ n i x, IsProb (k n i x))
    (hμk : ∀ n, ∀ i ∉ S, Stationary (μf n) (k n i) i)
    (hνk : ∀ n, ∀ i ∉ S, Stationary (νf n) (k n i) i)
    (kref : ∀ n, ι → (ι → Y n) → Y n → ℝ) (η δ : ℕ → ℝ) (hη : Tendsto η atTop (𝓝 0))
    (hδ : Tendsto δ atTop (𝓝 0))
    (hWref : ∀ n, ∀ i ∉ S, ∀ x y, ∃ π, IsCoupling (kref n i x) (kref n i y) π ∧
      tcost (fun a b => dist (e n a) (e n b)) π ≤ ∑ j, C i j * dist (e n (x j)) (e n (y j)) + η n)
    (happrox : ∀ n, ∀ i ∉ S, ∀ x, ∃ π, IsCoupling (k n i x) (kref n i x) π ∧
      tcost (fun a b => dist (e n a) (e n b)) π ≤ δ n)
    (hμlim : Tendsto (fun n => pushProb (fun x => e n ∘ x) (μf n) (hμf n)) atTop (𝓝 μ))
    (hνlim : Tendsto (fun n => pushProb (fun x => e n ∘ x) (νf n) (hνf n)) atTop (𝓝 ν)) :
    ∃ γ ∈ couplings μ ν, ∫ z, (∑ i, w i * dist (z.1 i) (z.2 i)) ∂(γ : Measure ((ι → X) × (ι → X))) ≤
      1 / (1 - θ) * ∑ i, w i * (if i ∈ S then D else 0) := by
  refine compact_comparison_of_discretizations μ ν S D hdD C hC w hw θ hθ hcol Y e μf νf hμf hνf k hk
    hμk hνk (fun n => η n + 2 * δ n) (by simpa using hη.add (hδ.const_mul 2))
    (fun n i hi x y => ?_) hμlim hνlim
  obtain ⟨π, hπ, hc⟩ := dobrushin_of_approx (fun a b => dist (e n a) (e n b))
    (fun a b => dist_comm _ _) (fun a b c => dist_triangle _ _ _) (kref n i) (k n i)
    (fun x y => ∑ j, C i j * dist (e n (x j)) (e n (y j)) + η n) (δ n) (happrox n i hi)
    (hWref n i hi) x y
  exact ⟨π, hπ, by linarith⟩

end Comparison

section Bool

/-- On `Bool` with the discrete metric, some coupling costs exactly `|p true - q true|`. -/
lemma bool_coupling {p q : Bool → ℝ} (hp : IsProb p) (hq : IsProb q) :
    ∃ π, IsCoupling p q π ∧ tcost dB π = |p true - q true| := by
  have hp1 : p false = 1 - p true := by have := hp.2; rw [Fintype.sum_bool] at this; linarith
  have hq1 : q false = 1 - q true := by have := hq.2; rw [Fintype.sum_bool] at this; linarith
  refine ⟨fun z => if z.1 = z.2 then min (p z.1) (q z.1) else
    if z.1 = true then max (p true - q true) 0 else max (q true - p true) 0, ⟨?_, ?_, ?_⟩, ?_⟩
  · rintro ⟨a, b⟩
    dsimp only
    split_ifs
    · exact le_min (hp.1 _) (hq.1 _)
    · exact le_max_right _ _
    · exact le_max_right _ _
  · intro a
    cases a <;> simp only [Fintype.sum_bool] <;> simp [hp1, hq1, min_def, max_def] <;>
      split_ifs <;> linarith
  · intro b
    cases b <;> simp only [Fintype.sum_bool] <;> simp [hp1, hq1, min_def, max_def] <;>
      split_ifs <;> linarith
  · simp only [tcost, Fintype.sum_bool, dB]
    simp only [if_true, mul_zero, add_zero, zero_add]
    norm_num
    rw [abs_eq_max_neg, max_def, max_def, max_def]
    split_ifs <;> linarith

/-- On `Bool` with the discrete metric, the finite Kantorovich distance is the total-variation
distance `|p true - q true|`. -/
theorem fW1_bool {p q : Bool → ℝ} (hp : IsProb p) (hq : IsProb q) :
    fW1 dB p q = |p true - q true| := by
  obtain ⟨π, hπ, hc⟩ := bool_coupling hp hq
  refine le_antisymm (hc ▸ fW1_le dB hp hq hπ) ?_
  obtain ⟨γ, hγ, he, -⟩ := exists_fW1_eq dB hp hq
  rw [← he]
  have e1 := hγ.2.1 true
  have e2 := hγ.2.2 true
  simp only [Fintype.sum_bool] at e1 e2
  have h1 := hγ.1 (true, false)
  have h2 := hγ.1 (false, true)
  simp only [tcost, Fintype.sum_bool, dB, if_true]
  norm_num
  rw [abs_le]
  constructor <;> linarith

end Bool

section Example

/-! ### The two-site Ising instance, computed exactly

The laws `gibbs Φμ` and `gibbs Φν` of `FiniteCoupling.example_comparison`. Configurations are written
`![x₀, x₁]`. -/

lemma sum_fin2 (F : (Fin 2 → Bool) → ℝ) :
    ∑ x, F x = F ![true, true] + F ![true, false] + F ![false, true] + F ![false, false] := by
  rw [← (finTwoArrowEquiv Bool).symm.sum_comp, Fintype.sum_prod_type]
  simp only [finTwoArrowEquiv_symm_apply, Fintype.sum_bool]
  ring

lemma fin2_eq (x : Fin 2 → Bool) : x = ![x 0, x 1] := by
  ext i; fin_cases i <;> rfl

/-- The table of an optimal coupling of `gibbs Φμ` and `gibbs Φν`, indexed by `(x₀, x₁, y₀, y₁)`:
the diagonal `min(μ, ν)` plus the moves `00 → 10`, `00 → 11`, `01 → 11`, each of mass `1/12`. -/
noncomputable def exT : Bool → Bool → Bool → Bool → ℝ
  | false, false, false, false => 1 / 6
  | false, true, false, true => 1 / 12
  | true, false, true, false => 1 / 6
  | true, true, true, true => 1 / 3
  | false, false, true, false => 1 / 12
  | false, false, true, true => 1 / 12
  | false, true, true, true => 1 / 12
  | _, _, _, _ => 0

/-- The optimal coupling. -/
noncomputable def γex (z : (Fin 2 → Bool) × (Fin 2 → Bool)) : ℝ :=
  exT (z.1 0) (z.1 1) (z.2 0) (z.2 1)

lemma Zμ : ∑ x, Φμ x = 6 := by
  rw [sum_fin2]; simp [Φμ, pairW]; norm_num

lemma Zν : ∑ x, Φν x = 12 := by
  rw [sum_fin2]; simp [Φν, Φμ, pairW, fieldW]; norm_num

lemma γex_isCoupling : IsCoupling (gibbs Φμ) (gibbs Φν) γex := by
  refine ⟨fun z => ?_, fun x => ?_, fun y => ?_⟩
  · simp only [γex]
    cases z.1 0 <;> cases z.1 1 <;> cases z.2 0 <;> cases z.2 1 <;> simp [exT]
  · rw [sum_fin2, fin2_eq x]
    simp only [gibbs, Zμ, γex]
    cases x 0 <;> cases x 1 <;> simp [exT, Φμ, pairW] <;> norm_num
  · rw [sum_fin2, fin2_eq y]
    simp only [gibbs, Zν, γex]
    cases y 0 <;> cases y 1 <;> simp [exT, Φν, Φμ, pairW, fieldW] <;> norm_num

lemma disc_γex : disc dB γex 0 = 1 / 4 ∧ disc dB γex 1 = 1 / 12 := by
  simp only [disc, Fintype.sum_prod_type, sum_fin2]
  constructor
  · simp [γex, exT, dB]; norm_num
  · simp [γex, exT, dB]

/-- The probabilities of `x₀ = true` and of `x₁ = true` under the two laws. -/
lemma example_means :
    ∑ x, gibbs Φμ x * (if x 0 = true then 1 else 0) = 1 / 2 ∧
    ∑ x, gibbs Φν x * (if x 0 = true then 1 else 0) = 3 / 4 ∧
    ∑ x, gibbs Φμ x * (if x 1 = true then 1 else 0) = 1 / 2 ∧
    ∑ x, gibbs Φν x * (if x 1 = true then 1 else 0) = 7 / 12 := by
  simp only [gibbs, Zμ, Zν]
  refine ⟨?_, ?_, ?_, ?_⟩ <;> rw [sum_fin2] <;> simp [Φν, Φμ, pairW, fieldW] <;> norm_num

/-- **The discrepancies of the two-site instance, exactly.** Every coupling of `gibbs Φμ` and
`gibbs Φν` has `E[x₀ ≠ y₀] ≥ 1/4` and `E[x₁ ≠ y₁] ≥ 1/12`, and one coupling attains both. At that
coupling `ρ₁ = Cex 1 0 · ρ₀`: the Dobrushin recurrence `ρ₁ ≤ (1/3) ρ₀` is an equality, while
`example_comparison`'s bound `ρ₁ ≤ 1/2` uses only `ρ₀ ≤ 1`. -/
theorem example_exact :
    (∀ γ, IsCoupling (gibbs Φμ) (gibbs Φν) γ → 1 / 4 ≤ disc dB γ 0 ∧ 1 / 12 ≤ disc dB γ 1) ∧
      ∃ γ, IsCoupling (gibbs Φμ) (gibbs Φν) γ ∧ disc dB γ 0 = 1 / 4 ∧ disc dB γ 1 = 1 / 12 ∧
        disc dB γ 1 = Cex 1 0 * disc dB γ 0 := by
  obtain ⟨m0, n0, m1, n1⟩ := example_means
  refine ⟨fun γ hγ => ⟨?_, ?_⟩, γex, γex_isCoupling, disc_γex.1, disc_γex.2, ?_⟩
  · have h := observable_bound dB hγ (fun x => if x 0 = true then 1 else 0)
      (fun i => if i = 0 then 1 else 0) (fun x y => by
        simp only [Fin.sum_univ_two, if_true, one_mul]
        norm_num
        cases x 0 <;> cases y 0 <;> simp [dB])
    rw [m0, n0] at h
    simp only [Fin.sum_univ_two, if_true, one_mul] at h
    norm_num at h
    linarith
  · have h := observable_bound dB hγ (fun x => if x 1 = true then 1 else 0)
      (fun i => if i = 1 then 1 else 0) (fun x y => by
        simp only [Fin.sum_univ_two, if_true, one_mul]
        norm_num
        cases x 1 <;> cases y 1 <;> simp [dB])
    rw [m1, n1] at h
    simp only [Fin.sum_univ_two, if_true, one_mul] at h
    norm_num at h
    linarith
  · rw [disc_γex.1, disc_γex.2]; simp [Cex]; norm_num

/-! ### A nontrivial instance of `finite_dobrushin_of_approx`

Stronger pair weight `3` (instead of `2`). Its site-1 heat bath differs from that of `Φμ`, and is
within transport cost `δ = 1/12` of it; the reference kernel is `heatBath Φμ`, with the Dobrushin bound
`hW_example` (`η = 0`). -/

/-- The stronger pair weight. -/
def pairW3 (a b : Bool) : ℝ := if a = b then 3 else 1

/-- The weight of `μ'`. -/
def Φμ3 (x : Fin 2 → Bool) : ℝ := pairW3 (x 0) (x 1)

/-- The weight of `ν'`: the same field on site `0`. -/
def Φν3 (x : Fin 2 → Bool) : ℝ := Φμ3 x * fieldW x

lemma Φμ3_pos (x : Fin 2 → Bool) : 0 < Φμ3 x := by unfold Φμ3 pairW3; split_ifs <;> norm_num

lemma Φν3_pos (x : Fin 2 → Bool) : 0 < Φν3 x := by
  unfold Φν3 fieldW; split_ifs <;> nlinarith [Φμ3_pos x]

lemma heatBath3_one (x : Fin 2 → Bool) (a : Bool) : heatBath Φμ3 1 x a = pairW3 (x 0) a / 4 := by
  have h01 : (0 : Fin 2) ≠ 1 := by decide
  simp only [heatBath, Φμ3, Function.update_of_ne h01, Function.update_self, Fintype.sum_bool]
  congr 1
  cases x 0 <;> simp [pairW3] <;> norm_num

lemma heatBath3_ν : heatBath Φν3 1 = heatBath Φμ3 1 :=
  heatBath_mul_invariant Φμ3 fieldW 1 (fun x a => by simp [fieldW])
    (fun x => by unfold fieldW; split_ifs <;> norm_num)

/-- **Non-vacuity of `finite_dobrushin_of_approx`, with an actual approximation.** The laws differ,
the kernel that leaves them invariant is not the reference kernel, and the theorem gives a coupling
with `E[x₀ ≠ y₀] + E[x₁ ≠ y₁] ≤ 7/4`, below the trivial bound `2`. -/
theorem example_approx :
    gibbs Φμ3 ≠ gibbs Φν3 ∧ heatBath Φμ3 1 ≠ heatBath Φμ 1 ∧
      ∃ γ, IsCoupling (gibbs Φμ3) (gibbs Φν3) γ ∧ disc dB γ 0 + disc dB γ 1 ≤ 7 / 4 := by
  refine ⟨fun h => ?_, fun h => ?_, ?_⟩
  · have hZ : 0 < ∑ x, Φν3 x := sum_pos (fun x _ => Φν3_pos x) univ_nonempty
    have h1 := congrFun h (fun _ => true)
    have h2 := congrFun h (fun _ => false)
    have e1 : Φμ3 (fun _ => true) = 3 := by simp [Φμ3, pairW3]
    have e2 : Φν3 (fun _ => true) = 9 := by norm_num [Φν3, Φμ3, fieldW, pairW3]
    have e3 : Φμ3 (fun _ => false) = 3 := by simp [Φμ3, pairW3]
    have e4 : Φν3 (fun _ => false) = 3 := by norm_num [Φν3, Φμ3, fieldW, pairW3]
    simp only [gibbs] at h1 h2
    rw [e1, e2] at h1
    rw [e3, e4] at h2
    rw [h2, div_eq_div_iff hZ.ne' hZ.ne'] at h1
    linarith
  · have := congrFun (congrFun h (fun _ => true)) true
    rw [heatBath3_one, heatBath_one] at this
    norm_num [pairW3, pairW] at this
  · have hS : ∀ i ∉ ({0} : Finset (Fin 2)), i = 1 := by
      intro i hi
      fin_cases i
      · simp at hi
      · rfl
    have hνk : ∀ i ∉ ({0} : Finset (Fin 2)), Stationary (gibbs Φν3) (heatBath Φμ3 i) i := by
      intro i hi
      rw [hS i hi, ← heatBath3_ν]
      exact gibbs_stationary Φν3 Φν3_pos 1
    have happrox : ∀ i ∉ ({0} : Finset (Fin 2)), ∀ x, ∃ π,
        IsCoupling (heatBath Φμ3 i x) (heatBath Φμ i x) π ∧ tcost dB π ≤ 1 / 12 := by
      intro i hi x
      rw [hS i hi]
      obtain ⟨π, hπ, hc⟩ := bool_coupling (heatBath_isProb Φμ3 Φμ3_pos 1 x)
        (heatBath_isProb Φμ Φμ_pos 1 x)
      refine ⟨π, hπ, ?_⟩
      rw [hc, heatBath3_one, heatBath_one]
      cases x 0 <;> norm_num [pairW3, pairW, abs_le]
    have hWref : ∀ i ∉ ({0} : Finset (Fin 2)), ∀ x y, ∃ π,
        IsCoupling (heatBath Φμ i x) (heatBath Φμ i y) π ∧
          tcost dB π ≤ ∑ j, Cex i j * dB (x j) (y j) + 0 := by
      intro i hi x y
      simpa using hW_example i hi x y
    obtain ⟨γ, hγ, hb⟩ := finite_dobrushin_of_approx dB
      (fun a b => by unfold dB; split_ifs <;> norm_num) 1
      (fun a b => by unfold dB; split_ifs <;> norm_num)
      (fun a b => by unfold dB; split_ifs <;> simp_all [eq_comm])
      (fun a b c => by unfold dB; split_ifs <;> simp_all)
      (gibbs_isProb Φμ3 Φμ3_pos) (gibbs_isProb Φν3 Φν3_pos) {0} (heatBath Φμ3)
      (fun i x => heatBath_isProb Φμ3 Φμ3_pos i x) (fun i _ => gibbs_stationary Φμ3 Φμ3_pos i) hνk
      (heatBath Φμ) Cex (fun i j => by unfold Cex; split_ifs <;> norm_num) 0 (1 / 12) hWref happrox
      (fun _ => 1) (fun _ => one_pos) (1 / 3) (by norm_num) (fun j => by fin_cases j <;> simp [Cex])
    refine ⟨γ, hγ, ?_⟩
    simp only [Fin.sum_univ_two, one_mul] at hb
    norm_num at hb
    linarith

end Example

end YangMills.StrongCoupling.FiniteGluing

end Part7_FiniteGluing

section Part8_QuantizedCoupling

/-!
# Quantising couplings onto a finite net: reference kernels from the continuum kernel

`FiniteGluing.compact_comparison_of_approx` reduces G1 on a compact spin space `X` to reference kernels on
finite nets that satisfy the Dobrushin bound, plus a transport-cost approximation of the discretised
heat baths by them. This file supplies the reference kernels: the continuum single-site kernels pushed
onto the net by a measurable quantiser `q : X → Y`.

* `quantize q μ`: the finite law of the cell index `q a` for `a ∼ μ`. `quantize_isProb`.
* `quantizeCoupling q γ`: the mass of the product cells. `quantize_coupling_cost`: if `γ` couples `μ`
  and `ν`, then `quantizeCoupling q γ` couples `quantize q μ` and `quantize q ν`, and its cost in the
  pulled-back metric `dist (e b) (e b')` is at most `∫ dist dγ` plus the expected displacements
  `∫ dist (e (q a)) a` under `μ` and under `ν`. `integral_displacement_le`: each is at most `ε` if the
  quantiser moves every point by at most `ε`.
* `exists_quantizer`: a compact metric space has, for every `ε > 0`, a finite net `e : Fin N → X` and
  a measurable quantiser `q` with `dist (e (q a)) a < ε` everywhere.
* `compact_comparison_of_quantization`: route 1 with the reference kernels replaced by a Dobrushin
  bound for the continuum kernels `K i x` themselves (couplings of measures on `X`), quantisers whose
  expected displacement `ε n` tends to `0`, and discretised kernels within transport cost `δ n → 0` of
  the quantised continuum kernels.
* `example_quantization`: every hypothesis of `compact_comparison_of_quantization` discharged on
  `X = [0, 1]` for two distinct laws, with a continuum kernel that depends on the whole of `[0, 1]`
  (Dobrushin coefficient `1/3` for all boundary values, not only at the net points).

Scope: infrastructure for the discretisation step. For the SU(2) heat baths it remains open to prove the continuum
Dobrushin bound `hK`, the approximation `happrox` of the discretised heat baths, and the weak
convergence of the discretised Gibbs laws.
-/

open Finset Filter Topology MeasureTheory

namespace YangMills.StrongCoupling.Quantize

open FiniteCoupling CompactCoupling CouplingLimit FiniteGluing

section Quantize

variable {X : Type*} [MeasurableSpace X] {Y : Type*} [Fintype Y]

/-- The finite law of the cell index: `b ↦ μ (q⁻¹ {b})`. -/
noncomputable def quantize (q : X → Y) (μ : Measure X) : Y → ℝ := fun b => μ.real (q ⁻¹' {b})

/-- The quantised coupling: the mass of the product cell `q⁻¹ {b} × q⁻¹ {b'}`. -/
noncomputable def quantizeCoupling (q : X → Y) (γ : Measure (X × X)) : Y × Y → ℝ :=
  fun z => γ.real ((q ⁻¹' {z.1}) ×ˢ (q ⁻¹' {z.2}))

theorem quantize_isProb (q : X → Y) (hq : ∀ b, MeasurableSet (q ⁻¹' {b})) (μ : Measure X)
    [IsProbabilityMeasure μ] : IsProb (quantize q μ) := by
  refine ⟨fun b => measureReal_nonneg, ?_⟩
  have h := sum_measureReal_preimage_singleton (μ := μ) Finset.univ (f := q) (fun y _ => hq y)
  simpa [quantize] using h

omit [MeasurableSpace X] in
lemma cells_disjoint (q : X → Y) (b : Y) :
    (↑(Finset.univ : Finset Y) : Set Y).PairwiseDisjoint (fun b' => (q ⁻¹' {b}) ×ˢ (q ⁻¹' {b'})) :=
  fun _ _ _ _ hne => Set.disjoint_prod.2 (Or.inr
    (Set.disjoint_left.2 fun _ h₁ h₂ => hne ((Set.mem_singleton_iff.1 h₁).symm.trans h₂)))

omit [MeasurableSpace X] in
lemma cells_disjoint' (q : X → Y) (b' : Y) :
    (↑(Finset.univ : Finset Y) : Set Y).PairwiseDisjoint (fun b => (q ⁻¹' {b}) ×ˢ (q ⁻¹' {b'})) :=
  fun _ _ _ _ hne => Set.disjoint_prod.2 (Or.inl
    (Set.disjoint_left.2 fun _ h₁ h₂ => hne ((Set.mem_singleton_iff.1 h₁).symm.trans h₂)))

/-- **Quantised couplings are couplings.** -/
theorem quantizeCoupling_isCoupling (q : X → Y) (hq : ∀ b, MeasurableSet (q ⁻¹' {b}))
    {μ ν : Measure X} {γ : Measure (X × X)} [IsFiniteMeasure γ]
    (hγ : WassersteinBridge.IsCoupling μ ν γ) :
    IsCoupling (quantize q μ) (quantize q ν) (quantizeCoupling q γ) := by
  refine ⟨fun z => measureReal_nonneg, fun b => ?_, fun b' => ?_⟩
  · simp only [quantizeCoupling]
    rw [← measureReal_biUnion_finset (cells_disjoint q b) (fun b' _ => (hq b).prod (hq b'))]
    have hU : (⋃ b' ∈ (Finset.univ : Finset Y), (q ⁻¹' {b}) ×ˢ (q ⁻¹' {b'})) = Prod.fst ⁻¹' (q ⁻¹' {b}) := by
      ext z; simp
    rw [hU, ← map_measureReal_apply measurable_fst (hq b), hγ.1]
    rfl
  · simp only [quantizeCoupling]
    rw [← measureReal_biUnion_finset (cells_disjoint' q b') (fun b _ => (hq b).prod (hq b'))]
    have hU : (⋃ b ∈ (Finset.univ : Finset Y), (q ⁻¹' {b}) ×ˢ (q ⁻¹' {b'})) = Prod.snd ⁻¹' (q ⁻¹' {b'}) := by
      ext z; simp
    rw [hU, ← map_measureReal_apply measurable_snd (hq b'), hγ.2]
    rfl

end Quantize

section Cost

variable {X : Type*} [MetricSpace X] [CompactSpace X] [MeasurableSpace X] [BorelSpace X]
  {Y : Type*} [Fintype Y]

omit [MetricSpace X] [CompactSpace X] [MeasurableSpace X] [BorelSpace X] in
/-- A function of the cell index is a finite sum of indicators of cells. -/
lemma cell_sum (q : X → Y) (f : Y → X → ℝ) (a : X) :
    ∑ b, (q ⁻¹' {b}).indicator (f b) a = f (q a) a := by
  rw [Finset.sum_eq_single_of_mem (q a) (mem_univ _) fun b _ hb => ?_]
  · simp
  · exact Set.indicator_of_notMem (show a ∉ q ⁻¹' {b} from fun h => hb (Set.mem_singleton_iff.1 h).symm) (f b)

omit [CompactSpace X] in
lemma displacement_measurable (e : Y → X) (q : X → Y) (hq : ∀ b, MeasurableSet (q ⁻¹' {b})) :
    Measurable fun a => dist (e (q a)) a := by
  have h : (fun a => dist (e (q a)) a) = fun a => ∑ b, (q ⁻¹' {b}).indicator (fun a => dist (e b) a) a :=
    funext fun a => (cell_sum q (fun b a => dist (e b) a) a).symm
  rw [h]
  exact Finset.measurable_sum _ fun b _ =>
    (continuous_const.dist continuous_id).measurable.indicator (hq b)

lemma integrable_of_le_bound {Z : Type*} [MeasurableSpace Z] {m : Measure Z} [IsFiniteMeasure m]
    {f : Z → ℝ} (hf : Measurable f) (B : ℝ) (hB : ∀ z, |f z| ≤ B) : Integrable f m :=
  (integrable_const B).mono' hf.aestronglyMeasurable (Eventually.of_forall fun z => by
    simpa [Real.norm_eq_abs] using hB z)

omit [MeasurableSpace X] [BorelSpace X] in
lemma bounded_dist : ∃ B, ∀ a b : X, dist a b ≤ B := by
  obtain ⟨B, hB⟩ := Metric.isBounded_iff.1 (isCompact_univ (X := X)).isBounded
  exact ⟨B, fun a b => hB (Set.mem_univ a) (Set.mem_univ b)⟩

omit [MetricSpace X] [CompactSpace X] [MeasurableSpace X] [BorelSpace X] in
/-- A function of the pair of cell indices is a finite sum of indicators of product cells. -/
lemma cell_sum₂ (q : X → Y) (c : Y → Y → ℝ) (z : X × X) :
    ∑ b, ∑ b', ((q ⁻¹' {b}) ×ˢ (q ⁻¹' {b'})).indicator (fun _ => c b b') z = c (q z.1) (q z.2) := by
  rw [Finset.sum_eq_single_of_mem (q z.1) (mem_univ _) fun b _ hb => sum_eq_zero fun b' _ =>
      Set.indicator_of_notMem (show z ∉ (q ⁻¹' {b}) ×ˢ (q ⁻¹' {b'}) from
        fun h => hb (Set.mem_singleton_iff.1 (Set.mem_prod.1 h).1).symm) _]
  rw [Finset.sum_eq_single_of_mem (q z.2) (mem_univ _) fun b' _ hb' =>
      Set.indicator_of_notMem (show z ∉ (q ⁻¹' {q z.1}) ×ˢ (q ⁻¹' {b'}) from
        fun h => hb' (Set.mem_singleton_iff.1 (Set.mem_prod.1 h).2).symm) _]
  exact Set.indicator_of_mem (show z ∈ (q ⁻¹' {q z.1}) ×ˢ (q ⁻¹' {q z.2}) from ⟨rfl, rfl⟩) _

omit [CompactSpace X] [BorelSpace X] in
/-- The cost of a quantised coupling is the integral of the cell-to-cell distance. -/
lemma tcost_quantizeCoupling (e : Y → X) (q : X → Y) (hq : ∀ b, MeasurableSet (q ⁻¹' {b}))
    (γ : Measure (X × X)) [IsFiniteMeasure γ] :
    tcost (fun b b' => dist (e b) (e b')) (quantizeCoupling q γ) =
      ∫ z, dist (e (q z.1)) (e (q z.2)) ∂γ := by
  have hint : ∀ b b', Integrable (((q ⁻¹' {b}) ×ˢ (q ⁻¹' {b'})).indicator
      fun _ : X × X => dist (e b) (e b')) γ :=
    fun b b' => (integrable_const _).indicator ((hq b).prod (hq b'))
  have hrep : (fun z : X × X => dist (e (q z.1)) (e (q z.2))) = fun z =>
      ∑ b, ∑ b', ((q ⁻¹' {b}) ×ˢ (q ⁻¹' {b'})).indicator (fun _ => dist (e b) (e b')) z :=
    funext fun z => (cell_sum₂ q (fun b b' => dist (e b) (e b')) z).symm
  rw [hrep, integral_finsetSum _ fun b _ => integrable_finsetSum _ fun b' _ => hint b b']
  unfold tcost
  refine sum_congr rfl fun b _ => ?_
  rw [integral_finsetSum _ fun b' _ => hint b b']
  refine sum_congr rfl fun b' _ => ?_
  rw [integral_indicator_const _ ((hq b).prod (hq b')), smul_eq_mul]
  rfl

/-- **Quantising a coupling.** If `γ` couples `μ` and `ν`, its quantisation couples the quantised laws,
and its cost in the pulled-back metric exceeds `∫ dist dγ` by at most the expected displacements of the
quantiser under `μ` and under `ν`. -/
theorem quantize_coupling_cost (e : Y → X) (q : X → Y) (hq : ∀ b, MeasurableSet (q ⁻¹' {b}))
    {μ ν : ProbabilityMeasure X} {γ : ProbabilityMeasure (X × X)} (hγ : γ ∈ couplings μ ν) :
    IsCoupling (quantize q (μ : Measure X)) (quantize q (ν : Measure X))
        (quantizeCoupling q (γ : Measure (X × X))) ∧
      tcost (fun b b' => dist (e b) (e b')) (quantizeCoupling q (γ : Measure (X × X))) ≤
        ∫ z, dist z.1 z.2 ∂(γ : Measure (X × X)) + ∫ a, dist (e (q a)) a ∂(μ : Measure X) +
          ∫ a, dist (e (q a)) a ∂(ν : Measure X) := by
  have hc := isCoupling_of_mem hγ
  refine ⟨quantizeCoupling_isCoupling q hq hc, ?_⟩
  obtain ⟨B, hB⟩ := bounded_dist (X := X)
  have hdm := displacement_measurable e q hq
  have bnd : ∀ a b : X, |dist a b| ≤ B := fun a b => by rw [abs_of_nonneg dist_nonneg]; exact hB a b
  have h1 : Integrable (fun z : X × X => dist (e (q z.1)) z.1) (γ : Measure (X × X)) :=
    integrable_of_le_bound (hdm.comp measurable_fst) B fun z => bnd _ _
  have h2 : Integrable (fun z : X × X => dist z.1 z.2) (γ : Measure (X × X)) :=
    integrable_of_le_bound (continuous_fst.dist continuous_snd).measurable B fun z => bnd _ _
  have h3 : Integrable (fun z : X × X => dist (e (q z.2)) z.2) (γ : Measure (X × X)) :=
    integrable_of_le_bound (hdm.comp measurable_snd) B fun z => bnd _ _
  have hg : Integrable (fun z : X × X => dist (e (q z.1)) (e (q z.2))) (γ : Measure (X × X)) := by
    have hrep : (fun z : X × X => dist (e (q z.1)) (e (q z.2))) = fun z =>
        ∑ b, ∑ b', ((q ⁻¹' {b}) ×ˢ (q ⁻¹' {b'})).indicator (fun _ => dist (e b) (e b')) z :=
      funext fun z => (cell_sum₂ q (fun b b' => dist (e b) (e b')) z).symm
    rw [hrep]
    exact integrable_finsetSum _ fun b _ => integrable_finsetSum _ fun b' _ =>
      (integrable_const _).indicator ((hq b).prod (hq b'))
  rw [tcost_quantizeCoupling e q hq]
  have hpt : ∀ z : X × X, dist (e (q z.1)) (e (q z.2)) ≤
      dist (e (q z.1)) z.1 + dist z.1 z.2 + dist (e (q z.2)) z.2 := fun z => by
    have := dist_triangle4 (e (q z.1)) z.1 z.2 (e (q z.2))
    rw [dist_comm z.2] at this
    linarith
  have hfst : ∫ z, dist (e (q z.1)) z.1 ∂(γ : Measure (X × X)) = ∫ a, dist (e (q a)) a ∂(μ : Measure X) := by
    rw [← hc.1, integral_map measurable_fst.aemeasurable hdm.aestronglyMeasurable]
  have hsnd : ∫ z, dist (e (q z.2)) z.2 ∂(γ : Measure (X × X)) = ∫ a, dist (e (q a)) a ∂(ν : Measure X) := by
    rw [← hc.2, integral_map measurable_snd.aemeasurable hdm.aestronglyMeasurable]
  calc ∫ z, dist (e (q z.1)) (e (q z.2)) ∂(γ : Measure (X × X))
      ≤ ∫ z, (dist (e (q z.1)) z.1 + dist z.1 z.2 + dist (e (q z.2)) z.2) ∂(γ : Measure (X × X)) :=
        integral_mono hg ((h1.add h2).add h3) hpt
    _ = ∫ z, dist (e (q z.1)) z.1 ∂(γ : Measure (X × X)) + ∫ z, dist z.1 z.2 ∂(γ : Measure (X × X)) +
          ∫ z, dist (e (q z.2)) z.2 ∂(γ : Measure (X × X)) := by
        have h12 : Integrable (fun z : X × X => dist (e (q z.1)) z.1 + dist z.1 z.2)
            (γ : Measure (X × X)) := h1.add h2
        rw [integral_add h12 h3, integral_add h1 h2]
    _ = _ := by rw [hfst, hsnd]; ring

omit [CompactSpace X] in
/-- If the quantiser moves every point by at most `ε`, its expected displacement is at most `ε`. -/
theorem integral_displacement_le (e : Y → X) (q : X → Y) (hq : ∀ b, MeasurableSet (q ⁻¹' {b}))
    {ε : ℝ} (hε : ∀ a, dist (e (q a)) a ≤ ε) (μ : Measure X) [IsProbabilityMeasure μ] :
    ∫ a, dist (e (q a)) a ∂μ ≤ ε := by
  have hi : Integrable (fun a => dist (e (q a)) a) μ :=
    integrable_of_le_bound (displacement_measurable e q hq) ε fun a => by
      rw [abs_of_nonneg dist_nonneg]; exact hε a
  calc ∫ a, dist (e (q a)) a ∂μ ≤ ∫ _a, ε ∂μ := integral_mono hi (integrable_const ε) hε
    _ = ε := by simp

/-- **Finite nets with measurable quantisers.** A compact metric space has, for every `ε > 0`, finitely
many points `e i` and a measurable map `q` to their indices with `dist (e (q a)) a < ε` for all `a`:
`q a` is the first index whose ball contains `a`. -/
theorem exists_quantizer {ε : ℝ} (hε : 0 < ε) :
    ∃ (N : ℕ) (e : Fin N → X) (q : X → Fin N), (∀ b, MeasurableSet (q ⁻¹' {b})) ∧
      ∀ a, dist (e (q a)) a < ε := by
  classical
  obtain ⟨t, ht, hcov⟩ := Metric.totallyBounded_iff.1 (isCompact_univ (X := X)).totallyBounded ε hε
  set s := ht.toFinset
  let e : Fin s.card → X := fun i => (s.equivFin.symm i : X)
  have hcover : ∀ a, ∃ i, dist a (e i) < ε := by
    intro a
    obtain ⟨y, hy, hay⟩ : ∃ y ∈ t, a ∈ Metric.ball y ε := by simpa using hcov (Set.mem_univ a)
    refine ⟨s.equivFin ⟨y, ht.mem_toFinset.2 hy⟩, ?_⟩
    simpa [e] using hay
  let F : X → Finset (Fin s.card) := fun a => univ.filter fun i => dist a (e i) < ε
  have hF : ∀ a, (F a).Nonempty := fun a => by
    obtain ⟨i, hi⟩ := hcover a
    exact ⟨i, by simp [F, hi]⟩
  let q : X → Fin s.card := fun a => (F a).min' (hF a)
  refine ⟨s.card, e, q, fun i => ?_, fun a => ?_⟩
  · have hset : q ⁻¹' {i} = Metric.ball (e i) ε \ ⋃ j ∈ univ.filter (· < i), Metric.ball (e j) ε := by
      ext a
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_sdiff, Metric.mem_ball,
        Set.mem_iUnion, Finset.mem_filter, Finset.mem_univ, true_and, exists_prop, not_exists, not_and,
        not_lt]
      constructor
      · intro h
        have hmem : q a ∈ F a := Finset.min'_mem _ _
        rw [h] at hmem
        refine ⟨(Finset.mem_filter.1 hmem).2, fun j hj => ?_⟩
        by_contra hlt
        have hle : q a ≤ j := Finset.min'_le _ _ (by simp [F, not_le.1 hlt])
        rw [h] at hle
        exact absurd hj (not_lt.2 hle)
      · rintro ⟨hi, hmin⟩
        refine le_antisymm (Finset.min'_le _ _ (by simp [F, hi])) (Finset.le_min' _ _ _ fun k hk => ?_)
        by_contra hlt
        exact absurd (Finset.mem_filter.1 hk).2 (not_lt.2 (hmin k (not_le.1 hlt)))
    rw [hset]
    exact measurableSet_ball.diff (Finset.measurableSet_biUnion _ fun j _ => measurableSet_ball)
  · rw [dist_comm]
    exact (Finset.mem_filter.1 (Finset.min'_mem (F a) (hF a))).2

end Cost

section Reduction

/-- **Route 1 from the continuum kernels.** As `FiniteGluing.compact_comparison_of_approx`, with the
reference kernels taken to be the quantised continuum kernels `quantize (q n) (K i (e n ∘ y))`. The
hypotheses are now: a Dobrushin bound `hK` for the continuum single-site kernels `K i x` (couplings of
probability measures on `X`, for every boundary `x : ι → X`); quantisers `q n` whose expected
displacement under the continuum kernels at net boundaries is at most `ε n → 0`; and discretised kernels
`k n` within transport cost `δ n → 0` of the quantised continuum kernels. The total Dobrushin error on
the net is `2 ε n + 2 δ n`. -/
theorem compact_comparison_of_quantization {ι X : Type*} [Fintype ι] [DecidableEq ι]
    [MetricSpace X] [CompactSpace X] [MeasurableSpace X] [BorelSpace X]
    (μ ν : ProbabilityMeasure (ι → X)) (S : Finset ι) (D : ℝ) (hdD : ∀ a b : X, dist a b ≤ D)
    (C : ι → ι → ℝ) (hC : ∀ i j, 0 ≤ C i j) (w : ι → ℝ) (hw : ∀ i, 0 < w i) (θ : ℝ) (hθ : θ < 1)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j)
    (K : ι → (ι → X) → ProbabilityMeasure X)
    (hK : ∀ i ∉ S, ∀ x x' : ι → X, ∃ γ ∈ couplings (K i x) (K i x'),
      ∫ z, dist z.1 z.2 ∂(γ : Measure (X × X)) ≤ ∑ j, C i j * dist (x j) (x' j))
    (Y : ℕ → Type) [∀ n, Fintype (Y n)] [∀ n, DecidableEq (Y n)] (e : ∀ n, Y n → X)
    (q : ∀ n, X → Y n) (hq : ∀ n b, MeasurableSet (q n ⁻¹' {b}))
    (ε : ℕ → ℝ) (hε : Tendsto ε atTop (𝓝 0))
    (hdisp : ∀ n, ∀ i ∉ S, ∀ y : ι → Y n,
      ∫ a, dist (e n (q n a)) a ∂(K i (e n ∘ y) : Measure X) ≤ ε n)
    (μf νf : ∀ n, (ι → Y n) → ℝ) (hμf : ∀ n, IsProb (μf n)) (hνf : ∀ n, IsProb (νf n))
    (k : ∀ n, ι → (ι → Y n) → Y n → ℝ) (hk : ∀ n i x, IsProb (k n i x))
    (hμk : ∀ n, ∀ i ∉ S, Stationary (μf n) (k n i) i)
    (hνk : ∀ n, ∀ i ∉ S, Stationary (νf n) (k n i) i)
    (δ : ℕ → ℝ) (hδ : Tendsto δ atTop (𝓝 0))
    (happrox : ∀ n, ∀ i ∉ S, ∀ y : ι → Y n, ∃ π, IsCoupling (k n i y)
      (quantize (q n) (K i (e n ∘ y) : Measure X)) π ∧
      tcost (fun a b => dist (e n a) (e n b)) π ≤ δ n)
    (hμlim : Tendsto (fun n => pushProb (fun x => e n ∘ x) (μf n) (hμf n)) atTop (𝓝 μ))
    (hνlim : Tendsto (fun n => pushProb (fun x => e n ∘ x) (νf n) (hνf n)) atTop (𝓝 ν)) :
    ∃ γ ∈ couplings μ ν, ∫ z, (∑ i, w i * dist (z.1 i) (z.2 i)) ∂(γ : Measure ((ι → X) × (ι → X))) ≤
      1 / (1 - θ) * ∑ i, w i * (if i ∈ S then D else 0) := by
  refine compact_comparison_of_approx μ ν S D hdD C hC w hw θ hθ hcol Y e μf νf hμf hνf k hk hμk hνk
    (fun n i y => quantize (q n) (K i (e n ∘ y) : Measure X)) (fun n => 2 * ε n) δ
    (by simpa using hε.const_mul 2) hδ (fun n i hi y y' => ?_) happrox hμlim hνlim
  obtain ⟨γ, hγ, hcost⟩ := hK i hi (e n ∘ y) (e n ∘ y')
  obtain ⟨hπ, hπc⟩ := quantize_coupling_cost (e n) (q n) (hq n) hγ
  refine ⟨_, hπ, hπc.trans ?_⟩
  have h1 := hdisp n i hi y
  have h2 := hdisp n i hi y'
  simp only [Function.comp_apply] at hcost
  linarith

end Reduction

section Example

/-! ### A continuum kernel on `[0, 1]`

Two sites, spin space `[0, 1]`. The continuum kernel at site `1` puts mass `(1 + x₀)/3` on the endpoint
`1` and the rest on `0`, for every boundary value `x₀ ∈ [0, 1]`. Its Dobrushin coefficient is `1/3`
for all boundary values. The net is `{0, 1}` (`eB`), the quantiser rounds at `1/2`, and the discretised
laws are the two-site Ising laws of `FiniteCoupling.example_comparison`. -/

/-- The continuum kernel's law on the endpoints. -/
noncomputable def kB (x : Fin 2 → unitInterval) : Bool → ℝ :=
  fun b => if b then (1 + (x 0 : ℝ)) / 3 else (2 - (x 0 : ℝ)) / 3

lemma kB_isProb (x : Fin 2 → unitInterval) : IsProb (kB x) := by
  have h0 := (x 0).2.1
  have h1 := (x 0).2.2
  refine ⟨fun b => ?_, ?_⟩
  · cases b <;> simp only [kB, Bool.false_eq_true, if_true, if_false] <;> apply div_nonneg <;> linarith
  · simp only [kB, Fintype.sum_bool, Bool.false_eq_true, if_true, if_false]
    ring

/-- The continuum single-site kernel (the same at both sites; only site `1` is used). -/
noncomputable def Kex (_i : Fin 2) (x : Fin 2 → unitInterval) : ProbabilityMeasure unitInterval :=
  pushProb eB (kB x) (kB_isProb x)

lemma Kex_coe (i : Fin 2) (x : Fin 2 → unitInterval) :
    (Kex i x : Measure unitInterval) = pushMeasure eB (kB x) := rfl

/-- The quantiser: round at `1/2`. -/
noncomputable def qB (a : unitInterval) : Bool := decide ((1 : ℝ) / 2 ≤ (a : ℝ))

lemma qB_eB (b : Bool) : qB (eB b) = b := by
  cases b <;> norm_num [qB, eB]

lemma qB_measurable (b : Bool) : MeasurableSet (qB ⁻¹' {b}) := by
  have hm : MeasurableSet {a : unitInterval | (1 : ℝ) / 2 ≤ (a : ℝ)} :=
    measurableSet_le measurable_const continuous_subtype_val.measurable
  cases b
  · convert hm.compl using 1
    ext a
    simp [qB]
  · convert hm using 1
    ext a
    simp [qB]

lemma quantize_push (p : Bool → ℝ) (hp : IsProb p) (b : Bool) :
    quantize qB (pushMeasure eB p) b = p b := by
  simp only [quantize, measureReal_def, pushMeasure_apply eB p (qB_measurable b), Fintype.sum_bool]
  cases b <;> simp [Set.indicator, qB_eB, ENNReal.toReal_ofReal (hp.1 _)]

lemma kB_eq (y : Fin 2 → Bool) : kB (eB ∘ y) = heatBath Φμ 1 y := by
  funext b
  rw [heatBath_one]
  simp only [kB, Function.comp_apply]
  cases y 0 <;> cases b <;> simp [eB, pairW] <;> norm_num

lemma dist_unit_le_one (a b : unitInterval) : dist a b ≤ 1 := by
  rcases a with ⟨a, ha⟩
  rcases b with ⟨b, hb⟩
  rw [Subtype.dist_eq, Real.dist_eq]
  simp only [Set.mem_Icc] at ha hb
  rw [abs_le]
  constructor <;> linarith

/-- **The continuum Dobrushin bound of the example**, for every pair of boundary values in `[0, 1]²`. -/
theorem Kex_dobrushin : ∀ i ∉ ({0} : Finset (Fin 2)), ∀ x x' : Fin 2 → unitInterval,
    ∃ γ ∈ couplings (Kex i x) (Kex i x'),
      ∫ z, dist z.1 z.2 ∂(γ : Measure (unitInterval × unitInterval)) ≤
        ∑ j, Cex i j * dist (x j) (x' j) := by
  intro i hi x x'
  have hi1 : i = 1 := by
    fin_cases i
    · simp at hi
    · rfl
  subst hi1
  obtain ⟨π, hπ, hc⟩ := bool_coupling (kB_isProb x) (kB_isProb x')
  refine ⟨_, push_mem_couplings (e := eB) (kB_isProb x) (kB_isProb x') hπ, ?_⟩
  show ∫ z, dist z.1 z.2 ∂(pushMeasure (fun z : Bool × Bool => (eB z.1, eB z.2)) π) ≤ _
  rw [integral_pushMeasure _ hπ.1]
  have htc : ∑ z : Bool × Bool, π z * dist (eB z.1, eB z.2).1 (eB z.1, eB z.2).2 = tcost dB π := by
    rw [Fintype.sum_prod_type]
    simp only [dist_eB]
    rfl
  rw [htc, hc]
  have hx : |kB x true - kB x' true| = 1 / 3 * |(x 0 : ℝ) - (x' 0 : ℝ)| := by
    simp only [kB, if_true]
    rw [show (1 + (x 0 : ℝ)) / 3 - (1 + (x' 0 : ℝ)) / 3 = ((x 0 : ℝ) - (x' 0 : ℝ)) / 3 by ring, abs_div]
    norm_num
    ring
  rw [hx]
  simp [Cex, Subtype.dist_eq, Real.dist_eq]

/-- **Non-vacuity of `compact_comparison_of_quantization`.** On `X = [0, 1]` every hypothesis is
discharged for two distinct laws: the continuum kernel `Kex` with Dobrushin coefficient `1/3` at all
boundary values, the quantiser `qB` (expected displacement `0` under `Kex` at net boundaries), and the
discretised Ising heat baths, which equal the quantised continuum kernels (`δ = 0`). -/
theorem example_quantization :
    let μ := pushProb (fun x : Fin 2 → Bool => eB ∘ x) (gibbs Φμ) (gibbs_isProb Φμ Φμ_pos)
    let ν := pushProb (fun x : Fin 2 → Bool => eB ∘ x) (gibbs Φν) (gibbs_isProb Φν Φν_pos)
    μ ≠ ν ∧ ∃ γ ∈ couplings μ ν,
      ∫ z, (∑ i, dist (z.1 i) (z.2 i)) ∂(γ : Measure ((Fin 2 → unitInterval) × (Fin 2 → unitInterval))) ≤
        3 / 2 := by
  intro μ ν
  refine ⟨CouplingLimit.example_limit.1, ?_⟩
  have hS : ∀ i ∉ ({0} : Finset (Fin 2)), i = 1 := by
    intro i hi
    fin_cases i
    · simp at hi
    · rfl
  have hνk : ∀ i ∉ ({0} : Finset (Fin 2)), Stationary (gibbs Φν) (heatBath Φμ i) i := by
    intro i hi
    rw [hS i hi, ← heatBath_ν]
    exact gibbs_stationary Φν Φν_pos 1
  obtain ⟨γ, hγ, hb⟩ := compact_comparison_of_quantization μ ν {0} 1 dist_unit_le_one
    Cex (fun i j => by unfold Cex; split_ifs <;> norm_num) (fun _ => 1) (fun _ => one_pos) (1 / 3)
    (by norm_num) (fun j => by fin_cases j <;> simp [Cex])
    Kex Kex_dobrushin (fun _ => Bool) (fun _ => eB) (fun _ => qB) (fun _ => qB_measurable)
    (fun _ => 0) tendsto_const_nhds
    (fun n i hi y => by
      rw [Kex_coe, integral_pushMeasure _ (kB_isProb _).1]
      simp [qB_eB])
    (fun _ => gibbs Φμ) (fun _ => gibbs Φν) (fun _ => gibbs_isProb Φμ Φμ_pos)
    (fun _ => gibbs_isProb Φν Φν_pos) (fun _ => heatBath Φμ)
    (fun _ i x => heatBath_isProb Φμ Φμ_pos i x) (fun _ i _ => gibbs_stationary Φμ Φμ_pos i)
    (fun _ => hνk) (fun _ => 0) tendsto_const_nhds
    (fun n i hi y => by
      rw [hS i hi]
      have hq : quantize qB (Kex 1 (eB ∘ y) : Measure unitInterval) = heatBath Φμ 1 y := by
        funext b
        rw [Kex_coe, quantize_push (kB (eB ∘ y)) (kB_isProb _) b, kB_eq]
      rw [hq]
      exact ⟨_, diag_isCoupling (heatBath_isProb Φμ Φμ_pos 1 y),
        (tcost_diag (fun a b => dist (eB a) (eB b)) (fun a => dist_self (eB a))
          (heatBath Φμ 1 y)).le⟩)
    tendsto_const_nhds tendsto_const_nhds
  refine ⟨γ, hγ, ?_⟩
  simp only [one_mul] at hb
  refine hb.trans (le_of_eq ?_)
  simp
  norm_num

end Example

