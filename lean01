    (activeCounts .plaq).foldl max 0 = 12 ∧ (activeCounts .rect).foldl max 0 = 66
    ∧ (activeCounts .chair).foldl max 0 = 264 ∧ (activeCounts .twist).foldl max 0 = 88 := by
  refine ⟨forestDefault_of_mu _ _ ?_ ?_ ?_ ?_, forestDefault_of_mu _ _ ?_ ?_ ?_ ?_,
