theorem sigma_line_field :
    sigmaTable.all (· < 4)
    ∧ parityClasses.all (fun r => ((List.range 4).filter fun d => forest (r.bump d (-1)) d).length = 1) := by
  decide +kernel

def M32 : Nat := 0xFFFFFFFF

def philoxRounds : Nat → Nat → Nat × Nat × Nat × Nat → Nat → Nat → Nat × Nat × Nat × Nat
  | 0, _, c, _, _ => c
  | n + 1, r, (c0, c1, c2, c3), k0, k1 =>
    let k0 := if r > 0 then (k0 + 0x9E3779B9) &&& M32 else k0
    let k1 := if r > 0 then (k1 + 0xBB67AE85) &&& M32 else k1
    let m0 := 0xD2511F53 * c0
    let m1 := 0xCD9E8D57 * c2
    philoxRounds n (r + 1)
      ((((m1 >>> 32) &&& M32) ^^^ c1) ^^^ k0, m1 &&& M32, (((m0 >>> 32) &&& M32) ^^^ c3) ^^^ k1, m0 &&& M32) k0 k1

def philox (c0 c1 c2 c3 k0 k1 : Nat) : Nat × Nat × Nat × Nat := philoxRounds 10 0 (c0, c1, c2, c3) k0 k1

theorem philox_known_answers :
    philox 0 0 0 0 0 0 = (0x6627e8d5, 0xe169c58d, 0xbc57ac4c, 0x9b00dbd8)
    ∧ philox 0xffffffff 0xffffffff 0xffffffff 0xffffffff 0xffffffff 0xffffffff
        = (0x408f276d, 0x41c83b0e, 0xa20bc7c6, 0x6d5451fd)
    ∧ philox 0x243f6a88 0x85a308d3 0x13198a2e 0x03707344 0xa4093822 0x299f31d0
        = (0xd16cfe09, 0x94fdcceb, 0x5001e420, 0x24126ea1) := by
  decide

def u01Num (a b : Nat) : Nat := 2 * ((a >>> 5) * 2 ^ 26 + (b >>> 6)) + 1

theorem u01_exact_in_open_unit (a b : Nat) (ha : a < 2 ^ 32) (hb : b < 2 ^ 32) :
    0 < u01Num a b ∧ u01Num a b < 2 ^ 54 := by
  simp only [u01Num, Nat.shiftRight_eq_div_pow, Nat.reducePow] at *; omega

def u01Float (a b : UInt32) : Float :=
  ((a >>> 5).toFloat * 67108864.0 + (b >>> 6).toFloat + 0.5) * (1.0 / 9007199254740992.0)

def fact : Nat → Nat
  | 0 => 1
  | n + 1 => (n + 1) * fact n

def logZ1Term (q : Rat) : Nat → Rat
  | 0 => 1
  | m + 1 => logZ1Term q m * (q / (((m : Rat) + 1) * ((m : Rat) + 2)))

theorem logZ1Term_closed (q : Rat) (m : Nat) :
    logZ1Term q m * ((fact m : Rat) * (fact (m + 1) : Rat)) = q ^ m := by
  induction m with
  | zero => simp [logZ1Term, fact]
  | succ m ih =>
    have hm : (0 : Rat) ≤ (m : Rat) := Rat.natCast_nonneg
    have h1 : ((m : Rat) + 1) ≠ 0 := by grind
    have h2 : ((m : Rat) + 2) ≠ 0 := by grind
    have hf : (fact (m + 1 + 1) : Rat) = ((m : Rat) + 2) * (fact (m + 1) : Rat) := by
      simp only [fact]; push_cast; grind
    have hf' : (fact (m + 1) : Rat) = ((m : Rat) + 1) * (fact m : Rat) := by
      simp only [fact]; push_cast; grind
    simp only [logZ1Term]; rw [hf, hf', Rat.pow_succ]; rw [hf'] at ih
    grind

