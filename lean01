section Part16_SharpBlockData

/- Generated from outward-rounded Arb enclosures (interval arithmetic), denominator 10^12. -/

def den : Nat := 1000000000000
/-- lower bound for every eigenvalue of Hess g on the ball |c| <= 24 beta -/
def lamLo : Nat := 156381938687
/-- upper bound for every eigenvalue of Hess g on that ball -/
def tauHi : Nat := 250000000007
/-- upper bound for the norm of D^3 g on that ball -/
def mHi : Nat := 61517136568
/-- upper bound for |grad g(c)| = |c| 2 phi'(|c|^2) on |c| <= 20 beta -/
def aHi : Nat := 391442796709

end Part16_SharpBlockData

section Part17_SharpBlockCheck

/-
Kernel-checked arithmetic of the sharpened plaquette-block constant for SU(2) (Lean core only, no Mathlib).

Inputs (Part 16, from Arb enclosures, rounded outward to 10^-12):
  lamLo <= every eigenvalue of Hess g,  tauHi >= every eigenvalue,  mHi >= |D^3 g|   on |c| <= 24 beta,
  aHi >= |grad g(c)|                                                                on |c| <= 20 beta,
for g = log Z0 and beta = beta_W / 4 at the endpoint beta_W = 0.351.

Three elementary facts are used as rational inequalities, each checked below:
  e^w <= 1/(1-w) for 0 <= w < 1          (encoded as E := 1/(1-W)),
  sqrt(tau) <= q   because q^2 >= tau     (sq_ok),
  1/sqrt 3  <= r   because 3 r^2 >= 1     (r_ok).

Checked (eq. (S) of the accompanying notes):
  W  = 8 beta^2 (tau - lambda_*)
  S  = 1/4 + (E - 1) E q r
  Cc = 4 beta S aHi + 20 beta * 16 beta^2 mHi E / 3          < 1
  alpha = 40 beta (1 + beta) S / (1 - Cc)                   < 1      (and <= 0.99997)
Every quantity is increasing in each input bound, so the checked numbers bound the true ones.
-/

/-- nonnegative rationals as numerator / denominator (denominators are positive throughout). -/
structure Q where
  n : Nat
  d : Nat

def Q.add (a b : Q) : Q := ⟨a.n * b.d + b.n * a.d, a.d * b.d⟩
def Q.mul (a b : Q) : Q := ⟨a.n * b.n, a.d * b.d⟩
/-- truncated difference; only used where `b ≤ a` is checked. -/
def Q.sub (a b : Q) : Q := ⟨a.n * b.d - b.n * a.d, a.d * b.d⟩
def Q.div (a b : Q) : Q := ⟨a.n * b.d, a.d * b.n⟩
def Q.le (a b : Q) : Bool := a.n * b.d ≤ b.n * a.d
def Q.lt (a b : Q) : Bool := a.n * b.d < b.n * a.d
def Q.nat (k : Nat) : Q := ⟨k, 1⟩

def lam : Q := ⟨lamLo, den⟩
def tau : Q := ⟨tauHi, den⟩
def mM : Q := ⟨mHi, den⟩
def aA : Q := ⟨aHi, den⟩
def q : Q := ⟨500000000008, den⟩
def r : Q := ⟨577350269190, den⟩
def one : Q := Q.nat 1

def sq_ok : Bool := tau.le (q.mul q)
def r_ok : Bool := one.le ((Q.nat 3).mul (r.mul r))
def tau_lam_ok : Bool := lam.le tau

/-- the chain of (S) at beta = bW / 4: returns (W, S, Cc, alpha). -/
def chain (bW : Q) : Q × Q × Q × Q :=
  let b := bW.div (Q.nat 4)
  let W := (Q.nat 8).mul (b.mul (b.mul (tau.sub lam)))
  let E := one.div (one.sub W)
  let S := (⟨1, 4⟩ : Q).add ((E.sub one).mul (E.mul (q.mul r)))
  let Cc := ((Q.nat 4).mul (b.mul (S.mul aA))).add
            ((⟨320, 3⟩ : Q).mul (b.mul (b.mul (b.mul (mM.mul E)))))
  let alpha := ((Q.nat 40).mul (b.mul ((one.add b).mul S))).div (one.sub Cc)
  (W, S, Cc, alpha)

/-- all side conditions (W < 1, Cc < 1, E >= 1) and alpha <= bound. -/
def ok (bW bound : Q) : Bool :=
  let (W, _, Cc, alpha) := chain bW
  W.lt one && Cc.lt one && alpha.le bound

theorem side_ok : (sq_ok && r_ok && tau_lam_ok) = true := by decide +kernel

/-- the endpoint: alpha(0.351) <= 0.99997 < 1. -/
theorem alpha_0351 : ok ⟨351, 1000⟩ ⟨99997, 100000⟩ = true := by decide +kernel

/-- with the same constants (valid on the smaller balls): alpha(0.345) <= 0.98046, alpha(1/3) <= 0.94280. -/
theorem alpha_0345 : ok ⟨345, 1000⟩ ⟨98046, 100000⟩ = true := by decide +kernel
theorem alpha_third : ok ⟨1, 3⟩ ⟨94280, 100000⟩ = true := by decide +kernel

/-- sanity: the check is not vacuous; alpha(0.352) with these constants exceeds 1. -/
theorem alpha_0352_fails : ok ⟨352, 1000⟩ ⟨1, 1⟩ = false := by decide +kernel

end Part17_SharpBlockCheck

section Part18_MCRG_qmul_assoc

section

namespace YMMCRG

universe u v

@[ext] structure Q (R : Type u) where
  w : R
  x : R
  y : R
  z : R

section Quat
variable {R : Type u} [Lean.Grind.CommRing R]

def qmul (a b : Q R) : Q R :=
  ⟨a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z,
   a.w * b.x + b.w * a.x - a.y * b.z + a.z * b.y,
   a.w * b.y + b.w * a.y - a.z * b.x + a.x * b.z,
   a.w * b.z + b.w * a.z - a.x * b.y + a.y * b.x⟩
def qconj (a : Q R) : Q R := ⟨a.w, -a.x, -a.y, -a.z⟩
def qadd (a b : Q R) : Q R := ⟨a.w + b.w, a.x + b.x, a.y + b.y, a.z + b.z⟩
def qscale (a : Q R) (s : R) : Q R := ⟨a.w * s, a.x * s, a.y * s, a.z * s⟩
def qdot (a b : Q R) : R := a.w * b.w + a.x * b.x + a.y * b.y + a.z * b.z
def qzero : Q R := ⟨0, 0, 0, 0⟩
def qone : Q R := ⟨1, 0, 0, 0⟩

def SU2 (q : Q R) : Prop := qdot q q = 1

macro "qring" : tactic =>
  `(tactic| (first
    | (ext <;> simp only [qmul, qconj, qadd, qscale, qdot, qzero, qone] <;> grind)
    | (simp only [qmul, qconj, qadd, qscale, qdot, qzero, qone] <;> grind)))

theorem qmul_assoc (a b c : Q R) : qmul (qmul a b) c = qmul a (qmul b c) := by qring
theorem qone_qmul (a : Q R) : qmul qone a = a := by qring
theorem qmul_qone (a : Q R) : qmul a qone = a := by qring
theorem qconj_qconj (a : Q R) : qconj (qconj a) = a := by qring
theorem qconj_qmul (a b : Q R) : qconj (qmul a b) = qmul (qconj b) (qconj a) := by qring
theorem qmul_qconj_self (a : Q R) : qmul a (qconj a) = qscale qone (qdot a a) := by qring
theorem qconj_qmul_self (a : Q R) : qmul (qconj a) a = qscale qone (qdot a a) := by qring
theorem qdot_qmul (a b : Q R) : qdot (qmul a b) (qmul a b) = qdot a a * qdot b b := by qring
theorem qdot_qmul_left (g a b : Q R) : qdot (qmul g a) (qmul g b) = qdot g g * qdot a b := by qring
theorem qdot_qmul_right (a b g : Q R) : qdot (qmul a g) (qmul b g) = qdot a b * qdot g g := by qring
theorem qdot_comm (a b : Q R) : qdot a b = qdot b a := by qring
theorem qdot_qconj (a b : Q R) : qdot (qconj a) (qconj b) = qdot a b := by qring
theorem re_qmul (u t : Q R) : (qmul u t).w = qdot u (qconj t) := by qring
theorem re_qmul_comm (a b : Q R) : (qmul a b).w = (qmul b a).w := by qring

theorem qadd_assoc (a b c : Q R) : qadd (qadd a b) c = qadd a (qadd b c) := by qring
theorem qadd_qzero (a : Q R) : qadd a qzero = a := by qring
theorem qzero_qadd (a : Q R) : qadd qzero a = a := by qring

theorem su2_qone : SU2 (qone : Q R) := by unfold SU2; qring
theorem su2_qconj {a : Q R} (h : SU2 a) : SU2 (qconj a) := by
  unfold SU2 at *; rw [qdot_qconj]; exact h
theorem su2_qmul {a b : Q R} (ha : SU2 a) (hb : SU2 b) : SU2 (qmul a b) := by
  unfold SU2 at *; rw [qdot_qmul, ha, hb]; grind
theorem qmul_qconj_of_su2 {g : Q R} (h : SU2 g) : qmul g (qconj g) = qone := by
  rw [qmul_qconj_self]; unfold SU2 at h; rw [h]; qring
theorem qconj_qmul_of_su2 {g : Q R} (h : SU2 g) : qmul (qconj g) g = qone := by
  rw [qconj_qmul_self]; unfold SU2 at h; rw [h]; qring
theorem re_conjugate {g : Q R} (h : SU2 g) (a : Q R) : (qmul (qmul g a) (qconj g)).w = a.w := by
  rw [re_qmul_comm, ← qmul_assoc, qconj_qmul_of_su2 h, qone_qmul]

theorem bicov_add (g h a b : Q R) :
    qmul (qmul g (qadd a b)) h = qadd (qmul (qmul g a) h) (qmul (qmul g b) h) := by qring
theorem bicov_scale (g h a : Q R) (c : R) :
    qmul (qmul g (qscale a c)) h = qscale (qmul (qmul g a) h) c := by qring
theorem bicov_zero (g h : Q R) : qmul (qmul g qzero) h = qzero := by qring
theorem qdot_bicov {g h : Q R} (hg : SU2 g) (hh : SU2 h) (a b : Q R) :
    qdot (qmul (qmul g a) (qconj h)) (qmul (qmul g b) (qconj h)) = qdot a b := by
  rw [qdot_qmul_right, qdot_qmul_left]; unfold SU2 at hg hh; rw [qdot_qconj, hg, hh]; grind
theorem qconj_bicov (g h a : Q R) :
    qconj (qmul (qmul g a) (qconj h)) = qmul (qmul h (qconj a)) (qconj g) := by
  rw [qconj_qmul, qconj_qmul, qconj_qconj, qmul_assoc]

theorem heatbath_newU_mul_S (V S : Q R) (κ : R) :
    qmul (qmul V (qscale (qconj S) κ)) S = qscale V (κ * qdot S S) := by qring
theorem heatbath_action (V S : Q R) (κ : R) :
    (qmul (qmul V (qscale (qconj S) κ)) S).w = (κ * qdot S S) * V.w := by
  rw [heatbath_newU_mul_S]; simp only [qscale]; grind
theorem heatbath_Shat_su2 (S : Q R) (κ : R) (hκ : κ * κ * qdot S S = 1) : SU2 (qscale (qconj S) κ) := by
  unfold SU2; simp only [qscale, qconj, qdot] at *; grind
theorem heatbath_map_isometry (S : Q R) (κ : R) (hκ : κ * κ * qdot S S = 1) (V W : Q R) :
    qdot (qmul V (qscale (qconj S) κ)) (qmul W (qscale (qconj S) κ)) = qdot V W := by
  have h := heatbath_Shat_su2 S κ hκ; unfold SU2 at h; rw [qdot_qmul_right, h]; grind
theorem heatbath_map_inverse (S : Q R) (κ : R) (hκ : κ * κ * qdot S S = 1) (V : Q R) :
    qmul (qmul V (qscale (qconj S) κ)) (qconj (qscale (qconj S) κ)) = V := by
  rw [qmul_assoc, qmul_qconj_of_su2 (heatbath_Shat_su2 S κ hκ), qmul_qone]
theorem heatbath_V_su2 (x0 z c s rr rv : R) (hrr : rr * rr = 1 - z * z) (hrv : rv * rv = 1 - x0 * x0)
    (hcs : c * c + s * s = 1) : SU2 (⟨x0, rv * rr * c, rv * rr * s, rv * z⟩ : Q R) := by
  unfold SU2 qdot; grind
theorem heatbath_newU_su2 (V S : Q R) (κ : R) (hκ : κ * κ * qdot S S = 1) (hV : SU2 V) :
    SU2 (qmul V (qscale (qconj S) κ)) := su2_qmul hV (heatbath_Shat_su2 S κ hκ)

def reflect (u n : Q R) : Q R :=
  ⟨2 * qdot u n * n.w - u.w, 2 * qdot u n * n.x - u.x, 2 * qdot u n * n.y - u.y, 2 * qdot u n * n.z - u.z⟩

theorem reflect_qdot_self (u n : Q R) (hn : SU2 n) : qdot (reflect u n) (reflect u n) = qdot u u := by
  unfold SU2 at hn; simp only [reflect, qdot] at *; grind
theorem reflect_qdot_n (u n : Q R) (hn : SU2 n) : qdot (reflect u n) n = qdot u n := by
  unfold SU2 at hn; simp only [reflect, qdot] at *; grind
theorem reflect_reflect (u n : Q R) (hn : SU2 n) : reflect (reflect u n) n = u := by
  have h := reflect_qdot_n u n hn
  ext <;> simp only [reflect] at * <;> rw [h] <;> grind
theorem overrelax_action (u S : Q R) (κ : R) (hκ : κ * κ * qdot S S = 1) :
    (qmul (reflect u (qscale (qconj S) κ)) S).w = (qmul u S).w := by
  have h := reflect_qdot_n u _ (heatbath_Shat_su2 S κ hκ)
  rw [re_qmul, re_qmul]
  simp only [qdot, qscale, qconj, reflect] at *
  grind
theorem overrelax_su2 (u n : Q R) (hn : SU2 n) (hu : SU2 u) : SU2 (reflect u n) := by
  unfold SU2 at *; rw [reflect_qdot_self u n hn, hu]

theorem sd_grad_tangent (u t : Q R) (hu : SU2 u) : qdot (qadd t (qscale u (-(qdot u t)))) u = 0 := by
  unfold SU2 at hu; simp only [qadd, qscale, qdot] at *; grind
theorem sd_adj_grad_tangent (u w : Q R) (hu : SU2 u) :
    qdot (qadd (qscale w (qdot u w)) (qscale u (-(qdot u w * qdot u w)))) u = 0 := by
  unfold SU2 at hu; simp only [qadd, qscale, qdot] at *; grind
theorem tangent_qadd (a b u : Q R) (ha : qdot a u = 0) (hb : qdot b u = 0) : qdot (qadd a b) u = 0 := by
  simp only [qadd, qdot] at *; grind
theorem tangent_qscale (a u : Q R) (c : R) (ha : qdot a u = 0) : qdot (qscale a c) u = 0 := by
  simp only [qscale, qdot] at *; grind

end Quat

abbrev Site := Fin 4 → Int
def shift (x : Site) (d : Fin 4) (s : Int) : Site := fun i => if i = d then x i + s else x i

theorem shift_shift (x : Site) (d : Fin 4) (a b : Int) : shift (shift x d a) d b = shift x d (a + b) := by
  funext i; by_cases h : i = d <;> simp [shift, h]; omega
theorem shift_zero (x : Site) (d : Fin 4) : shift x d 0 = x := by
  funext i; by_cases h : i = d <;> simp [shift, h]
theorem shift_back (x : Site) (d : Fin 4) : shift (shift x d (-1)) d 1 = x := by
  rw [shift_shift]; simp [shift_zero]

inductive Step where
  | fwd (d : Fin 4)
  | bwd (d : Fin 4)
  deriving DecidableEq, Repr

def Step.ofCode : Nat → Step
  | 0 => .fwd 0 | 1 => .fwd 1 | 2 => .fwd 2 | 3 => .fwd 3
  | 4 => .bwd 0 | 5 => .bwd 1 | 6 => .bwd 2 | _ => .bwd 3
def decode (p : List Nat) : List Step := p.map Step.ofCode

section Lattice
variable {R : Type u} [Lean.Grind.CommRing R]

abbrev GaugeField (R : Type u) := Site → Fin 4 → Q R

def walk : Site → List Step → Site
  | y, [] => y
  | y, .fwd d :: p => walk (shift y d 1) p
  | y, .bwd d :: p => walk (shift y d (-1)) p

def hol (U : GaugeField R) : Site → List Step → Q R
  | _, [] => qone
  | y, .fwd d :: p => qmul (U y d) (hol U (shift y d 1) p)
  | y, .bwd d :: p => qmul (qconj (U (shift y d (-1)) d)) (hol U (shift y d (-1)) p)

def loopStep (U : GaugeField R) : Site × Q R → Step → Site × Q R
  | (y, M), .fwd d => (shift y d 1, qmul M (U y d))
  | (y, M), .bwd d => (shift y d (-1), qmul M (qconj (U (shift y d (-1)) d)))

def holLoop (U : GaugeField R) (x : Site) (p : List Step) : Q R := (p.foldl (loopStep U) (x, qone)).2

theorem foldl_loopStep (U : GaugeField R) (p : List Step) :
    ∀ (y : Site) (M : Q R), (p.foldl (loopStep U) (y, M)).2 = qmul M (hol U y p) := by
  induction p with
  | nil => intro y M; simp [hol, qmul_qone]
  | cons s p ih =>
    intro y M; cases s with
    | fwd d => simp only [List.foldl, loopStep, hol]; rw [ih, qmul_assoc]
    | bwd d => simp only [List.foldl, loopStep, hol]; rw [ih, qmul_assoc]

theorem holLoop_eq_hol (U : GaugeField R) (x : Site) (p : List Step) : holLoop U x p = hol U x p := by
  unfold holLoop; rw [foldl_loopStep, qone_qmul]

def gauge (g : Site → Q R) (U : GaugeField R) : GaugeField R :=
  fun y d => qmul (qmul (g y) (U y d)) (qconj (g (shift y d 1)))

theorem hol_gauge (g : Site → Q R) (hg : ∀ y, SU2 (g y)) (U : GaugeField R) (p : List Step) :
    ∀ x, hol (gauge g U) x p = qmul (qmul (g x) (hol U x p)) (qconj (g (walk x p))) := by
  induction p with
  | nil => intro x; simp only [hol, walk]; rw [qmul_qone, qmul_qconj_of_su2 (hg x)]
  | cons s p ih =>
    intro x; cases s with
    | fwd d =>
      simp only [hol, walk, gauge]; rw [ih]
      calc qmul (qmul (qmul (g x) (U x d)) (qconj (g (shift x d 1))))
              (qmul (qmul (g (shift x d 1)) (hol U (shift x d 1) p)) (qconj (g (walk (shift x d 1) p))))
          = qmul (qmul (g x) (U x d)) (qmul (qmul (qconj (g (shift x d 1))) (g (shift x d 1)))
              (qmul (hol U (shift x d 1) p) (qconj (g (walk (shift x d 1) p))))) := by
            simp only [qmul_assoc]
        _ = _ := by rw [qconj_qmul_of_su2 (hg _), qone_qmul]; simp only [qmul_assoc]
    | bwd d =>
      simp only [hol, walk, gauge]; rw [ih, shift_back, qconj_qmul, qconj_qmul, qconj_qconj]
      calc qmul (qmul (g x) (qmul (qconj (U (shift x d (-1)) d)) (qconj (g (shift x d (-1))))))
              (qmul (qmul (g (shift x d (-1))) (hol U (shift x d (-1)) p)) (qconj (g (walk (shift x d (-1)) p))))
          = qmul (g x) (qmul (qconj (U (shift x d (-1)) d))
              (qmul (qmul (qconj (g (shift x d (-1)))) (g (shift x d (-1))))
              (qmul (hol U (shift x d (-1)) p) (qconj (g (walk (shift x d (-1)) p)))))) := by
            simp only [qmul_assoc]
        _ = _ := by rw [qconj_qmul_of_su2 (hg _), qone_qmul]; simp only [qmul_assoc]

theorem wilson_loop_gauge_invariant (g : Site → Q R) (hg : ∀ y, SU2 (g y)) (U : GaugeField R)
    (x : Site) (p : List Step) (hclosed : walk x p = x) : (hol (gauge g U) x p).w = (hol U x p).w := by
  rw [hol_gauge g hg, hclosed, re_conjugate (hg x)]

theorem staple_gauge (g : Site → Q R) (hg : ∀ y, SU2 (g y)) (U : GaugeField R) (x : Site) (mu : Fin 4)
    (rest : List Step) (hclosed : walk x (.fwd mu :: rest) = x) :
    qconj (hol (gauge g U) (shift x mu 1) rest)
      = qmul (qmul (g x) (qconj (hol U (shift x mu 1) rest))) (qconj (g (shift x mu 1))) := by
  simp only [walk] at hclosed; rw [hol_gauge g hg, hclosed, qconj_bicov]

theorem pl_sd_inputs_gauge_invariant (g : Site → Q R) (hg : ∀ y, SU2 (g y)) (U : GaugeField R) (x : Site)
    (mu : Fin 4) (p q : List Step) (hp : walk x (.fwd mu :: p) = x) (hq : walk x (.fwd mu :: q) = x) :
    qdot (gauge g U x mu) (qconj (hol (gauge g U) (shift x mu 1) p))
        = qdot (U x mu) (qconj (hol U (shift x mu 1) p))
    ∧ qdot (qconj (hol (gauge g U) (shift x mu 1) p)) (qconj (hol (gauge g U) (shift x mu 1) q))
        = qdot (qconj (hol U (shift x mu 1) p)) (qconj (hol U (shift x mu 1) q)) := by
  rw [staple_gauge g hg U x mu p hp, staple_gauge g hg U x mu q hq]
  exact ⟨by unfold gauge; exact qdot_bicov (hg _) (hg _) _ _, qdot_bicov (hg _) (hg _) _ _⟩

def dbl (X : Site) : Site := fun i => 2 * X i

theorem dbl_shift (X : Site) (d : Fin 4) (s : Int) : dbl (shift X d s) = shift (dbl X) d (2 * s) := by
  funext i; by_cases h : i = d <;> simp [dbl, shift, h]; omega

def block (U : GaugeField R) : GaugeField R := fun X d => qmul (U (dbl X) d) (U (shift (dbl X) d 1) d)

def dblPath : List Step → List Step
  | [] => []
  | s :: p => s :: s :: dblPath p

theorem hol_block (U : GaugeField R) (p : List Step) :
    ∀ X, hol (block U) X p = hol U (dbl X) (dblPath p) := by
  induction p with
  | nil => intro X; rfl
  | cons s p ih =>
    intro X; cases s with
    | fwd d =>
      simp only [hol, dblPath, block]; rw [ih, dbl_shift, shift_shift, qmul_assoc]; rfl
    | bwd d =>
      simp only [hol, dblPath, block]
      rw [ih, dbl_shift, qconj_qmul, qmul_assoc, shift_shift, shift_shift]
      have h1 : (2 * (-1 : Int)) = -1 + -1 := by decide
      have h2 : (2 * (-1 : Int) + 1) = -1 := by decide
      rw [h2, h1]

theorem walk_dbl (p : List Step) : ∀ X, walk (dbl X) (dblPath p) = dbl (walk X p) := by
  induction p with
  | nil => intro X; rfl
  | cons s p ih =>
    intro X; cases s with
    | fwd d => simp only [walk, dblPath]; rw [shift_shift, ← ih, dbl_shift]; rfl
    | bwd d => simp only [walk, dblPath]; rw [shift_shift, ← ih, dbl_shift]; rfl

theorem blocked_plaquette_eq_fine_2x2 (U : GaugeField R) (X : Site) (a c : Fin 4) :
    hol (block U) X [.fwd a, .fwd c, .bwd a, .bwd c]
      = hol U (dbl X) [.fwd a, .fwd a, .fwd c, .fwd c, .bwd a, .bwd a, .bwd c, .bwd c] :=
  hol_block U _ X

theorem block_gauge (g : Site → Q R) (hg : ∀ y, SU2 (g y)) (U : GaugeField R) :
    block (gauge g U) = gauge (fun X => g (dbl X)) (block U) := by
  funext X d
  simp only [block, gauge]; rw [dbl_shift, shift_shift]
  calc qmul (qmul (qmul (g (dbl X)) (U (dbl X) d)) (qconj (g (shift (dbl X) d 1))))
          (qmul (qmul (g (shift (dbl X) d 1)) (U (shift (dbl X) d 1) d)) (qconj (g (shift (dbl X) d (1 + 1)))))
      = qmul (g (dbl X)) (qmul (U (dbl X) d)
          (qmul (qmul (qconj (g (shift (dbl X) d 1))) (g (shift (dbl X) d 1)))
          (qmul (U (shift (dbl X) d 1) d) (qconj (g (shift (dbl X) d (1 + 1))))))) := by
        simp only [qmul_assoc]
    _ = _ := by rw [qconj_qmul_of_su2 (hg _), qone_qmul]; simp only [qmul_assoc]; rfl

theorem block_su2 (U : GaugeField R) (hU : ∀ y d, SU2 (U y d)) : ∀ X d, SU2 (block U X d) :=
  fun _ _ => su2_qmul (hU _ _) (hU _ _)

def blockN (N : R → R) (U : GaugeField R) : GaugeField R :=
  fun X d => qscale (block U X d) (N (qdot (block U X d) (block U X d)))

theorem blockN_eq_block (N : R → R) (hN : N 1 = 1) (U : GaugeField R) (hU : ∀ y d, SU2 (U y d)) :
    blockN N U = block U := by
  funext X d; simp only [blockN]; rw [block_su2 U hU X d, hN]; qring

def iter {α : Type v} (f : α → α) : Nat → α → α
  | 0, a => a
  | n + 1, a => iter f n (f a)

theorem iter_succ' {α : Type v} (f : α → α) (n : Nat) (a : α) : iter f (n + 1) a = f (iter f n a) := by
  induction n generalizing a with
  | zero => rfl
  | succ n ih => exact ih (f a)

theorem hol_block_iter (k : Nat) :
    ∀ (U : GaugeField R) X p, hol (iter block k U) X p = hol U (iter dbl k X) (iter dblPath k p) := by
  induction k with
  | zero => intro U X p; rfl
  | succ k ih =>
    intro U X p
    show hol (iter block k (block U)) X p = _
    rw [ih, hol_block, iter_succ', iter_succ']

theorem block_gauge_iter (k : Nat) : ∀ (g : Site → Q R), (∀ y, SU2 (g y)) → ∀ U : GaugeField R,
    iter block k (gauge g U) = gauge (fun X => g (iter dbl k X)) (iter block k U) := by
  induction k with
  | zero => intro g _ U; rfl
  | succ k ih =>
    intro g hg U
    show iter block k (block (gauge g U)) = gauge (fun X => g (iter dbl (k + 1) X)) (iter block k (block U))
    rw [block_gauge g hg, ih (fun X => g (dbl X)) (fun _ => hg _)]
    simp only [iter_succ']

def stapleA (U : GaugeField R) (x : Site) (mu nu : Fin 4) : Q R :=
  qmul (qmul (U (shift x mu 1) nu) (qconj (U (shift x nu 1) mu))) (qconj (U x nu))
def stapleB (U : GaugeField R) (x : Site) (mu nu : Fin 4) : Q R :=
  qmul (qmul (qconj (U (shift (shift x mu 1) nu (-1)) nu)) (qconj (U (shift x nu (-1)) mu)))
    (U (shift x nu (-1)) nu)
def staplePlaq (U : GaugeField R) (x : Site) (mu : Fin 4) : Q R :=
  ((List.finRange 4).filter (· ≠ mu)).foldl
    (fun S nu => qadd (qadd S (stapleA U x mu nu)) (stapleB U x mu nu)) qzero

theorem stapleA_hol (U : GaugeField R) (x : Site) (mu nu : Fin 4) :
    stapleA U x mu nu = hol U (shift x mu 1) [.fwd nu, .bwd mu, .bwd nu] := by
  have h1 : shift (shift (shift x mu 1) nu 1) mu (-1) = shift x nu 1 := by
    funext i; simp only [shift]; grind
  have h2 : shift (shift x nu 1) nu (-1) = x := by funext i; simp only [shift]; grind
  simp only [hol, stapleA]; rw [h1, h2, qmul_qone, qmul_assoc]

theorem stapleB_hol (U : GaugeField R) (x : Site) (mu nu : Fin 4) :
    stapleB U x mu nu = hol U (shift x mu 1) [.bwd nu, .bwd mu, .fwd nu] := by
  have h1 : shift (shift (shift x mu 1) nu (-1)) mu (-1) = shift x nu (-1) := by
    funext i; simp only [shift]; grind
  simp only [hol, stapleB]; rw [h1, qmul_qone, qmul_assoc]

theorem staple_plaquettes (U : GaugeField R) (x : Site) (mu nu : Fin 4) :
    qmul (U x mu) (stapleA U x mu nu) = hol U x [.fwd mu, .fwd nu, .bwd mu, .bwd nu]
    ∧ qmul (U x mu) (stapleB U x mu nu) = hol U x [.fwd mu, .bwd nu, .bwd mu, .fwd nu] := by
  rw [stapleA_hol, stapleB_hol]; exact ⟨rfl, rfl⟩

theorem stapleA_gauge (g : Site → Q R) (hg : ∀ y, SU2 (g y)) (U : GaugeField R) (x : Site) (mu nu : Fin 4) :
    stapleA (gauge g U) x mu nu = qmul (qmul (g (shift x mu 1)) (stapleA U x mu nu)) (qconj (g x)) := by
  rw [stapleA_hol, stapleA_hol, hol_gauge g hg]
  have : walk (shift x mu 1) [.fwd nu, .bwd mu, .bwd nu] = x := by
    simp only [walk]; funext i; simp only [shift]; grind
  rw [this]

theorem stapleB_gauge (g : Site → Q R) (hg : ∀ y, SU2 (g y)) (U : GaugeField R) (x : Site) (mu nu : Fin 4) :
    stapleB (gauge g U) x mu nu = qmul (qmul (g (shift x mu 1)) (stapleB U x mu nu)) (qconj (g x)) := by
  rw [stapleB_hol, stapleB_hol, hol_gauge g hg]
  have : walk (shift x mu 1) [.bwd nu, .bwd mu, .fwd nu] = x := by
    simp only [walk]; funext i; simp only [shift]; grind
  rw [this]

theorem foldl_bicov (g h : Q R) (A B : Fin 4 → Q R) (l : List (Fin 4)) : ∀ S0 : Q R,
    l.foldl (fun S nu => qadd (qadd S (qmul (qmul g (A nu)) h)) (qmul (qmul g (B nu)) h)) (qmul (qmul g S0) h)
      = qmul (qmul g (l.foldl (fun S nu => qadd (qadd S (A nu)) (B nu)) S0)) h := by
  induction l with
  | nil => intro S0; rfl
  | cons nu l ih => intro S0; simp only [List.foldl]; rw [← bicov_add, ← bicov_add, ih]

theorem staplePlaq_gauge (g : Site → Q R) (hg : ∀ y, SU2 (g y)) (U : GaugeField R) (x : Site) (mu : Fin 4) :
    staplePlaq (gauge g U) x mu = qmul (qmul (g (shift x mu 1)) (staplePlaq U x mu)) (qconj (g x)) := by
  unfold staplePlaq
  simp only [stapleA_gauge g hg, stapleB_gauge g hg]
  rw [← foldl_bicov, bicov_zero]

def ape (a1 a2 : R) (N : R → R) (U : GaugeField R) : GaugeField R := fun x mu =>
  qscale (qadd (qscale (U x mu) a1) (qscale (qconj (staplePlaq U x mu)) a2))
    (N (qdot (qadd (qscale (U x mu) a1) (qscale (qconj (staplePlaq U x mu)) a2))
             (qadd (qscale (U x mu) a1) (qscale (qconj (staplePlaq U x mu)) a2))))

theorem ape_gauge (a1 a2 : R) (N : R → R) (g : Site → Q R) (hg : ∀ y, SU2 (g y)) (U : GaugeField R) :
    ape a1 a2 N (gauge g U) = gauge g (ape a1 a2 N U) := by
  funext x mu
  have hv : qadd (qscale (gauge g U x mu) a1) (qscale (qconj (staplePlaq (gauge g U) x mu)) a2)
      = qmul (qmul (g x) (qadd (qscale (U x mu) a1) (qscale (qconj (staplePlaq U x mu)) a2)))
          (qconj (g (shift x mu 1))) := by
    rw [staplePlaq_gauge g hg, qconj_bicov, bicov_add, bicov_scale, bicov_scale]; rfl
  simp only [ape, gauge] at hv ⊢
  rw [hv, qdot_bicov (hg _) (hg _), bicov_scale]

theorem ape_block_gauge (a1 a2 : R) (N : R → R) (n : Nat) (g : Site → Q R) (hg : ∀ y, SU2 (g y))
    (U : GaugeField R) :
    block (iter (ape a1 a2 N) n (gauge g U)) = gauge (fun X => g (dbl X)) (block (iter (ape a1 a2 N) n U)) := by
  have h : ∀ n (U : GaugeField R), iter (ape a1 a2 N) n (gauge g U) = gauge g (iter (ape a1 a2 N) n U) := by
    intro n; induction n with
    | zero => intro U; rfl
    | succ n ih => intro U; show iter _ n (ape a1 a2 N (gauge g U)) = _; rw [ape_gauge a1 a2 N g hg, ih]; rfl
  rw [h, block_gauge g hg]

def wrap (L : Int) (x : Site) : Site := fun i => x i % L

theorem wrap_shift_wrap (L : Int) (x : Site) (d : Fin 4) (s : Int) :
    wrap L (shift (wrap L x) d s) = wrap L (shift x d s) := by
  funext i; simp only [wrap, shift]; split <;> simp [Int.emod_add_emod]

theorem code_bwd_index (L y : Int) : (y - 1 + L) % L = (y + -1) % L := by
  rw [Int.add_emod_right, Int.sub_eq_add_neg]

def holT (L : Int) (U : GaugeField R) : Site → List Step → Q R
  | _, [] => qone
  | y, .fwd d :: p => qmul (U y d) (holT L U (wrap L (shift y d 1)) p)
  | y, .bwd d :: p => qmul (qconj (U (wrap L (shift y d (-1))) d)) (holT L U (wrap L (shift y d (-1))) p)

def lift (L : Int) (U : GaugeField R) : GaugeField R := fun y d => U (wrap L y) d

theorem holT_eq_hol_lift (L : Int) (U : GaugeField R) (p : List Step) :
    ∀ x, holT L U (wrap L x) p = hol (lift L U) x p := by
  induction p with
  | nil => intro x; rfl
  | cons s p ih =>
    intro x; cases s with
    | fwd d => simp only [holT, hol, lift]; rw [wrap_shift_wrap, ih]
    | bwd d => simp only [holT, hol, lift]; rw [wrap_shift_wrap, ih]

def gaugeT (L : Int) (g : Site → Q R) (U : GaugeField R) : GaugeField R :=
  fun y d => qmul (qmul (g y) (U y d)) (qconj (g (wrap L (shift y d 1))))

theorem gaugeT_lift (L : Int) (g : Site → Q R) (U : GaugeField R) :
    lift L (gaugeT L g U) = gauge (fun y => g (wrap L y)) (lift L U) := by
  funext y d; simp only [lift, gaugeT, gauge]; rw [wrap_shift_wrap]

theorem torus_wilson_loop_gauge_invariant (L : Int) (g : Site → Q R) (hg : ∀ y, SU2 (g y))
    (U : GaugeField R) (x : Site) (p : List Step) (hclosed : walk x p = x) :
    (holT L (gaugeT L g U) (wrap L x) p).w = (holT L U (wrap L x) p).w := by
  rw [holT_eq_hol_lift, holT_eq_hol_lift, gaugeT_lift]
  exact wilson_loop_gauge_invariant _ (fun _ => hg _) _ x p hclosed

def blockT (L : Int) (U : GaugeField R) : GaugeField R :=
  fun X d => qmul (U (dbl X) d) (U (wrap L (shift (dbl X) d 1)) d)

theorem wrap_dbl (M : Int) (X : Site) : wrap (2 * M) (dbl X) = dbl (wrap M X) := by
  funext i; simp only [wrap, dbl]; exact Int.mul_emod_mul_of_pos _ _ (by decide)

theorem block_lift (M : Int) (U : GaugeField R) : block (lift (2 * M) U) = lift M (blockT (2 * M) U) := by
  funext X d; simp only [block, lift, blockT]; rw [← wrap_dbl, wrap_shift_wrap]

theorem torus_hol_block (M : Int) (U : GaugeField R) (X : Site) (p : List Step) :
    holT M (blockT (2 * M) U) (wrap M X) p = holT (2 * M) U (wrap (2 * M) (dbl X)) (dblPath p) := by
  rw [holT_eq_hol_lift, ← block_lift, hol_block, holT_eq_hol_lift]

end Lattice

section Checkerboard

abbrev Coord := Nat × Nat × Nat × Nat

def coords (L s : Nat) : Coord := (s / L / L / L, s / L / L % L, s / L % L, s % L)
def siteOf (L : Nat) (x : Coord) : Nat := ((x.1 * L + x.2.1) * L + x.2.2.1) * L + x.2.2.2
def parSum (x : Coord) : Nat := x.1 + x.2.1 + x.2.2.1 + x.2.2.2
def parity (L s : Nat) : Nat := parSum (coords L s) % 2

theorem siteOf_coords (L s : Nat) : siteOf L (coords L s) = s := by
  simp only [siteOf, coords]
  rw [Nat.mul_comm (s / L / L / L) L, Nat.div_add_mod, Nat.mul_comm (s / L / L) L, Nat.div_add_mod,
    Nat.mul_comm (s / L) L, Nat.div_add_mod]

theorem div_mod_digit (a b L : Nat) (hL : 0 < L) (hb : b < L) : (a * L + b) / L = a ∧ (a * L + b) % L = b := by
  constructor
  · rw [Nat.add_comm, Nat.add_mul_div_right _ _ hL, Nat.div_eq_of_lt hb, Nat.zero_add]
  · rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hb]

theorem coords_siteOf (L : Nat) (hL : 0 < L) (x0 x1 x2 x3 : Nat) (h1 : x1 < L) (h2 : x2 < L) (h3 : x3 < L) :
    coords L (siteOf L (x0, x1, x2, x3)) = (x0, x1, x2, x3) := by
  simp only [coords, siteOf]
  obtain ⟨d3, m3⟩ := div_mod_digit ((x0 * L + x1) * L + x2) x3 L hL h3
  obtain ⟨d2, m2⟩ := div_mod_digit (x0 * L + x1) x2 L hL h2
  obtain ⟨d1, m1⟩ := div_mod_digit x0 x1 L hL h1
  rw [d3, m3, d2, m2, d1, m1]

theorem two_mul_xor_one (k : Nat) : (2 * k) ^^^ 1 = 2 * k + 1 := by
  apply Nat.eq_of_testBit_eq; intro i
  cases i with
  | zero => simp
  | succ i =>
    rw [Nat.testBit_xor, Nat.testBit_succ, Nat.testBit_succ, Nat.testBit_succ]
    have h1 : 2 * k / 2 = k := by omega
    have h2 : (2 * k + 1) / 2 = k := by omega
    simp [h1, h2]

def hbSite (L par i : Nat) : Nat :=
  if parSum (coords L (2 * i)) &&& 1 ≠ par then
    siteOf L ((coords L (2 * i)).1, (coords L (2 * i)).2.1, (coords L (2 * i)).2.2.1,
      (coords L (2 * i)).2.2.2 ^^^ 1)
  else siteOf L (coords L (2 * i))

theorem x3_even (L i : Nat) (hL : L % 2 = 0) : (2 * i) % L % 2 = 0 := by
  rw [Nat.mod_mod_of_dvd _ (Nat.dvd_of_mod_eq_zero hL)]; omega

theorem siteOf_succ (L : Nat) (x : Coord) :
    siteOf L (x.1, x.2.1, x.2.2.1, x.2.2.2 + 1) = siteOf L x + 1 := by
  simp only [siteOf]; omega

theorem coords_succ (L i : Nat) (hL : L % 2 = 0) (hL0 : 0 < L) :
    coords L (2 * i + 1) = ((coords L (2 * i)).1, (coords L (2 * i)).2.1, (coords L (2 * i)).2.2.1,
      (coords L (2 * i)).2.2.2 + 1) := by
  have e := x3_even L i hL
  have hlt : (2 * i) % L < L := Nat.mod_lt _ hL0
  have h3 : (coords L (2 * i)).2.2.2 + 1 < L := by simp only [coords]; omega
  have h1 : (coords L (2 * i)).2.1 < L := by simp only [coords]; exact Nat.mod_lt _ hL0
  have h2 : (coords L (2 * i)).2.2.1 < L := by simp only [coords]; exact Nat.mod_lt _ hL0
  have hs : 2 * i + 1 = siteOf L ((coords L (2 * i)).1, (coords L (2 * i)).2.1, (coords L (2 * i)).2.2.1,
      (coords L (2 * i)).2.2.2 + 1) := by rw [siteOf_succ, siteOf_coords]
  rw [hs, coords_siteOf L hL0 _ _ _ _ h1 h2 h3]

theorem parity_succ (L i : Nat) (hL : L % 2 = 0) (hL0 : 0 < L) :
    parity L (2 * i + 1) = (parity L (2 * i) + 1) % 2 := by
  simp only [parity]; rw [coords_succ L i hL hL0]; simp only [parSum]; omega

theorem hbSite_eq (L par i : Nat) (hL : L % 2 = 0) :
    hbSite L par i = if parity L (2 * i) = par then 2 * i else 2 * i + 1 := by
  have e : (coords L (2 * i)).2.2.2 % 2 = 0 := by simp only [coords]; exact x3_even L i hL
  have hx : (coords L (2 * i)).2.2.2 ^^^ 1 = (coords L (2 * i)).2.2.2 + 1 := by
    have : (coords L (2 * i)).2.2.2 = 2 * ((coords L (2 * i)).2.2.2 / 2) := by omega
    rw [this, two_mul_xor_one]
  unfold hbSite parity; rw [Nat.and_one_is_mod, hx, siteOf_succ, siteOf_coords]
  by_cases h : parSum (coords L (2 * i)) % 2 = par <;> simp [h]

theorem hbSite_parity (L par i : Nat) (hL : L % 2 = 0) (hL0 : 0 < L) (hpar : par < 2) :
    parity L (hbSite L par i) = par := by
  rw [hbSite_eq L par i hL]
  have hp : parity L (2 * i) < 2 := Nat.mod_lt _ (by decide)
  by_cases h : parity L (2 * i) = par
  · simp [h]
  · simp only [h, ↓reduceIte]; rw [parity_succ L i hL hL0]; omega

theorem hbSite_div_two (L par i : Nat) (hL : L % 2 = 0) : hbSite L par i / 2 = i := by
  rw [hbSite_eq L par i hL]; split <;> omega

theorem hbSite_injective (L par i j : Nat) (hL : L % 2 = 0) (h : hbSite L par i = hbSite L par j) : i = j := by
  rw [← hbSite_div_two L par i hL, ← hbSite_div_two L par j hL, h]

theorem hbSite_lt (L par i : Nat) (hL : L % 2 = 0) (hi : i < L ^ 4 / 2) : hbSite L par i < L ^ 4 := by
  have hev : L ^ 4 % 2 = 0 := by rw [Nat.pow_mod, hL]
  rw [hbSite_eq L par i hL]; split <;> omega

theorem hbSite_surjective (L par s : Nat) (hL : L % 2 = 0) (hL0 : 0 < L) (hs : s < L ^ 4)
    (hp : parity L s = par) : s / 2 < L ^ 4 / 2 ∧ hbSite L par (s / 2) = s := by
  have hev : L ^ 4 % 2 = 0 := by rw [Nat.pow_mod, hL]
  refine ⟨by omega, ?_⟩
  rw [hbSite_eq L par _ hL]
  rcases Nat.mod_two_eq_zero_or_one s with h0 | h1
  · have e : 2 * (s / 2) = s := by omega
    rw [e]; simp [hp]
  · have e : 2 * (s / 2) + 1 = s := by omega
    have hq : parity L (2 * (s / 2)) ≠ par := by
      intro hq; have := parity_succ L (s / 2) hL hL0; rw [e, hp, hq] at this; omega
    simp only [hq, ↓reduceIte]; exact e

abbrev Link := Coord × Fin 4

def tget (x : Coord) (d : Fin 4) : Nat :=
  match d with | 0 => x.1 | 1 => x.2.1 | 2 => x.2.2.1 | 3 => x.2.2.2
def tset (x : Coord) (d : Fin 4) (c : Nat) : Coord :=
  match d with
  | 0 => (c, x.2.1, x.2.2.1, x.2.2.2)
  | 1 => (x.1, c, x.2.2.1, x.2.2.2)
  | 2 => (x.1, x.2.1, c, x.2.2.2)
  | 3 => (x.1, x.2.1, x.2.2.1, c)
def nbT (L : Nat) (x : Coord) (d : Fin 4) : Bool → Coord
  | true => tset x d ((tget x d + 1 + L) % L)
  | false => tset x d ((tget x d + L - 1) % L)
def valid (L : Nat) (x : Coord) : Prop := x.1 < L ∧ x.2.1 < L ∧ x.2.2.1 < L ∧ x.2.2.2 < L

theorem fwd_mod_parity (L c : Nat) (hL : L % 2 = 0) (hc : c < L) : (c + 1 + L) % L % 2 = (c + 1) % 2 := by
  rw [Nat.add_mod_right]
  rcases Nat.lt_or_ge (c + 1) L with h | h
  · rw [Nat.mod_eq_of_lt h]
  · have : c + 1 = L := by omega
    rw [this, Nat.mod_self]; omega

theorem bwd_mod_parity (L c : Nat) (hL : L % 2 = 0) (hL0 : 0 < L) (hc : c < L) :
    (c + L - 1) % L % 2 = (c + 1) % 2 := by
  rcases Nat.eq_zero_or_pos c with h | h
  · subst h; rw [Nat.zero_add, Nat.mod_eq_of_lt (show L - 1 < L by omega)]; omega
  · have : c + L - 1 = (c - 1) + L := by omega
    rw [this, Nat.add_mod_right, Nat.mod_eq_of_lt (show c - 1 < L by omega)]; omega

theorem nbT_parity (L : Nat) (hL : L % 2 = 0) (hL0 : 0 < L) (x : Coord) (hx : valid L x) (d : Fin 4)
    (b : Bool) : parSum (nbT L x d b) % 2 = (parSum x + 1) % 2 := by
  obtain ⟨x0, x1, x2, x3⟩ := x
  obtain ⟨h0, h1, h2, h3⟩ := hx
  match d, b with
  | 0, true => have := fwd_mod_parity L x0 hL h0; simp only [nbT, tget, tset, parSum] at *; omega
  | 1, true => have := fwd_mod_parity L x1 hL h1; simp only [nbT, tget, tset, parSum] at *; omega
  | 2, true => have := fwd_mod_parity L x2 hL h2; simp only [nbT, tget, tset, parSum] at *; omega
  | 3, true => have := fwd_mod_parity L x3 hL h3; simp only [nbT, tget, tset, parSum] at *; omega
  | 0, false => have := bwd_mod_parity L x0 hL hL0 h0; simp only [nbT, tget, tset, parSum] at *; omega
  | 1, false => have := bwd_mod_parity L x1 hL hL0 h1; simp only [nbT, tget, tset, parSum] at *; omega
  | 2, false => have := bwd_mod_parity L x2 hL hL0 h2; simp only [nbT, tget, tset, parSum] at *; omega
  | 3, false => have := bwd_mod_parity L x3 hL hL0 h3; simp only [nbT, tget, tset, parSum] at *; omega

def stapleReads (L : Nat) (x : Coord) (mu : Fin 4) : List Link :=
  ((List.finRange 4).filter (· ≠ mu)).flatMap fun nu =>
    [(nbT L x mu true, nu), (nbT L x nu true, mu), (x, nu),
     (nbT L (nbT L x mu true) nu false, nu), (nbT L x nu false, mu), (nbT L x nu false, nu)]

theorem stapleReads_parity (L : Nat) (hL : L % 2 = 0) (hL0 : 0 < L) (x : Coord) (mu : Fin 4)
    (hx : valid L x) (r : Link) (hr : r ∈ stapleReads L x mu) (hdir : r.2 = mu) :
    parSum r.1 % 2 ≠ parSum x % 2 := by
  simp only [stapleReads, List.mem_flatMap, List.mem_filter, List.mem_cons, List.not_mem_nil, or_false] at hr
  obtain ⟨nu, ⟨_, hne⟩, hr⟩ := hr
  have hne' : nu ≠ mu := by simpa using hne
  rcases hr with rfl | rfl | rfl | rfl | rfl | rfl
  · exact absurd hdir hne'
  · have := nbT_parity L hL hL0 x hx nu true; dsimp only; omega
  · exact absurd hdir hne'
  · exact absurd hdir hne'
  · have := nbT_parity L hL hL0 x hx nu false; dsimp only; omega
  · exact absurd hdir hne'

def upd {α : Type u} {β : Type v} [DecidableEq α] (C : α → β) (a : α) (b : β) : α → β :=
  fun a' => if a' = a then b else C a'

theorem sequential_eq_parallel_aux {L : Type u} {α : Type v} [DecidableEq L] (W0 : List L)
    (reads : L → List L) (f : L → (L → α) → α)
    (hloc : ∀ l (C C' : L → α), (∀ r ∈ reads l, C r = C' r) → f l C = f l C')
    (hdisj : ∀ l ∈ W0, ∀ r ∈ reads l, r = l ∨ r ∉ W0) (C : L → α) :
    ∀ W : List L, W.Nodup → (∀ l ∈ W, l ∈ W0) → ∀ D : L → α, (∀ r, (r ∉ W0 ∨ r ∈ W) → D r = C r) →
      W.foldl (fun D l => upd D l (f l D)) D = fun l' => if l' ∈ W then f l' C else D l' := by
  intro W
  induction W with
  | nil => intro _ _ D _; funext l'; simp
  | cons l W ih =>
    intro hnd hsub D hD
    rw [List.nodup_cons] at hnd
    have hl0 : l ∈ W0 := hsub l (List.mem_cons_self ..)
    have hfl : f l D = f l C := hloc l D C (fun r hr => by
      rcases hdisj l hl0 r hr with h | h
      · exact hD r (Or.inr (h ▸ List.mem_cons_self ..))
      · exact hD r (Or.inl h))
    simp only [List.foldl]
    rw [hfl, ih hnd.2 (fun l' h => hsub l' (List.mem_cons_of_mem _ h)) (upd D l (f l C)) ?_]
    · funext l'
      by_cases h1 : l' ∈ W
      · simp [h1]
      · by_cases h2 : l' = l
        · subst h2; simp [upd]
        · simp [upd, h1, h2]
    · intro r hr
      have hrl : r ≠ l := by
        rcases hr with h | h
        · exact fun e => h (e ▸ hl0)
        · exact fun e => hnd.1 (e ▸ h)
      simp only [upd, hrl, ↓reduceIte]
      rcases hr with h | h
      · exact hD r (Or.inl h)
      · exact hD r (Or.inr (List.mem_cons_of_mem _ h))

theorem sequential_eq_parallel {L : Type u} {α : Type v} [DecidableEq L] (W0 : List L) (hnd : W0.Nodup)
    (reads : L → List L) (f : L → (L → α) → α)
    (hloc : ∀ l (C C' : L → α), (∀ r ∈ reads l, C r = C' r) → f l C = f l C')
    (hdisj : ∀ l ∈ W0, ∀ r ∈ reads l, r = l ∨ r ∉ W0) (C : L → α) :
    W0.foldl (fun D l => upd D l (f l D)) C = fun l' => if l' ∈ W0 then f l' C else C l' :=
  sequential_eq_parallel_aux W0 reads f hloc hdisj C W0 hnd (fun _ h => h) C (fun _ _ => rfl)

theorem checkerboard_pass_order_independent {α : Type v} (L : Nat) (hL : L % 2 = 0) (hL0 : 0 < L)
    (mu : Fin 4) (par : Nat) (W0 : List Link) (hnd : W0.Nodup)
    (hW : ∀ l ∈ W0, l.2 = mu ∧ valid L l.1 ∧ parSum l.1 % 2 = par)
    (selfRead : Bool) (f : Link → (Link → α) → α)
    (hloc : ∀ l (C C' : Link → α),
      (∀ r ∈ (if selfRead then [l] else []) ++ stapleReads L l.1 l.2, C r = C' r) → f l C = f l C')
    (C : Link → α) :
    W0.foldl (fun D l => upd D l (f l D)) C = fun l' => if l' ∈ W0 then f l' C else C l' := by
  refine (sequential_eq_parallel W0 hnd _ f hloc ?_ C).trans (by congr!)
  intro l hl r hr
  obtain ⟨hmu, hv, hp⟩ := hW l hl
  rw [List.mem_append] at hr
  rcases hr with hr | hr
  · left; cases selfRead <;> simp at hr; exact hr
  · right; intro hrW
    obtain ⟨hmu', _, hp'⟩ := hW r hrW
    have := stapleReads_parity L hL hL0 l.1 l.2 hv r hr (by rw [hmu', hmu])
    omega

end Checkerboard

abbrev P4 := Int × Int × Int × Int

def P4.bump (p : P4) (d : Nat) (s : Int) : P4 :=
  match d with
  | 0 => (p.1 + s, p.2)
  | 1 => (p.1, p.2.1 + s, p.2.2)
  | 2 => (p.1, p.2.1, p.2.2.1 + s, p.2.2.2)
  | _ => (p.1, p.2.1, p.2.2.1, p.2.2.2 + s)
def P4.l1 (p : P4) : Int := p.1.natAbs + p.2.1.natAbs + p.2.2.1.natAbs + p.2.2.2.natAbs
def P4.move (p : P4) (s : Nat) : P4 := p.bump (s % 4) (if s < 4 then 1 else -1)
def origin : P4 := (0, 0, 0, 0)

def pathsFrom : Nat → List Nat → P4 → List P4 → List (List Nat)
  | 0, path, pos, _ => if pos = origin then [path.reverse] else []
  | k + 1, path, pos, vis => (List.range 8).flatMap fun s =>
      if pos.move s = origin then (if k = 0 then pathsFrom 0 (s :: path) (pos.move s) vis else [])
      else if pos.move s ∈ vis ∨ (pos.move s).l1 > k then []
      else pathsFrom k (s :: path) (pos.move s) (pos.move s :: vis)

def closedPaths (mu n : Nat) : List (List Nat) :=
  pathsFrom (n - 1) [mu] (origin.bump mu 1) [origin.bump mu 1]

inductive Shape | plaq | rect | chair | twist
  deriving DecidableEq, Repr

def classify (p : List Nat) : Option Shape :=
  let ax := p.map (· % 4)
  let used := ax.eraseDups
  if p.length = 4 then some .plaq
  else if p.length = 6 then
    if used.length = 2 then some .rect
    else if (used.map fun a => (List.range ax.length).filter fun i => ax[i]! = a).all
        (fun v => v.length = 2 && v[1]! - v[0]! = 3) then some .twist
    else some .chair
  else none

def Shape.len : Shape → Nat | .plaq => 4 | _ => 6
def allShapes : List Shape := [.plaq, .rect, .chair, .twist]

def shapePaths (s : Shape) (mu : Nat) : List (List Nat) :=
  (closedPaths mu s.len).filter (classify · = some s)

def disp : List Step → Fin 4 → Int
  | [] => fun _ => 0
  | .fwd d :: p => fun i => (if i = d then 1 else 0) + disp p i
  | .bwd d :: p => fun i => (if i = d then -1 else 0) + disp p i

theorem walk_eq_disp (p : List Step) : ∀ x, walk x p = fun i => x i + disp p i := by
  induction p with
  | nil => intro x; funext i; simp [walk, disp]
  | cons s p ih =>
    intro x; cases s with
    | fwd d => funext i; simp only [walk, disp]; rw [ih]; simp only [shift]; split <;> omega
    | bwd d => funext i; simp only [walk, disp]; rw [ih]; simp only [shift]; split <;> omega

set_option maxRecDepth 100000

theorem plaq_table : ∀ mu : Fin 4,
    (shapePaths .plaq mu.val).map (fun p => (decode p).tail)
      = ((List.finRange 4).filter (· ≠ mu)).map (fun nu => [.fwd nu, .bwd mu, .bwd nu])
        ++ ((List.finRange 4).filter (· ≠ mu)).map (fun nu => [.bwd nu, .bwd mu, .fwd nu]) := by
  decide +kernel

theorem pathsFrom_eq_rec (n : Nat) (path : List Nat) (pos : P4) (vis : List P4) :
    pathsFrom n path pos vis =
      Nat.rec (motive := fun _ => List Nat → P4 → List P4 → List (List Nat))
        (fun path pos _ => if pos = origin then [path.reverse] else [])
        (fun k ih path pos vis => (List.range 8).flatMap fun s =>
          if pos.move s = origin then
            (if k = 0 then (if pos.move s = origin then [(s :: path).reverse] else []) else [])
          else if pos.move s ∈ vis ∨ (pos.move s).l1 > k then []
          else ih (s :: path) (pos.move s) (pos.move s :: vis))
        n path pos vis := by
  induction n generalizing path pos vis with
  | zero => rw [pathsFrom.eq_1]; rfl
  | succ k ih =>
    rw [pathsFrom.eq_2]
    simp only [ih, pathsFrom.eq_1]

theorem loops_per_link : ∀ mu : Fin 4,
    (shapePaths .plaq mu).length = 6 ∧ (shapePaths .rect mu).length = 18
    ∧ (shapePaths .chair mu).length = 72 ∧ (shapePaths .twist mu).length = 24 := by
  simp only [shapePaths, closedPaths, pathsFrom_eq_rec]
  intro mu
  fin_cases mu <;> decide +kernel

theorem tpsc_pathsFrom_spec : ∀ (k : Nat) (path : List Nat) (pos : P4) (vis : List P4) (q : List Nat),
    q ∈ pathsFrom k path pos vis →
      ∃ ext : List Nat, q = path.reverse ++ ext ∧ (∀ t ∈ ext, t < 8) ∧ ext.foldl P4.move pos = origin := by
  intro k
  induction k with
  | zero =>
    intro path pos vis q hq
    simp only [pathsFrom] at hq
    split at hq
    · rename_i hpos
      simp only [List.mem_singleton] at hq
      exact ⟨[], by simp [hq], by simp, by simpa using hpos⟩
    · simp at hq
  | succ k ih =>
    intro path pos vis q hq
    rw [pathsFrom] at hq
    simp only [List.mem_flatMap, List.mem_range] at hq
    obtain ⟨s, hs, hq⟩ := hq
    split at hq
    · split at hq
      · rename_i hk
        subst hk
        obtain ⟨ext, rfl, hlt, hf⟩ := ih _ _ _ _ hq
        exact ⟨s :: ext, by simp, List.forall_mem_cons.2 ⟨hs, hlt⟩, by simpa using hf⟩
      · simp at hq
    · split at hq
      · simp at hq
      · obtain ⟨ext, rfl, hlt, hf⟩ := ih _ _ _ _ hq
        exact ⟨s :: ext, by simp, List.forall_mem_cons.2 ⟨hs, hlt⟩, by simpa using hf⟩

theorem tpsc_foldl_move : ∀ (ext : List Nat) (pos : P4), (∀ t ∈ ext, t < 8) →
    ext.foldl P4.move pos = (pos.1 + disp (decode ext) 0, pos.2.1 + disp (decode ext) 1,
      pos.2.2.1 + disp (decode ext) 2, pos.2.2.2 + disp (decode ext) 3) := by
  intro ext
  induction ext with
  | nil => intro pos _; simp [decode, disp]
  | cons s ext ih =>
    intro pos h
    have hs : s < 8 := h s (by simp)
    rw [List.foldl_cons, ih _ (fun t ht => h t (by simp [ht]))]
    obtain ⟨a, b, c, d⟩ := pos
    interval_cases s <;> simp [P4.move, P4.bump, decode, disp, Step.ofCode] <;> omega

theorem table_paths_start_and_close : ∀ mu : Fin 4, ∀ s ∈ allShapes,
    (shapePaths s mu).all (fun p => p.head? = some mu.val ∧ ∀ i : Fin 4, disp (decode p) i = 0) := by
  intro mu s _
  rw [List.all_eq_true]
  intro p hp
  rw [shapePaths, List.mem_filter] at hp
  have hp1 := hp.1
  unfold closedPaths at hp1
  obtain ⟨ext, hpe, hlt, hf⟩ := tpsc_pathsFrom_spec _ _ _ _ _ hp1
  have hpe' : p = mu.val :: ext := by simpa using hpe
  subst hpe'
  apply decide_eq_true
  have hmu := mu.isLt
  have hall : ∀ t ∈ (mu.val :: ext), t < 8 :=
    List.forall_mem_cons.2 ⟨by omega, hlt⟩
  have key := tpsc_foldl_move (mu.val :: ext) origin hall
  have h0 : (mu.val :: ext).foldl P4.move origin = origin := by
    rw [List.foldl_cons]
    have hm : origin.move mu.val = origin.bump mu.val 1 := by
      simp [P4.move, Nat.mod_eq_of_lt hmu, hmu]
    rw [hm]; exact hf
  rw [h0] at key
  simp only [origin, Prod.mk.injEq, zero_add] at key
  obtain ⟨k0, k1, k2, k3⟩ := key
  refine ⟨by simp, ?_⟩
  intro i
  fin_cases i
  · exact k0.symm
  · exact k1.symm
  · exact k2.symm
  · exact k3.symm

theorem table_loops_gauge_invariant {R : Type u} [Lean.Grind.CommRing R] (s : Shape) (mu : Fin 4)
    (p : List Nat) (hp : p ∈ shapePaths s mu) (g : Site → Q R) (hg : ∀ y, SU2 (g y)) (U : GaugeField R)
    (x : Site) : (holLoop (gauge g U) x (decode p)).w = (holLoop U x (decode p)).w := by
  have h := table_paths_start_and_close mu s (by cases s <;> simp [allShapes])
  rw [List.all_eq_true] at h
  have hc := (of_decide_eq_true (h p hp)).2
  rw [holLoop_eq_hol, holLoop_eq_hol]
  apply wilson_loop_gauge_invariant g hg
  rw [walk_eq_disp]; funext i; rw [hc i]; omega

def loopStaple {R : Type u} [Lean.Grind.CommRing R] (U : GaugeField R) (x : Site) (mu : Fin 4)
    (ps : List (List Nat)) : Q R :=
  ps.foldl (fun T p => qadd T (holLoop U (shift x mu 1) (decode p).tail)) qzero

theorem foldl_qadd_shift {R : Type u} [Lean.Grind.CommRing R] {β : Type v} (F : β → Q R) (l : List β) :
    ∀ S0 : Q R, l.foldl (fun S b => qadd S (F b)) S0 = qadd S0 (l.foldl (fun S b => qadd S (F b)) qzero) := by
  induction l with
  | nil => intro S0; simp [qadd_qzero]
  | cons b l ih => intro S0; simp only [List.foldl]; rw [ih, ih (qadd qzero (F b)), qzero_qadd, qadd_assoc]

theorem foldl_qadd2 {R : Type u} [Lean.Grind.CommRing R] {β : Type v} (A B : β → Q R) (l : List β) :
    ∀ S0 : Q R, l.foldl (fun S b => qadd (qadd S (A b)) (B b)) S0
      = l.foldl (fun S b => qadd S (B b)) (l.foldl (fun S b => qadd S (A b)) S0) := by
  induction l with
  | nil => intro S0; rfl
  | cons b l ih =>
    intro S0; simp only [List.foldl]; rw [ih]
    rw [foldl_qadd_shift A l (qadd (qadd S0 (A b)) (B b)), foldl_qadd_shift A l (qadd S0 (A b)),
      foldl_qadd_shift B l (qadd (qadd (qadd S0 (A b)) (B b)) (l.foldl (fun S b => qadd S (A b)) qzero)),
      foldl_qadd_shift B l (qadd (qadd (qadd S0 (A b)) (l.foldl (fun S b => qadd S (A b)) qzero)) (B b))]
    qring

theorem loopStaple_plaq_eq_staplePlaq {R : Type u} [Lean.Grind.CommRing R] (U : GaugeField R) (x : Site)
    (mu : Fin 4) : loopStaple U x mu (shapePaths .plaq mu.val) = staplePlaq U x mu := by
  have hmap : ∀ l : List (List Nat),
      l.foldl (fun T p => qadd T (hol U (shift x mu 1) (decode p).tail)) qzero
        = (l.map (fun p => (decode p).tail)).foldl (fun T q => qadd T (hol U (shift x mu 1) q)) qzero :=
    fun l => by rw [List.foldl_map]
  unfold loopStaple staplePlaq
  simp only [holLoop_eq_hol]
  rw [hmap, plaq_table mu, List.foldl_append, List.foldl_map, List.foldl_map, foldl_qadd2]
  simp only [stapleA_hol, stapleB_hol]

def sigmaTable : List Nat := [0, 0, 2, 3, 3, 1, 2, 1, 1, 2, 1, 3, 3, 2, 0, 0]
def sigma (y : P4) : Nat :=
  sigmaTable[(y.1 % 2).toNat + 2 * (y.2.1 % 2).toNat + 4 * (y.2.2.1 % 2).toNat + 8 * (y.2.2.2 % 2).toNat]!
def forest (y : P4) (d : Nat) : Bool := sigma y == d

def pathLinks (r : P4) (p : List Nat) : List (P4 × Nat) :=
  (p.foldl (fun (acc : P4 × List (P4 × Nat)) st =>
     if st < 4 then (acc.1.bump (st % 4) 1, acc.2 ++ [(acc.1, st % 4)])
     else (acc.1.bump (st % 4) (-1), acc.2 ++ [(acc.1.bump (st % 4) (-1), st % 4)])) (r, [])).2

def parityClasses : List P4 :=
  [0, 1].flatMap fun a => [0, 1].flatMap fun b => [0, 1].flatMap fun c => [0, 1].map fun e => (a, b, c, e)

def forestCount (s : Shape) (r : P4) (mu : Nat) : Nat :=
  (shapePaths s mu).foldl (fun acc p =>
    acc + (((pathLinks r p).drop 1).eraseDups.filter (fun l => !forest l.1 l.2)).length) 0

def activeCounts (s : Shape) : List Nat :=
  parityClasses.flatMap fun r =>
    (List.range 4).filterMap fun mu => if forest r mu then none else some (forestCount s r mu)

theorem forest_counts_uniform :
    (activeCounts .plaq).all (· = 12) ∧ (activeCounts .rect).all (· = 66)
    ∧ (activeCounts .chair).all (· = 264) ∧ (activeCounts .twist).all (· = 88) := by
  decide +kernel

theorem forestDefault_foldl_max_le {c : Nat} : ∀ (l : List Nat) (b : Nat),
    (∀ x ∈ l, x ≤ c) → b ≤ c → l.foldl max b ≤ c
  | [], _, _, hb => hb
  | x :: t, b, h, hb => forestDefault_foldl_max_le t (max b x)
      (fun y hy => h y (List.mem_cons.mpr (Or.inr hy))) (Nat.max_le.mpr ⟨hb, h x (List.mem_cons.mpr (Or.inl rfl))⟩)

theorem forestDefault_le_foldl_max_init : ∀ (l : List Nat) (b : Nat), b ≤ l.foldl max b
  | [], _ => Nat.le_refl _
  | x :: t, b => Nat.le_trans (Nat.le_max_left b x) (forestDefault_le_foldl_max_init t (max b x))

theorem forestDefault_le_foldl_max : ∀ (l : List Nat) (b y : Nat), y ∈ l → y ≤ l.foldl max b
  | [], _, _, hy => absurd hy List.not_mem_nil
  | x :: t, b, y, hy => by
    rcases List.mem_cons.mp hy with rfl | hy
    · exact Nat.le_trans (Nat.le_max_right b y) (forestDefault_le_foldl_max_init t (max b y))
    · exact forestDefault_le_foldl_max t (max b x) y hy

theorem forestDefault_of_mu (s : Shape) (c : Nat)
    (h0 : ∀ r ∈ parityClasses, forest r 0 = false → forestCount s r 0 = c)
    (h1 : ∀ r ∈ parityClasses, forest r 1 = false → forestCount s r 1 = c)
    (h2 : ∀ r ∈ parityClasses, forest r 2 = false → forestCount s r 2 = c)
    (h3 : ∀ r ∈ parityClasses, forest r 3 = false → forestCount s r 3 = c) :
    (activeCounts s).foldl max 0 = c := by
  have hall : ∀ x ∈ activeCounts s, x = c := by
    intro x hx
    simp only [activeCounts, List.mem_flatMap, List.mem_filterMap, List.mem_range] at hx
    obtain ⟨r, hr, mu, hmu, hx⟩ := hx
    split at hx
    · cases hx
    · rename_i hf
      cases hx
      have key : ∀ mu, mu < 4 → forest r mu = false → forestCount s r mu = c := by
        intro mu hmu
        match mu, hmu with
        | 0, _ => exact h0 r hr
        | 1, _ => exact h1 r hr
        | 2, _ => exact h2 r hr
        | 3, _ => exact h3 r hr
        | n + 4, h => exact absurd h (by omega)
      exact key mu hmu (by simpa using hf)
  have hmem : forestCount s (0, 0, 0, 0) 1 ∈ activeCounts s := by
    simp only [activeCounts, List.mem_flatMap, List.mem_filterMap, List.mem_range]
    exact ⟨(0, 0, 0, 0), by decide, 1, by decide, by rw [if_neg (by decide)]⟩
  have hc := hall _ hmem
  apply Nat.le_antisymm
  · exact forestDefault_foldl_max_le _ 0 (fun x hx => Nat.le_of_eq (hall x hx)) (Nat.zero_le c)
  · exact hc ▸ forestDefault_le_foldl_max _ 0 _ hmem

