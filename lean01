section Part02_WilsonAction

/-!
# Bounds on the Wilson action and the volume obstruction

For a unitary `N × N` matrix `U`, `|Re tr U| ≤ N`. Hence the Wilson plaquette
term `N - Re tr U_P` lies in `[0, 2N]`, the total action over a finite set `P`
of plaquettes lies in `[0, 2N |P|]`, and its oscillation is at most `2N |P|`.
The Holley–Stroock factor `exp (-(β · osc S))` therefore tends to `0` as the
number of plaquettes grows, at every fixed `β > 0`.

The plaquette holonomies are an arbitrary map `hol : P → Ω → U(N)` from
configurations to unitary matrices; any product of link variables around a
plaquette is of this form, since the unitary group is closed under products.
-/

open Matrix Filter Topology Real

namespace YangMills

variable {N : ℕ}

theorem norm_trace_le_of_unitary {U : Matrix (Fin N) (Fin N) ℂ}
    (hU : U ∈ Matrix.unitaryGroup (Fin N) ℂ) : ‖U.trace‖ ≤ N := by
  unfold Matrix.trace
  calc ‖∑ i, U.diag i‖ ≤ ∑ i, ‖U.diag i‖ := norm_sum_le _ _
    _ ≤ ∑ _i : Fin N, (1 : ℝ) :=
        Finset.sum_le_sum fun i _ => entry_norm_bound_of_unitary hU i i
    _ = N := by simp

theorem abs_re_trace_le_of_unitary {U : Matrix (Fin N) (Fin N) ℂ}
    (hU : U ∈ Matrix.unitaryGroup (Fin N) ℂ) : |U.trace.re| ≤ N :=
  (Complex.abs_re_le_norm _).trans (norm_trace_le_of_unitary hU)

/-- The Wilson plaquette term `N - Re tr U`. -/
noncomputable def plaquetteTerm (U : Matrix (Fin N) (Fin N) ℂ) : ℝ := N - U.trace.re

theorem plaquetteTerm_nonneg {U : Matrix (Fin N) (Fin N) ℂ}
    (hU : U ∈ Matrix.unitaryGroup (Fin N) ℂ) : 0 ≤ plaquetteTerm U := by
  have := abs_re_trace_le_of_unitary hU
  unfold plaquetteTerm; linarith [le_abs_self U.trace.re]

theorem plaquetteTerm_le {U : Matrix (Fin N) (Fin N) ℂ}
    (hU : U ∈ Matrix.unitaryGroup (Fin N) ℂ) : plaquetteTerm U ≤ 2 * N := by
  have := abs_re_trace_le_of_unitary hU
  unfold plaquetteTerm; linarith [neg_abs_le U.trace.re]

variable {Ω P : Type*} [Fintype P]

/-- The Wilson action `S(ω) = Σ_P (N - Re tr U_P(ω))`. -/
noncomputable def wilsonAction (hol : P → Ω → Matrix (Fin N) (Fin N) ℂ) (ω : Ω) : ℝ :=
  ∑ p, plaquetteTerm (hol p ω)

theorem wilsonAction_nonneg {hol : P → Ω → Matrix (Fin N) (Fin N) ℂ}
    (hU : ∀ p ω, hol p ω ∈ Matrix.unitaryGroup (Fin N) ℂ) (ω : Ω) :
    0 ≤ wilsonAction hol ω :=
  Finset.sum_nonneg fun p _ => plaquetteTerm_nonneg (hU p ω)

theorem wilsonAction_le {hol : P → Ω → Matrix (Fin N) (Fin N) ℂ}
    (hU : ∀ p ω, hol p ω ∈ Matrix.unitaryGroup (Fin N) ℂ) (ω : Ω) :
    wilsonAction hol ω ≤ 2 * N * Fintype.card P := by
  unfold wilsonAction
  calc ∑ p, plaquetteTerm (hol p ω) ≤ ∑ _p : P, (2 * N : ℝ) :=
        Finset.sum_le_sum fun p _ => plaquetteTerm_le (hU p ω)
    _ = 2 * N * Fintype.card P := by simp [mul_comm]

/-- The oscillation of `β S` is at most `2 N β |P|`. -/
theorem wilsonAction_osc_le {hol : P → Ω → Matrix (Fin N) (Fin N) ℂ}
    (hU : ∀ p ω, hol p ω ∈ Matrix.unitaryGroup (Fin N) ℂ) {β : ℝ} (hβ : 0 ≤ β)
    (ω ω' : Ω) :
    β * wilsonAction hol ω - β * wilsonAction hol ω' ≤ 2 * N * β * Fintype.card P := by
  have h1 := wilsonAction_le hU ω
  have h2 := wilsonAction_nonneg hU ω'
  have : β * wilsonAction hol ω ≤ β * (2 * N * Fintype.card P) :=
    mul_le_mul_of_nonneg_left h1 hβ
  nlinarith

/-- **Volume obstruction.** The Holley–Stroock factor obtained by perturbing the
product Haar measure by the full Wilson weight vanishes as the number of
plaquettes `m` tends to infinity, at every fixed `β > 0` and `N ≥ 1`. -/
theorem holleyStroock_factor_tendsto_zero {β : ℝ} (hβ : 0 < β) (hN : 1 ≤ N) :
    Tendsto (fun m : ℕ => Real.exp (-(2 * N * β * m))) atTop (𝓝 0) := by
  have hc : 0 < 2 * (N : ℝ) * β := by
    have : (1 : ℝ) ≤ N := by exact_mod_cast hN
    positivity
  have h1 : Tendsto (fun m : ℕ => 2 * (N : ℝ) * β * m) atTop atTop :=
    tendsto_natCast_atTop_atTop.const_mul_atTop hc
  exact Real.tendsto_exp_neg_atTop_nhds_zero.comp h1

/-! ### Plaquette variables are not independent in dimension three or more

On a unit cube with abelian link variables `θ_e` (the maximal torus, or the
gauge group `U(1)`), the six oriented plaquette angles sum to zero identically.
So the plaquette variables of a lattice of dimension `d ≥ 3` satisfy exact
linear relations and cannot be independent under the product Haar measure on
links. The labels are: edges along `x` at heights `(y,z)`, along `y` at
`(x,z)`, along `z` at `(x,y)`, each coordinate in `{0,1}`. -/

/-- The oriented plaquette angle `θ₁ + θ₂ - θ₃ - θ₄`. -/
def plaq {G : Type*} [AddCommGroup G] (θ₁ θ₂ θ₃ θ₄ : G) : G := θ₁ + θ₂ - θ₃ - θ₄

theorem cube_bianchi {G : Type*} [AddCommGroup G]
    (x y z : Fin 2 → Fin 2 → G) :
    -- faces z = 0 and z = 1 (normal z)
    plaq (x 0 0) (y 1 0) (x 1 0) (y 0 0) - plaq (x 0 1) (y 1 1) (x 1 1) (y 0 1)
    -- faces y = 0 and y = 1 (normal y)
    - plaq (x 0 0) (z 1 0) (x 0 1) (z 0 0) + plaq (x 1 0) (z 1 1) (x 1 1) (z 0 1)
    -- faces x = 0 and x = 1 (normal x)
    + plaq (y 0 0) (z 0 1) (y 0 1) (z 0 0) - plaq (y 1 0) (z 1 1) (y 1 1) (z 1 0)
    = 0 := by
  unfold plaq; abel

end YangMills

end Part02_WilsonAction

section Part03_RunningCoupling

/-!
# One-loop running coupling: the intermediate-coupling window is always entered

With `b₀ = 11 N / (48 π²)`, the one-loop solution of `μ dg/dμ = -b₀ g³` is
`g²(μ) = 1 / (2 b₀ log (μ / Λ))` for `μ > Λ`. It tends to `0` as `μ → ∞`
(asymptotic freedom) and to `+∞` as `μ → Λ⁺`, and it takes every value
`g_*² > 0` at the scale `μ_* = Λ exp (1 / (2 b₀ g_*²))`, which does not depend
on the lattice spacing. Hence along any continuum trajectory with
`β(a) = 2N / g²(1/a)`, the effective coupling at the fixed physical scale
`μ_*` equals `g_*²` for every spacing `a < 1/μ_*`: the bare coupling leaves
the intermediate window, but the effective coupling on physical scales does
not.
-/

open Real Filter Topology

namespace YangMills

/-- The one-loop coefficient `b₀ = 11 N / (48 π²)`. -/
noncomputable def b0 (N : ℕ) : ℝ := 11 * N / (48 * π ^ 2)

theorem b0_pos {N : ℕ} (hN : 1 ≤ N) : 0 < b0 N := by
  unfold b0
  have : (1 : ℝ) ≤ N := by exact_mod_cast hN
  positivity

/-- One-loop running coupling `g²(μ)`. -/
noncomputable def gsq (N : ℕ) (Λ μ : ℝ) : ℝ := 1 / (2 * b0 N * Real.log (μ / Λ))

/-- The scale at which the coupling equals `g`. -/
noncomputable def scaleOf (N : ℕ) (Λ g : ℝ) : ℝ := Λ * Real.exp (1 / (2 * b0 N * g))

theorem scaleOf_gt {N : ℕ} (hN : 1 ≤ N) {Λ g : ℝ} (hΛ : 0 < Λ) (hg : 0 < g) :
    Λ < scaleOf N Λ g := by
  unfold scaleOf
  have : 0 < 1 / (2 * b0 N * g) := by have := b0_pos hN; positivity
  have h1 : 1 < Real.exp (1 / (2 * b0 N * g)) := Real.one_lt_exp_iff.mpr this
  nlinarith

/-- **Every coupling is attained.** -/
theorem gsq_scaleOf {N : ℕ} (hN : 1 ≤ N) {Λ g : ℝ} (hΛ : 0 < Λ) (hg : 0 < g) :
    gsq N Λ (scaleOf N Λ g) = g := by
  have hb := b0_pos hN
  unfold gsq scaleOf
  rw [mul_div_cancel_left₀ _ hΛ.ne', Real.log_exp]
  field_simp

/-- **Asymptotic freedom.** -/
theorem gsq_tendsto_zero {N : ℕ} (hN : 1 ≤ N) {Λ : ℝ} (hΛ : 0 < Λ) :
    Tendsto (gsq N Λ) atTop (𝓝 0) := by
  have hb := b0_pos hN
  have h1 : Tendsto (fun μ : ℝ => μ / Λ) atTop atTop :=
    tendsto_id.atTop_div_const hΛ
  have h2 : Tendsto (fun μ : ℝ => 2 * b0 N * Real.log (μ / Λ)) atTop atTop :=
    (Real.tendsto_log_atTop.comp h1).const_mul_atTop (by positivity)
  have h3 := h2.inv_tendsto_atTop
  refine h3.congr fun μ => ?_
  simp [gsq]

/-- The coupling at the spacing-independent scale `μ_*` equals `g` for every
lattice spacing `a < 1/μ_*`, and that scale lies strictly between `Λ` and the
cutoff `1/a`. -/
theorem window_entered {N : ℕ} (hN : 1 ≤ N) {Λ g : ℝ} (hΛ : 0 < Λ) (hg : 0 < g)
    {a : ℝ} (ha : 0 < a) (hsmall : a < 1 / scaleOf N Λ g) :
    Λ < scaleOf N Λ g ∧ scaleOf N Λ g < 1 / a ∧ gsq N Λ (scaleOf N Λ g) = g := by
  have hs := scaleOf_gt hN hΛ hg
  have hspos : 0 < scaleOf N Λ g := hΛ.trans hs
  refine ⟨hs, ?_, gsq_scaleOf hN hΛ hg⟩
  rw [lt_div_iff₀ ha]
  rw [lt_div_iff₀ hspos] at hsmall
  linarith

end YangMills

end Part03_RunningCoupling

section Part04_SpectralNoGo

/-!
# The spacing-uniform gap no-go theorem

Reflection positivity gives, for a gauge-invariant observable localised in a
time slice, the spectral representation of its truncated temporal two-point
function in lattice units,
`S_a(t) = ∫ exp (-(E t / a)) dρ_a(E)`,
with `ρ_a` a finite positive measure on the spectrum of `-log T_a` above the
vacuum. A lattice gap `δ` uniform in the spacing means `ρ_a (Iio δ) = 0` for
every `a`.

This file proves, for arbitrary positive renormalisations `Z_a`:

* `twoPoint_ratio_le` : `S_a(t₂) ≤ exp (-(δ (t₂ - t₁) / a)) S_a(t₁)`;
* `nogo_later_limit_zero` : if `Z_a S_a(t₁)` and `Z_a S_a(t₂)` converge as
  `a → 0⁺` (along any filter, so along any sequence of spacings), the later
  limit is `0`;
* `kallenLehmann_pos` : a nonzero finite spectral measure supported in
  `[Δ, ∞)` with `Δ > 0` gives a two-point function strictly positive at every
  `t > 0`;
* `nogo_no_gapped_limit` : no family with a spacing-uniform lattice gap has
  renormalised two-point functions converging to such a continuum two-point
  function.
-/

open MeasureTheory Filter Topology Real Set

namespace YangMills

/-- The temporal two-point function at spacing `a` and separation `t`, from a
spectral measure `ρ` on lattice-unit energies. On `t ∈ aℤ` this is the lattice
two-point function; the formula defines it for every real `t`. -/
noncomputable def twoPoint (ρ : Measure ℝ) (a t : ℝ) : ℝ :=
  ∫ E, Real.exp (-(E * t / a)) ∂ρ

lemma ae_ge_of_Iio_null {ρ : Measure ℝ} {δ : ℝ} (h : ρ (Iio δ) = 0) :
    ∀ᵐ E ∂ρ, δ ≤ E := by
  rw [ae_iff]
  have : {E : ℝ | ¬δ ≤ E} = Iio δ := by ext E; simp
  rw [this]; exact h

lemma integrable_twoPoint {ρ : Measure ℝ} [IsFiniteMeasure ρ] {δ a t : ℝ}
    (hδ : 0 ≤ δ) (ha : 0 < a) (ht : 0 ≤ t) (h : ρ (Iio δ) = 0) :
    Integrable (fun E => Real.exp (-(E * t / a))) ρ := by
  refine Integrable.of_bound (C := 1) ?_ ?_
  · exact (Real.continuous_exp.comp
      ((continuous_id.mul continuous_const).div_const a).neg).aestronglyMeasurable
  · filter_upwards [ae_ge_of_Iio_null h] with E hE
    rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
    apply Real.exp_le_one_iff.mpr
    have : 0 ≤ E * t / a := div_nonneg (mul_nonneg (hδ.trans hE) ht) ha.le
    linarith

lemma twoPoint_nonneg (ρ : Measure ℝ) (a t : ℝ) : 0 ≤ twoPoint ρ a t :=
  integral_nonneg fun _ => (Real.exp_pos _).le

/-- The ratio bound. Every renormalisation constant cancels in it. -/
theorem twoPoint_ratio_le {ρ : Measure ℝ} [IsFiniteMeasure ρ] {δ a t₁ t₂ : ℝ}
    (hδ : 0 ≤ δ) (ha : 0 < a) (ht₁ : 0 ≤ t₁) (ht : t₁ ≤ t₂)
    (h : ρ (Iio δ) = 0) :
    twoPoint ρ a t₂ ≤ Real.exp (-(δ * (t₂ - t₁) / a)) * twoPoint ρ a t₁ := by
  unfold twoPoint
  rw [← integral_const_mul]
  apply integral_mono_ae (integrable_twoPoint hδ ha (ht₁.trans ht) h)
    ((integrable_twoPoint hδ ha ht₁ h).const_mul _)
  filter_upwards [ae_ge_of_Iio_null h] with E hE
  rw [← Real.exp_add]
  apply Real.exp_le_exp.mpr
  have hdt : 0 ≤ t₂ - t₁ := sub_nonneg.mpr ht
  have key : δ * (t₂ - t₁) ≤ E * (t₂ - t₁) := mul_le_mul_of_nonneg_right hE hdt
  have : (δ * (t₂ - t₁)) / a ≤ (E * (t₂ - t₁)) / a := div_le_div_of_nonneg_right key ha.le
  have e1 : E * t₂ / a = E * (t₂ - t₁) / a + E * t₁ / a := by ring
  rw [e1]; linarith

/-- `exp (-(c / a)) → 0` as `a → 0⁺` for `c > 0`. -/
lemma tendsto_exp_neg_div {c : ℝ} (hc : 0 < c) :
    Tendsto (fun a : ℝ => Real.exp (-(c / a))) (𝓝[>] 0) (𝓝 0) := by
  have h1 : Tendsto (fun a : ℝ => c * a⁻¹) (𝓝[>] 0) atTop :=
    tendsto_inv_nhdsGT_zero.const_mul_atTop hc
  have h2 := Real.tendsto_exp_neg_atTop_nhds_zero.comp h1
  refine h2.congr fun a => ?_
  simp [Function.comp, div_eq_mul_inv]

/-- **No-go theorem.** Let a family of lattice theories, indexed along any
filter `l` on which the spacing `a i` tends to `0⁺`, have a lattice gap `δ > 0`
uniform in the spacing. For any positive renormalisations `Z i`, if the
renormalised two-point functions converge at two separations `t₁ < t₂`, then
the limit at `t₂` is zero. -/
theorem nogo_later_limit_zero {ι : Type*} {l : Filter ι} [l.NeBot]
    {a : ι → ℝ} (ha : Tendsto a l (𝓝[>] 0))
    {ρ : ι → Measure ℝ} [∀ i, IsFiniteMeasure (ρ i)] {δ : ℝ} (hδ : 0 < δ)
    (hsupp : ∀ i, ρ i (Iio δ) = 0) {Z : ι → ℝ} (hZ : ∀ i, 0 < Z i)
    {t₁ t₂ : ℝ} (ht₁ : 0 ≤ t₁) (ht : t₁ < t₂) {L₁ L₂ : ℝ}
    (h₁ : Tendsto (fun i => Z i * twoPoint (ρ i) (a i) t₁) l (𝓝 L₁))
    (h₂ : Tendsto (fun i => Z i * twoPoint (ρ i) (a i) t₂) l (𝓝 L₂)) :
    L₂ = 0 := by
  have hc : 0 < δ * (t₂ - t₁) := mul_pos hδ (sub_pos.mpr ht)
  have hexp : Tendsto (fun i => Real.exp (-(δ * (t₂ - t₁) / a i))) l (𝓝 0) :=
    (tendsto_exp_neg_div hc).comp ha
  have hupper : Tendsto
      (fun i => Real.exp (-(δ * (t₂ - t₁) / a i)) * (Z i * twoPoint (ρ i) (a i) t₁))
      l (𝓝 0) := by
    simpa using hexp.mul h₁
  have hpos : ∀ᶠ i in l, 0 < a i := ha (self_mem_nhdsWithin)
  have hzero : Tendsto (fun i => Z i * twoPoint (ρ i) (a i) t₂) l (𝓝 0) := by
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hupper ?_ ?_
    · exact Eventually.of_forall fun i => mul_nonneg (hZ i).le (twoPoint_nonneg _ _ _)
    · filter_upwards [hpos] with i hi
      have := twoPoint_ratio_le (ρ := ρ i) hδ.le hi ht₁ ht.le (hsupp i)
      calc Z i * twoPoint (ρ i) (a i) t₂
          ≤ Z i * (Real.exp (-(δ * (t₂ - t₁) / a i)) * twoPoint (ρ i) (a i) t₁) :=
            mul_le_mul_of_nonneg_left this (hZ i).le
        _ = _ := by ring
  exact tendsto_nhds_unique h₂ hzero

/-- **Källén–Lehmann positivity.** A nonzero finite spectral measure supported
in `[Δ, ∞)` with `Δ > 0` gives a two-point function `∫ exp (-E t) dσ`
strictly positive at every `t > 0`. -/
theorem kallenLehmann_pos {σ : Measure ℝ} [IsFiniteMeasure σ] (hσ : σ ≠ 0)
    {Δ t : ℝ} (hΔ : 0 < Δ) (ht : 0 < t) (hsupp : σ (Iio Δ) = 0) :
    0 < ∫ E, Real.exp (-(E * t)) ∂σ := by
  have hint : Integrable (fun E => Real.exp (-(E * t))) σ := by
    have := integrable_twoPoint (ρ := σ) hΔ.le one_pos ht.le hsupp
    simpa using this
  rw [integral_pos_iff_support_of_nonneg (fun _ => (Real.exp_pos _).le) hint]
  have : Function.support (fun E : ℝ => Real.exp (-(E * t))) = univ := by
    ext E; simp [(Real.exp_pos _).ne']
  rw [this]
  exact Measure.measure_univ_pos.mpr hσ

/-- **No gapped continuum limit from a spacing-uniform lattice gap.** If the
renormalised two-point functions of a family with a spacing-uniform lattice gap
converged at every `t > 0` to the two-point function of a continuum theory with
gap `Δ > 0` and nonzero spectral measure, we would have a contradiction. -/
theorem nogo_no_gapped_limit {ι : Type*} {l : Filter ι} [l.NeBot]
    {a : ι → ℝ} (ha : Tendsto a l (𝓝[>] 0))
    {ρ : ι → Measure ℝ} [∀ i, IsFiniteMeasure (ρ i)] {δ : ℝ} (hδ : 0 < δ)
    (hsupp : ∀ i, ρ i (Iio δ) = 0) {Z : ι → ℝ} (hZ : ∀ i, 0 < Z i)
    {σ : Measure ℝ} [IsFiniteMeasure σ] (hσ : σ ≠ 0) {Δ : ℝ} (hΔ : 0 < Δ)
    (hσsupp : σ (Iio Δ) = 0) :
    ¬ ∀ t > 0, Tendsto (fun i => Z i * twoPoint (ρ i) (a i) t) l
        (𝓝 (∫ E, Real.exp (-(E * t)) ∂σ)) := by
  intro h
  have h0 := nogo_later_limit_zero ha hδ hsupp hZ zero_le_one one_lt_two
    (h 1 one_pos) (h 2 two_pos)
  exact (kallenLehmann_pos hσ hΔ two_pos hσsupp).ne' h0

/-- The renormalised target is incompatible with a spacing-uniform gap: if
`Δ_lat(a) / a → m` as `a → 0⁺`, then `Δ_lat(a) → 0`, so no `δ > 0` bounds it
below for all small `a`. -/
theorem target_excludes_uniform_gap {Δlat : ℝ → ℝ} {m : ℝ}
    (h : Tendsto (fun a => Δlat a / a) (𝓝[>] 0) (𝓝 m)) :
    ¬ ∃ δ > 0, ∀ a > 0, δ ≤ Δlat a := by
  rintro ⟨δ, hδ, hbound⟩
  have hid : Tendsto (fun a : ℝ => a) (𝓝[>] 0) (𝓝 0) :=
    tendsto_nhdsWithin_of_tendsto_nhds tendsto_id
  have hprod : Tendsto (fun a => Δlat a / a * a) (𝓝[>] 0) (𝓝 0) := by
    simpa using h.mul hid
  have heq : ∀ᶠ a in 𝓝[>] (0:ℝ), Δlat a / a * a = Δlat a := by
    filter_upwards [self_mem_nhdsWithin] with a (ha : 0 < a)
    field_simp
  have hΔ : Tendsto Δlat (𝓝[>] 0) (𝓝 0) := (tendsto_congr' heq).mp hprod
  have hge : ∀ᶠ a in 𝓝[>] (0:ℝ), δ ≤ Δlat a := by
    filter_upwards [self_mem_nhdsWithin] with a (ha : 0 < a)
    exact hbound a ha
  have := ge_of_tendsto hΔ hge
  linarith

end YangMills

end Part04_SpectralNoGo

section Part05_LimitRatio

/-!
# The critical scaling of the lattice gap

The no-go theorem of Part 04 (`SpectralNoGo`) excludes a lattice gap bounded below
in lattice units. This file records the bound that is *not* excluded and that
the Clay statement needs: a lattice gap `Δ_lat(a) ≥ m_a · a` with `m_a → m`.
Under that bound the limiting two-point functions satisfy the ratio inequality
`L(t₂) ≤ exp (-(m (t₂ - t₁))) L(t₁)`, which is the statement that the limit has
spectral gap at least `m`. Nothing here proves such a bound for Yang–Mills; it
only shows what the residual lower bound has to be.
-/

open MeasureTheory Filter Topology Real Set

namespace YangMills

/-- If the lattice gaps scale as `m i * a i` with `m i → m`, and the renormalised
two-point functions converge at `t₁ ≤ t₂`, the limits obey the continuum ratio
bound with rate `m`. -/
theorem limit_ratio_le {ι : Type*} {l : Filter ι} [l.NeBot]
    {a : ι → ℝ} (ha : ∀ᶠ i in l, 0 < a i)
    {ρ : ι → Measure ℝ} [∀ i, IsFiniteMeasure (ρ i)]
    {mseq : ι → ℝ} {m : ℝ} (hm : Tendsto mseq l (𝓝 m)) (hm0 : ∀ i, 0 ≤ mseq i)
    (hsupp : ∀ i, ρ i (Iio (mseq i * a i)) = 0)
    {Z : ι → ℝ} (hZ : ∀ i, 0 < Z i)
    {t₁ t₂ : ℝ} (ht₁ : 0 ≤ t₁) (ht : t₁ ≤ t₂) {L₁ L₂ : ℝ}
    (h₁ : Tendsto (fun i => Z i * twoPoint (ρ i) (a i) t₁) l (𝓝 L₁))
    (h₂ : Tendsto (fun i => Z i * twoPoint (ρ i) (a i) t₂) l (𝓝 L₂)) :
    L₂ ≤ Real.exp (-(m * (t₂ - t₁))) * L₁ := by
  have hrhs : Tendsto
      (fun i => Real.exp (-(mseq i * (t₂ - t₁))) * (Z i * twoPoint (ρ i) (a i) t₁))
      l (𝓝 (Real.exp (-(m * (t₂ - t₁))) * L₁)) := by
    refine Tendsto.mul ?_ h₁
    exact (Real.continuous_exp.tendsto _).comp ((hm.mul_const _).neg)
  refine le_of_tendsto_of_tendsto h₂ hrhs ?_
  filter_upwards [ha] with i hi
  · have hδ : 0 ≤ mseq i * a i := mul_nonneg (hm0 i) hi.le
    have := twoPoint_ratio_le (ρ := ρ i) hδ hi ht₁ ht (hsupp i)
    have e : mseq i * a i * (t₂ - t₁) / a i = mseq i * (t₂ - t₁) := by
      field_simp
    rw [e] at this
    calc Z i * twoPoint (ρ i) (a i) t₂
        ≤ Z i * (Real.exp (-(mseq i * (t₂ - t₁))) * twoPoint (ρ i) (a i) t₁) :=
          mul_le_mul_of_nonneg_left this (hZ i).le
      _ = _ := by ring

end YangMills

end Part05_LimitRatio

section Part06_HolleyStroock

/-!
# The Holley–Stroock perturbation lemma on a finite state space

Let `ν` be a probability vector on a finite set `Ω`, `V : Ω → ℝ` with
`m ≤ V ≤ M`, and `μ = ν e^{-V} / Z` the perturbed probability vector. For a
nonnegative energy density `Γ` (for instance a carré du champ `|∇f|²`, which
does not depend on the measure):

* `holleyStroock_poincare` : `Var_ν f ≤ C Σ ν Γ` implies
  `Var_μ f ≤ C e^{M - m} Σ μ Γ`;
* `holleyStroock_entropy` : `Ent_ν g ≤ C Σ ν Γ` implies
  `Ent_μ g ≤ C e^{M - m} Σ μ Γ` for `g ≥ 0`; with `g = f²` this is the
  log-Sobolev form.

The factor `e^{M - m} = e^{osc V}` is the whole content: for `V = β S` with the
Wilson action, `osc V` grows linearly with the number of plaquettes
(`YangMills.wilsonAction_osc_le`).
-/

open Real Finset

namespace YangMills

set_option linter.unusedSectionVars false

variable {Ω : Type*} [Fintype Ω]

/-- Mean of `f` under the weight vector `w`. -/
def wmean (w f : Ω → ℝ) : ℝ := ∑ ω, w ω * f ω

/-- Variance of `f` under `w`. -/
def wvar (w f : Ω → ℝ) : ℝ := ∑ ω, w ω * (f ω - wmean w f) ^ 2

/-- Entropy of `g ≥ 0` under `w`. -/
noncomputable def went (w g : Ω → ℝ) : ℝ :=
  ∑ ω, w ω * (g ω * Real.log (g ω)) - wmean w g * Real.log (wmean w g)

/-- The perturbed probability vector `ν e^{-V} / Z`. -/
noncomputable def gibbs (ν V : Ω → ℝ) (ω : Ω) : ℝ :=
  ν ω * Real.exp (-V ω) / ∑ ω', ν ω' * Real.exp (-V ω')

/-- The function whose `w`-average, minimised over `c > 0`, is the entropy. -/
noncomputable def entKernel (x c : ℝ) : ℝ := x * Real.log x - x * Real.log c - x + c

lemma entKernel_nonneg {x c : ℝ} (hx : 0 ≤ x) (hc : 0 < c) : 0 ≤ entKernel x c := by
  unfold entKernel
  rcases hx.eq_or_lt with rfl | hx
  · simp; exact hc.le
  · have h := Real.log_le_sub_one_of_pos (div_pos hc hx)
    rw [Real.log_div hc.ne' hx.ne'] at h
    have h2 : x * (Real.log c - Real.log x) ≤ x * (c / x - 1) :=
      mul_le_mul_of_nonneg_left h hx.le
    have h3 : x * (c / x - 1) = c - x := by field_simp
    nlinarith

section

variable {w : Ω → ℝ} (hw0 : ∀ ω, 0 ≤ w ω) (hw1 : ∑ ω, w ω = 1)
include hw0 hw1

theorem wvar_le (f : Ω → ℝ) (c : ℝ) : wvar w f ≤ ∑ ω, w ω * (f ω - c) ^ 2 := by
  set m := wmean w f with hm
  have key : ∑ ω, w ω * (f ω - c) ^ 2 - ∑ ω, w ω * (f ω - m) ^ 2 = (m - c) ^ 2 := by
    rw [← Finset.sum_sub_distrib]
    have h : ∀ ω, w ω * (f ω - c) ^ 2 - w ω * (f ω - m) ^ 2
        = (m - c) * (2 * (w ω * f ω)) - (m - c) * ((c + m) * w ω) := by intro; ring
    rw [Finset.sum_congr rfl (fun ω _ => h ω), Finset.sum_sub_distrib,
      ← Finset.mul_sum, ← Finset.mul_sum, ← Finset.mul_sum, ← Finset.mul_sum, hw1]
    have : ∑ ω, w ω * f ω = m := rfl
    rw [this]; ring
  have : 0 ≤ (m - c) ^ 2 := sq_nonneg _
  unfold wvar; linarith

theorem went_le {g : Ω → ℝ} (hg : ∀ ω, 0 ≤ g ω) {c : ℝ} (hc : 0 < c) :
    went w g ≤ ∑ ω, w ω * entKernel (g ω) c := by
  set m := wmean w g with hm
  have hm0 : 0 ≤ m := Finset.sum_nonneg fun ω _ => mul_nonneg (hw0 ω) (hg ω)
  have hsum : ∑ ω, w ω * entKernel (g ω) c
      = ∑ ω, w ω * (g ω * Real.log (g ω)) - m * Real.log c - m + c := by
    unfold entKernel
    have h : ∀ ω, w ω * (g ω * Real.log (g ω) - g ω * Real.log c - g ω + c)
        = w ω * (g ω * Real.log (g ω)) - Real.log c * (w ω * g ω) - w ω * g ω + c * w ω := by
      intro; ring
    rw [Finset.sum_congr rfl (fun ω _ => h ω), Finset.sum_add_distrib, Finset.sum_sub_distrib,
      Finset.sum_sub_distrib, ← Finset.mul_sum, ← Finset.mul_sum, hw1]
    have : ∑ ω, w ω * g ω = m := rfl
    rw [this]; ring
  rw [hsum]; unfold went
  rw [← hm]
  suffices h : -(m * Real.log m) ≤ -(m * Real.log c) - m + c by linarith
  rcases hm0.eq_or_lt with h0 | hpos
  · rw [← h0]; simp; exact hc.le
  · have := entKernel_nonneg hpos.le hc
    unfold entKernel at this; linarith

theorem went_eq_sum_entKernel (g : Ω → ℝ) :
    went w g = ∑ ω, w ω * entKernel (g ω) (wmean w g) := by
  unfold entKernel went
  have h : ∀ ω, w ω * (g ω * Real.log (g ω) - g ω * Real.log (wmean w g) - g ω + wmean w g)
      = w ω * (g ω * Real.log (g ω)) - Real.log (wmean w g) * (w ω * g ω) - w ω * g ω
        + wmean w g * w ω := by intro; ring
  rw [Finset.sum_congr rfl (fun ω _ => h ω), Finset.sum_add_distrib, Finset.sum_sub_distrib,
    Finset.sum_sub_distrib, ← Finset.mul_sum, ← Finset.mul_sum, hw1]
  have : ∑ ω, w ω * g ω = wmean w g := rfl
  rw [this]; ring

end

section Gibbs

variable {ν V : Ω → ℝ} (hν0 : ∀ ω, 0 ≤ ν ω) (hν1 : ∑ ω, ν ω = 1)
  {m M : ℝ} (hm : ∀ ω, m ≤ V ω) (hM : ∀ ω, V ω ≤ M)
include hν0 hν1 hM

lemma partition_pos : 0 < ∑ ω, ν ω * Real.exp (-V ω) := by
  have : ∑ ω, ν ω * Real.exp (-M) ≤ ∑ ω, ν ω * Real.exp (-V ω) :=
    Finset.sum_le_sum fun ω _ =>
      mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (by linarith [hM ω])) (hν0 ω)
  rw [← Finset.sum_mul, hν1, one_mul] at this
  exact (Real.exp_pos _).trans_le this

lemma gibbs_nonneg (ω : Ω) : 0 ≤ gibbs ν V ω :=
  div_nonneg (mul_nonneg (hν0 ω) (Real.exp_pos _).le) (partition_pos hν0 hν1 hM).le

lemma gibbs_sum : ∑ ω, gibbs ν V ω = 1 := by
  unfold gibbs
  rw [← Finset.sum_div]
  exact div_self (partition_pos hν0 hν1 hM).ne'

include hm

/-- Comparison of `μ`-averages of a nonnegative function with `ν`-averages. -/
lemma gibbs_sum_le {h : Ω → ℝ} (hh : ∀ ω, 0 ≤ h ω) :
    ∑ ω, gibbs ν V ω * h ω
      ≤ Real.exp (-m) / (∑ ω, ν ω * Real.exp (-V ω)) * ∑ ω, ν ω * h ω := by
  have hZ := partition_pos hν0 hν1 hM
  set Z := ∑ ω, ν ω * Real.exp (-V ω) with hZdef
  rw [Finset.mul_sum]
  refine Finset.sum_le_sum fun ω _ => ?_
  have e : gibbs ν V ω * h ω = Real.exp (-V ω) / Z * (ν ω * h ω) := by
    unfold gibbs; rw [← hZdef]; ring
  rw [e]
  have : Real.exp (-V ω) ≤ Real.exp (-m) := Real.exp_le_exp.mpr (by linarith [hm ω])
  exact mul_le_mul_of_nonneg_right (div_le_div_of_nonneg_right this hZ.le)
    (mul_nonneg (hν0 ω) (hh ω))

/-- The reverse comparison, for the energy term. -/
lemma sum_le_gibbs_sum {h : Ω → ℝ} (hh : ∀ ω, 0 ≤ h ω) :
    ∑ ω, ν ω * h ω
      ≤ Real.exp M * (∑ ω, ν ω * Real.exp (-V ω)) * ∑ ω, gibbs ν V ω * h ω := by
  have hZ := partition_pos hν0 hν1 hM
  set Z := ∑ ω, ν ω * Real.exp (-V ω) with hZdef
  rw [Finset.mul_sum]
  refine Finset.sum_le_sum fun ω _ => ?_
  have e : Real.exp M * Z * (gibbs ν V ω * h ω)
      = Real.exp M * Real.exp (-V ω) * (ν ω * h ω) := by
    unfold gibbs; rw [← hZdef]; field_simp
  rw [e]
  have : 1 ≤ Real.exp M * Real.exp (-V ω) := by
    rw [← Real.exp_add]; exact Real.one_le_exp (by linarith [hM ω])
  have h1 : 0 ≤ ν ω * h ω := mul_nonneg (hν0 ω) (hh ω)
  nlinarith

/-- **Holley–Stroock for the Poincaré inequality.** -/
theorem holleyStroock_poincare {Γ : Ω → ℝ} (hΓ : ∀ ω, 0 ≤ Γ ω) {f : Ω → ℝ} {C : ℝ}
    (hC : 0 ≤ C) (hPI : wvar ν f ≤ C * ∑ ω, ν ω * Γ ω) :
    wvar (gibbs ν V) f ≤ C * Real.exp (M - m) * ∑ ω, gibbs ν V ω * Γ ω := by
  have hZ := partition_pos hν0 hν1 hM
  set Z := ∑ ω, ν ω * Real.exp (-V ω)
  have hK : 0 ≤ Real.exp (-m) / Z := div_nonneg (Real.exp_pos _).le hZ.le
  calc wvar (gibbs ν V) f
      ≤ ∑ ω, gibbs ν V ω * (f ω - wmean ν f) ^ 2 :=
        wvar_le (gibbs_nonneg hν0 hν1 hM) (gibbs_sum hν0 hν1 hM) f _
    _ ≤ Real.exp (-m) / Z * wvar ν f :=
        gibbs_sum_le hν0 hν1 hm hM fun ω => sq_nonneg _
    _ ≤ Real.exp (-m) / Z * (C * ∑ ω, ν ω * Γ ω) := mul_le_mul_of_nonneg_left hPI hK
    _ ≤ Real.exp (-m) / Z * (C * (Real.exp M * Z * ∑ ω, gibbs ν V ω * Γ ω)) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left (sum_le_gibbs_sum hν0 hν1 hm hM hΓ) hC) hK
    _ = C * Real.exp (M - m) * ∑ ω, gibbs ν V ω * Γ ω := by
        rw [Real.exp_sub, Real.exp_neg]; field_simp

/-- **Holley–Stroock for the entropy inequality** (log-Sobolev form with
`g = f²`). -/
theorem holleyStroock_entropy {Γ : Ω → ℝ} (hΓ : ∀ ω, 0 ≤ Γ ω) {g : Ω → ℝ}
    (hg : ∀ ω, 0 ≤ g ω) {C : ℝ} (hC : 0 ≤ C) (hLS : went ν g ≤ C * ∑ ω, ν ω * Γ ω) :
    went (gibbs ν V) g ≤ C * Real.exp (M - m) * ∑ ω, gibbs ν V ω * Γ ω := by
  have hZ := partition_pos hν0 hν1 hM
  set Z := ∑ ω, ν ω * Real.exp (-V ω)
  have hK : 0 ≤ Real.exp (-m) / Z := div_nonneg (Real.exp_pos _).le hZ.le
  have hRHS : 0 ≤ C * Real.exp (M - m) * ∑ ω, gibbs ν V ω * Γ ω :=
    mul_nonneg (mul_nonneg hC (Real.exp_pos _).le)
      (Finset.sum_nonneg fun ω _ => mul_nonneg (gibbs_nonneg hν0 hν1 hM ω) (hΓ ω))
  have hm0 : 0 ≤ wmean ν g := Finset.sum_nonneg fun ω _ => mul_nonneg (hν0 ω) (hg ω)
  rcases hm0.eq_or_lt with h0 | hpos
  · -- `g = 0` on the support of `ν`, hence on that of `μ`: both entropies vanish
    have hzero : ∀ ω, ν ω * g ω = 0 := by
      intro ω
      have := (Finset.sum_eq_zero_iff_of_nonneg
        (fun ω _ => mul_nonneg (hν0 ω) (hg ω))).mp h0.symm ω (Finset.mem_univ _)
      exact this
    have hμ : ∀ ω, gibbs ν V ω * g ω = 0 := by
      intro ω; unfold gibbs
      rw [div_mul_eq_mul_div, mul_assoc, mul_comm (Real.exp _), ← mul_assoc, hzero ω]; simp
    have hμlog : ∀ ω, gibbs ν V ω * (g ω * Real.log (g ω)) = 0 := by
      intro ω; rw [← mul_assoc, hμ ω, zero_mul]
    have hent : went (gibbs ν V) g = 0 := by
      unfold went wmean
      simp [hμ, hμlog]
    rw [hent]; exact hRHS
  · calc went (gibbs ν V) g
        ≤ ∑ ω, gibbs ν V ω * entKernel (g ω) (wmean ν g) :=
          went_le (gibbs_nonneg hν0 hν1 hM) (gibbs_sum hν0 hν1 hM) hg hpos
      _ ≤ Real.exp (-m) / Z * ∑ ω, ν ω * entKernel (g ω) (wmean ν g) :=
          gibbs_sum_le hν0 hν1 hm hM fun ω => entKernel_nonneg (hg ω) hpos
      _ = Real.exp (-m) / Z * went ν g := by rw [went_eq_sum_entKernel hν0 hν1 g]
      _ ≤ Real.exp (-m) / Z * (C * ∑ ω, ν ω * Γ ω) := mul_le_mul_of_nonneg_left hLS hK
      _ ≤ Real.exp (-m) / Z * (C * (Real.exp M * Z * ∑ ω, gibbs ν V ω * Γ ω)) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_left (sum_le_gibbs_sum hν0 hν1 hm hM hΓ) hC) hK
      _ = C * Real.exp (M - m) * ∑ ω, gibbs ν V ω * Γ ω := by
          rw [Real.exp_sub, Real.exp_neg]; field_simp

end Gibbs

end YangMills

end Part06_HolleyStroock

section Part07_CumulantCounterexample

/-!
# Bounded nonnegative local terms do not give a volume-uniform cumulant bound

The second derivative of the finite-volume free energy
`f_Λ(β) = -|Λ|⁻¹ log ∫ e^{-β S}` is `-Var_β(S) / |Λ|`. A bound on it uniform in
`|Λ|` therefore needs `Var(S) = O(|Λ|)`, a decorrelation property. Boundedness
and nonnegativity of each local term do not give it: below, `n` local terms
each in `[0, 2N]`, all equal to `2N Y` with `Y` a fair coin, give
`Var(S_n) / n = N² n`, unbounded in the volume `n`. Independence of the local
terms is what would exclude this; plaquette variables are not independent in
dimension `d ≥ 3` (`YangMills.cube_bianchi`).
-/

open Real

namespace YangMills

/-- The fair coin on `Bool`. -/
noncomputable def coin : Bool → ℝ := fun _ => 1 / 2

/-- One local term, equal to `2N Y` with `Y ∈ {0,1}`. -/
def localTerm (N : ℕ) (b : Bool) : ℝ := if b then 2 * N else 0

theorem localTerm_mem (N : ℕ) (b : Bool) : 0 ≤ localTerm N b ∧ localTerm N b ≤ 2 * N := by
  cases b <;> simp [localTerm]

/-- The action of volume `n`: the sum of `n` copies of the local term. -/
def corrAction (N n : ℕ) (b : Bool) : ℝ := ∑ _i : Fin n, localTerm N b

theorem corrAction_var (N n : ℕ) :
    wvar coin (corrAction N n) = (N : ℝ) ^ 2 * n ^ 2 := by
  simp [wvar, wmean, coin, corrAction, localTerm]
  ring

/-- The variance per unit volume is `N² n`, unbounded in `n` for `N ≥ 1`. -/
theorem corrAction_var_per_volume_unbounded {N : ℕ} (hN : 1 ≤ N) (K : ℝ) :
    ∃ n : ℕ, 0 < n ∧ K < wvar coin (corrAction N n) / n := by
  obtain ⟨n, hn⟩ := exists_nat_gt (max K 0)
  have hnpos : (0 : ℝ) < n := lt_of_le_of_lt (le_max_right _ _) hn
  refine ⟨n, by exact_mod_cast hnpos, ?_⟩
  rw [corrAction_var, show (N : ℝ) ^ 2 * n ^ 2 / n = N ^ 2 * n by field_simp]
  have hN1 : (1 : ℝ) ≤ (N : ℝ) ^ 2 := by
    have : (1 : ℝ) ≤ N := by exact_mod_cast hN
    nlinarith
  have : (n : ℝ) ≤ N ^ 2 * n := by nlinarith
  linarith [le_max_left K 0]

end YangMills

end Part07_CumulantCounterexample

section Part08_BlockGauge

/-!
# The block-rooted axial gauge on blocks of side two

Offsets in a block `2y + {0,1}⁴` are read as `o : Fin 16`, bit `μ` of `o` being `o_μ`.  A link
`(o, μ)` is a tree link if `o_μ = 0` and `o_ν = 0` for every `ν > μ`.  The theorems check the
finite counts of Lemma `lem:blocktree` and of the proof of Theorem `thm:blockgap` of the
forest-gauge paper, and the twelve classes of Proposition `prop:invisible`.
-/

namespace YangMills.StrongCoupling.BlockGauge

def bit (o : Fin 16) (μ : Nat) : Nat := (o.val >>> μ) % 2

def flip (o : Fin 16) (μ : Nat) : Fin 16 := ⟨(o.val ^^^ (1 <<< μ)) % 16, Nat.mod_lt _ (by decide)⟩

def isTree (o : Fin 16) (μ : Fin 4) : Bool :=
  bit o μ.val == 0 && (List.range 4).all (fun ν => !(decide (μ.val < ν)) || bit o ν == 0)

/-- Fifteen tree links per block. -/
theorem tree_count :
    ((List.finRange 16).flatMap fun o => (List.finRange 4).filter fun μ => isTree o μ).length = 15 := by
  decide

/-- Seventeen active links inside a block and thirty-two between blocks. -/
theorem active_counts :
    ((List.finRange 16).flatMap fun o => (List.finRange 4).filter fun μ =>
        bit o μ.val == 0 && !isTree o μ).length = 17 ∧
    ((List.finRange 16).flatMap fun o => (List.finRange 4).filter fun μ =>
        bit o μ.val == 1).length = 32 := by
  decide

/-- The highest set bit of a nonzero offset. -/
def top (o : Fin 16) : Nat := if bit o 3 = 1 then 3 else if bit o 2 = 1 then 2 else if bit o 1 = 1 then 1 else 0

/-- Every offset other than the corner is joined by a tree link to an offset with a smaller value,
so the tree links connect the block and, being fifteen, form a spanning tree. -/
theorem tree_connects :
    ∀ o : Fin 16, o.val ≠ 0 →
      isTree (flip o (top o)) ⟨top o, by unfold top; split <;> (try split) <;> (try split) <;> decide⟩ = true ∧
      (flip o (top o)).val < o.val := by
  decide

/-- The chain of an active link inside a block: the directions above `μ` in which the offset is one. -/
def ones (o : Fin 16) (μ : Nat) : List Nat := (List.range 4).filter fun ν => μ < ν && bit o ν == 1

/-- The plaquettes `(x', μ, ν)` used by the chain of `(z, μ)`, with `x'` the offset after clearing
the bits of `z` from the top down to `ν`. -/
def clearFrom (o : Fin 16) (ν : Nat) : Fin 16 :=
  ⟨(o.val % (1 <<< ν)) % 16, Nat.mod_lt _ (by decide)⟩

def load (x : Fin 16) (μ ν : Nat) : Nat :=
  ((List.finRange 16).filter fun z =>
      bit z μ == 0 && (ones z μ).length > 0 && bit z ν == 1 && decide (μ < ν) &&
      clearFrom z ν == x).foldl (fun s z => s + (ones z μ).length) 0

/-- Chains have length at most three and every plaquette carries load at most eight. -/
theorem chain_bounds :
    (∀ z : Fin 16, ∀ μ : Fin 4, (ones z μ.val).length ≤ 3) ∧
    (∀ x : Fin 16, ∀ μ ν : Fin 4, load x μ.val ν.val ≤ 8) := by
  decide

def table : List Nat := [0, 0, 2, 3, 3, 1, 2, 1, 1, 2, 1, 3, 3, 2, 0, 0]

def sig (x : Fin 16) : Nat := table.getD x.val 0

def invisible (x : Fin 16) : Bool := x.val == 14 || x.val == 15

/-- Exactly twelve classes of active links of the line field have one end on an invisible line
(residues `0111`, `1111`), and none has both. -/
theorem invisible_classes :
    ((List.finRange 16).flatMap fun x => (List.finRange 4).filter fun μ =>
        sig x != μ.val && (invisible x != invisible (flip x μ.val))).length = 12 ∧
    (∀ x : Fin 16, ∀ μ : Fin 4, sig x ≠ μ.val → ¬(invisible x ∧ invisible (flip x μ.val))) := by
  decide

end YangMills.StrongCoupling.BlockGauge

end Part08_BlockGauge

section Part09_GaugeFix

/-!
# A gauge fixing of the four-dimensional lattice with one fixed link in every plaquette

Sites of `ℤ⁴` are read modulo 2 as `x : Fin 16`, bit `μ` of `x` being the parity of the
coordinate `x_μ`; the forward link from `x` in direction `μ` is the pair `(x, μ)`.  The pattern
fixes, at each site, the single forward link in direction `sig x`.  The four links of the
plaquette at `x` in the plane `(μ, ν)` are `(x, μ)`, `(x + e_μ, ν)`, `(x + e_ν, μ)` and `(x, ν)`;
moving by `e_μ` flips bit `μ`.  The theorems check, over all residues, that every plaquette has
exactly one fixed link and that every remaining link has exactly `12` remaining partners in its six
plaquettes (instead of `18` without gauge fixing).
-/

namespace YangMills.StrongCoupling.GaugeFix

/-- The fixed direction at a site, indexed by the parities `x_0 + 2 x_1 + 4 x_2 + 8 x_3`. -/
def table : List Nat := [0, 0, 2, 3, 3, 1, 2, 1, 1, 2, 1, 3, 3, 2, 0, 0]

def sig (x : Fin 16) : Nat := table.getD x.val 0

/-- Move by the unit vector `e_μ` (modulo 2). -/
def step (x : Fin 16) (μ : Fin 4) : Fin 16 := ⟨(x.val ^^^ (1 <<< μ.val)) % 16, Nat.mod_lt _ (by decide)⟩

def fixedLink (x : Fin 16) (μ : Fin 4) : Bool := sig x == μ.val

/-- The number of fixed links of the plaquette at `x` in the plane `(μ, ν)`. -/
def fixedCount (x : Fin 16) (μ ν : Fin 4) : Nat :=
  [fixedLink x μ, fixedLink (step x μ) ν, fixedLink (step x ν) μ, fixedLink x ν].countP id

theorem one_fixed_per_plaquette :
    ∀ x : Fin 16, ∀ μ ν : Fin 4, μ.val < ν.val → fixedCount x μ ν = 1 := by decide

/-- The other three links of the plaquette at base `y` in the plane `(μ, ν)` that contain the
forward link `(x, μ)`; the plaquette is either based at `x` or at `x - e_ν`. -/
def partners (x : Fin 16) (μ ν : Fin 4) : List Bool :=
  -- plaquette based at x: the other links are (x + e_μ, ν), (x + e_ν, μ), (x, ν)
  [fixedLink (step x μ) ν, fixedLink (step x ν) μ, fixedLink x ν] ++
  -- plaquette based at x - e_ν (= x + e_ν mod 2): links (y, ν), (y + e_ν, μ) = (x, μ) itself is
  -- excluded, (y + e_μ, ν), (y, μ)
  (let y := step x ν; [fixedLink y ν, fixedLink (step y μ) ν, fixedLink y μ])

/-- Remaining partners of a remaining link `(x, μ)`: summed over the three planes through `μ`,
two plaquettes each. -/
def activePartners (x : Fin 16) (μ : Fin 4) : Nat :=
  ((List.finRange 4).filter (fun ν => ν != μ)).foldl
    (fun acc ν => acc + (partners x μ ν).countP (fun b => !b)) 0

theorem twelve_neighbours :
    ∀ x : Fin 16, ∀ μ : Fin 4, fixedLink x μ = false → activePartners x μ = 12 := by decide

/-- Without gauge fixing each link has `6 · 3 = 18` partners; with the pattern, `6 · 2 = 12`.
In the normalisation `β_W = 4β` of the sharp-quarter argument the single-link Dobrushin
coefficient is at most `12 |β| = 3 β_W`. -/
theorem threshold : 6 * 3 = 18 ∧ 6 * 2 = 12 ∧ 12 = 3 * 4 := by decide

/-- Exactly one fixed forward link at every site. -/
theorem one_per_site : ∀ x : Fin 16, ((List.finRange 4).filter (fun μ => fixedLink x μ)).length = 1 := by
  decide


/-- The fixed links form straight lines: the next site along the fixed link has the same fixed
direction, so at every site the incoming and the outgoing fixed link point the same way. -/
theorem straight_lines :
    ∀ x : Fin 16, ∀ μ : Fin 4, fixedLink x μ = true → fixedLink (step x μ) μ = true := by decide

/-- In the six plaquettes of a remaining link `(x, μ)` the fixed link is the opposite (parallel)
link `(x ± e_ν, μ)`; both plaquettes of the plane `(μ, ν)` share that residue.  Count of planes. -/
def oppositeFixed (x : Fin 16) (μ : Fin 4) : Nat :=
  ((List.finRange 4).filter (fun ν => ν != μ && fixedLink (step x ν) μ)).length

/-- Every remaining link has the fixed link opposite to it in exactly one plane, that is in `2`
of its six plaquettes, and adjacent to it in the other `4`. -/
theorem two_opposite :
    ∀ x : Fin 16, ∀ μ : Fin 4, fixedLink x μ = false → 2 * oppositeFixed x μ = 2 := by decide

/-- The per-link budget of the gauge-fixed certificate: `4 · 21/10 + 2 · 5/4 + 4 · 9/10 = 29/2`,
in tenths and twentieths: `4·42 + 2·25 + 4·18 = 290`. -/
theorem budget : 4 * 42 + 2 * 25 + 4 * 18 = 290 := by decide

end YangMills.StrongCoupling.GaugeFix

end Part09_GaugeFix

section Part10_CubeOpen

/-!
# Perturbations of the cube condition: the finite arithmetic

The proposition `prop:cubeopen` of the forest-gauge paper shows that the cube
condition `D(n, α)` survives a finite-range perturbation of the action with
Lipschitz constant `ε`, with `α' = α e^Ω (1 + 2Ω) + 96 s Ω` and
`Ω = 48 M D N_n ε`; the proposition `prop:smallfield` shows that, for
gauge-invariant perturbations in the small-field regime, the cube must satisfy
`m(m+1) η + κ D ≥ (1 - α) D / 3`. The analytic steps (Kantorovich duality,
the loop bound) are in the paper; this file checks the arithmetic that joins
them:

* `cube_constants` : `48 · 2 = 96`, `96 · 48 = 4608`, `4608 = 4 · 1152`;
* `lipschitz_times_diameter` : `Δ_V M ε = Ω` with `Δ_V = 48 N_n D`;
* `coefficient_total` : `2 Δ_V s M |V| ε = 96 s Ω N_n` with `|V| = 48 N_n`;
* `common_tilt` : the two terms of the common tilt add up to
  `e^Ω (1 + 2Ω) W`;
* `two_tilts` : `1 - e^{-2η} ≤ 2η`;
* `alpha_prime_ge` : `α' ≥ α + 96 s Ω`;
* `eps_lt_of_alpha_prime_lt_one` : `α' < 1` forces
  `ε < (1 - α) / (4608 s M D N_n)`;
* `cube_side_sq_le` : `m(m+1) ≤ 2 m²` for `m ≥ 1`;
* `cube_volume_ge` : `m(m+1) ≥ x ≥ 0` gives `m⁴ ≥ x² / 4`;
* `small_field_eps` : with `x = c D / η` the admissible `ε` is below
  `(1 - α) η² / (1152 s M D³ c²)`;
* `small_field_side` : the two bounds on `ε_V` combine to
  `m(m+1) η + κ D ≥ (1 - α) D / 3`.
-/

open Real

namespace YangMills.StrongCoupling

theorem cube_constants : 48 * 2 = 96 ∧ 96 * 48 = 4608 ∧ 4608 = 4 * 1152 := by
  norm_num

/-- With `Δ_V = 48 N_n D` and `Ω = 48 M D N_n ε`, `Δ_V M ε = Ω`. -/
theorem lipschitz_times_diameter (N D M ε : ℝ) :
    (48 * N * D) * M * ε = 48 * M * D * N * ε := by ring

/-- The total of the second terms: `2 Δ_V s M |V| ε = 96 s Ω N_n`. -/
theorem coefficient_total (N D M s ε : ℝ) :
    2 * (48 * N * D) * s * M * (48 * N) * ε = 96 * s * (48 * M * D * N * ε) * N := by
  ring

/-- The common tilt: the first term is at most `e^Ω (1 + Ω) W`, the second at
most `Ω e^Ω W`, and together at most `e^Ω (1 + 2Ω) W`. -/
theorem common_tilt (x y W Ω : ℝ)
    (hx : x ≤ exp Ω * (1 + Ω) * W) (hy : y ≤ Ω * exp Ω * W) :
    x + y ≤ exp Ω * (1 + 2 * Ω) * W := by
  nlinarith

/-- Two tilts of one measure: `1 - e^{-2η} ≤ 2η`. -/
theorem two_tilts (η : ℝ) : 1 - exp (-2 * η) ≤ 2 * η := by
  have := add_one_le_exp (-2 * η)
  linarith

/-- `α' = α e^Ω (1 + 2Ω) + 96 s Ω ≥ α + 96 s Ω`. -/
theorem alpha_prime_ge (α Ω s : ℝ) (hα : 0 ≤ α) (hΩ : 0 ≤ Ω) :
    α + 96 * s * Ω ≤ α * exp Ω * (1 + 2 * Ω) + 96 * s * Ω := by
  have h1 : 1 ≤ exp Ω := one_le_exp hΩ
  have h2 : 1 ≤ exp Ω * (1 + 2 * Ω) := by nlinarith
  nlinarith

/-- If `α' < 1` then `ε < (1 - α) / (4608 s M D N_n)`. -/
theorem eps_lt_of_alpha_prime_lt_one (α s M D N ε : ℝ) (hα : 0 ≤ α) (hε : 0 ≤ ε)
    (hs : 0 < s) (hM : 0 < M) (hD : 0 < D) (hN : 0 < N)
    (h : α * exp (48 * M * D * N * ε) * (1 + 2 * (48 * M * D * N * ε))
        + 96 * s * (48 * M * D * N * ε) < 1) :
    ε < (1 - α) / (4608 * s * M * D * N) := by
  have hΩ : 0 ≤ 48 * M * D * N * ε := by positivity
  have hge := alpha_prime_ge α (48 * M * D * N * ε) s hα hΩ
  have hpos : 0 < 4608 * s * M * D * N := by positivity
  rw [lt_div_iff₀ hpos]
  nlinarith

/-- `m(m+1) ≤ 2 m²` for `m ≥ 1`. -/
theorem cube_side_sq_le (m : ℕ) (hm : 1 ≤ m) : m * (m + 1) ≤ 2 * m ^ 2 := by
  nlinarith

/-- If `m(m+1) ≥ x ≥ 0` then `N_n = m⁴ ≥ x² / 4`. -/
theorem cube_volume_ge (m : ℕ) (hm : 1 ≤ m) (x : ℝ) (hx : 0 ≤ x)
    (h : x ≤ (m : ℝ) * (m + 1)) : x ^ 2 / 4 ≤ (m : ℝ) ^ 4 := by
  have h2 : (m : ℝ) * (m + 1) ≤ 2 * (m : ℝ) ^ 2 := by
    exact_mod_cast cube_side_sq_le m hm
  have h3 : x ≤ 2 * (m : ℝ) ^ 2 := le_trans h h2
  have h4 : x ^ 2 ≤ (2 * (m : ℝ) ^ 2) ^ 2 := pow_le_pow_left₀ hx h3 2
  nlinarith

/-- The admissible perturbation on a small-field cube: if
`ε < (1 - α) / (4608 s M D N_n)` and `N_n ≥ x² / 4` with `x = c D / η`, then
`ε < (1 - α) η² / (1152 s M D³ c²)`. -/
theorem small_field_eps (α s M D N ε c η : ℝ) (hα : α < 1)
    (hs : 0 < s) (hM : 0 < M) (hD : 0 < D) (hc : 0 < c) (hη : 0 < η)
    (hN : (c * D / η) ^ 2 / 4 ≤ N)
    (hε : ε < (1 - α) / (4608 * s * M * D * N)) :
    ε < (1 - α) * η ^ 2 / (1152 * s * M * D ^ 3 * c ^ 2) := by
  have hx : 0 < (c * D / η) ^ 2 / 4 := by positivity
  have hNpos : 0 < N := lt_of_lt_of_le hx hN
  have h1 : (1 - α) / (4608 * s * M * D * N)
      ≤ (1 - α) / (4608 * s * M * D * ((c * D / η) ^ 2 / 4)) := by
    apply div_le_div_of_nonneg_left (by linarith) (by positivity)
    have : 0 < 4608 * s * M * D := by positivity
    exact mul_le_mul_of_nonneg_left hN this.le
  have h2 : (1 - α) / (4608 * s * M * D * ((c * D / η) ^ 2 / 4))
      = (1 - α) * η ^ 2 / (1152 * s * M * D ^ 3 * c ^ 2) := by
    field_simp
    ring
  linarith [h1, h2.le, h2.ge]

/-- The small-field bound: `(1 - α) D / 3 ≤ ε_V ≤ m(m+1) η + κ D`. -/
theorem small_field_side (α D εV m η κ : ℝ)
    (hlow : (1 - α) * D / 3 ≤ εV) (hup : εV ≤ m * (m + 1) * η + κ * D) :
    (1 - α) * D / 3 ≤ m * (m + 1) * η + κ * D :=
  le_trans hlow hup

end YangMills.StrongCoupling

end Part10_CubeOpen

section Part11_QxCoefficients

/-!
# The transverse half of the sharp quarter: coefficient positivity

The transverse part of the chordal-Lipschitz bound for the von Mises–Fisher law
on `S³` reduces to the positivity of
`D(k) = (8 + 2k²) I₁(k)² - k² I₀(k)² - k I₁(2k)`,
a power series in `k²`. Writing `I₀`, `I₁` as their series, the coefficients of
`I₀²` and `I₁²` are Cauchy products (`a`, `b`), and that of `k I₁(2k)` is `e`.

* `a_closed`, `b_closed` : the Cauchy products in closed form, by Vandermonde;
* `Dcoef_closed` : the coefficient of `k^{2(m+2)}` in `D` times a positive factor
  equals `C(2m+2,m+1)(4(2m+3) + m(m+2)(m+3)) - 4^{m+1}(m+2)(m+3)`;
* `coeff_ineq` : that number is `≥ 0` for every `m`, from
  `16^m ≤ 4m C(2m,m)²` (`sixteen_pow_le`);
* `Dcoef_nonneg` : every coefficient of `D` is nonnegative.
-/

open Nat Finset

namespace YangMills.StrongCoupling

theorem sixteen_pow_le (m : ℕ) (hm : 1 ≤ m) :
    16 ^ m ≤ 4 * m * centralBinom m ^ 2 := by
  induction m, hm using Nat.le_induction with
  | base => simp [Nat.centralBinom, Nat.choose]
  | succ m hm ih =>
    have h := Nat.succ_mul_centralBinom_succ m
    have key : 16 ^ m * (m + 1) ≤ (2 * m + 1) ^ 2 * centralBinom m ^ 2 := by
      calc 16 ^ m * (m + 1) ≤ 4 * m * centralBinom m ^ 2 * (m + 1) :=
            Nat.mul_le_mul_right _ ih
        _ ≤ (2 * m + 1) ^ 2 * centralBinom m ^ 2 := by nlinarith [Nat.zero_le (centralBinom m ^ 2)]
    have hpos : 0 < m + 1 := by omega
    have : 16 ^ (m + 1) * (m + 1) ≤ 4 * (m + 1) * centralBinom (m + 1) ^ 2 * (m + 1) := by
      have e : 4 * (m + 1) * centralBinom (m + 1) ^ 2 * (m + 1)
          = 4 * ((m + 1) * centralBinom (m + 1)) ^ 2 := by ring
      rw [e, h, pow_succ]
      nlinarith [key]
    exact Nat.le_of_mul_le_mul_right this hpos

theorem central_mul_ge (m : ℕ) (hm : 6 ≤ m) :
    4 ^ m ≤ centralBinom m * (m - 1) := by
  have h1 := sixteen_pow_le m (by omega)
  have h2 : 4 * m ≤ (m - 1) ^ 2 := by
    obtain ⟨k, rfl⟩ : ∃ k, m = k + 6 := ⟨m - 6, by omega⟩
    simp only [show k + 6 - 1 = k + 5 by omega]; nlinarith
  have : (4 ^ m) ^ 2 ≤ (centralBinom m * (m - 1)) ^ 2 := by
    calc (4 ^ m) ^ 2 = 16 ^ m := by rw [← pow_mul, mul_comm, pow_mul]; norm_num
      _ ≤ 4 * m * centralBinom m ^ 2 := h1
      _ ≤ (m - 1) ^ 2 * centralBinom m ^ 2 := Nat.mul_le_mul_right _ h2
      _ = (centralBinom m * (m - 1)) ^ 2 := by ring
  exact (Nat.pow_le_pow_iff_left (by norm_num)).1 this

/-- The coefficient inequality: for every `m`,
`4^m (m+1)(m+2) ≤ C(2m,m) (4(2m+1) + (m-1)(m+1)(m+2))`. -/
theorem coeff_ineq (m : ℕ) :
    (4 : ℤ) ^ m * ((m + 1) * (m + 2)) ≤
      (centralBinom m : ℤ) * (4 * (2 * m + 1) + ((m : ℤ) - 1) * (m + 1) * (m + 2)) := by
  rcases lt_or_ge m 6 with h | h
  · interval_cases m <;> simp [Nat.centralBinom, Nat.choose]
  · have h3 := central_mul_ge m h
    have h3' : (4 : ℤ) ^ m ≤ (centralBinom m : ℤ) * ((m : ℤ) - 1) := by
      have : ((m - 1 : ℕ) : ℤ) = (m : ℤ) - 1 := by omega
      rw [← this]; exact_mod_cast h3
    have hc : (0 : ℤ) ≤ centralBinom m := by positivity
    have hp : (0 : ℤ) < (m + 1) * (m + 2) := by positivity
    nlinarith [mul_le_mul_of_nonneg_right h3' hp.le, mul_nonneg hc (show (0:ℤ) ≤ 4 * (2 * m + 1) by positivity)]

/-- Coefficient of `k^{2m}` in `I₀(k)²`, as a Cauchy product of the series
`I₀(k) = Σ (k/2)^{2j}/(j!)²`. -/
noncomputable def a (m : ℕ) : ℚ :=
  (1 / 4 ^ m) * ∑ j ∈ range (m + 1), 1 / ((j ! : ℚ) ^ 2 * ((m - j)! : ℚ) ^ 2)

/-- Coefficient of `k^{2m+2}` in `I₁(k)²`, from `I₁(k) = Σ (k/2)^{2j+1}/(j!(j+1)!)`. -/
noncomputable def b (m : ℕ) : ℚ :=
  (1 / 4 ^ (m + 1)) *
    ∑ j ∈ range (m + 1), 1 / ((j ! : ℚ) * (j + 1)! * (m - j)! * (m - j + 1)!)

theorem a_closed (m : ℕ) : a m = (centralBinom m : ℚ) / (4 ^ m * (m ! : ℚ) ^ 2) := by
  have hs : ∑ j ∈ range (m + 1), 1 / ((j ! : ℚ) ^ 2 * ((m - j)! : ℚ) ^ 2)
      = ∑ j ∈ range (m + 1), ((m.choose j : ℕ) : ℚ) ^ 2 / (m ! : ℚ) ^ 2 := by
    refine sum_congr rfl fun j hj => ?_
    have hj : j ≤ m := Nat.lt_succ_iff.mp (mem_range.mp hj)
    rw [Nat.cast_choose ℚ hj]
    have h1 : (j ! : ℚ) ≠ 0 := by positivity
    have h2 : ((m - j)! : ℚ) ≠ 0 := by positivity
    have h3 : (m ! : ℚ) ≠ 0 := by positivity
    field_simp
  have hc : (∑ j ∈ range (m + 1), ((m.choose j : ℕ) : ℚ) ^ 2) = centralBinom m := by
    rw [Nat.centralBinom_eq_two_mul_choose, ← Nat.sum_range_choose_sq]; push_cast; rfl
  rw [a, hs, ← sum_div, hc]
  field_simp

theorem vandermonde_shift (m : ℕ) :
    ∑ j ∈ range (m + 1), (m.choose j) * ((m + 2).choose (j + 1)) = centralBinom (m + 1) := by
  have hv : centralBinom (m + 1) =
      ∑ k ∈ range (m + 1 + 1), m.choose k * (m + 2).choose (m + 1 - k) := by
    rw [Nat.centralBinom_eq_two_mul_choose, show 2 * (m + 1) = m + (m + 2) by ring,
      Nat.add_choose_eq, Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk]
  rw [hv, Finset.sum_range_succ _ (m + 1), Nat.choose_succ_self, zero_mul, add_zero]
  refine sum_congr rfl fun j hj => ?_
  have hj : j ≤ m := Nat.lt_succ_iff.mp (mem_range.mp hj)
  congr 1
  rw [← Nat.choose_symm (show j + 1 ≤ m + 2 by omega)]
  congr 1; omega

theorem b_closed (m : ℕ) :
    b m = (centralBinom (m + 1) : ℚ) / (4 ^ (m + 1) * (m ! : ℚ) * ((m + 2)! : ℚ)) := by
  have hs : ∑ j ∈ range (m + 1), 1 / ((j ! : ℚ) * (j + 1)! * (m - j)! * (m - j + 1)!)
      = ∑ j ∈ range (m + 1),
          ((m.choose j : ℕ) : ℚ) * (((m + 2).choose (j + 1) : ℕ) : ℚ) / ((m ! : ℚ) * (m + 2)!) := by
    refine sum_congr rfl fun j hj => ?_
    have hj : j ≤ m := Nat.lt_succ_iff.mp (mem_range.mp hj)
    rw [Nat.cast_choose ℚ hj, Nat.cast_choose ℚ (show j + 1 ≤ m + 2 by omega),
      show m + 2 - (j + 1) = m - j + 1 by omega]
    have h1 : (j ! : ℚ) ≠ 0 := by positivity
    have h1' : ((j + 1)! : ℚ) ≠ 0 := by positivity
    have h2 : ((m - j)! : ℚ) ≠ 0 := by positivity
    have h2' : ((m - j + 1)! : ℚ) ≠ 0 := by positivity
    have h3 : (m ! : ℚ) ≠ 0 := by positivity
    have h4 : ((m + 2)! : ℚ) ≠ 0 := by positivity
    field_simp
  have hc : (∑ j ∈ range (m + 1), ((m.choose j : ℕ) : ℚ) * (((m + 2).choose (j + 1) : ℕ) : ℚ))
      = centralBinom (m + 1) := by
    rw [← vandermonde_shift]; push_cast; rfl
  rw [b, hs, ← sum_div, hc]
  field_simp

/-- Coefficient of `k^{2m+2}` in `k I₁(2k) = Σ k^{2m+2}/(m!(m+1)!)`. -/
noncomputable def e (m : ℕ) : ℚ := 1 / ((m ! : ℚ) * (m + 1)!)

/-- Coefficient of `k^{2n}` in `D(k) = (8 + 2k²) I₁(k)² - k² I₀(k)² - k I₁(2k)`. -/
noncomputable def Dcoef : ℕ → ℚ
  | 0 => 0
  | 1 => 8 * b 0 - a 0 - e 0
  | m + 2 => 8 * b (m + 1) + 2 * b m - a (m + 1) - e (m + 1)

theorem Dcoef_one : Dcoef 1 = 0 := by
  simp [Dcoef, a, b, e]; norm_num

theorem Dcoef_closed (m : ℕ) :
    Dcoef (m + 2) * (4 ^ (m + 1) * ((m + 1)! : ℚ) * ((m + 2)! : ℚ) * ((m + 2) * (m + 3)))
      = (centralBinom (m + 1) : ℚ) * (4 * (2 * m + 3) + m * (m + 2) * (m + 3))
        - 4 ^ (m + 1) * ((m + 2) * (m + 3)) := by
  have hc := Nat.succ_mul_centralBinom_succ (m + 1)
  have hc' : ((m + 2 : ℕ) : ℚ) * (centralBinom (m + 2) : ℚ)
      = 2 * (2 * ((m + 1 : ℕ) : ℚ) + 1) * (centralBinom (m + 1) : ℚ) := by exact_mod_cast hc
  push_cast at hc'
  have f1 : ((m + 1)! : ℚ) = (m + 1) * (m ! : ℚ) := by push_cast [Nat.factorial_succ]; ring
  have f2 : ((m + 2)! : ℚ) = (m + 2) * (m + 1) * (m ! : ℚ) := by
    push_cast [Nat.factorial_succ]; ring
  have f3 : ((m + 1 + 2)! : ℚ) = (m + 3) * (m + 2) * (m + 1) * (m ! : ℚ) := by
    push_cast [Nat.factorial_succ]; ring
  have hf : (m ! : ℚ) ≠ 0 := by positivity
  have hC : (centralBinom (m + 2) : ℚ) =
      2 * (2 * (m : ℚ) + 3) * (centralBinom (m + 1) : ℚ) / (m + 2) := by
    rw [eq_div_iff (by positivity)]; linarith
  simp only [Dcoef, a_closed, b_closed, e]
  rw [f3, f2, f1, hC, show m + 1 + 1 = m + 2 by ring]
  field_simp
  ring

theorem Dcoef_nonneg (n : ℕ) : 0 ≤ Dcoef n := by
  match n with
  | 0 => simp [Dcoef]
  | 1 => rw [Dcoef_one]
  | m + 2 =>
    have hK : (0 : ℚ) < 4 ^ (m + 1) * ((m + 1)! : ℚ) * ((m + 2)! : ℚ) * ((m + 2) * (m + 3)) := by
      positivity
    have h := coeff_ineq (m + 1)
    have h' : (0 : ℚ) ≤ (centralBinom (m + 1) : ℚ) * (4 * (2 * m + 3) + m * (m + 2) * (m + 3))
        - 4 ^ (m + 1) * ((m + 2) * (m + 3)) := by
      have : (0 : ℤ) ≤ (centralBinom (m + 1) : ℤ) *
          (4 * (2 * ((m + 1 : ℕ) : ℤ) + 1) + (((m + 1 : ℕ) : ℤ) - 1) * ((m + 1 : ℕ) + 1) * ((m + 1 : ℕ) + 2))
          - 4 ^ (m + 1) * ((((m + 1 : ℕ) : ℤ) + 1) * (((m + 1 : ℕ) : ℤ) + 2)) := by linarith
      have hq : (0 : ℚ) ≤ ((_ : ℤ) : ℚ) := Int.cast_nonneg this
      push_cast at hq
      convert hq using 2 <;> ring
    rw [← Dcoef_closed m] at h'
    exact nonneg_of_mul_nonneg_left h' hK

end YangMills.StrongCoupling

end Part11_QxCoefficients

section Part12_Thresholds

/-!
# The Dobrushin threshold for SU(2) at the sharp quarter

For `SU(2)` the conditional law of one link is a von Mises–Fisher law on `S³`
whose staple moves by `4|β|` times the displacement of a neighbouring link.
With the sharp chordal-Lipschitz bound `1/4` (`YangMills.StrongCoupling.zonal_final`
and `Dcoef_nonneg` give its two halves), each Dobrushin coefficient is at most
`4|β| · 1/4 = |β|`. A link lies in `2(d-1)` plaquettes, each with three other
links, so a row of the Dobrushin matrix has at most `6(d-1)` nonzero entries:

* `neighbours_count` : `3 · 2(d-1) = 6(d-1)`;
* `row_sum_le` : a row sum is at most `6(d-1)|β|`;
* `alpha_lt_one_iff` : `6(d-1)|β| < 1 ↔ |β| < 1/(6(d-1))`;
* `wilson_threshold_d4` : at `d = 4`, with `β_W = 4β`, the range is `β_W < 2/9`;
* `gap_pos`, `gap_d4` : the gap `m = -log(6(d-1)|β|)` is positive and equals
  `-log(9β_W/2)` at `d = 4`.
-/

open Finset Real

namespace YangMills.StrongCoupling

/-- The coefficient bound `4|β| · (1/4) = |β|`. -/
theorem coefficient_bound (β L : ℝ) (hL : L ≤ 1 / 4) :
    4 * |β| * L ≤ |β| := by
  have := abs_nonneg β
  nlinarith

theorem neighbours_count (d : ℕ) : 3 * (2 * (d - 1)) = 6 * (d - 1) := by ring

/-- A row of the Dobrushin matrix: at most `6(d-1)` entries, each at most `|β|`. -/
theorem row_sum_le {ι : Type*} (s : Finset ι) (C : ι → ℝ) (β : ℝ) (d : ℕ)
    (hcard : s.card ≤ 6 * (d - 1)) (hC : ∀ i ∈ s, C i ≤ |β|) :
    ∑ i ∈ s, C i ≤ 6 * (d - 1 : ℕ) * |β| := by
  calc ∑ i ∈ s, C i ≤ ∑ _i ∈ s, |β| := sum_le_sum hC
    _ = s.card * |β| := by rw [sum_const, nsmul_eq_mul]
    _ ≤ 6 * (d - 1 : ℕ) * |β| := by
      apply mul_le_mul_of_nonneg_right _ (abs_nonneg β)
      exact_mod_cast hcard

theorem alpha_lt_one_iff (β : ℝ) (d : ℕ) (hd : 2 ≤ d) :
    6 * (d - 1 : ℕ) * |β| < 1 ↔ |β| < 1 / (6 * (d - 1 : ℕ)) := by
  have hpos : (0 : ℝ) < 6 * (d - 1 : ℕ) := by
    have : (1 : ℝ) ≤ (d - 1 : ℕ) := by exact_mod_cast (show 1 ≤ d - 1 by omega)
    linarith
  rw [lt_div_iff₀ hpos, mul_comm]

/-- At `d = 4` with `β_W = 4β` the Dobrushin range is `β_W < 2/9`. -/
theorem wilson_threshold_d4 (βW : ℝ) (h0 : 0 ≤ βW) :
    6 * ((4 - 1 : ℕ) : ℝ) * |βW / 4| < 1 ↔ βW < 2 / 9 := by
  rw [abs_of_nonneg (by positivity)]
  norm_num
  constructor <;> intro h <;> linarith

theorem gap_pos (β : ℝ) (d : ℕ) (hβ : β ≠ 0) (h : 6 * (d - 1 : ℕ) * |β| < 1)
    (hd : 2 ≤ d) : 0 < -Real.log (6 * (d - 1 : ℕ) * |β|) := by
  have hpos : 0 < 6 * (d - 1 : ℕ) * |β| := by
    have : (1 : ℝ) ≤ (d - 1 : ℕ) := by exact_mod_cast (show 1 ≤ d - 1 by omega)
    have := abs_pos.mpr hβ
    positivity
  have := Real.log_neg hpos h
  linarith

theorem gap_d4 (βW : ℝ) (h0 : 0 ≤ βW) :
    -Real.log (6 * ((4 - 1 : ℕ) : ℝ) * |βW / 4|) = -Real.log (9 * βW / 2) := by
  rw [abs_of_nonneg (by positivity)]
  norm_num
  ring_nf

end YangMills.StrongCoupling

end Part12_Thresholds

section Part13_ZonalBound

/-!
# The zonal half of the sharp quarter: the algebraic steps

Let `A = I₂(k)/I₁(k)`, which solves the Riccati equation `A' = 1 - A² - 3A/k`.
The zonal part of the chordal-Lipschitz bound is at most
`1/4 + 4A'² + A²/4 - A/(2k) - 2A²/k²`.

* `riccati_residual`, `riccati_residual_pos`, `hasDerivAt_Alo` : the function
  `A_lo = k/(3/2 + s)`, `s = √(k² + 25/4)`, is a strict subsolution of the
  Riccati equation, with residual `5(s - 5/2)/(2s(3/2+s)²)`;
* `alpha_identity`, `phi_identity` : at `A = A_lo` the bound equals
  `1/4 + (2s-5)(8s³+28s²-98s-695)/(4(2s+3)⁴)`;
* `cubic_neg`, `phi_neg` : that correction is negative for `5/2 < s ≤ √577/6`;
* `T_antitone`, `zonal_final` : for `A_lo ≤ A ≤ k/4`, `A' ≥ 0` and `9k² ≤ 88`
  the bound is strictly below `1/4`.
-/

namespace YangMills.StrongCoupling

/-- `α(s) = 1 - 3y - k²y²` at `y = 2/(2s+3)`, `k² = s² - 25/4`. -/
theorem alpha_identity (s : ℝ) (hs : 0 < s) :
    1 - 3 * (2 / (2 * s + 3)) - (s ^ 2 - 25 / 4) * (2 / (2 * s + 3)) ^ 2
      = 16 / (2 * s + 3) ^ 2 := by
  have : (2 * s + 3) ≠ 0 := by positivity
  field_simp; ring

theorem phi_identity (s : ℝ) (hs : 0 < s) :
    4 * (16 / (2 * s + 3) ^ 2) ^ 2 + (s ^ 2 - 25 / 4) * (2 / (2 * s + 3)) ^ 2 / 4
        - (2 / (2 * s + 3)) / 2 - 2 * (2 / (2 * s + 3)) ^ 2
      = (2 * s - 5) * (8 * s ^ 3 + 28 * s ^ 2 - 98 * s - 695) / (4 * (2 * s + 3) ^ 4) := by
  have : (2 * s + 3) ≠ 0 := by positivity
  field_simp; ring

theorem cubic_neg (s : ℝ) (h1 : 5 / 2 < s) (h2 : 36 * s ^ 2 ≤ 577) :
    8 * s ^ 3 + 28 * s ^ 2 - 98 * s - 695 < 0 := by
  have hs4 : s < 4.01 := by nlinarith
  nlinarith

theorem phi_neg (s : ℝ) (h1 : 5 / 2 < s) (h2 : 36 * s ^ 2 ≤ 577) :
    (2 * s - 5) * (8 * s ^ 3 + 28 * s ^ 2 - 98 * s - 695) / (4 * (2 * s + 3) ^ 4) < 0 := by
  apply div_neg_of_neg_of_pos
  · exact mul_neg_of_pos_of_neg (by linarith) (cubic_neg s h1 h2)
  · positivity

/-- Residual of the Riccati equation `A' = 1 - A² - 3A/k` along `A_lo = k/(3/2+s)`,
`s = √(k²+25/4)`, whose derivative is `(3s/2+25/4)/(s(3/2+s)²)`. -/
theorem riccati_residual (k s : ℝ) (hk : 0 < k) (hs : 0 < s) (hks : s ^ 2 = k ^ 2 + 25 / 4) :
    1 - (k / (3 / 2 + s)) ^ 2 - 3 * (k / (3 / 2 + s)) / k
        - (3 * s / 2 + 25 / 4) / (s * (3 / 2 + s) ^ 2)
      = 5 / 2 * (s - 5 / 2) / (s * (3 / 2 + s) ^ 2) := by
  have h1 : (3 / 2 + s) ≠ 0 := by positivity
  have h2 : k ≠ 0 := hk.ne'
  have h3 : s ≠ 0 := hs.ne'
  field_simp
  have : k ^ 2 = s ^ 2 - 25 / 4 := by linarith
  rw [this]; ring

theorem riccati_residual_pos (k s : ℝ) (hk : 0 < k) (hs : 0 < s)
    (hks : s ^ 2 = k ^ 2 + 25 / 4) :
    0 < 1 - (k / (3 / 2 + s)) ^ 2 - 3 * (k / (3 / 2 + s)) / k
        - (3 * s / 2 + 25 / 4) / (s * (3 / 2 + s) ^ 2) := by
  rw [riccati_residual k s hk hs hks]
  have : 5 / 2 < s := by nlinarith
  apply div_pos (by nlinarith) (by positivity)

/-- The derivative of `A_lo(k) = k/(3/2 + √(k²+25/4))`. -/
theorem hasDerivAt_Alo (k : ℝ) (hk : 0 < k) :
    HasDerivAt (fun x : ℝ => x / (3 / 2 + Real.sqrt (x ^ 2 + 25 / 4)))
      ((3 * Real.sqrt (k ^ 2 + 25 / 4) / 2 + 25 / 4) /
        (Real.sqrt (k ^ 2 + 25 / 4) * (3 / 2 + Real.sqrt (k ^ 2 + 25 / 4)) ^ 2)) k := by
  have hpos : 0 < k ^ 2 + 25 / 4 := by positivity
  have hq : HasDerivAt (fun x : ℝ => x ^ 2 + 25 / 4) (2 * k) k := by
    simpa using (hasDerivAt_pow 2 k).add_const (25 / 4 : ℝ)
  have hden : HasDerivAt (fun x : ℝ => 3 / 2 + Real.sqrt (x ^ 2 + 25 / 4))
      (2 * k / (2 * Real.sqrt (k ^ 2 + 25 / 4))) k := by
    simpa using (hq.sqrt hpos.ne').const_add (3 / 2 : ℝ)
  have hs : 0 < Real.sqrt (k ^ 2 + 25 / 4) := Real.sqrt_pos.mpr hpos
  have hne : (3 / 2 + Real.sqrt (k ^ 2 + 25 / 4)) ≠ 0 := by positivity
  refine ((hasDerivAt_id' k).div hden hne).congr_deriv ?_
  obtain ⟨s, hsdef⟩ : ∃ s, s = Real.sqrt (k ^ 2 + 25 / 4) := ⟨_, rfl⟩
  have hss : s ^ 2 = k ^ 2 + 25 / 4 := by rw [hsdef]; exact Real.sq_sqrt hpos.le
  rw [← hsdef] at hs ⊢
  have : s ≠ 0 := hs.ne'
  have : 3 / 2 + s ≠ 0 := by positivity
  field_simp
  rw [show k ^ 2 = s ^ 2 - 25 / 4 by linarith]
  ring

/-- The quadratic part `T(A) = A²/4 - A/(2k) - 2A²/k²` is decreasing on `[0, k/4]`
when `k² ≤ 12`. -/
theorem T_antitone (k A B : ℝ) (hk : 0 < k) (hk12 : k ^ 2 ≤ 12)
    (hB : 0 ≤ B) (hBA : B ≤ A) (hA : A ≤ k / 4) :
    A ^ 2 / 4 - A / (2 * k) - 2 * A ^ 2 / k ^ 2 ≤ B ^ 2 / 4 - B / (2 * k) - 2 * B ^ 2 / k ^ 2 := by
  have hk2 : 0 < k ^ 2 := by positivity
  rw [← sub_nonneg]
  have e : (B ^ 2 / 4 - B / (2 * k) - 2 * B ^ 2 / k ^ 2) - (A ^ 2 / 4 - A / (2 * k) - 2 * A ^ 2 / k ^ 2)
      = (A - B) * (2 * k - (A + B) * (k ^ 2 - 8)) / (4 * k ^ 2) := by
    field_simp; ring
  rw [e]
  apply div_nonneg _ (by positivity)
  apply mul_nonneg (by linarith)
  rcases le_or_gt (k ^ 2) 8 with h8 | h8
  · nlinarith
  · have : (A + B) * (k ^ 2 - 8) ≤ (k / 2) * (k ^ 2 - 8) :=
      mul_le_mul_of_nonneg_right (by linarith) (by linarith)
    nlinarith

/-- The final step of the zonal bound: with `A_lo ≤ A ≤ k/4` and `A' = 1 - A² - 3A/k ≥ 0`,
`4A'² + T(A) < 0` for `0 < k`, `9k² ≤ 88`. -/
theorem zonal_final (k A : ℝ) (hk : 0 < k) (hk88 : 9 * k ^ 2 ≤ 88)
    (hlo : k / (3 / 2 + Real.sqrt (k ^ 2 + 25 / 4)) ≤ A) (hhi : A ≤ k / 4)
    (hAp : 0 ≤ 1 - A ^ 2 - 3 * A / k) :
    4 * (1 - A ^ 2 - 3 * A / k) ^ 2 + (A ^ 2 / 4 - A / (2 * k) - 2 * A ^ 2 / k ^ 2) < 0 := by
  set s := Real.sqrt (k ^ 2 + 25 / 4) with hsdef
  have hpos : 0 < k ^ 2 + 25 / 4 := by positivity
  have hs : 0 < s := Real.sqrt_pos.mpr hpos
  have hss : s ^ 2 = k ^ 2 + 25 / 4 := Real.sq_sqrt hpos.le
  have hs52 : 5 / 2 < s := by nlinarith
  set Alo := k / (3 / 2 + s) with hAlo
  have hAlo0 : 0 ≤ Alo := by positivity
  -- A' decreases in A
  have hmono : 1 - A ^ 2 - 3 * A / k ≤ 1 - Alo ^ 2 - 3 * Alo / k := by
    have : 3 * Alo / k ≤ 3 * A / k := by
      apply div_le_div_of_nonneg_right _ hk.le; linarith
    nlinarith
  have hy : Alo / k = 2 / (2 * s + 3) := by
    rw [hAlo]; field_simp; ring
  have hAloy : Alo = k * (2 / (2 * s + 3)) := by
    rw [← hy]; field_simp
  have halpha : 1 - Alo ^ 2 - 3 * Alo / k = 16 / (2 * s + 3) ^ 2 := by
    rw [← alpha_identity s hs, hAloy]
    have : k ≠ 0 := hk.ne'
    have hk2 : k ^ 2 = s ^ 2 - 25 / 4 := by linarith
    field_simp
    rw [hk2]; ring
  have hT := T_antitone k A Alo hk (by linarith) hAlo0 hlo hhi
  have hTlo : Alo ^ 2 / 4 - Alo / (2 * k) - 2 * Alo ^ 2 / k ^ 2
      = (s ^ 2 - 25 / 4) * (2 / (2 * s + 3)) ^ 2 / 4 - (2 / (2 * s + 3)) / 2
          - 2 * (2 / (2 * s + 3)) ^ 2 := by
    rw [hAloy]
    have : k ≠ 0 := hk.ne'
    have hk2 : k ^ 2 = s ^ 2 - 25 / 4 := by linarith
    field_simp
    rw [hk2]; ring
  have hsq : (1 - A ^ 2 - 3 * A / k) ^ 2 ≤ (16 / (2 * s + 3) ^ 2) ^ 2 := by
    rw [← halpha]; exact pow_le_pow_left₀ hAp hmono 2
  have hphi := phi_neg s hs52 (by nlinarith)
  rw [← phi_identity s hs] at hphi
  linarith
end YangMills.StrongCoupling

end Part13_ZonalBound

section Part14_ForestDobrushinProofs

/-!
# Standalone copies of the theorems of the Dobrushin comparison

This part holds the four theorem declarations of Part 1 of Part 01 (`DobrushinComparison`), with their
proofs, in the namespace `YangMills.Response.ComparisonProofs`.

| original declaration | copy in this part |
|---|---|
| `YangMills.StrongCoupling.Comparison.comparison_weighted` | `YangMills.Response.ComparisonProofs.comparison_weighted` |
| `YangMills.StrongCoupling.Comparison.comparison_empty` | `YangMills.Response.ComparisonProofs.comparison_empty` |
| `YangMills.StrongCoupling.Comparison.decay_rowweighted` | `YangMills.Response.ComparisonProofs.decay_rowweighted` |
| `YangMills.StrongCoupling.Comparison.sup_bound` | `YangMills.Response.ComparisonProofs.sup_bound` |

What is copied:
* The declarations below are the original module from its `open` line to its `end` line.
* Only the namespace is changed.
* The module they come from imported Mathlib only, so the copied proofs do not use the original
  declarations.
* Part 15 checks that each copy proves the same proposition as the original declaration.

Scope:
* These theorems are the arithmetic half of Lemma `comparison` of the forest-gauge paper, for a
  finite index set.
* The coupling half is not formalised in this part; it is the remaining part of G1 (see Part 01).
* No Lean declaration states Lemma J or Lemma HR of the accompanying notes.
-/

open Finset Real

namespace YangMills.Response.ComparisonProofs

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- **Column-weighted comparison.** The arithmetic of Lemma `comparison`. -/
theorem comparison_weighted (S : Finset ι) (C : ι → ι → ℝ) (w ρ : ι → ℝ)
    (θ D : ℝ) (hθ : θ < 1) (hθ0 : 0 ≤ θ)
    (hC : ∀ e e', 0 ≤ C e e') (hw : ∀ e, 0 ≤ w e) (hρ : ∀ e, 0 ≤ ρ e)
    (hρS : ∀ z ∈ S, ρ z ≤ D)
    (hmin : ∀ e ∉ S, ρ e ≤ ∑ e', C e e' * ρ e')
    (hcol : ∀ e', ∑ e, w e * C e e' ≤ θ * w e') :
    ∑ e ∈ Sᶜ, w e * ρ e ≤ θ * D / (1 - θ) * ∑ z ∈ S, w z := by
  set X := ∑ e ∈ Sᶜ, w e * ρ e
  set Y := ∑ z ∈ S, w z * ρ z
  -- Step 1: X ≤ θ (X + Y).
  have h1 : X ≤ ∑ e ∈ Sᶜ, w e * ∑ e', C e e' * ρ e' := by
    apply sum_le_sum
    intro e he
    exact mul_le_mul_of_nonneg_left (hmin e (by simpa using he)) (hw e)
  have h2 : ∑ e ∈ Sᶜ, w e * ∑ e', C e e' * ρ e' ≤ ∑ e, w e * ∑ e', C e e' * ρ e' := by
    apply sum_le_sum_of_subset_of_nonneg (subset_univ _)
    intro e _ _
    exact mul_nonneg (hw e) (sum_nonneg fun e' _ => mul_nonneg (hC e e') (hρ e'))
  have h3 : ∑ e, w e * ∑ e', C e e' * ρ e' = ∑ e', (∑ e, w e * C e e') * ρ e' := by
    simp_rw [mul_sum, sum_mul]
    rw [sum_comm]
    refine sum_congr rfl fun _ _ => sum_congr rfl fun _ _ => by ring
  have h4 : ∑ e', (∑ e, w e * C e e') * ρ e' ≤ ∑ e', θ * (w e' * ρ e') := by
    apply sum_le_sum
    intro e' _
    calc (∑ e, w e * C e e') * ρ e' ≤ (θ * w e') * ρ e' :=
          mul_le_mul_of_nonneg_right (hcol e') (hρ e')
      _ = θ * (w e' * ρ e') := by ring
  have h5 : ∑ e', θ * (w e' * ρ e') = θ * (X + Y) := by
    rw [← mul_sum, ← sum_compl_add_sum S]
  have hX : X ≤ θ * (X + Y) := by linarith
  -- Step 2: Y ≤ D ∑ w.
  have hY : Y ≤ D * ∑ z ∈ S, w z := by
    rw [mul_sum]
    apply sum_le_sum
    intro z hz
    calc w z * ρ z ≤ w z * D := mul_le_mul_of_nonneg_left (hρS z hz) (hw z)
      _ = D * w z := by ring
  -- Step 3: solve.
  have hpos : 0 < 1 - θ := by linarith
  have hX' : X * (1 - θ) ≤ θ * Y := by linarith
  have hXle : X ≤ θ * Y / (1 - θ) := by rw [le_div_iff₀ hpos]; linarith
  calc X ≤ θ * Y / (1 - θ) := hXle
    _ ≤ θ * (D * ∑ z ∈ S, w z) / (1 - θ) := by
        apply div_le_div_of_nonneg_right _ hpos.le
        exact mul_le_mul_of_nonneg_left hY hθ0
    _ = θ * D / (1 - θ) * ∑ z ∈ S, w z := by ring

/-- With `S = ∅` and positive weights, the distances vanish: uniqueness. -/
theorem comparison_empty (C : ι → ι → ℝ) (w ρ : ι → ℝ) (θ : ℝ) (hθ : θ < 1) (hθ0 : 0 ≤ θ)
    (hC : ∀ e e', 0 ≤ C e e') (hw : ∀ e, 0 < w e) (hρ : ∀ e, 0 ≤ ρ e)
    (hmin : ∀ e, ρ e ≤ ∑ e', C e e' * ρ e')
    (hcol : ∀ e', ∑ e, w e * C e e' ≤ θ * w e') :
    ∀ e, ρ e = 0 := by
  have h := comparison_weighted (∅ : Finset ι) C w ρ θ 0 hθ hθ0 hC (fun e => (hw e).le) hρ
    (by simp) (fun e _ => hmin e) hcol
  simp only [compl_empty, sum_empty, mul_zero] at h
  have hz := (sum_eq_zero_iff_of_nonneg (fun e _ => mul_nonneg (hw e).le (hρ e))).mp
    (le_antisymm h (sum_nonneg fun e _ => mul_nonneg (hw e).le (hρ e)))
  intro e
  have := hz e (mem_univ e)
  rcases mul_eq_zero.mp this with h0 | h0
  · exact absurd h0 (hw e).ne'
  · exact h0

omit [DecidableEq ι] in
/-- **Row-weighted decay** (Bassalygo–Dobrushin form). `d` is a pseudometric (only the
triangle inequality through `k` and `0 ≤ m` are used). -/
theorem decay_rowweighted [Nonempty ι] (C : ι → ι → ℝ) (ρ b : ι → ℝ) (d : ι → ι → ℝ)
    (k : ι) (m α B : ℝ) (hm : 0 ≤ m) (hα : α < 1)
    (hC : ∀ i j, 0 ≤ C i j) (hρ : ∀ i, 0 ≤ ρ i)
    (htri : ∀ i j, d i k ≤ d i j + d j k)
    (hrec : ∀ i, ρ i ≤ ∑ j, C i j * ρ j + b i)
    (hb : ∀ i, b i ≤ B * exp (-(m * d i k)))
    (hrow : ∀ i, ∑ j, C i j * exp (m * d i j) ≤ α) :
    ∀ i, ρ i ≤ B / (1 - α) * exp (-(m * d i k)) := by
  -- M = max over i of ρ i · exp (m d i k)
  set f : ι → ℝ := fun i => ρ i * exp (m * d i k)
  obtain ⟨i₀, -, hi₀⟩ := exists_max_image (univ : Finset ι) f univ_nonempty
  set M := f i₀
  have hf0 : ∀ i, 0 ≤ f i := fun i => mul_nonneg (hρ i) (exp_pos _).le
  have hM0 : 0 ≤ M := hf0 i₀
  have hfM : ∀ i, f i ≤ M := fun i => hi₀ i (mem_univ i)
  have key : ∀ i, f i ≤ α * M + B := by
    intro i
    have e1 : f i ≤ (∑ j, C i j * ρ j + b i) * exp (m * d i k) :=
      mul_le_mul_of_nonneg_right (hrec i) (exp_pos _).le
    have e2 : b i * exp (m * d i k) ≤ B := by
      calc b i * exp (m * d i k) ≤ B * exp (-(m * d i k)) * exp (m * d i k) :=
            mul_le_mul_of_nonneg_right (hb i) (exp_pos _).le
        _ = B := by rw [mul_assoc, ← exp_add]; simp
    have e3 : ∀ j, C i j * ρ j * exp (m * d i k) ≤ C i j * exp (m * d i j) * M := by
      intro j
      have hexp : exp (m * d i k) ≤ exp (m * d i j) * exp (m * d j k) := by
        rw [← exp_add]
        apply exp_le_exp.mpr
        have := mul_le_mul_of_nonneg_left (htri i j) hm
        linarith
      calc C i j * ρ j * exp (m * d i k)
          ≤ C i j * ρ j * (exp (m * d i j) * exp (m * d j k)) :=
            mul_le_mul_of_nonneg_left hexp (mul_nonneg (hC i j) (hρ j))
        _ = C i j * exp (m * d i j) * f j := by simp only [f]; ring
        _ ≤ C i j * exp (m * d i j) * M :=
            mul_le_mul_of_nonneg_left (hfM j) (mul_nonneg (hC i j) (exp_pos _).le)
    have e4 : (∑ j, C i j * ρ j) * exp (m * d i k) ≤ α * M := by
      rw [sum_mul]
      calc ∑ j, C i j * ρ j * exp (m * d i k) ≤ ∑ j, C i j * exp (m * d i j) * M :=
            sum_le_sum fun j _ => e3 j
        _ = (∑ j, C i j * exp (m * d i j)) * M := by rw [sum_mul]
        _ ≤ α * M := mul_le_mul_of_nonneg_right (hrow i) hM0
    calc f i ≤ (∑ j, C i j * ρ j + b i) * exp (m * d i k) := e1
      _ = (∑ j, C i j * ρ j) * exp (m * d i k) + b i * exp (m * d i k) := by ring
      _ ≤ α * M + B := add_le_add e4 e2
  have hpos : 0 < 1 - α := by linarith
  have hMB : M ≤ B / (1 - α) := by
    rw [le_div_iff₀ hpos]; have := key i₀; linarith
  intro i
  have hi : ρ i * exp (m * d i k) ≤ B / (1 - α) := (hfM i).trans hMB
  have hE : 0 < exp (m * d i k) := exp_pos _
  calc ρ i = ρ i * exp (m * d i k) * exp (-(m * d i k)) := by
        rw [mul_assoc, ← exp_add]; simp
    _ ≤ B / (1 - α) * exp (-(m * d i k)) :=
        mul_le_mul_of_nonneg_right hi (exp_pos _).le

omit [DecidableEq ι] in
/-- The case `m = 0`: a uniform bound `ρ ≤ B / (1 - α)`. -/
theorem sup_bound [Nonempty ι] (C : ι → ι → ℝ) (ρ b : ι → ℝ) (α B : ℝ) (hα : α < 1)
    (hC : ∀ i j, 0 ≤ C i j) (hρ : ∀ i, 0 ≤ ρ i)
    (hrec : ∀ i, ρ i ≤ ∑ j, C i j * ρ j + b i) (hb : ∀ i, b i ≤ B)
    (hrow : ∀ i, ∑ j, C i j ≤ α) :
    ∀ i, ρ i ≤ B / (1 - α) := by
  intro i
  have := decay_rowweighted C ρ b (fun _ _ => 0) (Classical.arbitrary ι) 0 α B le_rfl hα hC hρ
    (fun _ _ => by simp) hrec (fun i => by simpa using hb i) (fun i => by simpa using hrow i) i
  simpa using this

end YangMills.Response.ComparisonProofs

