estimates (D), (E) and the mass gap remain open. -/
theorem nonvacuity_thmR3 :
    (∀ k (y : ES (k + 1)), rV k (rR k y) = y) ∧ (0 : ℝ) < 2 ∧ (0 : ℝ) ≤ 1 ∧ (0 : ℝ) ≤ 4 ∧
      (0 : ℝ) ≤ 4 ∧ (0 : ℝ) ≤ 1 ∧
      (∀ k (z : ES (k + 1)), rN k (rR k z) ≤ 4 * rN (k + 1) z) ∧
      (∀ k (z : ES (k + 1)), rG k (rR k z) ≤ 4 * rN (k + 1) z) ∧
      (∀ k (y : ES k), rG k y ≤ 1 * rN k y) ∧
      (∀ i < 3, (4 + 1 * 4 + 2 * (1 + 1 * 1) : ℝ) * 4 ^ i + rδ (i + 1) ≤ 2 * rδ i) ∧
      0 ≤ rδ 3 ∧
      (∀ u ∈ U rR 3 1, ValueOnly rR rN rG 2 1 0 u) ∧
      (∀ k, ∀ u ∈ U rR 3 (k + 2), TwoTerm rR rN rG 2 1 (k + 1) u) ∧
      (∀ i < 3, 0 ≤ rδ i) ∧ (0 : ℝ) ≤ 1 ∧
      (∀ k (z : ES (k + 1)), 2 * rN (k + 1) z ≤ rN k (rR k z)) ∧
      (∀ k (y : ES k), rN (k + 1) (rV k y) ≤ 1 * rN k y) ∧
      Composes rR rV rN rG 3 2 1 rδ ∧
      (∀ k (y : ES k), famRJ rR rV rN rG 3 2 1 rδ k y ≤
        (1 + 1 * 1 + (1 + 4 * 1) * ∑ i ∈ range 3, rδ i * 1 ^ i) * rN 0 (Tmap rR k y)) ∧
      (1 + 1 * 1 + (1 + 4 * 1) * ∑ i ∈ range 3, rδ i * 1 ^ i : ℝ) = 1052 ∧
      chan rR rV rN 2 2 eOne = 1 / 4 := by
  have hδrec : ∀ i < 3, (4 + 1 * 4 + 2 * (1 + 1 * 1) : ℝ) * 4 ^ i + rδ (i + 1) ≤ 2 * rδ i := by
    intro i hi
    interval_cases i <;> norm_num [rδ]
  have hδ3 : 0 ≤ rδ 3 := by norm_num [rδ]
  have hδ0 : ∀ i < 3, 0 ≤ rδ i := by
    intro i hi
    interval_cases i <;> norm_num [rδ]
  have hVO : ∀ u ∈ U rR 3 1, ValueOnly rR rN rG 2 1 0 u :=
    fun u _ => rescue_valueOnly 1 zero_le_one u
  have hTT : ∀ k, ∀ u ∈ U rR 3 (k + 2), TwoTerm rR rN rG 2 1 (k + 1) u := by
    intro k u hu
    refine rescue_twoTerm 1 (k + 1) u (fun hk => ?_)
    have hk0 : k = 0 := by omega
    subst hk0
    exact rescue_U32 hu
  have hcomp : Composes rR rV rN rG 3 2 1 rδ :=
    (thmRJ_family_iff rR rV rN rG rescue_VR (J := 3) (s := 2) (g := 1) (L := 4) (K := 4)
      (β := 1) (δ := rδ) two_pos zero_le_one (by norm_num) (by norm_num) zero_le_one rescue_L
      rescue_K rescue_g hδrec hδ3).2 ⟨hVO, hTT⟩
  have hloss := thmRJ_loss_bound rR rV rN rG (J := 3) (s := 2) (g := 1) (L := 4) (v := 1)
    (β := 1) (δ := rδ) two_pos zero_le_one hδ0 (by norm_num) zero_le_one zero_le_one rescue_low
    rescue_L rescue_V rescue_g
  have hconst : (1 + 1 * 1 + (1 + 4 * 1) * ∑ i ∈ range 3, rδ i * 1 ^ i : ℝ) = 1052 := by
    norm_num [Finset.sum_range_succ, rδ]
  exact ⟨rescue_VR, two_pos, zero_le_one, by norm_num, by norm_num, zero_le_one, rescue_L,
    rescue_K, rescue_g, hδrec, hδ3, hVO, hTT, hδ0, zero_le_one, rescue_low, rescue_V, hcomp,
