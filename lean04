/-- **Profile comparison (pure arithmetic).** For `u ∈ [0, 1]` and `0 ≤ P ≤ p ≤ 1`,
`|u(1−u)[N²(P + (1−P)u) + 1 + P]/(N²+2) − u(1−u)(p + (1−p)u)| ≤ (N²(p − P) + 1)/4/(N² + 2)`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem profile_diff_bound {N u P p : ℝ} (hu0 : 0 ≤ u) (hu1 : u ≤ 1) (hP0 : 0 ≤ P)
    (hPp : P ≤ p) (hp1 : p ≤ 1) :
    |u * (1 - u) * (N ^ 2 * (P + (1 - P) * u) + 1 + P) / (N ^ 2 + 2) -
        u * (1 - u) * (p + (1 - p) * u)| ≤ (N ^ 2 * (p - P) + 1) / 4 / (N ^ 2 + 2) := by
  have hd : 0 < N ^ 2 + 2 := by positivity
  have e : u * (1 - u) * (N ^ 2 * (P + (1 - P) * u) + 1 + P) / (N ^ 2 + 2) -
      u * (1 - u) * (p + (1 - p) * u) =
      u * (1 - u) * (-(N ^ 2 * (p - P) * (1 - u)) + (1 + P - 2 * p - 2 * (1 - p) * u)) /
        (N ^ 2 + 2) := by
    field_simp
    ring
  rw [e, abs_div, abs_of_pos hd]
  apply div_le_div_of_nonneg_right _ hd.le
  have hX0 : 0 ≤ u * (1 - u) := mul_nonneg hu0 (by linarith)
  have hX1 : u * (1 - u) ≤ 1 / 4 := by nlinarith [sq_nonneg (u - 1 / 2)]
  have hNd : 0 ≤ N ^ 2 * (p - P) := mul_nonneg (sq_nonneg N) (by linarith)
  have h1 : 0 ≤ N ^ 2 * (p - P) * u := mul_nonneg hNd hu0
  have h2 : 0 ≤ N ^ 2 * (p - P) * (1 - u) := mul_nonneg hNd (by linarith)
  have h3 : 0 ≤ (1 - p) * u := mul_nonneg (by linarith) hu0
  have hb : |-(N ^ 2 * (p - P) * (1 - u)) + (1 + P - 2 * p - 2 * (1 - p) * u)| ≤
      N ^ 2 * (p - P) + 1 := by
    rw [abs_le]
    constructor <;> nlinarith
  rw [abs_mul, abs_of_nonneg hX0]
  calc u * (1 - u) * |-(N ^ 2 * (p - P) * (1 - u)) + (1 + P - 2 * p - 2 * (1 - p) * u)|
      ≤ 1 / 4 * (N ^ 2 * (p - P) + 1) := mul_le_mul hX1 hb (abs_nonneg _) (by norm_num)
    _ = (N ^ 2 * (p - P) + 1) / 4 := by ring

/-- **Uniform closeness of the profiles:** for `N ≥ 2` and `u ∈ [0, 1]`,
`|g_N(u) − f(u)| ≤ (N²(p_∞ − p_N) + 1)/4/(N² + 2)`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem splineProfile_sub_limitProfile {N u : ℝ} (hN : 2 ≤ N) (hu0 : 0 ≤ u) (hu1 : u ≤ 1) :
    |splineProfile N u - limitProfile u| ≤
      (N ^ 2 * (limitRoot - splineRoot N) + 1) / 4 / (N ^ 2 + 2) := by
  have hN1 : (1 : ℝ) < N := by linarith
  have hδ := limitRoot_sub_splineRoot_bounds hN1
  have h3 := sqrt3_bounds
  unfold splineProfile limitProfile
  exact profile_diff_bound hu0 hu1 (splineRoot_pos hN1).le (by linarith)
    (by unfold limitRoot; linarith)

/-- **A grid point near the maximiser:** for `n ≥ 2` some `t ≤ n` has
`f* − f(t/n) ≤ (√3 − 1)(1 − w)/4/n²`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem exists_grid_near_argmax (n : ℕ) (hn : 2 ≤ n) :
    ∃ t : ℕ, t ≤ n ∧
      limitMax - limitProfile ((t : ℝ) / n) ≤
        (√3 - 1) * (1 - limitThirdRoot) / 4 / (n : ℝ) ^ 2 := by
  have hr := limit_roots_bounds
  have h3 := sqrt3_bounds
  have hn0 : (2 : ℝ) ≤ n := by exact_mod_cast hn
  have hnpos : (0 : ℝ) < n := by linarith
  have ha0 : 0 ≤ (n : ℝ) * limitArgmax + 1 / 2 := by nlinarith
  have hfl1 : (⌊(n : ℝ) * limitArgmax + 1 / 2⌋₊ : ℝ) ≤ (n : ℝ) * limitArgmax + 1 / 2 :=
    Nat.floor_le ha0
  have hfl2 : (n : ℝ) * limitArgmax + 1 / 2 < ⌊(n : ℝ) * limitArgmax + 1 / 2⌋₊ + 1 :=
    Nat.lt_floor_add_one _
  have hle : (⌊(n : ℝ) * limitArgmax + 1 / 2⌋₊ : ℝ) ≤ n := by nlinarith
  refine ⟨⌊(n : ℝ) * limitArgmax + 1 / 2⌋₊, by exact_mod_cast hle, ?_⟩
  set m : ℝ := (⌊(n : ℝ) * limitArgmax + 1 / 2⌋₊ : ℝ) with hm
  have hu1 : m / n ≤ 1 := (div_le_one hnpos).mpr hle
  have hdist : (m / n - limitArgmax) ^ 2 ≤ 1 / (4 * (n : ℝ) ^ 2) := by
    have e : m / n - limitArgmax = (m - n * limitArgmax) / n := by field_simp
    rw [e, div_pow, div_le_div_iff₀ (by positivity) (by positivity)]
    have hl : -(1 / 2) < m - n * limitArgmax := by linarith
    have hu : m - n * limitArgmax ≤ 1 / 2 := by linarith
    have hsq : (m - n * limitArgmax) ^ 2 ≤ 1 / 4 := by
      nlinarith [mul_nonneg (by linarith : (0 : ℝ) ≤ 1 / 2 - (m - n * limitArgmax))
        (by linarith : (0 : ℝ) ≤ 1 / 2 + (m - n * limitArgmax))]
    nlinarith [mul_nonneg (sub_nonneg.mpr hsq) (sq_nonneg (n : ℝ))]
  rw [limitMax_sub_limitProfile]
  have hq : 0 < √3 - 1 := by linarith
  have hu0 : 0 ≤ m / n := by positivity
  have huw0 : 0 ≤ m / n - limitThirdRoot := by linarith
  have huw1 : m / n - limitThirdRoot ≤ 1 - limitThirdRoot := by linarith
  calc (√3 - 1) * (m / n - limitArgmax) ^ 2 * (m / n - limitThirdRoot)
      ≤ (√3 - 1) * (1 / (4 * (n : ℝ) ^ 2)) * (1 - limitThirdRoot) :=
        mul_le_mul (mul_le_mul_of_nonneg_left hdist hq.le) huw1 huw0
          (mul_nonneg hq.le (by positivity))
    _ = (√3 - 1) * (1 - limitThirdRoot) / 4 / (n : ℝ) ^ 2 := by field_simp

/-- **`G_n` is close to `f*`:** for `n ≥ 2`,
`|G_n − f*| ≤ (n²(p_∞ − p_n) + 1)/4/(n² + 2) + (√3 − 1)(1 − w)/4/n²`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem splineMax_sub_limitMax (n : ℕ) (hn : 2 ≤ n) :
    |splineMax n - limitMax| ≤
      ((n : ℝ) ^ 2 * (limitRoot - splineRoot n) + 1) / 4 / ((n : ℝ) ^ 2 + 2) +
        (√3 - 1) * (1 - limitThirdRoot) / 4 / (n : ℝ) ^ 2 := by
  have hn0 : (2 : ℝ) ≤ n := by exact_mod_cast hn
  have hnpos : (0 : ℝ) < n := by linarith
  have hr := limit_roots_bounds
  have h3 := sqrt3_bounds
  have hC : 0 ≤ (√3 - 1) * (1 - limitThirdRoot) / 4 / (n : ℝ) ^ 2 :=
    div_nonneg (div_nonneg (mul_nonneg (by linarith) (by linarith)) (by norm_num))
      (by positivity)
  have hup : splineMax n ≤ limitMax +
      ((n : ℝ) ^ 2 * (limitRoot - splineRoot n) + 1) / 4 / ((n : ℝ) ^ 2 + 2) := by
    refine sup'_le _ _ fun t ht => ?_
    have ht' : (t : ℝ) ≤ n := by exact_mod_cast Nat.lt_succ_iff.mp (mem_range.mp ht)
    have hu0 : 0 ≤ (t : ℝ) / n := by positivity
    have hu1 : (t : ℝ) / n ≤ 1 := (div_le_one hnpos).mpr ht'
    have h1 := (abs_le.mp (splineProfile_sub_limitProfile hn0 hu0 hu1)).2
    have h2 := limitProfile_le hu0
    linarith
  obtain ⟨t₀, ht₀, hnear⟩ := exists_grid_near_argmax n hn
  have hlow : limitMax -
      ((n : ℝ) ^ 2 * (limitRoot - splineRoot n) + 1) / 4 / ((n : ℝ) ^ 2 + 2) -
      (√3 - 1) * (1 - limitThirdRoot) / 4 / (n : ℝ) ^ 2 ≤ splineMax n := by
    have hu0 : 0 ≤ (t₀ : ℝ) / n := by positivity
    have hu1 : (t₀ : ℝ) / n ≤ 1 := (div_le_one hnpos).mpr (by exact_mod_cast ht₀)
    have h1 := (abs_le.mp (splineProfile_sub_limitProfile hn0 hu0 hu1)).1
    have h2 : splineProfile n ((t₀ : ℝ) / n) ≤ splineMax n :=
      le_sup' (fun t : ℕ => splineProfile n ((t : ℝ) / n))
        (mem_range.mpr (Nat.lt_succ_of_le ht₀))
    linarith
  rw [abs_le]
  constructor <;> linarith

/-- `1 − 1/N² ≤ r_N` for `N ≥ 1`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem one_sub_le_splineRatio {N : ℝ} (hN : 1 ≤ N) : 1 - 1 / N ^ 2 ≤ splineRatio N := by
  have hpos : 0 < √(N ^ 2 + 2) := Real.sqrt_pos.mpr (by positivity)
  have hs : √(N ^ 2 + 2) ^ 2 = N ^ 2 + 2 := Real.sq_sqrt (by positivity)
  have hN2 : 1 ≤ N ^ 2 := by nlinarith
  rw [splineRatio, le_div_iff₀ hpos]
  apply le_of_sq_le_sq_of_nonneg (by linarith)
  have e : 1 - 1 / N ^ 2 = (N ^ 2 - 1) / N ^ 2 := by field_simp
  rw [mul_pow, hs, e, div_pow, div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
  nlinarith

/-- The numerical constant of the rate is at most `4`:
`2√3 [((4/3)(2√3 − 3) + 1)/4 + (√3 − 1)(1 − w)/4 + f*] ≤ 4`. (Its exact value
`(25 − 7√3 + 5√6 − 5√2)/6 ≈ 3.009` is for illustration; it is not part of the statement.)

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem rate_constant_le :
    2 * √3 * ((4 / 3 * (2 * √3 - 3) + 1) / 4 + (√3 - 1) * (1 - limitThirdRoot) / 4 + limitMax)
      ≤ 4 := by
  unfold limitThirdRoot limitMax
  have h3 := sqrt3_bounds
  have h2 := sqrt2_bounds
  have h6 := sqrt6_bounds
  have e33 : √3 * √3 = 3 := Real.mul_self_sqrt (by norm_num)
  have e36 : √3 * √6 = 3 * √2 := by rw [sqrt6_eq]; linear_combination √2 * e33
  have e333 : √3 * √3 * √3 = 3 * √3 := by rw [e33]
  have e336 : √3 * √3 * √6 = 3 * √6 := by rw [e33]
  nlinarith [e33, e36, e333, e336]

/-- **The rate:** for `n ≥ 2`, `|1 + 2√3 r_n G_n − ℓ_∞| ≤ 4/n²`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem scalarLossN_rate (n : ℕ) (hn : 2 ≤ n) :
    |scalarLossN n - scalarLossLimit| ≤ 4 / (n : ℝ) ^ 2 := by
  have hN : (2 : ℝ) ≤ n := by exact_mod_cast hn
  have hN1 : (1 : ℝ) < n := by linarith
  have hnpos : (0 : ℝ) < n := by linarith
  have hN4 : (4 : ℝ) ≤ (n : ℝ) ^ 2 := by nlinarith
  obtain ⟨hδ0, hδ1⟩ := limitRoot_sub_splineRoot_bounds hN1
  have hG := splineMax_sub_limitMax n hn
  have hr0 := splineRatio_bounds hnpos.le
  have hr1 := one_sub_le_splineRatio hN1.le
  have h3 := sqrt3_bounds
  have h2 := sqrt2_bounds
  have h6 := sqrt6_bounds
  have hfs : 0 ≤ limitMax := by unfold limitMax; linarith
  have hq : 0 < 2 * √3 - 3 := by linarith
  have hNd : (n : ℝ) ^ 2 * (limitRoot - splineRoot n) ≤ 4 / 3 * (2 * √3 - 3) := by
    have hd : 0 < (n : ℝ) ^ 2 - 1 := by linarith
    calc (n : ℝ) ^ 2 * (limitRoot - splineRoot n)
        ≤ (n : ℝ) ^ 2 * ((2 * √3 - 3) / ((n : ℝ) ^ 2 - 1)) :=
          mul_le_mul_of_nonneg_left hδ1 (by positivity)
      _ ≤ 4 / 3 * (2 * √3 - 3) := by
          rw [mul_div_assoc', div_le_iff₀ hd]
          nlinarith
  have hE : ((n : ℝ) ^ 2 * (limitRoot - splineRoot n) + 1) / 4 / ((n : ℝ) ^ 2 + 2) ≤
      (4 / 3 * (2 * √3 - 3) + 1) / 4 / (n : ℝ) ^ 2 := by
    apply div_le_div₀ (by positivity) (by linarith) (by positivity) (by linarith)
  have hkey : |splineRatio n * splineMax n - limitMax| ≤
      |splineMax n - limitMax| + limitMax / (n : ℝ) ^ 2 := by
    have e : splineRatio n * splineMax n - limitMax =
        splineRatio n * (splineMax n - limitMax) - (1 - splineRatio n) * limitMax := by ring
    rw [e]
    refine (abs_sub _ _).trans ?_
    rw [abs_mul, abs_mul, abs_of_nonneg hr0.1,
      abs_of_nonneg (by linarith : 0 ≤ 1 - splineRatio n), abs_of_nonneg hfs]
    have h1 : splineRatio n * |splineMax n - limitMax| ≤ |splineMax n - limitMax| := by
      nlinarith [abs_nonneg (splineMax n - limitMax)]
    have h2 : (1 - splineRatio n) * limitMax ≤ limitMax / (n : ℝ) ^ 2 := by
      have h' : 1 - splineRatio n ≤ 1 / (n : ℝ) ^ 2 := by linarith
      calc (1 - splineRatio n) * limitMax ≤ 1 / (n : ℝ) ^ 2 * limitMax :=
            mul_le_mul_of_nonneg_right h' hfs
        _ = limitMax / (n : ℝ) ^ 2 := by ring
    linarith
  rw [← one_add_limitMax]
  unfold scalarLossN
  have e : 1 + 2 * √3 * splineRatio n * splineMax n - (1 + 2 * √3 * limitMax) =
      2 * √3 * (splineRatio n * splineMax n - limitMax) := by ring
  have h3p : 0 < 2 * √3 := by linarith
  rw [e, abs_mul, abs_of_pos h3p]
  have hsum : |splineRatio n * splineMax n - limitMax| ≤
      ((4 / 3 * (2 * √3 - 3) + 1) / 4 + (√3 - 1) * (1 - limitThirdRoot) / 4 + limitMax) /
        (n : ℝ) ^ 2 := by
    have : ((4 / 3 * (2 * √3 - 3) + 1) / 4 + (√3 - 1) * (1 - limitThirdRoot) / 4 + limitMax) /
        (n : ℝ) ^ 2 = (4 / 3 * (2 * √3 - 3) + 1) / 4 / (n : ℝ) ^ 2 +
          (√3 - 1) * (1 - limitThirdRoot) / 4 / (n : ℝ) ^ 2 + limitMax / (n : ℝ) ^ 2 := by
      ring
    rw [this]
    linarith
  calc 2 * √3 * |splineRatio n * splineMax n - limitMax|
      ≤ 2 * √3 * (((4 / 3 * (2 * √3 - 3) + 1) / 4 + (√3 - 1) * (1 - limitThirdRoot) / 4 +
          limitMax) / (n : ℝ) ^ 2) := mul_le_mul_of_nonneg_left hsum h3p.le
    _ = 2 * √3 * ((4 / 3 * (2 * √3 - 3) + 1) / 4 + (√3 - 1) * (1 - limitThirdRoot) / 4 +
          limitMax) / (n : ℝ) ^ 2 := by ring
    _ ≤ 4 / (n : ℝ) ^ 2 := div_le_div_of_nonneg_right rate_constant_le (by positivity)

/-- **The rate `|ℓ_k − ℓ_∞| ≤ 4·4^{−k}`** for every `k`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem scalarLoss_rate (k : ℕ) : |scalarLoss k - scalarLossLimit| ≤ 4 * (1 / 4) ^ k := by
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · rw [scalarLoss_zero, pow_zero, mul_one, abs_le]
    unfold scalarLossLimit
    have h3 := sqrt3_bounds
    have h2 := sqrt2_bounds
    have h6 := sqrt6_bounds
    constructor <;> linarith
  · have hn : 2 ≤ 2 ^ k := by
      calc 2 = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ k := Nat.pow_le_pow_right (by norm_num) hk
    have h := scalarLossN_rate (2 ^ k) hn
    unfold scalarLoss
    refine h.trans (le_of_eq ?_)
    have e : (((2 ^ k : ℕ) : ℝ)) ^ 2 = 4 ^ k := by
      push_cast; rw [← pow_mul, mul_comm, pow_mul]; norm_num
    rw [e, _root_.one_div_pow]
    ring

/-- **Geometric increments:** `|ℓ_{k+1} − ℓ_k| ≤ 5·4^{−k}`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem scalarLoss_increment (k : ℕ) :
    |scalarLoss (k + 1) - scalarLoss k| ≤ 5 * (1 / 4) ^ k := by
  have h1 := scalarLoss_rate (k + 1)
  have h2 := scalarLoss_rate k
  have e : scalarLoss (k + 1) - scalarLoss k =
      (scalarLoss (k + 1) - scalarLossLimit) - (scalarLoss k - scalarLossLimit) := by ring
  rw [e]
  refine (abs_sub _ _).trans ?_
  rw [pow_succ] at h1
  linarith

/-- **The limit `ℓ_k → ℓ_∞ = (2 + √3 + √6 − √2)/3`.**

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem tendsto_scalarLoss : Tendsto scalarLoss atTop (𝓝 scalarLossLimit) := by
  rw [tendsto_iff_norm_sub_tendsto_zero]
  have h0 : Tendsto (fun k : ℕ => 4 * (1 / 4 : ℝ) ^ k) atTop (𝓝 0) := by
    simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 4)
      (by norm_num)).const_mul 4
  exact squeeze_zero (fun k => norm_nonneg _) (fun k => by
    rw [Real.norm_eq_abs]; exact scalarLoss_rate k) h0

end Spline


/-! ## 6. Assembly: a uniform bound from a one-shot Poincaré inequality and column decay -/

section Assembly

/-- `b⁴ − a⁴ ≤ 4b³(b − a)` for `0 ≤ a ≤ b`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem pow_four_sub_le {a b : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) :
    b ^ 4 - a ^ 4 ≤ 4 * b ^ 3 * (b - a) := by
  have hb : 0 ≤ b := ha.trans hab
  have h1 : b ^ 2 * a ≤ b ^ 3 := by nlinarith [mul_le_mul_of_nonneg_left hab (sq_nonneg b)]
  have h2 : b * a ^ 2 ≤ b ^ 3 := by nlinarith [mul_le_mul_of_nonneg_left (pow_le_pow_left₀ ha hab 2) hb]
  have h3 : a ^ 3 ≤ b ^ 3 := pow_le_pow_left₀ ha hab 3
  have e : b ^ 4 - a ^ 4 = (b - a) * (b ^ 3 + b ^ 2 * a + b * a ^ 2 + a ^ 3) := by ring
  rw [e]
  nlinarith [mul_le_mul_of_nonneg_left (by linarith : b ^ 3 + b ^ 2 * a + b * a ^ 2 + a ^ 3 ≤
    4 * b ^ 3) (sub_nonneg.mpr hab)]

/-- **Lattice-shell count (the arithmetic).** For real `t ≥ 1` and `M ≥ 1`:
`4((2(t+1)M − 1)⁴ − (2tM − 1)⁴) ≤ 256 (t+1)³ M⁴` and `4(2M − 1)⁴ ≤ 256 (0+1)³ M⁴`. The statement
is these two real inequalities. Their intended reading (not formalised): with `M = 2^k`, the
number of `ℤ⁴` points at `ℓ^∞` distance in `[tM, (t+1)M)` is `(2(t+1)M − 1)⁴ − (2tM − 1)⁴` for
`t ≥ 1` and `(2M − 1)⁴` for `t = 0`, so with four links per site each annulus has at most
`256 (t+1)³ M⁴` links.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem shell_count_le (t M : ℝ) (ht : 1 ≤ t) (hM : 1 ≤ M) :
    4 * ((2 * (t + 1) * M - 1) ^ 4 - (2 * t * M - 1) ^ 4) ≤ 256 * (t + 1) ^ 3 * M ^ 4 ∧
      4 * (2 * M - 1) ^ 4 ≤ 256 * (0 + 1) ^ 3 * M ^ 4 := by
  constructor
  · have ha : 0 ≤ 2 * t * M - 1 := by nlinarith
    have hab : 2 * t * M - 1 ≤ 2 * (t + 1) * M - 1 := by nlinarith
    have h := pow_four_sub_le ha hab
    have hb0 : 0 ≤ 2 * (t + 1) * M - 1 := ha.trans hab
    have hb : 2 * (t + 1) * M - 1 ≤ 2 * (t + 1) * M := by linarith
    have hb3 : (2 * (t + 1) * M - 1) ^ 3 ≤ (2 * (t + 1) * M) ^ 3 := pow_le_pow_left₀ hb0 hb 3
    have e : (2 * (t + 1) * M - 1) - (2 * t * M - 1) = 2 * M := by ring
    rw [e] at h
    have hM0 : 0 ≤ M := by linarith
    nlinarith [mul_le_mul_of_nonneg_right hb3 (by linarith : (0 : ℝ) ≤ 8 * M)]
  · have h0 : 0 ≤ 2 * M - 1 := by linarith
    have h4 : (2 * M - 1) ^ 4 ≤ (2 * M) ^ 4 := pow_le_pow_left₀ h0 (by linarith) 4
    nlinarith

/-- **ℓ¹ from annular ℓ².** Let the fine sites be split into annuli `Ω_t = {ann = t}`,
`t < T`, with `|Ω_t| ≤ 256 (t+1)³ L⁴` (`L` any real; `L = 2^k` in the application). Then, by
Cauchy–Schwarz on each annulus,
`‖φ‖₁ ≤ 16 L² Σ_t (t+1)^{3/2} ‖φ 1_{Ω_t}‖₂`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem l1_le_annular {V : Type*} [Fintype V] (φ : V → ℝ) (ann : V → ℕ) (T : ℕ)
    (hT : ∀ v, ann v < T) (L : ℝ)
    (hcount : ∀ t : ℕ, ((univ.filter fun v => ann v = t).card : ℝ) ≤
      256 * ((t : ℝ) + 1) ^ 3 * L ^ 4) :
    l1 φ ≤ 16 * L ^ 2 * ∑ t ∈ range T, ((t : ℝ) + 1) * √((t : ℝ) + 1) *
      √(∑ v ∈ univ.filter (fun v => ann v = t), φ v ^ 2) := by
  have hfib : l1 φ = ∑ t ∈ range T, ∑ v ∈ univ.filter (fun v => ann v = t), |φ v| := by
    unfold l1
    exact (Finset.sum_fiberwise_of_maps_to (fun v _ => mem_range.mpr (hT v)) _).symm
  rw [hfib, mul_sum]
  refine sum_le_sum fun t _ => ?_
  have hcs := Real.sum_mul_le_sqrt_mul_sqrt (univ.filter fun v => ann v = t) (fun _ => (1 : ℝ))
    (fun v => |φ v|)
  simp only [one_mul, one_pow, sum_const, nsmul_eq_mul, mul_one, sq_abs] at hcs
  have hsq : √((univ.filter fun v => ann v = t).card : ℝ) ≤
      16 * L ^ 2 * (((t : ℝ) + 1) * √((t : ℝ) + 1)) := by
    rw [Real.sqrt_le_left (by positivity)]
    calc ((univ.filter fun v => ann v = t).card : ℝ) ≤ 256 * ((t : ℝ) + 1) ^ 3 * L ^ 4 :=
          hcount t
      _ = (16 * L ^ 2 * (((t : ℝ) + 1) * √((t : ℝ) + 1))) ^ 2 := by
          rw [mul_pow, mul_pow, mul_pow, Real.sq_sqrt (by positivity)]; ring
  calc ∑ v ∈ univ.filter (fun v => ann v = t), |φ v|
      ≤ √((univ.filter fun v => ann v = t).card : ℝ) *
          √(∑ v ∈ univ.filter (fun v => ann v = t), φ v ^ 2) := hcs
    _ ≤ 16 * L ^ 2 * (((t : ℝ) + 1) * √((t : ℝ) + 1)) *
          √(∑ v ∈ univ.filter (fun v => ann v = t), φ v ^ 2) :=
        mul_le_mul_of_nonneg_right hsq (Real.sqrt_nonneg _)
    _ = 16 * L ^ 2 * (((t : ℝ) + 1) * √((t : ℝ) + 1) *
          √(∑ v ∈ univ.filter (fun v => ann v = t), φ v ^ 2)) := by ring

/-- `6 binom(t+3, 3) = (t+3)(t+2)(t+1)`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem choose_three_mul_six (t : ℕ) :
    (((t + 3).choose 3 : ℕ) : ℝ) * 6 = ((t : ℝ) + 3) * ((t : ℝ) + 2) * ((t : ℝ) + 1) := by
  have h1 : (t + 3) * (t + 2).choose 2 = (t + 3).choose 3 * 3 := Nat.add_one_mul_choose_eq (t + 2) 2
  have h2 : (t + 2) * (t + 1).choose 1 = (t + 2).choose 2 * 2 := Nat.add_one_mul_choose_eq (t + 1) 1
  rw [Nat.choose_one_right] at h2
  have h1' : ((t : ℝ) + 3) * (((t + 2).choose 2 : ℕ) : ℝ) = (((t + 3).choose 3 : ℕ) : ℝ) * 3 := by
    exact_mod_cast h1
  have h2' : ((t : ℝ) + 2) * ((t : ℝ) + 1) = (((t + 2).choose 2 : ℕ) : ℝ) * 2 := by
    exact_mod_cast h2
  linear_combination (-2) * h1' + (-((t : ℝ) + 3)) * h2'

/-- `Σ_{t<T} (t+1)³ q^t ≤ 6/(1 − q)⁴` for `0 ≤ q < 1`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem sum_cube_geom_le {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (T : ℕ) :
    ∑ t ∈ range T, ((t : ℝ) + 1) ^ 3 * q ^ t ≤ 6 / (1 - q) ^ 4 := by
  have hs := hasSum_choose_mul_geometric_of_norm_lt_one (𝕜 := ℝ) 3 (r := q)
    (by rw [Real.norm_eq_abs, abs_of_nonneg hq0]; exact hq1)
  have hterm : ∀ t : ℕ, ((t : ℝ) + 1) ^ 3 * q ^ t ≤
      6 * ((((t + 3).choose 3 : ℕ) : ℝ) * q ^ t) := by
    intro t
    have hc := choose_three_mul_six t
    have hqt : 0 ≤ q ^ t := pow_nonneg hq0 t
    have ht : 0 ≤ (t : ℝ) := Nat.cast_nonneg t
    have hle : ((t : ℝ) + 1) ^ 3 ≤ ((t : ℝ) + 3) * ((t : ℝ) + 2) * ((t : ℝ) + 1) := by nlinarith
    nlinarith
  have hsum := sum_le_hasSum (range T) (fun i _ => by positivity) hs
  calc ∑ t ∈ range T, ((t : ℝ) + 1) ^ 3 * q ^ t
      ≤ ∑ t ∈ range T, 6 * ((((t + 3).choose 3 : ℕ) : ℝ) * q ^ t) := sum_le_sum fun t _ => hterm t
    _ = 6 * ∑ t ∈ range T, (((t + 3).choose 3 : ℕ) : ℝ) * q ^ t := by rw [mul_sum]
    _ ≤ 6 * (1 / (1 - q) ^ (3 + 1)) := mul_le_mul_of_nonneg_left hsum (by norm_num)
    _ = 6 / (1 - q) ^ 4 := by ring

/-- **The series bound** `Σ_{t<T} (t+1)^{3/2} q^t ≤ √6 (1 − q)^{−5/2}` for `0 ≤ q < 1`
(Cauchy–Schwarz against `Σ q^t`, and `Σ (t+1)³ q^t ≤ 6/(1−q)⁴`).

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem sum_three_halves_geom_le {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (T : ℕ) :
    ∑ t ∈ range T, ((t : ℝ) + 1) * √((t : ℝ) + 1) * q ^ t ≤
      √6 / ((1 - q) ^ 2 * √(1 - q)) := by
  have hq : 0 < 1 - q := by linarith
  have hsplit : ∀ t : ℕ, ((t : ℝ) + 1) * √((t : ℝ) + 1) * q ^ t =
      (((t : ℝ) + 1) * √((t : ℝ) + 1) * √q ^ t) * √q ^ t := by
    intro t
    rw [mul_assoc _ (√q ^ t), ← mul_pow, Real.mul_self_sqrt hq0]
  rw [sum_congr rfl fun t _ => hsplit t]
  have hcs := Real.sum_mul_le_sqrt_mul_sqrt (range T)
    (fun t : ℕ => ((t : ℝ) + 1) * √((t : ℝ) + 1) * √q ^ t) (fun t : ℕ => √q ^ t)
  have ha2 : ∀ t : ℕ, (((t : ℝ) + 1) * √((t : ℝ) + 1) * √q ^ t) ^ 2 =
      ((t : ℝ) + 1) ^ 3 * q ^ t := by
    intro t
    rw [mul_pow, mul_pow, Real.sq_sqrt (by positivity), ← pow_mul, mul_comm t 2, pow_mul,
      Real.sq_sqrt hq0]
    ring
  have hb2 : ∀ t : ℕ, (√q ^ t) ^ 2 = q ^ t := by
    intro t
    rw [← pow_mul, mul_comm t 2, pow_mul, Real.sq_sqrt hq0]
  simp only [ha2, hb2] at hcs
  have hgeom : ∑ t ∈ range T, q ^ t ≤ 1 / (1 - q) := by
    have h := sum_le_hasSum (range T) (fun i _ => pow_nonneg hq0 i)
      (hasSum_geometric_of_lt_one hq0 hq1)
    rwa [one_div]
  have hcube := sum_cube_geom_le hq0 hq1 T
  calc ∑ t ∈ range T, ((t : ℝ) + 1) * √((t : ℝ) + 1) * √q ^ t * √q ^ t
      ≤ √(∑ t ∈ range T, ((t : ℝ) + 1) ^ 3 * q ^ t) * √(∑ t ∈ range T, q ^ t) := hcs
    _ ≤ √(6 / (1 - q) ^ 4) * √(1 / (1 - q)) :=
        mul_le_mul (Real.sqrt_le_sqrt hcube) (Real.sqrt_le_sqrt hgeom) (Real.sqrt_nonneg _)
          (Real.sqrt_nonneg _)
    _ = √6 / ((1 - q) ^ 2 * √(1 - q)) := by
        have e4 : √((1 - q) ^ 4) = (1 - q) ^ 2 := by
          rw [show (1 - q) ^ 4 = ((1 - q) ^ 2) ^ 2 by ring, Real.sqrt_sq (by positivity)]
        rw [Real.sqrt_div' 6 (by positivity), e4, Real.sqrt_div' 1 hq.le, Real.sqrt_one]
        field_simp

end Assembly

section L2Bound

variable {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [NormedAddCommGroup F] [InnerProductSpace ℝ F]

/-- **Vanishing first variation.** If `φ` minimises `Q = ‖D·‖²` on the affine set `φ + K`, then
`⟨Dφ, Dη⟩ = 0` for every `η ∈ K`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem first_variation_eq_zero (D : E →ₗ[ℝ] F) (K : Submodule ℝ E) {φ : E}
    (hM : ∀ η ∈ K, ‖D φ‖ ^ 2 ≤ ‖D (φ + η)‖ ^ 2) {η : E} (hη : η ∈ K) :
    inner ℝ (D φ) (D η) = 0 := by
  set a := inner ℝ (D φ) (D η) with ha
  set b := ‖D η‖ ^ 2 with hbdef
  have key : ∀ t : ℝ, 0 ≤ 2 * t * a + t ^ 2 * b := by
    intro t
    have h := hM (t • η) (K.smul_mem t hη)
    rw [map_add, map_smul, norm_add_sq_real, real_inner_smul_right, norm_smul, mul_pow,
      Real.norm_eq_abs, sq_abs] at h
    linarith
  have hb : 0 ≤ b := sq_nonneg _
  have hb1 : 0 < b + 1 := by linarith
  have h := key (-a / (b + 1))
  have e : 2 * (-a / (b + 1)) * a + (-a / (b + 1)) ^ 2 * b = -(a ^ 2 * (b + 2)) / (b + 1) ^ 2 := by
    field_simp
    ring
  rw [e] at h
  have h' := mul_nonneg h (sq_nonneg (b + 1))
  rw [div_mul_cancel₀ _ (by positivity)] at h'
  have ha2 : a ^ 2 ≤ 0 := by nlinarith [sq_nonneg a, mul_nonneg (sq_nonneg a) hb]
  exact (pow_eq_zero_iff two_ne_zero).mp (le_antisymm ha2 (sq_nonneg a))

/-- **Energy Pythagoras.** Under the minimality of `φ` on `φ + K`,
`Q(φ + η) = Q(φ) + Q(η)` for every `η ∈ K`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem energy_pythagoras (D : E →ₗ[ℝ] F) (K : Submodule ℝ E) {φ : E}
    (hM : ∀ η ∈ K, ‖D φ‖ ^ 2 ≤ ‖D (φ + η)‖ ^ 2) {η : E} (hη : η ∈ K) :
    ‖D (φ + η)‖ ^ 2 = ‖D φ‖ ^ 2 + ‖D η‖ ^ 2 := by
  rw [map_add, norm_add_sq_real, first_variation_eq_zero D K hM hη]
  ring

/-- **The `ℓ²` column bound.** Let `φ` minimise `Q = ‖D·‖²` on `φ + K` (minimality), let a
reference field `ψ ∈ φ + K` have `Q(ψ) ≤ q_R` and `‖ψ‖ ≤ p_R L`, and let the one-shot Poincaré
inequality `c_P ‖η‖² ≤ L² Q(η)` hold on `K` (`c_P > 0`, `L > 0`). Then
`Q(φ) + Q(ψ − φ) = Q(ψ)` and `‖φ‖ ≤ (p_R + √(q_R/c_P)) L`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem l2_column_bound (D : E →ₗ[ℝ] F) (K : Submodule ℝ E) {φ ψ : E} {L pR qR cP : ℝ}
    (hL : 0 < L) (hcP : 0 < cP) (hM : ∀ η ∈ K, ‖D φ‖ ^ 2 ≤ ‖D (φ + η)‖ ^ 2)
    (hψK : ψ - φ ∈ K) (hQψ : ‖D ψ‖ ^ 2 ≤ qR) (hpψ : ‖ψ‖ ≤ pR * L)
    (hP : ∀ η ∈ K, cP * ‖η‖ ^ 2 ≤ L ^ 2 * ‖D η‖ ^ 2) :
    ‖D φ‖ ^ 2 + ‖D (ψ - φ)‖ ^ 2 = ‖D ψ‖ ^ 2 ∧ ‖φ‖ ≤ (pR + √(qR / cP)) * L := by
  have hpy := energy_pythagoras D K hM hψK
  rw [show φ + (ψ - φ) = ψ by abel] at hpy
  refine ⟨hpy.symm, ?_⟩
  have hQ : ‖D (ψ - φ)‖ ^ 2 ≤ qR := by nlinarith [sq_nonneg ‖D φ‖]
  have h1 : ‖ψ - φ‖ ^ 2 ≤ L ^ 2 * (qR / cP) := by
    have h := hP _ hψK
    rw [mul_div_assoc', le_div_iff₀ hcP]
    nlinarith [sq_nonneg L]
  have hq0 : 0 ≤ qR / cP := div_nonneg ((sq_nonneg _).trans hQψ) hcP.le
  have h2 : ‖ψ - φ‖ ≤ L * √(qR / cP) := by
    calc ‖ψ - φ‖ = √(‖ψ - φ‖ ^ 2) := (Real.sqrt_sq (norm_nonneg _)).symm
      _ ≤ √(L ^ 2 * (qR / cP)) := Real.sqrt_le_sqrt h1
      _ = L * √(qR / cP) := by rw [Real.sqrt_mul (sq_nonneg L), Real.sqrt_sq hL.le]
  calc ‖φ‖ = ‖ψ - (ψ - φ)‖ := by rw [sub_sub_cancel]
    _ ≤ ‖ψ‖ + ‖ψ - φ‖ := norm_sub_le _ _
    _ ≤ pR * L + L * √(qR / cP) := add_le_add hpψ h2
    _ = (pR + √(qR / cP)) * L := by ring

end L2Bound

section AssemblyMain

/-- **The assembly bound.** On the Euclidean space of fine fields, let
* (M) `φ` minimise `Q = ‖D·‖²` on `φ + K`;
* (R) a reference field `ψ ∈ φ + K` have `Q(ψ) ≤ q_R`, `‖ψ‖ ≤ p_R L`;
* (P) the one-shot Poincaré inequality `c_P ‖η‖² ≤ L² Q(η)` hold on `K`;
* (CD) the column decay `‖φ 1_{ann ≥ t}‖₂ ≤ C_D e^{−λt} ‖φ‖₂` hold for every `t`;
* the annulus counts satisfy `|{ann = t}| ≤ 256 (t+1)³ L⁴`;
and let `L > 0`, `c_P > 0`, `λ > 0`, `C_D ≥ 0`, and `ann v < T` for every site `v`.
Then `‖φ‖₁ ≤ 16√6 (p_R + √(q_R/c_P)) C_D (1 − e^{−λ})^{−5/2} L³`. With `L = 2^k` this is a bound
on the one-shot loss `‖φ‖₁/8^k` with constants independent of `k` (`assembly_loss_bound`).

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem assembly_bound {V : Type*} [Fintype V] {F : Type*} [NormedAddCommGroup F]
    [InnerProductSpace ℝ F] (D : EuclideanSpace ℝ V →ₗ[ℝ] F) (K : Submodule ℝ (EuclideanSpace ℝ V))
    {φ ψ : EuclideanSpace ℝ V} {L pR qR cP CD lam : ℝ} (hL : 0 < L) (hcP : 0 < cP)
    (hlam : 0 < lam) (hCD : 0 ≤ CD) (ann : V → ℕ) (T : ℕ) (hT : ∀ v, ann v < T)
    (hM : ∀ η ∈ K, ‖D φ‖ ^ 2 ≤ ‖D (φ + η)‖ ^ 2)
    (hψK : ψ - φ ∈ K) (hQψ : ‖D ψ‖ ^ 2 ≤ qR) (hpψ : ‖ψ‖ ≤ pR * L)
    (hP : ∀ η ∈ K, cP * ‖η‖ ^ 2 ≤ L ^ 2 * ‖D η‖ ^ 2)
    (hdecay : ∀ t : ℕ, √(∑ v ∈ univ.filter (fun v => t ≤ ann v), φ.ofLp v ^ 2) ≤
      CD * Real.exp (-lam * t) * ‖φ‖)
    (hcount : ∀ t : ℕ, ((univ.filter fun v => ann v = t).card : ℝ) ≤
      256 * ((t : ℝ) + 1) ^ 3 * L ^ 4) :
    l1 φ.ofLp ≤ 16 * √6 * (pR + √(qR / cP)) * CD /
      ((1 - Real.exp (-lam)) ^ 2 * √(1 - Real.exp (-lam))) * L ^ 3 := by
  set q := Real.exp (-lam) with hqdef
  have hq0 : 0 ≤ q := (Real.exp_pos _).le
  have hq1 : q < 1 := Real.exp_lt_one_iff.mpr (by linarith)
  have hq : 0 < 1 - q := by linarith
  set C2 := pR + √(qR / cP) with hC2
  have hφ := (l2_column_bound D K hL hcP hM hψK hQψ hpψ hP).2
  have hC2L : 0 ≤ C2 * L := (norm_nonneg _).trans hφ
  have hT1 := l1_le_annular φ.ofLp ann T hT L hcount
  have hτ : ∀ t : ℕ, √(∑ v ∈ univ.filter (fun v => ann v = t), φ.ofLp v ^ 2) ≤
      CD * C2 * L * q ^ t := by
    intro t
    have hsub : ∑ v ∈ univ.filter (fun v => ann v = t), φ.ofLp v ^ 2 ≤
        ∑ v ∈ univ.filter (fun v => t ≤ ann v), φ.ofLp v ^ 2 := by
      apply Finset.sum_le_sum_of_subset_of_nonneg
      · intro v hv
        simp only [mem_filter, mem_univ, true_and] at hv ⊢
        omega
      · intro v _ _; exact sq_nonneg _
    have hexp : Real.exp (-lam * t) = q ^ t := by
      rw [hqdef, ← Real.exp_nat_mul]; ring_nf
    calc √(∑ v ∈ univ.filter (fun v => ann v = t), φ.ofLp v ^ 2)
        ≤ √(∑ v ∈ univ.filter (fun v => t ≤ ann v), φ.ofLp v ^ 2) := Real.sqrt_le_sqrt hsub
      _ ≤ CD * Real.exp (-lam * t) * ‖φ‖ := hdecay t
      _ ≤ CD * Real.exp (-lam * t) * (C2 * L) :=
          mul_le_mul_of_nonneg_left hφ (mul_nonneg hCD (Real.exp_pos _).le)
      _ = CD * C2 * L * q ^ t := by rw [hexp]; ring
  have hser := sum_three_halves_geom_le hq0 hq1 T
  have hsum : ∑ t ∈ range T, ((t : ℝ) + 1) * √((t : ℝ) + 1) *
      √(∑ v ∈ univ.filter (fun v => ann v = t), φ.ofLp v ^ 2) ≤
      CD * C2 * L * (√6 / ((1 - q) ^ 2 * √(1 - q))) := by
    calc ∑ t ∈ range T, ((t : ℝ) + 1) * √((t : ℝ) + 1) *
          √(∑ v ∈ univ.filter (fun v => ann v = t), φ.ofLp v ^ 2)
        ≤ ∑ t ∈ range T, ((t : ℝ) + 1) * √((t : ℝ) + 1) * (CD * C2 * L * q ^ t) :=
          sum_le_sum fun t _ => mul_le_mul_of_nonneg_left (hτ t) (by positivity)
      _ = CD * C2 * L * ∑ t ∈ range T, ((t : ℝ) + 1) * √((t : ℝ) + 1) * q ^ t := by
          rw [mul_sum]; exact sum_congr rfl fun t _ => by ring
      _ ≤ CD * C2 * L * (√6 / ((1 - q) ^ 2 * √(1 - q))) :=
          mul_le_mul_of_nonneg_left hser (by
            have : 0 ≤ CD * (C2 * L) := mul_nonneg hCD hC2L
            linarith [mul_assoc CD C2 L])
  calc l1 φ.ofLp ≤ 16 * L ^ 2 * ∑ t ∈ range T, ((t : ℝ) + 1) * √((t : ℝ) + 1) *
        √(∑ v ∈ univ.filter (fun v => ann v = t), φ.ofLp v ^ 2) := hT1
    _ ≤ 16 * L ^ 2 * (CD * C2 * L * (√6 / ((1 - q) ^ 2 * √(1 - q)))) :=
        mul_le_mul_of_nonneg_left hsum (by positivity)
    _ = 16 * √6 * C2 * CD / ((1 - q) ^ 2 * √(1 - q)) * L ^ 3 := by ring

/-- **The uniform one-shot loss bound.** Under the hypotheses of `assembly_bound` with `L = 2^k`,
the one-shot loss `‖φ‖₁/8^k` is at most `16√6 (p_R + √(q_R/c_P)) C_D (1 − e^{−λ})^{−5/2}`, a
constant independent of `k` whenever the inputs `p_R, q_R, c_P, C_D, λ` are.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem assembly_loss_bound {V : Type*} [Fintype V] {F : Type*} [NormedAddCommGroup F]
    [InnerProductSpace ℝ F] (D : EuclideanSpace ℝ V →ₗ[ℝ] F) (K : Submodule ℝ (EuclideanSpace ℝ V))
    {φ ψ : EuclideanSpace ℝ V} (k : ℕ) {pR qR cP CD lam : ℝ} (hcP : 0 < cP)
    (hlam : 0 < lam) (hCD : 0 ≤ CD) (ann : V → ℕ) (T : ℕ) (hT : ∀ v, ann v < T)
    (hM : ∀ η ∈ K, ‖D φ‖ ^ 2 ≤ ‖D (φ + η)‖ ^ 2)
    (hψK : ψ - φ ∈ K) (hQψ : ‖D ψ‖ ^ 2 ≤ qR) (hpψ : ‖ψ‖ ≤ pR * 2 ^ k)
    (hP : ∀ η ∈ K, cP * ‖η‖ ^ 2 ≤ (2 ^ k) ^ 2 * ‖D η‖ ^ 2)
    (hdecay : ∀ t : ℕ, √(∑ v ∈ univ.filter (fun v => t ≤ ann v), φ.ofLp v ^ 2) ≤
      CD * Real.exp (-lam * t) * ‖φ‖)
    (hcount : ∀ t : ℕ, ((univ.filter fun v => ann v = t).card : ℝ) ≤
      256 * ((t : ℝ) + 1) ^ 3 * (2 ^ k) ^ 4) :
    l1 φ.ofLp / 8 ^ k ≤ 16 * √6 * (pR + √(qR / cP)) * CD /
      ((1 - Real.exp (-lam)) ^ 2 * √(1 - Real.exp (-lam))) := by
  have h := assembly_bound D K (L := 2 ^ k) (by positivity) hcP hlam hCD ann T hT hM hψK hQψ hpψ
    hP hdecay hcount
  have e : ((2 : ℝ) ^ k) ^ 3 = 8 ^ k := by rw [← pow_mul, mul_comm, pow_mul]; norm_num
  rw [e] at h
  rwa [div_le_iff₀ (by positivity)]

end AssemblyMain

/-! ## 7. The `ℓ²`-minimal section and the quotient Poincaré identity -/

section SectionDim

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- **Complement by dimension.** If `S, W ≤ Σ₀`, `S ∩ W = 0` and
`dim S + dim W = dim Σ₀`, then `S + W = Σ₀`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem sup_eq_of_finrank [FiniteDimensional ℝ E] {W Z S : Submodule ℝ E} (hW0 : W ≤ Z)
    (hS0 : S ≤ Z) (hSW : S ⊓ W = ⊥)
    (hdim : Module.finrank ℝ S + Module.finrank ℝ W = Module.finrank ℝ Z) : S ⊔ W = Z := by
  apply Submodule.eq_of_le_of_finrank_eq (sup_le hS0 hW0)
  have h := Submodule.finrank_sup_add_finrank_inf_eq S W
  rw [hSW, finrank_bot, add_zero] at h
  rw [h, hdim]

end SectionDim

section GaugeSection

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The gauge reduction `Φ_W = I − P_W`: subtract the Euclidean-orthogonal projection onto a
subspace `W` (in the application, the subspace of pure gauges, on which the energy and the block
averages vanish). -/
def gaugeReduce (W : Submodule ℝ E) [W.HasOrthogonalProjection] (x : E) : E :=
  x - W.starProjection x

variable (W : Submodule ℝ E) [W.HasOrthogonalProjection]

/-- `Φ_W x ⊥ W`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem gaugeReduce_mem_orthogonal (x : E) : gaugeReduce W x ∈ Wᗮ :=
  Submodule.sub_starProjection_mem_orthogonal x

/-- `x − Φ_W x ∈ W`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem sub_gaugeReduce_mem (x : E) : x - gaugeReduce W x ∈ W := by
  rw [gaugeReduce, sub_sub_cancel]
  exact W.starProjection_apply_mem x

/-- `Φ_W` is additive.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem gaugeReduce_add (x y : E) :
    gaugeReduce W (x + y) = gaugeReduce W x + gaugeReduce W y := by
  simp only [gaugeReduce, map_add]
  abel

/-- `Φ_W` commutes with scalars.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem gaugeReduce_smul (c : ℝ) (x : E) : gaugeReduce W (c • x) = c • gaugeReduce W x := by
  simp only [gaugeReduce, map_smul, smul_sub]

/-- `Φ_W` commutes with differences.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem gaugeReduce_sub (x y : E) :
    gaugeReduce W (x - y) = gaugeReduce W x - gaugeReduce W y := by
  simp only [gaugeReduce, map_sub]
  abel

/-- **The orbit meets `W^⊥` once.** If `z ⊥ W` and `x − z ∈ W`, then `Φ_W x = z`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem gaugeReduce_eq_of_sub_mem {x z : E} (hz : z ∈ Wᗮ) (hxz : x - z ∈ W) :
    gaugeReduce W x = z := by
  have h1 : W.starProjection (x - z) = x - z := Submodule.starProjection_eq_self_iff.mpr hxz
  have h2 : W.starProjection z = 0 := (Submodule.starProjection_apply_eq_zero_iff W).mpr hz
  have h3 : W.starProjection x = x - z := by
    have h := map_sub W.starProjection x z
    rw [h1, h2, sub_zero] at h
    exact h.symm
  rw [gaugeReduce, h3, sub_sub_cancel]

/-- `Φ_W x = 0 ↔ x ∈ W`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem gaugeReduce_eq_zero_iff (x : E) : gaugeReduce W x = 0 ↔ x ∈ W := by
  rw [gaugeReduce, sub_eq_zero]
  constructor
  · intro h
    rw [h]
    exact W.starProjection_apply_mem x
  · intro h
    exact (Submodule.starProjection_eq_self_iff.mpr h).symm

/-- **`Φ_W` preserves every linear map vanishing on `W`** (the energy operator and the block
averages).

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem map_gaugeReduce {G : Type*} [AddCommGroup G] [Module ℝ G] (f : E →ₗ[ℝ] G)
    (hf : W ≤ LinearMap.ker f) (x : E) : f (gaugeReduce W x) = f x := by
  rw [gaugeReduce, map_sub, LinearMap.mem_ker.mp (hf (W.starProjection_apply_mem x)), sub_zero]

/-- **Euclidean minimality:** `‖Φ_W x‖ ≤ ‖x + w‖` for every `w ∈ W`, i.e. `Φ_W x` is the
Euclidean-closest point of the orbit `x + W`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem norm_gaugeReduce_le (x : E) {w : E} (hw : w ∈ W) : ‖gaugeReduce W x‖ ≤ ‖x + w‖ := by
  have h1 : x + w = gaugeReduce W x + (W.starProjection x + w) := by
    rw [gaugeReduce]; abel
  have h2 : inner ℝ (gaugeReduce W x) (W.starProjection x + w) = 0 :=
    Submodule.inner_left_of_mem_orthogonal (W.add_mem (W.starProjection_apply_mem x) hw)
      (gaugeReduce_mem_orthogonal W x)
  have h3 := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero _ _ h2
  rw [h1]
  apply le_of_sq_le_sq_of_nonneg (norm_nonneg _)
  nlinarith [mul_self_nonneg ‖W.starProjection x + w‖]

/-- `‖Φ_W x‖ = dist(x, W) = inf_{w ∈ W} ‖x − w‖`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem norm_gaugeReduce_eq_iInf (x : E) : ‖gaugeReduce W x‖ = ⨅ w : W, ‖x - w‖ :=
  Submodule.starProjection_minimal x

variable (Z S : Submodule ℝ E)

/-- `Φ_W` maps the base section `Σ₀ ⊇ W` into the `ℓ²`-minimal section `Σ' = Σ₀ ∩ W^⊥`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem gaugeReduce_mem_section (hW0 : W ≤ Z) {x : E} (hx : x ∈ Z) :
    gaugeReduce W x ∈ Z ⊓ Wᗮ :=
  ⟨Z.sub_mem hx (hW0 (W.starProjection_apply_mem x)), gaugeReduce_mem_orthogonal W x⟩

/-- `Φ_W` is injective on a slice `S` with `S ∩ W = 0`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem gaugeReduce_injOn (hSW : S ⊓ W = ⊥) {x y : E} (hx : x ∈ S) (hy : y ∈ S)
    (h : gaugeReduce W x = gaugeReduce W y) : x = y := by
  have h0 : gaugeReduce W (x - y) = 0 := by rw [gaugeReduce_sub, h, sub_self]
  rw [gaugeReduce_eq_zero_iff] at h0
  have hmem : x - y ∈ S ⊓ W := ⟨S.sub_mem hx hy, h0⟩
  rw [hSW, Submodule.mem_bot, sub_eq_zero] at hmem
  exact hmem

/-- `Φ_W` maps a slice `S` with `S + W = Σ₀` onto `Σ₀ ∩ W^⊥`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem gaugeReduce_surjOn (hsup : S ⊔ W = Z) {z : E} (hz : z ∈ Z ⊓ Wᗮ) :
    ∃ x ∈ S, gaugeReduce W x = z := by
  have hz0 : z ∈ S ⊔ W := hsup ▸ hz.1
  obtain ⟨x, hx, w, hw, rfl⟩ := Submodule.mem_sup.mp hz0
  refine ⟨x, hx, gaugeReduce_eq_of_sub_mem W hz.2 ?_⟩
  rw [show x - (x + w) = -w by abel]
  exact W.neg_mem hw

/-- **The `ℓ²`-minimal section is a bijective image of the slice.** If `W ≤ Σ₀`, `S ∩ W = 0` and
`S + W = Σ₀` (so also `S ≤ Σ₀`), then `Φ_W = I − P_W` restricts to a linear bijection
`S ≃ Σ₀ ∩ W^⊥`: there is a linear equivalence `e` from the subspace `S` onto the subspace
`Σ₀ ∩ W^⊥` (in Lean, `e : S ≃ₗ[ℝ] ↥(Z ⊓ Wᗮ)`, with `Z = Σ₀`) such that `e x = Φ_W x` for every
`x ∈ S`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem exists_sectionEquiv (hW0 : W ≤ Z) (hSW : S ⊓ W = ⊥) (hsup : S ⊔ W = Z) :
    ∃ e : S ≃ₗ[ℝ] ↥(Z ⊓ Wᗮ), ∀ x : S, (e x : E) = gaugeReduce W x := by
  have hS0 : S ≤ Z := hsup ▸ le_sup_left
  let f : S →ₗ[ℝ] ↥(Z ⊓ Wᗮ) :=
    { toFun := fun x => ⟨gaugeReduce W x, gaugeReduce_mem_section W Z hW0 (hS0 x.2)⟩
      map_add' := fun x y => Subtype.ext (by
        simp only [Submodule.coe_add]
        exact gaugeReduce_add W x y)
      map_smul' := fun c x => Subtype.ext (by
        simp only [Submodule.coe_smul, RingHom.id_apply]
        exact gaugeReduce_smul W c x) }
  have hinj : Function.Injective f := fun x y h =>
    Subtype.ext (gaugeReduce_injOn W S hSW x.2 y.2 (congrArg Subtype.val h))
  have hsurj : Function.Surjective f := fun z => by
    obtain ⟨x, hx, hxz⟩ := gaugeReduce_surjOn W Z S hsup z.2
    exact ⟨⟨x, hx⟩, Subtype.ext hxz⟩
  exact ⟨LinearEquiv.ofBijective f ⟨hinj, hsurj⟩, fun _ => rfl⟩

variable {F G : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F] [AddCommGroup G]
  [Module ℝ G]

/-- **The `ℓ²`-minimal reconstruction.** Let `A` (block averages) and `D` (energy, `Q = ‖D·‖²`)
vanish on `W`, `W ≤ Σ₀`, `S + W = Σ₀`. If `x ∈ S` minimises `Q` among `x' ∈ S` with
`A x' = A x`, then `Φ_W x ∈ Σ₀ ∩ W^⊥` has the same block averages and the same energy and
minimises `Q` among `z ∈ Σ₀ ∩ W^⊥` with `A z = A x`. (Intended reading, not part of the
statement: applied to each column of a reconstruction `T`, this makes `T' = Φ_W T` the
conditional-mean map of the `ℓ²`-minimal section, with `A T' = A T`.)

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem minimizer_transfer (A : E →ₗ[ℝ] G) (D : E →ₗ[ℝ] F) (hWA : W ≤ LinearMap.ker A)
    (hWD : W ≤ LinearMap.ker D) (hW0 : W ≤ Z) (hsup : S ⊔ W = Z) {x : E} (hx : x ∈ S)
    (hmin : ∀ x' ∈ S, A x' = A x → ‖D x‖ ^ 2 ≤ ‖D x'‖ ^ 2) :
    gaugeReduce W x ∈ Z ⊓ Wᗮ ∧ A (gaugeReduce W x) = A x ∧
      ‖D (gaugeReduce W x)‖ = ‖D x‖ ∧
      ∀ z ∈ Z ⊓ Wᗮ, A z = A x → ‖D (gaugeReduce W x)‖ ^ 2 ≤ ‖D z‖ ^ 2 := by
  have hS0 : S ≤ Z := hsup ▸ le_sup_left
  refine ⟨gaugeReduce_mem_section W Z hW0 (hS0 hx), map_gaugeReduce W A hWA x,
    by rw [map_gaugeReduce W D hWD], fun z hz hAz => ?_⟩
  obtain ⟨x', hx', rfl⟩ := gaugeReduce_surjOn W Z S hsup hz
  rw [map_gaugeReduce W D hWD, map_gaugeReduce W D hWD]
  rw [map_gaugeReduce W A hWA] at hAz
  exact hmin x' hx' hAz

/-- **Proper fibres transfer.** Let `A` and `D` (with `Q = ‖D·‖²`) vanish on `W`, and let
`S + W = Σ₀`. If `Q > 0` on `(S ∩ ker A) \ 0`, then `Q > 0` on `(Σ₀ ∩ W^⊥ ∩ ker A) \ 0`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem posdef_transfer (A : E →ₗ[ℝ] G) (D : E →ₗ[ℝ] F) (hWA : W ≤ LinearMap.ker A)
    (hWD : W ≤ LinearMap.ker D) (hsup : S ⊔ W = Z)
    (hpos : ∀ x ∈ S, A x = 0 → x ≠ 0 → 0 < ‖D x‖ ^ 2) :
    ∀ z ∈ Z ⊓ Wᗮ, A z = 0 → z ≠ 0 → 0 < ‖D z‖ ^ 2 := by
  intro z hz hAz hz0
  obtain ⟨x, hx, rfl⟩ := gaugeReduce_surjOn W Z S hsup hz
  rw [map_gaugeReduce W D hWD]
  rw [map_gaugeReduce W A hWA] at hAz
  refine hpos x hx hAz fun h => hz0 ?_
  rw [h, gaugeReduce, map_zero, sub_zero]

/-- **The quotient Poincaré identity (ratio sets).** With `A, D` vanishing on `W ≤ Σ₀`, the
Rayleigh quotients of the `ℓ²`-minimal section,
`{Q(φ)/‖φ‖² : φ ∈ Σ₀ ∩ W^⊥ ∩ ker A, φ ≠ 0}`, are exactly the quotient Rayleigh quotients
`{Q(φ)/dist(φ, W)² : φ ∈ Σ₀ ∩ ker A, φ ∉ W}` (with `dist(φ, W) = ‖Φ_W φ‖`).

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem quotient_ratio_sets_eq (A : E →ₗ[ℝ] G) (D : E →ₗ[ℝ] F) (hWA : W ≤ LinearMap.ker A)
    (hWD : W ≤ LinearMap.ker D) (hW0 : W ≤ Z) :
    {r | ∃ φ ∈ Z, A φ = 0 ∧ φ ∉ W ∧ r = ‖D φ‖ ^ 2 / ‖gaugeReduce W φ‖ ^ 2} =
      {r | ∃ φ ∈ Z ⊓ Wᗮ, A φ = 0 ∧ φ ≠ 0 ∧ r = ‖D φ‖ ^ 2 / ‖φ‖ ^ 2} := by
  ext r
  constructor
  · rintro ⟨φ, hφ, hA, hW, rfl⟩
    exact ⟨gaugeReduce W φ, gaugeReduce_mem_section W Z hW0 hφ,
      by rw [map_gaugeReduce W A hWA, hA], fun h => hW ((gaugeReduce_eq_zero_iff W φ).mp h),
      by rw [map_gaugeReduce W D hWD]⟩
  · rintro ⟨φ, hφ, hA, hne, rfl⟩
    have hP : gaugeReduce W φ = φ := gaugeReduce_eq_of_sub_mem W hφ.2 (by simp)
    refine ⟨φ, hφ.1, hA, fun hW => hne ?_, by rw [hP]⟩
    have hm : φ ∈ W ⊓ Wᗮ := ⟨hW, hφ.2⟩
    rw [Submodule.inf_orthogonal_eq_bot W] at hm
    exact (Submodule.mem_bot ℝ).mp hm

/-- **The quotient Poincaré identity (constants).** With `A, D` vanishing on `W ≤ Σ₀` and any real
`L`, a constant `c` is a one-shot Poincaré constant of the `ℓ²`-minimal section
(`c ‖φ‖² ≤ L² Q(φ)` on `Σ₀ ∩ W^⊥ ∩ ker A`) if and only if it is a quotient Poincaré constant
(`c dist(φ, W)² ≤ L² Q(φ)` on `Σ₀ ∩ ker A`).

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem quotient_poincare_iff (A : E →ₗ[ℝ] G) (D : E →ₗ[ℝ] F) (hWA : W ≤ LinearMap.ker A)
    (hWD : W ≤ LinearMap.ker D) (hW0 : W ≤ Z) (c L : ℝ) :
    (∀ φ ∈ Z, A φ = 0 → c * ‖gaugeReduce W φ‖ ^ 2 ≤ L ^ 2 * ‖D φ‖ ^ 2) ↔
      (∀ φ ∈ Z ⊓ Wᗮ, A φ = 0 → c * ‖φ‖ ^ 2 ≤ L ^ 2 * ‖D φ‖ ^ 2) := by
  constructor
  · intro h φ hφ hA
    have := h φ hφ.1 hA
    rwa [gaugeReduce_eq_of_sub_mem W hφ.2 (by simp)] at this
  · intro h φ hφ hA
    have := h (gaugeReduce W φ) (gaugeReduce_mem_section W Z hW0 hφ)
      (by rw [map_gaugeReduce W A hWA, hA])
    rwa [map_gaugeReduce W D hWD] at this

/-- **The `ℓ²`-minimal section has the best one-shot Poincaré constant.** Let `D` vanish on `W`,
let `S'` be any section whose kernel elements cover `Σ₀ ∩ W^⊥ ∩ ker A` modulo `W` (every such `φ'`
has some `φ ∈ S'` with `A φ = 0`, `φ − φ' ∈ W`), and let `c ≥ 0` be a one-shot Poincaré constant
of `S'`. Then `c` is a one-shot Poincaré constant of `Σ₀ ∩ W^⊥`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem poincare_transfer (A : E →ₗ[ℝ] G) (D : E →ₗ[ℝ] F) (hWD : W ≤ LinearMap.ker D)
    (S' : Submodule ℝ E) {c L : ℝ} (hc : 0 ≤ c)
    (hcov : ∀ φ' ∈ Z ⊓ Wᗮ, A φ' = 0 → ∃ φ ∈ S', A φ = 0 ∧ φ - φ' ∈ W)
    (hS' : ∀ φ ∈ S', A φ = 0 → c * ‖φ‖ ^ 2 ≤ L ^ 2 * ‖D φ‖ ^ 2) :
    ∀ φ' ∈ Z ⊓ Wᗮ, A φ' = 0 → c * ‖φ'‖ ^ 2 ≤ L ^ 2 * ‖D φ'‖ ^ 2 := by
  intro φ' hφ' hA
  obtain ⟨φ, hφ, hAφ, hsub⟩ := hcov φ' hφ' hA
  have hΦ : gaugeReduce W φ = φ' := gaugeReduce_eq_of_sub_mem W hφ'.2 hsub
  have hD : D φ' = D φ := by rw [← hΦ, map_gaugeReduce W D hWD]
  have hn : ‖φ'‖ ≤ ‖φ‖ := by
    have := norm_gaugeReduce_le W φ W.zero_mem
    rwa [add_zero, hΦ] at this
  rw [hD]
  calc c * ‖φ'‖ ^ 2 ≤ c * ‖φ‖ ^ 2 :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) hn 2) hc
    _ ≤ L ^ 2 * ‖D φ‖ ^ 2 := hS' φ hφ hAφ

/-- **The slice covers.** If `A` vanishes on `W` and `S + W = Σ₀`, the kernel elements of `S`
cover `Σ₀ ∩ W^⊥ ∩ ker A` modulo `W`: every `φ'` there has some `φ ∈ S` with `A φ = 0` and
`φ − φ' ∈ W`. (Combined with `poincare_transfer`, which also needs `D` to vanish on `W`, this
gives that every one-shot Poincaré constant `c ≥ 0` of the slice `S` is one of the `ℓ²`-minimal
section; that consequence is not part of this statement.)

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem slice_covers (A : E →ₗ[ℝ] G) (hWA : W ≤ LinearMap.ker A) (hsup : S ⊔ W = Z) :
    ∀ φ' ∈ Z ⊓ Wᗮ, A φ' = 0 → ∃ φ ∈ S, A φ = 0 ∧ φ - φ' ∈ W := by
  intro φ' hφ' hA
  obtain ⟨x, hx, hxz⟩ := gaugeReduce_surjOn W Z S hsup hφ'
  refine ⟨x, hx, by rw [← map_gaugeReduce W A hWA, hxz, hA], ?_⟩
  rw [← hxz]
  exact sub_gaugeReduce_mem W x

end GaugeSection

/-! ## 8. The quotient-`ℓ¹` one-shot loss -/

section Quotient

variable {κ ι : Type*} [Fintype κ] [Fintype ι]

/-- The quotient `ℓ¹` seminorm `N^q(x) = inf_{h ∈ G} ‖x + h‖₁` modulo the gauge subspace `G`. -/
def quotNorm (G : Submodule ℝ (κ → ℝ)) (x : κ → ℝ) : ℝ := ⨅ h : G, l1 (x + (h : κ → ℝ))

/-- The weighted coarse quotient cost `N^q_{L}(y) = inf_{g ∈ G_c} Σ_w L_w |(y + g)_w|`. -/
def quotCost (Gc : Submodule ℝ (ι → ℝ)) (L y : ι → ℝ) : ℝ := ⨅ g : Gc, wl1 L (y + (g : ι → ℝ))

omit [Fintype ι] in
/-- The range of `h ↦ ‖x + h‖₁` is bounded below by `0`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem quot_bddBelow (G : Submodule ℝ (κ → ℝ)) (x : κ → ℝ) :
    BddBelow (Set.range fun h : G => l1 (x + (h : κ → ℝ))) :=
  ⟨0, by rintro _ ⟨h, rfl⟩; exact l1_nonneg _⟩

omit [Fintype ι] in
/-- `N^q ≥ 0`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem quotNorm_nonneg (G : Submodule ℝ (κ → ℝ)) (x : κ → ℝ) : 0 ≤ quotNorm G x :=
  le_ciInf fun _ => l1_nonneg _

omit [Fintype ι] in
/-- `N^q(x) ≤ ‖x + h‖₁` for every `h ∈ G`: every gauge representative costs at least `N^q`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem quotNorm_le (G : Submodule ℝ (κ → ℝ)) (x : κ → ℝ) {h : κ → ℝ} (hh : h ∈ G) :
    quotNorm G x ≤ l1 (x + h) :=
  ciInf_le (quot_bddBelow G x) ⟨h, hh⟩

omit [Fintype ι] in
/-- `N^q` is invariant under gauge translations.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem quotNorm_add_mem (G : Submodule ℝ (κ → ℝ)) (x : κ → ℝ) {h : κ → ℝ} (hh : h ∈ G) :
    quotNorm G (x + h) = quotNorm G x := by
  apply le_antisymm
  · refine le_ciInf fun h' => ?_
    have := quotNorm_le G (x + h) (G.sub_mem h'.2 hh)
    rwa [show x + h + ((h' : κ → ℝ) - h) = x + h' by abel] at this
  · refine le_ciInf fun h' => ?_
    have := quotNorm_le G x (G.add_mem hh h'.2)
    rwa [show x + (h + (h' : κ → ℝ)) = x + h + h' by abel] at this

omit [Fintype ι] in
/-- `N^q` is subadditive.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem quotNorm_add_le (G : Submodule ℝ (κ → ℝ)) (x x' : κ → ℝ) :
    quotNorm G (x + x') ≤ quotNorm G x + quotNorm G x' := by
  have h1 : ∀ h h' : G, quotNorm G (x + x') ≤ l1 (x + (h : κ → ℝ)) + l1 (x' + (h' : κ → ℝ)) :=
      fun h h' => by
    have := quotNorm_le G (x + x') (G.add_mem h.2 h'.2)
    refine this.trans ?_
    unfold l1
    rw [← sum_add_distrib]
    refine sum_le_sum fun v _ => ?_
    simp only [Pi.add_apply]
    rw [show x v + x' v + ((h : κ → ℝ) v + (h' : κ → ℝ) v) =
      (x v + (h : κ → ℝ) v) + (x' v + (h' : κ → ℝ) v) by ring]
    exact abs_add_le _ _
  have h2 : ∀ h' : G, quotNorm G (x + x') - l1 (x' + (h' : κ → ℝ)) ≤ quotNorm G x := fun h' =>
    le_ciInf fun h => by linarith [h1 h h']
  have h3 : quotNorm G (x + x') - quotNorm G x ≤ quotNorm G x' :=
    le_ciInf fun h' => by linarith [h2 h']
  linarith

omit [Fintype ι] in
/-- `N^q(c x) ≤ |c| N^q(x)`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem quotNorm_smul_le (G : Submodule ℝ (κ → ℝ)) (c : ℝ) (x : κ → ℝ) :
    quotNorm G (c • x) ≤ |c| * quotNorm G x := by
  have key : ∀ h : G, quotNorm G (c • x) ≤ |c| * l1 (x + (h : κ → ℝ)) := fun h => by
    have := quotNorm_le G (c • x) (G.smul_mem c h.2)
    rwa [← smul_add, l1_smul] at this
  calc quotNorm G (c • x) ≤ ⨅ h : G, |c| * l1 (x + (h : κ → ℝ)) := le_ciInf key
    _ = |c| * quotNorm G x := (Real.mul_iInf_of_nonneg (abs_nonneg c) _).symm

omit [Fintype ι] in
/-- `N^q(Σ_w z_w v_w) ≤ Σ_w |z_w| N^q(v_w)`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem quotNorm_sum_le (G : Submodule ℝ (κ → ℝ)) (s : Finset ι) (z : ι → ℝ)
    (v : ι → κ → ℝ) : quotNorm G (∑ w ∈ s, z w • v w) ≤ ∑ w ∈ s, |z w| * quotNorm G (v w) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [sum_empty]
    have := quotNorm_le G 0 G.zero_mem
    simp [l1] at this
    exact this
  | insert a s ha ih =>
    rw [sum_insert ha, sum_insert ha]
    exact (quotNorm_add_le G _ _).trans (add_le_add (quotNorm_smul_le G _ _) ih)

variable [DecidableEq ι]

omit [Fintype κ] in
/-- `T y = Σ_w y_w T e_w`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem mulVec_eq_sum_single (T : Matrix κ ι ℝ) (y : ι → ℝ) :
    T *ᵥ y = ∑ w, y w • (T *ᵥ Pi.single w 1) := by
  funext v
  simp [Matrix.mulVec, dotProduct, Finset.sum_apply, mul_comm]

omit [Fintype κ] in
/-- `(M e_w)_v = M_{vw}`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem mulVec_single_one_apply (M : Matrix κ ι ℝ) (w : ι) (v : κ) :
    (M *ᵥ Pi.single w 1) v = M v w := by
  simp [Matrix.mulVec, dotProduct, Pi.single_apply]

omit [DecidableEq ι] in
/-- If every column of `A` has absolute sum `≤ c`, then `‖A x‖₁ ≤ c ‖x‖₁`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem l1_mulVec_le (A : Matrix ι κ ℝ) (c : ℝ) (hA : ∀ v, ∑ w, |A w v| ≤ c) (x : κ → ℝ) :
    l1 (A *ᵥ x) ≤ c * l1 x := by
  calc l1 (A *ᵥ x) = ∑ w, |∑ v, A w v * x v| := rfl
    _ ≤ ∑ w, ∑ v, |A w v| * |x v| :=
        sum_le_sum fun w _ => (abs_sum_le_sum_abs _ _).trans
          (le_of_eq (sum_congr rfl fun v _ => abs_mul _ _))
    _ = ∑ v, ∑ w, |A w v| * |x v| := Finset.sum_comm
    _ = ∑ v, (∑ w, |A w v|) * |x v| := sum_congr rfl fun v _ => (sum_mul _ _ _).symm
    _ ≤ ∑ v, c * |x v| := sum_le_sum fun v _ => mul_le_mul_of_nonneg_right (hA v) (abs_nonneg _)
    _ = c * l1 x := by rw [l1, mul_sum]

/-- The quotient one-shot weights `L_w = N^q([T e_w])`. -/
def quotWeights (Gf : Submodule ℝ (κ → ℝ)) (T : Matrix κ ι ℝ) (w : ι) : ℝ :=
  quotNorm Gf (T *ᵥ Pi.single w 1)

/-- **The quotient one-shot cost is admissible.** If `T` maps coarse gauge directions to fine ones
(`T(G_c) ⊆ G_f`), then `N^q([T y]) ≤ N^q_L([y])` with `L_w = N^q([T e_w])`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem quot_admissible (Gf : Submodule ℝ (κ → ℝ)) (Gc : Submodule ℝ (ι → ℝ))
    (T : Matrix κ ι ℝ) (hTG : ∀ g ∈ Gc, T *ᵥ g ∈ Gf) (y : ι → ℝ) :
    quotNorm Gf (T *ᵥ y) ≤ quotCost Gc (quotWeights Gf T) y := by
  refine le_ciInf fun g => ?_
  rw [← quotNorm_add_mem Gf (T *ᵥ y) (hTG g g.2), ← Matrix.mulVec_add,
    mulVec_eq_sum_single T (y + g)]
  refine (quotNorm_sum_le Gf univ _ _).trans (le_of_eq ?_)
  unfold wl1 quotWeights
  exact sum_congr rfl fun w _ => mul_comm _ _

/-- **The quotient one-shot loss bound.** If `A T = I`, `‖A‖₁→₁ ≤ 1/s` (`s > 0`) and `A` maps
fine gauge directions to coarse ones (`A(G_f) ⊆ G_c`), then
`N^q_L([y]) ≤ (max_w L_w / s) N^q([T y])` for every coarse `y`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem quot_loss_le [Nonempty ι] (Gf : Submodule ℝ (κ → ℝ)) (Gc : Submodule ℝ (ι → ℝ))
    (T : Matrix κ ι ℝ) (A : Matrix ι κ ℝ) (hAT : A * T = 1) (hAG : ∀ h ∈ Gf, A *ᵥ h ∈ Gc)
    {s : ℝ} (hs : 0 < s) (hA : ∀ v, ∑ w, |A w v| ≤ 1 / s) (y : ι → ℝ) :
    quotCost Gc (quotWeights Gf T) y ≤
      univ.sup' univ_nonempty (quotWeights Gf T) / s * quotNorm Gf (T *ᵥ y) := by
  set Lmax := univ.sup' univ_nonempty (quotWeights Gf T)
  have hL0 : ∀ w, 0 ≤ quotWeights Gf T w := fun w => quotNorm_nonneg _ _
  have hLmax : ∀ w, quotWeights Gf T w ≤ Lmax := fun w => le_sup' _ (mem_univ w)
  have hLmax0 : 0 ≤ Lmax := (hL0 (Classical.arbitrary ι)).trans (hLmax _)
  rw [quotNorm, Real.mul_iInf_of_nonneg (div_nonneg hLmax0 hs.le)]
  refine le_ciInf fun h => ?_
  have hAh : A *ᵥ (h : κ → ℝ) ∈ Gc := hAG h h.2
  have hyA : A *ᵥ (T *ᵥ y + (h : κ → ℝ)) = y + A *ᵥ (h : κ → ℝ) := by
    rw [Matrix.mulVec_add, Matrix.mulVec_mulVec, hAT, Matrix.one_mulVec]
  have hbdd : BddBelow (Set.range fun g : Gc => wl1 (quotWeights Gf T) (y + (g : ι → ℝ))) := by
    refine ⟨0, ?_⟩
    rintro _ ⟨g, rfl⟩
    exact sum_nonneg fun w _ => mul_nonneg (hL0 w) (abs_nonneg _)
  have h1 : quotCost Gc (quotWeights Gf T) y ≤ wl1 (quotWeights Gf T) (y + A *ᵥ (h : κ → ℝ)) :=
    ciInf_le hbdd ⟨_, hAh⟩
  have h2 : wl1 (quotWeights Gf T) (y + A *ᵥ (h : κ → ℝ)) ≤ Lmax * l1 (y + A *ᵥ (h : κ → ℝ)) := by
    unfold wl1 l1
    rw [mul_sum]
    exact sum_le_sum fun w _ => mul_le_mul_of_nonneg_right (hLmax w) (abs_nonneg _)
  have h3 : l1 (y + A *ᵥ (h : κ → ℝ)) ≤ 1 / s * l1 (T *ᵥ y + (h : κ → ℝ)) := by
    rw [← hyA]
    exact l1_mulVec_le A (1 / s) hA _
  calc quotCost Gc (quotWeights Gf T) y ≤ Lmax * l1 (y + A *ᵥ (h : κ → ℝ)) := h1.trans h2
    _ ≤ Lmax * (1 / s * l1 (T *ᵥ y + (h : κ → ℝ))) := mul_le_mul_of_nonneg_left h3 hLmax0
    _ = Lmax / s * l1 (T *ᵥ y + (h : κ → ℝ)) := by ring

/-- **The quotient one-shot loss is exact.** Under the hypotheses of `quot_loss_le`, suppose a
coarse field `y₀` has a coarse dual certificate `pc` (`|pc_w| ≤ 1`, `pc ⊥ G_c`,
`⟨pc, y₀⟩ = ‖y₀‖₁`, `pc` supported where `L_w = max L`; e.g. for a flat field, the circulation
along the lines of its direction) and a fine gauge representative `T y₀ + h₀` (`h₀ ∈ G_f`) of
`ℓ¹` mass `≤ s ‖y₀‖₁` (e.g. for a flat field, the constant representative). Then the quotient loss
bound is an equality at `y₀`. (The flat-field instances are illustrations; they are not
formalised in general.)

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem quot_loss_eq [Nonempty ι] (Gf : Submodule ℝ (κ → ℝ)) (Gc : Submodule ℝ (ι → ℝ))
    (T : Matrix κ ι ℝ) (A : Matrix ι κ ℝ) (hAT : A * T = 1) (hAG : ∀ h ∈ Gf, A *ᵥ h ∈ Gc)
    {s : ℝ} (hs : 0 < s) (hA : ∀ v, ∑ w, |A w v| ≤ 1 / s) {y₀ pc : ι → ℝ}
    (hpc1 : ∀ w, |pc w| ≤ 1) (hpcG : ∀ g ∈ Gc, ∑ w, pc w * g w = 0)
    (hpcy : ∑ w, pc w * y₀ w = l1 y₀)
    (hpcmax : ∀ w, pc w ≠ 0 → quotWeights Gf T w = univ.sup' univ_nonempty (quotWeights Gf T))
    {h₀ : κ → ℝ} (hh₀ : h₀ ∈ Gf) (hflat : l1 (T *ᵥ y₀ + h₀) ≤ s * l1 y₀) :
    quotCost Gc (quotWeights Gf T) y₀ =
      univ.sup' univ_nonempty (quotWeights Gf T) / s * quotNorm Gf (T *ᵥ y₀) := by
  set Lmax := univ.sup' univ_nonempty (quotWeights Gf T)
  have hL0 : ∀ w, 0 ≤ quotWeights Gf T w := fun w => quotNorm_nonneg _ _
  have hLmax0 : 0 ≤ Lmax :=
    (hL0 (Classical.arbitrary ι)).trans (le_sup' _ (mem_univ _))
  refine le_antisymm (quot_loss_le Gf Gc T A hAT hAG hs hA y₀) ?_
  have hlow : Lmax * l1 y₀ ≤ quotCost Gc (quotWeights Gf T) y₀ := by
    refine le_ciInf fun g => ?_
    have hterm : ∀ w, Lmax * (pc w * (y₀ + (g : ι → ℝ)) w) ≤
        quotWeights Gf T w * |(y₀ + (g : ι → ℝ)) w| := fun w => by
      by_cases hw : pc w = 0
      · rw [hw, zero_mul, mul_zero]; exact mul_nonneg (hL0 w) (abs_nonneg _)
      · rw [hpcmax w hw]
        apply mul_le_mul_of_nonneg_left _ hLmax0
        calc pc w * (y₀ + (g : ι → ℝ)) w ≤ |pc w * (y₀ + (g : ι → ℝ)) w| := le_abs_self _
          _ = |pc w| * |(y₀ + (g : ι → ℝ)) w| := abs_mul _ _
          _ ≤ 1 * |(y₀ + (g : ι → ℝ)) w| := mul_le_mul_of_nonneg_right (hpc1 w) (abs_nonneg _)
          _ = |(y₀ + (g : ι → ℝ)) w| := one_mul _
    have hsum : ∑ w, pc w * (y₀ + (g : ι → ℝ)) w = l1 y₀ := by
      simp only [Pi.add_apply, mul_add, sum_add_distrib, hpcy, hpcG g g.2, add_zero]
    calc Lmax * l1 y₀ = ∑ w, Lmax * (pc w * (y₀ + (g : ι → ℝ)) w) := by rw [← mul_sum, hsum]
      _ ≤ ∑ w, quotWeights Gf T w * |(y₀ + (g : ι → ℝ)) w| := sum_le_sum fun w _ => hterm w
      _ = wl1 (quotWeights Gf T) (y₀ + g) := rfl
  have hup : Lmax / s * quotNorm Gf (T *ᵥ y₀) ≤ Lmax * l1 y₀ := by
    calc Lmax / s * quotNorm Gf (T *ᵥ y₀) ≤ Lmax / s * l1 (T *ᵥ y₀ + h₀) :=
          mul_le_mul_of_nonneg_left (quotNorm_le Gf _ hh₀) (div_nonneg hLmax0 hs.le)
      _ ≤ Lmax / s * (s * l1 y₀) := mul_le_mul_of_nonneg_left hflat (div_nonneg hLmax0 hs.le)
      _ = Lmax * l1 y₀ := by field_simp
  linarith

/-- **The quotient loss is a lower bound for every gauge.** If `T'` is gauge-equivalent to `T`
(`T' y − T y ∈ G_f` for every `y`), then `L_w = N^q([T e_w]) ≤ ‖T' e_w‖₁` for every `w`. The
consequence `max_w L_w / s ≤ max_w ‖T' e_w‖₁ / s` (for `s > 0`), i.e. no gauge-fixed
reconstruction has a smaller one-shot constant than the quotient one, is `quot_const_le_gauge`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem quotWeights_le_colNorm (Gf : Submodule ℝ (κ → ℝ)) (T T' : Matrix κ ι ℝ)
    (hT' : ∀ y, T' *ᵥ y - T *ᵥ y ∈ Gf) (w : ι) : quotWeights Gf T w ≤ colNorm T' w := by
  have h := quotNorm_le Gf (T *ᵥ Pi.single w 1) (hT' (Pi.single w 1))
  rw [show T *ᵥ Pi.single w 1 + (T' *ᵥ Pi.single w 1 - T *ᵥ Pi.single w 1) =
    T' *ᵥ Pi.single w 1 by abel] at h
  refine h.trans (le_of_eq ?_)
  unfold l1 colNorm
  exact sum_congr rfl fun v _ => by rw [mulVec_single_one_apply]

/-- The quotient one-shot constant is at most that of any gauge-equivalent reconstruction: if
`T' y − T y ∈ G_f` for every `y` and `s > 0`, then `max_w L_w / s ≤ max_w ‖T' e_w‖₁ / s`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem quot_const_le_gauge [Nonempty ι] (Gf : Submodule ℝ (κ → ℝ)) (T T' : Matrix κ ι ℝ)
    (hT' : ∀ y, T' *ᵥ y - T *ᵥ y ∈ Gf) {s : ℝ} (hs : 0 < s) :
    univ.sup' univ_nonempty (quotWeights Gf T) / s ≤ cmax T' / s :=
  div_le_div_of_nonneg_right (sup'_le _ _ fun w _ =>
    (quotWeights_le_colNorm Gf T T' hT' w).trans (colNorm_le_cmax T' w)) hs.le

end Quotient

/-! ## 9. Curvature control of the tree-gauge loss (summation step, explicit hypotheses) -/

section Curvature

/-- **The level summation costs no logarithm.** For naturals `d ≥ 2`, `k` and reals `c, F₀ ≥ 0`,
`s, a, Φ`, `F_i`: if `Φ ≤ s a + Σ_{i<k} c 2^{(d−1)i} F_i` and `F_i ≤ F₀/2^{(d−2)i}` for every
`i < k`, then `Φ ≤ s a + c 2^k F₀`. The statement is this real inequality. Intended reading (not
formalised): `Φ` is the `ℓ¹` mass of a field in the hierarchical tree section, `s a` its top
average term, `F_i` its scale-`i` curvature fluxes with multiplicities `c 2^{(d−1)i}` (the first
hypothesis is the telescoping estimate along ancestors), and the second hypothesis says that the
curvature contracts.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem level_sum_bound {d k : ℕ} (hd : 2 ≤ d) {c s a Φ F₀ : ℝ} (F : ℕ → ℝ) (hc : 0 ≤ c)
    (hF₀ : 0 ≤ F₀) (htel : Φ ≤ s * a + ∑ i ∈ range k, c * 2 ^ ((d - 1) * i) * F i)
    (hcontr : ∀ i < k, F i ≤ F₀ / 2 ^ ((d - 2) * i)) : Φ ≤ s * a + c * 2 ^ k * F₀ := by
  have hterm : ∀ i ∈ range k, c * 2 ^ ((d - 1) * i) * F i ≤ c * F₀ * 2 ^ i := by
    intro i hi
    have hpow : (2 : ℝ) ^ ((d - 1) * i) = 2 ^ ((d - 2) * i) * 2 ^ i := by
      rw [← pow_add]; congr 1
      have : d - 1 = (d - 2) + 1 := by omega
      rw [this, add_mul, one_mul]
    have hpos : (0 : ℝ) < 2 ^ ((d - 2) * i) := by positivity
    have h := hcontr i (mem_range.mp hi)
    rw [le_div_iff₀ hpos] at h
    rw [hpow]
    calc c * (2 ^ ((d - 2) * i) * 2 ^ i) * F i = c * 2 ^ i * (F i * 2 ^ ((d - 2) * i)) := by ring
      _ ≤ c * 2 ^ i * F₀ := mul_le_mul_of_nonneg_left h (by positivity)
      _ = c * F₀ * 2 ^ i := by ring
  have hgeom : ∑ i ∈ range k, (2 : ℝ) ^ i ≤ 2 ^ k := by
    have h := geom_sum_eq (show (2 : ℝ) ≠ 1 by norm_num) k
    rw [h]
    linarith [show (0 : ℝ) < 2 ^ k by positivity]
  calc Φ ≤ s * a + ∑ i ∈ range k, c * 2 ^ ((d - 1) * i) * F i := htel
    _ ≤ s * a + ∑ i ∈ range k, c * F₀ * 2 ^ i := by linarith [sum_le_sum hterm]
    _ = s * a + c * F₀ * ∑ i ∈ range k, (2 : ℝ) ^ i := by rw [mul_sum]
    _ ≤ s * a + c * F₀ * 2 ^ k := by
        linarith [mul_le_mul_of_nonneg_left hgeom (mul_nonneg hc hF₀)]
    _ = s * a + c * 2 ^ k * F₀ := by ring

/-- **The tree-gauge loss is controlled by the curvature mass.** For naturals `d ≥ 2`, `k` and
reals `c, Φ, κ`: if `Φ ≤ 2^{(d−1)k}·1 + c 2^k (2^{(d−2)k} κ)`, then `Φ / 2^{(d−1)k} ≤ 1 + c κ`.
The statement is this real inequality. Intended reading (not formalised): `Φ = ‖T_k e_w‖₁` obeys
the conclusion of `level_sum_bound` with `s = 2^{(d−1)k}`, top average of `ℓ¹` mass `1` and
`F₀ = 2^{(d−2)k} κ` (`κ` the curvature mass in natural units), so the one-shot loss satisfies
`‖T_k e_w‖₁ / s ≤ 1 + c κ`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem loss_le_one_add_curvature {d k : ℕ} (hd : 2 ≤ d) {c Φ κ : ℝ}
    (hΦ : Φ ≤ 2 ^ ((d - 1) * k) * 1 + c * 2 ^ k * (2 ^ ((d - 2) * k) * κ)) :
    Φ / 2 ^ ((d - 1) * k) ≤ 1 + c * κ := by
  have hpow : (2 : ℝ) ^ ((d - 1) * k) = 2 ^ k * 2 ^ ((d - 2) * k) := by
    rw [← pow_add]; congr 1
    have : d - 1 = (d - 2) + 1 := by omega
    rw [this, add_mul, one_mul, add_comm]
  rw [div_le_iff₀ (by positivity), hpow]
  rw [hpow] at hΦ
  nlinarith

/-- **The curvature mass at fixed coarse side.** For a natural `k` and reals `N`, `curv`, `Q`: if
`Q ≤ 1536` and `curv ≤ √(6 (2^k N)⁴) √Q`, then `curv / 4^k ≤ 96 N²`. The statement is this real
inequality. Intended reading (not formalised): on `(ℤ/n)⁴` with `n = 2^k N`, `curv = ‖dφ‖₁`, the
second hypothesis is Cauchy–Schwarz over the `6n⁴` plaquettes, `Q ≤ 1536` is an energy bound, and
the conclusion is `κ = ‖dφ‖₁/4^k ≤ 96 N²`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem curvature_mass_le {k : ℕ} {N curv Q : ℝ} (hQ : Q ≤ 1536)
    (hcs : curv ≤ √(6 * (2 ^ k * N) ^ 4) * √Q) : curv / 4 ^ k ≤ 96 * N ^ 2 := by
  have h1 : √(6 * (2 ^ k * N) ^ 4) * √Q ≤ √(6 * (2 ^ k * N) ^ 4) * √1536 :=
    mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt hQ) (Real.sqrt_nonneg _)
  have h2 : √(6 * (2 ^ k * N) ^ 4) * √1536 = 96 * (4 ^ k * N ^ 2) := by
    rw [← Real.sqrt_mul (by positivity)]
    rw [Real.sqrt_eq_iff_mul_self_eq (by positivity) (by positivity)]
    have : ((2 : ℝ) ^ k) ^ 4 = (4 ^ k) ^ 2 := by
      rw [← pow_mul, ← pow_mul, show (4 : ℝ) = 2 ^ 2 by norm_num, ← pow_mul]; ring_nf
    rw [mul_pow, this]
    ring
  rw [div_le_iff₀ (by positivity)]
  linarith

end Curvature

/-! ## 10. Non-vacuity: the main hypothesis bundles on concrete data -/

section Examples

/-- A `2 × 4` block-average matrix with nonnegative entries and all column sums `1/2`. -/
def exA : Matrix (Fin 2) (Fin 4) ℝ := !![1 / 4, 1 / 2, 1 / 4, 0; 1 / 4, 0, 1 / 4, 1 / 2]

/-- A sign-changing reconstruction with `exA * exT = 1`; each column has negative mass `1`. -/
def exT : Matrix (Fin 4) (Fin 2) ℝ := !![1, 1; 1, -1; 1, 1; -1, 1]

/-- The flat coarse field `(1, 1)`. -/
def exY : Fin 2 → ℝ := ![1, 1]

/-- `exA * exT = 1`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem exA_mul_exT : exA * exT = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [exA, exT, Matrix.mul_apply, Fin.sum_univ_four] <;> norm_num

/-- Both column norms of `exT` equal `4`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem exT_colNorm (w : Fin 2) : colNorm exT w = 4 := by
  fin_cases w <;> simp [colNorm, exT, Fin.sum_univ_four] <;> norm_num

/-- `c* = 4` for `exT`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem exT_cmax : cmax exT = 4 := by
  have e : colNorm exT = fun _ => 4 := funext exT_colNorm
  rw [cmax, e, Finset.sup'_const]

/-- **Non-vacuity of the equality criterion and the negative-mass identity.** The data `A = exA`
(nonnegative, column sums exactly `1/2`), `T = exT` (sign-changing), `A T = I`, and the flat
field `y = (1, 1)` (nonzero, supported on `argmax c`, with `T y ≥ 0`) satisfy every hypothesis of
`oneShot_sup_eq_of_nonneg`, each stated as a conjunct; the conclusion is that the one-shot loss is
exactly `c*/s`, and `c*/s = 2`. (For illustration, not part of the statement: `T y = (2, 0, 2, 0)`
and `c* = 4`, `exT_cmax`.) The statement also gives the negative-mass identity at `w = 0` and the
negative mass `N⁻_0 = 1`; with `‖T e_0‖₁ = 4` (`exT_colNorm`) the identity reads `2 = 1 + 2·1/2`.
The unit field `e_0`, whose reconstruction cancels inside the second row of `A`, only reaches the
ratio `1 < 2`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem example_oneShot_exact :
    exA * exT = 1 ∧ (∀ i j, 0 ≤ exA i j) ∧ (∀ j, ∑ i, exA i j = 1 / 2) ∧ exY ≠ 0 ∧
      (∀ w, exY w ≠ 0 → colNorm exT w = cmax exT) ∧ (∀ j, 0 ≤ (exT *ᵥ exY) j) ∧
      IsLUB (lossSet exT) (cmax exT / 2) ∧ cmax exT / 2 = 2 ∧
      colNorm exT 0 / 2 = 1 + 2 * (∑ v, max (-exT v 0) 0) / 2 ∧
      (∑ v, max (-exT v 0) 0) = 1 ∧ lossRatio exT (Pi.single 0 1) = 1 := by
  have hA0 : ∀ i j, 0 ≤ exA i j := by
    intro i j; fin_cases i <;> fin_cases j <;> simp [exA]
  have hcol : ∀ j, ∑ i, exA i j = 1 / 2 := by
    intro j; fin_cases j <;> simp [exA, Fin.sum_univ_two] <;> norm_num
  have hy : exY ≠ 0 := fun h => by
    have := congrFun h 0
    simp [exY] at this
  have ha : ∀ w, exY w ≠ 0 → colNorm exT w = cmax exT := fun w _ => by
    rw [exT_colNorm, exT_cmax]
  have hTy : ∀ j, 0 ≤ (exT *ᵥ exY) j := by
    intro j; fin_cases j <;> simp [exT, exY, Matrix.mulVec, dotProduct, Fin.sum_univ_two]
  have hneg : (∑ v, max (-exT v 0) 0) = 1 := by
    simp [exT, Fin.sum_univ_four]
  have hratio : lossRatio exT (Pi.single 0 1) = 1 := by
    have hnum : ∑ w, colNorm exT w * |(Pi.single 0 1 : Fin 2 → ℝ) w| = 4 := by
      simp [Fin.sum_univ_two, exT_colNorm, Pi.single_apply]
    have hden : l1 (exT *ᵥ Pi.single 0 1) = 4 := by
      rw [← exT_colNorm 0]
      unfold l1 colNorm
      simp only [mulVec_single_one_apply]
    rw [lossRatio, hnum, hden]
    norm_num
  refine ⟨exA_mul_exT, hA0, hcol, hy, ha, hTy,
    oneShot_sup_eq_of_nonneg exT exA exA_mul_exT hA0 hcol hy ha hTy, by rw [exT_cmax]; norm_num,
    colNorm_div_eq_one_add_negMass exT exA exA_mul_exT (by norm_num) hcol 0, hneg, hratio⟩

/-- **Non-vacuity of the bounded-product criterion.** The factors `g_i = 1 + 2^{−(i+1)}` are all
`> 1` (lossy at every scale), the increments `a_i = 2^{−(i+1)} ≥ 0` are summable, and the
criterion gives that the cumulative factor `Π_{i<k} g_i` is bounded: lossy infinitely often
does not mean multiplicative loss.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem example_bounded_product :
    (∀ i : ℕ, 0 ≤ (1 / 2 : ℝ) ^ (i + 1)) ∧ Summable (fun i : ℕ => (1 / 2 : ℝ) ^ (i + 1)) ∧
      (∀ i : ℕ, 1 < 1 + (1 / 2 : ℝ) ^ (i + 1)) ∧
      BddAbove (Set.range fun k => ∏ i ∈ range k, (1 + (1 / 2 : ℝ) ^ (i + 1))) := by
  have h0 : ∀ i : ℕ, 0 ≤ (1 / 2 : ℝ) ^ (i + 1) := fun i => by positivity
  have hs : Summable (fun i : ℕ => (1 / 2 : ℝ) ^ (i + 1)) :=
    (summable_geometric_of_lt_one (by norm_num) (by norm_num)).comp_injective
      (add_left_injective 1)
  exact ⟨h0, hs, fun i => by linarith [show (0 : ℝ) < (1 / 2) ^ (i + 1) by positivity],
    (prod_bddAbove_iff_summable _ h0).mpr hs⟩

/-- A `2 × 4` block average with overlapping rows (sites `1, 2` lie in both rows). -/
def exP : Matrix (Fin 2) (Fin 4) ℝ := !![1 / 2, 1 / 4, 1 / 4, 0; 0, 1 / 4, 1 / 4, 1 / 2]

/-- A nonnegative right inverse of `exP`, supported on the private sites `0` and `3`. -/
def exR : Matrix (Fin 4) (Fin 2) ℝ := !![2, 0; 0, 0; 0, 0; 0, 2]

/-- **Non-vacuity of the private-support statement.** `P = exP` (nonnegative, rows covering every
site, rows overlapping: the statement records the overlap at site `1`; they also overlap at site
`2`), `R = exR ≥ 0`, `P R = I`; the conclusions: distinct columns of `R` are disjoint, and the box
hull is exact, `Σ_w ‖R e_w‖₁ |y_w| = ‖R y‖₁` for all `y`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem example_private_support :
    (∀ w x, 0 ≤ exP w x) ∧ (∀ x w, 0 ≤ exR x w) ∧ exP * exR = 1 ∧ (∀ x, ∃ u, 0 < exP u x) ∧
      0 < exP 0 1 ∧ 0 < exP 1 1 ∧
      (∀ x (w w' : Fin 2), w ≠ w' → exR x w = 0 ∨ exR x w' = 0) ∧
      ∀ y : Fin 2 → ℝ, ∑ w, colNorm exR w * |y w| = l1 (exR *ᵥ y) := by
  have hP : ∀ w x, 0 ≤ exP w x := by
    intro w x; fin_cases w <;> fin_cases x <;> simp [exP]
  have hR : ∀ x w, 0 ≤ exR x w := by
    intro x w; fin_cases x <;> fin_cases w <;> simp [exR]
  have hPR : exP * exR = 1 := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [exP, exR, Matrix.mul_apply, Fin.sum_univ_four]
  have hcov : ∀ x, ∃ u, 0 < exP u x := by
    intro x
    fin_cases x
    · exact ⟨0, by simp [exP]⟩
    · exact ⟨0, by simp [exP]⟩
    · exact ⟨0, by simp [exP]⟩
    · exact ⟨1, by simp [exP]⟩
  have hdisj := fun x (w w' : Fin 2) (h : w ≠ w') =>
    colDisjoint_of_private exP exR hP hR hPR hcov x h
  exact ⟨hP, hR, hPR, hcov, by simp [exP], by simp [exP], hdisj,
    wl1_colNorm_eq_of_disjoint exR hdisj⟩

/-- **Non-vacuity of the absorption bundle (bounded case).** `A_c = 1`, `κ = 1`, `A = 15`, and the
constant loss `ℓ_k = 2 ≥ 1`: the hypotheses of `absorbable_iff_bddAbove` hold and the loss is
absorbable.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem example_absorbable :
    (0 : ℝ) ≤ 1 ∧ (0 : ℝ) < 1 ∧ (0 : ℝ) < 15 ∧ (∀ k : ℕ, (1 : ℝ) ≤ (fun _ => 2) k) ∧
      Absorbable 1 1 15 (fun _ => 2) := by
  refine ⟨by norm_num, by norm_num, by norm_num, fun _ => by norm_num, ?_⟩
  rw [absorbable_iff_bddAbove (by norm_num) (by norm_num) (by norm_num) (fun _ => by norm_num)]
  exact ⟨2, by rintro _ ⟨k, rfl⟩; exact le_rfl⟩

/-- The harmonic loss `ℓ_k = 1 + Σ_{i<k} 1/(i+1)`, whose increments `1/(k+1)` decay to `0`. -/
def harmonicLoss (k : ℕ) : ℝ := 1 + ∑ i ∈ range k, (1 / ((i : ℝ) + 1))

/-- **Non-vacuity of the absorption bundle (harmonic case).** For `A_c = 1`, `κ = 1`, `A = 15`,
`c = 1` and `ℓ_k = 1 + Σ_{i<k} 1/(i+1)`, the statement lists the hypotheses `ℓ_k ≥ 1` and
`ℓ_{k+1} − ℓ_k ≥ 1/(k+1)` of `not_absorbable_of_harmonic` (its other hypotheses, `0 ≤ A_c`,
`0 < κ`, `0 < A` and `0 < c`, hold for these numbers but are not conjuncts). The conclusions: the
loss is not absorbable, and some `k` has `ℓ_k α̂_16 > 1`, so no top cube of side `16` absorbs every
scale at the level `α' = 1`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem example_harmonic :
    (∀ k, 1 ≤ harmonicLoss k) ∧
      (∀ k : ℕ, 1 / ((k : ℝ) + 1) ≤ harmonicLoss (k + 1) - harmonicLoss k) ∧
      ¬ Absorbable 1 1 15 harmonicLoss ∧ ∃ k, (1 : ℝ) < harmonicLoss k * cubeThreshold 15 16 := by
  have h1 : ∀ k, 1 ≤ harmonicLoss k := fun k => by
    unfold harmonicLoss
    have : 0 ≤ ∑ i ∈ range k, (1 / ((i : ℝ) + 1)) := sum_nonneg fun i _ => by positivity
    linarith
  have hinc : ∀ k : ℕ, 1 / ((k : ℝ) + 1) ≤ harmonicLoss (k + 1) - harmonicLoss k := fun k => by
    unfold harmonicLoss
    rw [sum_range_succ]
    linarith
  have hna := not_absorbable_of_harmonic (Ac := 1) (κ := 1) (A := 15) (by norm_num) (by norm_num)
    (by norm_num) h1
    (by norm_num : (0 : ℝ) < 1) hinc
  refine ⟨h1, hinc, hna, absorption_fails (by norm_num) ?_ (by norm_num) 1⟩
  intro hb
  exact hna ((absorbable_iff_bddAbove (by norm_num) (by norm_num) (by norm_num) h1).mpr hb)

/-- The reference column on one site: `φ = (1)`. -/
def exPhi : EuclideanSpace ℝ (Fin 1) := !₂[1]

/-- **Non-vacuity of the assembly bundle (a degenerate instance).** One site, `φ = ψ = (1)`,
`D = 0` (so `Q ≡ 0`), `K = 0`, `L = 1`, `p_R = 1`, `q_R = 0`, `c_P = 1`, `C_D = 1`, `λ = 1`, one
annulus (`ann ≡ 0`, `T = 1`). The conjuncts are minimality, the reference field, the one-shot
Poincaré inequality, the column decay and the annulus counts; because `D = 0` and `K = 0`,
minimality, the energy bound `Q(ψ) ≤ 0` and the Poincaré inequality hold trivially. The side
conditions `L > 0`, `c_P > 0`, `λ > 0`, `C_D ≥ 0` and `ann v < T` hold for these numbers but are
not conjuncts. The conclusions: the `ℓ²` column bound (`Q(φ) + Q(ψ − φ) = Q(ψ)` and
`‖φ‖ ≤ (1 + √(0/1))·1 = 1`), and the assembly bound `‖φ‖₁ ≤ 16√6 (1 + √(0/1)) (1 − e^{−1})^{−5/2}`,
also in the scale form with `k = 0`. (Here `‖φ‖₁ = 1`; that value is not part of the statement.)

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem example_assembly :
    let D : EuclideanSpace ℝ (Fin 1) →ₗ[ℝ] ℝ := 0
    let K : Submodule ℝ (EuclideanSpace ℝ (Fin 1)) := ⊥
    let ann : Fin 1 → ℕ := fun _ => 0
    (∀ η ∈ K, ‖D exPhi‖ ^ 2 ≤ ‖D (exPhi + η)‖ ^ 2) ∧ exPhi - exPhi ∈ K ∧
      ‖D exPhi‖ ^ 2 ≤ 0 ∧ ‖exPhi‖ ≤ 1 * 1 ∧ (∀ η ∈ K, 1 * ‖η‖ ^ 2 ≤ 1 ^ 2 * ‖D η‖ ^ 2) ∧
      (∀ t : ℕ, √(∑ v ∈ univ.filter (fun v => t ≤ ann v), exPhi.ofLp v ^ 2) ≤
        1 * Real.exp (-1 * t) * ‖exPhi‖) ∧
      (∀ t : ℕ, ((univ.filter fun v => ann v = t).card : ℝ) ≤ 256 * ((t : ℝ) + 1) ^ 3 * 1 ^ 4) ∧
      l1 exPhi.ofLp ≤ 16 * √6 * (1 + √(0 / 1)) * 1 /
        ((1 - Real.exp (-1)) ^ 2 * √(1 - Real.exp (-1))) * 1 ^ 3 ∧
      (‖D exPhi‖ ^ 2 + ‖D (exPhi - exPhi)‖ ^ 2 = ‖D exPhi‖ ^ 2 ∧
        ‖exPhi‖ ≤ (1 + √(0 / 1)) * 1) ∧
      l1 exPhi.ofLp / 8 ^ 0 ≤ 16 * √6 * (1 + √(0 / 1)) * 1 /
        ((1 - Real.exp (-1)) ^ 2 * √(1 - Real.exp (-1))) := by
  intro D K ann
  have hnorm : ‖exPhi‖ = 1 := by
    rw [EuclideanSpace.norm_eq, Real.sqrt_eq_one]
    simp [exPhi]
  have hM : ∀ η ∈ K, ‖D exPhi‖ ^ 2 ≤ ‖D (exPhi + η)‖ ^ 2 := fun _ _ => by simp [D]
  have hψ : exPhi - exPhi ∈ K := by simp [K]
  have hQ : ‖D exPhi‖ ^ 2 ≤ 0 := by simp [D]
  have hp : ‖exPhi‖ ≤ 1 * 1 := by rw [hnorm]; norm_num
  have hP : ∀ η ∈ K, 1 * ‖η‖ ^ 2 ≤ 1 ^ 2 * ‖D η‖ ^ 2 := fun η hη => by
    rw [Submodule.mem_bot] at hη
    simp [hη, D]
  have hdec : ∀ t : ℕ, √(∑ v ∈ univ.filter (fun v => t ≤ ann v), exPhi.ofLp v ^ 2) ≤
      1 * Real.exp (-1 * t) * ‖exPhi‖ := by
    intro t
    rcases Nat.eq_zero_or_pos t with rfl | ht
    · have e : univ.filter (fun v : Fin 1 => 0 ≤ ann v) = univ := by
        ext v; simp
      rw [e, hnorm]
      simp [exPhi]
    · have e : univ.filter (fun v : Fin 1 => t ≤ ann v) = ∅ := by
        refine Finset.eq_empty_iff_forall_notMem.mpr fun v hv => ?_
        simp only [mem_filter, mem_univ, true_and, ann] at hv
        omega
      rw [e, sum_empty, Real.sqrt_zero]
      positivity
  have hcount : ∀ t : ℕ, ((univ.filter fun v => ann v = t).card : ℝ) ≤
      256 * ((t : ℝ) + 1) ^ 3 * 1 ^ 4 := by
    intro t
    have hc : ((univ.filter fun v : Fin 1 => ann v = t).card : ℝ) ≤ 1 := by
      have := card_filter_le (univ : Finset (Fin 1)) (fun v => ann v = t)
      have h' : ((univ.filter fun v : Fin 1 => ann v = t).card : ℝ) ≤ (univ : Finset (Fin 1)).card :=
        by exact_mod_cast this
      simpa using h'
    have : (1 : ℝ) ≤ 256 * ((t : ℝ) + 1) ^ 3 * 1 ^ 4 := by
      have : (1 : ℝ) ≤ ((t : ℝ) + 1) ^ 3 := one_le_pow₀ (by linarith [(Nat.cast_nonneg t : (0 : ℝ) ≤ t)])
      nlinarith
    linarith
  have hp0 : ‖exPhi‖ ≤ 1 * 2 ^ 0 := by simpa using hp
  have hP0 : ∀ η ∈ K, 1 * ‖η‖ ^ 2 ≤ (2 ^ 0) ^ 2 * ‖D η‖ ^ 2 := by simpa using hP
  have hcount0 : ∀ t : ℕ, ((univ.filter fun v => ann v = t).card : ℝ) ≤
      256 * ((t : ℝ) + 1) ^ 3 * (2 ^ 0) ^ 4 := by simpa using hcount
  exact ⟨hM, hψ, hQ, hp, hP, hdec, hcount,
    assembly_bound D K (L := 1) (pR := 1) (qR := 0) (cP := 1) (CD := 1) (lam := 1) one_pos
      one_pos one_pos zero_le_one ann 1 (fun _ => by simp [ann]) hM hψ hQ hp hP hdec hcount,
    l2_column_bound D K (L := 1) (pR := 1) (qR := 0) (cP := 1) one_pos one_pos hM hψ hQ hp hP,
    assembly_loss_bound D K 0 (pR := 1) (qR := 0) (cP := 1) (CD := 1) (lam := 1) one_pos one_pos
      zero_le_one ann 1 (fun _ => by simp [ann]) hM hψ hQ hp0 hP0 hdec hcount0⟩

/-- The coordinate maps of `ℝ³` as linear maps. -/
def exProj (i : Fin 3) : EuclideanSpace ℝ (Fin 3) →ₗ[ℝ] ℝ :=
  (EuclideanSpace.proj (𝕜 := ℝ) i : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ).toLinearMap

/-- `exProj i x = x_i`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem exProj_apply (i : Fin 3) (x : EuclideanSpace ℝ (Fin 3)) : exProj i x = x.ofLp i := by
  simp [exProj]

/-- The pure-gauge subspace of the example: fields `(0, 0, z)`. -/
def exW : Submodule ℝ (EuclideanSpace ℝ (Fin 3)) :=
  LinearMap.ker (exProj 0) ⊓ LinearMap.ker (exProj 1)

/-- The slice of the example: fields with `x₂ = x₀ + x₁`. -/
def exS : Submodule ℝ (EuclideanSpace ℝ (Fin 3)) :=
  LinearMap.ker (exProj 2 - exProj 0 - exProj 1)

/-- The block average of the example: `x ↦ x₀`. -/
def exAvg : EuclideanSpace ℝ (Fin 3) →ₗ[ℝ] ℝ := exProj 0

/-- The energy operator of the example: `x ↦ x₁` (so `Q(x) = x₁²`). -/
def exD : EuclideanSpace ℝ (Fin 3) →ₗ[ℝ] ℝ := exProj 1

/-- Membership in the pure-gauge subspace of the example.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem exW_mem (x : EuclideanSpace ℝ (Fin 3)) : x ∈ exW ↔ x.ofLp 0 = 0 ∧ x.ofLp 1 = 0 := by
  simp [exW, exProj_apply]

/-- Membership in the slice of the example.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem exS_mem (x : EuclideanSpace ℝ (Fin 3)) : x ∈ exS ↔ x.ofLp 2 = x.ofLp 0 + x.ofLp 1 := by
  rw [exS, LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.sub_apply, exProj_apply, exProj_apply,
    exProj_apply, sub_sub, sub_eq_zero]

/-- `‖x‖² = x₀² + x₁² + x₂²` in `ℝ³`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem ex_norm_sq (x : EuclideanSpace ℝ (Fin 3)) :
    ‖x‖ ^ 2 = x.ofLp 0 ^ 2 + x.ofLp 1 ^ 2 + x.ofLp 2 ^ 2 := by
  rw [EuclideanSpace.norm_eq, Real.sq_sqrt (by positivity)]
  simp [Fin.sum_univ_three]

/-- The average of the example vanishes on its pure gauges.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem exW_le_avg : exW ≤ LinearMap.ker exAvg := fun x hx => by
  rw [exW_mem] at hx; simp [exAvg, exProj_apply, hx.1]

/-- The energy operator of the example vanishes on its pure gauges.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem exW_le_D : exW ≤ LinearMap.ker exD := fun x hx => by
  rw [exW_mem] at hx; simp [exD, exProj_apply, hx.2]

/-- The slice of the example meets the pure gauges only in `0`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem exS_inf_exW : exS ⊓ exW = ⊥ := by
  rw [eq_bot_iff]
  intro x hx
  rw [Submodule.mem_inf, exS_mem, exW_mem] at hx
  rw [Submodule.mem_bot]
  ext i
  fin_cases i <;> simp [hx.2.1, hx.2.2, hx.1]

/-- The slice and the pure gauges of the example span `ℝ³`.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem exS_sup_exW : exS ⊔ exW = ⊤ := by
  rw [eq_top_iff]
  intro x _
  rw [Submodule.mem_sup]
  refine ⟨!₂[x.ofLp 0, x.ofLp 1, x.ofLp 0 + x.ofLp 1], by rw [exS_mem]; simp,
    !₂[0, 0, x.ofLp 2 - x.ofLp 0 - x.ofLp 1], by rw [exW_mem]; simp, ?_⟩
  ext i
  fin_cases i <;> simp

/-- **Non-vacuity of the section bundle.** In `ℝ³` take the pure gauges `W = {(0, 0, z)}`, the base
section `Σ₀ = ℝ³`, the slice `S = {x₂ = x₀ + x₁}`, the block average `A x = x₀` and the energy
`Q(x) = x₁²`. Then `A` and `D` vanish on `W`, `W ≤ Σ₀`, `S ∩ W = 0`, `S + W = Σ₀`, and the slice
has the one-shot Poincaré constant `1/2` (`L = 1`). The conclusions: `Φ_W = I − P_W` is a linear
bijection `S ≃ Σ₀ ∩ W^⊥` (a linear equivalence `e : S ≃ₗ[ℝ] ↥(Σ₀ ⊓ Wᗮ)` with `e x = Φ_W x`), the
constant `1/2` transfers to the `ℓ²`-minimal section, and the quotient Poincaré inequality with
constant `1`, `dist(φ, W)² ≤ Q(φ)` on `Σ₀ ∩ ker A`, holds.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem example_section :
    exW ≤ LinearMap.ker exAvg ∧ exW ≤ LinearMap.ker exD ∧ exW ≤ ⊤ ∧ exS ⊓ exW = ⊥ ∧
      exS ⊔ exW = ⊤ ∧
      (∀ φ ∈ exS, exAvg φ = 0 → 1 / 2 * ‖φ‖ ^ 2 ≤ 1 ^ 2 * ‖exD φ‖ ^ 2) ∧
      (∃ e : exS ≃ₗ[ℝ] ↥((⊤ : Submodule ℝ (EuclideanSpace ℝ (Fin 3))) ⊓ exWᗮ),
        ∀ x : exS, (e x : EuclideanSpace ℝ (Fin 3)) = gaugeReduce exW x) ∧
      (∀ φ ∈ (⊤ : Submodule ℝ (EuclideanSpace ℝ (Fin 3))) ⊓ exWᗮ, exAvg φ = 0 →
        1 / 2 * ‖φ‖ ^ 2 ≤ 1 ^ 2 * ‖exD φ‖ ^ 2) ∧
      (∀ φ ∈ (⊤ : Submodule ℝ (EuclideanSpace ℝ (Fin 3))), exAvg φ = 0 →
        1 * ‖gaugeReduce exW φ‖ ^ 2 ≤ 1 ^ 2 * ‖exD φ‖ ^ 2) := by
  have hPS : ∀ φ ∈ exS, exAvg φ = 0 → 1 / 2 * ‖φ‖ ^ 2 ≤ 1 ^ 2 * ‖exD φ‖ ^ 2 := by
    intro φ hφ hA
    rw [exS_mem] at hφ
    have h0 : φ.ofLp 0 = 0 := by simpa [exAvg, exProj_apply] using hA
    rw [ex_norm_sq, hφ, h0]
    simp [exD, exProj_apply]
    linarith
  have hPsec := poincare_transfer exW ⊤ exAvg exD exW_le_D exS (c := 1 / 2) (L := 1)
    (by norm_num) (slice_covers exW ⊤ exS exAvg exW_le_avg exS_sup_exW) hPS
  have hQ : ∀ φ ∈ (⊤ : Submodule ℝ (EuclideanSpace ℝ (Fin 3))) ⊓ exWᗮ, exAvg φ = 0 →
      1 * ‖φ‖ ^ 2 ≤ 1 ^ 2 * ‖exD φ‖ ^ 2 := by
    intro φ hφ hA
    have h0 : φ.ofLp 0 = 0 := by simpa [exAvg, exProj_apply] using hA
    have hW2 : (!₂[0, 0, 1] : EuclideanSpace ℝ (Fin 3)) ∈ exW := by rw [exW_mem]; simp
    have h2 : φ.ofLp 2 = 0 := by
      have := Submodule.inner_right_of_mem_orthogonal hW2 hφ.2
      simpa [PiLp.inner_apply, Fin.sum_univ_three] using this
    rw [ex_norm_sq, h0, h2]
    simp [exD, exProj_apply]
  exact ⟨exW_le_avg, exW_le_D, le_top, exS_inf_exW, exS_sup_exW, hPS,
    exists_sectionEquiv exW ⊤ exS le_top exS_inf_exW exS_sup_exW, hPsec,
    (quotient_poincare_iff exW ⊤ exAvg exD exW_le_avg exW_le_D le_top 1 1).mpr hQ⟩

/-- **Non-vacuity of the minimiser, proper-fibre and ratio-set bundles.** On the data of
`example_section` (whose structural hypotheses, `A` and `D` vanishing on `W` and `S + W = Σ₀`,
are conjuncts there, not here), the field `x = (1, 0, 1) ∈ S` minimises `Q` on its fibre and the
slice has proper fibres (`Q > 0` on `S ∩ ker A \ 0`). The minimiser is degenerate:
`Q(x) = x₁² = 0`, so its minimality is trivial (the value `Q(x) = 0` is not itself a conjunct).
The conclusions: `Φ_W x` lies in the `ℓ²`-minimal section with the same average and energy and
minimises `Q` there; that section has proper fibres; and its Rayleigh quotients are the quotient
Rayleigh quotients.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem example_section_transfer :
    (!₂[1, 0, 1] : EuclideanSpace ℝ (Fin 3)) ∈ exS ∧
      (∀ x' ∈ exS, exAvg x' = exAvg !₂[1, 0, 1] →
        ‖exD !₂[1, 0, 1]‖ ^ 2 ≤ ‖exD x'‖ ^ 2) ∧
      (∀ x ∈ exS, exAvg x = 0 → x ≠ 0 → 0 < ‖exD x‖ ^ 2) ∧
      (gaugeReduce exW !₂[1, 0, 1] ∈ (⊤ : Submodule ℝ (EuclideanSpace ℝ (Fin 3))) ⊓ exWᗮ ∧
        exAvg (gaugeReduce exW !₂[1, 0, 1]) = exAvg !₂[1, 0, 1] ∧
        ‖exD (gaugeReduce exW !₂[1, 0, 1])‖ = ‖exD !₂[1, 0, 1]‖ ∧
        ∀ z ∈ (⊤ : Submodule ℝ (EuclideanSpace ℝ (Fin 3))) ⊓ exWᗮ, exAvg z = exAvg !₂[1, 0, 1] →
          ‖exD (gaugeReduce exW !₂[1, 0, 1])‖ ^ 2 ≤ ‖exD z‖ ^ 2) ∧
      (∀ z ∈ (⊤ : Submodule ℝ (EuclideanSpace ℝ (Fin 3))) ⊓ exWᗮ, exAvg z = 0 → z ≠ 0 →
        0 < ‖exD z‖ ^ 2) ∧
      {r | ∃ φ ∈ (⊤ : Submodule ℝ (EuclideanSpace ℝ (Fin 3))), exAvg φ = 0 ∧ φ ∉ exW ∧
          r = ‖exD φ‖ ^ 2 / ‖gaugeReduce exW φ‖ ^ 2} =
        {r | ∃ φ ∈ (⊤ : Submodule ℝ (EuclideanSpace ℝ (Fin 3))) ⊓ exWᗮ, exAvg φ = 0 ∧ φ ≠ 0 ∧
          r = ‖exD φ‖ ^ 2 / ‖φ‖ ^ 2} := by
  have hx : (!₂[1, 0, 1] : EuclideanSpace ℝ (Fin 3)) ∈ exS := by rw [exS_mem]; simp
  have hmin : ∀ x' ∈ exS, exAvg x' = exAvg !₂[1, 0, 1] →
      ‖exD !₂[1, 0, 1]‖ ^ 2 ≤ ‖exD x'‖ ^ 2 := fun x' _ _ => by
    simp [exD, exProj_apply]
    exact sq_nonneg _
  have hpos : ∀ x ∈ exS, exAvg x = 0 → x ≠ 0 → 0 < ‖exD x‖ ^ 2 := by
    intro x hxS hA hx0
    rw [exS_mem] at hxS
    have h0 : x.ofLp 0 = 0 := by simpa [exAvg, exProj_apply] using hA
    have h1 : x.ofLp 1 ≠ 0 := fun h1 => hx0 (by
      ext i; fin_cases i <;> simp [h0, h1, hxS])
    have e : ‖exD x‖ ^ 2 = x.ofLp 1 ^ 2 := by simp [exD, exProj_apply]
    rw [e]
    exact lt_of_le_of_ne (sq_nonneg _) (Ne.symm (pow_ne_zero 2 h1))
  exact ⟨hx, hmin, hpos,
    minimizer_transfer exW ⊤ exS exAvg exD exW_le_avg exW_le_D le_top exS_sup_exW hx hmin,
    posdef_transfer exW ⊤ exS exAvg exD exW_le_avg exW_le_D exS_sup_exW hpos,
    quotient_ratio_sets_eq exW ⊤ exAvg exD exW_le_avg exW_le_D le_top⟩

/-- **Non-vacuity of the dimension criterion (a fully degenerate instance).** In `ℝ³` with
`S = Σ₀ = ℝ³` and `W = 0`: `W, S ≤ Σ₀`, `S ∩ W = 0` and `dim S + dim W = dim Σ₀`; the conclusion
is `S + W = Σ₀`. With `W = 0` every conjunct, the conclusion included, holds trivially.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem example_finrank :
    (⊥ : Submodule ℝ (EuclideanSpace ℝ (Fin 3))) ≤ ⊤ ∧
      (⊤ : Submodule ℝ (EuclideanSpace ℝ (Fin 3))) ≤ ⊤ ∧
      (⊤ : Submodule ℝ (EuclideanSpace ℝ (Fin 3))) ⊓ ⊥ = ⊥ ∧
      Module.finrank ℝ (⊤ : Submodule ℝ (EuclideanSpace ℝ (Fin 3))) +
          Module.finrank ℝ (⊥ : Submodule ℝ (EuclideanSpace ℝ (Fin 3))) =
        Module.finrank ℝ (⊤ : Submodule ℝ (EuclideanSpace ℝ (Fin 3))) ∧
      (⊤ : Submodule ℝ (EuclideanSpace ℝ (Fin 3))) ⊔ ⊥ = ⊤ := by
  have hdim : Module.finrank ℝ (⊤ : Submodule ℝ (EuclideanSpace ℝ (Fin 3))) +
      Module.finrank ℝ (⊥ : Submodule ℝ (EuclideanSpace ℝ (Fin 3))) =
      Module.finrank ℝ (⊤ : Submodule ℝ (EuclideanSpace ℝ (Fin 3))) := by
    rw [finrank_bot, add_zero]
  exact ⟨bot_le, le_rfl, inf_bot_eq _, hdim, sup_eq_of_finrank bot_le le_rfl (inf_bot_eq _) hdim⟩

/-- The zero-sum fields on `n` sites: the gradients of a cycle. -/
def zeroSum (n : ℕ) : Submodule ℝ (Fin n → ℝ) :=
  LinearMap.ker (∑ i : Fin n, (LinearMap.proj i : (Fin n → ℝ) →ₗ[ℝ] ℝ))

/-- Membership in the zero-sum subspace.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem mem_zeroSum {n : ℕ} (x : Fin n → ℝ) : x ∈ zeroSum n ↔ ∑ i, x i = 0 := by
  simp [zeroSum, LinearMap.sum_apply]

/-- The 1D block average from the 4-cycle to the 2-cycle: `V_0 = (φ₀ + 2φ₁ + φ₂)/2`,
`V_1 = (φ₂ + 2φ₃ + φ₀)/2` (column sums `1`). -/
def cycA : Matrix (Fin 2) (Fin 4) ℝ := !![1 / 2, 1, 1 / 2, 0; 1 / 2, 0, 1 / 2, 1]

/-- A reconstruction with `cycA * cycT = 1`. -/
def cycT : Matrix (Fin 4) (Fin 2) ℝ := !![0, 0; 1, 0; 0, 0; 0, 1]

/-- On a cycle, the quotient `ℓ¹` norm of a field is at least the absolute value of its sum.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem abs_sum_le_quotNorm_zeroSum {n : ℕ} (x : Fin n → ℝ) :
    |∑ i, x i| ≤ quotNorm (zeroSum n) x := by
  refine le_ciInf fun h => ?_
  have hh := (mem_zeroSum (h : Fin n → ℝ)).mp h.2
  calc |∑ i, x i| = |∑ i, (x + (h : Fin n → ℝ)) i| := by
        simp [Pi.add_apply, sum_add_distrib, hh]
    _ ≤ l1 (x + (h : Fin n → ℝ)) := abs_sum_le_sum_abs _ _

/-- **Non-vacuity of the quotient one-shot bundle.** On the 4-cycle over the 2-cycle with the
gradient (zero-sum) subspaces `G_f, G_c`, the average `A = cycA` (column sums `1`, `s = 1`), the
reconstruction `T = cycT` with `A T = I` and `A(G_f) ⊆ G_c`, the flat field `y₀ = (1, 1)`, the
circulation `π = (1, 1)` and `h₀ = 0`: every hypothesis of `quot_loss_eq` except `0 < s` is a
conjunct (`s = 1`, so `0 < s` holds but is not listed); the statement also records
`T(G_c) ⊆ G_f` and that both quotient weights equal `1`. The conclusion: the quotient loss is
exact at the flat field.

Scope: a statement about one proof method at Gaussian order; analytic inputs enter only as
hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
