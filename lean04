/-- **Non-vacuity of depth monotonicity, and failure of its converse.**  In the depth-rescue
tower, with the hypotheses of Theorem R_J that do not involve `β` or `δ` (`V_k R_k = I`,
`s = 2 > 0`, `L = K = 4`, `g = 1`, all `≥ 0`, and the three bounds), the input `u = (−1, 1)`
lies in `U^2_1`, satisfies `2 Γ_2(u) ≤ Γ_1(R_1 u)` (`κ(u) ≥ s`) and has positive excess, and
`U^3_1 ≠ U^2_1` (the proof shows that `u` is not in `U^3_1`).  Conclusions: at every depth
`J ≤ 2` (including `J = 0`) no `β ≥ 0` and no `δ` make the family compose; at every depth
`J ≥ 3` every `β ≥ 0` is admissible.  So a failure at depth two does not imply a failure at
depth three, while composition at depth three transfers to every larger depth
(`composes_of_le`).

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem nonvacuity_depth_rescue :
    (∀ k (y : ES (k + 1)), rV k (rR k y) = y) ∧ (0 : ℝ) < 2 ∧ (0 : ℝ) ≤ 4 ∧ (0 : ℝ) ≤ 4 ∧
      (0 : ℝ) ≤ 1 ∧
      (∀ k (z : ES (k + 1)), rN k (rR k z) ≤ 4 * rN (k + 1) z) ∧
      (∀ k (z : ES (k + 1)), rG k (rR k z) ≤ 4 * rN (k + 1) z) ∧
      (∀ k (y : ES k), rG k y ≤ 1 * rN k y) ∧
      badU ∈ U rR 2 2 ∧ 2 * rG 2 badU ≤ rG 1 (rR 1 badU) ∧ 2 * rN 2 badU < rN 1 (rR 1 badU) ∧
      U rR 3 2 ≠ U rR 2 2 ∧
      (∀ J ≤ 2, ¬ ∃ β, 0 ≤ β ∧ ∃ δ : ℕ → ℝ, Composes rR rV rN rG J 2 β δ) ∧
      (∀ J, 3 ≤ J → ∀ β, 0 ≤ β → ∃ δ : ℕ → ℝ, Composes rR rV rN rG J 2 β δ) := by
  have hfail : ∀ J ≤ 2, ¬ ∃ β, 0 ≤ β ∧ ∃ δ : ℕ → ℝ, Composes rR rV rN rG J 2 β δ := by
    rintro J hJ ⟨β, hβ, δ, h⟩
    have hmem : badU ∈ U rR J 2 := U_antitone rR hJ 2 rescue_bad_mem
    exact not_twoTerm_of_bad rR rN rG hβ rescue_bad_kappa rescue_bad_tau
      ((thmRJ_family_converse rR rV rN rG rescue_VR two_pos h).2 0 badU hmem)
  have hpass : ∀ J, 3 ≤ J → ∀ β, 0 ≤ β → ∃ δ : ℕ → ℝ, Composes rR rV rN rG J 2 β δ := by
    intro J hJ β hβ
    refine ⟨_, (thmRJ_family_iff_std rR rV rN rG rescue_VR (J := J) (s := 2) (g := 1) (L := 4)
      (K := 4) two_pos hβ (by norm_num) (by norm_num) zero_le_one rescue_L rescue_K
      rescue_g).2 ⟨fun u _ => rescue_valueOnly β hβ u,
        fun k u hu => rescue_twoTerm β (k + 1) u (fun hk => ?_)⟩⟩
    have hk0 : k = 0 := by omega
    subst hk0
    exact rescue_U32 (U_antitone rR hJ 2 hu)
  have hne : U rR 3 2 ≠ U rR 2 2 := by
    intro h
    have hmem : badU ∈ U rR 3 2 := by rw [h]; exact rescue_bad_mem
    have := rescue_U32 hmem
    norm_num [badU] at this
  exact ⟨rescue_VR, two_pos, by norm_num, by norm_num, zero_le_one, rescue_L, rescue_K, rescue_g,
    rescue_bad_mem, rescue_bad_kappa, rescue_bad_tau, hne, hfail, hpass⟩

/-! ### A tower with threshold `β_* = 1`

Scales `0, 1` read the sites `0, …, 3`; scales `≥ 2` read the sites `0, 1`.  `R_0 = 2·I`,
`R_1(a, b) = (a, a, b + a, b − a)` (and a shift on the other sites), `R_k = 2·I` for `k ≥ 2`;
`V_1` takes pair means and the other `V_k` are `I/2`.  `Γ = |y_1 − y_0|` at scales `0, 1` and
`Γ = |y_0|` at scales `≥ 2`.  Constants `s = 2`, `L = 4`, `K = 2`, `g = 1`.  Every gap is
non-negative and the largest ratio is `1`, attained at the step `R_1` at `e_0 ∈ E_2`. -/

/-- The map `R_1(a, b) = (a, a, b + a, b − a)` on the sites `0, …, 3`, `(R_1 z)_i = z_{i−2}`
for `i ≥ 4`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
noncomputable def tR1 : (ℕ → ℝ) →ₗ[ℝ] (ℕ → ℝ) where
  toFun z i := if i = 0 then z 0 else if i = 1 then z 0 else if i = 2 then z 1 + z 0
    else if i = 3 then z 1 - z 0 else z (i - 2)
  map_add' x y := by
    funext i
    simp only [Pi.add_apply]
    split_ifs <;> ring
  map_smul' a x := by
    funext i
    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
    split_ifs <;> ring

/-- The pair means `V_1 w = ((w_0 + w_1)/2, (w_2 + w_3)/2, w_4, w_5, …)`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
noncomputable def tV1 : (ℕ → ℝ) →ₗ[ℝ] (ℕ → ℝ) where
  toFun w j := if j = 0 then (w 0 + w 1) / 2 else if j = 1 then (w 2 + w 3) / 2 else w (j + 2)
  map_add' x y := by
    funext j
    simp only [Pi.add_apply]
    split_ifs <;> ring
  map_smul' a x := by
    funext j
    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
    split_ifs <;> ring

/-- `(R_1 z)_i` in the threshold tower.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem tR1_apply (z : ℕ → ℝ) (i : ℕ) : tR1 z i = if i = 0 then z 0 else if i = 1 then z 0
    else if i = 2 then z 1 + z 0 else if i = 3 then z 1 - z 0 else z (i - 2) := rfl

/-- `V_1 R_1 = I` in the threshold tower.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem tV1_tR1 (z : ℕ → ℝ) : tV1 (tR1 z) = z := by
  funext j
  show (if j = 0 then (tR1 z 0 + tR1 z 1) / 2 else if j = 1 then (tR1 z 2 + tR1 z 3) / 2
    else tR1 z (j + 2)) = z j
  split_ifs with h0 h1
  · subst h0; simp [tR1_apply]
  · subst h1; simp [tR1_apply]
  · rw [tR1_apply, if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega)]
    congr 1

/-- The maps `R_k` of the threshold tower.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
noncomputable def tR : ∀ k, ES (k + 1) →ₗ[ℝ] ES k
  | 0 => scal 2
  | 1 => tR1
  | _ + 2 => scal 2

/-- The maps `V_k` of the threshold tower.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
noncomputable def tV : ∀ k, ES k →ₗ[ℝ] ES (k + 1)
  | 0 => scal (1 / 2)
  | 1 => tV1
  | _ + 2 => scal (1 / 2)

/-- The norms of the threshold tower: four sites at scales `0, 1`, two above.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
noncomputable def tN : ∀ k, Seminorm ℝ (ES k)
  | 0 => l1Semi 4
  | 1 => l1Semi 4
  | _ + 2 => l1Semi 2

/-- The curvature seminorms of the threshold tower: `|y_1 − y_0|` at scales `0, 1`, `|y_0|`
above.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
noncomputable def tG : ∀ k, Seminorm ℝ (ES k)
  | 0 => absSemi gradF
  | 1 => absSemi gradF
  | _ + 2 => absSemi (projF 0)

/-- `V_k R_k = I` in the threshold tower.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem thr_VR (k : ℕ) (y : ES (k + 1)) : tV k (tR k y) = y := by
  rcases k with _ | _ | k
  · show scal (1 / 2) (scal 2 y) = y; exact scal_comp (by norm_num) y
  · exact tV1_tR1 y
  · show scal (1 / 2) (scal 2 y) = y; exact scal_comp (by norm_num) y

/-- The ℓ¹ norm of `R_1 z` over the sites `0, …, 3`:
`‖R_1 z‖ = |z_0| + |z_0| + |z_1 + z_0| + |z_1 − z_0|`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem thr_nrm1 (z : ℕ → ℝ) : l1Semi 4 (tR1 z) = |z 0| + |z 0| + |z 1 + z 0| + |z 1 - z 0| := by
  rw [l1Semi_four]; simp [tR1_apply]

/-- `Γ_1(R_1 z) = 0` in the threshold tower.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem thr_gam1 (z : ℕ → ℝ) : absSemi gradF (tR1 z) = 0 := by
  rw [absSemi_apply, gradF_apply]; simp [tR1_apply]

/-- `‖R_k z‖ ≤ 4‖z‖` in the threshold tower.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem thr_L (k : ℕ) (z : ES (k + 1)) : tN k (tR k z) ≤ 4 * tN (k + 1) z := by
  rcases k with _ | _ | k
  · show l1Semi 4 (scal 2 z) ≤ 4 * l1Semi 4 z
    rw [semi_scal _ 2 (by norm_num)]; linarith [apply_nonneg (l1Semi 4) z]
  · show l1Semi 4 (tR1 z) ≤ 4 * l1Semi 2 z
    rw [thr_nrm1, l1Semi_two]
    rcases abs_cases (z 1 + z 0) with ⟨h1, _⟩ | ⟨h1, _⟩ <;>
      rcases abs_cases (z 1 - z 0) with ⟨h2, _⟩ | ⟨h2, _⟩ <;>
      rcases abs_cases (z 0) with ⟨h3, _⟩ | ⟨h3, _⟩ <;>
      rcases abs_cases (z 1) with ⟨h4, _⟩ | ⟨h4, _⟩ <;> linarith
  · show l1Semi 2 (scal 2 z) ≤ 4 * l1Semi 2 z
    rw [semi_scal _ 2 (by norm_num)]; linarith [apply_nonneg (l1Semi 2) z]

/-- `Γ_k(R_k z) ≤ 2‖z‖` in the threshold tower.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem thr_K (k : ℕ) (z : ES (k + 1)) : tG k (tR k z) ≤ 2 * tN (k + 1) z := by
  rcases k with _ | _ | k
  · show absSemi gradF (scal 2 z) ≤ 2 * l1Semi 4 z
    rw [semi_scal _ 2 (by norm_num), absSemi_apply, gradF_apply, l1Semi_four]
    linarith [ex_abs_sub (z 1) (z 0), abs_nonneg (z 2), abs_nonneg (z 3)]
  · show absSemi gradF (tR1 z) ≤ 2 * l1Semi 2 z
    rw [thr_gam1]; exact mul_nonneg (by norm_num) (apply_nonneg _ _)
  · show absSemi (projF 0) (scal 2 z) ≤ 2 * l1Semi 2 z
    rw [semi_scal _ 2 (by norm_num), absSemi_apply, projF_apply, l1Semi_two]
    linarith [abs_nonneg (z 1)]

/-- `Γ_k ≤ 1 · ‖·‖` in the threshold tower.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem thr_g (k : ℕ) (y : ES k) : tG k y ≤ 1 * tN k y := by
  have h : ∀ y : ℕ → ℝ, absSemi gradF y ≤ 1 * l1Semi 4 y := fun y => by
    rw [absSemi_apply, gradF_apply, l1Semi_four]
    linarith [ex_abs_sub (y 1) (y 0), abs_nonneg (y 2), abs_nonneg (y 3)]
  rcases k with _ | _ | k
  · exact h y
  · exact h y
  · show absSemi (projF 0) y ≤ 1 * l1Semi 2 y
    rw [absSemi_apply, projF_apply, l1Semi_two]; linarith [abs_nonneg (y 1)]

/-- `U R J 2 = E_2` for every `J` in the threshold tower (so `U^J_1` is all of `E_2`).

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem thr_U2 (J : ℕ) : U tR J 2 = ⊤ := by
  refine U_eq_top_of_surj tR (j0 := 2) (fun j hj => ?_) J 2 le_rfl
  obtain ⟨j', rfl⟩ : ∃ j', j = j' + 2 := ⟨j - 2, by omega⟩
  exact scal_surj (by norm_num : (2 : ℝ) ≠ 0)

/-- The excess at `k = 0` vanishes in the threshold tower.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem thr_texc0 (u : ℕ → ℝ) : texc tR tN 2 0 u = 0 := by
  show l1Semi 4 (scal 2 u) - 2 * l1Semi 4 u = 0
  rw [semi_scal _ 2 (by norm_num)]; ring

/-- The excess at `k = 1`: `x = |u_1 + u_0| + |u_1 − u_0| − 2|u_1|`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem thr_texc1 (u : ℕ → ℝ) :
    texc tR tN 2 1 u = |u 1 + u 0| + |u 1 - u 0| - 2 * |u 1| := by
  show l1Semi 4 (tR1 u) - 2 * l1Semi 2 u = _
  rw [thr_nrm1, l1Semi_two]; ring

/-- The gap at `k = 1`: `y = 2|u_0|`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem thr_tgap1 (u : ℕ → ℝ) : tgap tR tG 2 1 u = 2 * |u 0| := by
  show 2 * absSemi (projF 0) u - absSemi gradF (tR1 u) = _
  rw [thr_gam1, absSemi_apply, projF_apply, sub_zero]

/-- The excess at `k ≥ 2` vanishes in the threshold tower.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem thr_texc_high (k : ℕ) (u : ℕ → ℝ) : texc tR tN 2 (k + 1 + 1) u = 0 := by
  show l1Semi 2 (scal 2 u) - 2 * l1Semi 2 u = 0
  rw [semi_scal _ 2 (by norm_num)]; ring

/-- The gap at `k ≥ 2` vanishes in the threshold tower.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem thr_tgap_high (k : ℕ) (u : ℕ → ℝ) : tgap tR tG 2 (k + 1 + 1) u = 0 := by
  show 2 * absSemi (projF 0) u - absSemi (projF 0) (scal 2 u) = 0
  rw [semi_scal _ 2 (by norm_num)]; ring

/-- Every restricted gap is non-negative in the threshold tower, at every depth and step.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem thr_gap_nonneg (J k : ℕ) : ∀ u ∈ U tR J (k + 1), 0 ≤ tgap tR tG 2 k u := by
  intro u _
  rcases k with _ | _ | k
  · show 0 ≤ 2 * absSemi gradF u
    exact mul_nonneg (by norm_num) (apply_nonneg _ _)
  · show 0 ≤ tgap tR tG 2 1 u
    rw [thr_tgap1]; positivity
  · rw [thr_tgap_high]

/-- A zero gap forces non-positive excess in the threshold tower.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem thr_gap_zero (J k : ℕ) :
    ∀ u ∈ U tR J (k + 1), tgap tR tG 2 k u = 0 → texc tR tN 2 k u ≤ 0 := by
  intro u _ h
  rcases k with _ | _ | k
  · rw [thr_texc0]
  · have h' : tgap tR tG 2 1 u = 0 := h
    rw [thr_tgap1] at h'
    have hu0 : u 0 = 0 := abs_eq_zero.1 (by linarith)
    show texc tR tN 2 1 u ≤ 0
    rw [thr_texc1, hu0, add_zero, sub_zero]; linarith
  · rw [thr_texc_high]

/-- Every ratio is at most `1` in the threshold tower, at every depth.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem thr_ratio_le (J : ℕ) : ∀ r ∈ ratioSet tR tN tG J 2, r ≤ 1 := by
  rintro r ⟨k, u, _, hpos, rfl⟩
  rcases k with _ | _ | k
  · rw [thr_texc0, zero_div]; norm_num
  · have hpos' : 0 < tgap tR tG 2 1 u := hpos
    show texc tR tN 2 1 u / tgap tR tG 2 1 u ≤ 1
    rw [div_le_iff₀ hpos', one_mul, thr_texc1, thr_tgap1]
    rcases abs_cases (u 1 + u 0) with ⟨h1, _⟩ | ⟨h1, _⟩ <;>
      rcases abs_cases (u 1 - u 0) with ⟨h2, _⟩ | ⟨h2, _⟩ <;>
      rcases abs_cases (u 0) with ⟨h3, _⟩ | ⟨h3, _⟩ <;>
      rcases abs_cases (u 1) with ⟨h4, _⟩ | ⟨h4, _⟩ <;> linarith
  · have hpos' : 0 < tgap tR tG 2 (k + 1 + 1) u := hpos
    rw [thr_tgap_high] at hpos'
    exact absurd hpos' (lt_irrefl 0)

/-- The ratio `1` is attained in the threshold tower, at every depth `J`: at the step `R_1`
and the input `e_0 ∈ E_2`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem thr_one_mem (J : ℕ) : (1 : ℝ) ∈ ratioSet tR tN tG J 2 := by
  have hmem : eZero ∈ U tR J 2 := by rw [thr_U2]; exact Submodule.mem_top
  have hy : tgap tR tG 2 1 eZero = 2 := by rw [thr_tgap1]; norm_num [eZero]
  have hx : texc tR tN 2 1 eZero = 2 := by rw [thr_texc1]; norm_num [eZero]
  exact ⟨1, eZero, hmem, by rw [hy]; norm_num, by rw [hx, hy]; norm_num⟩

/-- `β_* = 1` in the threshold tower, at every depth: `1` is the least upper bound of
`{0} ∪` ratios.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem thr_lub (J : ℕ) : IsLUB (insert 0 (ratioSet tR tN tG J 2)) 1 := by
  refine ⟨fun r hr => ?_, fun b hb => hb (Set.mem_insert_of_mem _ (thr_one_mem J))⟩
  rcases Set.mem_insert_iff.1 hr with rfl | hr
  · norm_num
  · exact thr_ratio_le J r hr

/-- **Non-vacuity of the threshold criterion (`admissible_iff_ge_threshold`,
`threshold_criterion`).**  In the threshold tower the hypotheses hold: `V_k R_k = I`;
`s = 2 > 0`; `L = 4`, `K = 2`, `g = 1 ≥ 0` with the bounds `‖R_k z‖ ≤ 4‖z‖`,
`Γ_k(R_k z) ≤ 2‖z‖`, `Γ_k ≤ 1·‖·‖`; every restricted gap is non-negative; a zero gap forces
non-positive excess; and `β_* = 1` is the least upper bound of `{0} ∪` ratios, at every depth.
Conclusions, at every depth: `β ≥ 0` is admissible iff `β ≥ 1`; for every real `T`, an
admissible `β ∈ [0, T]` exists iff `1 ≤ T`; in particular one exists in `[0, 20]` and none in
`[0, 1/2]`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem nonvacuity_threshold :
    (∀ k (y : ES (k + 1)), tV k (tR k y) = y) ∧ (0 : ℝ) < 2 ∧ (0 : ℝ) ≤ 4 ∧ (0 : ℝ) ≤ 2 ∧
      (0 : ℝ) ≤ 1 ∧
      (∀ k (z : ES (k + 1)), tN k (tR k z) ≤ 4 * tN (k + 1) z) ∧
      (∀ k (z : ES (k + 1)), tG k (tR k z) ≤ 2 * tN (k + 1) z) ∧
      (∀ k (y : ES k), tG k y ≤ 1 * tN k y) ∧
      (∀ J k, ∀ u ∈ U tR J (k + 1), 0 ≤ tgap tR tG 2 k u) ∧
      (∀ J k, ∀ u ∈ U tR J (k + 1), tgap tR tG 2 k u = 0 → texc tR tN 2 k u ≤ 0) ∧
      (∀ J, IsLUB (insert 0 (ratioSet tR tN tG J 2)) 1) ∧
      (∀ J β, 0 ≤ β → ((∃ δ : ℕ → ℝ, Composes tR tV tN tG J 2 β δ) ↔ 1 ≤ β)) ∧
      (∀ J (T : ℝ), (∃ β, 0 ≤ β ∧ β ≤ T ∧ ∃ δ : ℕ → ℝ, Composes tR tV tN tG J 2 β δ) ↔
        1 ≤ T) ∧
      (∀ J, ∃ β, 0 ≤ β ∧ β ≤ 20 ∧ ∃ δ : ℕ → ℝ, Composes tR tV tN tG J 2 β δ) ∧
      (∀ J, ¬ ∃ β, 0 ≤ β ∧ β ≤ 1 / 2 ∧ ∃ δ : ℕ → ℝ, Composes tR tV tN tG J 2 β δ) := by
  have hT : ∀ J (T : ℝ), (∃ β, 0 ≤ β ∧ β ≤ T ∧ ∃ δ : ℕ → ℝ, Composes tR tV tN tG J 2 β δ) ↔
      1 ≤ T := fun J T =>
    threshold_criterion tR tV tN tG thr_VR (J := J) two_pos (by norm_num) (by norm_num)
      zero_le_one thr_L thr_K thr_g (thr_gap_nonneg J) (thr_gap_zero J) (thr_lub J) T
  refine ⟨thr_VR, two_pos, by norm_num, by norm_num, zero_le_one, thr_L, thr_K, thr_g,
    thr_gap_nonneg, thr_gap_zero, thr_lub, fun J β hβ => ?_, hT,
    fun J => (hT J 20).2 (by norm_num), fun J h => ?_⟩
  · exact admissible_iff_ge_threshold tR tV tN tG thr_VR (J := J) (β := β) two_pos hβ
      (by norm_num) (by norm_num) zero_le_one thr_L thr_K thr_g (thr_gap_nonneg J)
      (thr_gap_zero J) (thr_lub J)
  · have := (hT J (1 / 2)).1 h
    norm_num at this

/-! ### The linear counterexample to "composes iff `β_* < ∞`"

Scales `0, 1` read the sites `0, …, 15`; scales `≥ 2` read the sites `0, 1`.  `R_0 = 8·I`,
`R_1(a, b) = (a ×8, b + a, b − a, b ×6)` on the sites `0, …, 15` (and a shift on the other
sites), `R_k = 8·I` for `k ≥ 2`; `V_1` takes the two 8-block means, so `V_1 R_1 = I` and
`‖V_1‖ ≤ 1/8`, and the other `V_k` are `I/8`.  `Γ_0 = 0`, `Γ_1(w) = |w_8 + ⋯ + w_15|`,
`Γ_k(a, b) = |a| + |b|/4` for `k ≥ 2`.
Constants `s = 8`, `L = 10`, `K = 8`, `g = 6`, `v = 1/8`.  At the step `R_1`:
`x = |b + a| + |b − a| − 2|b|` and `y = 8|a| − 6|b|`. -/

/-- The map `R_1(a, b) = (a ×8, b + a, b − a, b ×6)`, `(R_1 z)_i = z_{i−14}` for `i ≥ 16`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
noncomputable def cR1 : (ℕ → ℝ) →ₗ[ℝ] (ℕ → ℝ) where
  toFun z i := if i < 8 then z 0 else if i = 8 then z 1 + z 0 else if i = 9 then z 1 - z 0
    else if i < 16 then z 1 else z (i - 14)
  map_add' x y := by
    funext i
    simp only [Pi.add_apply]
    split_ifs <;> ring
  map_smul' a x := by
    funext i
    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
    split_ifs <;> ring

/-- The two 8-block means `V_1 w = (Σ_{i<8} w_i/8, Σ_{i<8} w_{i+8}/8, w_16, w_17, …)`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
noncomputable def cV1 : (ℕ → ℝ) →ₗ[ℝ] (ℕ → ℝ) where
  toFun w j := if j = 0 then (∑ i ∈ range 8, w i) / 8
    else if j = 1 then (∑ i ∈ range 8, w (i + 8)) / 8 else w (j + 14)
  map_add' x y := by
    funext j
    simp only [Pi.add_apply, Finset.sum_add_distrib]
    split_ifs <;> ring
  map_smul' a x := by
    funext j
    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, ← Finset.mul_sum]
    split_ifs <;> ring

/-- The block functional `w ↦ w_8 + ⋯ + w_15`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
noncomputable def blockSum : (ℕ → ℝ) →ₗ[ℝ] ℝ where
  toFun y := ∑ i ∈ range 8, y (i + 8)
  map_add' x y := by simp only [Pi.add_apply, Finset.sum_add_distrib]
  map_smul' a x := by simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.mul_sum]

/-- The seminorm `|a| + |b|/4` of the sites `0, 1`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
noncomputable def cGh : Seminorm ℝ (ℕ → ℝ) := absSemi (projF 0) + absSemi ((1 / 4 : ℝ) • projF 1)

/-- `cGh y = |y_0| + |y_1/4|`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cGh_apply (y : ℕ → ℝ) : cGh y = |y 0| + |1 / 4 * y 1| := rfl

/-- `(R_1 z)_i` in the counterexample.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cR1_apply (z : ℕ → ℝ) (i : ℕ) : cR1 z i = if i < 8 then z 0 else if i = 8 then z 1 + z 0
    else if i = 9 then z 1 - z 0 else if i < 16 then z 1 else z (i - 14) := rfl

/-- `‖R_1 z‖ = 8|z_0| + |z_1 + z_0| + |z_1 − z_0| + 6|z_1|`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cex_nrm1 (z : ℕ → ℝ) :
    l1Semi 16 (cR1 z) = 8 * |z 0| + |z 1 + z 0| + |z 1 - z 0| + 6 * |z 1| := by
  rw [l1Semi_apply]
  simp [Finset.sum_range_succ, cR1_apply]
  ring

/-- `w_8 + ⋯ + w_15` at `w = R_1 z` is `8 z_1`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cex_block (z : ℕ → ℝ) : blockSum (cR1 z) = 8 * z 1 := by
  show ∑ i ∈ range 8, cR1 z (i + 8) = 8 * z 1
  simp [Finset.sum_range_succ, cR1_apply]
  ring

/-- `V_1 R_1 = I` in the counterexample.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cex_V1R1 (z : ℕ → ℝ) : cV1 (cR1 z) = z := by
  funext j
  show (if j = 0 then (∑ i ∈ range 8, cR1 z i) / 8
    else if j = 1 then (∑ i ∈ range 8, cR1 z (i + 8)) / 8 else cR1 z (j + 14)) = z j
  split_ifs with h0 h1
  · subst h0; simp [Finset.sum_range_succ, cR1_apply]; ring
  · subst h1; simp [Finset.sum_range_succ, cR1_apply]; ring
  · rw [cR1_apply, if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega)]
    congr 1

/-- `‖V_1 w‖ ≤ (1/8)‖w‖` in the counterexample.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cex_V1_le (w : ℕ → ℝ) : l1Semi 2 (cV1 w) ≤ 1 / 8 * l1Semi 16 w := by
  have e0 : cV1 w 0 = (∑ i ∈ range 8, w i) / 8 := by simp [cV1]
  have e1 : cV1 w 1 = (∑ i ∈ range 8, w (i + 8)) / 8 := by simp [cV1]
  rw [l1Semi_two, l1Semi_apply, show (16 : ℕ) = 8 + 8 from rfl, Finset.sum_range_add, e0, e1,
    abs_div, abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 8)]
  have h1 : |∑ i ∈ range 8, w i| ≤ ∑ i ∈ range 8, |w i| := Finset.abs_sum_le_sum_abs _ _
  have h2 : |∑ i ∈ range 8, w (i + 8)| ≤ ∑ i ∈ range 8, |w (i + 8)| :=
    Finset.abs_sum_le_sum_abs _ _
  have h3 : ∑ i ∈ range 8, |w (8 + i)| = ∑ i ∈ range 8, |w (i + 8)| :=
    Finset.sum_congr rfl (fun i _ => by rw [add_comm])
  rw [h3]
  linarith

/-- `|w_8 + ⋯ + w_15| ≤ Σ_{i<16} |w_i|`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cex_block_le (w : ℕ → ℝ) : |blockSum w| ≤ l1Semi 16 w := by
  rw [l1Semi_apply, show (16 : ℕ) = 8 + 8 from rfl, Finset.sum_range_add]
  have h2 : |∑ i ∈ range 8, w (i + 8)| ≤ ∑ i ∈ range 8, |w (i + 8)| :=
    Finset.abs_sum_le_sum_abs _ _
  have h3 : ∑ i ∈ range 8, |w (8 + i)| = ∑ i ∈ range 8, |w (i + 8)| :=
    Finset.sum_congr rfl (fun i _ => by rw [add_comm])
  have h4 : 0 ≤ ∑ i ∈ range 8, |w i| := Finset.sum_nonneg (fun i _ => abs_nonneg _)
  rw [h3]
  show |∑ i ∈ range 8, w (i + 8)| ≤ _
  linarith

/-- The maps `R_k` of the counterexample.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
noncomputable def cR : ∀ k, ES (k + 1) →ₗ[ℝ] ES k
  | 0 => scal 8
  | 1 => cR1
  | _ + 2 => scal 8

/-- The maps `V_k` of the counterexample.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
noncomputable def cV : ∀ k, ES k →ₗ[ℝ] ES (k + 1)
  | 0 => scal (1 / 8)
  | 1 => cV1
  | _ + 2 => scal (1 / 8)

/-- The norms of the counterexample: sixteen sites at scales `0, 1`, two above.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
noncomputable def cN : ∀ k, Seminorm ℝ (ES k)
  | 0 => l1Semi 16
  | 1 => l1Semi 16
  | _ + 2 => l1Semi 2

/-- The curvature seminorms of the counterexample: `0`, `|w_8 + ⋯ + w_15|`, `|a| + |b|/4`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
noncomputable def cG : ∀ k, Seminorm ℝ (ES k)
  | 0 => 0
  | 1 => absSemi blockSum
  | _ + 2 => cGh

/-- `|b + a| + |b − a| − 2|b| ≤ (8|a| − 6|b|)/4` when `8|a| − 6|b| > 0`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem ex_c_ratio (a b : ℝ) (h : 0 < 8 * |a| - 6 * |b|) :
    |b + a| + |b - a| - 2 * |b| ≤ 1 / 4 * (8 * |a| - 6 * |b|) := by
  rcases abs_cases (b + a) with ⟨h1, _⟩ | ⟨h1, _⟩ <;>
    rcases abs_cases (b - a) with ⟨h2, _⟩ | ⟨h2, _⟩ <;>
    rcases abs_cases a with ⟨h3, _⟩ | ⟨h3, _⟩ <;>
    rcases abs_cases b with ⟨h4, _⟩ | ⟨h4, _⟩ <;> linarith

/-- `8|a| − 6|b| ≤ 0` forces `|b + a| + |b − a| − 2|b| = 0`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem ex_c_zero (a b : ℝ) (h : 8 * |a| - 6 * |b| ≤ 0) : |b + a| + |b - a| - 2 * |b| = 0 := by
  rcases abs_cases (b + a) with ⟨h1, _⟩ | ⟨h1, _⟩ <;>
    rcases abs_cases (b - a) with ⟨h2, _⟩ | ⟨h2, _⟩ <;>
    rcases abs_cases a with ⟨h3, _⟩ | ⟨h3, _⟩ <;>
    rcases abs_cases b with ⟨h4, _⟩ | ⟨h4, _⟩ <;> linarith

/-- `8(|a| + |b|) ≤ 8|a| + |b + a| + |b − a| + 6|b| ≤ 10(|a| + |b|)`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem ex_c_bounds (a b : ℝ) :
    8 * (|a| + |b|) ≤ 8 * |a| + |b + a| + |b - a| + 6 * |b| ∧
      8 * |a| + |b + a| + |b - a| + 6 * |b| ≤ 10 * (|a| + |b|) := by
  constructor <;>
  rcases abs_cases (b + a) with ⟨h1, _⟩ | ⟨h1, _⟩ <;>
    rcases abs_cases (b - a) with ⟨h2, _⟩ | ⟨h2, _⟩ <;>
    rcases abs_cases a with ⟨h3, _⟩ | ⟨h3, _⟩ <;>
    rcases abs_cases b with ⟨h4, _⟩ | ⟨h4, _⟩ <;> linarith

/-- `V_k R_k = I` in the counterexample.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cex_VR (k : ℕ) (y : ES (k + 1)) : cV k (cR k y) = y := by
  rcases k with _ | _ | k
  · show scal (1 / 8) (scal 8 y) = y; exact scal_comp (by norm_num) y
  · exact cex_V1R1 y
  · show scal (1 / 8) (scal 8 y) = y; exact scal_comp (by norm_num) y

/-- `‖R_k z‖ ≤ 10‖z‖` in the counterexample.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cex_L (k : ℕ) (z : ES (k + 1)) : cN k (cR k z) ≤ 10 * cN (k + 1) z := by
  rcases k with _ | _ | k
  · show l1Semi 16 (scal 8 z) ≤ 10 * l1Semi 16 z
    rw [semi_scal _ 8 (by norm_num)]; linarith [apply_nonneg (l1Semi 16) z]
  · show l1Semi 16 (cR1 z) ≤ 10 * l1Semi 2 z
    rw [cex_nrm1, l1Semi_two]; exact (ex_c_bounds (z 0) (z 1)).2
  · show l1Semi 2 (scal 8 z) ≤ 10 * l1Semi 2 z
    rw [semi_scal _ 8 (by norm_num)]; linarith [apply_nonneg (l1Semi 2) z]

/-- `Γ_k(R_k z) ≤ 8‖z‖` in the counterexample.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cex_K (k : ℕ) (z : ES (k + 1)) : cG k (cR k z) ≤ 8 * cN (k + 1) z := by
  rcases k with _ | _ | k
  · show (0 : ℝ) ≤ 8 * l1Semi 16 z
    exact mul_nonneg (by norm_num) (apply_nonneg _ _)
  · show absSemi blockSum (cR1 z) ≤ 8 * l1Semi 2 z
    rw [absSemi_apply, cex_block, l1Semi_two, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 8)]
    linarith [abs_nonneg (z 0)]
  · show cGh (scal 8 z) ≤ 8 * l1Semi 2 z
    rw [semi_scal _ 8 (by norm_num), cGh_apply, l1Semi_two, abs_mul,
      abs_of_pos (by norm_num : (0 : ℝ) < 1 / 4)]
    linarith [abs_nonneg (z 1)]

/-- `Γ_k ≤ 6‖·‖` in the counterexample.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cex_g (k : ℕ) (y : ES k) : cG k y ≤ 6 * cN k y := by
  rcases k with _ | _ | k
  · show (0 : ℝ) ≤ 6 * l1Semi 16 y
    exact mul_nonneg (by norm_num) (apply_nonneg _ _)
  · show absSemi blockSum y ≤ 6 * l1Semi 16 y
    rw [absSemi_apply]
    linarith [cex_block_le y, apply_nonneg (l1Semi 16) y]
  · show cGh y ≤ 6 * l1Semi 2 y
    rw [cGh_apply, l1Semi_two, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 4)]
    linarith [abs_nonneg (y 0), abs_nonneg (y 1)]

/-- The anchor bound `8‖z‖ ≤ ‖R_k z‖` in the counterexample.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cex_low (k : ℕ) (z : ES (k + 1)) : 8 * cN (k + 1) z ≤ cN k (cR k z) := by
  rcases k with _ | _ | k
  · exact (semi_scal (l1Semi 16) 8 (by norm_num) z).ge
  · show 8 * l1Semi 2 z ≤ l1Semi 16 (cR1 z)
    rw [cex_nrm1, l1Semi_two]; exact (ex_c_bounds (z 0) (z 1)).1
  · exact (semi_scal (l1Semi 2) 8 (by norm_num) z).ge

/-- `‖V_k y‖ ≤ (1/8)‖y‖` in the counterexample.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cex_V (k : ℕ) (y : ES k) : cN (k + 1) (cV k y) ≤ 1 / 8 * cN k y := by
  rcases k with _ | _ | k
  · exact (semi_scal (l1Semi 16) (1 / 8) (by norm_num) y).le
  · exact cex_V1_le y
  · exact (semi_scal (l1Semi 2) (1 / 8) (by norm_num) y).le

/-- `U R J 2 = E_2` for every `J` in the counterexample (so `U^J_1` is all of `E_2`).

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cex_U2 (J : ℕ) : U cR J 2 = ⊤ := by
  refine U_eq_top_of_surj cR (j0 := 2) (fun j hj => ?_) J 2 le_rfl
  obtain ⟨j', rfl⟩ : ∃ j', j = j' + 2 := ⟨j - 2, by omega⟩
  exact scal_surj (by norm_num : (8 : ℝ) ≠ 0)

/-- The excess at `k = 0` vanishes in the counterexample.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cex_texc0 (u : ℕ → ℝ) : texc cR cN 8 0 u = 0 := by
  show l1Semi 16 (scal 8 u) - 8 * l1Semi 16 u = 0
  rw [semi_scal _ 8 (by norm_num)]; ring

/-- The excess at the step `R_1`: `x = |b + a| + |b − a| − 2|b|`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cex_texc1 (u : ℕ → ℝ) : texc cR cN 8 1 u = |u 1 + u 0| + |u 1 - u 0| - 2 * |u 1| := by
  show l1Semi 16 (cR1 u) - 8 * l1Semi 2 u = _
  rw [cex_nrm1, l1Semi_two]; ring

/-- The gap at the step `R_1`: `y = 8|a| − 6|b|`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cex_tgap1 (u : ℕ → ℝ) : tgap cR cG 8 1 u = 8 * |u 0| - 6 * |u 1| := by
  show 8 * cGh u - absSemi blockSum (cR1 u) = _
  rw [cGh_apply, absSemi_apply, cex_block, abs_mul, abs_mul,
    abs_of_pos (by norm_num : (0 : ℝ) < 1 / 4), abs_of_pos (by norm_num : (0 : ℝ) < 8)]
  ring

/-- The excess at `k ≥ 2` vanishes in the counterexample.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cex_texc_high (k : ℕ) (u : ℕ → ℝ) : texc cR cN 8 (k + 1 + 1) u = 0 := by
  show l1Semi 2 (scal 8 u) - 8 * l1Semi 2 u = 0
  rw [semi_scal _ 8 (by norm_num)]; ring

/-- The gap at `k ≥ 2` vanishes in the counterexample.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cex_tgap_high (k : ℕ) (u : ℕ → ℝ) : tgap cR cG 8 (k + 1 + 1) u = 0 := by
  show 8 * cGh u - cGh (scal 8 u) = 0
  rw [semi_scal _ 8 (by norm_num)]; ring

/-- Every ratio is at most `1/4` in the counterexample, at every depth.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem cex_ratio_le (J : ℕ) : ∀ r ∈ ratioSet cR cN cG J 8, r ≤ 1 / 4 := by
  rintro r ⟨k, u, _, hpos, rfl⟩
  rcases k with _ | _ | k
  · rw [cex_texc0, zero_div]; norm_num
  · have hpos' : 0 < tgap cR cG 8 1 u := hpos
    show texc cR cN 8 1 u / tgap cR cG 8 1 u ≤ 1 / 4
    rw [div_le_iff₀ hpos', cex_texc1, cex_tgap1]
    rw [cex_tgap1] at hpos'
    linarith [ex_c_ratio (u 0) (u 1) hpos']
  · have hpos' : 0 < tgap cR cG 8 (k + 1 + 1) u := hpos
    rw [cex_tgap_high] at hpos'
    exact absurd hpos' (lt_irrefl 0)

/-- **The linear counterexample to "composes iff `β_* < ∞`".**  The tower above satisfies, at
every depth, every hypothesis of Theorem R_J that does not involve `β` or `δ`: `V_k R_k = I`;
`s = 8 > 0`; `L = 10`, `K = 8`, `g = 6`, all `≥ 0`; `‖R_k z‖ ≤ 10‖z‖`, `Γ_k(R_k z) ≤ 8‖z‖`,
`Γ_k ≤ 6‖·‖`; and in addition the anchor bound `8‖z‖ ≤ ‖R_k z‖` and `‖V_k y‖ ≤ ‖y‖/8`.  (For
every `β ≥ 0` the coefficient conditions can be met, by `deltaStd`.)  The space `U R J 2` is
all of `E_2` for every `J`, so every input at scale `2` is restricted at the step `R_1`.  The
simpler criterion's conditions hold at every depth: the ratios over positive gaps are bounded
(the least upper bound of `{0} ∪` ratios is `1/4`, so `β_* = 1/4`), and no restricted point
has a non-positive gap with non-zero excess.  But clause (iii) of `exactness_iff` fails: at the
step `R_1`, `e_1` has negative gap and `e_0` has positive excess (the values are `−6` and `2`;
the statement records only the signs).  Indeed no family composes, at any depth, for any real
`β` and any `δ`.  So "composes iff `β_* < ∞`" and "`β` admissible iff `β ≥ β_*`" (without
non-negative gaps) are both false.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem linear_counterexample :
    (∀ k (y : ES (k + 1)), cV k (cR k y) = y) ∧ (0 : ℝ) < 8 ∧ (0 : ℝ) ≤ 10 ∧ (0 : ℝ) ≤ 8 ∧
      (0 : ℝ) ≤ 6 ∧
      (∀ k (z : ES (k + 1)), cN k (cR k z) ≤ 10 * cN (k + 1) z) ∧
      (∀ k (z : ES (k + 1)), cG k (cR k z) ≤ 8 * cN (k + 1) z) ∧
      (∀ k (y : ES k), cG k y ≤ 6 * cN k y) ∧
      (∀ k (z : ES (k + 1)), 8 * cN (k + 1) z ≤ cN k (cR k z)) ∧
      (∀ k (y : ES k), cN (k + 1) (cV k y) ≤ 1 / 8 * cN k y) ∧
      (∀ J, U cR J 2 = ⊤) ∧
      (∀ J, BddAbove (ratioSet cR cN cG J 8)) ∧
      (∀ J k, ∀ u ∈ U cR J (k + 1), tgap cR cG 8 k u ≤ 0 → texc cR cN 8 k u = 0) ∧
      (∀ J, IsLUB (insert 0 (ratioSet cR cN cG J 8)) (1 / 4)) ∧
      tgap cR cG 8 1 eOne < 0 ∧ 0 < texc cR cN 8 1 eZero ∧
      ∀ J β (δ : ℕ → ℝ), ¬ Composes cR cV cN cG J 8 β δ := by
  have hmem : ∀ J (u : ℕ → ℝ), u ∈ U cR J 2 := fun J u => by
    rw [cex_U2]; exact Submodule.mem_top
  have hx0 : texc cR cN 8 1 eZero = 2 := by rw [cex_texc1]; norm_num [eZero]
  have hy0 : tgap cR cG 8 1 eZero = 8 := by rw [cex_tgap1]; norm_num [eZero]
  have hx1 : texc cR cN 8 1 eOne = 0 := by rw [cex_texc1]; norm_num [eOne]
  have hy1 : tgap cR cG 8 1 eOne = -6 := by rw [cex_tgap1]; norm_num [eOne]
  have hzero : ∀ J k, ∀ u ∈ U cR J (k + 1), tgap cR cG 8 k u ≤ 0 → texc cR cN 8 k u = 0 := by
    intro J k u _ h
    rcases k with _ | _ | k
    · exact cex_texc0 u
    · have h' : tgap cR cG 8 1 u ≤ 0 := h
      rw [cex_tgap1] at h'
      show texc cR cN 8 1 u = 0
      rw [cex_texc1]; exact ex_c_zero (u 0) (u 1) h'
    · exact cex_texc_high k u
  have hlub : ∀ J, IsLUB (insert 0 (ratioSet cR cN cG J 8)) (1 / 4) := by
    intro J
    have hq : (1 / 4 : ℝ) ∈ ratioSet cR cN cG J 8 :=
      ⟨1, eZero, hmem J eZero, by rw [hy0]; norm_num, by rw [hx0, hy0]; norm_num⟩
    refine ⟨fun r hr => ?_, fun b hb => hb (Set.mem_insert_of_mem _ hq)⟩
    rcases Set.mem_insert_iff.1 hr with rfl | hr
    · norm_num
    · exact cex_ratio_le J r hr
  have hnot : ∀ J β (δ : ℕ → ℝ), ¬ Composes cR cV cN cG J 8 β δ := by
    intro J β δ h
    have hT := (thmRJ_family_converse cR cV cN cG cex_VR (by norm_num) h).2 0
    have e0 : texc cR cN 8 1 eZero ≤ β * tgap cR cG 8 1 eZero :=
      (twoTerm_iff_texc cR cN cG).1 (hT eZero (hmem J eZero))
    have e1 : texc cR cN 8 1 eOne ≤ β * tgap cR cG 8 1 eOne :=
      (twoTerm_iff_texc cR cN cG).1 (hT eOne (hmem J eOne))
    rw [hx0, hy0] at e0
    rw [hx1, hy1] at e1
    linarith
  exact ⟨cex_VR, by norm_num, by norm_num, by norm_num, by norm_num, cex_L, cex_K, cex_g, cex_low,
    cex_V, cex_U2, fun J => ⟨1 / 4, cex_ratio_le J⟩, hzero, hlub,
    by rw [hy1]; norm_num, by rw [hx0]; norm_num, hnot⟩

/-! ### A curvature-floor instance -/

/-- The averaging matrix with all entries `1/4` (one coarse cell, four fine cells).

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
noncomputable def avgMat : Matrix (Fin 1) (Fin 4) ℝ := fun _ _ => 1 / 4

/-- The coarse-to-fine copy `u ↦ (u_0, u_0, u_0, u_0)`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
def fRup : (Fin 1 → ℝ) → (Fin 4 → ℝ) := fun u _ => u 0

/-- The fine-to-coarse average `V y = avgMat · y`.

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
noncomputable def fVdown : (Fin 4 → ℝ) → (Fin 1 → ℝ) := fun y => avgMat.mulVec y

/-- **Non-vacuity of Lemma F2 (`curvature_floor`, `l1_mulVec_le`, `cancelFrac_spec`).**  With
`R` the copy, `V` and `W` the average with weights `1/4` and `F = F' = id`, the hypotheses
hold: `V R = I`, `F' ∘ V = W ∘ F`, `W ≥ 0` with column sums `≤ 1/4`, hence (by
`l1_mulVec_le`) `4‖W g‖₁ ≤ ‖g‖₁`.  Conclusion (by `curvature_floor`): `4‖u‖₁ ≤ ‖R u‖₁` for
every `u`, with equality here.  The instance is degenerate: `V` and `W` are the same map and
`F = F' = id`, so the intertwining `F' ∘ V = W ∘ F` holds by definition, and the floor is an
equality (`κ = 4`, no cancellation).  For `cancelFrac_spec` the statement uses separate
numbers, `m = 4 > 0`, `b = 1 > 0`, `m b ≤ a = 6`, `s = 8 > 0`, chosen for illustration and not
computed from the instance above: the cancellation fraction is `1/3`, `a/b = 6 = 4/(1 − 1/3)`,
and `a/b < 8 ⟺ D < 1 − 4/8`.  (Both sides of the last equivalence are true here; the
statement records the equivalence, and omits the conclusion `D ∈ [0, 1)` of
`cancelFrac_spec`.)

Scope: a statement about one proof method (norm chains across scales) at Gaussian order;
physical constants enter only as hypotheses; nothing about the Yang–Mills measure; the
estimates (D), (E) and the mass gap remain open. -/
theorem nonvacuity_floor :
    (∀ u, fVdown (fRup u) = u) ∧ (∀ y, id (fVdown y) = avgMat.mulVec (id y)) ∧
      (∀ i j, 0 ≤ avgMat i j) ∧ (∀ j, ∑ i, avgMat i j ≤ 1 / 4) ∧
      (∀ g : Fin 4 → ℝ, ∑ i, |avgMat.mulVec g i| ≤ 1 / 4 * ∑ j, |g j|) ∧
      (∀ g : Fin 4 → ℝ, 4 * ∑ i, |avgMat.mulVec g i| ≤ ∑ j, |g j|) ∧
      (∀ u : Fin 1 → ℝ, 4 * ∑ i, |u i| ≤ ∑ j, |fRup u j|) ∧
      (∀ u : Fin 1 → ℝ, 4 * ∑ i, |u i| = ∑ j, |fRup u j|) ∧
      (0 : ℝ) < 4 ∧ (0 : ℝ) < 1 ∧ (4 : ℝ) * 1 ≤ 6 ∧ (0 : ℝ) < 8 ∧
      cancelFrac 4 6 1 = 1 / 3 ∧ (6 : ℝ) / 1 = 4 / (1 - cancelFrac 4 6 1) ∧
      ((6 : ℝ) / 1 < 8 ↔ cancelFrac 4 6 1 < 1 - 4 / 8) := by
  have hVR : ∀ u, fVdown (fRup u) = u := by
    intro u
    funext i
    rw [Fin.fin_one_eq_zero i]
    simp [fVdown, fRup, avgMat, Matrix.mulVec, dotProduct]
  have hpos : ∀ i j, 0 ≤ avgMat i j := fun _ _ => by norm_num [avgMat]
  have hcol : ∀ j, ∑ i, avgMat i j ≤ 1 / 4 := fun _ => by simp [avgMat]
  have hl1 : ∀ g : Fin 4 → ℝ, ∑ i, |avgMat.mulVec g i| ≤ 1 / 4 * ∑ j, |g j| :=
    fun g => l1_mulVec_le avgMat hpos hcol g
  have hW : ∀ g : Fin 4 → ℝ, 4 * ∑ i, |avgMat.mulVec g i| ≤ ∑ j, |g j| := fun g => by
    linarith [hl1 g]
  have hfloor : ∀ u : Fin 1 → ℝ, 4 * ∑ i, |u i| ≤ ∑ j, |fRup u j| := fun u =>
    curvature_floor fRup fVdown id id avgMat.mulVec (fun g : Fin 4 → ℝ => ∑ j, |g j|)
      (fun g : Fin 1 → ℝ => ∑ i, |g i|) hVR (fun _ => rfl) hW u
  have heq : ∀ u : Fin 1 → ℝ, 4 * ∑ i, |u i| = ∑ j, |fRup u j| := fun u => by
    simp [fRup]
  have hspec := cancelFrac_spec (m := 4) (a := 6) (b := 1) (s := 8) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num)
  have hD : cancelFrac 4 6 1 = 1 / 3 := by norm_num [cancelFrac]
  exact ⟨hVR, fun _ => rfl, hpos, hcol, hl1, hW, hfloor, heq, by norm_num, by norm_num,
    by norm_num, by norm_num, hD, hspec.2.2.1, hspec.2.2.2⟩

end Examples

