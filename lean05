namespace TreeGaugeBridge

open Finset Matrix

/-! ## 0. Definitions -/

/-- The `ℓ¹` norm `‖x‖₁ = Σ_i |x_i|`. -/
def l1 {α : Type*} [Fintype α] (x : α → ℝ) : ℝ := ∑ i, |x i|

/-- The squared Euclidean norm `‖x‖² = Σ_i x_i²`. -/
def sqNorm {α : Type*} [Fintype α] (x : α → ℝ) : ℝ := ∑ i, x i ^ 2

/-- The energy `Q(x) = ‖D x‖² = Σ_p (D x)_p²` of a link field `x` for a curvature matrix `D`. -/
def energy {ρ ι : Type*} [Fintype ρ] [Fintype ι] (D : Matrix ρ ι ℝ) (x : ι → ℝ) : ℝ :=
  ∑ p, (D *ᵥ x) p ^ 2

/-- The weighted field `(e^f x)_e = e^{f(e)} x_e`. -/
def weighted {ι : Type*} (f x : ι → ℝ) : ι → ℝ := fun e => Real.exp (f e) * x e

/-! ## 1. Minimisers of a positive semidefinite form on an affine subspace -/

section Minimisers

variable {V Z : Type*} [AddCommGroup V] [Module ℝ V] [AddCommGroup Z] [Module ℝ Z]

/-- `½ (y + y) = y` in a real vector space.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem half_smul_add_self (y : Z) : (2⁻¹ : ℝ) • (y + y) = y := by
  rw [← two_smul ℝ y, smul_smul, inv_mul_cancel₀ two_ne_zero, one_smul]

/-- **Parallelogram identity for a bilinear form.** For every bilinear `B` (no symmetry needed),
`B(u − u', u − u') = 2B(u, u) + 2B(u', u') − 4B(m, m)` with `m = ½(u + u')`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem bilin_parallelogram (B : V →ₗ[ℝ] V →ₗ[ℝ] ℝ) (u u' : V) :
    B (u - u') (u - u') =
      2 * B u u + 2 * B u' u' - 4 * B ((2⁻¹ : ℝ) • (u + u')) ((2⁻¹ : ℝ) • (u + u')) := by
  simp only [map_sub, map_add, map_smul, LinearMap.sub_apply, LinearMap.add_apply,
    LinearMap.smul_apply, smul_eq_mul]
  ring

/-- **The kernel of a positive semidefinite form.** If `B` is symmetric with `B(x, x) ≥ 0` for
all `x`, and `B(z, z) = 0`, then `B(z, x) = 0` for every `x`: `z` lies in the kernel of `B`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem apply_eq_zero_of_self_eq_zero (B : V →ₗ[ℝ] V →ₗ[ℝ] ℝ) (hB : ∀ x, 0 ≤ B x x)
    (hsymm : ∀ x z, B x z = B z x) {z : V} (hz : B z z = 0) (x : V) : B z x = 0 := by
  have key : ∀ t : ℝ, B (t • z + x) (t • z + x) = 2 * t * B z x + B x x := by
    intro t
    simp only [map_add, map_smul, LinearMap.add_apply, LinearMap.smul_apply, smul_eq_mul, hz]
    linear_combination t * hsymm x z
  by_contra hne
  have h := hB ((-(B x x + 1) / (2 * B z x)) • z + x)
  rw [key] at h
  have h2 : 2 * (-(B x x + 1) / (2 * B z x)) * B z x = -(B x x + 1) := by
    field_simp
  linarith

/-- **Two minimisers differ by a kernel element.** Let `B` be a symmetric positive semidefinite
bilinear form, `Q(x) = B(x, x)`, and let `u, u'` lie in the affine set `Σ₀ ∩ {A x = y}` and both
minimise `Q` on it. Then `Q(u) = Q(u')` and `u − u' ∈ Σ₀ ∩ ker A ∩ ker B`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem sub_mem_ker_of_minimizers (B : V →ₗ[ℝ] V →ₗ[ℝ] ℝ) (hB : ∀ x, 0 ≤ B x x)
    (hsymm : ∀ x z, B x z = B z x) (S₀ : Submodule ℝ V) (A : V →ₗ[ℝ] Z) (y : Z) {u u' : V}
    (hu : u ∈ S₀ ∧ A u = y) (hu' : u' ∈ S₀ ∧ A u' = y)
    (hmin : ∀ x ∈ S₀, A x = y → B u u ≤ B x x) (hmin' : ∀ x ∈ S₀, A x = y → B u' u' ≤ B x x) :
    B u u = B u' u' ∧ u - u' ∈ S₀ ⊓ LinearMap.ker A ⊓ LinearMap.ker B := by
  have hmS : (2⁻¹ : ℝ) • (u + u') ∈ S₀ := S₀.smul_mem _ (S₀.add_mem hu.1 hu'.1)
  have hmA : A ((2⁻¹ : ℝ) • (u + u')) = y := by
    rw [map_smul, map_add, hu.2, hu'.2, half_smul_add_self]
  have heq : B u u = B u' u' := le_antisymm (hmin u' hu'.1 hu'.2) (hmin' u hu.1 hu.2)
  have hle := hmin _ hmS hmA
  have hzero : B (u - u') (u - u') = 0 := by
    have h1 := bilin_parallelogram B u u'
    have h2 := hB (u - u')
    linarith
  refine ⟨heq, Submodule.mem_inf.2 ⟨Submodule.mem_inf.2 ⟨S₀.sub_mem hu.1 hu'.1, ?_⟩, ?_⟩⟩
  · rw [LinearMap.mem_ker, map_sub, hu.2, hu'.2, sub_self]
  · rw [LinearMap.mem_ker]
    exact LinearMap.ext fun x => apply_eq_zero_of_self_eq_zero B hB hsymm hzero x

/-- **The curvature transfer.** Let `F : V → W` be linear into a real inner product space and
`Q(x) = ‖F x‖²`. If `u, u'` lie in `Σ₀ ∩ {A x = y}` and both minimise `Q` on it, then
`F u = F u'`, and `u − u' ∈ Σ₀ ∩ ker A ∩ ker F`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem map_eq_of_minimizers {W : Type*} [NormedAddCommGroup W] [InnerProductSpace ℝ W]
    (F : V →ₗ[ℝ] W) (S₀ : Submodule ℝ V) (A : V →ₗ[ℝ] Z) (y : Z) {u u' : V}
    (hu : u ∈ S₀ ∧ A u = y) (hu' : u' ∈ S₀ ∧ A u' = y)
    (hmin : ∀ x ∈ S₀, A x = y → ‖F u‖ ^ 2 ≤ ‖F x‖ ^ 2)
    (hmin' : ∀ x ∈ S₀, A x = y → ‖F u'‖ ^ 2 ≤ ‖F x‖ ^ 2) :
    F u = F u' ∧ u - u' ∈ S₀ ⊓ LinearMap.ker A ⊓ LinearMap.ker F := by
  have hmS : (2⁻¹ : ℝ) • (u + u') ∈ S₀ := S₀.smul_mem _ (S₀.add_mem hu.1 hu'.1)
  have hmA : A ((2⁻¹ : ℝ) • (u + u')) = y := by
    rw [map_smul, map_add, hu.2, hu'.2, half_smul_add_self]
  have heq : ‖F u‖ ^ 2 = ‖F u'‖ ^ 2 := le_antisymm (hmin u' hu'.1 hu'.2) (hmin' u hu.1 hu.2)
  have hle := hmin _ hmS hmA
  have hFm : ‖F ((2⁻¹ : ℝ) • (u + u'))‖ ^ 2 = ‖F u + F u'‖ ^ 2 / 4 := by
    rw [map_smul, map_add, norm_smul, Real.norm_of_nonneg (by norm_num)]
    ring
  have hpar := parallelogram_law_with_norm ℝ (F u) (F u')
  have hsq : ‖F u - F u'‖ ^ 2 = 0 := by
    have := sq_nonneg ‖F u - F u'‖
    linarith
  have hFeq : F u = F u' := by
    rw [← sub_eq_zero, ← norm_eq_zero]
    exact (pow_eq_zero_iff two_ne_zero).1 hsq
  refine ⟨hFeq, Submodule.mem_inf.2 ⟨Submodule.mem_inf.2 ⟨S₀.sub_mem hu.1 hu'.1, ?_⟩, ?_⟩⟩
  · rw [LinearMap.mem_ker, map_sub, hu.2, hu'.2, sub_self]
  · rw [LinearMap.mem_ker, map_sub, hFeq, sub_self]

/-- **Minimality transfers from a section.** Let `T` satisfy `Q(T) ≤ Q(x)` for every admissible
`x` in the section `G`. If every admissible point `x` has an admissible point `x'` in `G` with
`Q(x') ≤ Q(x)`, then `Q(T) ≤ Q(x)` for every admissible `x`. (`T` itself need not be admissible
or lie in `G`.)

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem minimizer_of_section {α : Type*} (Q : α → ℝ) (S G : α → Prop) {T : α}
    (hTmin : ∀ x, S x ∧ G x → Q T ≤ Q x) (hfix : ∀ x, S x → ∃ x', (S x' ∧ G x') ∧ Q x' ≤ Q x) :
    ∀ x, S x → Q T ≤ Q x := by
  intro x hx
  obtain ⟨x', hx', hle⟩ := hfix x hx
  exact (hTmin x' hx').trans hle

/-- **Minimality transfers from a penalised problem.** Let `R ≥ 0`. If `u` minimises `Q + R` on
`S`, and some `v ∈ S` minimises `Q` on `S` with `R(v) = 0`, then `u` minimises `Q` on `S`, and
`R(u) = 0`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem minimizer_of_penalty {α : Type*} (Q R : α → ℝ) (S : α → Prop) (hR : ∀ x, 0 ≤ R x)
    {u v : α} (hu : S u) (humin : ∀ x, S x → Q u + R u ≤ Q x + R x) (hv : S v)
    (hvmin : ∀ x, S x → Q v ≤ Q x) (hRv : R v = 0) : (∀ x, S x → Q u ≤ Q x) ∧ R u = 0 := by
  have h1 : Q u + R u ≤ Q v := by
    have := humin v hv
    rwa [hRv, add_zero] at this
  have h2 := hvmin u hu
  have hRu := hR u
  refine ⟨fun x hx => ?_, by linarith⟩
  linarith [hvmin x hx]

end Minimisers

section MatrixMinimisers

variable {ρ ι γ : Type*} [Fintype ρ] [Fintype ι]

/-- **The curvature transfer, matrix form.** If `u, u'` lie in `Σ₀ ∩ {A x = y}` and both
minimise `Q(x) = ‖D x‖²` on it, then `D u = D u'`, `u − u' ∈ Σ₀` and `A (u − u') = 0`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem mulVec_eq_of_minimizers (D : Matrix ρ ι ℝ) (A : Matrix γ ι ℝ)
    (S₀ : Submodule ℝ (ι → ℝ)) (y : γ → ℝ) {u u' : ι → ℝ}
    (hu : u ∈ S₀ ∧ A *ᵥ u = y) (hu' : u' ∈ S₀ ∧ A *ᵥ u' = y)
    (hmin : ∀ x ∈ S₀, A *ᵥ x = y → energy D u ≤ energy D x)
    (hmin' : ∀ x ∈ S₀, A *ᵥ x = y → energy D u' ≤ energy D x) :
    D *ᵥ u = D *ᵥ u' ∧ u - u' ∈ S₀ ∧ A *ᵥ (u - u') = 0 := by
  have hmS : (2⁻¹ : ℝ) • (u + u') ∈ S₀ := S₀.smul_mem _ (S₀.add_mem hu.1 hu'.1)
  have hmA : A *ᵥ ((2⁻¹ : ℝ) • (u + u')) = y := by
    rw [Matrix.mulVec_smul, Matrix.mulVec_add, hu.2, hu'.2, half_smul_add_self]
  have heq : energy D u = energy D u' := le_antisymm (hmin u' hu'.1 hu'.2) (hmin' u hu.1 hu.2)
  have hle := hmin _ hmS hmA
  have hpt : ∀ p, ((D *ᵥ u) p - (D *ᵥ u') p) ^ 2 = 2 * (D *ᵥ u) p ^ 2 + 2 * (D *ᵥ u') p ^ 2 -
      4 * (D *ᵥ ((2⁻¹ : ℝ) • (u + u'))) p ^ 2 := by
    intro p
    rw [Matrix.mulVec_smul, Matrix.mulVec_add]
    simp only [Pi.smul_apply, Pi.add_apply, smul_eq_mul]
    ring
  have hpar : ∑ p, ((D *ᵥ u) p - (D *ᵥ u') p) ^ 2 =
      2 * energy D u + 2 * energy D u' - 4 * energy D ((2⁻¹ : ℝ) • (u + u')) := by
    simp only [energy]
    rw [Finset.sum_congr rfl fun p _ => hpt p, Finset.sum_sub_distrib, Finset.sum_add_distrib,
      ← Finset.mul_sum, ← Finset.mul_sum, ← Finset.mul_sum]
  have hzero : ∑ p, ((D *ᵥ u) p - (D *ᵥ u') p) ^ 2 = 0 := by
    have := Finset.sum_nonneg fun p (_ : p ∈ Finset.univ) =>
      sq_nonneg ((D *ᵥ u) p - (D *ᵥ u') p)
    linarith
  have hDeq : D *ᵥ u = D *ᵥ u' := by
    funext p
    have h0 := (Finset.sum_eq_zero_iff_of_nonneg fun p _ =>
      sq_nonneg ((D *ᵥ u) p - (D *ᵥ u') p)).1 hzero p (Finset.mem_univ p)
    exact sub_eq_zero.1 ((pow_eq_zero_iff two_ne_zero).1 h0)
  refine ⟨hDeq, S₀.sub_mem hu.1 hu'.1, ?_⟩
  rw [Matrix.mulVec_sub, hu.2, hu'.2, sub_self]

/-- **Same curvature in the tree section and the smooth section.** Let the tree column `T` be
admissible, with `Q(T) ≤ Q(x)` for every admissible `x` in the tree section `G`, and suppose every
admissible point can be moved into `G` without raising `Q` (gauge fixing). Let `u` minimise
`Q + R` over the admissible points (`R ≥ 0`), and let some admissible `v` (the reduced tree column)
have `R(v) = 0` and `Q(v) ≤ Q(T)`. Then `D T = D u`, `T − u ∈ Σ₀`, `A(T − u) = 0` and `R(u) = 0`.
Admissible means `x ∈ Σ₀` and `A x = y`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem curvature_transfer (D : Matrix ρ ι ℝ) (A : Matrix γ ι ℝ) (S₀ : Submodule ℝ (ι → ℝ))
    (y : γ → ℝ) (G : (ι → ℝ) → Prop) (Rpen : (ι → ℝ) → ℝ) {T u v : ι → ℝ}
    (hT : T ∈ S₀ ∧ A *ᵥ T = y)
    (hTmin : ∀ x, (x ∈ S₀ ∧ A *ᵥ x = y) ∧ G x → energy D T ≤ energy D x)
    (hfix : ∀ x, x ∈ S₀ ∧ A *ᵥ x = y →
      ∃ x', ((x' ∈ S₀ ∧ A *ᵥ x' = y) ∧ G x') ∧ energy D x' ≤ energy D x)
    (hRpen : ∀ x, 0 ≤ Rpen x) (hu : u ∈ S₀ ∧ A *ᵥ u = y)
    (humin : ∀ x, x ∈ S₀ ∧ A *ᵥ x = y → energy D u + Rpen u ≤ energy D x + Rpen x)
    (hv : v ∈ S₀ ∧ A *ᵥ v = y) (hRv : Rpen v = 0) (hvT : energy D v ≤ energy D T) :
    D *ᵥ T = D *ᵥ u ∧ T - u ∈ S₀ ∧ A *ᵥ (T - u) = 0 ∧ Rpen u = 0 := by
  have hTS := minimizer_of_section (energy D) (fun x => x ∈ S₀ ∧ A *ᵥ x = y) G hTmin hfix
  have hvS : ∀ x, x ∈ S₀ ∧ A *ᵥ x = y → energy D v ≤ energy D x :=
    fun x hx => hvT.trans (hTS x hx)
  obtain ⟨huS, hRu⟩ := minimizer_of_penalty (energy D) Rpen (fun x => x ∈ S₀ ∧ A *ᵥ x = y)
    hRpen hu humin hv hvS hRv
  obtain ⟨h1, h2, h3⟩ := mulVec_eq_of_minimizers D A S₀ y hT hu
    (fun x hx hAx => hTS x ⟨hx, hAx⟩) (fun x hx hAx => huS x ⟨hx, hAx⟩)
  exact ⟨h1, h2, h3, hRu⟩

end MatrixMinimisers

/-! ## 2. Weighted curvature energy (the commutator step) -/

section Commutator

variable {ρ ι : Type*} [Fintype ρ] [Fintype ι]

/-- **Weighted Young inequality.** `(a + c)² ≤ (1 + t) a² + (1 + t⁻¹) c²` for `t > 0`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem add_sq_le_young {t : ℝ} (ht : 0 < t) (a c : ℝ) :
    (a + c) ^ 2 ≤ (1 + t) * a ^ 2 + (1 + t⁻¹) * c ^ 2 := by
  have ht' : t * t⁻¹ = 1 := mul_inv_cancel₀ ht.ne'
  have hexp : t⁻¹ * (t * a - c) ^ 2 = t * a ^ 2 - 2 * a * c + t⁻¹ * c ^ 2 := by
    linear_combination (t * a ^ 2 - 2 * a * c) * ht'
  have hnn : 0 ≤ t⁻¹ * (t * a - c) ^ 2 := mul_nonneg (inv_nonneg.2 ht.le) (sq_nonneg _)
  nlinarith [hexp, hnn]

/-- **Commutator of a weight with the curvature.** Let the rows of `|D|` have sums `≤ m`
(`m ≥ 0`) and its columns have sums `≤ n`, and let `|e^{g(p) − f(e)} − 1| ≤ η` whenever
`D_{pe} ≠ 0`. Then for every `t > 0`,
`Σ_p e^{2g(p)} (D u)_p² ≤ (1 + t) Q(e^f u) + (1 + t⁻¹) η² m n ‖e^f u‖²`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem commutator_energy_le_young (D : Matrix ρ ι ℝ) (f u : ι → ℝ) (g : ρ → ℝ)
    {η m n t : ℝ} (ht : 0 < t) (hm : 0 ≤ m) (hrow : ∀ p, ∑ e, |D p e| ≤ m)
    (hcol : ∀ e, ∑ p, |D p e| ≤ n)
    (hη : ∀ p e, D p e ≠ 0 → |Real.exp (g p - f e) - 1| ≤ η) :
    ∑ p, Real.exp (2 * g p) * (D *ᵥ u) p ^ 2 ≤
      (1 + t) * energy D (weighted f u) +
        (1 + t⁻¹) * (η ^ 2 * m * n) * sqNorm (weighted f u) := by
  have hcomm : ∀ p, Real.exp (g p) * (D *ᵥ u) p - (D *ᵥ weighted f u) p =
      ∑ e, D p e * (Real.exp (g p - f e) - 1) * weighted f u e := by
    intro p
    simp only [Matrix.mulVec, dotProduct, weighted, Finset.mul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun e _ => ?_
    have hexp : Real.exp (g p) = Real.exp (g p - f e) * Real.exp (f e) := by
      rw [← Real.exp_add, sub_add_cancel]
    rw [hexp]
    ring
  have hpt : ∀ p, (Real.exp (g p) * (D *ᵥ u) p - (D *ᵥ weighted f u) p) ^ 2 ≤
      η ^ 2 * m * ∑ e, |D p e| * weighted f u e ^ 2 := by
    intro p
    rw [hcomm p]
    have h1 : |∑ e, D p e * (Real.exp (g p - f e) - 1) * weighted f u e| ≤
        η * ∑ e, |D p e| * |weighted f u e| := by
      rw [Finset.mul_sum]
      refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun e _ => ?_)
      rw [abs_mul, abs_mul]
      by_cases hD : D p e = 0
      · simp [hD]
      · calc |D p e| * |Real.exp (g p - f e) - 1| * |weighted f u e|
            ≤ |D p e| * η * |weighted f u e| := by
              gcongr
              exact hη p e hD
          _ = η * (|D p e| * |weighted f u e|) := by ring
    have h2 : (∑ e, |D p e| * |weighted f u e|) ^ 2 ≤
        (∑ e, |D p e|) * ∑ e, |D p e| * weighted f u e ^ 2 :=
      Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul _ (fun e _ => abs_nonneg _)
        (fun e _ => mul_nonneg (abs_nonneg _) (sq_nonneg _))
        (fun e _ => le_of_eq (by rw [mul_pow, sq_abs (weighted f u e)]; ring))
    have h3 : 0 ≤ ∑ e, |D p e| * weighted f u e ^ 2 :=
      Finset.sum_nonneg fun e _ => mul_nonneg (abs_nonneg _) (sq_nonneg _)
    calc (∑ e, D p e * (Real.exp (g p - f e) - 1) * weighted f u e) ^ 2
        = |∑ e, D p e * (Real.exp (g p - f e) - 1) * weighted f u e| ^ 2 := (sq_abs _).symm
      _ ≤ (η * ∑ e, |D p e| * |weighted f u e|) ^ 2 := pow_le_pow_left₀ (abs_nonneg _) h1 2
      _ = η ^ 2 * (∑ e, |D p e| * |weighted f u e|) ^ 2 := by ring
      _ ≤ η ^ 2 * ((∑ e, |D p e|) * ∑ e, |D p e| * weighted f u e ^ 2) :=
          mul_le_mul_of_nonneg_left h2 (sq_nonneg η)
      _ ≤ η ^ 2 * (m * ∑ e, |D p e| * weighted f u e ^ 2) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (hrow p) h3) (sq_nonneg η)
      _ = η ^ 2 * m * ∑ e, |D p e| * weighted f u e ^ 2 := by ring
  have hdouble : ∑ p, ∑ e, |D p e| * weighted f u e ^ 2 ≤ n * sqNorm (weighted f u) := by
    rw [Finset.sum_comm]
    unfold sqNorm
    rw [Finset.mul_sum]
    refine Finset.sum_le_sum fun e _ => ?_
    rw [← Finset.sum_mul]
    exact mul_le_mul_of_nonneg_right (hcol e) (sq_nonneg _)
  have ht1 : 0 ≤ 1 + t⁻¹ := by positivity
  have hsplit : ∀ p, Real.exp (2 * g p) * (D *ᵥ u) p ^ 2 ≤
      (1 + t) * (D *ᵥ weighted f u) p ^ 2 +
        (1 + t⁻¹) * (η ^ 2 * m * ∑ e, |D p e| * weighted f u e ^ 2) := by
    intro p
    have hexp : Real.exp (2 * g p) = Real.exp (g p) ^ 2 := by
      rw [sq, ← Real.exp_add, two_mul]
    have hy := add_sq_le_young ht ((D *ᵥ weighted f u) p)
      (Real.exp (g p) * (D *ᵥ u) p - (D *ᵥ weighted f u) p)
    have hab := mul_le_mul_of_nonneg_left (hpt p) ht1
    rw [hexp]
    nlinarith [hy, hab]
  have hηm : 0 ≤ (1 + t⁻¹) * (η ^ 2 * m) := mul_nonneg ht1 (mul_nonneg (sq_nonneg η) hm)
  calc ∑ p, Real.exp (2 * g p) * (D *ᵥ u) p ^ 2
      ≤ ∑ p, ((1 + t) * (D *ᵥ weighted f u) p ^ 2 +
          (1 + t⁻¹) * (η ^ 2 * m * ∑ e, |D p e| * weighted f u e ^ 2)) :=
        Finset.sum_le_sum fun p _ => hsplit p
    _ = (1 + t) * energy D (weighted f u) +
          (1 + t⁻¹) * (η ^ 2 * m) * ∑ p, ∑ e, |D p e| * weighted f u e ^ 2 := by
        rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum, ← Finset.mul_sum]
        unfold energy
        ring
    _ ≤ (1 + t) * energy D (weighted f u) +
          (1 + t⁻¹) * (η ^ 2 * m) * (n * sqNorm (weighted f u)) := by
        linarith [mul_le_mul_of_nonneg_left hdouble hηm]
    _ = (1 + t) * energy D (weighted f u) +
          (1 + t⁻¹) * (η ^ 2 * m * n) * sqNorm (weighted f u) := by ring

/-- **Commutator of a weight with the curvature, `t = 1`.** Under the hypotheses of
`commutator_energy_le_young`, `Σ_p e^{2g(p)} (D u)_p² ≤ 2 Q(e^f u) + 2 η² m n ‖e^f u‖²`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem commutator_energy_le (D : Matrix ρ ι ℝ) (f u : ι → ℝ) (g : ρ → ℝ) {η m n : ℝ}
    (hm : 0 ≤ m) (hrow : ∀ p, ∑ e, |D p e| ≤ m) (hcol : ∀ e, ∑ p, |D p e| ≤ n)
    (hη : ∀ p e, D p e ≠ 0 → |Real.exp (g p - f e) - 1| ≤ η) :
    ∑ p, Real.exp (2 * g p) * (D *ᵥ u) p ^ 2 ≤
      2 * energy D (weighted f u) + 2 * (η ^ 2 * m * n) * sqNorm (weighted f u) := by
  have h := commutator_energy_le_young D f u g one_pos hm hrow hcol hη
  norm_num at h
  linarith

/-- **Weighted curvature energy.** In the lattice normalisation (rows of `|D|` sum to `≤ 4`,
columns to `≤ 6`, weights `λ₀/2^k`-Lipschitz along the incidence, `λ₀ ≥ 0`, `96 λ₀² ≤ 1`), the
energy-norm form of the weighted bound, `Q(e^f u) + 4^{−k}‖e^f u‖² ≤ (2𝔐)²`, gives
`Σ_p e^{2g(p)} (D u)_p² ≤ 8𝔐²`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem weighted_curvature_le (D : Matrix ρ ι ℝ) (f u : ι → ℝ) (g : ρ → ℝ) (k : ℕ) {lam M : ℝ}
    (hlam : 0 ≤ lam) (hlam96 : 96 * lam ^ 2 ≤ 1)
    (hrow : ∀ p, ∑ e, |D p e| ≤ 4) (hcol : ∀ e, ∑ p, |D p e| ≤ 6)
    (hlip : ∀ p e, D p e ≠ 0 → |g p - f e| ≤ lam / 2 ^ k)
    (hV : energy D (weighted f u) + sqNorm (weighted f u) / 4 ^ k ≤ (2 * M) ^ 2) :
    ∑ p, Real.exp (2 * g p) * (D *ᵥ u) p ^ 2 ≤ 8 * M ^ 2 := by
  have hlam1 : lam ≤ 1 := by nlinarith
  have hstep : lam / 2 ^ k ≤ 1 := (div_le_self hlam (one_le_pow₀ (by norm_num))).trans hlam1
  have hη : ∀ p e, D p e ≠ 0 → |Real.exp (g p - f e) - 1| ≤ 2 * (lam / 2 ^ k) := by
    intro p e hD
    have h := hlip p e hD
    have := Real.abs_exp_sub_one_le (h.trans hstep)
    linarith
  have hmain := commutator_energy_le D f u g (by norm_num : (0 : ℝ) ≤ 4) hrow hcol hη
  have h4k : (4 : ℝ) ^ k = (2 ^ k) ^ 2 := by
    rw [← pow_mul, mul_comm, pow_mul]; norm_num
  have hN : 0 ≤ sqNorm (weighted f u) / 4 ^ k :=
    div_nonneg (Finset.sum_nonneg fun _ _ => sq_nonneg _) (by positivity)
  have hcoef : 2 * ((2 * (lam / 2 ^ k)) ^ 2 * 4 * 6) * sqNorm (weighted f u) =
      192 * lam ^ 2 * (sqNorm (weighted f u) / 4 ^ k) := by
    rw [h4k]; field_simp; ring
  have h192 : 192 * lam ^ 2 * (sqNorm (weighted f u) / 4 ^ k) ≤
      2 * (sqNorm (weighted f u) / 4 ^ k) := mul_le_mul_of_nonneg_right (by linarith) hN
  have hM2 : (2 * M) ^ 2 = 4 * M ^ 2 := by ring
  linarith

/-- **Weighted curvature energy, Young form.** Let the rows of `|D|` sum to `≤ 4`, its columns
to `≤ 6`, the weights be `λ₀/2^k`-Lipschitz along the incidence with `0 < λ₀ ≤ 1` (the condition
`96 λ₀² ≤ 1` of `weighted_curvature_le` is not needed), and
`Q(e^f u) + 4^{−k}‖e^f u‖² ≤ (2𝔐)²`. Then the weighted Young inequality at `t = 96 λ₀²` gives
`Σ_p e^{2g(p)} (D u)_p² ≤ 4𝔐² (1 + 96 λ₀²)`. (For small `λ₀` this is about half of the bound
`8𝔐²`; for illustration, not part of the statement.)

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem weighted_curvature_le_young (D : Matrix ρ ι ℝ) (f u : ι → ℝ) (g : ρ → ℝ) (k : ℕ)
    {lam M : ℝ} (hlam : 0 < lam) (hlam1 : lam ≤ 1)
    (hrow : ∀ p, ∑ e, |D p e| ≤ 4) (hcol : ∀ e, ∑ p, |D p e| ≤ 6)
    (hlip : ∀ p e, D p e ≠ 0 → |g p - f e| ≤ lam / 2 ^ k)
    (hV : energy D (weighted f u) + sqNorm (weighted f u) / 4 ^ k ≤ (2 * M) ^ 2) :
    ∑ p, Real.exp (2 * g p) * (D *ᵥ u) p ^ 2 ≤ 4 * M ^ 2 * (1 + 96 * lam ^ 2) := by
  have hstep : lam / 2 ^ k ≤ 1 :=
    (div_le_self hlam.le (one_le_pow₀ (by norm_num))).trans hlam1
  have hη : ∀ p e, D p e ≠ 0 → |Real.exp (g p - f e) - 1| ≤ 2 * (lam / 2 ^ k) := by
    intro p e hD
    have h := hlip p e hD
    have := Real.abs_exp_sub_one_le (h.trans hstep)
    linarith
  have ht : 0 < 96 * lam ^ 2 := by positivity
  have hmain := commutator_energy_le_young D f u g ht (by norm_num : (0 : ℝ) ≤ 4) hrow hcol hη
  have h4k : (4 : ℝ) ^ k = (2 ^ k) ^ 2 := by
    rw [← pow_mul, mul_comm, pow_mul]; norm_num
  have hcoef : (1 + (96 * lam ^ 2)⁻¹) * ((2 * (lam / 2 ^ k)) ^ 2 * 4 * 6) *
      sqNorm (weighted f u) = (1 + 96 * lam ^ 2) * (sqNorm (weighted f u) / 4 ^ k) := by
    rw [h4k]; field_simp; ring
  have hV' := mul_le_mul_of_nonneg_left hV (by positivity : (0 : ℝ) ≤ 1 + 96 * lam ^ 2)
  have hM2 : (2 * M) ^ 2 = 4 * M ^ 2 := by ring
  nlinarith [hmain, hcoef, hV']

end Commutator

/-! ## 3. Curvature mass (Cauchy–Schwarz) and the constant `κ_lead` -/

section Mass

variable {ρ : Type*} [Fintype ρ]

/-- **Weighted Cauchy–Schwarz.** `‖x‖₁² ≤ (Σ_p e^{−2g(p)}) (Σ_p e^{2g(p)} x_p²)`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem l1_sq_le (x g : ρ → ℝ) :
    l1 x ^ 2 ≤ (∑ p, Real.exp (-(2 * g p))) * ∑ p, Real.exp (2 * g p) * x p ^ 2 :=
  Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul _ (fun p _ => (Real.exp_pos _).le)
    (fun p _ => mul_nonneg (Real.exp_pos _).le (sq_nonneg _))
    (fun p _ => le_of_eq (by
      rw [sq_abs, ← mul_assoc, ← Real.exp_add, neg_add_cancel, Real.exp_zero, one_mul]))

/-- The **leading term** `κ_lead = 24 √2 𝔐 / λ₀²` of the curvature-mass constant, without the
correction factors `(1 + 96 λ₀²)^{1/2}` and `(1 + δ)^{1/2}` carried by the corrected constant
`κ_* = 24√2 (1 + 96 λ₀²)^{1/2} (1 + δ)^{1/2} 𝔐/λ₀²`. The two constants are different objects.
Under its hypotheses, `curvature_mass_le_lead` shows that `κ_lead` itself bounds the curvature
mass.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
def kappaLead (M lam : ℝ) : ℝ := 24 * √2 * M / lam ^ 2

/-- **From the squared mass to `√q κ_lead`.** If `‖x‖₁² ≤ 144 (2^k/λ₀)⁴ q · 8𝔐²` with
`q, 𝔐 ≥ 0`, then `‖x‖₁ / 4^k ≤ √q · κ_lead`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem curvature_mass_le_of_sq (x : ρ → ℝ) (k : ℕ) {M lam q : ℝ} (hM : 0 ≤ M) (hq : 0 ≤ q)
    (hprod : l1 x ^ 2 ≤ (144 * (2 ^ k / lam) ^ 4 * q) * (8 * M ^ 2)) :
    l1 x / 4 ^ k ≤ √q * kappaLead M lam := by
  have h4 : ((2 : ℝ) ^ k) ^ 4 = ((4 : ℝ) ^ k) ^ 2 := by
    rw [← pow_mul, ← pow_mul, show (4 : ℝ) = 2 ^ 2 by norm_num, ← pow_mul]; ring_nf
  have hid : (144 * (2 ^ k / lam) ^ 4 * q) * (8 * M ^ 2) =
      (√q * kappaLead M lam * 4 ^ k) ^ 2 := by
    have hs : (√q * kappaLead M lam * 4 ^ k) ^ 2 =
        √q ^ 2 * √2 ^ 2 * (576 * M ^ 2 / lam ^ 4 * ((4 : ℝ) ^ k) ^ 2) := by
      unfold kappaLead; ring
    rw [hs, Real.sq_sqrt hq, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2), div_pow, h4]
    ring
  have hrhs : 0 ≤ √q * kappaLead M lam * 4 ^ k := by unfold kappaLead; positivity
  rw [div_le_iff₀ (by positivity)]
  exact (le_abs_self _).trans (abs_le_of_sq_le_sq (hprod.trans_eq hid) hrhs)

/-- **The curvature mass is bounded by `√q κ_lead`.** Let `𝔐 ≥ 0` and `q ≥ 0`. If
`Σ_p e^{−2g(p)} ≤ 144 (2^k/λ₀)⁴ q` and `Σ_p e^{2g(p)} x_p² ≤ 8𝔐²`, then
`‖x‖₁ / 4^k ≤ √q · κ_lead`.

Here `q` bounds the excess of the weight sum over its leading term `144 (2^k/λ₀)⁴`. Given only
these two hypotheses, `√q` cannot be dropped: Cauchy–Schwarz is attained when `|x|` is
proportional to `e^{−2g}` (an observation, not formalised). Under the shell-count hypothesis of
`tree_gauge_loss_le`, the majorant `q = e^{8λ₀/2^k}` is proved there, so `√q = e^{4λ₀/2^k}`. This
majorant depends only on `λ₀` and `k` and decreases in `k`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem curvature_mass_le (x g : ρ → ℝ) (k : ℕ) {M lam q : ℝ} (hM : 0 ≤ M) (hq : 0 ≤ q)
    (hW : ∑ p, Real.exp (-(2 * g p)) ≤ 144 * (2 ^ k / lam) ^ 4 * q)
    (hE : ∑ p, Real.exp (2 * g p) * x p ^ 2 ≤ 8 * M ^ 2) :
    l1 x / 4 ^ k ≤ √q * kappaLead M lam := by
  have hE0 : 0 ≤ ∑ p, Real.exp (2 * g p) * x p ^ 2 :=
    Finset.sum_nonneg fun p _ => mul_nonneg (Real.exp_pos _).le (sq_nonneg _)
  have hWq : 0 ≤ 144 * (2 ^ k / lam) ^ 4 * q := mul_nonneg (by positivity) hq
  exact curvature_mass_le_of_sq x k hM hq ((l1_sq_le x g).trans (mul_le_mul hW hE hE0 hWq))

/-- **The curvature mass is bounded by `κ_lead` itself.** Let `𝔐 ≥ 0` and `q ≥ 0`. If
`Σ_p e^{−2g(p)} ≤ 144 (2^k/λ₀)⁴ q`, `Σ_p e^{2g(p)} x_p² ≤ 4𝔐² (1 + 96 λ₀²)` (the Young form of the
weighted curvature energy) and `q (1 + 96 λ₀²) ≤ 2`, then `‖x‖₁ / 4^k ≤ κ_lead = 24√2 𝔐/λ₀²`.
No excess factor remains.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem curvature_mass_le_lead (x g : ρ → ℝ) (k : ℕ) {M lam q : ℝ} (hM : 0 ≤ M) (hq : 0 ≤ q)
    (hqt : q * (1 + 96 * lam ^ 2) ≤ 2)
    (hW : ∑ p, Real.exp (-(2 * g p)) ≤ 144 * (2 ^ k / lam) ^ 4 * q)
    (hE : ∑ p, Real.exp (2 * g p) * x p ^ 2 ≤ 4 * M ^ 2 * (1 + 96 * lam ^ 2)) :
    l1 x / 4 ^ k ≤ kappaLead M lam := by
  have hE0 : 0 ≤ ∑ p, Real.exp (2 * g p) * x p ^ 2 :=
    Finset.sum_nonneg fun p _ => mul_nonneg (Real.exp_pos _).le (sq_nonneg _)
  have hWq : 0 ≤ 144 * (2 ^ k / lam) ^ 4 * q := mul_nonneg (by positivity) hq
  have hc : 0 ≤ 144 * (2 ^ k / lam) ^ 4 * (4 * M ^ 2) := by positivity
  have hprod : l1 x ^ 2 ≤ (144 * (2 ^ k / lam) ^ 4 * 1) * (8 * M ^ 2) := by
    calc l1 x ^ 2 ≤ (144 * (2 ^ k / lam) ^ 4 * q) * (4 * M ^ 2 * (1 + 96 * lam ^ 2)) :=
          (l1_sq_le x g).trans (mul_le_mul hW hE hE0 hWq)
      _ = (144 * (2 ^ k / lam) ^ 4 * (4 * M ^ 2)) * (q * (1 + 96 * lam ^ 2)) := by ring
      _ ≤ (144 * (2 ^ k / lam) ^ 4 * (4 * M ^ 2)) * 2 := mul_le_mul_of_nonneg_left hqt hc
      _ = (144 * (2 ^ k / lam) ^ 4 * 1) * (8 * M ^ 2) := by ring
  have h := curvature_mass_le_of_sq x k hM zero_le_one hprod
  rwa [Real.sqrt_one, one_mul] at h

/-- **`√q κ_lead ≤ 34 𝔐/λ₀²` for `0 ≤ q ≤ 289/288`**, when `𝔐 ≥ 0`. (`(24√2)² q ≤ 34²` exactly
when `q ≤ 289/288`.)

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem sqrt_mul_kappaLead_le {M lam q : ℝ} (hM : 0 ≤ M) (hq : 0 ≤ q) (hq' : q ≤ 289 / 288) :
    √q * kappaLead M lam ≤ 34 * M / lam ^ 2 := by
  have hc : √q * (24 * √2) ≤ 34 := by
    have hsq : (√q * (24 * √2)) ^ 2 ≤ 34 ^ 2 := by
      rw [show (√q * (24 * √2)) ^ 2 = √q ^ 2 * √2 ^ 2 * 576 by ring, Real.sq_sqrt hq,
        Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]
      linarith
    exact (le_abs_self _).trans (abs_le_of_sq_le_sq hsq (by norm_num))
  unfold kappaLead
  have hML : 0 ≤ M / lam ^ 2 := div_nonneg hM (sq_nonneg _)
  calc √q * (24 * √2 * M / lam ^ 2) = √q * (24 * √2) * (M / lam ^ 2) := by ring
    _ ≤ 34 * (M / lam ^ 2) := mul_le_mul_of_nonneg_right hc hML
    _ = 34 * M / lam ^ 2 := by ring

/-- **`κ_lead ≤ 34 𝔐/λ₀²`** for `𝔐 ≥ 0` (the case `q = 1` of `sqrt_mul_kappaLead_le`).

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem kappaLead_le {M lam : ℝ} (hM : 0 ≤ M) : kappaLead M lam ≤ 34 * M / lam ^ 2 := by
  simpa using sqrt_mul_kappaLead_le (q := 1) (lam := lam) hM zero_le_one (by norm_num)

/-- **Numerical size of `κ_lead`.** If `0 ≤ 𝔐 ≤ 6.34·10¹¹` and `λ₀ ≥ 3.928·10⁻²¹`, then
`κ_lead ≤ 1.4·10⁵⁴`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem kappaLead_numeric_le {M lam : ℝ} (hM0 : 0 ≤ M) (hM : M ≤ 634 * 10 ^ 9)
    (hlam : 3928 / 10 ^ 24 ≤ lam) : kappaLead M lam ≤ 14 * 10 ^ 53 := by
  have h2 : √2 ≤ 14143 / 10000 := by
    rw [show (14143 / 10000 : ℝ) = √((14143 / 10000) ^ 2) by
      rw [Real.sqrt_sq (by norm_num)]]
    exact Real.sqrt_le_sqrt (by norm_num)
  have hl2 : (3928 / 10 ^ 24 : ℝ) ^ 2 ≤ lam ^ 2 := pow_le_pow_left₀ (by norm_num) hlam 2
  have hnum : 24 * √2 * M ≤ 24 * (14143 / 10000) * (634 * 10 ^ 9) := by
    have := Real.sqrt_nonneg 2
    nlinarith
  unfold kappaLead
  calc 24 * √2 * M / lam ^ 2 ≤ 24 * (14143 / 10000) * (634 * 10 ^ 9) / (3928 / 10 ^ 24) ^ 2 :=
        div_le_div₀ (by norm_num) hnum (by norm_num) hl2
    _ ≤ 14 * 10 ^ 53 := by norm_num

end Mass

/-! ## 4. Shell sums: an explicit bound for the weight sum -/

section Shells

/-- `C(r + 3, 3) · 6 = (r + 1)(r + 2)(r + 3)`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem choose_three_cast (r : ℕ) :
    (((r + 3).choose 3 : ℕ) : ℝ) * 6 = ((r : ℝ) + 1) * ((r : ℝ) + 2) * ((r : ℝ) + 3) := by
  have h1 : (r + 3) * (r + 2).choose 2 = (r + 3).choose 3 * 3 :=
    Nat.add_one_mul_choose_eq (r + 2) 2
  have h2 : (r + 2) * (r + 1).choose 1 = (r + 2).choose 2 * 2 :=
    Nat.add_one_mul_choose_eq (r + 1) 1
  rw [Nat.choose_one_right] at h2
  have h1' : ((r : ℝ) + 3) * (((r + 2).choose 2 : ℕ) : ℝ) = (((r + 3).choose 3 : ℕ) : ℝ) * 3 := by
    exact_mod_cast h1
  have h2' : ((r : ℝ) + 2) * ((r : ℝ) + 1) = (((r + 2).choose 2 : ℕ) : ℝ) * 2 := by
    exact_mod_cast h2
  linear_combination (-2 : ℝ) * h1' - ((r : ℝ) + 3) * h2'

/-- **The shell series.** For `0 ≤ x < 1` and every `R`,
`Σ_{r<R} (64 r³ + 16 r + 1) x^r ≤ 384/(1 − x)⁴`, since `64 r³ + 16 r + 1 ≤ 384 C(r + 3, 3)` and
`Σ_r C(r + 3, 3) x^r = (1 − x)^{−4}`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem shell_series_le {x : ℝ} (hx0 : 0 ≤ x) (hx1 : x < 1) (R : ℕ) :
    ∑ r ∈ range R, (64 * (r : ℝ) ^ 3 + 16 * r + 1) * x ^ r ≤ 384 / (1 - x) ^ 4 := by
  have hs := hasSum_choose_mul_geometric_of_norm_lt_one (𝕜 := ℝ) 3
    (by rwa [Real.norm_of_nonneg hx0])
  have hle : ∑ r ∈ range R, (((r + 3).choose 3 : ℕ) : ℝ) * x ^ r ≤ 1 / (1 - x) ^ 4 :=
    sum_le_hasSum (range R) (fun r _ => mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hx0 r)) hs
  calc ∑ r ∈ range R, (64 * (r : ℝ) ^ 3 + 16 * r + 1) * x ^ r
      ≤ ∑ r ∈ range R, 384 * ((((r + 3).choose 3 : ℕ) : ℝ) * x ^ r) := by
        refine Finset.sum_le_sum fun r _ => ?_
        have h := choose_three_cast r
        have hr : (0 : ℝ) ≤ r := Nat.cast_nonneg r
        have hxr : 0 ≤ x ^ r := pow_nonneg hx0 r
        have hpoly : 64 * (r : ℝ) ^ 3 + 16 * r + 1 ≤ 384 * (((r + 3).choose 3 : ℕ) : ℝ) := by
          nlinarith
        calc (64 * (r : ℝ) ^ 3 + 16 * r + 1) * x ^ r
            ≤ 384 * (((r + 3).choose 3 : ℕ) : ℝ) * x ^ r :=
              mul_le_mul_of_nonneg_right hpoly hxr
          _ = 384 * ((((r + 3).choose 3 : ℕ) : ℝ) * x ^ r) := by ring
    _ = 384 * ∑ r ∈ range R, (((r + 3).choose 3 : ℕ) : ℝ) * x ^ r := by rw [Finset.mul_sum]
    _ ≤ 384 * (1 / (1 - x) ^ 4) := mul_le_mul_of_nonneg_left hle (by norm_num)
    _ = 384 / (1 - x) ^ 4 := mul_one_div _ _

/-- `b e^{−b} ≤ 1 − e^{−b}` for every real `b` (equivalently `1 + b ≤ e^b`).

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem mul_exp_neg_le_one_sub (b : ℝ) : b * Real.exp (-b) ≤ 1 - Real.exp (-b) := by
  have h1 := Real.add_one_le_exp b
  have h2 : Real.exp b * Real.exp (-b) = 1 := by
    rw [← Real.exp_add, add_neg_cancel, Real.exp_zero]
  have h3 := Real.exp_pos (-b)
  nlinarith [mul_le_mul_of_nonneg_right h1 h3.le]

/-- **Explicit shell bound.** For `b > 0` and every `R`,
`Σ_{r<R} (64 r³ + 16 r + 1) e^{−br} ≤ 384 e^{4b}/b⁴`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem shell_weight_le {b : ℝ} (hb : 0 < b) (R : ℕ) :
    ∑ r ∈ range R, (64 * (r : ℝ) ^ 3 + 16 * r + 1) * Real.exp (-b) ^ r ≤
      384 * Real.exp b ^ 4 / b ^ 4 := by
  have hx1 : Real.exp (-b) < 1 := Real.exp_lt_one_iff.2 (by linarith)
  refine (shell_series_le (Real.exp_pos _).le hx1 R).trans ?_
  have hpos : 0 < b * Real.exp (-b) := mul_pos hb (Real.exp_pos _)
  have h4 : (b * Real.exp (-b)) ^ 4 ≤ (1 - Real.exp (-b)) ^ 4 :=
    pow_le_pow_left₀ hpos.le (mul_exp_neg_le_one_sub b) 4
  refine (div_le_div_of_nonneg_left (by norm_num) (by positivity) h4).trans (le_of_eq ?_)
  have hb0 : b ≠ 0 := hb.ne'
  have he : Real.exp b ≠ 0 := (Real.exp_pos b).ne'
  rw [Real.exp_neg]
  field_simp

/-- **The weight bound at rate `b = 2λ₀/2^k`.** For `λ₀ > 0`,
`6 · 384 e^{4b}/b⁴ = 144 (2^k/λ₀)⁴ e^{4b}`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem weight_bound_eq (k : ℕ) {lam : ℝ} (hlam : 0 < lam) :
    6 * (384 * Real.exp (2 * lam / 2 ^ k) ^ 4 / (2 * lam / 2 ^ k) ^ 4) =
      144 * (2 ^ k / lam) ^ 4 * Real.exp (2 * lam / 2 ^ k) ^ 4 := by
  have hl : lam ≠ 0 := hlam.ne'
  field_simp
  ring

/-- **The excess majorant is harmless for small rates.** If `0 ≤ b ≤ 2·10⁻⁴` and `𝔐 ≥ 0`, then
`e^{2b} κ_lead ≤ 34 𝔐/λ₀²`. The statement does not tie `b` to `λ₀` or `k`. In the intended use
`b = 2λ₀/2^k`, so that `e^{2b} = √q` for the majorant `q = e^{8λ₀/2^k}`; then, for
`0 ≤ λ₀ ≤ 10⁻⁴`, the hypotheses `0 ≤ b ≤ 2·10⁻⁴` hold at every `k`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem exp_sq_mul_kappaLead_le {b M lam : ℝ} (hb0 : 0 ≤ b) (hb : b ≤ 2 / 10000) (hM : 0 ≤ M) :
    Real.exp b ^ 2 * kappaLead M lam ≤ 34 * M / lam ^ 2 := by
  have hb1 : |b| ≤ 1 := by rw [abs_of_nonneg hb0]; linarith
  have hX : Real.exp b ≤ 10004 / 10000 := by
    have h := Real.abs_exp_sub_one_le hb1
    rw [abs_of_nonneg hb0] at h
    have := le_abs_self (Real.exp b - 1)
    linarith
  have hX0 : 0 ≤ Real.exp b := (Real.exp_pos b).le
  have hq : Real.exp b ^ 4 ≤ 289 / 288 := by
    calc Real.exp b ^ 4 ≤ (10004 / 10000) ^ 4 := pow_le_pow_left₀ hX0 hX 4
      _ ≤ 289 / 288 := by norm_num
  have hsq : √(Real.exp b ^ 4) = Real.exp b ^ 2 := by
    rw [show Real.exp b ^ 4 = (Real.exp b ^ 2) ^ 2 by ring]
    exact Real.sqrt_sq (by positivity)
  rw [← hsq]
  exact sqrt_mul_kappaLead_le hM (by positivity) hq

end Shells

/-! ## 5. The tree-gauge `ℓ¹` inequality and its constant -/

section TreeConstant

/-- **Internal links (`c₁ = 1`).** If `a = −Σ_{p ∈ s} F_p` with `s ⊆ t`, then
`|a| ≤ Σ_{p ∈ t} |F_p|`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem internal_link_le {β : Type*} (s t : Finset β) (F : β → ℝ) (hst : s ⊆ t) {a : ℝ}
    (ha : a = -∑ p ∈ s, F p) : |a| ≤ ∑ p ∈ t, |F p| := by
  rw [ha, abs_neg]
  exact (Finset.abs_sum_le_sum_abs _ _).trans
    (Finset.sum_le_sum_of_subset_of_nonneg hst fun _ _ _ => abs_nonneg _)

/-- **Crossing links (`c₂ ≤ 7/2`).** Let `y_a` (`a ∈ {0,1}³`, eight siblings) satisfy
`|y_a − y_{a'}| ≤ 3σ` for all `a, a'`, and `|S| + |S'| ≤ 8σ`. Then the parent value
`⅛ Σ_a y_a + (1/16)(S + S')` is within `(7/2)σ` of every `y_a`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem crossing_link_le (y : Fin 8 → ℝ) {S S' σ : ℝ} (hpath : ∀ a a', |y a - y a'| ≤ 3 * σ)
    (hS : |S| + |S'| ≤ 8 * σ) (a : Fin 8) :
    |y a - ((1 / 8) * ∑ a', y a' + (1 / 16) * (S + S'))| ≤ 7 / 2 * σ := by
  have hmean : y a - (1 / 8) * ∑ a', y a' = (1 / 8) * ∑ a', (y a - y a') := by
    rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      nsmul_eq_mul]
    push_cast
    ring
  have h1 : |(1 / 8 : ℝ) * ∑ a', (y a - y a')| ≤ 3 * σ := by
    have hsum : ∑ a', |y a - y a'| ≤ ∑ _a' : Fin 8, 3 * σ :=
      Finset.sum_le_sum fun a' _ => hpath a a'
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at hsum
    have habs := (Finset.abs_sum_le_sum_abs _ _).trans hsum
    rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 8)]
    push_cast at habs
    linarith
  have h2 : |(1 / 16 : ℝ) * (S + S')| ≤ 1 / 2 * σ := by
    rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 16)]
    have := abs_add_le S S'
    linarith
  calc |y a - ((1 / 8) * ∑ a', y a' + (1 / 16) * (S + S'))|
      = |(y a - (1 / 8) * ∑ a', y a') + -((1 / 16) * (S + S'))| := by congr 1; ring
    _ ≤ |y a - (1 / 8) * ∑ a', y a'| + |-((1 / 16) * (S + S'))| := abs_add_le _ _
    _ = |(1 / 8 : ℝ) * ∑ a', (y a - y a')| + |(1 / 16 : ℝ) * (S + S')| := by
        rw [hmean, abs_neg]
    _ ≤ 3 * σ + 1 / 2 * σ := add_le_add h1 h2
    _ = 7 / 2 * σ := by ring

/-- The constant of the tree-gauge `ℓ¹` inequality in dimension `d`:
`C_d = 2d · 2^{d−1} c₂ + c₁ c_B` (box multiplicity `2d`, `2^{d−1}` children per coarse link).

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
def treeConst (d : ℕ) (c₁ c₂ cB : ℝ) : ℝ := 2 * d * 2 ^ (d - 1) * c₂ + c₁ * cB

/-- `C₄ = 64 c₂ + c₁ c_B`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem treeConst_four (c₁ c₂ cB : ℝ) : treeConst 4 c₁ c₂ cB = 64 * c₂ + c₁ * cB := by
  unfold treeConst
  norm_num

/-- **`C₄ ≤ 241`** from `c₁ = 1`, `c_B = 17` and `c₂ ≤ 7/2`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem treeConst_four_le {c₂ : ℝ} (hc₂ : c₂ ≤ 7 / 2) : treeConst 4 1 c₂ 17 ≤ 241 := by
  rw [treeConst_four]
  linarith

/-- **A sharper constant, `C₄ ≤ 128`, from tightened local constants.** If `c₂ ≤ 31/16` and
`c₁ c_B ≤ 4`, then `C₄ ≤ 128`. Both inputs are hypotheses. They are stronger than the local
constants proved in this file (`c₂ ≤ 7/2` in `crossing_link_le`, and `c₁ c_B = 17` from `c₁ = 1`
and `c_B = 17`), and they are not proved here. The composition (§6) uses `C ≤ 241`, not this
bound.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem treeConst_four_le_128 {c₁ c₂ cB : ℝ} (hc₂ : c₂ ≤ 31 / 16) (hcB : c₁ * cB ≤ 4) :
    treeConst 4 c₁ c₂ cB ≤ 128 := by
  rw [treeConst_four]
  linarith

/-- **The count behind `c_B = 17`.** In the natural numbers, `4 · 2³ − Σ_{μ<4} 2^μ = 17`. In
the intended reading a `2⁴` block has `4 · 2³ = 32` internal links, of which `Σ_{μ<4} 2^μ = 15`
are tree links; that count of links is not formalised, only the arithmetic.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem block_link_count : 4 * 2 ^ 3 - ∑ μ ∈ range 4, 2 ^ μ = 17 := by
  decide

/-- **The level summation costs no logarithm.** Let `d ≥ 2` and `C ≥ 0`. If
`Φ ≤ s a + Σ_{i<k} C 2^{(d−1)i} F_i` and `F_i ≤ 2^{−(d−2)i} F₀` for every `i < k`, then
`Φ ≤ s a + C (2^k − 1) F₀`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem level_sum_bound {d k : ℕ} (hd : 2 ≤ d) {C s a Φ F₀ : ℝ} (F : ℕ → ℝ) (hC : 0 ≤ C)
    (htel : Φ ≤ s * a + ∑ i ∈ range k, C * 2 ^ ((d - 1) * i) * F i)
    (hcontr : ∀ i < k, F i ≤ F₀ / 2 ^ ((d - 2) * i)) :
    Φ ≤ s * a + C * (2 ^ k - 1) * F₀ := by
  have hterm : ∀ i ∈ range k, C * 2 ^ ((d - 1) * i) * F i ≤ C * F₀ * 2 ^ i := by
    intro i hi
    have hpow : (2 : ℝ) ^ ((d - 1) * i) = 2 ^ ((d - 2) * i) * 2 ^ i := by
      rw [← pow_add]; congr 1
      have : d - 1 = (d - 2) + 1 := by omega
      rw [this, add_mul, one_mul]
    have hpos : (0 : ℝ) < 2 ^ ((d - 2) * i) := by positivity
    have h := hcontr i (mem_range.mp hi)
    rw [le_div_iff₀ hpos] at h
    rw [hpow]
    calc C * (2 ^ ((d - 2) * i) * 2 ^ i) * F i = C * 2 ^ i * (F i * 2 ^ ((d - 2) * i)) := by
          ring
      _ ≤ C * 2 ^ i * F₀ := mul_le_mul_of_nonneg_left h (by positivity)
      _ = C * F₀ * 2 ^ i := by ring
  have hgeom : ∑ i ∈ range k, (2 : ℝ) ^ i = 2 ^ k - 1 := by
    rw [geom_sum_eq (by norm_num : (2 : ℝ) ≠ 1) k]; norm_num
  calc Φ ≤ s * a + ∑ i ∈ range k, C * 2 ^ ((d - 1) * i) * F i := htel
    _ ≤ s * a + ∑ i ∈ range k, C * F₀ * 2 ^ i := by linarith [sum_le_sum hterm]
    _ = s * a + C * F₀ * ∑ i ∈ range k, (2 : ℝ) ^ i := by rw [mul_sum]
    _ = s * a + C * (2 ^ k - 1) * F₀ := by rw [hgeom]; ring

/-- **The tree-gauge `ℓ¹` inequality from the local constants.** Let `d ≥ 2`,
`C_d = treeConst d c₁ c₂ c_B ≥ 0` and `F₀ ≥ 0`. If the telescoped estimate has, at level `i`,
the crossing coefficient `2d c₂ 2^{(d−1)(i+1)}` and the internal coefficient
`c₁ c_B 2^{(d−1)i}`, and the curvature contracts as `F_i ≤ 2^{−(d−2)i} F₀` for every `i < k`,
then `Φ ≤ s a + C_d (2^k − 1) F₀` and `Φ ≤ s a + C_d 2^k F₀`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem tree_l1_le {d k : ℕ} (hd : 2 ≤ d) {c₁ c₂ cB s a Φ F₀ : ℝ} (F : ℕ → ℝ)
    (hC : 0 ≤ treeConst d c₁ c₂ cB) (hF₀ : 0 ≤ F₀)
    (htel : Φ ≤ s * a + ∑ i ∈ range k,
      (2 * (d : ℝ) * c₂ * 2 ^ ((d - 1) * (i + 1)) + c₁ * cB * 2 ^ ((d - 1) * i)) * F i)
    (hcontr : ∀ i < k, F i ≤ F₀ / 2 ^ ((d - 2) * i)) :
    Φ ≤ s * a + treeConst d c₁ c₂ cB * (2 ^ k - 1) * F₀ ∧
      Φ ≤ s * a + treeConst d c₁ c₂ cB * 2 ^ k * F₀ := by
  have hcoef : ∀ i : ℕ, 2 * (d : ℝ) * c₂ * 2 ^ ((d - 1) * (i + 1)) + c₁ * cB * 2 ^ ((d - 1) * i) =
      treeConst d c₁ c₂ cB * 2 ^ ((d - 1) * i) := by
    intro i
    rw [mul_add, mul_one, pow_add]
    unfold treeConst
    ring
  have htel' : Φ ≤ s * a + ∑ i ∈ range k, treeConst d c₁ c₂ cB * 2 ^ ((d - 1) * i) * F i := by
    simpa only [hcoef] using htel
  have h1 := level_sum_bound hd F hC htel' hcontr
  refine ⟨h1, h1.trans ?_⟩
  have := mul_nonneg hC hF₀
  nlinarith

end TreeConstant

/-! ## 6. Composition -/

section Composition

variable {ρ ι γ : Type*} [Fintype ρ] [Fintype ι] [Fintype γ]

/-- **From the `ℓ¹` inequality to the loss.** If `Φ ≤ 8^k · 1 + C 2^k c` (`C ≥ 0`) and
`c/4^k ≤ κ`, then `Φ/8^k ≤ 1 + C κ`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem loss_le {k : ℕ} {Φ c C κ : ℝ} (hC : 0 ≤ C) (hB : Φ ≤ 8 ^ k * 1 + C * 2 ^ k * c)
    (hκ : c / 4 ^ k ≤ κ) : Φ / 8 ^ k ≤ 1 + C * κ := by
  have h8 : (8 : ℝ) ^ k = 2 ^ k * 4 ^ k := by rw [← mul_pow]; norm_num
  have hc : c ≤ κ * 4 ^ k := (div_le_iff₀ (by positivity)).1 hκ
  have hC2 : 0 ≤ C * 2 ^ k := mul_nonneg hC (by positivity)
  rw [div_le_iff₀ (by positivity)]
  calc Φ ≤ 8 ^ k * 1 + C * 2 ^ k * c := hB
    _ ≤ 8 ^ k * 1 + C * 2 ^ k * (κ * 4 ^ k) := by
        linarith [mul_le_mul_of_nonneg_left hc hC2]
    _ = (1 + C * κ) * 8 ^ k := by rw [h8]; ring

/-- **The one-shot loss bound.** Let `𝔐 ≥ 0`, `q ≥ 0` and `C ≥ 0`. Let `u` satisfy the weighted
energy bound in energy-norm form, `Q(e^f u) + 4^{−k}‖e^f u‖² ≤ (2𝔐)²`; let the incidence of `D`
and the weights satisfy the lattice hypotheses (rows `≤ 4`, columns `≤ 6`, `λ₀/2^k`-Lipschitz,
`λ₀ ≥ 0`, `96 λ₀² ≤ 1`, weight sum `≤ 144 (2^k/λ₀)⁴ q`); let `φ` have the same curvature as `u`
and satisfy the tree-gauge `ℓ¹` inequality `‖φ‖₁ ≤ 8^k ‖Aφ‖₁ + C 2^k ‖Dφ‖₁` with `‖Aφ‖₁ = 1`.
Then `κ := ‖Dφ‖₁/4^k ≤ √q κ_lead` and `‖φ‖₁/8^k ≤ 1 + C √q κ_lead`. Here `q` bounds the excess of
the weight sum over `144 (2^k/λ₀)⁴`. Under a shell-count hypothesis, the majorant
`q = e^{8λ₀/2^k}` is proved in `tree_gauge_loss_le`; it depends only on `λ₀` and `k` and
decreases in `k`. For the bound without `√q` see `oneShot_loss_le_lead`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem oneShot_loss_le (D : Matrix ρ ι ℝ) (A : Matrix γ ι ℝ) (φ u f : ι → ℝ) (g : ρ → ℝ)
    (k : ℕ) {M lam q C : ℝ} (hM : 0 ≤ M) (hlam : 0 ≤ lam) (hlam96 : 96 * lam ^ 2 ≤ 1)
    (hq : 0 ≤ q) (hC : 0 ≤ C)
    (hrow : ∀ p, ∑ e, |D p e| ≤ 4) (hcol : ∀ e, ∑ p, |D p e| ≤ 6)
    (hlip : ∀ p e, D p e ≠ 0 → |g p - f e| ≤ lam / 2 ^ k)
    (hW : ∑ p, Real.exp (-(2 * g p)) ≤ 144 * (2 ^ k / lam) ^ 4 * q)
    (hV : energy D (weighted f u) + sqNorm (weighted f u) / 4 ^ k ≤ (2 * M) ^ 2)
    (hcurv : D *ᵥ φ = D *ᵥ u)
    (hB : l1 φ ≤ 8 ^ k * l1 (A *ᵥ φ) + C * 2 ^ k * l1 (D *ᵥ φ))
    (hA : l1 (A *ᵥ φ) = 1) :
    l1 (D *ᵥ φ) / 4 ^ k ≤ √q * kappaLead M lam ∧
      l1 φ / 8 ^ k ≤ 1 + C * (√q * kappaLead M lam) := by
  have hE := weighted_curvature_le D f u g k hlam hlam96 hrow hcol hlip hV
  have hκ : l1 (D *ᵥ φ) / 4 ^ k ≤ √q * kappaLead M lam := by
    rw [hcurv]
    exact curvature_mass_le (D *ᵥ u) g k hM hq hW hE
  refine ⟨hκ, loss_le hC ?_ hκ⟩
  rwa [hA] at hB

/-- **The one-shot loss bound with the leading constant.** Assume the hypotheses of
`oneShot_loss_le`, except that `λ₀ ≥ 0` and `96 λ₀² ≤ 1` are replaced by `0 < λ₀ ≤ 1`, and
assume in addition `q (1 + 96 λ₀²) ≤ 2`. Then the Young form of the commutator step gives
`κ := ‖Dφ‖₁/4^k ≤ κ_lead` and `‖φ‖₁/8^k ≤ 1 + C κ_lead`, with `κ_lead = 24√2 𝔐/λ₀²` and no
excess factor.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem oneShot_loss_le_lead (D : Matrix ρ ι ℝ) (A : Matrix γ ι ℝ) (φ u f : ι → ℝ) (g : ρ → ℝ)
    (k : ℕ) {M lam q C : ℝ} (hM : 0 ≤ M) (hlam : 0 < lam) (hlam1 : lam ≤ 1)
    (hq : 0 ≤ q) (hqt : q * (1 + 96 * lam ^ 2) ≤ 2) (hC : 0 ≤ C)
    (hrow : ∀ p, ∑ e, |D p e| ≤ 4) (hcol : ∀ e, ∑ p, |D p e| ≤ 6)
    (hlip : ∀ p e, D p e ≠ 0 → |g p - f e| ≤ lam / 2 ^ k)
    (hW : ∑ p, Real.exp (-(2 * g p)) ≤ 144 * (2 ^ k / lam) ^ 4 * q)
    (hV : energy D (weighted f u) + sqNorm (weighted f u) / 4 ^ k ≤ (2 * M) ^ 2)
    (hcurv : D *ᵥ φ = D *ᵥ u)
    (hB : l1 φ ≤ 8 ^ k * l1 (A *ᵥ φ) + C * 2 ^ k * l1 (D *ᵥ φ))
    (hA : l1 (A *ᵥ φ) = 1) :
    l1 (D *ᵥ φ) / 4 ^ k ≤ kappaLead M lam ∧ l1 φ / 8 ^ k ≤ 1 + C * kappaLead M lam := by
  have hE := weighted_curvature_le_young D f u g k hlam hlam1 hrow hcol hlip hV
  have hκ : l1 (D *ᵥ φ) / 4 ^ k ≤ kappaLead M lam := by
    rw [hcurv]
    exact curvature_mass_le_lead (D *ᵥ u) g k hM hq hqt hW hE
  refine ⟨hκ, loss_le hC ?_ hκ⟩
  rwa [hA] at hB

/-- **The tree-gauge one-shot bound.** Assume:
* the hypotheses of `curvature_transfer`: the tree column `T` is admissible with `Q(T) ≤ Q(x)`
  for every admissible `x` in the tree section `G`; gauge fixing into `G` does not raise `Q`;
  `R ≥ 0`; `u` is admissible and minimises `Q + R` over the admissible points; and an admissible
  `v` has `R(v) = 0` and `Q(v) ≤ Q(T)`;
* `𝔐 ≥ 0` and the weighted energy bound for `u`, in energy-norm form;
* `0 < λ₀ ≤ 10⁻⁴` and the lattice hypotheses on the incidence (rows `≤ 4`, columns `≤ 6`), the
  weights (`λ₀/2^k`-Lipschitz) and the shell sums,
  `Σ_p e^{−2g(p)} ≤ 6 Σ_{r<R} (64 r³ + 16 r + 1) e^{−br}` with `b = 2λ₀/2^k`;
* the tree-gauge `ℓ¹` inequality for `T` with `0 ≤ C ≤ 241`, and `‖A T‖₁ = 1`.

Then
* `D T = D u`;
* `‖D T‖₁/4^k ≤ √q · κ_lead`, with the explicit majorant `q = e^{8λ₀/2^k}` of the excess of the
  weight sum; it depends only on `λ₀` and `k` and decreases in `k`;
* `‖D T‖₁/4^k ≤ κ_lead = 24√2 𝔐/λ₀²`, with no excess factor (Young form);
* `‖T‖₁/8^k ≤ 1 + 241 κ_lead`;
* `‖T‖₁/8^k ≤ 1 + 241 · 34 𝔐/λ₀²`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem tree_gauge_loss_le (D : Matrix ρ ι ℝ) (A : Matrix γ ι ℝ) (S₀ : Submodule ℝ (ι → ℝ))
    (y : γ → ℝ) (G : (ι → ℝ) → Prop) (Rpen : (ι → ℝ) → ℝ) (T u v f : ι → ℝ) (g : ρ → ℝ)
    (k R : ℕ) {M lam C : ℝ}
    (hT : T ∈ S₀ ∧ A *ᵥ T = y)
    (hTmin : ∀ x, (x ∈ S₀ ∧ A *ᵥ x = y) ∧ G x → energy D T ≤ energy D x)
    (hfix : ∀ x, x ∈ S₀ ∧ A *ᵥ x = y →
      ∃ x', ((x' ∈ S₀ ∧ A *ᵥ x' = y) ∧ G x') ∧ energy D x' ≤ energy D x)
    (hRpen : ∀ x, 0 ≤ Rpen x) (hu : u ∈ S₀ ∧ A *ᵥ u = y)
    (humin : ∀ x, x ∈ S₀ ∧ A *ᵥ x = y → energy D u + Rpen u ≤ energy D x + Rpen x)
    (hv : v ∈ S₀ ∧ A *ᵥ v = y) (hRv : Rpen v = 0) (hvT : energy D v ≤ energy D T)
    (hM : 0 ≤ M) (hV : energy D (weighted f u) + sqNorm (weighted f u) / 4 ^ k ≤ (2 * M) ^ 2)
    (hlam : 0 < lam) (hlam' : lam ≤ 1 / 10000)
    (hrow : ∀ p, ∑ e, |D p e| ≤ 4) (hcol : ∀ e, ∑ p, |D p e| ≤ 6)
    (hlip : ∀ p e, D p e ≠ 0 → |g p - f e| ≤ lam / 2 ^ k)
    (hshell : ∑ p, Real.exp (-(2 * g p)) ≤
      6 * ∑ r ∈ range R, (64 * (r : ℝ) ^ 3 + 16 * r + 1) * Real.exp (-(2 * lam / 2 ^ k)) ^ r)
    (hC0 : 0 ≤ C) (hC : C ≤ 241)
    (hB : l1 T ≤ 8 ^ k * l1 (A *ᵥ T) + C * 2 ^ k * l1 (D *ᵥ T)) (hA : l1 (A *ᵥ T) = 1) :
    D *ᵥ T = D *ᵥ u ∧
      l1 (D *ᵥ T) / 4 ^ k ≤ √(Real.exp (8 * lam / 2 ^ k)) * kappaLead M lam ∧
      l1 (D *ᵥ T) / 4 ^ k ≤ kappaLead M lam ∧
      l1 T / 8 ^ k ≤ 1 + 241 * kappaLead M lam ∧
      l1 T / 8 ^ k ≤ 1 + 241 * (34 * M / lam ^ 2) := by
  obtain ⟨hcurv, -, -, -⟩ :=
    curvature_transfer D A S₀ y G Rpen hT hTmin hfix hRpen hu humin hv hRv hvT
  have hb : 0 < 2 * lam / 2 ^ k := by positivity
  have hq_eq : Real.exp (2 * lam / 2 ^ k) ^ 4 = Real.exp (8 * lam / 2 ^ k) := by
    rw [← Real.exp_nat_mul]
    congr 1
    push_cast
    ring
  have hW : ∑ p, Real.exp (-(2 * g p)) ≤
      144 * (2 ^ k / lam) ^ 4 * Real.exp (8 * lam / 2 ^ k) := by
    calc ∑ p, Real.exp (-(2 * g p))
        ≤ 6 * ∑ r ∈ range R, (64 * (r : ℝ) ^ 3 + 16 * r + 1) *
            Real.exp (-(2 * lam / 2 ^ k)) ^ r := hshell
      _ ≤ 6 * (384 * Real.exp (2 * lam / 2 ^ k) ^ 4 / (2 * lam / 2 ^ k) ^ 4) :=
          mul_le_mul_of_nonneg_left (shell_weight_le hb R) (by norm_num)
      _ = 144 * (2 ^ k / lam) ^ 4 * Real.exp (8 * lam / 2 ^ k) := by
          rw [weight_bound_eq k hlam, hq_eq]
  have hlam96 : 96 * lam ^ 2 ≤ 1 := by nlinarith
  obtain ⟨hκ, -⟩ := oneShot_loss_le D A T u f g k hM hlam.le hlam96 (Real.exp_pos _).le hC0
    hrow hcol hlip hW hV hcurv hB hA
  have hc8' : 0 ≤ 8 * lam / 2 ^ k := by positivity
  have hc8 : 8 * lam / 2 ^ k ≤ 8 / 10000 := by
    have : 8 * lam / 2 ^ k ≤ 8 * lam := div_le_self (by positivity) (one_le_pow₀ (by norm_num))
    linarith
  have hexp8 : Real.exp (8 * lam / 2 ^ k) ≤ 1 + 2 * (8 / 10000) := by
    have h := Real.abs_exp_sub_one_le (x := 8 * lam / 2 ^ k)
      (by rw [abs_of_nonneg hc8']; linarith)
    rw [abs_of_nonneg hc8'] at h
    have := le_abs_self (Real.exp (8 * lam / 2 ^ k) - 1)
    linarith
  have hl2 : lam ^ 2 ≤ (1 / 10000) ^ 2 := pow_le_pow_left₀ hlam.le hlam' 2
  have hs : 1 + 96 * lam ^ 2 ≤ 1 + 96 * (1 / 10000) ^ 2 := by linarith
  have hqt : Real.exp (8 * lam / 2 ^ k) * (1 + 96 * lam ^ 2) ≤ 2 := by
    calc Real.exp (8 * lam / 2 ^ k) * (1 + 96 * lam ^ 2)
        ≤ (1 + 2 * (8 / 10000)) * (1 + 96 * (1 / 10000) ^ 2) :=
          mul_le_mul hexp8 hs (by positivity) (by norm_num)
      _ ≤ 2 := by norm_num
  obtain ⟨hκL, hℓL⟩ := oneShot_loss_le_lead D A T u f g k hM hlam (by linarith)
    (Real.exp_pos _).le hqt hC0 hrow hcol hlip hW hV hcurv hB hA
  have hK0 : 0 ≤ kappaLead M lam := by unfold kappaLead; positivity
  have hℓ241 : l1 T / 8 ^ k ≤ 1 + 241 * kappaLead M lam :=
    hℓL.trans (by nlinarith [mul_le_mul_of_nonneg_right hC hK0])
  have hK34 := kappaLead_le (lam := lam) hM
  exact ⟨hcurv, hκ, hκL, hℓ241, hℓ241.trans (by linarith)⟩

/-- **Numerical size of the bound.** If `𝔐 ≤ 6.34·10¹¹` and `λ₀ ≥ 3.928·10⁻²¹`, then
`1 + 241 · 34 𝔐/λ₀² ≤ 3.4·10⁵⁶`.

Scope: a statement about one proof method at Gaussian order; lattice and Fourier inputs enter only
as hypotheses; nothing about the Yang–Mills measure; the estimates (D), (E) and the mass gap remain
open. -/
theorem loss_numeric {M lam : ℝ} (hM : M ≤ 634 * 10 ^ 9) (hlam : 3928 / 10 ^ 24 ≤ lam) :
    1 + 241 * (34 * M / lam ^ 2) ≤ 34 * 10 ^ 55 := by
  have hl2 : (3928 / 10 ^ 24 : ℝ) ^ 2 ≤ lam ^ 2 := pow_le_pow_left₀ (by norm_num) hlam 2
  have h : 34 * M / lam ^ 2 ≤ 34 * (634 * 10 ^ 9) / (3928 / 10 ^ 24) ^ 2 :=
    div_le_div₀ (by norm_num) (by linarith) (by norm_num) hl2
  have h' : (1 : ℝ) + 241 * (34 * (634 * 10 ^ 9) / (3928 / 10 ^ 24) ^ 2) ≤ 34 * 10 ^ 55 := by
    norm_num
  linarith

end Composition

/-! ## 7. Non-vacuity: the hypothesis bundles on concrete data

Each example lists the hypotheses of a theorem on concrete data and then its conclusion, obtained
by applying the theorem. Its content is that the hypotheses are jointly satisfiable; it says
nothing about how sharp they are. Where a hypothesis of an applied theorem is not listed as a
conjunct, the docstring says so.

**Minimisers.** On `ℝ³`, the curvature is `F x = x₀` and the constraint is `A x = x₀ + x₁ = 8`. The
energy form is `B(x, z) = x₀ z₀`. The points `u = (0, 8, 0)` and `u' = (0, 8, 5)` are distinct
minimisers, and their difference `(0, 0, −5)` lies in `ker A ∩ ker F`. Here `Σ₀` is the whole
space and the minimum value of `Q` is `0`.

**Tree gauge.** There are two links, one plaquette and one coarse link, with `D = (1 0)`,
`A = (1/8 0)` and datum `y = 1`.
* `Σ₀` is everything, the tree section is `G = {x₁ = x₀}` and the penalty is `R(x) = x₁²/4`.
* The tree column is `T = (8, 8)`; the smooth column and the reduced tree column are
  `u = v = (8, 0)`.
* The weights are `f = g = 0`, with `k = 1`, `R = 1`, `𝔐 = 5`, `λ₀ = 10⁻⁴` and `C = 241`.
* Here `T ≠ u` but `D T = D u`. (For illustration; not part of any statement: the curvature
  mass is `‖D T‖₁/4 = 2` and the loss is `‖T‖₁/8 = 2`.)

These data are degenerate. The admissible set is the line `{x₀ = 8}`, on which `Q` and `D` are
constant; so every admissible point minimises `Q`, and `D T = D u` holds for any two admissible
points. The tree section meets the admissible set only in `T`. The weights are zero, so the
Lipschitz hypothesis holds trivially, and the weight-sum and `ℓ¹` hypotheses hold with a wide
margin. Only the penalised minimisation (`u` is the unique minimiser of `Q + R`) is not
trivial.

**Witnesses.** `witness_exp_sq_mul_kappaLead_le` takes `λ₀ = 10⁻⁴`, `k = 1`, `b = 2λ₀/2^k` and
`𝔐 = 5`. `witness_treeConst_four_le_128` takes `c₁ = 1`, `c₂ = 31/16` and `c_B = 4`, where the
bound `128` is attained.
-/

section Examples

/-- The curvature `x ↦ x₀` on `ℝ³`. -/
def exF : (Fin 3 → ℝ) →ₗ[ℝ] ℝ := LinearMap.proj 0

/-- The constraint map `x ↦ x₀ + x₁` on `ℝ³`. -/
def exA : (Fin 3 → ℝ) →ₗ[ℝ] ℝ :=
  exF + LinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℝ) 1

/-- The energy form `B(x, z) = x₀ z₀`, so that `B(x, x) = ‖exF x‖²`. -/
def exB : (Fin 3 → ℝ) →ₗ[ℝ] (Fin 3 → ℝ) →ₗ[ℝ] ℝ := (LinearMap.mul ℝ ℝ).compl₁₂ exF exF

/-- The first minimiser `(0, 8, 0)`. -/
def exU : Fin 3 → ℝ := ![0, 8, 0]

/-- The second minimiser `(0, 8, 5)`. -/
def exU' : Fin 3 → ℝ := ![0, 8, 5]

/-- `exB x z = x₀ z₀`. -/
theorem exB_apply (x z : Fin 3 → ℝ) : exB x z = x 0 * z 0 := rfl

/-- Both points are admissible: `A u = A u' = 8`. -/
theorem ex_admissible :
    (exU ∈ (⊤ : Submodule ℝ (Fin 3 → ℝ)) ∧ exA exU = 8) ∧
      (exU' ∈ (⊤ : Submodule ℝ (Fin 3 → ℝ)) ∧ exA exU' = 8) := by
  refine ⟨⟨Submodule.mem_top, ?_⟩, ⟨Submodule.mem_top, ?_⟩⟩
  · show (0 : ℝ) + 8 = 8
    norm_num
  · show (0 : ℝ) + 8 = 8
    norm_num

/-- The two minimisers are distinct. -/
theorem exU_ne : exU ≠ exU' := by
  intro h
  have h2 := congrFun h 2
  have a : exU 2 = 0 := rfl
  have b : exU' 2 = 5 := rfl
  rw [a, b] at h2
  norm_num at h2

/-- **Non-vacuity of the kernel form of the transfer.** With `Σ₀` the whole space: the form
`B(x, z) = x₀ z₀` is positive semidefinite and symmetric; `u = (0, 8, 0)` and `u' = (0, 8, 5)` are
admissible for `x₀ + x₁ = 8` and both minimise `B(x, x)` there (the minimum value is `0`). These
are the hypotheses. The next conjunct, `u ≠ u'`, is not a hypothesis; it shows that the instance
has two distinct minimisers. The last conjunct is the conclusion of `sub_mem_ker_of_minimizers`:
`B(u, u) = B(u', u')` and `u − u' ∈ Σ₀ ∩ ker A ∩ ker B`. -/
theorem example_minimizers :
    (∀ x, 0 ≤ exB x x) ∧ (∀ x z, exB x z = exB z x) ∧
    (exU ∈ (⊤ : Submodule ℝ (Fin 3 → ℝ)) ∧ exA exU = 8) ∧
    (exU' ∈ (⊤ : Submodule ℝ (Fin 3 → ℝ)) ∧ exA exU' = 8) ∧
    (∀ x ∈ (⊤ : Submodule ℝ (Fin 3 → ℝ)), exA x = 8 → exB exU exU ≤ exB x x) ∧
    (∀ x ∈ (⊤ : Submodule ℝ (Fin 3 → ℝ)), exA x = 8 → exB exU' exU' ≤ exB x x) ∧
    exU ≠ exU' ∧
    (exB exU exU = exB exU' exU' ∧
      exU - exU' ∈ (⊤ : Submodule ℝ (Fin 3 → ℝ)) ⊓ LinearMap.ker exA ⊓ LinearMap.ker exB) := by
  have hB : ∀ x, 0 ≤ exB x x := fun x => by rw [exB_apply]; exact mul_self_nonneg _
  have hsymm : ∀ x z, exB x z = exB z x := fun x z => by rw [exB_apply, exB_apply, mul_comm]
  obtain ⟨hu, hu'⟩ := ex_admissible
  have hmin : ∀ x ∈ (⊤ : Submodule ℝ (Fin 3 → ℝ)), exA x = 8 → exB exU exU ≤ exB x x :=
    fun x _ _ => by
      rw [exB_apply, exB_apply, show exU 0 = 0 from rfl, mul_zero]
      exact mul_self_nonneg _
  have hmin' : ∀ x ∈ (⊤ : Submodule ℝ (Fin 3 → ℝ)), exA x = 8 → exB exU' exU' ≤ exB x x :=
    fun x _ _ => by
      rw [exB_apply, exB_apply, show exU' 0 = 0 from rfl, mul_zero]
      exact mul_self_nonneg _
  exact ⟨hB, hsymm, hu, hu', hmin, hmin', exU_ne,
    sub_mem_ker_of_minimizers exB hB hsymm ⊤ exA 8 hu hu' hmin hmin'⟩

/-- **Non-vacuity of the curvature transfer.** With `Σ₀` the whole space and `Q = ‖F·‖²`
(`F x = x₀`, values in `ℝ`), the points `u = (0, 8, 0)` and `u' = (0, 8, 5)` are admissible for
`x₀ + x₁ = 8` and both minimise `Q` there (the minimum value is `0`). These are the hypotheses.
The next conjunct, `u ≠ u'`, is not a hypothesis; it shows that the instance has two distinct
minimisers. The last conjunct is the conclusion of `map_eq_of_minimizers`: `F u = F u'` and
`u − u' ∈ Σ₀ ∩ ker A ∩ ker F`. -/
theorem example_map_minimizers :
    (exU ∈ (⊤ : Submodule ℝ (Fin 3 → ℝ)) ∧ exA exU = 8) ∧
    (exU' ∈ (⊤ : Submodule ℝ (Fin 3 → ℝ)) ∧ exA exU' = 8) ∧
    (∀ x ∈ (⊤ : Submodule ℝ (Fin 3 → ℝ)), exA x = 8 → ‖exF exU‖ ^ 2 ≤ ‖exF x‖ ^ 2) ∧
    (∀ x ∈ (⊤ : Submodule ℝ (Fin 3 → ℝ)), exA x = 8 → ‖exF exU'‖ ^ 2 ≤ ‖exF x‖ ^ 2) ∧
    exU ≠ exU' ∧
    (exF exU = exF exU' ∧
      exU - exU' ∈ (⊤ : Submodule ℝ (Fin 3 → ℝ)) ⊓ LinearMap.ker exA ⊓ LinearMap.ker exF) := by
  obtain ⟨hu, hu'⟩ := ex_admissible
  have hmin : ∀ x ∈ (⊤ : Submodule ℝ (Fin 3 → ℝ)), exA x = 8 → ‖exF exU‖ ^ 2 ≤ ‖exF x‖ ^ 2 :=
    fun x _ _ => by
      rw [show exF exU = 0 from rfl, norm_zero, zero_pow two_ne_zero]
      positivity
  have hmin' : ∀ x ∈ (⊤ : Submodule ℝ (Fin 3 → ℝ)), exA x = 8 →
      ‖exF exU'‖ ^ 2 ≤ ‖exF x‖ ^ 2 :=
    fun x _ _ => by
      rw [show exF exU' = 0 from rfl, norm_zero, zero_pow two_ne_zero]
      positivity
  exact ⟨hu, hu', hmin, hmin', exU_ne,
    map_eq_of_minimizers exF ⊤ exA 8 hu hu' hmin hmin'⟩

/-- One plaquette, two links: `(D x)₀ = x₀`. -/
def tD : Matrix (Fin 1) (Fin 2) ℝ := !![1, 0]

/-- One coarse link: `(A x)₀ = x₀/8`. -/
def tA : Matrix (Fin 1) (Fin 2) ℝ := !![8⁻¹, 0]

/-- The coarse datum `y = 1`. -/
def tY : Fin 1 → ℝ := ![1]

/-- The tree column `T = (8, 8)`. -/
def tT : Fin 2 → ℝ := ![8, 8]

/-- The smooth column `u = (8, 0)` (also the reduced tree column). -/
def tU : Fin 2 → ℝ := ![8, 0]

/-- The tree section `G = {x₁ = x₀}`. -/
def tG (x : Fin 2 → ℝ) : Prop := x 1 = x 0

/-- The penalty `R(x) = x₁²/4`: the square of the component along `ker D ∩ ker A` (the second
coordinate), scaled by `4^{−1}`. -/
def tR (x : Fin 2 → ℝ) : ℝ := x 1 ^ 2 / 4

/-- The plaquette weight `g = 0`. -/
def tg : Fin 1 → ℝ := fun _ => 0

/-- The link weight `f = 0`. -/
def tf : Fin 2 → ℝ := fun _ => 0

/-- `D x = x₀`. -/
theorem tD_mulVec (x : Fin 2 → ℝ) : tD *ᵥ x = fun _ => x 0 := by
  funext p
  fin_cases p
  simp [tD, Matrix.mulVec, dotProduct, Fin.sum_univ_two]

/-- `A x = x₀/8`. -/
theorem tA_mulVec (x : Fin 2 → ℝ) : tA *ᵥ x = fun _ => 8⁻¹ * x 0 := by
  funext p
  fin_cases p
  simp [tA, Matrix.mulVec, dotProduct, Fin.sum_univ_two]

/-- `Q(x) = x₀²`. -/
theorem t_energy (x : Fin 2 → ℝ) : energy tD x = x 0 ^ 2 := by
  simp [energy, tD_mulVec]

/-- `A x = y` iff `x₀ = 8`. -/
theorem tA_eq_iff (x : Fin 2 → ℝ) : tA *ᵥ x = tY ↔ x 0 = 8 := by
  rw [tA_mulVec]
  constructor
  · intro h
    have h0 : 8⁻¹ * x 0 = 1 := congrFun h 0
    linarith
  · intro h
    funext p
    fin_cases p
    show 8⁻¹ * x 0 = 1
    rw [h]
    norm_num

/-- The tree column and the smooth column are distinct. -/
theorem tT_ne_tU : tT ≠ tU := by
  intro h
  have h1 := congrFun h 1
  have a : tT 1 = 8 := rfl
  have b : tU 1 = 0 := rfl
  rw [a, b] at h1
  norm_num at h1

/-- The hypotheses of the curvature transfer on the tree-gauge data, with `v = u`; the
admissibility of `v = u` is listed once. -/
theorem t_transfer_hyps :
    (tT ∈ (⊤ : Submodule ℝ (Fin 2 → ℝ)) ∧ tA *ᵥ tT = tY) ∧
    (∀ x, (x ∈ (⊤ : Submodule ℝ (Fin 2 → ℝ)) ∧ tA *ᵥ x = tY) ∧ tG x →
      energy tD tT ≤ energy tD x) ∧
    (∀ x, x ∈ (⊤ : Submodule ℝ (Fin 2 → ℝ)) ∧ tA *ᵥ x = tY →
      ∃ x', ((x' ∈ (⊤ : Submodule ℝ (Fin 2 → ℝ)) ∧ tA *ᵥ x' = tY) ∧ tG x') ∧
        energy tD x' ≤ energy tD x) ∧
    (∀ x, 0 ≤ tR x) ∧ (tU ∈ (⊤ : Submodule ℝ (Fin 2 → ℝ)) ∧ tA *ᵥ tU = tY) ∧
    (∀ x, x ∈ (⊤ : Submodule ℝ (Fin 2 → ℝ)) ∧ tA *ᵥ x = tY →
      energy tD tU + tR tU ≤ energy tD x + tR x) ∧
    tR tU = 0 ∧ energy tD tU ≤ energy tD tT := by
  refine ⟨⟨Submodule.mem_top, (tA_eq_iff tT).2 rfl⟩, ?_, ?_, fun x => by unfold tR; positivity,
    ⟨Submodule.mem_top, (tA_eq_iff tU).2 rfl⟩, ?_, ?_, ?_⟩
  · intro x hx
    rw [t_energy, t_energy, (tA_eq_iff x).1 hx.1.2]
    show (8 : ℝ) ^ 2 ≤ 8 ^ 2
    exact le_rfl
  · intro x hx
    refine ⟨![x 0, x 0], ⟨⟨Submodule.mem_top, (tA_eq_iff _).2 ((tA_eq_iff x).1 hx.2)⟩, rfl⟩, ?_⟩
    exact le_of_eq (by simp [t_energy])
  · intro x hx
    rw [t_energy, t_energy, (tA_eq_iff x).1 hx.2]
    unfold tR
    rw [show tU 0 = 8 from rfl, show tU 1 = 0 from rfl]
    nlinarith [sq_nonneg (x 1)]
  · unfold tR
    rw [show tU 1 = 0 from rfl]
    norm_num
  · exact le_of_eq (by simp [t_energy, tU, tT])

/-- The weighted energy bound on the tree-gauge data, with `f = 0`, `k = 1` and `𝔐 = 5`:
`Q(u) + ‖u‖²/4 ≤ (2 · 5)²`. (For illustration; not part of the statement: the left side is
`64 + 16 = 80`.) -/
theorem t_energy_bound :
    energy tD (weighted tf tU) + sqNorm (weighted tf tU) / 4 ^ 1 ≤ (2 * 5) ^ 2 := by
  have hw : weighted tf tU = tU := by
    funext e
    simp [weighted, tf]
  rw [hw, t_energy]
  norm_num [sqNorm, Fin.sum_univ_two, tU]

/-- The incidence and weight hypotheses on the tree-gauge data, at `λ₀ = 10⁻⁴` and `k = 1`. -/
theorem t_lattice_hyps :
    (∀ p, ∑ e, |tD p e| ≤ 4) ∧ (∀ e, ∑ p, |tD p e| ≤ 6) ∧
    (∀ p e, tD p e ≠ 0 → |tg p - tf e| ≤ 1 / 10000 / 2 ^ 1) := by
  refine ⟨fun p => ?_, fun e => ?_, fun p e _ => by norm_num [tg, tf]⟩
  · fin_cases p
    norm_num [tD, Fin.sum_univ_two]
  · fin_cases e <;> norm_num [tD]

/-- The tree-gauge `ℓ¹` inequality on the data, with `k = 1` and `C = 241`:
`‖T‖₁ ≤ 8 ‖A T‖₁ + 241 · 2 ‖D T‖₁`, and `‖A T‖₁ = 1`. (For illustration; not part of the
statement: `‖T‖₁ = 16` and `‖D T‖₁ = 8`.) -/
theorem t_l1_hyps :
    l1 tT ≤ 8 ^ 1 * l1 (tA *ᵥ tT) + 241 * 2 ^ 1 * l1 (tD *ᵥ tT) ∧ l1 (tA *ᵥ tT) = 1 := by
  rw [tA_mulVec, tD_mulVec]
  constructor <;> norm_num [l1, Fin.sum_univ_two, tT]

/-- The weight sum on the tree-gauge data, at `k = 1`, `λ₀ = 10⁻⁴` and `q = 1`: the sum over
the one plaquette, `e^0 = 1`, is at most `144 (2/λ₀)⁴`. -/
theorem t_weight_sum : ∑ p, Real.exp (-(2 * tg p)) ≤ 144 * (2 ^ 1 / (1 / 10000)) ^ 4 * 1 := by
  norm_num [tg]

/-- The tree column and the smooth column have the same curvature on the data. -/
theorem t_curv : tD *ᵥ tT = tD *ᵥ tU := by
  rw [tD_mulVec, tD_mulVec]
  rfl

/-- **Non-vacuity of the one-shot loss bound.** On the tree-gauge data (`k = 1`), with `φ = T`
and `q = 1`, the hypotheses are: `𝔐 = 5 ≥ 0`, `λ₀ = 10⁻⁴ ≥ 0`, `96 λ₀² ≤ 1`, `q ≥ 0`,
`C = 241 ≥ 0`, the incidence and Lipschitz hypotheses, the weight sum `1 ≤ 144 (2/λ₀)⁴`, the
weighted energy bound, the same curvature `D T = D u`, the `ℓ¹` inequality and `‖A T‖₁ = 1`. The
last conjunct is the conclusion of `oneShot_loss_le`. The data are degenerate in the ways listed
at the head of this section. -/
theorem example_oneShot :
    (0 : ℝ) ≤ 5 ∧ (0 : ℝ) ≤ 1 / 10000 ∧ 96 * (1 / 10000 : ℝ) ^ 2 ≤ 1 ∧ (0 : ℝ) ≤ 1 ∧
    (0 : ℝ) ≤ 241 ∧
    (∀ p, ∑ e, |tD p e| ≤ 4) ∧ (∀ e, ∑ p, |tD p e| ≤ 6) ∧
    (∀ p e, tD p e ≠ 0 → |tg p - tf e| ≤ 1 / 10000 / 2 ^ 1) ∧
    ∑ p, Real.exp (-(2 * tg p)) ≤ 144 * (2 ^ 1 / (1 / 10000)) ^ 4 * 1 ∧
    energy tD (weighted tf tU) + sqNorm (weighted tf tU) / 4 ^ 1 ≤ (2 * 5) ^ 2 ∧
    tD *ᵥ tT = tD *ᵥ tU ∧
    l1 tT ≤ 8 ^ 1 * l1 (tA *ᵥ tT) + 241 * 2 ^ 1 * l1 (tD *ᵥ tT) ∧ l1 (tA *ᵥ tT) = 1 ∧
    (l1 (tD *ᵥ tT) / 4 ^ 1 ≤ √1 * kappaLead 5 (1 / 10000) ∧
      l1 tT / 8 ^ 1 ≤ 1 + 241 * (√1 * kappaLead 5 (1 / 10000))) := by
  obtain ⟨hrow, hcol, hlip⟩ := t_lattice_hyps
  obtain ⟨hB, hA⟩ := t_l1_hyps
  exact ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num, hrow, hcol, hlip,
    t_weight_sum, t_energy_bound, t_curv, hB, hA,
    oneShot_loss_le tD tA tT tU tf tg 1 (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num) hrow hcol hlip t_weight_sum t_energy_bound t_curv hB hA⟩

/-- **Non-vacuity of the one-shot loss bound with the leading constant.** On the tree-gauge data
(`k = 1`), with `φ = T` and `q = 1`, the hypotheses are:
* `𝔐 = 5 ≥ 0`, `0 < λ₀ = 10⁻⁴ ≤ 1`, `q ≥ 0`, `q (1 + 96 λ₀²) ≤ 2`, `C = 241 ≥ 0`;
* the incidence and Lipschitz hypotheses, the weight sum, the weighted energy bound;
* the same curvature, the `ℓ¹` inequality, and `‖A T‖₁ = 1`.

The last conjunct is the conclusion of `oneShot_loss_le_lead`. The data are degenerate in the
ways listed at the head of this section. -/
theorem example_oneShot_lead :
    (0 : ℝ) ≤ 5 ∧ (0 : ℝ) < 1 / 10000 ∧ (1 / 10000 : ℝ) ≤ 1 ∧ (0 : ℝ) ≤ 1 ∧
    (1 : ℝ) * (1 + 96 * (1 / 10000) ^ 2) ≤ 2 ∧ (0 : ℝ) ≤ 241 ∧
    (∀ p, ∑ e, |tD p e| ≤ 4) ∧ (∀ e, ∑ p, |tD p e| ≤ 6) ∧
    (∀ p e, tD p e ≠ 0 → |tg p - tf e| ≤ 1 / 10000 / 2 ^ 1) ∧
    ∑ p, Real.exp (-(2 * tg p)) ≤ 144 * (2 ^ 1 / (1 / 10000)) ^ 4 * 1 ∧
    energy tD (weighted tf tU) + sqNorm (weighted tf tU) / 4 ^ 1 ≤ (2 * 5) ^ 2 ∧
    tD *ᵥ tT = tD *ᵥ tU ∧
    l1 tT ≤ 8 ^ 1 * l1 (tA *ᵥ tT) + 241 * 2 ^ 1 * l1 (tD *ᵥ tT) ∧ l1 (tA *ᵥ tT) = 1 ∧
    (l1 (tD *ᵥ tT) / 4 ^ 1 ≤ kappaLead 5 (1 / 10000) ∧
      l1 tT / 8 ^ 1 ≤ 1 + 241 * kappaLead 5 (1 / 10000)) := by
  obtain ⟨hrow, hcol, hlip⟩ := t_lattice_hyps
  obtain ⟨hB, hA⟩ := t_l1_hyps
  have hqt : (1 : ℝ) * (1 + 96 * (1 / 10000) ^ 2) ≤ 2 := by norm_num
  exact ⟨by norm_num, by norm_num, by norm_num, by norm_num, hqt, by norm_num, hrow, hcol, hlip,
    t_weight_sum, t_energy_bound, t_curv, hB, hA,
    oneShot_loss_le_lead tD tA tT tU tf tg 1 (by norm_num) (by norm_num) (by norm_num)
      (by norm_num) hqt (by norm_num) hrow hcol hlip t_weight_sum t_energy_bound t_curv hB hA⟩

/-- **Non-vacuity of the tree-gauge one-shot bound.** On the tree-gauge data (`k = 1`, `R = 1`,
`𝔐 = 5`, `λ₀ = 10⁻⁴`, `C = 241`), the hypotheses are:
* the tree column `T = (8, 8)` is admissible and minimises `Q` on the tree section, and gauge
  fixing does not raise `Q`;
* the penalty is nonnegative; `u = (8, 0)` is admissible and minimises `Q + R`;
* the reduced tree column `v = u` is admissible and has `R(v) = 0` and `Q(v) ≤ Q(T)`;
* `𝔐 = 5 ≥ 0` and the weighted energy bound;
* `0 < λ₀ ≤ 10⁻⁴`, the incidence and Lipschitz hypotheses, and the shell bound (which reads
  `1 ≤ 6` here);
* `0 ≤ C ≤ 241`, the `ℓ¹` inequality, and `‖A T‖₁ = 1`.

The last conjunct is the conclusion of `tree_gauge_loss_le`. Here `T ≠ u` (`tT_ne_tU`, not a
conjunct), so the transfer `D T = D u` is not an identity of the columns; but on these data `D` is
constant on the admissible set, so the transfer holds for any two admissible points (see the head
of this section). -/
theorem example_tree_gauge_loss :
    (tT ∈ (⊤ : Submodule ℝ (Fin 2 → ℝ)) ∧ tA *ᵥ tT = tY) ∧
    (∀ x, (x ∈ (⊤ : Submodule ℝ (Fin 2 → ℝ)) ∧ tA *ᵥ x = tY) ∧ tG x →
      energy tD tT ≤ energy tD x) ∧
    (∀ x, x ∈ (⊤ : Submodule ℝ (Fin 2 → ℝ)) ∧ tA *ᵥ x = tY →
      ∃ x', ((x' ∈ (⊤ : Submodule ℝ (Fin 2 → ℝ)) ∧ tA *ᵥ x' = tY) ∧ tG x') ∧
        energy tD x' ≤ energy tD x) ∧
    (∀ x, 0 ≤ tR x) ∧ (tU ∈ (⊤ : Submodule ℝ (Fin 2 → ℝ)) ∧ tA *ᵥ tU = tY) ∧
    (∀ x, x ∈ (⊤ : Submodule ℝ (Fin 2 → ℝ)) ∧ tA *ᵥ x = tY →
      energy tD tU + tR tU ≤ energy tD x + tR x) ∧
    (tU ∈ (⊤ : Submodule ℝ (Fin 2 → ℝ)) ∧ tA *ᵥ tU = tY) ∧ tR tU = 0 ∧
    energy tD tU ≤ energy tD tT ∧
    (0 : ℝ) ≤ 5 ∧
    energy tD (weighted tf tU) + sqNorm (weighted tf tU) / 4 ^ 1 ≤ (2 * 5) ^ 2 ∧
    (0 : ℝ) < 1 / 10000 ∧ (1 / 10000 : ℝ) ≤ 1 / 10000 ∧
    (∀ p, ∑ e, |tD p e| ≤ 4) ∧ (∀ e, ∑ p, |tD p e| ≤ 6) ∧
    (∀ p e, tD p e ≠ 0 → |tg p - tf e| ≤ 1 / 10000 / 2 ^ 1) ∧
    ∑ p, Real.exp (-(2 * tg p)) ≤
      6 * ∑ r ∈ range 1, (64 * (r : ℝ) ^ 3 + 16 * r + 1) *
        Real.exp (-(2 * (1 / 10000) / 2 ^ 1)) ^ r ∧
    (0 : ℝ) ≤ 241 ∧ (241 : ℝ) ≤ 241 ∧
    l1 tT ≤ 8 ^ 1 * l1 (tA *ᵥ tT) + 241 * 2 ^ 1 * l1 (tD *ᵥ tT) ∧ l1 (tA *ᵥ tT) = 1 ∧
    (tD *ᵥ tT = tD *ᵥ tU ∧
      l1 (tD *ᵥ tT) / 4 ^ 1 ≤ √(Real.exp (8 * (1 / 10000) / 2 ^ 1)) * kappaLead 5 (1 / 10000) ∧
      l1 (tD *ᵥ tT) / 4 ^ 1 ≤ kappaLead 5 (1 / 10000) ∧
      l1 tT / 8 ^ 1 ≤ 1 + 241 * kappaLead 5 (1 / 10000) ∧
      l1 tT / 8 ^ 1 ≤ 1 + 241 * (34 * 5 / (1 / 10000) ^ 2)) := by
  obtain ⟨hT, hTmin, hfix, hRpen, hu, humin, hRv, hvT⟩ := t_transfer_hyps
  obtain ⟨hrow, hcol, hlip⟩ := t_lattice_hyps
  obtain ⟨hB, hA⟩ := t_l1_hyps
  have hshell : ∑ p, Real.exp (-(2 * tg p)) ≤
      6 * ∑ r ∈ range 1, (64 * (r : ℝ) ^ 3 + 16 * r + 1) *
        Real.exp (-(2 * (1 / 10000) / 2 ^ 1)) ^ r := by
    norm_num [tg]
  exact ⟨hT, hTmin, hfix, hRpen, hu, humin, hu, hRv, hvT, by norm_num, t_energy_bound,
    by norm_num, le_rfl, hrow, hcol, hlip, hshell, by norm_num, le_rfl, hB, hA,
    tree_gauge_loss_le tD tA ⊤ tY tG tR tT tU tU tf tg 1 1 hT hTmin hfix hRpen hu humin hu hRv
      hvT (by norm_num) t_energy_bound (by norm_num) le_rfl hrow hcol hlip hshell (by norm_num)
      le_rfl hB hA⟩

/-- The constant curvature flux `F_i ≡ 1`. -/
def tF : ℕ → ℝ := fun _ => 1

/-- **Non-vacuity of the tree-gauge constant.** The data: dimension `d = 4`, `k = 1`, `c₁ = 1`,
`c₂ = 7/2`, `c_B = 17`, `s = 8`, `a = 1`, `F ≡ 1`, `F₀ = 1` and `Φ = 249`. The hypotheses of
`tree_l1_le` are listed first: `d ≥ 2`, `C₄ ≥ 0`, `F₀ ≥ 0`, the telescoped estimate (which reads
`249 ≤ 8 + (224 + 17)` here) and the contraction `F_i ≤ 2^{−2i} F₀` for `i < 1`; then the
hypothesis `c₂ ≤ 7/2` of
`treeConst_four_le`. The last two conjuncts are the conclusions of `tree_l1_le` and
`treeConst_four_le`. With `k = 1` the level sum has a single term. (For illustration; not part of
the statement: `C₄ = 241` here, so `Φ = 249` equals the first bound `8 + 241 (2 − 1)`.) -/
theorem example_tree_constant :
    2 ≤ 4 ∧ 0 ≤ treeConst 4 1 (7 / 2) 17 ∧ (0 : ℝ) ≤ 1 ∧
    (249 : ℝ) ≤ 8 * 1 + ∑ i ∈ range 1,
      (2 * ((4 : ℕ) : ℝ) * (7 / 2) * 2 ^ ((4 - 1) * (i + 1)) + 1 * 17 * 2 ^ ((4 - 1) * i)) *
        tF i ∧
    (∀ i < 1, tF i ≤ 1 / 2 ^ ((4 - 2) * i)) ∧ (7 / 2 : ℝ) ≤ 7 / 2 ∧
    ((249 : ℝ) ≤ 8 * 1 + treeConst 4 1 (7 / 2) 17 * (2 ^ 1 - 1) * 1 ∧
      (249 : ℝ) ≤ 8 * 1 + treeConst 4 1 (7 / 2) 17 * 2 ^ 1 * 1) ∧
    treeConst 4 1 (7 / 2) 17 ≤ 241 := by
  have hC : 0 ≤ treeConst 4 1 (7 / 2) 17 := by rw [treeConst_four]; norm_num
  have htel : (249 : ℝ) ≤ 8 * 1 + ∑ i ∈ range 1,
      (2 * ((4 : ℕ) : ℝ) * (7 / 2) * 2 ^ ((4 - 1) * (i + 1)) + 1 * 17 * 2 ^ ((4 - 1) * i)) *
        tF i := by
    norm_num [tF]
  have hcontr : ∀ i < 1, tF i ≤ 1 / 2 ^ ((4 - 2) * i) := by
    intro i hi
    obtain rfl : i = 0 := by omega
    norm_num [tF]
  exact ⟨by norm_num, hC, by norm_num, htel, hcontr, le_rfl,
    tree_l1_le (d := 4) (k := 1) (by norm_num) tF hC (by norm_num) htel hcontr,
    treeConst_four_le le_rfl⟩

/-- Eight crossing siblings: `y₀ = 3` and `y_a = 0` otherwise. -/
def tY8 : Fin 8 → ℝ := fun a => if a = 0 then 3 else 0

/-- **Non-vacuity of the local constants.** The hypotheses and conclusions, in order:
* Internal link: `s = {0} ⊆ t = Fin 3`, flux `F = (1, −2, 5)` and `a = −F_0 = −1` (hypotheses), so
  `|a| ≤ Σ |F|` (conclusion of `internal_link_le`).
* Crossing link: the siblings `(3, 0, …, 0)` satisfy `|y_a − y_{a'}| ≤ 3 · 1`, and `S = 8`,
  `S' = 0` satisfy `|S| + |S'| ≤ 8 · 1` (hypotheses, with `σ = 1`), so the parent is within `7/2`
  of `y₀` (conclusion of `crossing_link_le` at `a = 0`). -/
theorem example_local_constants :
    ({0} : Finset (Fin 3)) ⊆ Finset.univ ∧
    (-1 : ℝ) = -∑ p ∈ ({0} : Finset (Fin 3)), (![1, -2, 5] : Fin 3 → ℝ) p ∧
    |(-1 : ℝ)| ≤ ∑ p, |(![1, -2, 5] : Fin 3 → ℝ) p| ∧
    (∀ a a' : Fin 8, |tY8 a - tY8 a'| ≤ 3 * 1) ∧ |(8 : ℝ)| + |(0 : ℝ)| ≤ 8 * 1 ∧
    |tY8 0 - ((1 / 8) * ∑ a', tY8 a' + (1 / 16) * (8 + 0))| ≤ 7 / 2 * 1 := by
  have hst : ({0} : Finset (Fin 3)) ⊆ Finset.univ := Finset.subset_univ _
  have ha : (-1 : ℝ) = -∑ p ∈ ({0} : Finset (Fin 3)), (![1, -2, 5] : Fin 3 → ℝ) p := by
    simp
  have hpath : ∀ a a' : Fin 8, |tY8 a - tY8 a'| ≤ 3 * 1 := by
    intro a a'
    unfold tY8
    split_ifs <;> norm_num
  have hS : |(8 : ℝ)| + |(0 : ℝ)| ≤ 8 * 1 := by norm_num
  exact ⟨hst, ha, internal_link_le _ _ _ hst ha, hpath, hS, crossing_link_le tY8 hpath hS 0⟩

/-- **Non-vacuity of the shell bound.** At `b = 1` and `R = 3`, the hypothesis is `b = 1 > 0`, and
`shell_weight_le` gives `Σ_{r<3} (64 r³ + 16 r + 1) e^{−r} ≤ 384 e⁴/1⁴`. -/
theorem example_shell :
    (0 : ℝ) < 1 ∧
    ∑ r ∈ range 3, (64 * (r : ℝ) ^ 3 + 16 * r + 1) * Real.exp (-1) ^ r ≤
      384 * Real.exp 1 ^ 4 / 1 ^ 4 :=
  ⟨one_pos, shell_weight_le one_pos 3⟩

/-- **Non-vacuity of the numerical bounds.** At `𝔐 = 6.34·10¹¹` and `λ₀ = 3.928·10⁻²¹`, the
hypotheses `0 ≤ 𝔐`, `𝔐 ≤ 6.34·10¹¹` and `3.928·10⁻²¹ ≤ λ₀` are listed first; the data are the
boundary values, so the last two hold with equality. The conclusions are `κ_lead ≤ 34 𝔐/λ₀²`
(`kappaLead_le`), `κ_lead ≤ 1.4·10⁵⁴` (`kappaLead_numeric_le`) and
`1 + 241 · 34 𝔐/λ₀² ≤ 3.4·10⁵⁶` (`loss_numeric`). -/
theorem example_numeric :
    (0 : ℝ) ≤ 634 * 10 ^ 9 ∧ (634 * 10 ^ 9 : ℝ) ≤ 634 * 10 ^ 9 ∧
    (3928 / 10 ^ 24 : ℝ) ≤ 3928 / 10 ^ 24 ∧
    kappaLead (634 * 10 ^ 9) (3928 / 10 ^ 24) ≤ 34 * (634 * 10 ^ 9) / (3928 / 10 ^ 24) ^ 2 ∧
    kappaLead (634 * 10 ^ 9) (3928 / 10 ^ 24) ≤ 14 * 10 ^ 53 ∧
    1 + 241 * (34 * (634 * 10 ^ 9) / (3928 / 10 ^ 24) ^ 2) ≤ (34 * 10 ^ 55 : ℝ) := by
  have hM : (0 : ℝ) ≤ 634 * 10 ^ 9 := by norm_num
  exact ⟨hM, le_rfl, le_rfl, kappaLead_le hM, kappaLead_numeric_le hM le_rfl le_rfl,
    loss_numeric le_rfl le_rfl⟩

/-- **Witness for `exp_sq_mul_kappaLead_le`.** The rate `b = 2λ₀/2^k` at `λ₀ = 10⁻⁴` and `k = 1`
(so `b = 10⁻⁴`), with `𝔐 = 5`. The hypotheses `0 ≤ b`, `b ≤ 2·10⁻⁴` and `0 ≤ 𝔐` are listed
first; the last conjunct is the conclusion, `e^{2b} κ_lead ≤ 34 𝔐/λ₀²` at `λ₀ = 10⁻⁴`. The
theorem does not tie `b` to `λ₀`; the choice `b = 2λ₀/2^k` is the intended one. -/
theorem witness_exp_sq_mul_kappaLead_le :
    (0 : ℝ) ≤ 2 * (1 / 10000) / 2 ^ 1 ∧ (2 * (1 / 10000) / 2 ^ 1 : ℝ) ≤ 2 / 10000 ∧
      (0 : ℝ) ≤ 5 ∧
      Real.exp (2 * (1 / 10000) / 2 ^ 1) ^ 2 * kappaLead 5 (1 / 10000) ≤
        34 * 5 / (1 / 10000) ^ 2 := by
  have hb0 : (0 : ℝ) ≤ 2 * (1 / 10000) / 2 ^ 1 := by norm_num
  have hb : (2 * (1 / 10000) / 2 ^ 1 : ℝ) ≤ 2 / 10000 := by norm_num
  have hM : (0 : ℝ) ≤ 5 := by norm_num
  exact ⟨hb0, hb, hM, exp_sq_mul_kappaLead_le hb0 hb hM⟩

/-- **Witness for `treeConst_four_le_128`.** At `c₁ = 1`, `c₂ = 31/16` and `c_B = 4`, the
hypotheses `c₂ ≤ 31/16` and `c₁ c_B ≤ 4` hold with equality (the first two conjuncts). The third
conjunct is the conclusion, `C₄ ≤ 128`; the fourth shows that it is attained,
`C₄ = 64 · 31/16 + 4 = 128`. These local constants are hypotheses of the theorem, not the ones
proved in §5. -/
theorem witness_treeConst_four_le_128 :
    (31 / 16 : ℝ) ≤ 31 / 16 ∧ (1 : ℝ) * 4 ≤ 4 ∧ treeConst 4 1 (31 / 16) 4 ≤ 128 ∧
      treeConst 4 1 (31 / 16) 4 = 128 := by
  have hc₂ : (31 / 16 : ℝ) ≤ 31 / 16 := le_rfl
  have hcB : (1 : ℝ) * 4 ≤ 4 := by norm_num
  refine ⟨hc₂, hcB, treeConst_four_le_128 hc₂ hcB, ?_⟩
  rw [treeConst_four]
  norm_num

end Examples

