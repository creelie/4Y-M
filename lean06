/-! ## 4. Non-vacuity

Each theorem with hypotheses is applied below to closed data.
* Generic results: `A = [[2, 1], [1, 2]]` with `A − I = L diag(1, 0) Lᵀ`, `L = [[1, 0], [1, 1]]`,
  and the eigenvector `v = (1, −1)` of the eigenvalue `1`; one-dimensional blocks for the Schur
  bounds; short lists for the checkers.
* The coarse problem: the hypotheses are the validity of the turning-tree certificates,
  `turning_valid` and `turning_c0_valid`. -/

namespace NonVacuity

open Coarse

/-- The symmetric matrix `[[2, 1], [1, 2]]`, with eigenvalues `1` and `3`. -/
noncomputable def exA : Matrix (Fin 2) (Fin 2) ℝ := !![2, 1; 1, 2]

/-- The factor `L = [[1, 0], [1, 1]]`. -/
noncomputable def exL : Matrix (Fin 2) (Fin 2) ℝ := !![1, 0; 1, 1]

/-- The diagonal `(1, 0)`. -/
noncomputable def exD : Fin 2 → ℝ := ![1, 0]

/-- The eigenvector `(1, −1)`. -/
noncomputable def exV : Fin 2 → ℝ := ![1, -1]

theorem exD_nonneg : ∀ k, 0 ≤ exD k := by
  intro k
  fin_cases k <;> simp [exD]

theorem exA_ldl : exA - (1 : ℝ) • (1 : Matrix (Fin 2) (Fin 2) ℝ) = exL * diagonal exD * exLᵀ := by
  ext i j
  rw [Matrix.mul_apply, Fin.sum_univ_two]
  simp only [Matrix.mul_diagonal, transpose_apply]
  fin_cases i <;> fin_cases j <;> simp [exA, exL, exD] <;> norm_num

theorem exA_herm : exA.IsHermitian := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [exA]

theorem exV_ne : exV ≠ 0 := by
  intro h
  have := congrFun h 0
  simp [exV] at this

theorem exA_eig : exA *ᵥ exV = (1 : ℝ) • exV := by
  ext i
  fin_cases i <;> simp [exA, exV, mulVec, dotProduct, Fin.sum_univ_two] <;> norm_num

/-- `quad_nonneg_of_ldl` and `posSemidef_of_ldl` on `A − I = L diag(1, 0) Lᵀ`. -/
theorem ldl_example :
    (∀ x : Fin 2 → ℝ, 0 ≤ x ⬝ᵥ ((exA - (1 : ℝ) • 1) *ᵥ x)) ∧ (exA - (1 : ℝ) • 1).PosSemidef :=
  ⟨quad_nonneg_of_ldl exD_nonneg exA_ldl, posSemidef_of_ldl exD_nonneg exA_ldl⟩

/-- `lower_bound_of_ldl` (with `G = 1`), `lower_bound_of_ldl_one`, `le_of_eigenvector`,
`le_eigenvalues_of_quad`, `le_eigenvalues_of_ldl`, `exists_eigenvalue_le` and
`eigenvalues_min_eq` on `A = [[2, 1], [1, 2]]`, `λ = 1`, `v = (1, −1)`. -/
theorem eigen_example :
    (∀ x : Fin 2 → ℝ, 1 * (x ⬝ᵥ ((1 : Matrix (Fin 2) (Fin 2) ℝ) *ᵥ x)) ≤ x ⬝ᵥ (exA *ᵥ x)) ∧
      (∀ x : Fin 2 → ℝ, 1 * (x ⬝ᵥ x) ≤ x ⬝ᵥ (exA *ᵥ x)) ∧ (1 : ℝ) ≤ 1 ∧
      (∀ i, (1 : ℝ) ≤ exA_herm.eigenvalues i) ∧ (∀ i, (1 : ℝ) ≤ exA_herm.eigenvalues i) ∧
      (∃ i, exA_herm.eigenvalues i ≤ 1) ∧
      ((∀ i, (1 : ℝ) ≤ exA_herm.eigenvalues i) ∧ ∃ i, exA_herm.eigenvalues i = 1) :=
  ⟨lower_bound_of_ldl exD_nonneg exA_ldl, lower_bound_of_ldl_one exD_nonneg exA_ldl,
    le_of_eigenvector (lower_bound_of_ldl_one exD_nonneg exA_ldl) exV_ne exA_eig,
    le_eigenvalues_of_quad exA_herm (lower_bound_of_ldl_one exD_nonneg exA_ldl),
    le_eigenvalues_of_ldl exA_herm exD_nonneg exA_ldl,
    exists_eigenvalue_le exA_herm exV_ne (le_of_eq (by rw [exA_eig, dotProduct_smul, smul_eq_mul])),
    eigenvalues_min_eq exA_herm exD_nonneg exA_ldl exV_ne exA_eig⟩

/-- `quad_eq_sum_eigen` at `v = (1, −1)`. -/
