  | .turning => turning_c0_valid
  | .comb => comb_c0_valid

/-- **The plaquette multiplicities, turning tree.** -/
theorem mult_turning : mult .turning = ![6, 5, 6, 5, 7, 8, 7, 8, 6, 5, 6, 5, 7, 8, 7, 8] := by
  funext p
  have h := mult_eq (certOf_valid .turning) (c0Of_valid .turning) p
  have h2 : (c0Of .turning).m.getD p 0 =
      ((![6, 5, 6, 5, 7, 8, 7, 8, 6, 5, 6, 5, 7, 8, 7, 8] : Fin 16 → ℕ) p : ℤ) := by
    fin_cases p <;> rfl
  exact_mod_cast h.trans h2

/-- **The plaquette multiplicities, comb tree.** -/
theorem mult_comb : mult .comb = ![6, 7, 6, 7, 5, 8, 5, 8, 6, 7, 6, 7, 5, 8, 5, 8] := by
  funext p
  have h := mult_eq (certOf_valid .comb) (c0Of_valid .comb) p
