/-! ### The certified instance -/

/-- The certificate for each tree. -/
def certOf : Tree → Cert
  | .turning => turningCert
  | .comb => combCert

/-- **The certificate for the turning tree is valid**, checked by the kernel. -/
theorem turning_valid : turningCert.Valid .turning := by decide +kernel

/-- **The certificate for the comb tree is valid**, checked by the kernel. -/
theorem comb_valid : combCert.Valid .comb := by decide +kernel

theorem certOf_valid : ∀ t : Tree, (certOf t).Valid t
  | .turning => turning_valid
  | .comb => comb_valid

/-- **`λ_min(T|F₀) = 10/9`, for both trees.** Every eigenvalue of the restricted coarse
operator `T|F₀` is at least `10/9`, and `10/9` is an eigenvalue. -/
theorem lambdaMin_coarseOpF0 (t : Tree) :
    (∀ μ : ℝ, (coarseOpF0 t).HasEigenvalue μ → 10 / 9 ≤ μ) ∧
      (coarseOpF0 t).HasEigenvalue (10 / 9) :=
  ⟨fun _ h => le_of_hasEigenvalue (certOf_valid t) h, hasEigenvalue_ten_ninths (certOf_valid t)⟩

/-- **The lower bound** `∑_b ‖Π_{K_b} c‖² ≥ (10/9) ‖c‖²` on `F₀`, for both trees. -/
theorem coarse_lower_bound (t : Tree) (c : EuclideanSpace ℝ (Fin 16)) (hc : c ∈ F0 t) :
    10 / 9 * ‖c‖ ^ 2 ≤ ∑ b : Fin 16, ‖(Kb t b).starProjection c‖ ^ 2 :=
  lower_bound (certOf_valid t) hc

/-- **The bound is attained**, at the explicit eigenvector `c*`. -/
theorem coarse_bound_attained (t : Tree) :
    ∃ c ∈ F0 t, c ≠ 0 ∧ ∑ b : Fin 16, ‖(Kb t b).starProjection c‖ ^ 2 = 10 / 9 * ‖c‖ ^ 2 :=
  ⟨cstarV (certOf t), cstar_mem (certOf_valid t), cstar_ne_zero (certOf_valid t),
    rayleigh_cstar (certOf_valid t)⟩

/-- **`C_coarse = 9/10`, for both trees.** Every `c ∈ F₀` splits as `∑_b c_b` with
`c_b ∈ K_b` and `∑_b ‖c_b‖² ≤ (9/10) ‖c‖²`, and some nonzero `c ∈ F₀` has no splitting with
`∑_b ‖c_b‖² < (9/10) ‖c‖²`. -/
theorem coarse_splitting_constant (t : Tree) :
    (∀ c ∈ F0 t, ∃ cb : Fin 16 → EuclideanSpace ℝ (Fin 16), (∀ b : Fin 16, cb b ∈ Kb t b) ∧
        ∑ b, cb b = c ∧ ∑ b, ‖cb b‖ ^ 2 ≤ 9 / 10 * ‖c‖ ^ 2) ∧
      ∃ c ∈ F0 t, c ≠ 0 ∧ ∀ cb : Fin 16 → EuclideanSpace ℝ (Fin 16), (∀ b : Fin 16, cb b ∈ Kb t b) →
        ∑ b, cb b = c → 9 / 10 * ‖c‖ ^ 2 ≤ ∑ b, ‖cb b‖ ^ 2 :=
  ⟨fun _ hc => splitting_of_valid (certOf_valid t) hc,
    cstarV (certOf t), cstar_mem (certOf_valid t), cstar_ne_zero (certOf_valid t),
    fun cb hcb hsum => splitting_lower_cstar (certOf_valid t) cb hcb hsum⟩

/-- **The depth-0 cover is ergodic**: the sixteen curvature fibres span `F₀`. -/
theorem coarse_ergodic (t : Tree) : ⨆ b : Fin 16, Kb t b = F0 t :=
  iSup_Kb_eq (certOf_valid t)

/-- **The coarse hypothesis of the aligned-cover Poincaré argument**, on `E = F₀`:
`(10/9) ‖c‖² ≤ ∑_b ‖Π_{K_b} c‖²` for every `c ∈ F₀`, with the projections taken in `F₀`. -/
theorem aligned_cover_coarse_hypothesis (t : Tree) (c : F0 t) :
    10 / 9 * ‖c‖ ^ 2 ≤ ∑ b : Fin 16, ‖(KbF0 t b).starProjection c‖ ^ 2 := by
  have h := lower_bound (certOf_valid t) c.2
  simp only [← coe_starProjection_KbF0] at h
  exact h

/-- **The coarse splitting of the aligned-cover Poincaré argument**: the fibres `K_b ⊆ F₀` have
a stable decomposition with constant `C_coarse = 9/10`. -/
theorem aligned_cover_coarse_splitting (t : Tree) : StableDecomposition (KbF0 t) (9 / 10) := by
  intro d
  obtain ⟨cb, hcb, hsum, hle⟩ := splitting_of_valid (certOf_valid t) d.2
  refine ⟨fun b => ⟨cb b, Kb_le_F0 t b (hcb b)⟩, fun b => hcb b, Subtype.ext ?_, ?_⟩
  · rw [Submodule.coe_sum]
    exact hsum
  · simpa [Submodule.coe_norm] using hle

/-! ## 3. The depth-0 splitting constant `c₀⁽⁰⁾`

The splitting constant of the depth-0 cover is the least generalized eigenvalue of the pencil
`(A, B)` on `F₀`, with `A(c) = ∑_b ‖Π_{K_b} c‖²` and `B(c) = ∑_p m_p c_p²`, where `m_p` is the
number of boxes whose curvature fibre is nonzero at the plaquette `p`. In section coordinates
`c = E y` the two forms are `yᵀ A_E y / g` and `yᵀ B_E y`. A rational basis `Y` splits both forms
into a `2 × 2` block, whose pencil determinant is a multiple of `405 λ² − 339 λ + 50`, and a
`10 × 10` block on which `A − B/4 ⪰ 0` (an LDLᵀ certificate). The least eigenvalue is therefore
the smaller root `(113 − √3769)/270` of the quadratic. -/

/-- **The depth-0 splitting constant** `c₀⁽⁰⁾ = (113 − √3769)/270`. -/
noncomputable def c0Depth0 : ℝ := (113 - Real.sqrt 3769) / 270

/-- `c₀⁽⁰⁾` is a root of `405 λ² − 339 λ + 50`. -/
theorem c0Depth0_root : 405 * c0Depth0 ^ 2 - 339 * c0Depth0 + 50 = 0 := by
  have hs : Real.sqrt 3769 ^ 2 = 3769 := Real.sq_sqrt (by norm_num)
  unfold c0Depth0
  linear_combination (1 / 180 : ℝ) * hs

/-- `0.19114 < c₀⁽⁰⁾ < 0.19115`. -/
theorem c0Depth0_bounds : 0.19114 < c0Depth0 ∧ c0Depth0 < 0.19115 := by
  have h1 : (61.3921 : ℝ) < Real.sqrt 3769 := by
    rw [Real.lt_sqrt (by norm_num)]
    norm_num
  have h2 : Real.sqrt 3769 < 61.3922 := by
    rw [Real.sqrt_lt' (by norm_num)]
    norm_num
  unfold c0Depth0
  constructor <;> linarith

/-- The diagonal list matrix `diag(v)`. -/
def diagL (n : ℕ) (v : List ℤ) : LMat :=
  toRows n n (Matrix.of fun i j => if i = j then v.getD i 0 else 0)

theorem rM_diagL (n : ℕ) (v : List ℤ) :
    rM n n (diagL n v) = diagonal fun i : Fin n => (v.getD i 0 : ℝ) := by
  rw [diagL, rM_toRows]
  ext i j
  simp only [map_apply, of_apply, diagonal_apply]
  split_ifs <;> simp

/-- Whether row `p` of the curvature basis of box `b` is nonzero. -/
def rowNZ (C : Cert) (b p : ℕ) : Bool := (List.range 5).any fun j => (C.bx b).K.get p j != 0

/-- **The plaquette multiplicity** `m_p`: the number of boxes whose curvature fibre contains a
vector that is nonzero at the plaquette `p`. -/
noncomputable def mult (t : Tree) (p : Fin 16) : ℕ := by
  classical
  exact (univ.filter fun b : Fin 16 => ∃ c ∈ Kb t b, WithLp.ofLp c p ≠ 0).card

/-- **Certificate data for the depth-0 pencil.** -/
structure C0Cert where
  /-- the multiplicities `m_p` -/
  m : List ℤ
  /-- `diag(m) E` -/
  mE : LMat
  /-- `B_E = Eᵀ diag(m) E` -/
  Bm : LMat
  /-- `A_E = Eᵀ T_int E` -/
  Am : LMat
  /-- the block-diagonalizing basis (columns) -/
  Y : LMat
  /-- the transpose of `Y` -/
  YT : LMat
  /-- `sY Y⁻¹` -/
  Yinv : LMat
  /-- the scale of `Y⁻¹` -/
  sY : ℕ
  /-- `A_E Y` -/
  AmY : LMat
  /-- `B_E Y` -/
  BmY : LMat
  /-- `Yᵀ A_E Y`, block diagonal -/
  AY : LMat
  /-- `Yᵀ B_E Y`, block diagonal -/
  BY : LMat
  /-- `4 Yᵀ A_E Y − g Yᵀ B_E Y` on the `10 × 10` block, zero elsewhere -/
  H2 : LMat
  /-- the LDLᵀ certificate of `H2`: rows are the columns of `L` -/
  M2 : LMat
  /-- the LDLᵀ certificate of `H2`: the diagonal -/
  w2 : List ℤ
  /-- the scale of the LDLᵀ certificate -/
  sH2 : ℕ
  /-- `sE (EᵀE)⁻¹ Eᵀ`, a left inverse of `E` -/
  EL : LMat
  /-- the scale of the left inverse -/
  sE : ℕ

/-- **Validity of the pencil certificate** relative to a coarse certificate `C`. -/
abbrev C0Cert.Valid (C : Cert) (D : C0Cert) : Prop :=
  (List.range 16).all (fun p => D.m.getD p 0 ==
    ((List.finRange 16).map fun b : Fin 16 => if rowNZ C b p then (1 : ℤ) else 0).sum) = true ∧
  combCheck 16 (fun _ => true) (fun _ => true) [⟨1, 16, diagL 16 D.m, C.E⟩] 1 D.mE = true ∧
  combCheck 12 (fun _ => true) (fun _ => true) [⟨1, 16, C.ET, D.mE⟩] 1 D.Bm = true ∧
  combCheck 12 (fun _ => true) (fun _ => true) [⟨1, 16, C.ET, C.TE⟩] 1 D.Am = true ∧
  combCheck 12 (fun _ => true) (fun _ => true) [⟨1, 12, D.Y, D.Yinv⟩] D.sY (idL 12) = true ∧
  combCheck 12 (fun _ => true) (fun _ => true) [⟨1, 12, D.Yinv, D.Y⟩] D.sY (idL 12) = true ∧
  0 < D.sY ∧ transCheck 12 12 D.Y D.YT = true ∧
  combCheck 12 (fun _ => true) (fun _ => true) [⟨1, 12, D.Am, D.Y⟩] 1 D.AmY = true ∧
  combCheck 12 (fun _ => true) (fun _ => true) [⟨1, 12, D.YT, D.AmY⟩] 1 D.AY = true ∧
  combCheck 12 (fun _ => true) (fun _ => true) [⟨1, 12, D.Bm, D.Y⟩] 1 D.BmY = true ∧
  combCheck 12 (fun _ => true) (fun _ => true) [⟨1, 12, D.YT, D.BmY⟩] 1 D.BY = true ∧
  zeroCheck 12 12 (fun i => decide (i < 2)) (fun j => decide (2 ≤ j)) D.AY = true ∧
  zeroCheck 12 12 (fun i => decide (2 ≤ i)) (fun j => decide (j < 2)) D.AY = true ∧
  zeroCheck 12 12 (fun i => decide (i < 2)) (fun j => decide (2 ≤ j)) D.BY = true ∧
  zeroCheck 12 12 (fun i => decide (2 ≤ i)) (fun j => decide (j < 2)) D.BY = true ∧
  combCheck 12 (fun i => decide (2 ≤ i)) (fun j => decide (2 ≤ j))
    [⟨4, 12, D.AY, idL 12⟩, ⟨-(C.g : ℤ), 12, D.BY, idL 12⟩] 1 D.H2 = true ∧
  zeroCheck 12 12 (fun i => decide (i < 2)) (fun _ => true) D.H2 = true ∧
  zeroCheck 12 12 (fun _ => true) (fun j => decide (j < 2)) D.H2 = true ∧
  ldlCheck 12 D.sH2 D.H2 D.M2 D.w2 = true ∧ 0 < D.sH2 ∧ D.w2.all (0 ≤ ·) = true ∧
  combCheck 12 (fun _ => true) (fun _ => true) [⟨1, 16, D.EL, C.E⟩] D.sE (idL 12) = true ∧
  0 < D.sE ∧
  D.AY.get 0 1 = D.AY.get 1 0 ∧ D.BY.get 0 1 = D.BY.get 1 0 ∧
  0 < D.BY.get 0 0 ∧
  (D.BY.get 0 0 * D.BY.get 1 1 - D.BY.get 0 1 ^ 2) * (C.g : ℤ) ^ 2 * 50 =
    405 * (D.AY.get 0 0 * D.AY.get 1 1 - D.AY.get 0 1 ^ 2) ∧
  (D.AY.get 0 0 * D.BY.get 1 1 + D.AY.get 1 1 * D.BY.get 0 0 -
      2 * D.AY.get 0 1 * D.BY.get 0 1) * (C.g : ℤ) * 50 =
    339 * (D.AY.get 0 0 * D.AY.get 1 1 - D.AY.get 0 1 ^ 2) ∧
  0 < D.AY.get 0 0 * D.AY.get 1 1 - D.AY.get 0 1 ^ 2 ∧
  (C.g : ℤ) * 19115 * D.BY.get 0 0 ≤ 100000 * D.AY.get 0 0

section C0Soundness

variable {t : Tree} {C : Cert} {D : C0Cert}

/-- The multiplicities, read off the certificate. -/
theorem mult_eq (hv : C.Valid t) (hd : D.Valid C) (p : Fin 16) :
    (mult t p : ℤ) = D.m.getD p 0 := by
  have h1 := hd.1
  simp only [List.all_eq_true, List.mem_range, beq_iff_eq] at h1
  rw [h1 p p.2, ← Fin.sum_univ_def, mult, card_filter]
  push_cast
  refine sum_congr rfl fun b _ => ?_
  have key : (∃ c ∈ Kb t b, WithLp.ofLp c p ≠ 0) ↔ rowNZ C b p = true := by
    simp only [rowNZ, List.any_eq_true, List.mem_range, bne_iff_ne, ne_eq]
    constructor
    · rintro ⟨c, hc, hcp⟩
      obtain ⟨z, rfl⟩ := (mem_Kb_iff hv b c).mp hc
      by_contra hcon
      push Not at hcon
      apply hcp
      simp only [mulVec, dotProduct, rM_apply]
      exact sum_eq_zero fun j _ => by rw [hcon j j.2]; simp
    · rintro ⟨j, hj, hne⟩
      refine ⟨WithLp.toLp 2 (rM 16 5 (C.bx b).K *ᵥ Pi.single ⟨j, hj⟩ 1),
        (mem_Kb_iff hv b _).mpr ⟨_, rfl⟩, ?_⟩
      simp only [mulVec_single_one, col_apply, rM_apply]
      exact_mod_cast hne
  by_cases h : rowNZ C b p = true
  · rw [if_pos (key.mpr h), if_pos h]
  · rw [if_neg (fun h' => h (key.mp h')), if_neg h]

/-- The form `A` in section coordinates: `∑_b ‖Π_{K_b} (E y)‖² = (1/g) yᵀ A_E y`. -/
theorem formA_eq (hv : C.Valid t) (hd : D.Valid C) (y : Fin 12 → ℝ) :
    ∑ b : Fin 16, ‖(Kb t b).starProjection (WithLp.toLp 2 (rM 16 12 C.E *ᵥ y))‖ ^ 2 =
      (1 / (C.g : ℝ)) * (y ⬝ᵥ (rM 12 12 D.Am *ᵥ y)) := by
  rw [sum_norm_sq_eq hv, WithLp.ofLp_toLp]
  have hAm : rM 12 16 C.ET * rM 16 12 C.TE = rM 12 12 D.Am := by
    simpa using rM_mul_of_check hd.2.2.2.1
  have hETr : (rM 16 12 C.E)ᵀ = rM 12 16 C.ET := transpose_rM_of_check hv.2.2.2.2.2.1
  have hTEr : rM 16 16 C.Tm * rM 16 12 C.E = rM 16 12 C.TE := by
    simpa using rM_mul_of_check hv.2.2.2.2.2.2.2.2.2.1
  rw [← hAm, ← hETr, ← hTEr, ← mulVec_mulVec, ← mulVec_mulVec, dotProduct_mulVec y,
    vecMul_transpose]

/-- The form `B` in section coordinates: `∑_p m_p (E y)_p² = yᵀ B_E y`. -/
theorem formB_eq (hv : C.Valid t) (hd : D.Valid C) (y : Fin 12 → ℝ) :
    ∑ p : Fin 16, (mult t p : ℝ) * (rM 16 12 C.E *ᵥ y) p ^ 2 = y ⬝ᵥ (rM 12 12 D.Bm *ᵥ y) := by
  have hmE : rM 16 16 (diagL 16 D.m) * rM 16 12 C.E = rM 16 12 D.mE := by
    simpa using rM_mul_of_check hd.2.1
  have hBm : rM 12 16 C.ET * rM 16 12 D.mE = rM 12 12 D.Bm := by
    simpa using rM_mul_of_check hd.2.2.1
  have hETr : (rM 16 12 C.E)ᵀ = rM 12 16 C.ET := transpose_rM_of_check hv.2.2.2.2.2.1
  rw [← hBm, ← hmE, ← hETr, rM_diagL, ← mulVec_mulVec, ← mulVec_mulVec, dotProduct_mulVec y,
    vecMul_transpose]
  simp only [dotProduct, mulVec_diagonal]
  refine sum_congr rfl fun p _ => ?_
  rw [show (mult t p : ℝ) = ((mult t p : ℤ) : ℝ) by norm_cast, mult_eq hv hd p]
  ring

/-- `B_E ⪰ 0`. -/
theorem formB_nonneg (hv : C.Valid t) (hd : D.Valid C) (y : Fin 12 → ℝ) :
    0 ≤ y ⬝ᵥ (rM 12 12 D.Bm *ᵥ y) := by
  rw [← formB_eq hv hd]
  exact sum_nonneg fun p _ => mul_nonneg (Nat.cast_nonneg _) (sq_nonneg _)

/-- `Y` is invertible: `y = Y (Y⁻¹ y)`. -/
theorem Y_mulVec (hd : D.Valid C) (y : Fin 12 → ℝ) :
    rM 12 12 D.Y *ᵥ ((1 / (D.sY : ℝ)) • (rM 12 12 D.Yinv *ᵥ y)) = y := by
  have h := rM_mul_of_check (n := 12) hd.2.2.2.2.1
  rw [rM_idL] at h
  have hs : (0 : ℝ) < D.sY := by exact_mod_cast hd.2.2.2.2.2.2.1
  rw [mulVec_smul, mulVec_mulVec, h, smul_mulVec, one_mulVec, smul_smul]
  push_cast
  rw [one_div, inv_mul_cancel₀ hs.ne', one_smul]

/-- The block forms: `yᵀ A_E y = zᵀ A_Y z` and `yᵀ B_E y = zᵀ B_Y z` for `y = Y z`. -/
theorem forms_Y (hd : D.Valid C) (z : Fin 12 → ℝ) :
    (rM 12 12 D.Y *ᵥ z) ⬝ᵥ (rM 12 12 D.Am *ᵥ (rM 12 12 D.Y *ᵥ z)) =
        z ⬝ᵥ (rM 12 12 D.AY *ᵥ z) ∧
      (rM 12 12 D.Y *ᵥ z) ⬝ᵥ (rM 12 12 D.Bm *ᵥ (rM 12 12 D.Y *ᵥ z)) =
        z ⬝ᵥ (rM 12 12 D.BY *ᵥ z) := by
  obtain ⟨-, -, -, -, -, -, -, hYT, hAmY, hAY, hBmY, hBY, -⟩ := hd
  have hYTr : (rM 12 12 D.Y)ᵀ = rM 12 12 D.YT := transpose_rM_of_check hYT
  have e1 : rM 12 12 D.Am * rM 12 12 D.Y = rM 12 12 D.AmY := by
    simpa using rM_mul_of_check hAmY
  have e2 : rM 12 12 D.YT * rM 12 12 D.AmY = rM 12 12 D.AY := by
    simpa using rM_mul_of_check hAY
  have e3 : rM 12 12 D.Bm * rM 12 12 D.Y = rM 12 12 D.BmY := by
    simpa using rM_mul_of_check hBmY
  have e4 : rM 12 12 D.YT * rM 12 12 D.BmY = rM 12 12 D.BY := by
    simpa using rM_mul_of_check hBY
  constructor
  · rw [← e2, ← e1, ← hYTr, ← mulVec_mulVec, ← mulVec_mulVec, dotProduct_mulVec z,
      vecMul_transpose]
  · rw [← e4, ← e3, ← hYTr, ← mulVec_mulVec, ← mulVec_mulVec, dotProduct_mulVec z,
      vecMul_transpose]

/-- The part of `z ∈ ℝ¹²` in the first two coordinates. -/
def headPart (z : Fin 12 → ℝ) : Fin 12 → ℝ := z 0 • Pi.single 0 1 + z 1 • Pi.single 1 1

theorem headPart_apply_of_two_le (z : Fin 12 → ℝ) {i : Fin 12} (hi : 2 ≤ (i : ℕ)) :
    headPart z i = 0 := by
  have h0 : i ≠ 0 := fun h => by rw [h] at hi; simp at hi
  have h1 : i ≠ 1 := fun h => by rw [h] at hi; simp at hi
  simp [headPart, h0, h1]

theorem sub_headPart_apply_of_lt_two (z : Fin 12 → ℝ) {i : Fin 12} (hi : (i : ℕ) < 2) :
    (z - headPart z) i = 0 := by
  have : i = 0 ∨ i = 1 := by omega
  rcases this with rfl | rfl <;> simp [headPart]

/-- The quadratic form on the first two coordinates. -/
theorem quad_two (M : Matrix (Fin 12) (Fin 12) ℝ) (u v : ℝ) :
    (u • Pi.single 0 1 + v • Pi.single 1 1 : Fin 12 → ℝ) ⬝ᵥ
        (M *ᵥ (u • Pi.single 0 1 + v • Pi.single 1 1)) =
      u ^ 2 * M 0 0 + u * v * (M 0 1 + M 1 0) + v ^ 2 * M 1 1 := by
  simp only [mulVec_add, mulVec_smul, dotProduct_add, add_dotProduct, dotProduct_smul,
    smul_dotProduct, smul_eq_mul, mulVec_single_one, single_one_dotProduct, col_apply]
  ring

/-- **The block split of a quadratic form.** If `M_{ij} = 0` whenever exactly one of `i, j` is
below `2`, then `zᵀMz = z_Aᵀ M z_A + z_Bᵀ M z_B`, with `z_A` the head part and `z_B = z − z_A`. -/
theorem quad_block (M : Matrix (Fin 12) (Fin 12) ℝ)
    (hM1 : ∀ i j : Fin 12, (i : ℕ) < 2 → 2 ≤ (j : ℕ) → M i j = 0)
    (hM2 : ∀ i j : Fin 12, 2 ≤ (i : ℕ) → (j : ℕ) < 2 → M i j = 0) (z : Fin 12 → ℝ) :
    z ⬝ᵥ (M *ᵥ z) = headPart z ⬝ᵥ (M *ᵥ headPart z) +
      (z - headPart z) ⬝ᵥ (M *ᵥ (z - headPart z)) := by
  have cross : ∀ u v : Fin 12 → ℝ, (∀ i : Fin 12, 2 ≤ (i : ℕ) → u i = 0) →
      (∀ i : Fin 12, (i : ℕ) < 2 → v i = 0) → u ⬝ᵥ (M *ᵥ v) = 0 ∧ v ⬝ᵥ (M *ᵥ u) = 0 := by
    intro u v hu hv
    constructor
    · simp only [dotProduct, mulVec, mul_sum]
      refine sum_eq_zero fun i _ => sum_eq_zero fun j _ => ?_
      by_cases hi : 2 ≤ (i : ℕ)
      · rw [hu i hi]; ring
      · by_cases hj : (j : ℕ) < 2
        · rw [hv j hj]; ring
        · rw [hM1 i j (by omega) (by omega)]; ring
    · simp only [dotProduct, mulVec, mul_sum]
      refine sum_eq_zero fun i _ => sum_eq_zero fun j _ => ?_
      by_cases hi : (i : ℕ) < 2
      · rw [hv i hi]; ring
      · by_cases hj : 2 ≤ (j : ℕ)
        · rw [hu j hj]; ring
        · rw [hM2 i j (by omega) (by omega)]; ring
  obtain ⟨c1, c2⟩ := cross (headPart z) (z - headPart z)
    (fun i hi => headPart_apply_of_two_le z hi) (fun i hi => sub_headPart_apply_of_lt_two z hi)
  have hz : z = headPart z + (z - headPart z) := by abel
  conv_lhs => rw [hz]
  rw [mulVec_add, dotProduct_add, add_dotProduct, add_dotProduct, c1, c2]
  ring

/-- **The `2 × 2` block at `c₀⁽⁰⁾`.** If the pencil determinant of a `2 × 2` block is
proportional to `405 λ² − 339 λ + 50` (in `λ = s / g`) and its first diagonal ratio exceeds
`0.19115 g`, then at `s = g c₀⁽⁰⁾` the first pivot is positive and the determinant vanishes. -/
theorem block_two {a11 a12 a22 b11 b12 b22 g : ℝ} (hg : 0 < g) (hb : 0 < b11)
    (hα : (b11 * b22 - b12 ^ 2) * g ^ 2 * 50 = 405 * (a11 * a22 - a12 ^ 2))
    (hβ : (a11 * b22 + a22 * b11 - 2 * a12 * b12) * g * 50 = 339 * (a11 * a22 - a12 ^ 2))
    (hdg : g * 19115 * b11 ≤ 100000 * a11) :
    0 < a11 - g * c0Depth0 * b11 ∧
      (a11 - g * c0Depth0 * b11) * (a22 - g * c0Depth0 * b22) -
        (a12 - g * c0Depth0 * b12) ^ 2 = 0 := by
  obtain ⟨-, hc2⟩ := c0Depth0_bounds
  constructor
  · nlinarith [mul_pos hg hb]
  · have h50 : 50 * ((a11 - g * c0Depth0 * b11) * (a22 - g * c0Depth0 * b22) -
        (a12 - g * c0Depth0 * b12) ^ 2) =
        (a11 * a22 - a12 ^ 2) * (405 * c0Depth0 ^ 2 - 339 * c0Depth0 + 50) := by
      linear_combination c0Depth0 ^ 2 * hα - c0Depth0 * hβ
    rw [c0Depth0_root, mul_zero] at h50
    linarith

/-- The matrix `A_Y − s B_Y`. -/
noncomputable def pencilY (D : C0Cert) (s : ℝ) : Matrix (Fin 12) (Fin 12) ℝ :=
  rM 12 12 D.AY - s • rM 12 12 D.BY

theorem pencilY_quad (D : C0Cert) (s : ℝ) (z : Fin 12 → ℝ) :
    z ⬝ᵥ (pencilY D s *ᵥ z) = z ⬝ᵥ (rM 12 12 D.AY *ᵥ z) - s * (z ⬝ᵥ (rM 12 12 D.BY *ᵥ z)) := by
  simp only [pencilY, sub_mulVec, smul_mulVec, dotProduct_sub, dotProduct_smul, smul_eq_mul]

theorem pencilY_block (hd : D.Valid C) (s : ℝ) :
    (∀ i j : Fin 12, (i : ℕ) < 2 → 2 ≤ (j : ℕ) → pencilY D s i j = 0) ∧
      ∀ i j : Fin 12, 2 ≤ (i : ℕ) → (j : ℕ) < 2 → pencilY D s i j = 0 := by
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, hA1, hA2, hB1, hB2, -⟩ := hd
  constructor
  · intro i j hi hj
    simp only [pencilY, Matrix.sub_apply, Matrix.smul_apply, rM_apply, smul_eq_mul,
      zeroCheck_sound hA1 i.2 j.2 (by simpa using hi) (by simpa using hj),
      zeroCheck_sound hB1 i.2 j.2 (by simpa using hi) (by simpa using hj)]
    simp
  · intro i j hi hj
    simp only [pencilY, Matrix.sub_apply, Matrix.smul_apply, rM_apply, smul_eq_mul,
      zeroCheck_sound hA2 i.2 j.2 (by simpa using hi) (by simpa using hj),
      zeroCheck_sound hB2 i.2 j.2 (by simpa using hi) (by simpa using hj)]
    simp

/-- The `2 × 2` block of `A_Y − s B_Y` in terms of the certificate entries. -/
theorem pencilY_head (hd : D.Valid C) (s u v : ℝ) :
    (u • Pi.single 0 1 + v • Pi.single 1 1 : Fin 12 → ℝ) ⬝ᵥ
        (pencilY D s *ᵥ (u • Pi.single 0 1 + v • Pi.single 1 1)) =
      u ^ 2 * ((D.AY.get 0 0 : ℝ) - s * D.BY.get 0 0) +
        u * v * (((D.AY.get 0 1 : ℝ) - s * D.BY.get 0 1) +
          ((D.AY.get 0 1 : ℝ) - s * D.BY.get 0 1)) +
          v ^ 2 * ((D.AY.get 1 1 : ℝ) - s * D.BY.get 1 1) := by
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hsymA, hsymB,
    -⟩ := hd
  rw [quad_two]
  simp only [pencilY, Matrix.sub_apply, Matrix.smul_apply, rM_apply, smul_eq_mul, Fin.val_zero,
    Fin.val_one]
  rw [← hsymA, ← hsymB]

/-- The complementary `10 × 10` block: `zᵀ(A_Y − s B_Y)z ≥ 0` for `z` vanishing on the first two
coordinates and `s ≤ g/4`. -/
theorem pencilY_tail_nonneg (hv : C.Valid t) (hd : D.Valid C) {s : ℝ} (hs : 4 * s ≤ C.g)
    {z : Fin 12 → ℝ} (hz : ∀ i : Fin 12, (i : ℕ) < 2 → z i = 0) :
    0 ≤ z ⬝ᵥ (pencilY D s *ᵥ z) := by
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hH2, -, -, hldl, hsH, hw, -⟩ := id hd
  have hent : ∀ i j : Fin 12, z i * (4 * (D.AY.get i j : ℝ) - C.g * (D.BY.get i j : ℝ)) * z j =
      z i * (D.H2.get i j : ℝ) * z j := by
    intro i j
    by_cases hi : (i : ℕ) < 2
    · rw [hz i hi]; ring
    · by_cases hj : (j : ℕ) < 2
      · rw [hz j hj]; ring
      · have h := rM_mul2_entry_of_check hH2 i j (by simp; omega) (by simp; omega)
        simp only [rM_idL, Matrix.mul_one, rM_apply] at h
        push_cast at h
        have h' : (D.H2.get i j : ℝ) = 4 * (D.AY.get i j : ℝ) - C.g * (D.BY.get i j : ℝ) := by
          linarith
        rw [h']
  have hquad : ∀ M : Matrix (Fin 12) (Fin 12) ℝ,
      z ⬝ᵥ (M *ᵥ z) = ∑ i, ∑ j, z i * M i j * z j := by
    intro M
    simp only [dotProduct, mulVec, mul_sum]
    exact sum_congr rfl fun i _ => sum_congr rfl fun j _ => by ring
  have hH : z ⬝ᵥ (rM 12 12 D.H2 *ᵥ z) =
      4 * (z ⬝ᵥ (rM 12 12 D.AY *ᵥ z)) - C.g * (z ⬝ᵥ (rM 12 12 D.BY *ᵥ z)) := by
    rw [hquad, hquad, hquad, mul_sum, mul_sum, ← sum_sub_distrib]
    refine sum_congr rfl fun i _ => ?_
    rw [mul_sum, mul_sum, ← sum_sub_distrib]
    refine sum_congr rfl fun j _ => ?_
    simp only [rM_apply]
    rw [← hent i j]
    ring
  have hpsd := quad_nonneg_of_ldlCheck hldl (by exact_mod_cast hsH) (getD_nonneg hw) z
  have hB : 0 ≤ z ⬝ᵥ (rM 12 12 D.BY *ᵥ z) := by
    rw [← (forms_Y hd z).2]
    exact formB_nonneg hv hd _
  rw [pencilY_quad]
  change 0 ≤ z ⬝ᵥ (rM 12 12 D.H2 *ᵥ z) at hpsd
  rw [hH] at hpsd
  nlinarith [mul_nonneg (sub_nonneg.mpr hs) hB]

/-- **The pencil lower bound**: `g c₀⁽⁰⁾ yᵀ B_E y ≤ yᵀ A_E y` for every `y`. -/
theorem pencil_lower (hv : C.Valid t) (hd : D.Valid C) (y : Fin 12 → ℝ) :
    C.g * c0Depth0 * (y ⬝ᵥ (rM 12 12 D.Bm *ᵥ y)) ≤ y ⬝ᵥ (rM 12 12 D.Am *ᵥ y) := by
  have hd' := hd
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hb11,
    hdetα, hdetβ, -, hdiag⟩ := hd'
  have hg : (0 : ℝ) < C.g := by exact_mod_cast hv.2.2.2.2.2.2.2.1
  obtain ⟨-, hc2⟩ := c0Depth0_bounds
  obtain ⟨z, rfl⟩ : ∃ z, rM 12 12 D.Y *ᵥ z = y := ⟨_, Y_mulVec hd y⟩
  rw [(forms_Y hd z).1, (forms_Y hd z).2]
  set s := (C.g : ℝ) * c0Depth0 with hsdef
  obtain ⟨hM1, hM2⟩ := pencilY_block hd s
  have key := quad_block _ hM1 hM2 z
  have hhead : 0 ≤ headPart z ⬝ᵥ (pencilY D s *ᵥ headPart z) := by
    rw [headPart, pencilY_head hd]
    obtain ⟨hp, hdet⟩ := block_two (a11 := (D.AY.get 0 0 : ℝ)) (a12 := (D.AY.get 0 1 : ℝ))
      (a22 := (D.AY.get 1 1 : ℝ)) (b11 := (D.BY.get 0 0 : ℝ)) (b12 := (D.BY.get 0 1 : ℝ))
      (b22 := (D.BY.get 1 1 : ℝ)) hg
      (by exact_mod_cast hb11) (by exact_mod_cast hdetα) (by exact_mod_cast hdetβ)
      (by exact_mod_cast hdiag)
    rw [← hsdef] at hp hdet
    have hq := sq_nonneg (((D.AY.get 0 0 : ℝ) - s * D.BY.get 0 0) * z 0 +
      ((D.AY.get 0 1 : ℝ) - s * D.BY.get 0 1) * z 1)
    have : 0 ≤ ((D.AY.get 0 0 : ℝ) - s * D.BY.get 0 0) * (z 0 ^ 2 *
        ((D.AY.get 0 0 : ℝ) - s * D.BY.get 0 0) + z 0 * z 1 * (((D.AY.get 0 1 : ℝ) -
        s * D.BY.get 0 1) + ((D.AY.get 0 1 : ℝ) - s * D.BY.get 0 1)) +
        z 1 ^ 2 * ((D.AY.get 1 1 : ℝ) - s * D.BY.get 1 1)) := by
      nlinarith
    exact nonneg_of_mul_nonneg_right this hp
  have htail := pencilY_tail_nonneg hv hd (s := s) (by rw [hsdef]; nlinarith)
    (z := z - headPart z) (fun i hi => sub_headPart_apply_of_lt_two z hi)
  have hall : 0 ≤ z ⬝ᵥ (pencilY D s *ᵥ z) := by
    rw [key]
    exact add_nonneg hhead htail
  rw [pencilY_quad] at hall
  linarith

/-- **The pencil bound is attained**: some `y` with `E y ≠ 0` has `yᵀ A_E y = g c₀⁽⁰⁾ yᵀ B_E y`. -/
theorem pencil_attained (hv : C.Valid t) (hd : D.Valid C) :
    ∃ y : Fin 12 → ℝ, rM 16 12 C.E *ᵥ y ≠ 0 ∧
      y ⬝ᵥ (rM 12 12 D.Am *ᵥ y) = C.g * c0Depth0 * (y ⬝ᵥ (rM 12 12 D.Bm *ᵥ y)) := by
  have hd' := hd
  obtain ⟨-, -, -, -, -, hYinv, hsY, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hEL, hsE, -, -,
    hb11, hdetα, hdetβ, -, hdiag⟩ := hd'
  have hg : (0 : ℝ) < C.g := by exact_mod_cast hv.2.2.2.2.2.2.2.1
  obtain ⟨s, hsdef⟩ : ∃ s : ℝ, s = C.g * c0Depth0 := ⟨_, rfl⟩
  obtain ⟨hp, hdet⟩ := block_two (a11 := (D.AY.get 0 0 : ℝ)) (a12 := (D.AY.get 0 1 : ℝ))
    (a22 := (D.AY.get 1 1 : ℝ)) (b11 := (D.BY.get 0 0 : ℝ)) (b12 := (D.BY.get 0 1 : ℝ))
    (b22 := (D.BY.get 1 1 : ℝ)) hg
    (by exact_mod_cast hb11) (by exact_mod_cast hdetα) (by exact_mod_cast hdetβ)
    (by exact_mod_cast hdiag)
  rw [← hsdef] at hp hdet
  obtain ⟨p, hpdef⟩ : ∃ p : ℝ, p = (D.AY.get 0 0 : ℝ) - s * D.BY.get 0 0 := ⟨_, rfl⟩
  obtain ⟨q, hqdef⟩ : ∃ q : ℝ, q = (D.AY.get 0 1 : ℝ) - s * D.BY.get 0 1 := ⟨_, rfl⟩
  obtain ⟨r, hrdef⟩ : ∃ r : ℝ, r = (D.AY.get 1 1 : ℝ) - s * D.BY.get 1 1 := ⟨_, rfl⟩
  rw [← hpdef] at hp
  rw [← hpdef, ← hqdef, ← hrdef] at hdet
  obtain ⟨zs, hzs⟩ : ∃ zs : Fin 12 → ℝ, zs = (-q) • Pi.single 0 1 + p • Pi.single 1 1 :=
    ⟨_, rfl⟩
  refine ⟨rM 12 12 D.Y *ᵥ zs, ?_, ?_⟩
  · intro h0
    have hEL' := rM_mul_of_check (n := 12) hEL
    rw [rM_idL] at hEL'
    have hY' := rM_mul_of_check (n := 12) hYinv
    rw [rM_idL] at hY'
    have h1 : (rM 12 16 D.EL * rM 16 12 C.E) *ᵥ (rM 12 12 D.Y *ᵥ zs) = 0 := by
      rw [← mulVec_mulVec, h0, mulVec_zero]
    rw [hEL', smul_mulVec, one_mulVec, smul_eq_zero] at h1
    have h2 : rM 12 12 D.Y *ᵥ zs = 0 := h1.resolve_left (by exact_mod_cast hsE.ne')
    have h3 : (rM 12 12 D.Yinv * rM 12 12 D.Y) *ᵥ zs = 0 := by
      rw [← mulVec_mulVec, h2, mulVec_zero]
    rw [hY', smul_mulVec, one_mulVec, smul_eq_zero] at h3
    have h4 : zs = 0 := h3.resolve_left (by exact_mod_cast hsY.ne')
    have h5 := congrFun h4 1
    rw [hzs] at h5
    simp at h5
    linarith
  · rw [(forms_Y hd zs).1, (forms_Y hd zs).2, ← hsdef]
    have hval : zs ⬝ᵥ (pencilY D s *ᵥ zs) = 0 := by
      rw [hzs, pencilY_head hd, ← hpdef, ← hqdef, ← hrdef]
      have e : (-q) ^ 2 * p + -q * p * (q + q) + p ^ 2 * r = p * (p * r - q ^ 2) := by ring
      rw [e, hdet, mul_zero]
    rw [pencilY_quad] at hval
    linarith

/-- **`c₀⁽⁰⁾` is the least eigenvalue of the depth-0 pencil.** -/
theorem c0_of_valid (hv : C.Valid t) (hd : D.Valid C) :
    (∀ c ∈ F0 t, c0Depth0 * ∑ p : Fin 16, (mult t p : ℝ) * WithLp.ofLp c p ^ 2 ≤
        ∑ b : Fin 16, ‖(Kb t b).starProjection c‖ ^ 2) ∧
      ∃ c ∈ F0 t, c ≠ 0 ∧ ∑ b : Fin 16, ‖(Kb t b).starProjection c‖ ^ 2 =
        c0Depth0 * ∑ p : Fin 16, (mult t p : ℝ) * WithLp.ofLp c p ^ 2 := by
  have hg : (0 : ℝ) < C.g := by exact_mod_cast hv.2.2.2.2.2.2.2.1
  constructor
  · intro c hc
    obtain ⟨y, rfl⟩ := (mem_F0_iff hv c).mp hc
    rw [formA_eq hv hd, WithLp.ofLp_toLp, formB_eq hv hd]
    have h := pencil_lower hv hd y
    rw [one_div, inv_mul_eq_div, le_div_iff₀ hg]
    linarith
  · obtain ⟨y, hy0, hy⟩ := pencil_attained hv hd
    refine ⟨WithLp.toLp 2 (rM 16 12 C.E *ᵥ y), (mem_F0_iff hv _).mpr ⟨y, rfl⟩, ?_, ?_⟩
    · intro h
      apply hy0
      have := congrArg WithLp.ofLp h
      simpa using this
    · rw [formA_eq hv hd, WithLp.ofLp_toLp, formB_eq hv hd, hy]
      field_simp

end C0Soundness

/-! ### Pencil certificate data: the turning tree -/

/-- `diag(m) E`. -/
def turningmE : LMat :=
  [[-6, -12, 0, 0, 0, -12, 0, 0, 0, 0, 0, 0],
   [0, 5, 0, -10, 0, 5, 0, 0, 0, 0, 0, 0],
