  exact_mod_cast h.trans h2

/-- **`c₀⁽⁰⁾ = (113 − √3769)/270` is the depth-0 splitting constant, for both trees.** On `F₀`,
`c₀⁽⁰⁾ ∑_p m_p c_p² ≤ ∑_b ‖Π_{K_b} c‖²`, with equality at some `c ≠ 0`. So `c₀⁽⁰⁾` is the least
eigenvalue of the pencil `(A, B)`, a root of `405 λ² − 339 λ + 50` (`c0Depth0_root`). -/
theorem c0Depth0_lambdaMin (t : Tree) :
    (∀ c ∈ F0 t, c0Depth0 * ∑ p : Fin 16, (mult t p : ℝ) * WithLp.ofLp c p ^ 2 ≤
        ∑ b : Fin 16, ‖(Kb t b).starProjection c‖ ^ 2) ∧
      ∃ c ∈ F0 t, c ≠ 0 ∧ ∑ b : Fin 16, ‖(Kb t b).starProjection c‖ ^ 2 =
        c0Depth0 * ∑ p : Fin 16, (mult t p : ℝ) * WithLp.ofLp c p ^ 2 :=
  c0_of_valid (certOf_valid t) (c0Of_valid t)

