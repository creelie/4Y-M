  have h1 : (rho k * Real.sqrt 3) ^ 2 = 3 * rho k ^ 2 := by rw [mul_pow, sqrt_three_sq]; ring
  have h2 : 0 < rho k * Real.sqrt 3 := mul_pos (rho_pos k) sqrt_three_pos
  nlinarith [rho_sq_gt k]

/-- `2√3 < 3ρ_k`, i.e. `ρ_k > 2/√3` once more, in the form without division. -/
lemma two_sqrt_three_lt (k : ℕ) : 2 * Real.sqrt 3 < 3 * rho k := by
  have h : rho k * Real.sqrt 3 * Real.sqrt 3 = 3 * rho k := by
    rw [mul_assoc, Real.mul_self_sqrt (by norm_num)]; ring
  nlinarith [mul_lt_mul_of_pos_right (rho_mul_sqrt_three_gt k) sqrt_three_pos]

/-- **`ρ_k > ρ_∞ = 2/√3` for every `k`.** -/
theorem rho_gt (k : ℕ) : 2 / Real.sqrt 3 < rho k := by
  rw [div_lt_iff₀ sqrt_three_pos]; exact rho_mul_sqrt_three_gt k

/-- **`ρ_k` is strictly decreasing.** -/
theorem rho_strictAnti : StrictAnti rho := by
  refine strictAnti_nat_of_succ_lt fun k => ?_
  unfold rho
  apply Real.sqrt_lt_sqrt (by positivity)
  have := quarter_pow_succ_lt k
  linarith

/-- `ρ₀ = √2`. -/
theorem rho_zero : rho 0 = Real.sqrt 2 := by norm_num [rho]

/-- `ρ₁ = √6/2`. -/
theorem rho_one : rho 1 = Real.sqrt 6 / 2 := by
  unfold rho
  rw [show ((4 : ℝ) + 2 * (1 / 4) ^ 1) / 3 = (Real.sqrt 6 / 2) ^ 2 by
    rw [div_pow (Real.sqrt 6) 2 2, sqrt_six_sq]; norm_num]
  exact Real.sqrt_sq (by positivity)

/-- `√(4/3) = 2/√3`, the value of `ρ_∞`. -/
lemma sqrt_four_thirds : Real.sqrt ((4 + 2 * 0) / 3) = 2 / Real.sqrt 3 := by
  rw [show ((4 : ℝ) + 2 * 0) / 3 = (2 / Real.sqrt 3) ^ 2 by rw [div_pow, sqrt_three_sq]; norm_num]
  exact Real.sqrt_sq (by positivity)

/-- **`ρ_k → 2/√3`** as `k → ∞`. -/
theorem rho_tendsto : Tendsto rho atTop (𝓝 (2 / Real.sqrt 3)) := by
  have h0 : Tendsto (fun k : ℕ => (1 / 4 : ℝ) ^ k) atTop (𝓝 0) :=
    tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)
  have h1 : Tendsto (fun k : ℕ => (4 + 2 * (1 / 4 : ℝ) ^ k) / 3) atTop
      (𝓝 ((4 + 2 * 0) / 3)) :=
    (tendsto_const_nhds.add (tendsto_const_nhds.mul h0)).div_const 3
  rw [← sqrt_four_thirds]
  exact h1.sqrt

/-! ## 2. The gradient constant `μ_k` -/

/-- The **gradient constant** `μ_k = 1 + 1/ρ_k` (the constant "κ" that must stay below 2). Here
it is the closed form only; that it equals the optimal constant `sup_z ‖∇R_k z‖₁/‖∇z‖₁` of the
1D Gaussian toy chain is analytic and not formalised (one composition method at Gaussian order;
nothing about Yang–Mills). -/
noncomputable def mu (k : ℕ) : ℝ := 1 + 1 / rho k

lemma mu_pos (k : ℕ) : 0 < mu k := by unfold mu; have := rho_pos k; positivity

/-- **`μ_k < 1 + √3/2`** for every `k`: the supremum `1 + √3/2` is never attained. -/
theorem mu_lt_sup (k : ℕ) : mu k < 1 + Real.sqrt 3 / 2 := by
  unfold mu
  have : 1 / rho k < Real.sqrt 3 / 2 := by
    rw [div_lt_div_iff₀ (rho_pos k) (by norm_num)]; linarith [rho_mul_sqrt_three_gt k]
  linarith

/-- **`μ_k < 2` for every `k`**: the gradient constant stays below the threshold 2 at every
scale. -/
theorem mu_lt_two (k : ℕ) : mu k < 2 := by
  have := mu_lt_sup k; linarith [sqrt_three_lt_two]

/-- **`μ_k` is strictly increasing.** -/
theorem mu_strictMono : StrictMono mu := by
  refine strictMono_nat_of_lt_succ fun k => ?_
  unfold mu
  have := one_div_lt_one_div_of_lt (rho_pos (k + 1)) (rho_strictAnti (Nat.lt_succ_self k))
  linarith

/-- `μ_k` is increasing (monotone). -/
theorem mu_monotone : Monotone mu := mu_strictMono.monotone

/-- **`μ_k → 1 + √3/2`** as `k → ∞`. -/
theorem mu_tendsto : Tendsto mu atTop (𝓝 (1 + Real.sqrt 3 / 2)) := by
  have h : Tendsto (fun k => 1 + 1 / rho k) atTop (𝓝 (1 + 1 / (2 / Real.sqrt 3))) :=
    tendsto_const_nhds.add (tendsto_const_nhds.div rho_tendsto (by positivity))
  rw [one_div_div] at h
  exact h

/-- `μ₀ = 1 + √2/2` (the exact value of the gradient constant at `k = 0`). -/
theorem mu_zero : mu 0 = 1 + Real.sqrt 2 / 2 := by
  unfold mu
  rw [rho_zero]
  congr 1
  rw [div_eq_div_iff (ne_of_gt sqrt_two_pos) (by norm_num)]
  nlinarith [Real.mul_self_sqrt (show (0 : ℝ) ≤ 2 by norm_num)]

/-- `μ₁ = 1 + √6/3`. -/
theorem mu_one : mu 1 = 1 + Real.sqrt 6 / 3 := by
  unfold mu
  rw [rho_one, one_div_div]
  congr 1
  rw [div_eq_div_iff (ne_of_gt (Real.sqrt_pos.2 (by norm_num))) (by norm_num)]
  nlinarith [Real.mul_self_sqrt (show (0 : ℝ) ≤ 6 by norm_num)]

/-! ## 3. The value constant `τ_k` and `γ_k = 1 + τ_k` -/

/-- The **value constant** `τ_k = 2/(ρ_k(2 + ρ_k))` (the optimal `κ₀` of
`‖R_k y‖₁ ≤ 2‖y‖₁ + τ_k ‖∇y‖₁`, attained at `y = e_w`). Closed form only; the identification
with the optimal constant is analytic and not formalised. 1D Gaussian toy chain; nothing about
Yang–Mills. -/
noncomputable def tau (k : ℕ) : ℝ := 2 / (rho k * (2 + rho k))

/-- `γ_k = 1 + 2/(ρ_k(2 + ρ_k))`: the closed form of the 1D per-scale factor
`γ_k = ‖R_k e_w‖₁/2` of the site-additive class (Proposition C). The identification with
`‖R_k e_w‖₁/2` is analytic and not formalised. -/
noncomputable def gamma (k : ℕ) : ℝ := 1 + 2 / (rho k * (2 + rho k))

lemma gamma_eq (k : ℕ) : gamma k = 1 + tau k := rfl

/-- **`τ_k = γ_k − 1`.** -/
theorem tau_eq_gamma_sub_one (k : ℕ) : tau k = gamma k - 1 := by rw [gamma_eq]; ring

lemma den_pos (k : ℕ) : 0 < rho k * (2 + rho k) := by have := rho_pos k; positivity

lemma den_gt_three (k : ℕ) : 3 < rho k * (2 + rho k) := by nlinarith [one_lt_rho k]

lemma den_lt_six (k : ℕ) : rho k * (2 + rho k) < 6 := by
  nlinarith [rho_lt_three_halves k, rho_pos k]

lemma den_strictAnti : StrictAnti fun k => rho k * (2 + rho k) := by
  refine strictAnti_nat_of_succ_lt fun k => ?_
  have h := rho_strictAnti (Nat.lt_succ_self k)
  have := rho_pos (k + 1)
  show rho (k + 1) * (2 + rho (k + 1)) < rho k * (2 + rho k)
  nlinarith

lemma tau_pos (k : ℕ) : 0 < tau k := div_pos (by norm_num) (den_pos k)

lemma tau_lt_one (k : ℕ) : tau k < 1 := by
  unfold tau; rw [div_lt_one (den_pos k)]; linarith [den_gt_three k]

lemma tau_gt_third (k : ℕ) : 1 / 3 < tau k := by
  unfold tau; rw [lt_div_iff₀ (den_pos k)]; linarith [den_lt_six k]

lemma gamma_pos (k : ℕ) : 0 < gamma k := by rw [gamma_eq]; linarith [tau_pos k]

/-- `τ_k` is strictly increasing. -/
theorem tau_strictMono : StrictMono tau := by
  refine strictMono_nat_of_lt_succ fun k => ?_
  unfold tau
  exact div_lt_div_of_pos_left (by norm_num) (den_pos (k + 1))
    (den_strictAnti (Nat.lt_succ_self k))

/-- **`γ_k` is strictly increasing** (`γ_k` increases from `√2`). -/
theorem gamma_strictMono : StrictMono gamma := by
  intro i j hij
  rw [gamma_eq, gamma_eq]
  linarith [tau_strictMono hij]

/-- `τ_k < τ_∞ = 3(√3 − 1)/4` for every `k`. -/
theorem tau_lt_lim (k : ℕ) : tau k < 3 * (Real.sqrt 3 - 1) / 4 := by
  set s := Real.sqrt 3 with hs_def
  have hs : s ^ 2 = 3 := sqrt_three_sq
  have hρ := rho_pos k
  have ht := rho_mul_sqrt_three_gt k
  have key : 3 * (s - 1) * (rho k * (2 + rho k)) - 8
      = (rho k * s - 2) * ((s - 1) * (rho k * s) + 4) := by
    linear_combination (2 * rho k - (s - 1) * rho k ^ 2) * hs
  have hpos : 0 < (rho k * s - 2) * ((s - 1) * (rho k * s) + 4) := by
    apply mul_pos (by linarith)
    have : 0 < s - 1 := by linarith [one_lt_sqrt_three]
    have : 0 < rho k * s := by positivity
    positivity
  unfold tau
  rw [div_lt_div_iff₀ (den_pos k) (by norm_num)]
  nlinarith

/-- **`γ_k < γ_∞ = (1 + 3√3)/4`** for every `k`. -/
theorem gamma_lt_lim (k : ℕ) : gamma k < (1 + 3 * Real.sqrt 3) / 4 := by
  rw [gamma_eq]; linarith [tau_lt_lim k]

/-- The value of `τ` at `ρ_∞ = 2/√3`: `2/(ρ_∞(2 + ρ_∞)) = 3(√3 − 1)/4`. -/
lemma tau_at_lim :
    2 / (2 / Real.sqrt 3 * (2 + 2 / Real.sqrt 3)) = 3 * (Real.sqrt 3 - 1) / 4 := by
  set s := Real.sqrt 3 with hs_def
  have hs : s ^ 2 = 3 := sqrt_three_sq
  have hs0 : 0 < s := sqrt_three_pos
  have h2s : 2 / s = 2 * s / 3 := by
    rw [div_eq_div_iff (ne_of_gt hs0) (by norm_num)]; nlinarith
  rw [h2s, div_eq_div_iff (by positivity) (by norm_num)]
  linear_combination (-(8 / 3 + 4 * s / 3)) * hs

/-- **`τ_k → 3(√3 − 1)/4`** as `k → ∞`. -/
theorem tau_tendsto : Tendsto tau atTop (𝓝 (3 * (Real.sqrt 3 - 1) / 4)) := by
  have h : Tendsto (fun k => 2 / (rho k * (2 + rho k))) atTop
      (𝓝 (2 / (2 / Real.sqrt 3 * (2 + 2 / Real.sqrt 3)))) :=
    tendsto_const_nhds.div (rho_tendsto.mul (tendsto_const_nhds.add rho_tendsto))
      (by positivity)
  rw [tau_at_lim] at h
  exact h

/-- **`γ_k → (1 + 3√3)/4`** as `k → ∞`. -/
theorem gamma_tendsto : Tendsto gamma atTop (𝓝 ((1 + 3 * Real.sqrt 3) / 4)) := by
  have h := (tendsto_const_nhds (x := (1 : ℝ))).add tau_tendsto
  rw [show (1 : ℝ) + 3 * (Real.sqrt 3 - 1) / 4 = (1 + 3 * Real.sqrt 3) / 4 by ring] at h
  exact h

/-- `τ₀ = √2 − 1` (the exact optimal `κ₀` at `k = 0`). -/
theorem tau_zero : tau 0 = Real.sqrt 2 - 1 := by
  unfold tau
  rw [rho_zero, div_eq_iff (ne_of_gt (by rw [← rho_zero]; exact den_pos 0))]
  linear_combination (-(Real.sqrt 2 + 1)) * sqrt_two_sq

/-- **`γ₀ = √2`** (the exact infinite-chain value). -/
theorem gamma_zero : gamma 0 = Real.sqrt 2 := by rw [gamma_eq, tau_zero]; ring

/-- `τ₁ = (8√6 − 12)/15`. -/
theorem tau_one : tau 1 = (8 * Real.sqrt 6 - 12) / 15 := by
  unfold tau
  rw [rho_one, div_eq_div_iff (ne_of_gt (by rw [← rho_one]; exact den_pos 1)) (by norm_num)]
  linear_combination (-(2 * Real.sqrt 6 + 5)) * sqrt_six_sq

/-- `γ₁ = (3 + 8√6)/15`. -/
theorem gamma_one : gamma 1 = (3 + 8 * Real.sqrt 6) / 15 := by rw [gamma_eq, tau_one]; ring

/-- `γ_k ≥ √2` for every `k`. -/
theorem gamma_ge_sqrt_two (k : ℕ) : Real.sqrt 2 ≤ gamma k :=
  gamma_zero ▸ gamma_strictMono.monotone (Nat.zero_le k)

/-! ## 4. The kernel parameters of `R_k` and the identities between the constants -/

/-- `p_k = |q_k| = (2 − ρ_k)/(2 + ρ_k)`. -/
noncomputable def pRoot (k : ℕ) : ℝ := (2 - rho k) / (2 + rho k)

/-- The geometric ratio `q_k = −(2 − ρ_k)/(2 + ρ_k)` of the kernel of `R_k`. -/
noncomputable def qRoot (k : ℕ) : ℝ := -pRoot k

/-- The kernel amplitude `a_k = 1/(2(2 + ρ_k))` of `R_k`. -/
noncomputable def aAmp (k : ℕ) : ℝ := 1 / (2 * (2 + rho k))

lemma pRoot_pos (k : ℕ) : 0 < pRoot k := by
  unfold pRoot; have := rho_lt_three_halves k; have := rho_pos k
  exact div_pos (by linarith) (by linarith)

lemma pRoot_lt_one (k : ℕ) : pRoot k < 1 := by
  unfold pRoot; have := rho_pos k
  rw [div_lt_one (by linarith)]; linarith

lemma one_sub_pRoot (k : ℕ) : 1 - pRoot k = 2 * rho k / (2 + rho k) := by
  unfold pRoot; have := rho_pos k
  field_simp; ring

/-- `q₀ = −3 + 2√2`, the Green-function root at `k = 0`. -/
theorem qRoot_zero : qRoot 0 = -3 + 2 * Real.sqrt 2 := by
  unfold qRoot pRoot
  rw [rho_zero, neg_eq_iff_eq_neg, div_eq_iff (by linarith [sqrt_two_pos])]
  linear_combination (2 : ℝ) * sqrt_two_sq

/-- `τ_k = (1 + p_k)/(2ρ_k)` (the value constant in terms of the kernel parameter `p_k`). -/
theorem tau_eq_kernel (k : ℕ) : tau k = (1 + pRoot k) / (2 * rho k) := by
  unfold tau pRoot; have := rho_pos k
  field_simp; ring

/-- `μ_k = 1 + 4a_k/(1 − p_k)` (in kernel form: `μ = d_{−1} + 2Σ|d_y| = 1 + 4a/(1 − p)`). -/
theorem mu_eq_kernel (k : ℕ) : mu k = 1 + 4 * aAmp k / (1 - pRoot k) := by
  rw [one_sub_pRoot]; unfold mu aAmp; have := rho_pos k
  field_simp; ring

/-- `γ_k = μ_k − 2a_k` (at `n = 1`: `g₁ = μ − Δ₁` with `Δ₁ = 2a`). -/
theorem gamma_eq_mu_sub (k : ℕ) : gamma k = mu k - 2 * aAmp k := by
  unfold gamma mu aAmp; have := rho_pos k
  field_simp; ring

/-- `(1 − p_k)/(2ρ_k · 2a_k) = 1` (the normalisation used in the threshold rule of `betaThr`). -/
theorem threshold_identity (k : ℕ) : (1 - pRoot k) / (2 * rho k * (2 * aAmp k)) = 1 := by
  rw [one_sub_pRoot]; unfold aAmp; have := rho_pos k
  field_simp

/-- The odd-`n` thresholds of the threshold rule: `n = 2m + 1` beats `φ_∞` iff
`β < β*_m(k) := p_k^{m+1}/((1 + p_k) − 2p_k^{m+1})`. The threshold rule itself is analytic and
not formalised; only the numbers are. -/
noncomputable def betaThr (k m : ℕ) : ℝ :=
  pRoot k ^ (m + 1) / ((1 + pRoot k) - 2 * pRoot k ^ (m + 1))

/-- `β*₀(k) = p_k/(1 − p_k) = 1/ρ_k − 1/2`. -/
theorem betaThr_zero (k : ℕ) : betaThr k 0 = 1 / rho k - 1 / 2 := by
  unfold betaThr
  rw [zero_add, pow_one, show (1 + pRoot k) - 2 * pRoot k = 1 - pRoot k by ring,
    one_sub_pRoot]
  unfold pRoot; have := rho_pos k
  field_simp

/-! ## 5. The optimal chain `β_k` -/

/-- The **minimal chain with `ã ≡ 1`** (no value loss; called the "optimal chain"),
`N_k = 2^k(‖·‖₁ + β_k‖∇·‖₁)`:
* `β₀ = 0`;
* `β₁ = (√2 − 1)/2` (`= F₀(0)/2 = τ₀/2`);
* `β₂ = (τ₁ + γ₁β₁)/2` (`= φ₁(β₁)/2`: at `k = 1` the single site `n = 1` is the argmax);
* `β_{k+1} = (1/(2ρ_k) + (1 + 1/ρ_k)β_k)/2` for `k ≥ 2` (`= φ_∞(β_k)/2`).

Here `β` is *defined* by this recursion. That it is the minimal admissible coefficient
`β_{k+1} = F_k(β_k)/2` is analytic (the threshold rule and the optimal-chain analysis), not
formalised.
1D Gaussian toy chain; one composition method at Gaussian order; nothing about Yang–Mills. -/
noncomputable def beta : ℕ → ℝ
  | 0 => 0
  | 1 => (Real.sqrt 2 - 1) / 2
  | 2 => (tau 1 + gamma 1 * ((Real.sqrt 2 - 1) / 2)) / 2
  | k + 3 => (1 / (2 * rho (k + 2)) + mu (k + 2) * beta (k + 2)) / 2

/-- The scale-`k` map of the recursion, `f_k(β) = (1/(2ρ_k) + μ_kβ)/2 = φ_∞(β)/2`. -/
noncomputable def step (k : ℕ) (b : ℝ) : ℝ := (1 / (2 * rho k) + mu k * b) / 2

/-- The fixed point `φ*_k = 1/(2(ρ_k − 1))` of the scale-`k` map. -/
noncomputable def fixedPt (k : ℕ) : ℝ := 1 / (2 * (rho k - 1))

theorem beta_zero : beta 0 = 0 := rfl

theorem beta_one : beta 1 = (Real.sqrt 2 - 1) / 2 := rfl

theorem beta_two_eq : beta 2 = (tau 1 + gamma 1 * beta 1) / 2 := rfl

theorem beta_add_three (k : ℕ) :
    beta (k + 3) = (1 / (2 * rho (k + 2)) + mu (k + 2) * beta (k + 2)) / 2 := rfl

/-- The recursion for `k ≥ 2`: `β_{k+1} = (1/(2ρ_k) + (1 + 1/ρ_k)β_k)/2`. -/
theorem beta_succ (k : ℕ) (hk : 2 ≤ k) :
    beta (k + 1) = (1 / (2 * rho k) + mu k * beta k) / 2 := by
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 2 := ⟨k - 2, by omega⟩
  exact beta_add_three j

theorem beta_succ_eq_step (k : ℕ) (hk : 2 ≤ k) : beta (k + 1) = step k (beta k) :=
  beta_succ k hk

/-- The initial value `β₁` is the `k = 0` step of the single-site branch:
`β₁ = (τ₀ + γ₀β₀)/2 = τ₀/2`. -/
theorem beta_one_eq_step : beta 1 = (tau 0 + gamma 0 * beta 0) / 2 := by
  rw [beta_one, tau_zero, beta_zero]; ring

/-- `β₂ = (8√6 + 16√3 + 3√2 − 27)/60 ≈ 0.409190`. -/
theorem beta_two : beta 2 =
    (8 * Real.sqrt 6 + 16 * Real.sqrt 3 + 3 * Real.sqrt 2 - 27) / 60 := by
  rw [beta_two_eq, tau_one, gamma_one, beta_one, sqrt_six_eq]
  linear_combination (2 * Real.sqrt 3 / 15) * sqrt_two_sq

/-- `f_k(φ*_k) = φ*_k`: `φ*_k` is the fixed point of the scale-`k` map. -/
theorem step_fixedPt (k : ℕ) : step k (fixedPt k) = fixedPt k := by
  unfold step fixedPt mu
  have h1 := rho_pos k
  have h2 : rho k - 1 ≠ 0 := ne_of_gt (by linarith [one_lt_rho k])
  field_simp
  ring

/-- `4ρ_k β_{k+1} = 1 + 2(ρ_k + 1)β_k` for `k ≥ 2` (the recursion without division). -/
lemma beta_succ_mul (k : ℕ) (hk : 2 ≤ k) :
    4 * rho k * beta (k + 1) = 1 + 2 * (rho k + 1) * beta k := by
  rw [beta_succ k hk]; unfold mu; have := rho_pos k
  field_simp; ring

lemma beta_one_gt : 1 / 5 < beta 1 := by rw [beta_one]; linarith [sqrt_two_gt]

lemma beta_one_lt : beta 1 < 1 / 4 := by rw [beta_one]; linarith [sqrt_two_lt_three_halves]

lemma beta_two_lt_one : beta 2 < 1 := by
  rw [beta_two_eq]
  have h1 := tau_lt_one 1
  have h2 := beta_one_lt
  have h3 := beta_one_gt
  have h4 : gamma 1 < 2 := by rw [gamma_eq]; linarith
  have h5 := gamma_pos 1
  nlinarith

/-- `β_k ≥ 0` for every `k`. -/
theorem beta_nonneg : ∀ k, 0 ≤ beta k
  | 0 => by rw [beta_zero]
  | 1 => by have := beta_one_gt; linarith
  | 2 => by
      rw [beta_two_eq]
      have := beta_one_gt
      nlinarith [tau_pos 1, gamma_pos 1]
  | k + 3 => by
      rw [beta_add_three]
      have h1 := beta_nonneg (k + 2)
      have h2 : 0 ≤ 1 / (2 * rho (k + 2)) := by have := rho_pos (k + 2); positivity
      have h3 : 0 ≤ mu (k + 2) * beta (k + 2) := mul_nonneg (mu_pos _).le h1
      linarith

/-- **The invariant** `2(ρ_k − 1)β_k < 1`, i.e. `β_k < φ*_k`, for every `k ≥ 2`
(by induction: base case `β₂ < φ*₂`, and `β_k ≤ φ*_k ⇒ β_{k+1} ≤ φ*_k ≤ φ*_{k+1}`
because the scale map has slope `μ_k/2 > 0` and fixed point `φ*_k`, and `ρ_k` decreases). -/
theorem beta_invariant (k : ℕ) (hk : 2 ≤ k) : 2 * (rho k - 1) * beta k < 1 := by
  induction k, hk using Nat.le_induction with
  | base =>
    have h1 := rho_lt_three_halves 2
    have h2 := one_lt_rho 2
    have h3 := beta_two_lt_one
    have h4 := beta_nonneg 2
    nlinarith
  | succ k hk ih =>
    have hrec := beta_succ_mul k hk
    have hρ := rho_pos k
    have hanti : rho (k + 1) < rho k := rho_strictAnti (Nat.lt_succ_self k)
    have hnn := beta_nonneg (k + 1)
    have key : 2 * (rho k - 1) * (4 * rho k * beta (k + 1)) < 4 * rho k := by
      rw [hrec]
      nlinarith [mul_lt_mul_of_pos_left ih (by linarith : (0 : ℝ) < 2 * (rho k + 1))]
    have hstep : 2 * (rho k - 1) * beta (k + 1) < 1 := by nlinarith
    have hmono : (rho (k + 1) - 1) * beta (k + 1) ≤ (rho k - 1) * beta (k + 1) :=
      mul_le_mul_of_nonneg_right (by linarith) hnn
    linarith

/-- **`β_k < φ*_k = 1/(2(ρ_k − 1))`** for every `k ≥ 2`. -/
theorem beta_lt_fixedPt (k : ℕ) (hk : 2 ≤ k) : beta k < fixedPt k := by
  unfold fixedPt
  have := one_lt_rho k
  rw [lt_div_iff₀ (by linarith)]
  linarith [beta_invariant k hk]

/-- `1 < 2(ρ_k − 1)(3/2 + √3)`: the limit fixed point `3/2 + √3 = 1/(2(2/√3 − 1))` lies strictly
above every scale fixed point. -/
lemma fixedPoint_gap (k : ℕ) : 1 < 2 * (rho k - 1) * (3 / 2 + Real.sqrt 3) := by
  nlinarith [rho_mul_sqrt_three_gt k, two_sqrt_three_lt k]

/-- `φ*_k < 3/2 + √3` for every `k`. -/
theorem fixedPt_lt (k : ℕ) : fixedPt k < 3 / 2 + Real.sqrt 3 := by
  unfold fixedPt
  have := one_lt_rho k
  rw [div_lt_iff₀ (by linarith)]
  linarith [fixedPoint_gap k]

/-- `φ*_k` is strictly increasing (because `ρ_k` is strictly decreasing). -/
theorem fixedPt_strictMono : StrictMono fixedPt := by
  intro i j hij
  unfold fixedPt
  have := rho_strictAnti hij
  have := one_lt_rho j
  exact one_div_lt_one_div_of_lt (by linarith) (by linarith)

/-- **`β_k < 3/2 + √3` for every `k`.** For `k ≥ 2` this is the
invariant `2(ρ_k − 1)β_k < 1` together with `2(ρ_k − 1)(3/2 + √3) > 1`; the latter says that
the fixed point of each scale map lies below the limit fixed point `3/2 + √3`, using
`ρ_k > 2/√3`. -/
theorem beta_lt (k : ℕ) : beta k < 3 / 2 + Real.sqrt 3 := by
  have hs := sqrt_three_pos
  rcases lt_or_ge k 2 with hk | hk
  · interval_cases k
    · rw [beta_zero]; linarith
    · linarith [beta_one_lt]
  · have hinv := beta_invariant k hk
    have hgap := fixedPoint_gap k
    have hρ := one_lt_rho k
    by_contra hcon
    replace hcon := not_lt.1 hcon
    nlinarith [mul_le_mul_of_nonneg_left hcon (by linarith : (0 : ℝ) ≤ 2 * (rho k - 1))]

/-- `β_k < β_{k+1}` for every `k`. -/
theorem beta_lt_succ (k : ℕ) : beta k < beta (k + 1) := by
  match k with
  | 0 => rw [beta_zero]; exact lt_trans (by norm_num) beta_one_gt
  | 1 =>
    show beta 1 < beta 2
    rw [beta_two_eq, gamma_eq]
    have h1 := tau_gt_third 1
    have h2 := beta_one_lt
    have h3 := beta_one_gt
    nlinarith
  | k + 2 =>
    have hrec := beta_succ_mul (k + 2) (by omega)
    have ih := beta_invariant (k + 2) (by omega)
    have hρ := rho_pos (k + 2)
    nlinarith

/-- **`β_k` is strictly increasing.** -/
theorem beta_strictMono : StrictMono beta := strictMono_nat_of_lt_succ beta_lt_succ

/-- `β_k` is increasing (monotone). -/
theorem beta_monotone : Monotone beta := beta_strictMono.monotone

/-- **`β_k → 3/2 + √3`**: the bound of `beta_lt` is the limit, so it
cannot be lowered. Proof: `β` is increasing and bounded, so it converges to some `ℓ`; passing to
the limit in the recursion (`ρ_k → 2/√3`, `μ_k → 1 + √3/2`) gives
`ℓ = (√3/4 + (1 + √3/2)ℓ)/2`, whose only solution is `3/2 + √3`. -/
theorem beta_tendsto : Tendsto beta atTop (𝓝 (3 / 2 + Real.sqrt 3)) := by
  have hbdd : BddAbove (Set.range beta) :=
    ⟨3 / 2 + Real.sqrt 3, by rintro _ ⟨k, rfl⟩; exact (beta_lt k).le⟩
  have hlim : Tendsto beta atTop (𝓝 (⨆ k, beta k)) := tendsto_atTop_ciSup beta_monotone hbdd
  set ℓ := ⨆ k, beta k with hℓ
  have hb2 : Tendsto (fun k => beta (k + 2)) atTop (𝓝 ℓ) := (tendsto_add_atTop_iff_nat 2).2 hlim
  have hb3 : Tendsto (fun k => beta (k + 3)) atTop (𝓝 ℓ) := (tendsto_add_atTop_iff_nat 3).2 hlim
  have hρ2 : Tendsto (fun k => rho (k + 2)) atTop (𝓝 (2 / Real.sqrt 3)) :=
    (tendsto_add_atTop_iff_nat 2).2 rho_tendsto
  have hμ2 : Tendsto (fun k => mu (k + 2)) atTop (𝓝 (1 + Real.sqrt 3 / 2)) :=
    (tendsto_add_atTop_iff_nat 2).2 mu_tendsto
  have hrhs : Tendsto (fun k => (1 / (2 * rho (k + 2)) + mu (k + 2) * beta (k + 2)) / 2) atTop
      (𝓝 ((1 / (2 * (2 / Real.sqrt 3)) + (1 + Real.sqrt 3 / 2) * ℓ) / 2)) :=
    ((tendsto_const_nhds.div (tendsto_const_nhds.mul hρ2) (by positivity)).add
      (hμ2.mul hb2)).div_const 2
  have heq : ℓ = (1 / (2 * (2 / Real.sqrt 3)) + (1 + Real.sqrt 3 / 2) * ℓ) / 2 :=
    tendsto_nhds_unique hb3 (hrhs.congr fun k => (beta_add_three k).symm)
  have hs := sqrt_three_sq
  have hs0 := sqrt_three_pos
  have h1 : 1 / (2 * (2 / Real.sqrt 3)) = Real.sqrt 3 / 4 := by field_simp; ring
  rw [h1] at heq
  have hprod : (ℓ - (3 / 2 + Real.sqrt 3)) * (2 - Real.sqrt 3) = 0 := by
    linear_combination 4 * heq + hs
  have hℓv : ℓ = 3 / 2 + Real.sqrt 3 := by
    rcases mul_eq_zero.1 hprod with h | h
    · linarith
    · linarith [sqrt_three_lt_two]
  rw [← hℓv]
  exact hlim

/-! ## 6. Bounded loss -/

/-- **Bounded loss (`theta_bound`).** The bounded-loss bound of the optimal chain is
`Θ_k ≤ 1 + 2β_k < 4 + 2√3` for every `k`. This theorem proves the arithmetic part,
`1 + 2β_k < 4 + 2√3`, for every `k`.

Meaning. `Θ_k := sup_{y ≠ 0} N_k(y)/‖T_k y‖₁` is the overestimate of a scale-`k` component by the
chain norm `N_k = 2^k(‖·‖₁ + β_k‖∇·‖₁)`, and `1 + 2β_k` is the analytic upper bound for it. So
this bounds the **composite-norm loss of the chain**: it compares the iterated bound
`Σ_k N_k(a^{(k)})` built from the chain with the exact-composite iterated bound
`Σ_k ‖T_k a^{(k)}‖₁`. It does **not** bound the loss against the true response
`‖Σ_k T_k a^{(k)}‖₁`; the cross-scale triangle inequality
`‖Σ_k T_k a^{(k)}‖₁ ≤ Σ_k ‖T_k a^{(k)}‖₁` is untouched by the choice of per-scale norm. The
inequality `Θ_k ≤ 1 + 2β_k`, and the identification of `β_k` with the minimal admissible chain,
are analytic and not formalised.
1D Gaussian toy chain; one composition method at Gaussian order; nothing about Yang–Mills. -/
theorem theta_bound (k : ℕ) : 1 + 2 * beta k < 4 + 2 * Real.sqrt 3 := by
  linarith [beta_lt k]

/-- The bound `4 + 2√3` of `theta_bound` is the limit of `1 + 2β_k`, hence the least constant
that bounds `1 + 2β_k` uniformly in `k`. This says nothing about `Θ_k` itself, whose exact value
is open: the analytic argument gives only `Θ_k ≤ 1 + 2β_k`, and the `e₀` test gives an observed
lower bound `≈ 4.70` (a numerical observation, not a proof). -/
theorem theta_tendsto :
    Tendsto (fun k => 1 + 2 * beta k) atTop (𝓝 (4 + 2 * Real.sqrt 3)) := by
  have h := (tendsto_const_nhds (x := (1 : ℝ))).add
    ((tendsto_const_nhds (x := (2 : ℝ))).mul beta_tendsto)
  rw [show (1 : ℝ) + 2 * (3 / 2 + Real.sqrt 3) = 4 + 2 * Real.sqrt 3 by ring] at h
  exact h

/-! ## 7. The branch inequalities at `k = 1` and for `k ≥ 2` -/

/-- **`k = 1` window** (numerically `0.0514 < 0.2071 < 0.3165`): `β*₁(1) < β₁ < β*₀(1)`. By the
threshold rule (see `betaThr`; analytic, not formalised) this makes the single site `n = 1` the
argmax at `k = 1`, hence `β₂ = (τ₁ + γ₁β₁)/2`. -/
theorem beta_one_window : betaThr 1 1 < beta 1 ∧ beta 1 < betaThr 1 0 := by
  have hρ1 : rho 1 ^ 2 = 3 / 2 := by rw [rho_sq]; norm_num
  have hρpos := rho_pos 1
  constructor
  · -- `p₁ < 1/4` because `ρ₁ > 6/5`; then `β*₁(1) < 1/14 < 1/5 < β₁`.
    have hρ65 : 6 / 5 < rho 1 := by nlinarith
    have hp0 := pRoot_pos 1
    have hp : pRoot 1 < 1 / 4 := by
      unfold pRoot; rw [div_lt_iff₀ (by linarith)]; linarith
    have hp2 : pRoot 1 ^ 2 < 1 / 16 := by nlinarith
    have hden : 0 < (1 + pRoot 1) - 2 * pRoot 1 ^ 2 := by linarith
    have hthr : betaThr 1 1 < 1 / 5 := by
      show pRoot 1 ^ 2 / ((1 + pRoot 1) - 2 * pRoot 1 ^ 2) < 1 / 5
      rw [div_lt_iff₀ hden]
      linarith
    linarith [beta_one_gt]
  · -- `β*₀(1) = 1/ρ₁ − 1/2`, and `ρ₁ < ρ₀ = √2` gives `1/ρ₁ > √2/2`.
    rw [betaThr_zero, beta_one]
    have hlt : rho 1 < Real.sqrt 2 := rho_zero ▸ rho_strictAnti (show 0 < 1 by norm_num)
    have : Real.sqrt 2 / 2 < 1 / rho 1 := by
      rw [div_lt_div_iff₀ (by norm_num) hρpos]
      nlinarith [sqrt_two_sq, sqrt_two_pos]
    linarith

/-- `β₂ > (√3 − 1)/2`. -/
theorem beta_two_gt : (Real.sqrt 3 - 1) / 2 < beta 2 := by
  rw [beta_two, sqrt_six_eq]
  have h2 := sqrt_two_gt
  have h3 := sqrt_three_gt
  have h3' := sqrt_three_lt
  nlinarith [mul_pos (by linarith : (0 : ℝ) < Real.sqrt 2 - 1.4)
    (by linarith : (0 : ℝ) < Real.sqrt 3 - 1.7)]

/-- **`k ≥ 2`: `β_k > β*₀(k)`**: `β*₀(k) = 1/ρ_k − 1/2 < (√3 − 1)/2 < β₂ ≤ β_k`. By the threshold
rule (see `betaThr`; analytic, not formalised) this puts every `k ≥ 2` on the `φ_∞` branch,
i.e. `β_{k+1} = (1/(2ρ_k) + μ_kβ_k)/2`, the recursion used in `beta`. -/
theorem beta_gt_threshold (k : ℕ) (hk : 2 ≤ k) : betaThr k 0 < beta k := by
  rw [betaThr_zero]
  have h1 : 1 / rho k < Real.sqrt 3 / 2 := by
    rw [div_lt_div_iff₀ (rho_pos k) (by norm_num)]; linarith [rho_mul_sqrt_three_gt k]
  have h2 := beta_two_gt
  have h3 := beta_monotone hk
  linarith

/-! ## 8. The site-additive contrast: `∏_{i<k} γ_i ≥ (√2)^k` -/

/-- **`∏_{i<k} γ_i ≥ (√2)^k`**: the site-additive class loses at least `(√2)^k` on constant
components, because `γ_i ≥ γ₀ = √2` for every `i`. The identification of `γ_i` with the per-scale
factor `‖R_i e_w‖₁/2` of Proposition C, and of the product with the additive-class loss `ω_k(1)`,
is analytic and not formalised. 1D Gaussian toy chain; nothing about
Yang–Mills. -/
theorem gamma_prod_ge (k : ℕ) : Real.sqrt 2 ^ k ≤ ∏ i ∈ Finset.range k, gamma i := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [Finset.prod_range_succ, pow_succ]
    exact mul_le_mul ih (gamma_ge_sqrt_two k) (Real.sqrt_nonneg 2)
      (le_trans (by positivity) ih)

/-- `∏_{i<k} γ_i → ∞`: geometric growth of the site-additive loss. -/
theorem gamma_prod_tendsto :
    Tendsto (fun k => ∏ i ∈ Finset.range k, gamma i) atTop atTop :=
  tendsto_atTop_mono gamma_prod_ge (tendsto_pow_atTop_atTop_of_one_lt one_lt_sqrt_two)

/-- **Bounded versus geometric**: the value-plus-gradient chain's loss bound
`1 + 2β_k` stays below `4 + 2√3` at every scale, while the site-additive product `∏_{i<k} γ_i` is
at least `(√2)^k` and tends to infinity. Both statements are about the closed-form constants of
the 1D Gaussian toy chain; their identification with the actual losses is analytic (not
formalised), and the first compares with the exact-composite iterated bound, not
with the true response. One composition method at Gaussian order; nothing about Yang–Mills. -/
theorem bounded_versus_geometric :
    (∀ k, 1 + 2 * beta k < 4 + 2 * Real.sqrt 3) ∧
    (∀ k, Real.sqrt 2 ^ k ≤ ∏ i ∈ Finset.range k, gamma i) ∧
    Tendsto (fun k => ∏ i ∈ Finset.range k, gamma i) atTop atTop :=
  ⟨theta_bound, gamma_prod_ge, gamma_prod_tendsto⟩

