/-! # Part 2: the local-cost comparison (Lemma LC) -/
section Part2_LocalCostComparison

/-!
# Lemma LC: the local-cost comparison, arithmetic half

Lemma LC generalises the Dobrushin–Shlosman comparison from a per-site cost to a cost that is a
**sum of local terms**. This part proves the arithmetic half of Lemma LC. It follows the per-site
version `CouplingMinimality` (a separate Lean development, not imported here): couplings are the
points of an abstract type `P`, and the minimal coupling and its block updates are abstract
points of `P`. This part needs only Mathlib and re-proves what it uses.

"The full lemma" below means Lemma LC as stated for couplings of probability measures (the
minimal coupling `π*`, the block couplings `π_x`, expectations `E_π`); that measure-theoretic
setting is not formalised here.

**Setting.**
* `β` is a finite type of blocks `x`, and `τ` a finite type of cost terms `t`.
* `T x : Finset τ` is the touched set `T_x`: the terms that block `x` touches.
* `mult T t = m_t = #{x : t ∈ T_x}` is the multiplicity of `t`.
* `w t ≥ 0` are the term weights, and `ρ p t ≥ 0` is the term profile of the point `p : P`
  (in the full lemma, `ρ_t = E_π φ_t`).
* The cost is `Ψ(p) = ∑_t w_t ρ_t(p)` (`cost`; it is `CouplingMinimality.cost` with the terms
  as index type).
* `A : Finset β` is the set of admissible blocks (in the full lemma, `V_x ∩ S = ∅`), and
  `S : Finset τ` is a set of terms containing every `T_x` with `x ∉ A`. The set
  `𝒮 = ⋃_{x ∉ A} T_x` is the smallest choice.

**Contents.**
* `cost_update_block`: a block update changes only the touched summands.
* `recurrence_with_error_block`, `recurrence_of_block_minimality`: minimality of `p` against a
  block update gives the block recurrence (the block-recurrence step).
* `block_recurrence_of_approx`: the same from ε-optimal block updates, letting ε → 0.
* `comparison_of_block_recurrence`: the counting step, from the block recurrences.
* `local_cost_comparison_summed`: Lemma LC from the weakest form (Σ_w) (the block-recurrence and
  counting steps).
* `sigma_w_of_column`: the column condition in θ bounds the summed right side of (H1), which
  gives (Σ_w).
* `local_cost_comparison`: Lemma LC under (H1)–(H3), with θ as a parameter.
* `local_cost_uniqueness`: the case `S = ∅`, where the profile vanishes.
* `weighted_column_of_H3`: (H3) with constant α and the weight ratio `w̄_x ≤ L w_s` give the
  column condition in θ with `θ = α L` (in the full lemma `L = e^{λR}`: the weight-ratio step).
* `site_additive_comparison`, `site_additive_comparison_of_local`: one term per site, touched
  only by its own block, recovers `CouplingMinimality.comparison_of_minimality`.
* `Example`: a non-vacuity instance for `local_cost_comparison` (3 blocks, 3 terms, every term
  touched by two blocks, α = 3/8, θ = 3/4, far side 1/4 > 0). The same data also instantiate
  the block-recurrence, (Σ_w), counting and uniqueness bundles.
* `SiteExample`: a non-vacuity instance for both site-additive theorems.

This is an arithmetic statement about the comparison method; the measure-theoretic half
(existence of block-minimal couplings, (H1) for gauge fields) is not proved here. In forest
gauges (H1) meets an obstruction, which is not formalised here either.
-/

open Finset

namespace YangMills.StrongCoupling.LocalCostComparison

section General

variable {β τ P : Type*} [Fintype β] [Fintype τ] [DecidableEq τ]

/-- **Multiplicity.** `mult T t = m_t = #{x : t ∈ T_x}`, the number of blocks that touch the
term `t`. -/
def mult (T : β → Finset τ) (t : τ) : ℕ := (univ.filter fun x => t ∈ T x).card

/-- **The cost of an abstract coupling.** `Ψ_w(p) = ∑_t w_t ρ_t(p)`, the weighted sum of its term
profile. This is `CouplingMinimality.cost` with the cost terms as index type. -/
def cost (w : τ → ℝ) (ρ : P → τ → ℝ) (p : P) : ℝ := ∑ t, w t * ρ p t

omit [Fintype β] in
/-- **A block update changes the cost only on the touched terms** (the block form of
`CouplingMinimality.cost_update`). If `q` agrees with `p` on every term that block `x` does not
touch, `ρ_t(q) = ρ_t(p)` for `t ∉ T_x`, then
`Ψ(q) = Ψ(p) + ∑_{t ∈ T_x} w_t (ρ_t(q) − ρ_t(p))`.
This is the block-recurrence step of the proof of Lemma LC. -/
theorem cost_update_block (w : τ → ℝ) (ρ : P → τ → ℝ) (p q : P) (T : β → Finset τ) (x : β)
    (hfix : ∀ t ∉ T x, ρ q t = ρ p t) :
    cost w ρ q = cost w ρ p + ∑ t ∈ T x, w t * (ρ q t - ρ p t) := by
  have hterm : ∀ t, w t * ρ q t =
      w t * ρ p t + if t ∈ T x then w t * (ρ q t - ρ p t) else 0 := by
    intro t
    by_cases ht : t ∈ T x
    · rw [if_pos ht]; ring
    · rw [if_neg ht, hfix t ht, add_zero]
  simp only [cost, hterm, sum_add_distrib, sum_ite_mem, univ_inter]

omit [Fintype β] in
/-- **Block recurrence with error** (the block form of `CouplingMinimality.recurrence_with_error`).
If `p` is `ε`-minimal against `q`, `Ψ(p) ≤ Ψ(q) + ε`, and `q` agrees with `p` off `T_x`, then
`∑_{t ∈ T_x} w_t ρ_t(p) ≤ ∑_{t ∈ T_x} w_t ρ_t(q) + ε`.
There are no sign hypotheses, and no weight is divided out, so `w > 0` is not needed. -/
theorem recurrence_with_error_block (w : τ → ℝ) (ρ : P → τ → ℝ) (p q : P) (T : β → Finset τ)
    (x : β) (ε : ℝ) (hmin : cost w ρ p ≤ cost w ρ q + ε) (hfix : ∀ t ∉ T x, ρ q t = ρ p t) :
    ∑ t ∈ T x, w t * ρ p t ≤ ∑ t ∈ T x, w t * ρ q t + ε := by
  have h := cost_update_block w ρ p q T x hfix
  simp only [mul_sub, sum_sub_distrib] at h
  linarith

omit [Fintype β] in
/-- **Block recurrence from minimality** (the block form of
`CouplingMinimality.recurrence_of_minimality`). Suppose
* `p` is minimal against the block update `upd x`: `Ψ(p) ≤ Ψ(upd_x)`;
* `upd x` agrees with `p` off `T_x`: `ρ_t(upd_x) = ρ_t(p)` for `t ∉ T_x`;
* the block response bound holds: `∑_{t ∈ T_x} w_t ρ_t(upd_x) ≤ ∑_{s ∉ T_x} K_{x,s} ρ_s(p)`.

Then the block recurrence holds: `∑_{t ∈ T_x} w_t ρ_t(p) ≤ ∑_{s ∉ T_x} K_{x,s} ρ_s(p)`.

An arithmetic statement about the comparison method; the measure-theoretic half (existence of
block-minimal couplings, (H1) for gauge fields) is not proved here. In forest gauges (H1) meets an
obstruction, which is not formalised here either. -/
theorem recurrence_of_block_minimality (w : τ → ℝ) (ρ : P → τ → ℝ) (p : P) (upd : β → P)
    (T : β → Finset τ) (K : β → τ → ℝ) (x : β)
    (hmin : cost w ρ p ≤ cost w ρ (upd x)) (hfix : ∀ t ∉ T x, ρ (upd x) t = ρ p t)
    (hresp : ∑ t ∈ T x, w t * ρ (upd x) t ≤ ∑ s ∈ (T x)ᶜ, K x s * ρ p s) :
    ∑ t ∈ T x, w t * ρ p t ≤ ∑ s ∈ (T x)ᶜ, K x s * ρ p s := by
  have h := recurrence_with_error_block w ρ p (upd x) T x 0 (by rw [add_zero]; exact hmin) hfix
  linarith

omit [Fintype β] in
/-- **Double counting.** `∑_{x ∈ A} ∑_{t ∈ T_x} f_t = ∑_t #{x ∈ A : t ∈ T_x} · f_t`. -/
theorem sum_touched_eq (A : Finset β) (T : β → Finset τ) (f : τ → ℝ) :
    ∑ x ∈ A, ∑ t ∈ T x, f t = ∑ t, ((A.filter fun x => t ∈ T x).card : ℝ) * f t := by
  have h : ∀ x t, x ∈ A ∧ t ∈ T x ↔ x ∈ A.filter (fun x => t ∈ T x) ∧ t ∈ (univ : Finset τ) := by
    intro x t
    simp
  rw [sum_comm' h]
  simp only [sum_const, nsmul_eq_mul]

omit [Fintype β] in
/-- **Block recurrence from ε-optimal block updates** (letting ε → 0 in the block-recurrence
step). In the full lemma the block couplings are only ε-optimal: the resampled coupling satisfies
`∑_{t ∈ T_x} w_t E_{π_x} φ_t ≤ w̄_x (E_{π*} 𝒯_x + ε)`. Suppose that for every `ε > 0` there is a
competitor `q` with `Ψ(p) ≤ Ψ(q)`, `ρ_t(q) = ρ_t(p)` for `t ∉ T_x`, and
`∑_{t ∈ T_x} w_t ρ_t(q) ≤ r + ε`. Then `∑_{t ∈ T_x} w_t ρ_t(p) ≤ r`.
With `comparison_of_block_recurrence` this gives Lemma LC from ε-optimal block updates. -/
theorem block_recurrence_of_approx (w : τ → ℝ) (ρ : P → τ → ℝ) (p : P) (T : β → Finset τ)
    (x : β) (r : ℝ)
    (happrox : ∀ ε > 0, ∃ q : P, cost w ρ p ≤ cost w ρ q ∧ (∀ t ∉ T x, ρ q t = ρ p t) ∧
      ∑ t ∈ T x, w t * ρ q t ≤ r + ε) :
    ∑ t ∈ T x, w t * ρ p t ≤ r := by
  refine le_of_forall_pos_le_add fun ε hε => ?_
  obtain ⟨q, hmin, hfix, hresp⟩ := happrox ε hε
  have h := recurrence_with_error_block w ρ p q T x 0 (by rw [add_zero]; exact hmin) hfix
  linarith

/-- **The counting step of Lemma LC.** Let `w ≥ 0` and `ρ ≥ 0`, and let `S` contain `T_x`
for every block `x ∉ A`. If the block recurrence `∑_{t ∈ T_x} w_t ρ_t ≤ r_x` holds for every
`x ∈ A`, and `∑_{x ∈ A} r_x ≤ θ ∑_t m_t w_t ρ_t`, then
`(1 − θ) ∑_{t ∉ S} m_t w_t ρ_t ≤ θ ∑_{t ∈ S} m_t w_t ρ_t`.
A term `t ∉ S` is touched only by admissible blocks, `m_t` of them, so summing the recurrences
counts it `m_t` times; the other summands are nonnegative and are dropped. -/
theorem comparison_of_block_recurrence (A : Finset β) (S : Finset τ) (T : β → Finset τ)
    (w ρ : τ → ℝ) (r : β → ℝ) (θ : ℝ) (hw : ∀ t, 0 ≤ w t) (hρ : ∀ t, 0 ≤ ρ t)
    (hS : ∀ x ∉ A, T x ⊆ S)
    (hrec : ∀ x ∈ A, ∑ t ∈ T x, w t * ρ t ≤ r x)
    (hsum : ∑ x ∈ A, r x ≤ θ * ∑ t, (mult T t : ℝ) * w t * ρ t) :
    (1 - θ) * ∑ t ∈ Sᶜ, (mult T t : ℝ) * w t * ρ t ≤
      θ * ∑ t ∈ S, (mult T t : ℝ) * w t * ρ t := by
  have hL : ∑ x ∈ A, ∑ t ∈ T x, w t * ρ t ≤ θ * ∑ t, (mult T t : ℝ) * w t * ρ t :=
    (sum_le_sum hrec).trans hsum
  rw [sum_touched_eq] at hL
  -- A term outside `S` is touched only by admissible blocks, so its count is `m_t`.
  have hcount : ∀ t ∉ S, (A.filter fun x => t ∈ T x) = univ.filter fun x => t ∈ T x := by
    intro t ht
    ext x
    simp only [mem_filter, mem_univ, true_and]
    constructor
    · exact fun h => h.2
    · intro hx
      refine ⟨?_, hx⟩
      by_contra hA
      exact ht (hS x hA hx)
  have hlow : ∑ t ∈ Sᶜ, (mult T t : ℝ) * w t * ρ t ≤
      ∑ t, ((A.filter fun x => t ∈ T x).card : ℝ) * (w t * ρ t) := by
    calc ∑ t ∈ Sᶜ, (mult T t : ℝ) * w t * ρ t
        = ∑ t ∈ Sᶜ, ((A.filter fun x => t ∈ T x).card : ℝ) * (w t * ρ t) := by
          refine sum_congr rfl fun t ht => ?_
          rw [hcount t (mem_compl.mp ht), mul_assoc]
          rfl
      _ ≤ ∑ t, ((A.filter fun x => t ∈ T x).card : ℝ) * (w t * ρ t) :=
          sum_le_sum_of_subset_of_nonneg (subset_univ _)
            (fun t _ _ => mul_nonneg (Nat.cast_nonneg _) (mul_nonneg (hw t) (hρ t)))
  have hsplit := sum_compl_add_sum S (fun t => (mult T t : ℝ) * w t * ρ t)
  have hX : ∑ t ∈ Sᶜ, (mult T t : ℝ) * w t * ρ t ≤
      θ * (∑ t ∈ Sᶜ, (mult T t : ℝ) * w t * ρ t + ∑ t ∈ S, (mult T t : ℝ) * w t * ρ t) := by
    rw [hsplit]
    exact hlow.trans hL
  linarith

/-- **Lemma LC from the weakest form (Σ_w).** Suppose, for every admissible block `x ∈ A`:
* minimality: `Ψ(p) ≤ Ψ(upd_x)`;
* locality: `ρ_t(upd_x) = ρ_t(p)` for `t ∉ T_x`;
* a response bound `∑_{t ∈ T_x} w_t ρ_t(upd_x) ≤ r_x`;

and the summed condition (Σ_w): `∑_{x ∈ A} r_x ≤ θ ∑_t m_t w_t ρ_t(p)`. If `w ≥ 0`, `ρ(p) ≥ 0`, and
`S` contains `T_x` for every inadmissible `x`, then
`(1 − θ) ∑_{t ∉ S} m_t w_t ρ_t(p) ≤ θ ∑_{t ∈ S} m_t w_t ρ_t(p)`.

In the full lemma `r_x = w̄_x E_{π*} 𝒯_x`, and (Σ_w) is posed with the sum over all blocks; since
`𝒯_x ≥ 0`, that implies the form used here, which sums over the admissible blocks only. So the
block-recurrence, weight-ratio and counting steps together use only (Σ_w). No condition on θ is
needed for this inequality.

An arithmetic statement about the comparison method; the measure-theoretic half (existence of
block-minimal couplings, (H1) for gauge fields) is not proved here. In forest gauges (H1) meets an
obstruction, which is not formalised here either. -/
theorem local_cost_comparison_summed (A : Finset β) (S : Finset τ) (T : β → Finset τ)
    (w : τ → ℝ) (ρ : P → τ → ℝ) (p : P) (upd : β → P) (r : β → ℝ) (θ : ℝ)
    (hw : ∀ t, 0 ≤ w t) (hρ : ∀ t, 0 ≤ ρ p t)
    (hS : ∀ x ∉ A, T x ⊆ S)
    (hmin : ∀ x ∈ A, cost w ρ p ≤ cost w ρ (upd x))
    (hfix : ∀ x ∈ A, ∀ t ∉ T x, ρ (upd x) t = ρ p t)
    (hresp : ∀ x ∈ A, ∑ t ∈ T x, w t * ρ (upd x) t ≤ r x)
    (hsum : ∑ x ∈ A, r x ≤ θ * ∑ t, (mult T t : ℝ) * w t * ρ p t) :
    (1 - θ) * ∑ t ∈ Sᶜ, (mult T t : ℝ) * w t * ρ p t ≤
      θ * ∑ t ∈ S, (mult T t : ℝ) * w t * ρ p t := by
  -- The block recurrence at every admissible block, then the count of multiplicities.
  refine comparison_of_block_recurrence A S T w (ρ p) r θ hw hρ hS (fun x hx => ?_) hsum
  have h := recurrence_with_error_block w ρ p (upd x) T x 0
    (by rw [add_zero]; exact hmin x hx) (hfix x hx)
  linarith [hresp x hx]

omit [DecidableEq τ] in
/-- **Finishing step.** From `(1 − θ) X ≤ θ Y` with `X = ∑_{t ∉ S} c_t ρ_t` and `Y = ∑_{t ∈ S} c_t ρ_t`,
`c ≥ 0`, `ρ ≤ D` on `S` and `0 ≤ θ < 1`: `θ Y ≤ θ D ∑_{t ∈ S} c_t` and
`X ≤ θ D / (1 − θ) · ∑_{t ∈ S} c_t`. -/
theorem comparison_finish [DecidableEq τ] (S : Finset τ) (c ρ : τ → ℝ) (θ D : ℝ) (hθ : θ < 1)
    (hθ0 : 0 ≤ θ) (hc : ∀ t, 0 ≤ c t) (hD : ∀ t ∈ S, ρ t ≤ D)
    (h : (1 - θ) * ∑ t ∈ Sᶜ, c t * ρ t ≤ θ * ∑ t ∈ S, c t * ρ t) :
    θ * ∑ t ∈ S, c t * ρ t ≤ θ * D * ∑ t ∈ S, c t ∧
      ∑ t ∈ Sᶜ, c t * ρ t ≤ θ * D / (1 - θ) * ∑ t ∈ S, c t := by
  have hpos : 0 < 1 - θ := by linarith
  have hY : ∑ t ∈ S, c t * ρ t ≤ D * ∑ t ∈ S, c t := by
    rw [mul_sum]
    refine sum_le_sum fun t ht => ?_
    calc c t * ρ t ≤ c t * D := mul_le_mul_of_nonneg_left (hD t ht) (hc t)
      _ = D * c t := mul_comm _ _
  have h2 : θ * ∑ t ∈ S, c t * ρ t ≤ θ * D * ∑ t ∈ S, c t := by
    rw [mul_assoc]
    exact mul_le_mul_of_nonneg_left hY hθ0
  refine ⟨h2, ?_⟩
  have h3 : ∑ t ∈ Sᶜ, c t * ρ t ≤ θ * D * (∑ t ∈ S, c t) / (1 - θ) := by
    rw [le_div_iff₀ hpos]
    linarith
  calc ∑ t ∈ Sᶜ, c t * ρ t ≤ θ * D * (∑ t ∈ S, c t) / (1 - θ) := h3
    _ = θ * D / (1 - θ) * ∑ t ∈ S, c t := by ring

/-- **The column condition bounds the summed right side of (H1).** If `w̄ ≥ 0`, `K ≥ 0`, `ρ ≥ 0`
and, for every term `s`, `∑_{x : s ∉ T_x} w̄_x K_{x,s} ≤ θ m_s w_s`, then for every set `A` of blocks
`∑_{x ∈ A} w̄_x ∑_{s ∉ T_x} K_{x,s} ρ_s ≤ θ ∑_t m_t w_t ρ_t`.
Since (H1) bounds `𝒯_x` by `∑_{s ∉ T_x} K_{x,s} φ_s`, applying this to `φ` (or to the profile `ρ`)
gives (Σ_w): this is the claim of the full lemma that (H1)–(H3) imply (Σ_w), with the column
condition in θ as in `local_cost_comparison`. -/
theorem sigma_w_of_column (A : Finset β) (T : β → Finset τ) (w : τ → ℝ) (wbar : β → ℝ)
    (K : β → τ → ℝ) (ρ : τ → ℝ) (θ : ℝ)
    (hwbar : ∀ x, 0 ≤ wbar x) (hK : ∀ x s, 0 ≤ K x s) (hρ : ∀ t, 0 ≤ ρ t)
    (hcol : ∀ s, ∑ x ∈ univ.filter (fun x => s ∉ T x), wbar x * K x s ≤
      θ * (mult T s : ℝ) * w s) :
    ∑ x ∈ A, wbar x * ∑ s ∈ (T x)ᶜ, K x s * ρ s ≤ θ * ∑ t, (mult T t : ℝ) * w t * ρ t := by
  have hnn : ∀ x, 0 ≤ wbar x * ∑ s ∈ (T x)ᶜ, K x s * ρ s := fun x =>
    mul_nonneg (hwbar x) (sum_nonneg fun s _ => mul_nonneg (hK x s) (hρ s))
  have hswap : ∀ x s, x ∈ (univ : Finset β) ∧ s ∈ (T x)ᶜ ↔
      x ∈ univ.filter (fun x => s ∉ T x) ∧ s ∈ (univ : Finset τ) := by
    intro x s
    simp
  calc ∑ x ∈ A, wbar x * ∑ s ∈ (T x)ᶜ, K x s * ρ s
      ≤ ∑ x, wbar x * ∑ s ∈ (T x)ᶜ, K x s * ρ s :=
        sum_le_sum_of_subset_of_nonneg (subset_univ A) (fun x _ _ => hnn x)
    _ = ∑ x, ∑ s ∈ (T x)ᶜ, wbar x * K x s * ρ s := by
        refine sum_congr rfl fun x _ => ?_
        rw [mul_sum]
        exact sum_congr rfl fun s _ => by ring
    _ = ∑ s, ∑ x ∈ univ.filter (fun x => s ∉ T x), wbar x * K x s * ρ s := sum_comm' hswap
    _ = ∑ s, (∑ x ∈ univ.filter (fun x => s ∉ T x), wbar x * K x s) * ρ s := by
        simp only [sum_mul]
    _ ≤ ∑ s, (θ * (mult T s : ℝ) * w s) * ρ s :=
        sum_le_sum fun s _ => mul_le_mul_of_nonneg_right (hcol s) (hρ s)
    _ = θ * ∑ t, (mult T t : ℝ) * w t * ρ t := by
        rw [mul_sum]
        exact sum_congr rfl fun t _ => by ring

/-- **Lemma LC (local-cost comparison) under (H1)–(H3).**

*Data.* Blocks `x : β` with touched sets `T_x`; terms `t : τ` with multiplicities `m_t`; term
weights `w_t ≥ 0`; row weights `w̄_x ≥ 0` (in the full lemma `w̄_x = max_{t ∈ T_x} w_t`); a matrix
`K_{x,s} ≥ 0`; a point `p` (the minimal coupling `π*`) with profile `ρ_t = ρ_t(p) ≥ 0`; block
updates `upd x` (the couplings `π_x`); the admissible blocks `A`; a set of terms `S` containing
`T_x` for every inadmissible `x`.

*Hypotheses.* For every admissible `x`:
* minimality: `Ψ(p) ≤ Ψ(upd_x)`;
* locality: `ρ_t(upd_x) = ρ_t(p)` for `t ∉ T_x`;
* the response bound, (H1) integrated against `π*`:
  `∑_{t ∈ T_x} w_t ρ_t(upd_x) ≤ w̄_x ∑_{s ∉ T_x} K_{x,s} ρ_s(p)`.

For every term `s`, the column condition in θ: `∑_{x : s ∉ T_x} w̄_x K_{x,s} ≤ θ m_s w_s`.
Finally `0 ≤ θ < 1`, and `ρ_t ≤ D` for `t ∈ S`.

*Conclusion.* The two inequalities of the full lemma, and their solved form:
* `(1 − θ) ∑_{t ∉ S} m_t w_t ρ_t ≤ θ ∑_{t ∈ S} m_t w_t ρ_t`;
* `θ ∑_{t ∈ S} m_t w_t ρ_t ≤ θ D ∑_{t ∈ S} m_t w_t`;
* `∑_{t ∉ S} m_t w_t ρ_t ≤ θ D / (1 − θ) · ∑_{t ∈ S} m_t w_t`.

*On θ.* In the full lemma θ = α e^{λR}: (H3) reads `∑_{x : s ∉ T_x} K_{x,s} ≤ α m_s`, and the range
(H2) with the weights `w_t = e^{−λ dist(s(t), T)}` gives `w̄_x ≤ e^{λR} w_s` whenever
`K_{x,s} ≠ 0`. As in `Comparison.comparison_weighted` and
`CouplingMinimality.comparison_of_minimality`, θ is a parameter here, and the column condition is
stated in θ with the weights inside. `weighted_column_of_H3` derives it from (H3) and the weight
ratio `w̄_x ≤ L w_s`, with θ = α L. With `w ≡ w̄ ≡ 1` it is (H3) with α = θ.

*On the block updates.* They are exact here, as in `comparison_of_minimality`. For the
ε-optimal block couplings of the full lemma, `block_recurrence_of_approx` gives the same
block recurrence, and `comparison_of_block_recurrence`, `sigma_w_of_column` and
`comparison_finish` give the same conclusion.

An arithmetic statement about the comparison method; the measure-theoretic half (existence of
block-minimal couplings, (H1) for gauge fields) is not proved here. In forest gauges (H1) meets an
obstruction, which is not formalised here either. -/
theorem local_cost_comparison (A : Finset β) (S : Finset τ) (T : β → Finset τ)
    (w : τ → ℝ) (wbar : β → ℝ) (K : β → τ → ℝ) (ρ : P → τ → ℝ) (p : P) (upd : β → P)
    (θ D : ℝ) (hθ : θ < 1) (hθ0 : 0 ≤ θ)
    (hw : ∀ t, 0 ≤ w t) (hwbar : ∀ x, 0 ≤ wbar x) (hK : ∀ x s, 0 ≤ K x s)
    (hρ : ∀ t, 0 ≤ ρ p t) (hD : ∀ t ∈ S, ρ p t ≤ D)
    (hS : ∀ x ∉ A, T x ⊆ S)
    (hmin : ∀ x ∈ A, cost w ρ p ≤ cost w ρ (upd x))
    (hfix : ∀ x ∈ A, ∀ t ∉ T x, ρ (upd x) t = ρ p t)
    (hresp : ∀ x ∈ A, ∑ t ∈ T x, w t * ρ (upd x) t ≤ wbar x * ∑ s ∈ (T x)ᶜ, K x s * ρ p s)
    (hcol : ∀ s, ∑ x ∈ univ.filter (fun x => s ∉ T x), wbar x * K x s ≤
      θ * (mult T s : ℝ) * w s) :
    (1 - θ) * ∑ t ∈ Sᶜ, (mult T t : ℝ) * w t * ρ p t ≤
        θ * ∑ t ∈ S, (mult T t : ℝ) * w t * ρ p t ∧
      θ * ∑ t ∈ S, (mult T t : ℝ) * w t * ρ p t ≤ θ * D * ∑ t ∈ S, (mult T t : ℝ) * w t ∧
      ∑ t ∈ Sᶜ, (mult T t : ℝ) * w t * ρ p t ≤
        θ * D / (1 - θ) * ∑ t ∈ S, (mult T t : ℝ) * w t := by
  have hcore := local_cost_comparison_summed A S T w ρ p upd
    (fun x => wbar x * ∑ s ∈ (T x)ᶜ, K x s * ρ p s) θ hw hρ hS hmin hfix hresp
    (sigma_w_of_column A T w wbar K (ρ p) θ hwbar hK hρ hcol)
  have hfin := comparison_finish S (fun t => (mult T t : ℝ) * w t) (ρ p) θ D hθ hθ0
    (fun t => mul_nonneg (Nat.cast_nonneg _) (hw t)) hD hcore
  exact ⟨hcore, hfin.1, hfin.2⟩

/-- **Uniqueness (`S = ∅`).** Suppose every block is admissible, every term is touched
(`m_t ≥ 1`), the weights are positive (`w > 0`) and θ < 1. If minimality, locality, the response
bound and the column condition of `local_cost_comparison` hold at every block, then the profile
vanishes: `ρ_t(p) = 0` for every `t`. This is the statement "if S = ∅, then ρ ≡ 0" of the full
lemma. (No sign
condition on θ is needed.)

An arithmetic statement about the comparison method; the measure-theoretic half (existence of
block-minimal couplings, (H1) for gauge fields) is not proved here. In forest gauges (H1) meets an
obstruction, which is not formalised here either. -/
theorem local_cost_uniqueness (T : β → Finset τ) (w : τ → ℝ) (wbar : β → ℝ) (K : β → τ → ℝ)
    (ρ : P → τ → ℝ) (p : P) (upd : β → P) (θ : ℝ) (hθ : θ < 1)
    (hw : ∀ t, 0 < w t) (hwbar : ∀ x, 0 ≤ wbar x) (hK : ∀ x s, 0 ≤ K x s)
    (hρ : ∀ t, 0 ≤ ρ p t) (hm : ∀ t, 1 ≤ mult T t)
    (hmin : ∀ x, cost w ρ p ≤ cost w ρ (upd x))
    (hfix : ∀ x, ∀ t ∉ T x, ρ (upd x) t = ρ p t)
    (hresp : ∀ x, ∑ t ∈ T x, w t * ρ (upd x) t ≤ wbar x * ∑ s ∈ (T x)ᶜ, K x s * ρ p s)
    (hcol : ∀ s, ∑ x ∈ univ.filter (fun x => s ∉ T x), wbar x * K x s ≤
      θ * (mult T s : ℝ) * w s) :
    ∀ t, ρ p t = 0 := by
  have h := local_cost_comparison_summed univ ∅ T w ρ p upd
    (fun x => wbar x * ∑ s ∈ (T x)ᶜ, K x s * ρ p s) θ (fun t => (hw t).le) hρ (by simp)
    (fun x _ => hmin x) (fun x _ => hfix x) (fun x _ => hresp x)
    (sigma_w_of_column univ T w wbar K (ρ p) θ hwbar hK hρ hcol)
  simp only [compl_empty, sum_empty, mul_zero] at h
  have hpos : 0 < 1 - θ := by linarith
  have hnn : ∀ t, 0 ≤ (mult T t : ℝ) * w t * ρ p t := fun t =>
    mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (hw t).le) (hρ t)
  have hsum0 : ∑ t, (mult T t : ℝ) * w t * ρ p t = 0 := by
    have h0 := sum_nonneg fun t (_ : t ∈ (univ : Finset τ)) => hnn t
    have hle : ∑ t, (mult T t : ℝ) * w t * ρ p t ≤ 0 := by
      by_contra hc
      push Not at hc
      have := mul_pos hpos hc
      linarith
    linarith
  intro t
  have ht := (sum_eq_zero_iff_of_nonneg fun t _ => hnn t).mp hsum0 t (mem_univ t)
  have hmw : 0 < (mult T t : ℝ) * w t := mul_pos (Nat.cast_pos.mpr (hm t)) (hw t)
  rcases mul_eq_zero.mp ht with h0 | h0
  · exact absurd h0 hmw.ne'
  · exact h0

omit [Fintype τ] in
/-- **Where θ = α L enters.** If (H3) holds with constant α, `∑_{x : s ∉ T_x} K_{x,s} ≤ α m_s`,
and the row weights satisfy `w̄_x ≤ L w_s` whenever `s ∉ T_x` and `K_{x,s} ≠ 0`, then the column
condition of `local_cost_comparison` holds with θ = α L:
`∑_{x : s ∉ T_x} w̄_x K_{x,s} ≤ (α L) m_s w_s`.
In the full lemma `L = e^{λR}`: by the range (H2), `dist(s(s), T) ≤ dist(s(t), T) + R` for
`t ∈ T_x` and `K_{x,s} ≠ 0`, so `w_t ≤ e^{λR} w_s` (the weight-ratio step), hence θ = α e^{λR}. -/
theorem weighted_column_of_H3 (T : β → Finset τ) (K : β → τ → ℝ) (w : τ → ℝ) (wbar : β → ℝ)
    (α L : ℝ) (hK : ∀ x s, 0 ≤ K x s) (hw : ∀ s, 0 ≤ w s) (hL : 0 ≤ L)
    (hrange : ∀ x s, s ∉ T x → K x s ≠ 0 → wbar x ≤ L * w s)
    (hH3 : ∀ s, ∑ x ∈ univ.filter (fun x => s ∉ T x), K x s ≤ α * (mult T s : ℝ)) :
    ∀ s, ∑ x ∈ univ.filter (fun x => s ∉ T x), wbar x * K x s ≤
      α * L * (mult T s : ℝ) * w s := by
  intro s
  have hterm : ∀ x ∈ univ.filter (fun x => s ∉ T x), wbar x * K x s ≤ L * w s * K x s := by
    intro x hx
    by_cases h0 : K x s = 0
    · simp [h0]
    · exact mul_le_mul_of_nonneg_right (hrange x s (mem_filter.mp hx).2 h0) (hK x s)
  calc ∑ x ∈ univ.filter (fun x => s ∉ T x), wbar x * K x s
      ≤ ∑ x ∈ univ.filter (fun x => s ∉ T x), L * w s * K x s := sum_le_sum hterm
    _ = L * w s * ∑ x ∈ univ.filter (fun x => s ∉ T x), K x s := by rw [mul_sum]
    _ ≤ L * w s * (α * (mult T s : ℝ)) :=
        mul_le_mul_of_nonneg_left (hH3 s) (mul_nonneg hL (hw s))
    _ = α * L * (mult T s : ℝ) * w s := by ring

end General

section SiteAdditive

/-! ### The site-additive case

One term per site, touched only by its own block: `β = τ = ι` and `T_i = {i}`, so `m_i = 1`. -/

variable {ι P : Type*} [Fintype ι] [DecidableEq ι]

/-- With singleton touched sets every multiplicity is one. -/
theorem mult_singleton (j : ι) : mult (fun i : ι => ({i} : Finset ι)) j = 1 := by
  unfold mult
  rw [card_eq_one]
  exact ⟨j, by ext x; simp [eq_comm]⟩

/-- **The site-additive case recovers `CouplingMinimality.comparison_of_minimality`.** With one
term per site, touched only by its own block (`T_i = {i}`, `m_i = 1`), the hypotheses below are
those of `comparison_of_minimality` verbatim, except that the weights need only be nonnegative
(`0 ≤ w`, not `0 < w`), and the conclusion is the same:
`∑_{i ∉ S} w_i d_i(p) ≤ θ D / (1 − θ) · ∑_{j ∈ S} w_j`.

It is obtained from `local_cost_comparison_summed`, the (Σ_w) form of Lemma LC, with
`r_i = w_i ∑_j C_{ij} d_j(p)`; the (Σ_w) form allows the diagonal `C_{ii}` of
`comparison_of_minimality`. For the (H1)–(H3) form see `site_additive_comparison_of_local`. -/
theorem site_additive_comparison (S : Finset ι) (w : ι → ℝ) (d : P → ι → ℝ) (p : P)
    (update : ι → P) (C : ι → ι → ℝ) (θ D : ℝ) (hθ : θ < 1) (hθ0 : 0 ≤ θ)
    (hC : ∀ i j, 0 ≤ C i j) (hw : ∀ i, 0 ≤ w i)
    (hd : ∀ i, 0 ≤ d p i) (hD : ∀ i ∈ S, d p i ≤ D)
    (hmin : ∀ i ∉ S, cost w d p ≤ cost w d (update i))
    (hfix : ∀ i ∉ S, ∀ j, j ≠ i → d (update i) j = d p j)
    (hstep : ∀ i ∉ S, d (update i) i ≤ ∑ j, C i j * d p j)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j) :
    ∑ i ∈ Sᶜ, w i * d p i ≤ θ * D / (1 - θ) * ∑ j ∈ S, w j := by
  have hm : ∀ j, (mult (fun i : ι => ({i} : Finset ι)) j : ℝ) = 1 := fun j => by
    rw [mult_singleton, Nat.cast_one]
  have hsum : ∑ i ∈ Sᶜ, w i * ∑ j, C i j * d p j ≤
      θ * ∑ t, (mult (fun i : ι => ({i} : Finset ι)) t : ℝ) * w t * d p t := by
    calc ∑ i ∈ Sᶜ, w i * ∑ j, C i j * d p j
        ≤ ∑ i, w i * ∑ j, C i j * d p j :=
          sum_le_sum_of_subset_of_nonneg (subset_univ _)
            (fun i _ _ => mul_nonneg (hw i) (sum_nonneg fun j _ => mul_nonneg (hC i j) (hd j)))
      _ = ∑ j, (∑ i, w i * C i j) * d p j := by
          simp_rw [mul_sum, sum_mul]
          rw [sum_comm]
          exact sum_congr rfl fun _ _ => sum_congr rfl fun _ _ => by ring
      _ ≤ ∑ j, (θ * w j) * d p j :=
          sum_le_sum fun j _ => mul_le_mul_of_nonneg_right (hcol j) (hd j)
      _ = θ * ∑ t, (mult (fun i : ι => ({i} : Finset ι)) t : ℝ) * w t * d p t := by
          rw [mul_sum]
          exact sum_congr rfl fun t _ => by rw [hm t]; ring
  have hcore := local_cost_comparison_summed Sᶜ S (fun i : ι => ({i} : Finset ι)) w d p update
    (fun i => w i * ∑ j, C i j * d p j) θ hw hd
    (fun x hx => by simpa using hx)
    (fun i hi => hmin i (mem_compl.mp hi))
    (fun i hi t ht => hfix i (mem_compl.mp hi) t (by simpa using ht))
    (fun i hi => by
      simp only [sum_singleton]
      exact mul_le_mul_of_nonneg_left (hstep i (mem_compl.mp hi)) (hw i))
    hsum
  simp only [hm, one_mul] at hcore
  exact (comparison_finish S w (d p) θ D hθ hθ0 hw hD hcore).2

/-- **The (H1)–(H3) form specialises to the site-additive case.** With `T_i = {i}`, row weights
`w̄_i = w_i` and `K = C`, `local_cost_comparison` gives the conclusion of
`CouplingMinimality.comparison_of_minimality` from its hypotheses, provided `C` has zero diagonal
(the response bound (H1) runs over the untouched terms `s ∉ T_i`, i.e. `s ≠ i`). The column
condition `∑_{x : s ∉ T_x} w̄_x K_{x,s} ≤ θ m_s w_s` is then `∑_{i ≠ j} w_i C_{ij} ≤ θ w_j`. -/
theorem site_additive_comparison_of_local (S : Finset ι) (w : ι → ℝ) (d : P → ι → ℝ) (p : P)
    (update : ι → P) (C : ι → ι → ℝ) (θ D : ℝ) (hθ : θ < 1) (hθ0 : 0 ≤ θ)
    (hC : ∀ i j, 0 ≤ C i j) (hdiag : ∀ i, C i i = 0) (hw : ∀ i, 0 ≤ w i)
    (hd : ∀ i, 0 ≤ d p i) (hD : ∀ i ∈ S, d p i ≤ D)
    (hmin : ∀ i ∉ S, cost w d p ≤ cost w d (update i))
    (hfix : ∀ i ∉ S, ∀ j, j ≠ i → d (update i) j = d p j)
    (hstep : ∀ i ∉ S, d (update i) i ≤ ∑ j, C i j * d p j)
    (hcol : ∀ j, ∑ i, w i * C i j ≤ θ * w j) :
    ∑ i ∈ Sᶜ, w i * d p i ≤ θ * D / (1 - θ) * ∑ j ∈ S, w j := by
  have hm : ∀ j, (mult (fun i : ι => ({i} : Finset ι)) j : ℝ) = 1 := fun j => by
    rw [mult_singleton, Nat.cast_one]
  have hoff : ∀ i, ∑ j, C i j * d p j = ∑ s ∈ ({i} : Finset ι)ᶜ, C i s * d p s := by
    intro i
    rw [← sum_compl_add_sum {i}, sum_singleton, hdiag i, zero_mul, add_zero]
  have h := local_cost_comparison Sᶜ S (fun i : ι => ({i} : Finset ι)) w w C d p update θ D
    hθ hθ0 hw hw hC hd hD
    (fun x hx => by simpa using hx)
    (fun i hi => hmin i (mem_compl.mp hi))
    (fun i hi t ht => hfix i (mem_compl.mp hi) t (by simpa using ht))
    (fun i hi => by
      simp only [sum_singleton]
      rw [← hoff i]
      exact mul_le_mul_of_nonneg_left (hstep i (mem_compl.mp hi)) (hw i))
    (fun s => by
      rw [hm s, mul_one]
      calc ∑ x ∈ univ.filter (fun x => s ∉ ({x} : Finset ι)), w x * C x s
          ≤ ∑ x, w x * C x s :=
            sum_le_sum_of_subset_of_nonneg (subset_univ _)
              (fun x _ _ => mul_nonneg (hw x) (hC x s))
        _ ≤ θ * w s := hcol s)
  simpa only [hm, one_mul] using h.2.2

end SiteAdditive

/-! ### Non-vacuity

Three sites on a triangle, single-site blocks and pure gradient (edge) terms: block `x` touches
the two edges at `x`, which are the terms `x` and `x + 1` (indices in `Fin 3`), and it leaves the
opposite edge `x + 2` untouched. Every term is touched by two blocks, `m_t = 2`.

* Weights `w = (1/2, 1, 1/2)`, decaying away from the edge `1`; row weights
  `w̄ = (1, 1, 1/2) = (max_{t ∈ T_x} w_t)_x`.
* `K_{x,x+2} = 3/4`, and `K_{x,s} = 0` otherwise. (H3) holds with α = 3/8 (tight: `3/4 ≤ α m_s`),
  the weight ratio with `L = 2`, so θ = α L = 3/4 < 1.
* Block 2 is inadmissible, so `S = T_2 = {0, 2}`, and the far term is the edge `1`, which is touched
  by the two admissible blocks 0 and 1.
* The points are `Fin 3`: `p = 0` with profile `(1, 1/8, 1)`; the block updates `upd x = x + 1`,
  with profiles `(1/2, 1/2, 1)` (for block 0) and `(1, 1/2, 1/2)` (for block 1). Minimality is
  strict (`Ψ(p) = 9/8 < 5/4`), and the response bounds hold with equality.

The conclusion is not trivial: the far side is `∑_{t ∉ S} m_t w_t ρ_t = 1/4 > 0`
(`example_values`). Without the multiplicity, i.e. with `m_s` replaced by 1, the column condition
would need θ ≥ 3/2 (`example_needs_multiplicity`). -/

namespace Example

/-- Touched sets: block `x` touches the terms `x` and `x + 1`. -/
def exT (x : Fin 3) : Finset (Fin 3) := {x, x + 1}

/-- The admissible blocks. -/
def exA : Finset (Fin 3) := {0, 1}

/-- The terms touched by the inadmissible block 2. -/
def exS : Finset (Fin 3) := {0, 2}

/-- Term weights. -/
noncomputable def exW : Fin 3 → ℝ := ![1 / 2, 1, 1 / 2]

/-- Row weights `w̄_x = max_{t ∈ T_x} w_t`. -/
noncomputable def exWbar : Fin 3 → ℝ := ![1, 1, 1 / 2]

/-- The (H1) matrix: block `x` responds to its untouched term `x + 2` only. -/
noncomputable def exK (x s : Fin 3) : ℝ := if s = x + 2 then 3 / 4 else 0

/-- Profiles of the three points: `p = 0` and the two block updates `1`, `2`. -/
noncomputable def exRho : Fin 3 → Fin 3 → ℝ :=
  ![![1, 1 / 8, 1], ![1 / 2, 1 / 2, 1], ![1, 1 / 2, 1 / 2]]

/-- Block updates. -/
def exUpd (x : Fin 3) : Fin 3 := x + 1

theorem exT_compl : ∀ x : Fin 3, (exT x)ᶜ = {x + 2} := by decide

theorem exT_filter : ∀ s : Fin 3, univ.filter (fun x => s ∉ exT x) = {s + 1} := by decide

theorem exT_mult : ∀ t : Fin 3, mult exT t = 2 := by decide

theorem exS_compl : exSᶜ = {1} := by decide

theorem exK_succ : ∀ s : Fin 3, exK (s + 1) s = 3 / 4 := by
  intro s
  unfold exK
  rw [if_pos]
  revert s
  decide

theorem exK_ne : ∀ x s : Fin 3, exK x s ≠ 0 → s = x + 2 := by
  intro x s h
  by_contra hs
  exact h (by simp [exK, hs])

/-- **Every hypothesis of `local_cost_comparison` holds**, with (H3) at α = 3/8 < 1 and the weight
ratio at `L = 2`. Every term is touched by two blocks (`m_t = 2`), minimality is strict, the
response bounds hold with equality, and `w̄_x = max_{t ∈ T_x} w_t` (the last two conjuncts). -/
theorem example_hypotheses :
    (∀ t, mult exT t = 2) ∧
    (∀ t, 0 ≤ exW t) ∧ (∀ x, 0 ≤ exWbar x) ∧ (∀ x s, 0 ≤ exK x s) ∧
    (∀ t, 0 ≤ exRho 0 t) ∧ (∀ t ∈ exS, exRho 0 t ≤ 1) ∧
    (∀ x ∉ exA, exT x ⊆ exS) ∧
    (∀ x ∈ exA, cost exW exRho 0 < cost exW exRho (exUpd x)) ∧
    (∀ x ∈ exA, ∀ t ∉ exT x, exRho (exUpd x) t = exRho 0 t) ∧
    (∀ x ∈ exA, ∑ t ∈ exT x, exW t * exRho (exUpd x) t =
      exWbar x * ∑ s ∈ (exT x)ᶜ, exK x s * exRho 0 s) ∧
    (∀ s, ∑ x ∈ univ.filter (fun x => s ∉ exT x), exK x s ≤ (3 / 8 : ℝ) * (mult exT s : ℝ)) ∧
    (∀ x s, s ∉ exT x → exK x s ≠ 0 → exWbar x ≤ 2 * exW s) ∧
    (∀ x, ∀ t ∈ exT x, exW t ≤ exWbar x) ∧
    (∀ x, ∃ t ∈ exT x, exW t = exWbar x) := by
  refine ⟨exT_mult, ?_, ?_, ?_, ?_, ?_, by decide, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro t; fin_cases t <;> simp [exW]
  · intro x; fin_cases x <;> simp [exWbar]
  · intro x s; unfold exK; split_ifs <;> norm_num
  · intro t; fin_cases t <;> simp [exRho]
  · intro t ht
    simp only [exS, mem_insert, mem_singleton] at ht
    rcases ht with rfl | rfl <;> simp [exRho]
  · intro x hx
    simp only [exA, mem_insert, mem_singleton] at hx
    rcases hx with rfl | rfl <;>
      simp [cost, Fin.sum_univ_three, exW, exRho, exUpd] <;> norm_num
  · intro x hx t ht
    rw [← mem_compl, exT_compl, mem_singleton] at ht
    subst ht
    simp only [exA, mem_insert, mem_singleton] at hx
    rcases hx with rfl | rfl <;> simp [exRho, exUpd]
  · intro x hx
    rw [exT_compl, sum_singleton]
    simp only [exA, mem_insert, mem_singleton] at hx
    rcases hx with rfl | rfl <;> simp [exT, exW, exWbar, exK, exRho, exUpd] <;> norm_num
  · intro s
    rw [exT_filter, sum_singleton, exK_succ, exT_mult]
    norm_num
  · intro x s _ hK
    have hs := exK_ne x s hK
    subst hs
    fin_cases x <;> simp [exWbar, exW]
    norm_num
  · intro x t ht
    fin_cases x <;> simp only [exT, mem_insert, mem_singleton] at ht <;>
      rcases ht with rfl | rfl <;> simp [exW, exWbar] <;> norm_num
  · intro x
    fin_cases x
    · exact ⟨1, by decide, by simp [exW, exWbar]⟩
    · exact ⟨1, by decide, by simp [exW, exWbar]⟩
    · exact ⟨2, by decide, by simp [exW, exWbar]⟩

/-- **The conclusion of Lemma LC for the example**, with θ = α L = 3/8 · 2 = 3/4 and `D = 1`,
obtained by applying `local_cost_comparison` (the column condition comes from
`weighted_column_of_H3`). -/
theorem example_conclusion :
    (1 - 3 / 4 : ℝ) * ∑ t ∈ exSᶜ, (mult exT t : ℝ) * exW t * exRho 0 t ≤
        3 / 4 * ∑ t ∈ exS, (mult exT t : ℝ) * exW t * exRho 0 t ∧
      (3 / 4 : ℝ) * ∑ t ∈ exS, (mult exT t : ℝ) * exW t * exRho 0 t ≤
        3 / 4 * 1 * ∑ t ∈ exS, (mult exT t : ℝ) * exW t ∧
