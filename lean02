  · intro i; fin_cases i <;> simp [sC]
  · intro i; simp [sW]
  · intro i; fin_cases i <;> simp [sD]
  · intro i hi
    simp only [sS, mem_singleton] at hi
    subst hi
    simp [sD]
  · intro i hi
    obtain rfl := sS_out i hi
    simp [cost, Fin.sum_univ_two, sW, sD, sUpd]
    norm_num
  · intro i hi j hj
    obtain rfl := sS_out i hi
    fin_cases j
    · exact absurd rfl hj
    · simp [sD, sUpd]
  · intro i hi
    obtain rfl := sS_out i hi
    simp [sC, sD, sUpd]
  · intro j
