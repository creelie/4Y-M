    (∀ i ∉ sS, sD (sUpd i) i ≤ ∑ j, sC i j * sD 0 j) ∧
    (∀ j, ∑ i, sW i * sC i j ≤ 1 / 2 * sW j) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
