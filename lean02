      ∑ i ∈ sSᶜ, sW i * sD 0 i ≤ 1 / 2 * 1 / (1 - 1 / 2) * ∑ j ∈ sS, sW j := by
  obtain ⟨hC, hdiag, hw, hd, hD, hmin, hfix, hstep, hcol⟩ := site_example_hypotheses
  refine ⟨?_, ?_, ?_⟩
  · have hc : sSᶜ = {0} := by decide
