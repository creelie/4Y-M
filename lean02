namespace CompositionLoss

open Finset Matrix

/-! ## 1. One scale: Lemma W (i) -/

section OneStep

variable {κ ι : Type*} [Fintype κ] [Fintype ι]

/-- The site-additive (weighted `ℓ¹`) distance `d_λ(x, x') = Σ_i λ_i |x_i − x'_i|`. -/
def addDist (lam x x' : κ → ℝ) : ℝ := ∑ i, lam i * |x i - x' i|

/-- **Admissibility.** `d_μ` (coarse, on `ι`) is admissible for `d_λ` (fine, on `κ`) through the
linear map `R`: `d_λ(R z, R z') ≤ d_μ(z, z')` for all coarse `z, z'`.

This is the linear-algebra form of the Wasserstein admissibility condition.  The reduction from
the Wasserstein form (via Fact G and Lemma 0) is not formalised; it also needs every coarse value
to be allowed, which holds since `P_{k+1}` is surjective and the Gaussian law has full support. -/
def Admissible (R : Matrix κ ι ℝ) (lam : κ → ℝ) (mu : ι → ℝ) : Prop :=
  ∀ z z' : ι → ℝ, addDist lam (R *ᵥ z) (R *ᵥ z') ≤ addDist mu z z'

omit [Fintype ι] in
/-- `(|R|ᵀ λ)_j = Σ_i |R_{ij}| λ_i`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem absT_mulVec_apply (R : Matrix κ ι ℝ) (lam : κ → ℝ) (j : ι) :
    ((R.map abs)ᵀ *ᵥ lam) j = ∑ i, |R i j| * lam i := by
  simp [Matrix.mulVec, dotProduct]

omit [Fintype ι] in
/-- `(Rᵀ λ)_j = Σ_i R_{ij} λ_i` (the signed weight).

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem transpose_mulVec_apply (R : Matrix κ ι ℝ) (lam : κ → ℝ) (j : ι) :
    (Rᵀ *ᵥ lam) j = ∑ i, R i j * lam i := by
  simp [Matrix.mulVec, dotProduct]

omit [Fintype κ] in
/-- `R e_j` is the `j`-th column of `R`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem mulVec_single_one_eq [DecidableEq ι] (R : Matrix κ ι ℝ) (j : ι) :
    R *ᵥ Pi.single j 1 = fun i => R i j := by
  ext i
  simp [Matrix.mulVec, dotProduct, Pi.single_apply]

/-- `d_λ(e_j, 0) = λ_j`: an additive metric charges a single-coordinate move its own weight.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem addDist_single_zero [DecidableEq κ] (lam : κ → ℝ) (j : κ) :
    addDist lam (Pi.single j 1) 0 = lam j := by
  unfold addDist
  rw [Finset.sum_eq_single j]
  · simp
  · intro b _ hb
    simp [hb]
  · intro h
    exact absurd (Finset.mem_univ j) h

/-- Single-coordinate identity: `d_λ(R e_j, R 0) = (|R|ᵀ λ)_j`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem addDist_single [DecidableEq ι] (R : Matrix κ ι ℝ) (lam : κ → ℝ) (j : ι) :
    addDist lam (R *ᵥ Pi.single j 1) (R *ᵥ 0) = ((R.map abs)ᵀ *ᵥ lam) j := by
  rw [mulVec_single_one_eq, Matrix.mulVec_zero, absT_mulVec_apply]
  simp [addDist, mul_comm]

/-- **Lemma W (i), necessity.** If `d_μ` is admissible for `d_λ` through `R`, then
`μ ≥ |R|ᵀ λ` entrywise.  No sign condition on the weights is needed.

The proof tests admissibility on the single-coordinate pair `(z, z') = (e_j, 0)`; this is where
additivity of `d_μ` is used (`d_μ(e_j, 0) = μ_j`).

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem weight_le_of_admissible {R : Matrix κ ι ℝ} {lam : κ → ℝ} {mu : ι → ℝ}
    (h : Admissible R lam mu) : (R.map abs)ᵀ *ᵥ lam ≤ mu := by
  classical
  intro j
  have hj := h (Pi.single j 1) 0
  rwa [addDist_single, addDist_single_zero] at hj

/-- **Lemma W (i), sufficiency.** If `λ ≥ 0` and `μ ≥ |R|ᵀ λ` entrywise, then `d_μ` is admissible
for `d_λ` through `R` (triangle inequality).

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem admissible_of_weight_le {R : Matrix κ ι ℝ} {lam : κ → ℝ} {mu : ι → ℝ}
    (hlam : 0 ≤ lam) (h : (R.map abs)ᵀ *ᵥ lam ≤ mu) : Admissible R lam mu := by
  intro z z'
  have step : ∀ i, lam i * |(R *ᵥ z) i - (R *ᵥ z') i|
      ≤ ∑ j, lam i * |R i j| * |z j - z' j| := by
    intro i
    have e : (R *ᵥ z) i - (R *ᵥ z') i = ∑ j, R i j * (z j - z' j) := by
      simp [Matrix.mulVec, dotProduct, mul_sub, Finset.sum_sub_distrib]
    rw [e]
    calc lam i * |∑ j, R i j * (z j - z' j)|
        ≤ lam i * ∑ j, |R i j * (z j - z' j)| :=
          mul_le_mul_of_nonneg_left (Finset.abs_sum_le_sum_abs _ _) (hlam i)
      _ = ∑ j, lam i * |R i j| * |z j - z' j| := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [abs_mul]
          ring
  calc addDist lam (R *ᵥ z) (R *ᵥ z')
      ≤ ∑ i, ∑ j, lam i * |R i j| * |z j - z' j| := Finset.sum_le_sum fun i _ => step i
    _ = ∑ j, ((R.map abs)ᵀ *ᵥ lam) j * |z j - z' j| := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [absT_mulVec_apply, Finset.sum_mul]
        refine Finset.sum_congr rfl fun i _ => ?_
        ring
    _ ≤ addDist mu z z' :=
        Finset.sum_le_sum fun j _ => mul_le_mul_of_nonneg_right (h j) (abs_nonneg _)

/-- **Lemma W (i).** For finite index types, a real matrix `R` and fine weights `λ ≥ 0`:
`d_λ(R z, R z') ≤ d_μ(z, z')` for all `z, z'` **iff** `μ ≥ |R|ᵀ λ` entrywise, where `|R|` is the
entrywise absolute value.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem admissible_iff {R : Matrix κ ι ℝ} {lam : κ → ℝ} {mu : ι → ℝ} (hlam : 0 ≤ lam) :
    Admissible R lam mu ↔ (R.map abs)ᵀ *ᵥ lam ≤ mu :=
  ⟨weight_le_of_admissible, admissible_of_weight_le hlam⟩

/-- **Minimal admissible weights at one scale.** For `λ ≥ 0`, `|R|ᵀ λ` is the least element (in
the entrywise order) of `{μ | d_μ is admissible for d_λ through R}`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem isLeast_admissible {R : Matrix κ ι ℝ} {lam : κ → ℝ} (hlam : 0 ≤ lam) :
    IsLeast {mu | Admissible R lam mu} ((R.map abs)ᵀ *ᵥ lam) :=
  ⟨admissible_of_weight_le hlam le_rfl, fun _ hmu => weight_le_of_admissible hmu⟩

omit [Fintype ι] in
/-- `|R|ᵀ` is a nonnegative matrix, so it is monotone: `v ≤ w → |R|ᵀ v ≤ |R|ᵀ w`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem absT_mulVec_mono (R : Matrix κ ι ℝ) {v w : κ → ℝ} (h : v ≤ w) :
    (R.map abs)ᵀ *ᵥ v ≤ (R.map abs)ᵀ *ᵥ w := by
  intro j
  rw [absT_mulVec_apply, absT_mulVec_apply]
  exact Finset.sum_le_sum fun i _ => mul_le_mul_of_nonneg_left (h i) (abs_nonneg _)

omit [Fintype ι] in
/-- `v ≥ 0 → |R|ᵀ v ≥ 0`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem absT_mulVec_nonneg (R : Matrix κ ι ℝ) {v : κ → ℝ} (h : 0 ≤ v) :
    0 ≤ (R.map abs)ᵀ *ᵥ v := by
  intro j
  rw [Pi.zero_apply, absT_mulVec_apply]
  exact Finset.sum_nonneg fun i _ => mul_nonneg (abs_nonneg _) (h i)

end OneStep

/-! ## 2. Across scales: Lemma W (ii) -/

section Chain

variable {X : ℕ → Type*} [∀ k, Fintype (X k)] (R : ∀ k, Matrix (X k) (X (k + 1)) ℝ)

/-- The **minimal additive weights** `Λ⁽⁰⁾ = 1`, `Λ⁽ᵏ⁺¹⁾ = |R_k|ᵀ Λ⁽ᵏ⁾`; that is,
`Λ⁽ᵏ⁾ = |R_{k−1}|ᵀ ⋯ |R_0|ᵀ 1` (see `minWeights_stationary` for the matrix-power form). -/
def minWeights : (k : ℕ) → X k → ℝ
  | 0 => 1
  | k + 1 => ((R k).map abs)ᵀ *ᵥ minWeights k

/-- The exact composite `T_k = R_0 R_1 ⋯ R_{k−1}`, from scale-`k` fields to fine fields:
`T_0 x = x`, `T_{k+1} x = T_k (R_k x)`. -/
def Tmap : (k : ℕ) → (X k → ℝ) → (X 0 → ℝ)
  | 0, x => x
  | k + 1, x => Tmap k (R k *ᵥ x)

/-- `Λ⁽⁰⁾ = 1`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
@[simp] theorem minWeights_zero : minWeights R 0 = 1 := rfl

/-- `Λ⁽ᵏ⁺¹⁾ = |R_k|ᵀ Λ⁽ᵏ⁾`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
@[simp] theorem minWeights_succ (k : ℕ) :
    minWeights R (k + 1) = ((R k).map abs)ᵀ *ᵥ minWeights R k := rfl

/-- `T_0 x = x`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
@[simp] theorem Tmap_zero (x : X 0 → ℝ) : Tmap R 0 x = x := rfl

/-- `T_{k+1} x = T_k (R_k x)`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
@[simp] theorem Tmap_succ (k : ℕ) (x : X (k + 1) → ℝ) : Tmap R (k + 1) x = Tmap R k (R k *ᵥ x) :=
  rfl

/-- `Λ⁽ᵏ⁾ ≥ 0`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem minWeights_nonneg (k : ℕ) : 0 ≤ minWeights R k := by
  induction k with
  | zero => intro x; simp
  | succ k ih => rw [minWeights_succ]; exact absT_mulVec_nonneg _ ih

/-- **The minimal chain is admissible**: `d_{Λ⁽ᵏ⁺¹⁾}` is admissible for `d_{Λ⁽ᵏ⁾}` through `R_k`
(the equality case of Lemma W (ii)).

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem minWeights_admissible (k : ℕ) :
    Admissible (R k) (minWeights R k) (minWeights R (k + 1)) :=
  admissible_of_weight_le (minWeights_nonneg R k) le_rfl

/-- **Lemma W (ii).** Along any chain of additive metrics `d_{λ⁽ⁱ⁾}` with `λ⁽⁰⁾ ≥ 1` (in the
multiscale argument, `λ⁽⁰⁾ = 1`) in which `d_{λ⁽ⁱ⁺¹⁾}` is admissible for `d_{λ⁽ⁱ⁾}` through `R_i`
for every `i < k`, `λ⁽ᵏ⁾ ≥ Λ⁽ᵏ⁾ = |R_{k−1}|ᵀ ⋯ |R_0|ᵀ 1` entrywise.  No sign condition on the
`λ⁽ⁱ⁾` is needed.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem minimal_weights (lam : ∀ k, X k → ℝ) (h0 : 1 ≤ lam 0) (k : ℕ)
    (hadm : ∀ i < k, Admissible (R i) (lam i) (lam (i + 1))) :
    minWeights R k ≤ lam k := by
  induction k with
  | zero => exact h0
  | succ k ih =>
      rw [minWeights_succ]
      exact le_trans (absT_mulVec_mono _ (ih fun i hi => hadm i (Nat.lt_succ_of_lt hi)))
        (weight_le_of_admissible (hadm k (Nat.lt_succ_self k)))

/-- **Stationary case**: if `R_k = A` for all `k` (on a fixed index type), then
`Λ⁽ᵏ⁾ = (|A|ᵀ)ᵏ 1`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem minWeights_stationary {Y : Type*} [Fintype Y] [DecidableEq Y] (A : Matrix Y Y ℝ)
    (k : ℕ) : minWeights (X := fun _ => Y) (fun _ => A) k = ((A.map abs)ᵀ ^ k) *ᵥ 1 := by
  induction k with
  | zero => simp
  | succ k ih => rw [minWeights_succ, ih, pow_succ', ← Matrix.mulVec_mulVec]

/-- **The minimal additive bound is never below the exact composite**:
`‖T_k x‖₁ ≤ ⟨Λ⁽ᵏ⁾, |x|⟩` for every scale-`k` field `x`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem l1_Tmap_le (k : ℕ) :
    ∀ x : X k → ℝ, ∑ v, |Tmap R k x v| ≤ ∑ w, minWeights R k w * |x w| := by
  induction k with
  | zero => intro x; simp
  | succ k ih =>
      intro x
      rw [Tmap_succ]
      calc ∑ v, |Tmap R k (R k *ᵥ x) v|
          ≤ ∑ w, minWeights R k w * |(R k *ᵥ x) w| := ih _
        _ = addDist (minWeights R k) (R k *ᵥ x) (R k *ᵥ 0) := by simp [addDist]
        _ ≤ addDist (minWeights R (k + 1)) x 0 := minWeights_admissible R k x 0
        _ = ∑ w, minWeights R (k + 1) w * |x w| := by simp [addDist]

/-- The **overestimate ratio** `ω_k(x) = ⟨Λ⁽ᵏ⁾, |x|⟩ / ‖T_k x‖₁`, meaningful for `T_k x ≠ 0`
(when `T_k x = 0`, Lean's convention `a / 0 = 0` gives `0`). -/
noncomputable def overcount (k : ℕ) (x : X k → ℝ) : ℝ :=
  (∑ w, minWeights R k w * |x w|) / ∑ v, |Tmap R k x v|

/-- `ω_k(x) ≥ 1` whenever `T_k x ≠ 0`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem one_le_overcount {k : ℕ} {x : X k → ℝ} (hx : Tmap R k x ≠ 0) : 1 ≤ overcount R k x := by
  have hpos : 0 < ∑ v, |Tmap R k x v| := by
    obtain ⟨v, hv⟩ := Function.ne_iff.mp hx
    exact lt_of_lt_of_le (abs_pos.mpr hv)
      (Finset.single_le_sum (fun i _ => abs_nonneg (Tmap R k x i)) (Finset.mem_univ v))
  rw [overcount, le_div_iff₀ hpos, one_mul]
  exact l1_Tmap_le R k x

/-- **(C1), deterministic skeleton.** Let `λ⁽ⁱ⁾` (`i ≤ M`) be a chain with `λ⁽⁰⁾ ≥ 1` that is
admissible at the steps `i < M`, and let `x_k` (`k ≤ M`) be scale-`k` vectors (in the multiscale
argument, `x_k = a⁽ᵏ⁾` for `k < M`, `x_M = Δ_M`).  Put `u = Σ_{k≤M} T_k x_k` (the true fine shift;
the multiscale argument derives this formula from the law of total expectation, which is not
formalised) and
`B = Σ_{k≤M} ⟨λ⁽ᵏ⁾, |x_k|⟩` (the iterated bound, after Lemma 0).  Then
`‖u‖₁ ≤ Σ_{k≤M} ⟨Λ⁽ᵏ⁾, |x_k|⟩ ≤ B`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem iterated_bound_ge (lam : ∀ k, X k → ℝ) (h0 : 1 ≤ lam 0) (M : ℕ)
    (hadm : ∀ i < M, Admissible (R i) (lam i) (lam (i + 1))) (x : ∀ k, X k → ℝ) :
    ∑ v, |∑ k ∈ range (M + 1), Tmap R k (x k) v|
        ≤ ∑ k ∈ range (M + 1), ∑ w, minWeights R k w * |x k w| ∧
      ∑ k ∈ range (M + 1), ∑ w, minWeights R k w * |x k w|
        ≤ ∑ k ∈ range (M + 1), ∑ w, lam k w * |x k w| := by
  constructor
  · calc ∑ v, |∑ k ∈ range (M + 1), Tmap R k (x k) v|
        ≤ ∑ v, ∑ k ∈ range (M + 1), |Tmap R k (x k) v| :=
          Finset.sum_le_sum fun v _ => Finset.abs_sum_le_sum_abs _ _
      _ = ∑ k ∈ range (M + 1), ∑ v, |Tmap R k (x k) v| := Finset.sum_comm
      _ ≤ ∑ k ∈ range (M + 1), ∑ w, minWeights R k w * |x k w| :=
          Finset.sum_le_sum fun k _ => l1_Tmap_le R k (x k)
  · refine Finset.sum_le_sum fun k hk => Finset.sum_le_sum fun w _ => ?_
    have hkM : k ≤ M := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
    exact mul_le_mul_of_nonneg_right
      (minimal_weights R lam h0 k (fun i hi => hadm i (lt_of_lt_of_le hi hkM)) w) (abs_nonneg _)

/-- If `R_i ψ⁽ⁱ⁺¹⁾ = ψ⁽ⁱ⁾` for `i < k`, then `T_k ψ⁽ᵏ⁾ = ψ⁽⁰⁾`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem Tmap_of_rec (ψ : ∀ k, X k → ℝ) (k : ℕ) (hrec : ∀ i < k, R i *ᵥ ψ (i + 1) = ψ i) :
    Tmap R k (ψ k) = ψ 0 := by
  induction k with
  | zero => rfl
  | succ k ih =>
      rw [Tmap_succ, hrec k (Nat.lt_succ_self k)]
      exact ih fun i hi => hrec i (Nat.lt_succ_of_lt hi)

/-- If `R_i 1 = 1` for `i < k` (constants are reconstructed exactly), then `T_k 1 = 1`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem Tmap_one (k : ℕ) (h1 : ∀ i < k, R i *ᵥ 1 = 1) : Tmap R k 1 = 1 :=
  Tmap_of_rec R (fun _ => 1) k h1

/-- `T_k 0 = 0`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem Tmap_zero_vec (k : ℕ) : Tmap R k 0 = 0 := by
  induction k with
  | zero => rfl
  | succ k ih => rw [Tmap_succ, Matrix.mulVec_zero, ih]

/-- If `x_k = 0` for every `k ≥ 1`, the true fine shift is `u = Σ_{k≤M} T_k x_k = x_0`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem truth_of_fine (M : ℕ) (x : ∀ k, X k → ℝ) (hx : ∀ k, 1 ≤ k → x k = 0) (v : X 0) :
    ∑ k ∈ range (M + 1), Tmap R k (x k) v = x 0 v := by
  rw [Finset.sum_eq_single 0]
  · rfl
  · intro k _ hk
    rw [hx k (by omega), Tmap_zero_vec]
    rfl
  · intro h
    exact absurd (Finset.mem_range.mpr (Nat.succ_pos M)) h

/-- **(C4), deterministic skeleton: no compounding without coarse components.** If the data vanish
at every scale `k ≥ 1` (in the multiscale argument: the exterior change moves no coarse average,
so only the fine component `x_0 = a⁽⁰⁾` is present), then the bound of the minimal chain equals
the truth:
`Σ_{k≤M} ⟨Λ⁽ᵏ⁾, |x_k|⟩ = ‖u‖₁` with `u = Σ_{k≤M} T_k x_k`.  So an inequality
"bound `≥ Π_k γ_k · ‖u‖₁` for every exterior change" fails as soon as some `Π γ_k > 1`
(see `chain6_C4`).

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem minimal_bound_eq_truth_of_fine (M : ℕ) (x : ∀ k, X k → ℝ)
    (hx : ∀ k, 1 ≤ k → x k = 0) :
    ∑ k ∈ range (M + 1), ∑ w, minWeights R k w * |x k w| =
      ∑ v, |∑ k ∈ range (M + 1), Tmap R k (x k) v| := by
  have hB : ∑ k ∈ range (M + 1), ∑ w, minWeights R k w * |x k w| = ∑ w, |x 0 w| := by
    rw [Finset.sum_eq_single 0]
    · simp
    · intro k _ hk
      rw [hx k (by omega)]
      simp
    · intro h
      exact absurd (Finset.mem_range.mpr (Nat.succ_pos M)) h
  rw [hB]
  exact Finset.sum_congr rfl fun v _ => by rw [truth_of_fine R M x hx v]

end Chain

/-! ## 3. Proposition C -/

section SignChange

variable {κ ι : Type*} [Fintype κ] [Fintype ι]

/-- **Strict triangle inequality.** For a finite family `c`, `|Σ_i c_i| < Σ_i |c_i|` iff `c` has
entries of both signs (some `c_a < 0` and some `c_b > 0`).

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem abs_sum_lt_sum_abs_iff (c : κ → ℝ) :
    |∑ i, c i| < ∑ i, |c i| ↔ ∃ a b, c a < 0 ∧ 0 < c b := by
  have hneg : ∑ i, c i < ∑ i, |c i| ↔ ∃ a, c a < 0 := by
    have e : ∑ i, c i < ∑ i, |c i| ↔ 0 < ∑ i, (|c i| - c i) := by
      rw [Finset.sum_sub_distrib]
      constructor <;> intro h <;> linarith
    rw [e, Finset.sum_pos_iff_of_nonneg fun i _ => sub_nonneg.mpr (le_abs_self (c i))]
    simp only [Finset.mem_univ, true_and]
    refine exists_congr fun a => ⟨fun h => ?_, fun h => ?_⟩
    · refine not_le.mp fun h' => ?_
      rw [abs_of_nonneg h'] at h
      linarith
    · rw [abs_of_neg h]
      linarith
  have hpos : -∑ i, |c i| < ∑ i, c i ↔ ∃ b, 0 < c b := by
    have e : -∑ i, |c i| < ∑ i, c i ↔ 0 < ∑ i, (|c i| + c i) := by
      rw [Finset.sum_add_distrib]
      constructor <;> intro h <;> linarith
    rw [e, Finset.sum_pos_iff_of_nonneg fun i _ => by linarith [neg_abs_le (c i)]]
    simp only [Finset.mem_univ, true_and]
    refine exists_congr fun b => ⟨fun h => ?_, fun h => ?_⟩
    · refine not_le.mp fun h' => ?_
      rw [abs_of_nonpos h'] at h
      linarith
    · rw [abs_of_pos h]
      linarith
  rw [abs_lt, hneg, hpos]
  constructor
  · rintro ⟨⟨b, hb⟩, ⟨a, ha⟩⟩
    exact ⟨a, b, ha, hb⟩
  · rintro ⟨a, b, ha, hb⟩
    exact ⟨⟨b, hb⟩, ⟨a, ha⟩⟩

omit [Fintype ι] in
/-- **The `|R|ᵀ` weight exceeds the signed weight exactly at sign-changing columns.** For strictly
positive weights `λ > 0` and a column index `j`:
`|(Rᵀ λ)_j| < (|R|ᵀ λ)_j` iff column `j` of `R` has entries of both signs.
(With `λ = 1`: `|Σ column| < ‖column‖₁`.)

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem signed_lt_abs_weight_iff (R : Matrix κ ι ℝ) {lam : κ → ℝ} (hlam : ∀ i, 0 < lam i)
    (j : ι) :
    |(Rᵀ *ᵥ lam) j| < ((R.map abs)ᵀ *ᵥ lam) j ↔ ∃ a b, R a j < 0 ∧ 0 < R b j := by
  rw [transpose_mulVec_apply, absT_mulVec_apply]
  have e : ∑ i, |R i j| * lam i = ∑ i, |R i j * lam i| := by
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [abs_mul, abs_of_pos (hlam i)]
  rw [e, abs_sum_lt_sum_abs_iff]
  have k1 : ∀ a, R a j * lam a < 0 ↔ R a j < 0 := fun a =>
    ⟨fun h => not_le.mp fun h' => absurd h (not_lt.mpr (mul_nonneg h' (hlam a).le)),
     fun h => mul_neg_of_neg_of_pos h (hlam a)⟩
  have k2 : ∀ b, 0 < R b j * lam b ↔ 0 < R b j := fun b =>
    ⟨fun h => not_le.mp fun h' =>
      absurd h (not_lt.mpr (mul_nonpos_of_nonpos_of_nonneg h' (hlam b).le)),
     fun h => mul_pos h (hlam b)⟩
  simp only [k1, k2]

/-- Exact reconstruction of constants forces the common column sum: if `A 1 = 1` and every column
of `A` sums to `s`, then `s · |ι| = |κ|`.  (In (C2), for blocks of `2^d` sites:
`s = |X_k|/|X_{k+1}| = 2^d`.)

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem colSum_mul_card (A : Matrix κ ι ℝ) (s : ℝ) (h1 : A *ᵥ 1 = 1)
    (hs : ∀ j, ∑ i, A i j = s) : s * Fintype.card ι = Fintype.card κ := by
  have hrow : ∀ i, ∑ j, A i j = 1 := fun i => by
    have := congrFun h1 i
    simpa [Matrix.mulVec, dotProduct] using this
  calc s * Fintype.card ι = ∑ j, ∑ i, A i j := by simp [hs, mul_comm]
    _ = ∑ i, ∑ j, A i j := Finset.sum_comm
    _ = Fintype.card κ := by simp [hrow]

/-- Under the hypotheses of `colSum_mul_card`, with `κ, ι` nonempty, the column sum is positive.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem colSum_pos [Nonempty κ] [Nonempty ι] (A : Matrix κ ι ℝ) (s : ℝ) (h1 : A *ᵥ 1 = 1)
    (hs : ∀ j, ∑ i, A i j = s) : 0 < s := by
  have h := colSum_mul_card A s h1 hs
  have hκ : (0 : ℝ) < Fintype.card κ := by exact_mod_cast Fintype.card_pos
  have hι : (0 : ℝ) < Fintype.card ι := by exact_mod_cast Fintype.card_pos
  refine not_le.mp fun hns => ?_
  have : s * Fintype.card ι ≤ 0 := mul_nonpos_of_nonpos_of_nonneg hns hι.le
  linarith

/-- **`γ ≥ 1`.** If `A 1 = 1`, every column of `A` has `ℓ¹` norm `L` and column sum `s`, then
`γ := L / s ≥ 1`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem one_le_gamma [Nonempty κ] [Nonempty ι] (A : Matrix κ ι ℝ) (L s : ℝ) (h1 : A *ᵥ 1 = 1)
    (hL : ∀ j, ∑ i, |A i j| = L) (hs : ∀ j, ∑ i, A i j = s) : 1 ≤ L / s := by
  have hspos := colSum_pos A s h1 hs
  rw [one_le_div hspos]
  obtain ⟨j⟩ := ‹Nonempty ι›
  rw [← hL j, ← hs j]
  exact (le_abs_self _).trans (Finset.abs_sum_le_sum_abs _ _)

/-- **`γ > 1` iff some column changes sign** (Proposition C (C2)).  Under the hypotheses of
`one_le_gamma`, `γ = L / s > 1` iff some column of `A` has entries of both signs.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem one_lt_gamma_iff [Nonempty κ] [Nonempty ι] (A : Matrix κ ι ℝ) (L s : ℝ)
    (h1 : A *ᵥ 1 = 1) (hL : ∀ j, ∑ i, |A i j| = L) (hs : ∀ j, ∑ i, A i j = s) :
    1 < L / s ↔ ∃ j a b, A a j < 0 ∧ 0 < A b j := by
  have hspos := colSum_pos A s h1 hs
  have habs : ∀ j, |∑ i, A i j| = s := fun j => by rw [hs j, abs_of_pos hspos]
  rw [one_lt_div hspos]
  constructor
  · intro hlt
    obtain ⟨j⟩ := ‹Nonempty ι›
    have : |∑ i, A i j| < ∑ i, |A i j| := by rw [habs j, hL j]; exact hlt
    obtain ⟨a, b, ha, hb⟩ := (abs_sum_lt_sum_abs_iff fun i => A i j).mp this
    exact ⟨j, a, b, ha, hb⟩
  · rintro ⟨j, a, b, ha, hb⟩
    have := (abs_sum_lt_sum_abs_iff fun i => A i j).mpr ⟨a, b, ha, hb⟩
    rwa [habs j, hL j] at this

/-- Under the hypotheses of `one_le_gamma` the columns change sign all together or not at all:
some column changes sign iff every column does (since the column `ℓ¹` norm is the same for all).

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem exists_sign_change_iff_forall [Nonempty κ] [Nonempty ι] (A : Matrix κ ι ℝ) (L s : ℝ)
    (h1 : A *ᵥ 1 = 1) (hL : ∀ j, ∑ i, |A i j| = L) (hs : ∀ j, ∑ i, A i j = s) :
    (∃ j a b, A a j < 0 ∧ 0 < A b j) ↔ ∀ j, ∃ a b, A a j < 0 ∧ 0 < A b j := by
  have hspos := colSum_pos A s h1 hs
  have habs : ∀ j, |∑ i, A i j| = s := fun j => by rw [hs j, abs_of_pos hspos]
  constructor
  · rintro ⟨j, a, b, ha, hb⟩ j'
    have h := (abs_sum_lt_sum_abs_iff fun i => A i j).mpr ⟨a, b, ha, hb⟩
    rw [habs j, hL j] at h
    exact (abs_sum_lt_sum_abs_iff fun i => A i j').mp (by rw [habs j', hL j']; exact h)
  · intro h
    obtain ⟨j⟩ := ‹Nonempty ι›
    obtain ⟨a, b, ha, hb⟩ := h j
    exact ⟨j, a, b, ha, hb⟩

end SignChange

section ScalarTorus

variable {X : ℕ → Type*} [∀ k, Fintype (X k)] (R : ∀ k, Matrix (X k) (X (k + 1)) ℝ)

/-- If every column of `R_i` (`i < k`) has `ℓ¹` norm `L_i`, then `Λ⁽ᵏ⁾ = (Π_{i<k} L_i) · 1`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem minWeights_of_colNorm (L : ℕ → ℝ) (k : ℕ)
    (hL : ∀ i < k, ∀ j, ∑ w, |R i w j| = L i) :
    minWeights R k = fun _ => ∏ i ∈ range k, L i := by
  induction k with
  | zero => ext x; simp
  | succ k ih =>
      have ih' := ih fun i hi => hL i (Nat.lt_succ_of_lt hi)
      ext j
      rw [minWeights_succ, absT_mulVec_apply, ih', Finset.prod_range_succ]
      simp only
      rw [← Finset.sum_mul, hL k (Nat.lt_succ_self k) j, mul_comm]

/-- Telescoping of the column sums: if `R_i 1 = 1` and the columns of `R_i` all sum to `s_i`
(`i < k`), then `(Π_{i<k} s_i) · |X_k| = |X_0|`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem prod_colSum_mul_card (s : ℕ → ℝ) (k : ℕ) (h1 : ∀ i < k, R i *ᵥ 1 = 1)
    (hs : ∀ i < k, ∀ j, ∑ w, R i w j = s i) :
    (∏ i ∈ range k, s i) * Fintype.card (X k) = Fintype.card (X 0) := by
  induction k with
  | zero => simp
  | succ k ih =>
      have ih' := ih (fun i hi => h1 i (Nat.lt_succ_of_lt hi))
        (fun i hi => hs i (Nat.lt_succ_of_lt hi))
      have hk := colSum_mul_card (R k) (s k) (h1 k (Nat.lt_succ_self k))
        (hs k (Nat.lt_succ_self k))
      rw [Finset.prod_range_succ, mul_assoc, hk, ih']

/-- **Proposition C (C2), constant components.** Assume, for every `i < k`:
* every column of `R_i` has the same `ℓ¹` norm `L_i` (on the torus: `L⁽ⁱ⁾ = ‖R_i e_w‖₁`, the same
  for all `w`, by translation invariance);
* every column of `R_i` has the same sum `s_i` (by translation invariance; necessarily
  `s_i = |X_i|/|X_{i+1}|`, `colSum_mul_card`, which is `2^d` for blocks of `2^d` sites);
* constants are reconstructed exactly: `R_i 1 = 1`.

Then `Λ⁽ᵏ⁾ = (Π_{i<k} L_i) 1`, `T_k 1 = 1`, and the overestimate factor of the constant field is
`ω_k(1) = Π_{i<k} γ_i` with `γ_i = L_i / s_i`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem overcount_one_eq_prod [∀ k, Nonempty (X k)] (L s : ℕ → ℝ) (k : ℕ)
    (hL : ∀ i < k, ∀ j, ∑ w, |R i w j| = L i) (hs : ∀ i < k, ∀ j, ∑ w, R i w j = s i)
    (h1 : ∀ i < k, R i *ᵥ 1 = 1) :
    overcount R k 1 = ∏ i ∈ range k, L i / s i := by
  have hT := Tmap_one R k h1
  have hW := minWeights_of_colNorm R L k hL
  have hcard := prod_colSum_mul_card R s k h1 hs
  have hk : (0 : ℝ) < Fintype.card (X k) := by exact_mod_cast Fintype.card_pos
  have h0 : (0 : ℝ) < Fintype.card (X 0) := by exact_mod_cast Fintype.card_pos
  have hsne : (∏ i ∈ range k, s i) ≠ 0 := by
    intro h
    rw [h, zero_mul] at hcard
    linarith
  rw [overcount, hT, hW, Finset.prod_div_distrib]
  simp only [Pi.one_apply, abs_one, mul_one, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  rw [← hcard]
  field_simp

/-- **Product bound over `k` steps for constant fields.** Under the hypotheses of
`overcount_one_eq_prod`, if `γ_i = L_i / s_i ≥ g ≥ 0` for every `i < k`, then `ω_k(1) ≥ gᵏ`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem pow_le_overcount_one [∀ k, Nonempty (X k)] (L s : ℕ → ℝ) (k : ℕ)
    (hL : ∀ i < k, ∀ j, ∑ w, |R i w j| = L i) (hs : ∀ i < k, ∀ j, ∑ w, R i w j = s i)
    (h1 : ∀ i < k, R i *ᵥ 1 = 1) (g : ℝ) (hg0 : 0 ≤ g) (hg : ∀ i < k, g ≤ L i / s i) :
    g ^ k ≤ overcount R k 1 := by
  rw [overcount_one_eq_prod R L s k hL hs h1]
  calc g ^ k = ∏ _i ∈ range k, g := by rw [Finset.prod_const, Finset.card_range]
    _ ≤ ∏ i ∈ range k, L i / s i :=
        Finset.prod_le_prod (fun _ _ => hg0) fun i hi => hg i (Finset.mem_range.mp hi)

/-- **No loss for nonnegative reconstructions.** If every `R_i` (`i < k`) is entrywise
nonnegative, then for every `x ≥ 0` at scale `k`, `‖T_k x‖₁ = ⟨Λ⁽ᵏ⁾, x⟩`: the minimal additive
bound is exact on nonnegative (in particular constant) fields.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem no_loss_of_nonneg (k : ℕ) (hR : ∀ i < k, ∀ a b, 0 ≤ R i a b) :
    ∀ x : X k → ℝ, 0 ≤ x → ∑ v, |Tmap R k x v| = ∑ w, minWeights R k w * x w := by
  induction k with
  | zero =>
      intro x hx
      simp only [Tmap_zero, minWeights_zero, Pi.one_apply, one_mul]
      exact Finset.sum_congr rfl fun v _ => abs_of_nonneg (hx v)
  | succ k ih =>
      intro x hx
      have hRk := hR k (Nat.lt_succ_self k)
      have hy : 0 ≤ R k *ᵥ x := fun a => by
        simp only [Pi.zero_apply, Matrix.mulVec, dotProduct]
        exact Finset.sum_nonneg fun b _ => mul_nonneg (hRk a b) (hx b)
      rw [Tmap_succ, ih (fun i hi => hR i (Nat.lt_succ_of_lt hi)) _ hy, minWeights_succ]
      calc ∑ w, minWeights R k w * (R k *ᵥ x) w
          = ∑ w, ∑ j, minWeights R k w * R k w j * x j := by
            refine Finset.sum_congr rfl fun w _ => ?_
            simp only [Matrix.mulVec, dotProduct, Finset.mul_sum, mul_assoc]
        _ = ∑ j, ∑ w, minWeights R k w * R k w j * x j := Finset.sum_comm
        _ = ∑ j, (((R k).map abs)ᵀ *ᵥ minWeights R k) j * x j := by
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [absT_mulVec_apply, Finset.sum_mul]
            refine Finset.sum_congr rfl fun w _ => ?_
            rw [abs_of_nonneg (hRk w j)]
            ring

/-- Corollary of `no_loss_of_nonneg`: for nonnegative `R_i` and `x ≥ 0` with `T_k x ≠ 0`,
`ω_k(x) = 1`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem overcount_eq_one_of_nonneg (k : ℕ) (hR : ∀ i < k, ∀ a b, 0 ≤ R i a b) (x : X k → ℝ)
    (hx : 0 ≤ x) (hT : Tmap R k x ≠ 0) : overcount R k x = 1 := by
  have hpos : 0 < ∑ v, |Tmap R k x v| := by
    obtain ⟨v, hv⟩ := Function.ne_iff.mp hT
    exact lt_of_lt_of_le (abs_pos.mpr hv)
      (Finset.single_le_sum (fun i _ => abs_nonneg (Tmap R k x i)) (Finset.mem_univ v))
  have e := no_loss_of_nonneg R k hR x hx
  have e' : ∑ w, minWeights R k w * |x w| = ∑ w, minWeights R k w * x w :=
    Finset.sum_congr rfl fun w _ => by rw [abs_of_nonneg (hx w)]
  rw [overcount, e', ← e, div_self hpos.ne']

end ScalarTorus

/-! ### Gauge-field (direction-class) form of Proposition C -/

section Classes

variable {X : ℕ → Type*} [∀ k, Fintype (X k)] (R : ∀ k, Matrix (X k) (X (k + 1)) ℝ)
variable {D : Type*} [Fintype D]

/-- Class weights (for gauge fields: direction weights): `λ⁽⁰⁾ = 1`, `λ⁽ᵏ⁺¹⁾ = M_kᵀ λ⁽ᵏ⁾`. -/
def classWeights (M : ℕ → Matrix D D ℝ) : ℕ → D → ℝ
  | 0 => 1
  | k + 1 => (M k)ᵀ *ᵥ classWeights M k

/-- `λ⁽⁰⁾ = 1`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
@[simp] theorem classWeights_zero (M : ℕ → Matrix D D ℝ) : classWeights M 0 = 1 := rfl

/-- `λ⁽ᵏ⁺¹⁾ = M_kᵀ λ⁽ᵏ⁾`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
@[simp] theorem classWeights_succ (M : ℕ → Matrix D D ℝ) (k : ℕ) :
    classWeights M (k + 1) = (M k)ᵀ *ᵥ classWeights M k := rfl

/-- **Class collapse.**  Let `cls_i : X_i → D` assign a class (for gauge fields: the link
direction) to each site, and assume, for `i < k`, that the class-sum matrix
`M_i(ν, μ) = Σ_{e : cls_i e = ν} |R_i(e, w)|` depends on the column `w` only through
`μ = cls_{i+1} w`.  Then `Λ⁽ᵏ⁾_e = λ⁽ᵏ⁾_{cls_k e}`, with `λ⁽⁰⁾ = 1`, `λ⁽ⁱ⁺¹⁾ = M_iᵀ λ⁽ⁱ⁾`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem minWeights_eq_classWeights [DecidableEq D] (cls : ∀ k, X k → D)
    (M : ℕ → Matrix D D ℝ) (k : ℕ)
    (hM : ∀ i < k, ∀ (w : X (i + 1)) (ν : D),
      ∑ e ∈ univ.filter (fun e => cls i e = ν), |R i e w| = M i ν (cls (i + 1) w)) :
    ∀ e, minWeights R k e = classWeights M k (cls k e) := by
  induction k with
  | zero => intro e; simp
  | succ k ih =>
      have ih' := ih fun i hi => hM i (Nat.lt_succ_of_lt hi)
      intro w
      rw [minWeights_succ, classWeights_succ, absT_mulVec_apply, transpose_mulVec_apply]
      simp only [ih']
      rw [← Finset.sum_fiberwise Finset.univ (cls k)]
      refine Finset.sum_congr rfl fun ν _ => ?_
      rw [← hM k (Nat.lt_succ_self k) w ν, Finset.sum_mul]
      refine Finset.sum_congr rfl fun e he => ?_
      rw [(Finset.mem_filter.mp he).2]

/-- **Collatz–Wielandt column-sum bound.**  If `A ≥ 0` entrywise, every column sum of
`A` is at least `c`, and `v ≥ m ≥ 0` entrywise, then `(Aᵀ v)_μ ≥ c · m` for every `μ`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem colSum_lower_bound (A : Matrix D D ℝ) (hA : ∀ ν μ, 0 ≤ A ν μ) {c m : ℝ}
    (hc : ∀ μ, c ≤ ∑ ν, A ν μ) (hm : 0 ≤ m) {v : D → ℝ} (hv : ∀ ν, m ≤ v ν) (μ : D) :
    c * m ≤ (Aᵀ *ᵥ v) μ := by
  rw [transpose_mulVec_apply]
  calc c * m ≤ (∑ ν, A ν μ) * m := mul_le_mul_of_nonneg_right (hc μ) hm
    _ = ∑ ν, A ν μ * m := Finset.sum_mul _ _ _
    _ ≤ ∑ ν, A ν μ * v ν := Finset.sum_le_sum fun ν _ => mul_le_mul_of_nonneg_left (hv ν) (hA ν μ)

/-- **Iterated column-sum bound.** If, for `i < k`, `M_i ≥ 0` entrywise and every column sum of
`M_i` is at least `c_i ≥ 0`, then `λ⁽ᵏ⁾_μ ≥ Π_{i<k} c_i` for every class `μ` (for gauge fields:
the column sums of `M_k = 8I + 2n_k` are `8 + 2 m_k(μ)`, so the negative-mass bound
`m_k(μ) ≥ m_*`, which is not formalised here, would give `c_i = 8 + 2 m_*` and
`min_μ λ⁽ᵏ⁾_μ ≥ (8 + 2 m_*)ᵏ`).

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem classWeights_ge_prod (M : ℕ → Matrix D D ℝ) (c : ℕ → ℝ) (k : ℕ)
    (hM : ∀ i < k, ∀ ν μ, 0 ≤ M i ν μ) (hc0 : ∀ i < k, 0 ≤ c i)
    (hc : ∀ i < k, ∀ μ, c i ≤ ∑ ν, M i ν μ) :
    ∀ μ, ∏ i ∈ range k, c i ≤ classWeights M k μ := by
  induction k with
  | zero => intro μ; simp
  | succ k ih =>
      intro μ
      have ih' := ih (fun i hi => hM i (Nat.lt_succ_of_lt hi))
        (fun i hi => hc0 i (Nat.lt_succ_of_lt hi)) (fun i hi => hc i (Nat.lt_succ_of_lt hi))
      have hp : 0 ≤ ∏ i ∈ range k, c i :=
        Finset.prod_nonneg fun i hi => hc0 i (Nat.lt_succ_of_lt (Finset.mem_range.mp hi))
      rw [Finset.prod_range_succ, mul_comm, classWeights_succ]
      exact colSum_lower_bound (M k) (hM k (Nat.lt_succ_self k)) (hc k (Nat.lt_succ_self k)) hp
        ih' μ

/-- **Flat-field overcount.**  Under the class collapse hypothesis of
`minWeights_eq_classWeights`, let `ψ⁽ⁱ⁾` (`i ≤ k`) be fields with
* `R_i ψ⁽ⁱ⁺¹⁾ = ψ⁽ⁱ⁾` for `i < k` (for gauge fields: the flat field is reconstructed exactly),
* `ψ⁽ᵏ⁾ ≥ 0`, supported on the sites of class `μ`, and `ψ⁽⁰⁾ ≥ 0` with `‖ψ⁽⁰⁾‖₁ > 0`,
* `‖ψ⁽ᵏ⁾‖₁ = q⁻ᵏ ‖ψ⁽⁰⁾‖₁` (for gauge fields: `q = 8`, by counting links).

Then `ω_k(ψ⁽ᵏ⁾) = λ⁽ᵏ⁾_μ / qᵏ`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem overcount_flat [DecidableEq D] (cls : ∀ k, X k → D) (M : ℕ → Matrix D D ℝ) (k : ℕ)
    (hM : ∀ i < k, ∀ (w : X (i + 1)) (ν : D),
      ∑ e ∈ univ.filter (fun e => cls i e = ν), |R i e w| = M i ν (cls (i + 1) w))
    (μ : D) (ψ : ∀ k, X k → ℝ) (q : ℝ) (hrec : ∀ i < k, R i *ᵥ ψ (i + 1) = ψ i)
    (hψk : 0 ≤ ψ k) (hsupp : ∀ e, cls k e ≠ μ → ψ k e = 0) (hψ0 : 0 ≤ ψ 0)
    (hpos : 0 < ∑ e, ψ 0 e) (hmass : ∑ e, ψ k e = (∑ e, ψ 0 e) / q ^ k) :
    overcount R k (ψ k) = classWeights M k μ / q ^ k := by
  have hW := minWeights_eq_classWeights R cls M k hM
  have hT := Tmap_of_rec R ψ k hrec
  have num : ∑ w, minWeights R k w * |ψ k w| = classWeights M k μ * ∑ e, ψ k e := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun e _ => ?_
    rw [hW e, abs_of_nonneg (hψk e)]
    by_cases he : cls k e = μ
    · rw [he]
    · rw [hsupp e he, mul_zero, mul_zero]
  have den : ∑ v, |Tmap R k (ψ k) v| = ∑ e, ψ 0 e := by
    rw [hT]
    exact Finset.sum_congr rfl fun e _ => abs_of_nonneg (hψ0 e)
  rw [overcount, num, den, hmass]
  field_simp

/-- **Flat-field overcount as a product of per-scale factors.**  Under the hypotheses of
`overcount_flat`, if `q ≠ 0` and `λ⁽ⁱ⁾_μ ≠ 0` for `i < k`, then
`ω_k(ψ⁽ᵏ⁾) = Π_{i<k} γ_i(μ)` with `γ_i(μ) = λ⁽ⁱ⁺¹⁾_μ / (q λ⁽ⁱ⁾_μ)`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem overcount_flat_eq_prod_gamma [DecidableEq D] (cls : ∀ k, X k → D)
    (M : ℕ → Matrix D D ℝ) (k : ℕ)
    (hM : ∀ i < k, ∀ (w : X (i + 1)) (ν : D),
      ∑ e ∈ univ.filter (fun e => cls i e = ν), |R i e w| = M i ν (cls (i + 1) w))
    (μ : D) (ψ : ∀ k, X k → ℝ) (q : ℝ) (hrec : ∀ i < k, R i *ᵥ ψ (i + 1) = ψ i)
    (hψk : 0 ≤ ψ k) (hsupp : ∀ e, cls k e ≠ μ → ψ k e = 0) (hψ0 : 0 ≤ ψ 0)
    (hpos : 0 < ∑ e, ψ 0 e) (hmass : ∑ e, ψ k e = (∑ e, ψ 0 e) / q ^ k)
    (hq : q ≠ 0) (hne : ∀ i < k, classWeights M i μ ≠ 0) :
    overcount R k (ψ k) =
      ∏ i ∈ range k, classWeights M (i + 1) μ / (q * classWeights M i μ) := by
  rw [overcount_flat R cls M k hM μ ψ q hrec hψk hsupp hψ0 hpos hmass]
  clear hrec hψk hsupp hψ0 hpos hmass hM
  induction k with
  | zero => simp
  | succ k ih =>
      rw [Finset.prod_range_succ, ← ih fun i hi => hne i (Nat.lt_succ_of_lt hi)]
      have h := hne k (Nat.lt_succ_self k)
      field_simp
      ring

end Classes

/-! ## 4. Examples (non-vacuity) -/

noncomputable section Examples

/-! ### The 1D periodic chain `ℤ/6`, blocks of two: a sign-changing reconstruction

Fine sites `0, …, 5` on the cycle `ℤ/6`, blocks `{0,1}, {2,3}, {4,5}`, massless energy
`E(φ) = Σ_{x ∈ ℤ/6} (φ_{x+1} − φ_x)²`.  `R6 y` is the minimal-energy field with block averages `y`
(certified by `R6_isMin`).  Every column has entries `{1, 1, ±1/5, ±1/5}` of both signs, column sum
`2` and `ℓ¹` norm `14/5`, so `γ₀ = 7/5`.  (The infinite-line value is `γ₀ = √2`.  For the
cycles `ℤ/(2N)` the column norm is `14/5, 48/17, 82/29, …, 1632/577` for `N = 3, 4, 5, …, 16`,
converging to `2√2`; this was computed in exact rationals outside Lean and is not formalised.) -/

/-- The reconstruction map of the 1D periodic chain `ℤ/6` with blocks of two. -/
def R6 : Matrix (Fin 6) (Fin 3) ℝ :=
  !![1, -1/5, 1/5;
     1, 1/5, -1/5;
     1/5, 1, -1/5;
     -1/5, 1, 1/5;
     -1/5, 1/5, 1;
     1/5, -1/5, 1]

/-- The block averages `(P6 φ)_b = (φ_{2b} + φ_{2b+1}) / 2` on `ℤ/6`. -/
def P6 : Matrix (Fin 3) (Fin 6) ℝ :=
  !![1/2, 1/2, 0, 0, 0, 0;
     0, 0, 1/2, 1/2, 0, 0;
     0, 0, 0, 0, 1/2, 1/2]

/-- The massless energy on the cycle `ℤ/6`: `E(φ) = Σ_x (φ_{x+1} − φ_x)²`. -/
def energy6 (φ : Fin 6 → ℝ) : ℝ :=
  (φ 1 - φ 0) ^ 2 + (φ 2 - φ 1) ^ 2 + (φ 3 - φ 2) ^ 2 + (φ 4 - φ 3) ^ 2 + (φ 5 - φ 4) ^ 2 +
    (φ 0 - φ 5) ^ 2

/-- `R6` reproduces the block averages: `P6 R6 = I`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem P6_mul_R6 : P6 * R6 = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [P6, R6, Matrix.mul_apply, Fin.sum_univ_succ] <;> norm_num

/-- **`R6` is the minimal-energy reconstruction**: for every `y`, `P6 (R6 y) = y`, and
`E(R6 y) ≤ E(φ)` for every `φ` with `P6 φ = y`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem R6_isMin (y : Fin 3 → ℝ) :
    P6 *ᵥ (R6 *ᵥ y) = y ∧ ∀ φ : Fin 6 → ℝ, P6 *ᵥ φ = y → energy6 (R6 *ᵥ y) ≤ energy6 φ := by
  refine ⟨by rw [Matrix.mulVec_mulVec, P6_mul_R6, Matrix.one_mulVec], ?_⟩
  rintro φ rfl
  have key : energy6 φ = energy6 (R6 *ᵥ (P6 *ᵥ φ)) + energy6 (φ - R6 *ᵥ (P6 *ᵥ φ)) := by
    simp [energy6, R6, P6, Matrix.mulVec, dotProduct, Fin.sum_univ_succ]
    ring
  have h0 : 0 ≤ energy6 (φ - R6 *ᵥ (P6 *ᵥ φ)) := by unfold energy6; positivity
  linarith

/-- `R6 1 = 1`: constants are reconstructed exactly.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem R6_mulVec_one : R6 *ᵥ 1 = 1 := by
  ext i
  fin_cases i <;> simp [R6, Matrix.mulVec, dotProduct, Fin.sum_univ_succ] <;> norm_num

/-- Every column of `R6` sums to `2`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem R6_colSum : ∀ j, ∑ i, R6 i j = 2 := by
  intro j
  fin_cases j <;> simp [R6, Fin.sum_univ_succ] <;> norm_num

/-- Every column of `R6` has `ℓ¹` norm `14/5`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem R6_colNorm : ∀ j, ∑ i, |R6 i j| = 14 / 5 := by
  intro j
  fin_cases j <;> simp [R6, Fin.sum_univ_succ, abs_div] <;> norm_num

/-- Every column of `R6` has entries of both signs.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem R6_sign_change : ∀ j, ∃ a b, R6 a j < 0 ∧ 0 < R6 b j := by
  intro j
  fin_cases j
  · exact ⟨3, 0, by change (-1 / 5 : ℝ) < 0; norm_num, by change (0 : ℝ) < 1; norm_num⟩
  · exact ⟨0, 1, by change (-1 / 5 : ℝ) < 0; norm_num, by change (0 : ℝ) < 1 / 5; norm_num⟩
  · exact ⟨1, 0, by change (-1 / 5 : ℝ) < 0; norm_num, by change (0 : ℝ) < 1 / 5; norm_num⟩

/-- **`γ₀ = 7/5` for `R6`.** `R6` satisfies the hypotheses of `one_lt_gamma_iff` with `L = 14/5`,
`s = 2`; its columns change sign, so `γ₀ = L/s = 7/5 > 1`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem R6_gamma :
    (1 < (14 / 5 : ℝ) / 2 ↔ ∃ j a b, R6 a j < 0 ∧ 0 < R6 b j) ∧
      (∃ j a b, R6 a j < 0 ∧ 0 < R6 b j) ∧ (14 / 5 : ℝ) / 2 = 7 / 5 ∧ 1 < (14 / 5 : ℝ) / 2 := by
  have hiff := one_lt_gamma_iff R6 (14 / 5) 2 R6_mulVec_one R6_colNorm R6_colSum
  have hex : ∃ j a b, R6 a j < 0 ∧ 0 < R6 b j :=
    let ⟨a, b, ha, hb⟩ := R6_sign_change 0
    ⟨0, a, b, ha, hb⟩
  exact ⟨hiff, hex, by norm_num, hiff.mpr hex⟩

/-- **Strict loss for `R6`.** If `d_μ` is admissible for the fine cube metric `d_1` (`λ = 1`)
through `R6`, then for the constant coarse shift `z = 1` (exact composite cost
`d_1(R6 1, R6 0) = ‖1‖₁ = 6`) the additive metric charges `d_μ(1, 0) ≥ (7/5) · 6 = 42/5`; in
particular strictly more than the exact cost.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem R6_strict_loss (mu : Fin 3 → ℝ) (hmu : Admissible R6 1 mu) :
    addDist 1 (R6 *ᵥ 1) (R6 *ᵥ 0) = 6 ∧
      (7 / 5 : ℝ) * addDist 1 (R6 *ᵥ 1) (R6 *ᵥ 0) ≤ addDist mu 1 0 ∧
      addDist 1 (R6 *ᵥ 1) (R6 *ᵥ 0) < addDist mu 1 0 := by
  have hw := weight_le_of_admissible hmu
  have hj : ∀ j, (14 / 5 : ℝ) ≤ mu j := fun j => by
    have := hw j
    rwa [absT_mulVec_apply, show ∑ i, |R6 i j| * (1 : Fin 6 → ℝ) i = ∑ i, |R6 i j| by simp,
      R6_colNorm j] at this
  have h6 : addDist 1 (R6 *ᵥ 1) (R6 *ᵥ 0) = 6 := by
    rw [R6_mulVec_one, Matrix.mulVec_zero]
    simp [addDist]
  have hmu1 : addDist mu 1 0 = mu 0 + mu 1 + mu 2 := by
    simp [addDist, Fin.sum_univ_succ]
    ring
  refine ⟨h6, ?_, ?_⟩
  · rw [h6, hmu1]
    linarith [hj 0, hj 1, hj 2]
  · rw [h6, hmu1]
    linarith [hj 0, hj 1, hj 2]

/-- **Admissible weights for `R6`, exactly.** For the fine metric `d_1`: `d_μ` is admissible through
`R6` iff `μ_j ≥ 14/5` for every `j` (`admissible_iff`); the least admissible weight is
`|R6|ᵀ 1 = (14/5, 14/5, 14/5)` (`isLeast_admissible`); and it charges the constant coarse shift
`d_μ(1, 0) = 42/5 = (7/5) · 6`.  So the hypothesis of `R6_strict_loss` is satisfiable and its
bound is attained.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem R6_admissible :
    (∀ mu : Fin 3 → ℝ, Admissible R6 1 mu ↔ ∀ j, 14 / 5 ≤ mu j) ∧
      IsLeast {mu | Admissible R6 1 mu} (fun _ => 14 / 5) ∧
      Admissible R6 1 (fun _ => 14 / 5) ∧
      addDist (fun _ : Fin 3 => (14 / 5 : ℝ)) 1 0 = 42 / 5 := by
  have hw : (R6.map abs)ᵀ *ᵥ 1 = fun _ => 14 / 5 := by
    ext j
    rw [absT_mulVec_apply]
    simpa using R6_colNorm j
  have h0 : (0 : Fin 6 → ℝ) ≤ 1 := fun _ => by simp
  have hleast : IsLeast {mu | Admissible R6 1 mu} (fun _ => 14 / 5) := by
    rw [← hw]
    exact isLeast_admissible h0
  refine ⟨fun mu => ?_, hleast, hleast.1, ?_⟩
  · rw [admissible_iff h0, hw]
    exact Pi.le_def
  · norm_num [addDist, Fin.sum_univ_succ]

/-- **Column facts for `R6`** (closed instances of `colSum_mul_card`, `colSum_pos`, `one_le_gamma`,
`exists_sign_change_iff_forall`): `s · |ι| = |κ|` reads `2 · 3 = 6`; `s = 2 > 0`;
`γ₀ = (14/5)/2 ≥ 1`; and, since one column changes sign, every column does.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem R6_column_facts :
    (2 : ℝ) * Fintype.card (Fin 3) = Fintype.card (Fin 6) ∧ (0 : ℝ) < 2 ∧
      1 ≤ (14 / 5 : ℝ) / 2 ∧ ∀ j, ∃ a b, R6 a j < 0 ∧ 0 < R6 b j :=
  ⟨colSum_mul_card R6 2 R6_mulVec_one R6_colSum, colSum_pos R6 2 R6_mulVec_one R6_colSum,
    one_le_gamma R6 (14 / 5) 2 R6_mulVec_one R6_colNorm R6_colSum,
    (exists_sign_change_iff_forall R6 (14 / 5) 2 R6_mulVec_one R6_colNorm R6_colSum).mp
      R6_gamma.2.1⟩

/-! A chain instance for the multi-scale theorems: `X 0 = Fin 6`, `X k = Fin 3` for `k ≥ 1`,
`R_0 = R6`.  Only the step `0 → 1` enters the statements at `k = 1`; the later maps are set to
`0` and never used. -/

/-- Index types of the chain built on `R6`. -/
def X6 : ℕ → Type
  | 0 => Fin 6
  | _ + 1 => Fin 3

instance instFintypeX6 : ∀ k, Fintype (X6 k)
  | 0 => inferInstanceAs (Fintype (Fin 6))
  | _ + 1 => inferInstanceAs (Fintype (Fin 3))

instance instNonemptyX6 : ∀ k, Nonempty (X6 k)
  | 0 => inferInstanceAs (Nonempty (Fin 6))
  | _ + 1 => inferInstanceAs (Nonempty (Fin 3))

/-- The chain built on `R6`. -/
def chain6 : ∀ k, Matrix (X6 k) (X6 (k + 1)) ℝ
  | 0 => R6
  | _ + 1 => 0

/-- The column-norm hypothesis of (C2) for the `R6` chain at `k = 1`: `L_0 = 14/5`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem chain6_hL : ∀ i < 1, ∀ j, ∑ w, |chain6 i w j| = (fun _ => (14 / 5 : ℝ)) i := by
  intro i hi j
  obtain rfl : i = 0 := Nat.lt_one_iff.mp hi
  exact R6_colNorm j

/-- The column-sum hypothesis of (C2) for the `R6` chain at `k = 1`: `s_0 = 2`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem chain6_hs : ∀ i < 1, ∀ j, ∑ w, chain6 i w j = (fun _ => (2 : ℝ)) i := by
  intro i hi j
  obtain rfl : i = 0 := Nat.lt_one_iff.mp hi
  exact R6_colSum j

/-- The constants hypothesis of (C2) for the `R6` chain at `k = 1`: `R_0 1 = 1`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem chain6_h1 : ∀ i < 1, chain6 i *ᵥ 1 = 1 := by
  intro i hi
  obtain rfl : i = 0 := Nat.lt_one_iff.mp hi
  exact R6_mulVec_one

/-- **Non-vacuity of (C2) with strict loss.** The chain built on `R6` satisfies the hypotheses of
`overcount_one_eq_prod` at `k = 1`, and `ω_1(1) = γ₀ = 7/5 > 1`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem chain6_overcount : overcount chain6 1 1 = 7 / 5 := by
  rw [overcount_one_eq_prod chain6 _ _ 1 chain6_hL chain6_hs chain6_h1]
  norm_num

/-- **Lemma W (ii) and the (C2) bounds on the `R6` chain** (closed instances of
`minWeights_of_colNorm`, `prod_colSum_mul_card`, `minimal_weights`, `iterated_bound_ge`,
`one_le_overcount`, `pow_le_overcount_one`):
* `Λ⁽¹⁾ = (14/5) 1`, and `s_0 · |X_1| = |X_0|` (`2 · 3 = 6`);
* the minimal chain has `Λ⁽⁰⁾ = 1` and is admissible at every step, so the hypotheses of
  `minimal_weights` and `iterated_bound_ge` are satisfiable;
* every chain with `λ⁽⁰⁾ ≥ 1` admissible at step `0` has `λ⁽¹⁾ ≥ 14/5` entrywise;
* for the constant data `x_0 = x_1 = 1`, `‖T_0 1 + T_1 1‖₁ ≤ ⟨Λ⁽⁰⁾, 1⟩ + ⟨Λ⁽¹⁾, 1⟩`;
* `ω_1(1) ≥ 1` and `ω_1(1) ≥ (7/5)¹`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem chain6_weights :
    minWeights chain6 1 = (fun _ => 14 / 5) ∧
      (∏ _i ∈ range 1, (2 : ℝ)) * Fintype.card (X6 1) = Fintype.card (X6 0) ∧
      (1 ≤ minWeights chain6 0 ∧
        ∀ k, Admissible (chain6 k) (minWeights chain6 k) (minWeights chain6 (k + 1))) ∧
      (∀ lam : ∀ k, X6 k → ℝ, 1 ≤ lam 0 →
        (∀ i < 1, Admissible (chain6 i) (lam i) (lam (i + 1))) → ∀ j, 14 / 5 ≤ lam 1 j) ∧
      ∑ v, |∑ k ∈ range 2, Tmap chain6 k (1 : X6 k → ℝ) v| ≤
        ∑ k ∈ range 2, ∑ w, minWeights chain6 k w * |(1 : X6 k → ℝ) w| ∧
      1 ≤ overcount chain6 1 1 ∧ (7 / 5 : ℝ) ^ 1 ≤ overcount chain6 1 1 := by
  have hW : minWeights chain6 1 = (fun _ => 14 / 5) := by
    rw [minWeights_of_colNorm chain6 (fun _ => 14 / 5) 1 chain6_hL]
    simp
  have hT : Tmap chain6 1 1 ≠ 0 := by
    rw [Tmap_one chain6 1 chain6_h1]
    exact one_ne_zero
  refine ⟨hW, prod_colSum_mul_card chain6 (fun _ => 2) 1 chain6_h1 chain6_hs,
    ⟨(minWeights_zero chain6).ge, minWeights_admissible chain6⟩, ?_,
    (iterated_bound_ge chain6 (minWeights chain6) (minWeights_zero chain6).ge 1
      (fun i _ => minWeights_admissible chain6 i) (fun k => 1)).1,
    one_le_overcount chain6 hT,
    pow_le_overcount_one chain6 (fun _ => 14 / 5) (fun _ => 2) 1 chain6_hL chain6_hs chain6_h1
      (7 / 5) (by norm_num) (fun i _ => by norm_num)⟩
  intro lam h0 hadm j
  have := minimal_weights chain6 lam h0 1 hadm j
  rwa [hW] at this

/-- Data for the (C4) example on the `R6` chain: a unit change at the fine site `0`, and no coarse
component (`x_k = 0` for `k ≥ 1`). -/
def xFine6 : ∀ k, X6 k → ℝ
  | 0 => fun i : Fin 6 => if i = 0 then 1 else 0
  | _ + 1 => 0

/-- **(C4) on the `R6` chain: the unrestricted `Π γ` inequality is false.** For the constant
coarse field the factor is `Π_{i<1} γ_i = 7/5` (`chain6_overcount`).  For the purely fine change
`xFine6` (with `M = 1`), the bound of the minimal chain equals the truth `‖u‖₁ = 1`, hence is
strictly smaller than `Π_{i<1} γ_i · ‖u‖₁ = 7/5`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem chain6_C4 :
    ∑ k ∈ range 2, ∑ w, minWeights chain6 k w * |xFine6 k w| =
        ∑ v, |∑ k ∈ range 2, Tmap chain6 k (xFine6 k) v| ∧
      ∑ v, |∑ k ∈ range 2, Tmap chain6 k (xFine6 k) v| = 1 ∧
      ∑ k ∈ range 2, ∑ w, minWeights chain6 k w * |xFine6 k w| <
        (∏ _i ∈ range 1, (14 / 5 : ℝ) / 2) *
          ∑ v, |∑ k ∈ range 2, Tmap chain6 k (xFine6 k) v| := by
  have hx : ∀ k, 1 ≤ k → xFine6 k = 0 := by
    intro k hk
    obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
    rfl
  have heq : ∑ k ∈ range 2, ∑ w, minWeights chain6 k w * |xFine6 k w| =
      ∑ v, |∑ k ∈ range 2, Tmap chain6 k (xFine6 k) v| :=
    minimal_bound_eq_truth_of_fine chain6 1 xFine6 hx
  have hu : ∑ v, |∑ k ∈ range 2, Tmap chain6 k (xFine6 k) v| = 1 := by
    have e : ∀ v, ∑ k ∈ range 2, Tmap chain6 k (xFine6 k) v = xFine6 0 v :=
      truth_of_fine chain6 1 xFine6 hx
    simp only [e]
    change ∑ v : Fin 6, |(if v = 0 then (1 : ℝ) else 0)| = 1
    simp [Fin.sum_univ_succ]
  refine ⟨heq, hu, ?_⟩
  rw [heq, hu]
  norm_num

/-- The `1 × 1` class matrices of the `R6` chain (a single class; `M_0 = (14/5)`). -/
def M6 : ℕ → Matrix Unit Unit ℝ := fun _ => Matrix.of fun _ _ => 14 / 5

/-- **Non-vacuity of the class form** (`overcount_flat`, `overcount_flat_eq_prod_gamma`,
`classWeights_ge_prod`), on the `R6` chain with a single class, `ψ⁽ᵏ⁾ = 1` and `q = 2`:
`Λ⁽¹⁾_e = λ⁽¹⁾` for every coarse site (`minWeights_eq_classWeights`), the one-step column-sum bound
`(M_0ᵀ 1) ≥ 14/5 · 1` (`colSum_lower_bound`), `ω_1(1) = λ⁽¹⁾/2 = γ_0 = 7/5`, and
`λ⁽¹⁾ = 14/5 ≥ Π_{i<1} 14/5`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem chain6_flat :
    (∀ e, minWeights chain6 1 e = classWeights M6 1 ()) ∧
      (14 / 5 : ℝ) * 1 ≤ ((M6 0)ᵀ *ᵥ 1) () ∧
      overcount chain6 1 1 = classWeights M6 1 () / 2 ^ 1 ∧
      overcount chain6 1 1 =
        ∏ i ∈ range 1, classWeights M6 (i + 1) () / (2 * classWeights M6 i ()) ∧
      ∏ _i ∈ range 1, (14 / 5 : ℝ) ≤ classWeights M6 1 () ∧
      classWeights M6 1 () / 2 ^ 1 = 7 / 5 := by
  have hM : ∀ i < 1, ∀ (w : X6 (i + 1)) (ν : Unit),
      ∑ e ∈ univ.filter (fun e => (fun (k : ℕ) (_ : X6 k) => ()) i e = ν), |chain6 i e w| =
        M6 i ν ((fun (k : ℕ) (_ : X6 k) => ()) (i + 1) w) := by
    intro i hi w ν
    obtain rfl : i = 0 := Nat.lt_one_iff.mp hi
    rw [Finset.filter_true_of_mem fun e _ => Subsingleton.elim _ _]
    exact R6_colNorm w
  have hrec : ∀ i < 1, chain6 i *ᵥ (fun k => (1 : X6 k → ℝ)) (i + 1) =
      (fun k => (1 : X6 k → ℝ)) i := by
    intro i hi
    obtain rfl : i = 0 := Nat.lt_one_iff.mp hi
    exact R6_mulVec_one
  have hψ1 : (0 : X6 1 → ℝ) ≤ 1 := fun _ => by simp
  have hψ0 : (0 : X6 0 → ℝ) ≤ 1 := fun _ => by simp
  have hsupp : ∀ e : X6 1, (fun (k : ℕ) (_ : X6 k) => ()) 1 e ≠ () → (1 : X6 1 → ℝ) e = 0 :=
    fun _ h => absurd rfl h
  have c0 : Fintype.card (X6 0) = 6 := by
    change Fintype.card (Fin 6) = 6
    simp
  have c1 : Fintype.card (X6 1) = 3 := by
    change Fintype.card (Fin 3) = 3
    simp
  have hpos : 0 < ∑ e : X6 0, (1 : X6 0 → ℝ) e := by simp [c0]
  have hmass : ∑ e : X6 1, (1 : X6 1 → ℝ) e = (∑ e : X6 0, (1 : X6 0 → ℝ) e) / 2 ^ 1 := by
    simp [c0, c1]
    norm_num
  have hne : ∀ i < 1, classWeights M6 i () ≠ 0 := by
    intro i hi
    obtain rfl : i = 0 := Nat.lt_one_iff.mp hi
    simp
  have hlam : classWeights M6 1 () = 14 / 5 := by
    simp [M6, Matrix.mulVec, dotProduct]
  have hge := classWeights_ge_prod M6 (fun _ => 14 / 5) 1
    (fun i _ _ _ => by simp [M6]; norm_num) (fun i _ => by norm_num)
    (fun i _ _ => by simp [M6]) ()
  refine ⟨minWeights_eq_classWeights chain6 (fun _ _ => ()) M6 1 hM,
    colSum_lower_bound (M6 0) (fun _ _ => by simp [M6]; norm_num) (fun _ => by simp [M6])
      zero_le_one (fun _ => by simp) (),
    overcount_flat chain6 (fun _ _ => ()) M6 1 hM () (fun k => 1) 2 hrec hψ1 hsupp hψ0
      hpos hmass,
    overcount_flat_eq_prod_gamma chain6 (fun _ _ => ()) M6 1 hM () (fun k => 1) 2 hrec hψ1 hsupp
      hψ0 hpos hmass (by norm_num) hne, hge, ?_⟩
  rw [hlam]
  norm_num

/-- Parity classes on the `R6` chain: the fine site `e` has class `e mod 2` (its position in its
block), and every coarse site has class `0`. -/
def cls6 : ∀ k, X6 k → Fin 2
  | 0 => fun e : Fin 6 => ![0, 1, 0, 1, 0, 1] e
  | _ + 1 => fun _ => 0

/-- The `2 × 2` class matrices for `cls6`, every entry `7/5`: each column of `R6` has `ℓ¹` mass
`7/5` on the even sites and `7/5` on the odd sites. -/
def M62 : ℕ → Matrix (Fin 2) (Fin 2) ℝ := fun _ => Matrix.of fun _ _ => 7 / 5

/-- **Non-vacuity of the class collapse with two classes** (`minWeights_eq_classWeights` with
`D = Fin 2`, the parity classes `cls6`): the class-sum hypothesis holds for `R6`, and
`Λ⁽¹⁾_e = λ⁽¹⁾_{cls e}` with `λ⁽¹⁾_0 = M_0(0,0) + M_0(1,0) = 14/5`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem chain6_two_classes :
    (∀ e, minWeights chain6 1 e = classWeights M62 1 (cls6 1 e)) ∧
      classWeights M62 1 0 = 14 / 5 := by
  have hM : ∀ i < 1, ∀ (w : X6 (i + 1)) (ν : Fin 2),
      ∑ e ∈ univ.filter (fun e => cls6 i e = ν), |chain6 i e w| = M62 i ν (cls6 (i + 1) w) := by
    intro i hi w ν
    obtain rfl : i = 0 := Nat.lt_one_iff.mp hi
    change ∑ e ∈ univ.filter (fun e : Fin 6 => ![0, 1, 0, 1, 0, 1] e = ν), |R6 e w| = 7 / 5
    rw [Finset.sum_filter]
    fin_cases w <;> fin_cases ν <;> simp [Fin.sum_univ_succ, R6, abs_div] <;> norm_num
  refine ⟨minWeights_eq_classWeights chain6 cls6 M62 1 hM, ?_⟩
  simp [M62, Matrix.mulVec, dotProduct]
  norm_num

/-! ### The 1D periodic chain `ℤ/4`, two blocks of two: a nonnegative reconstruction

On the cycle `ℤ/4` with blocks `{0,1}, {2,3}` the minimal-energy reconstruction is block-constant,
so `R4 ≥ 0` and there is no loss.  This is a 1D two-block effect.  It is not representative of the
block gauge, where the two-block torus `(ℤ/4)⁴` has sign-changing columns and `γ₀ = 5/2` (not
formalised here). -/

/-- The reconstruction map of the 1D periodic chain `ℤ/4` with two blocks of two. -/
def R4 : Matrix (Fin 4) (Fin 2) ℝ :=
  !![1, 0;
     1, 0;
     0, 1;
     0, 1]

/-- The block averages on `ℤ/4`. -/
def P4 : Matrix (Fin 2) (Fin 4) ℝ :=
  !![1/2, 1/2, 0, 0;
     0, 0, 1/2, 1/2]

/-- The massless energy on the cycle `ℤ/4`. -/
def energy4 (φ : Fin 4 → ℝ) : ℝ :=
  (φ 1 - φ 0) ^ 2 + (φ 2 - φ 1) ^ 2 + (φ 3 - φ 2) ^ 2 + (φ 0 - φ 3) ^ 2

/-- `P4 R4 = I`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem P4_mul_R4 : P4 * R4 = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [P4, R4, Matrix.mul_apply, Fin.sum_univ_succ] <;> norm_num

/-- **`R4` is the minimal-energy reconstruction** on `ℤ/4`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem R4_isMin (y : Fin 2 → ℝ) :
    P4 *ᵥ (R4 *ᵥ y) = y ∧ ∀ φ : Fin 4 → ℝ, P4 *ᵥ φ = y → energy4 (R4 *ᵥ y) ≤ energy4 φ := by
  refine ⟨by rw [Matrix.mulVec_mulVec, P4_mul_R4, Matrix.one_mulVec], ?_⟩
  rintro φ rfl
  have key : energy4 φ = energy4 (R4 *ᵥ (P4 *ᵥ φ)) + energy4 (φ - R4 *ᵥ (P4 *ᵥ φ)) := by
    simp [energy4, R4, P4, Matrix.mulVec, dotProduct, Fin.sum_univ_succ]
    ring
  have h0 : 0 ≤ energy4 (φ - R4 *ᵥ (P4 *ᵥ φ)) := by unfold energy4; positivity
  linarith

/-- `R4 ≥ 0` entrywise.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem R4_nonneg : ∀ a b, 0 ≤ R4 a b := by
  intro a b
  fin_cases a <;> fin_cases b <;> simp [R4]

/-- `R4 1 = 1`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem R4_mulVec_one : R4 *ᵥ 1 = 1 := by
  ext i
  fin_cases i <;> simp [R4, Matrix.mulVec, dotProduct, Fin.sum_univ_succ]

/-- **No loss for `R4`.** The minimal admissible weight is `|R4|ᵀ 1 = (2, 2)`, and the minimal
additive metric equals the exact composite on every pair:
`d_1(R4 z, R4 z') = d_{|R4|ᵀ1}(z, z')` for all `z, z'`.  Also `γ₀ = 2/2 = 1`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem R4_no_loss :
    (R4.map abs)ᵀ *ᵥ 1 = (fun _ => 2) ∧
      (∀ z z' : Fin 2 → ℝ,
        addDist 1 (R4 *ᵥ z) (R4 *ᵥ z') = addDist ((R4.map abs)ᵀ *ᵥ 1) z z') ∧
      ¬ ∃ j a b, R4 a j < 0 ∧ 0 < R4 b j := by
  have hw : (R4.map abs)ᵀ *ᵥ 1 = (fun _ => 2) := by
    ext j
    rw [absT_mulVec_apply]
    fin_cases j <;> simp [R4, Fin.sum_univ_succ] <;> norm_num
  refine ⟨hw, fun z z' => ?_, ?_⟩
  · rw [hw]
    simp [addDist, R4, Matrix.mulVec, dotProduct, Fin.sum_univ_succ]
    ring
  · rintro ⟨j, a, b, ha, -⟩
    exact absurd ha (not_lt.mpr (R4_nonneg a j))

/-- **Signed versus `|R|ᵀ` weight** (`signed_lt_abs_weight_iff` with `λ = 1`, both directions): for
`R6` every column has `|Σ column| < ‖column‖₁` (`2 < 14/5`); for `R4` no column does.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem signed_vs_abs_examples :
    (∀ j, |(R6ᵀ *ᵥ 1) j| < ((R6.map abs)ᵀ *ᵥ 1) j) ∧
      (∀ j, ¬ |(R4ᵀ *ᵥ 1) j| < ((R4.map abs)ᵀ *ᵥ 1) j) := by
  have h6 : ∀ i : Fin 6, (0 : ℝ) < (1 : Fin 6 → ℝ) i := fun _ => by simp
  have h4 : ∀ i : Fin 4, (0 : ℝ) < (1 : Fin 4 → ℝ) i := fun _ => by simp
  refine ⟨fun j => (signed_lt_abs_weight_iff R6 h6 j).mpr (R6_sign_change j), fun j h => ?_⟩
  obtain ⟨a, b, ha, -⟩ := (signed_lt_abs_weight_iff R4 h4 j).mp h
  exact absurd ha (not_lt.mpr (R4_nonneg a j))

/-- The chain built on `R4`: `X 0 = Fin 4`, `X k = Fin 2` for `k ≥ 1`, `R_0 = R4`. -/
def X4 : ℕ → Type
  | 0 => Fin 4
  | _ + 1 => Fin 2

instance instFintypeX4 : ∀ k, Fintype (X4 k)
  | 0 => inferInstanceAs (Fintype (Fin 4))
  | _ + 1 => inferInstanceAs (Fintype (Fin 2))

instance instNonemptyX4 : ∀ k, Nonempty (X4 k)
  | 0 => inferInstanceAs (Nonempty (Fin 4))
  | _ + 1 => inferInstanceAs (Nonempty (Fin 2))

/-- The chain built on `R4`. -/
def chain4 : ∀ k, Matrix (X4 k) (X4 (k + 1)) ℝ
  | 0 => R4
  | _ + 1 => 0

/-- **Non-vacuity of the no-loss case.** The chain built on `R4` satisfies the hypotheses of
`overcount_one_eq_prod`, `overcount_eq_one_of_nonneg` and `no_loss_of_nonneg` at `k = 1`:
`ω_1(1) = Π_{i<1} γ_i = 2/2`, `ω_1(1) = 1`, and `‖T_1 x‖₁ = ⟨Λ⁽¹⁾, x⟩` for every `x ≥ 0`.

Scope: a statement about one proof method (site-additive metrics); it says nothing about the
Yang–Mills measure. -/
theorem chain4_overcount :
    overcount chain4 1 1 = ∏ _i ∈ range 1, (2 : ℝ) / 2 ∧ overcount chain4 1 1 = 1 ∧
      ∀ x : X4 1 → ℝ, 0 ≤ x → ∑ v, |Tmap chain4 1 x v| = ∑ w, minWeights chain4 1 w * x w := by
  have hR : ∀ i < 1, ∀ a b, 0 ≤ chain4 i a b := by
    intro i hi
    obtain rfl : i = 0 := Nat.lt_one_iff.mp hi
    exact R4_nonneg
  have hL : ∀ i < 1, ∀ j, ∑ w, |chain4 i w j| = (fun _ => (2 : ℝ)) i := by
    intro i hi j
