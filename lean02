about Yang–Mills). -/
noncomputable def rho (k : ℕ) : ℝ := Real.sqrt ((4 + 2 * (1 / 4 : ℝ) ^ k) / 3)

lemma rho_sq (k : ℕ) : rho k ^ 2 = (4 + 2 * (1 / 4 : ℝ) ^ k) / 3 := Real.sq_sqrt (by positivity)

lemma rho_pos (k : ℕ) : 0 < rho k := Real.sqrt_pos.2 (by positivity)

lemma rho_sq_gt (k : ℕ) : 4 / 3 < rho k ^ 2 := by
  rw [rho_sq]; have := quarter_pow_pos k; linarith

lemma rho_sq_le (k : ℕ) : rho k ^ 2 ≤ 2 := by
  rw [rho_sq]; have := quarter_pow_le_one k; linarith

lemma one_lt_rho (k : ℕ) : 1 < rho k := by nlinarith [rho_sq_gt k, rho_pos k]

lemma rho_lt_three_halves (k : ℕ) : rho k < 3 / 2 := by nlinarith [rho_sq_le k, rho_pos k]

/-- `ρ_k √3 > 2`, the form of `ρ_k > 2/√3` used in the proofs. -/
